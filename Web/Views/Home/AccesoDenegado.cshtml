@{
    ViewBag.Title = "Acceso Denegado";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";  // Ajustá si tu layout se llama distinto
}

<div class="container-fluid mt-5">

    <!-- 404 Error Text -->
    <div class="text-center">
        <div class="error mx-auto" data-text="403">403</div>
        <p class="lead text-gray-800 mb-5">Acceso Denegado</p>
        <p class="text-gray-500 mb-4">No tenés permisos para acceder a esta sección.</p>

        <a href="@Url.Action("Index", "Home")">
            <i class="fas fa-arrow-left"></i> Volver al inicio
        </a>
    </div>

</div>
