@model Web.Models.UtilitiesIndexVm

@{
    ViewBag.Title = "CarniSys | Utilidades";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Utilidades</h1>
            <p class="mb-0 text-muted">Descarga e instalación de agentes locales y futuras herramientas auxiliares.</p>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model.Agentes)
        {
            <div class="col-12 col-lg-6 mb-4">
                <div class="card shadow-sm h-100 border-left-@(item.Disponible ? "success" : "secondary")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="text-xs font-weight-bold text-uppercase text-muted mb-1">@item.Categoria</div>
                                <h5 class="mb-1">@item.Nombre</h5>
                            </div>
                            <span class="badge badge-@(item.Disponible ? "success" : "secondary")">@item.Estado</span>
                        </div>

                        <p class="text-muted mb-3">@item.Descripcion</p>

                        <div class="small text-muted mb-1">Archivo: <strong>@item.ArchivoNombre</strong></div>
                        <div class="small text-muted mb-1">Tamaño: <strong>@item.ArchivoTamano</strong></div>
                        <div class="small text-muted mb-3">Última actualización: <strong>@item.Version</strong></div>

                        <div class="alert alert-light border small mb-3">
                            @item.NotaInstalacion
                        </div>

                        <div class="mt-auto">
                            @if (item.Disponible)
                            {
                                <a class="btn btn-primary btn-sm" href="@item.ArchivoUrl" download>
                                    <i class="fas fa-download mr-1"></i> Descargar
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled>
                                    <i class="fas fa-clock mr-1"></i> Próximamente
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Más herramientas</h6>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var item in Model.OtrasUtilidades)
                {
                    <div class="col-12 col-md-6 mb-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>@item.Nombre</strong>
                                <span class="badge badge-secondary">@item.Estado</span>
                            </div>
                            <div class="text-muted small mb-2">@item.Descripcion</div>
                            <div class="small text-muted">@item.NotaInstalacion</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
