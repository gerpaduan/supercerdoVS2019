@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}


@{
    // Puedes pasar la URL del servicio desde el servidor si querés:
    // var balanzaUrl = Url.Content("http://localhost:5100/peso");
}

<div id="balanza-container" style="max-width:420px;">
    <label for="txtPeso" style="display:block; font-weight:600; margin-bottom:6px;">
        Peso leído (balanza)
    </label>

    <div style="display:flex; gap:10px; align-items:center;">
        <!-- Input grande y de sólo lectura -->
        <input id="txtPeso" type="text" readonly
               class="form-control"
               style="font-size:22px; font-weight:700; padding:10px; width:220px; text-align:right;"
               value="0.000" />

        <!-- Estado de conexión -->
        <div id="estadoBalanza" style="font-weight:600; min-width:110px;">
            <span id="estadoIcon" style="display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; background:#ccc; vertical-align:middle;"></span>
            <span id="estadoText">Sin conexión</span>
        </div>
    </div>

    <!-- Información adicional -->
    <div style="margin-top:8px; font-size:12px; color:#666;">
        <span>Última actualización: <span id="ultimaActualizacion">--</span></span>
        &nbsp;•&nbsp;
        <span>Intervalo: <span id="intervaloTxt">200ms</span></span>
    </div>
</div>

<script>
(function(){
    // Config
    const BALANZA_URL = "http://localhost:5100/peso"; // cambiar si tu servicio usa otro puerto
    const POLL_INTERVAL_MS = 200;                       // intervalo de sondeo
    const FETCH_TIMEOUT_MS = 1200;                      // timeout por petición

    // Elementos
    const $peso = document.getElementById("txtPeso");
    const $estadoIcon = document.getElementById("estadoIcon");
    const $estadoText = document.getElementById("estadoText");
    const $ultima = document.getElementById("ultimaActualizacion");
    const $intervaloTxt = document.getElementById("intervaloTxt");

    $intervaloTxt.textContent = POLL_INTERVAL_MS + "ms";

    // Formatea número a "0.000"
    function formatearPeso(valor) {
        if (valor === null || valor === undefined) return "0.000";
        const n = Number(valor);
        if (isNaN(n)) return "0.000";
        return n.toFixed(3);
    }

    // Actualiza estado visual
    function setEstado(conectado, mensaje) {
        if (conectado) {
            $estadoIcon.style.background = "#2ecc71"; // verde
            $estadoText.textContent = mensaje || "Conectada";
        } else {
            $estadoIcon.style.background = "#e74c3c"; // rojo
            $estadoText.textContent = mensaje || "Sin conexión";
        }
    }

    // Petición fetch con timeout
    async function fetchWithTimeout(url, timeoutMs) {
        const controller = new AbortController();
        const id = setTimeout(() => controller.abort(), timeoutMs);

        try {
            const res = await fetch(url, { signal: controller.signal, cache: "no-store" });
            clearTimeout(id);
            return res;
        } catch (err) {
            clearTimeout(id);
            throw err;
        }
    }

    // Función principal de lectura
    async function leerPesoUnaVez() {
        try {
            const resp = await fetchWithTimeout(BALANZA_URL, FETCH_TIMEOUT_MS);
            if (!resp.ok) throw new Error("HTTP " + resp.status);

            const data = await resp.json();

            // Esperamos el JSON { "peso": "1.234", "estado": "ok" } (típico)
            const pesoRaw = data.peso ?? data.valor ?? data.weight ?? null;
            const estado = (data.estado ?? data.status ?? "").toString().toLowerCase();

            // Normalizamos y mostramos
            const pesoFormateado = formatearPeso(pesoRaw);
            $peso.value = pesoFormateado;

            // Estado: consideramos ok si dice "ok" o "connected" o existe peso numérico
            const conectado = (estado === "ok" || estado === "connected") || (Number(pesoRaw) !== 0 && !isNaN(Number(pesoRaw)));

            setEstado(conectado, conectado ? "Conectada" : "Lectura intermitente");

            const now = new Date();
            $ultima.textContent = now.toLocaleTimeString();

        } catch (err) {
            // Error al leer: API no disponible o timeout
            setEstado(false, "Sin conexión");
            // no sobreescribimos el valor inmediatamente para evitar parpadeos; opcional:
            // $peso.value = "0.000";
            $ultima.textContent = "--";
            // console.log("Error leyendo balanza:", err);
        }
    }

    // Inicia sondeo periódico
    let pollingHandle = null;
    function startPolling() {
        if (pollingHandle) clearInterval(pollingHandle);
        // leer inmediatamente y después programar
        leerPesoUnaVez();
        pollingHandle = setInterval(leerPesoUnaVez, POLL_INTERVAL_MS);
    }

    // Start
    startPolling();

    // Opcional: Exponer funciones globales para debugging desde consola
    window._balanza = {
        start: startPolling,
        stop: () => { if (pollingHandle) clearInterval(pollingHandle); pollingHandle = null; },
        readNow: leerPesoUnaVez
    };

})();
</script>


