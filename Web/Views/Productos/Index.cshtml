    <div class="modal fade" id="modalCatalogoGlobal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-xl modal-catalogo-global-dialog" role="document">
            <div class="modal-content" id="modalCatalogoGlobalContent">
                <div class="modal-body text-center text-muted py-5">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Cargando catálogo global...
                </div>
            </div>
        </div>
    </div>


    <!-- =========================
         FORM ELIMINAR (POST)
         ========================= -->
    <form id="formEliminar" method="post" action="@Url.Action("Eliminar", "Productos")" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="EliminarId" />
    </form>

</div>

@section Scripts {

    <script>
    function showProductosNavigationLoading(message) {
        if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
            window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
        }
    }

    function navegarProductosConLoader(url) {
        if (!url) return;
        showProductosNavigationLoading("Cargando solicitud...");
        window.setTimeout(function () {
            window.location.href = url;
        }, 0);
    }

    // ============================
    // Helpers
    // ============================
    const urlVerGlobalesProductos = '@Url.Action("VerGlobales", "Productos")';
    const urlBuscarGlobalesProductos = '@Url.Action("BuscarGlobales", "Productos")';
    const urlImportarGlobalesProductos = '@Url.Action("ImportarSeleccionados", "Productos")';
    const catalogoGlobalState = {
        selectedIds: {},
        codigoDestinoPorId: {},
        precioPorId: {},
        verSoloSeleccionados: false,
        paginaActual: 1,
        hayMas: false,
        cargandoMas: false,
        solicitudActual: 0
    };
    const tabla = document.getElementById("tablaProductos");
    const TIEMPO_PAUSA_LECTURA_SCANNER = 2000;
    let scannerCatalogoGlobal = null;
    const scannerCatalogoGlobalState = {
        ultimoCodigoLeido: "",
        tiempoUltimaLectura: 0,
        pausaLecturaActiva: false,
        pausaTimer: null,
        camaraCerradaAutomaticamente: false
    };

    function onlyDigits(value) {
        return (value || "").toString().replace(/\D/g, "");
    }

    function isValidEAN(code) {
        code = onlyDigits(code);
        if (code.length === 13) return isValidEAN13(code);
        if (code.length === 8) return isValidEAN8(code);
        return false;
    }

    function isValidEAN13(code13) {
        if (!/^\d{13}$/.test(code13)) return false;
        let sum = 0;
        for (let i = 0; i < 12; i++) {
            const digit = parseInt(code13[i], 10);
            sum += (i % 2 === 0) ? digit : digit * 3;
        }
        const check = (10 - (sum % 10)) % 10;
        return check === parseInt(code13[12], 10);
    }

    function isValidEAN8(code8) {
        if (!/^\d{8}$/.test(code8)) return false;
        let sum = 0;
        for (let i = 0; i < 7; i++) {
            const digit = parseInt(code8[i], 10);
            sum += (i % 2 === 0) ? digit * 3 : digit;
        }
        const check = (10 - (sum % 10)) % 10;
        return check === parseInt(code8[7], 10);
    }

    function resetScannerDoubleReadState(state, preserveAutoClose) {
        state.ultimoCodigoLeido = "";
        state.tiempoUltimaLectura = 0;
        state.pausaLecturaActiva = false;
        if (state.pausaTimer) {
            clearTimeout(state.pausaTimer);
            state.pausaTimer = null;
        }
        if (!preserveAutoClose) {
            state.camaraCerradaAutomaticamente = false;
        }
    }

    function startScannerPause(state, preserveAutoClose, onPauseEnd) {
        state.pausaLecturaActiva = true;
        if (state.pausaTimer) {
            clearTimeout(state.pausaTimer);
        }
        state.pausaTimer = setTimeout(function () {
            resetScannerDoubleReadState(state, preserveAutoClose);
            if (typeof onPauseEnd === "function") {
                onPauseEnd();
            }
        }, TIEMPO_PAUSA_LECTURA_SCANNER);
    }

    function processDoubleReadCode(state, codigoLeido, callbacks) {
        if (state.pausaLecturaActiva) return;

        const codigo = onlyDigits(codigoLeido);
        if (!codigo) return;

        if (!state.ultimoCodigoLeido) {
            state.ultimoCodigoLeido = codigo;
            state.tiempoUltimaLectura = Date.now();
            callbacks.onFirstRead && callbacks.onFirstRead(codigo);
            return;
        }

        if (codigo !== state.ultimoCodigoLeido) {
            state.ultimoCodigoLeido = codigo;
            state.tiempoUltimaLectura = Date.now();
            callbacks.onDifferentRead && callbacks.onDifferentRead(codigo);
            return;
        }

        if (!isValidEAN(codigo)) {
            resetScannerDoubleReadState(state, false);
            callbacks.onInvalidRead && callbacks.onInvalidRead(codigo);
            return;
        }

        state.tiempoUltimaLectura = Date.now();
        callbacks.onAcceptedRead && callbacks.onAcceptedRead(codigo);
        startScannerPause(state, !!callbacks.preserveAutoCloseOnPause, callbacks.onPauseEnd);
    }

    function getFilasProductos() {
        return Array.from(tabla.querySelectorAll("tbody tr"))
            .filter(tr => tr.id && tr.id.startsWith("fila_"));
    }

    function guardarOrdenVisibleParaEdicion() {
        const idsVisibles = getFilasProductos()
            .filter(fila => fila.style.display !== "none")
            .map(fila => Number(fila.dataset.id))
            .filter(id => Number.isFinite(id) && id > 0);

        try {
            window.sessionStorage.setItem("productos_edicion_orden_visible", JSON.stringify(idsVisibles));
        } catch (e) {
        }
    }

    document.addEventListener("click", function (event) {
        const linkEditar = event.target.closest("a.js-editar-producto");
        if (!linkEditar || linkEditar.classList.contains("disabled")) return;
        guardarOrdenVisibleParaEdicion();
        try {
            window.sessionStorage.removeItem("productos_edicion_historial");
        } catch (e) {
        }
    });

    function getFilaDetallesDe(filaProducto) {
        const next = filaProducto.nextElementSibling;
        if (next && next.classList.contains("tr-detalles")) return next;
        return null;
    }

    function toggleDetallesFila(filaProducto) {
        if (!filaProducto) return;

        const filaDetalles = getFilaDetallesDe(filaProducto);
        if (!filaDetalles) return;

        const collapse = filaDetalles.querySelector(".collapse");
        if (!collapse) return;

        $(collapse).collapse(collapse.classList.contains("show") ? "hide" : "show");
    }

    tabla?.addEventListener("dblclick", function (event) {
        const fila = event.target.closest("tr[id^='fila_']");
        if (!fila) return;

        if (event.target.closest(".td-acciones-producto, button, a, input, label")) {
            return;
        }

        toggleDetallesFila(fila);
    });

    function setAlertCatalogoGlobal(mensaje) {
        const $alert = $("#alertCatalogoGlobal");
        if (!$alert.length) return;

        if (!mensaje) {
            $alert.addClass("d-none").html("");
            return;
        }

        $alert.removeClass("d-none").html(mensaje);
    }

    function getCatalogoGlobalLoadingHtml() {
        return '' +
            '<div class="modal-header">' +
                '<h5 class="modal-title"><i class="fas fa-globe-americas mr-1"></i> Catálogo global</h5>' +
                '<button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">' +
                    '<span aria-hidden="true">&times;</span>' +
                '</button>' +
            '</div>' +
            '<div class="modal-body text-center text-muted py-5">' +
                '<i class="fas fa-spinner fa-spin mr-2"></i> Cargando catálogo global...' +
            '</div>' +
            '<div class="modal-footer">' +
                '<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>' +
            '</div>';
    }

    function getCatalogoGlobalErrorHtml() {
        return '' +
            '<div class="modal-header">' +
                '<h5 class="modal-title"><i class="fas fa-globe-americas mr-1"></i> Catálogo global</h5>' +
                '<button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">' +
                    '<span aria-hidden="true">&times;</span>' +
                '</button>' +
            '</div>' +
            '<div class="modal-body">' +
                '<div class="alert alert-danger mb-0">No se pudo cargar el catálogo global.</div>' +
            '</div>' +
            '<div class="modal-footer">' +
                '<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>' +
            '</div>';
    }

    function actualizarResumenCatalogoGlobal() {
        const $rows = $("#tbodyCatalogoGlobal tr[data-id]:visible");
        const totalSeleccionados = Object.keys(catalogoGlobalState.selectedIds).length;
        $("#lblResumenCatalogoGlobal").text($rows.length + " producto(s) visible(s) - " + totalSeleccionados + " seleccionado(s)");
    }

    function aplicarFiltroSeleccionadosCatalogoGlobal() {
        const soloSeleccionados = !!catalogoGlobalState.verSoloSeleccionados;

        $("#tbodyCatalogoGlobal tr[data-id]").each(function () {
            const $row = $(this);
            const id = parseInt($row.data("id"), 10);
            const visible = !soloSeleccionados || !!catalogoGlobalState.selectedIds[id];
            $row.toggle(visible);
        });
    }

    function togglePrecioCatalogoGlobalFila(row, focusPrecio) {
        const $row = $(row);
        const $chk = $row.find(".chk-global-producto");
        const $wrapper = $row.find(".js-precio-wrapper");
        const $precio = $row.find(".js-precio-destino");
        const mostrar = $chk.is(":checked") && !$chk.is(":disabled");

        $wrapper.toggleClass("d-none", !mostrar);

        if (mostrar && focusPrecio && $precio.length) {
            window.setTimeout(function () {
                $precio.trigger("focus").trigger("select");
            }, 0);
        }
    }

    function renderEstadoCatalogoGlobalFila(row) {
        const $row = $(row);
        const $estado = $row.find(".js-estado-global");
        if (!$estado.length) return;

        const $chk = $row.find(".chk-global-producto");
        const $codigo = $row.find(".js-codigo-destino");
        const seleccionado = $chk.is(":checked") && !$chk.is(":disabled");
        const codigoDuplicadoOriginal = String($row.data("codigo-duplicado")) === "1";
        const codigoOriginal = ($row.data("codigo-original") || "").toString();
        const codigoSugerido = ($row.data("codigo-sugerido") || "").toString();
        const codigoActual = ($codigo.val() || "").toString().trim();
        const $precio = $row.find(".js-precio-destino");
        const precioActual = ($precio.val() || "").toString().trim();

        togglePrecioCatalogoGlobalFila(row, false);

        if (seleccionado && precioActual === "") {
            $estado.html(
                '<span class="badge badge-warning text-dark">Falta precio</span><br />' +
                '<small class="text-muted">Ingrese el precio antes de importar</small>'
            );
            return;
        }

        if (seleccionado && codigoDuplicadoOriginal && codigoActual === codigoOriginal) {
            $estado.html(
                '<span class="badge badge-warning text-dark">Codigo ocupado</span><br />' +
                '<small class="text-muted">Pertenece a la empresa actual. Sugerido: ' + codigoSugerido + '</small><br />' +
                '<button type="button" class="btn btn-link btn-sm p-0 mt-1 js-usar-codigo-sugerido">Usar sugerido</button>'
            );
            return;
        }

        $estado.html(
            '<span class="badge badge-secondary">Disponible</span><br />' +
            '<small class="text-muted">Listo para importar</small>'
        );
    }

    function renderEstadoCatalogoGlobalTabla() {
        $("#tbodyCatalogoGlobal tr[data-id]").each(function () {
            renderEstadoCatalogoGlobalFila(this);
        });
    }

    function snapshotCatalogoGlobalState() {
        $("#tbodyCatalogoGlobal tr[data-id]").each(function () {
            const $row = $(this);
            const id = parseInt($row.data("id"), 10);
            if (!id) return;

            const $chk = $row.find(".chk-global-producto");
            const $codigo = $row.find(".js-codigo-destino");
            const $precio = $row.find(".js-precio-destino");

            if ($codigo.length) {
                catalogoGlobalState.codigoDestinoPorId[id] = ($codigo.val() || "").toString().trim();
            }

            if ($precio.length) {
                catalogoGlobalState.precioPorId[id] = ($precio.val() || "").toString().trim();
            }

            if ($chk.is(":checked") && !$chk.is(":disabled")) {
                catalogoGlobalState.selectedIds[id] = true;
            } else {
                delete catalogoGlobalState.selectedIds[id];
            }
        });
    }

    function restoreCatalogoGlobalState() {
        $("#tbodyCatalogoGlobal tr[data-id]").each(function () {
            const $row = $(this);
            const id = parseInt($row.data("id"), 10);
            if (!id) return;

            const $chk = $row.find(".chk-global-producto");
            const $codigo = $row.find(".js-codigo-destino");
            const $precio = $row.find(".js-precio-destino");

            if ($codigo.length && Object.prototype.hasOwnProperty.call(catalogoGlobalState.codigoDestinoPorId, id)) {
                $codigo.val(catalogoGlobalState.codigoDestinoPorId[id]);
            }

            if ($precio.length && Object.prototype.hasOwnProperty.call(catalogoGlobalState.precioPorId, id)) {
                $precio.val(catalogoGlobalState.precioPorId[id]);
            }

            if ($chk.length && !$chk.is(":disabled")) {
                $chk.prop("checked", !!catalogoGlobalState.selectedIds[id]);
            }

            togglePrecioCatalogoGlobalFila(this, false);
        });

        const $checksDisponibles = $("#tbodyCatalogoGlobal .chk-global-producto:not(:disabled)");
        const todosMarcados = $checksDisponibles.length > 0 && $checksDisponibles.filter(":checked").length === $checksDisponibles.length;
        $("#chkSeleccionarTodosGlobales").prop("checked", todosMarcados);
        renderEstadoCatalogoGlobalTabla();
        $("#chkVerSoloSeleccionadosGlobales").prop("checked", !!catalogoGlobalState.verSoloSeleccionados);
        aplicarFiltroSeleccionadosCatalogoGlobal();
    }

    function bindCatalogoGlobalEvents() {
        let searchTimer = null;

        catalogoGlobalState.paginaActual = parseInt($("#formCatalogoGlobalImportacion").data("pagina"), 10) || 1;
        catalogoGlobalState.hayMas = String($("#formCatalogoGlobalImportacion").data("hay-mas")) === "1";
        catalogoGlobalState.cargandoMas = false;

        function cargarPaginaCatalogoGlobal(q, tipo, pagina, reemplazar) {
            const solicitud = ++catalogoGlobalState.solicitudActual;
            catalogoGlobalState.cargandoMas = !reemplazar;
            $("#catalogoGlobalCargandoMas").toggleClass("d-none", reemplazar);

            $.get(urlBuscarGlobalesProductos, { q: q, tipo: tipo, pagina: pagina })
                .done(function (resp) {
                    if (solicitud !== catalogoGlobalState.solicitudActual) return;

                    if (!resp || resp.ok === false) {
                        setAlertCatalogoGlobal(resp && resp.mensaje ? resp.mensaje : "No se pudo buscar en el catálogo global.");
                        return;
                    }

                    if (reemplazar) {
                        $("#tbodyCatalogoGlobal").html(resp.html || "");
                    } else {
                        $("#tbodyCatalogoGlobal").append(resp.html || "");
                    }

                    catalogoGlobalState.paginaActual = resp.pagina || pagina;
                    catalogoGlobalState.hayMas = !!resp.hayMas;
                    restoreCatalogoGlobalState();
                    setAlertCatalogoGlobal("");
                    actualizarResumenCatalogoGlobal();
                })
                .fail(function () {
                    if (solicitud === catalogoGlobalState.solicitudActual) {
                        setAlertCatalogoGlobal("No se pudo buscar en el catálogo global.");
                    }
                })
                .always(function () {
                    if (solicitud === catalogoGlobalState.solicitudActual) {
                        catalogoGlobalState.cargandoMas = false;
                        $("#catalogoGlobalCargandoMas").addClass("d-none");
                    }
                });
        }

        $("#txtBuscarCatalogoGlobal").off("input").on("input", function () {
            const valor = this.value || "";
            setScannerCatalogoGlobalMsg("");
            clearTimeout(searchTimer);
            catalogoGlobalState.solicitudActual++;
            searchTimer = window.setTimeout(function () {
                snapshotCatalogoGlobalState();
                cargarPaginaCatalogoGlobal(valor, $("#selTipoCatalogoGlobal").val() || "", 1, true);
            }, 250);
        });

        $("#selTipoCatalogoGlobal").off("change").on("change", function () {
            snapshotCatalogoGlobalState();
            setScannerCatalogoGlobalMsg("");
            cargarPaginaCatalogoGlobal($("#txtBuscarCatalogoGlobal").val() || "", this.value || "", 1, true);
        });

        $(".tabla-catalogo-global").off("scroll.catalogoGlobal").on("scroll.catalogoGlobal", function () {
            if (catalogoGlobalState.verSoloSeleccionados || catalogoGlobalState.cargandoMas || !catalogoGlobalState.hayMas) return;

            const restante = this.scrollHeight - this.scrollTop - this.clientHeight;
            if (restante > 120) return;

            snapshotCatalogoGlobalState();
            cargarPaginaCatalogoGlobal($("#txtBuscarCatalogoGlobal").val() || "", $("#selTipoCatalogoGlobal").val() || "", catalogoGlobalState.paginaActual + 1, false);
        });

        $("#chkSeleccionarTodosGlobales").off("change").on("change", function () {
            const checked = $(this).is(":checked");
            $("#tbodyCatalogoGlobal .chk-global-producto:not(:disabled)").prop("checked", checked);
            snapshotCatalogoGlobalState();
            renderEstadoCatalogoGlobalTabla();
            aplicarFiltroSeleccionadosCatalogoGlobal();
            actualizarResumenCatalogoGlobal();
        });

        $("#chkVerSoloSeleccionadosGlobales").off("change").on("change", function () {
            catalogoGlobalState.verSoloSeleccionados = $(this).is(":checked");
            aplicarFiltroSeleccionadosCatalogoGlobal();
            actualizarResumenCatalogoGlobal();
        });

        $("#modalCatalogoGlobal").off("change", ".chk-global-producto").on("change", ".chk-global-producto", function () {
            togglePrecioCatalogoGlobalFila($(this).closest("tr"), $(this).is(":checked"));
            snapshotCatalogoGlobalState();
            const $checksDisponibles = $("#tbodyCatalogoGlobal .chk-global-producto:not(:disabled)");
            const todosMarcados = $checksDisponibles.length > 0 && $checksDisponibles.filter(":checked").length === $checksDisponibles.length;
            $("#chkSeleccionarTodosGlobales").prop("checked", todosMarcados);
            renderEstadoCatalogoGlobalFila($(this).closest("tr"));
            aplicarFiltroSeleccionadosCatalogoGlobal();
            actualizarResumenCatalogoGlobal();
        });

        $("#modalCatalogoGlobal").off("dblclick", "#tbodyCatalogoGlobal tr[data-id]").on("dblclick", "#tbodyCatalogoGlobal tr[data-id]", function (e) {
            if ($(e.target).is("input, button, label, a")) return;

            const $row = $(this);
            const $chk = $row.find(".chk-global-producto");
            if (!$chk.length || $chk.is(":disabled")) return;

            $chk.prop("checked", !$chk.is(":checked")).trigger("change");
        });

        $("#modalCatalogoGlobal").off("input", ".js-codigo-destino").on("input", ".js-codigo-destino", function () {
            snapshotCatalogoGlobalState();
            renderEstadoCatalogoGlobalFila($(this).closest("tr"));
        });

        $("#modalCatalogoGlobal").off("input", ".js-precio-destino").on("input", ".js-precio-destino", function () {
            snapshotCatalogoGlobalState();
            renderEstadoCatalogoGlobalFila($(this).closest("tr"));
        });

        $("#modalCatalogoGlobal").off("click", ".js-usar-codigo-sugerido").on("click", ".js-usar-codigo-sugerido", function () {
            const $row = $(this).closest("tr");
            const sugerido = ($row.data("codigo-sugerido") || "").toString();
            const $codigo = $row.find(".js-codigo-destino");
            if ($codigo.length) {
                $codigo.val(sugerido);
                snapshotCatalogoGlobalState();
                renderEstadoCatalogoGlobalFila($row);
            }
        });

        $("#btnImportarCatalogoGlobal").off("click").on("click", function () {
            snapshotCatalogoGlobalState();
            const token = $("#formCatalogoGlobalImportacion input[name='__RequestVerificationToken']").val();
            const seleccionados = [];

            Object.keys(catalogoGlobalState.selectedIds).forEach(function (idRaw) {
                const id = parseInt(idRaw, 10);
                if (!id) return;

                seleccionados.push({
                    id: id,
                    codigoDestino: (catalogoGlobalState.codigoDestinoPorId[id] || "").toString().trim(),
                    precio: (catalogoGlobalState.precioPorId[id] || "").toString().trim()
                });
            });

            if (!seleccionados.length) {
                setAlertCatalogoGlobal("Seleccione al menos un producto para importar.");
                return;
            }

            const sinPrecio = seleccionados.filter(function (item) { return item.precio === ""; });
            if (sinPrecio.length) {
                setAlertCatalogoGlobal("Complete el precio de todos los productos seleccionados antes de importar.");
                const idFaltante = sinPrecio[0].id;
                const $inputFaltante = $('#tbodyCatalogoGlobal tr[data-id="' + idFaltante + '"] .js-precio-destino');
                if ($inputFaltante.length) {
                    togglePrecioCatalogoGlobalFila($inputFaltante.closest("tr"), true);
                }
                return;
            }

            const postData = {
                __RequestVerificationToken: token
            };

            seleccionados.forEach(function (item, index) {
                postData["Productos[" + index + "].IdProductoGlobal"] = item.id;
                postData["Productos[" + index + "].CodigoDestino"] = item.codigoDestino;
                postData["Productos[" + index + "].Precio"] = item.precio;
            });

            setAlertCatalogoGlobal("");

            $.ajax({
                url: urlImportarGlobalesProductos,
                type: "POST",
                data: postData
            }).done(function (resp) {
                if (!resp || resp.ok === false) {
                    setAlertCatalogoGlobal(resp && resp.mensaje ? resp.mensaje : "No se pudo importar la selección.");
                    return;
                }

                $("#modalCatalogoGlobal").modal("hide");
                Swal.fire("Catálogo global", resp.mensaje || "Importación realizada correctamente.", "success")
                    .then(function () {
                        window.location.reload();
                    });
            }).fail(function () {
                setAlertCatalogoGlobal("No se pudo importar la selección.");
            });
        });

        $("#btnScannerCatalogoGlobal").off("click").on("click", function () {
            if (!scannerCatalogoGlobal) {
                setScannerCatalogoGlobalMsg("Este navegador no soporta escaneo por cámara.");
                return;
            }
            resetScannerDoubleReadState(scannerCatalogoGlobalState, false);
            setScannerCatalogoGlobalMsg("");
            scannerCatalogoGlobal.iniciar().catch(function () {
                setScannerCatalogoGlobalMsg("No se pudo iniciar la cámara.");
            });
        });

        $("#btnCerrarScannerCatalogoGlobal").off("click").on("click", function () {
            setScannerCatalogoGlobalMsg("");
            cerrarScannerCatalogoGlobal(true);
        });

        $("#btnLimpiarScannerCatalogoGlobal").off("click").on("click", function () {
            limpiarScannerCatalogoGlobal();
        });

        $("#btnFlashCatalogoGlobal").off("click").on("click", async function () {
            if (!scannerCatalogoGlobal) return;
            try {
                const estado = await scannerCatalogoGlobal.toggleFlash();
                syncFlashButton("#btnFlashCatalogoGlobal", estado);
            } catch (e) { }
        });

        inicializarScannerCatalogoGlobal();

        renderEstadoCatalogoGlobalTabla();
        actualizarResumenCatalogoGlobal();
    }

    function abrirCatalogoGlobal() {
        catalogoGlobalState.selectedIds = {};
        catalogoGlobalState.codigoDestinoPorId = {};
        catalogoGlobalState.precioPorId = {};
        catalogoGlobalState.verSoloSeleccionados = false;
        cerrarScannerCatalogoGlobal(false);
        scannerCatalogoGlobal = null;
        resetScannerDoubleReadState(scannerCatalogoGlobalState, false);
        $("#modalCatalogoGlobalContent").html(getCatalogoGlobalLoadingHtml());
        $("#modalCatalogoGlobal").modal("show");

        $.get(urlVerGlobalesProductos)
            .done(function (html) {
                $("#modalCatalogoGlobalContent").html(html);
                bindCatalogoGlobalEvents();
                window.setTimeout(function () {
                    $("#txtBuscarCatalogoGlobal").trigger("focus");
                }, 150);
            })
            .fail(function () {
                $("#modalCatalogoGlobalContent").html(getCatalogoGlobalErrorHtml());
            });
