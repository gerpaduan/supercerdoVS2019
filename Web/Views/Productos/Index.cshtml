    function cargarStocksEnTabla() {
        // consulta 1 vez: devuelve { success:true, items:[{idCorte, idSucursal, stockTexto}] }
        const ids = getFilasProductos().map(f => parseInt(f.dataset.id, 10)).filter(x => !isNaN(x));
        if (!ids.length) return;

        // loading
        document.querySelectorAll(".td-stock-sucursal").forEach(td => {
            td.innerHTML = `<span class="text-muted">...</span>`;
        });

        $.ajax({
            url: '@Url.Action("GetStocksPorSucursalesTabla", "Productos")',
            type: 'POST',
            data: { ids: ids },
            traditional: true, // importante para arrays
            success: function(resp) {
                if (!resp || resp.success === false) {
                    document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                        td.innerHTML = `<span class="text-danger">Err</span>`;
                    });
                    return;
                }

                // vaciar a "—"
                document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                    td.innerHTML = `<span class="text-muted">—</span>`;
                });

                const items = resp.items || [];
                items.forEach(x => {
                    const tdId = `stk_${x.idCorte}_${x.idSucursal}`;
                    const td = document.getElementById(tdId);
                    if (td) td.innerHTML = `<span class="font-weight-bold">${x.stockTexto ?? x.stock ?? ""}</span>`;
                });
            },
            error: function() {
                document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                    td.innerHTML = `<span class="text-danger">Err</span>`;
                });
            }
        });
    }

