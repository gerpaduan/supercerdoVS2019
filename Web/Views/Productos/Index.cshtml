    (function initFiltros() {
        const saved = localStorage.getItem("filtrosAvanzadosProductos");
        const show = saved === "1";
        switchFiltros.checked = show;
        toggleFiltrosAvanzados(show);
    })();

    switchFiltros.addEventListener("change", function () {
        toggleFiltrosAvanzados(this.checked);
    });

    function aplicarFiltrosCliente() {
        const tipo = (filtroTipo?.value || "").toLowerCase();
        const marcaId = (filtroMarca?.value || "").trim();
        const cd = (filtroCodigoDesde?.value || "").trim();
        const ch = (filtroCodigoHasta?.value || "").trim();

        const codigoDesde = cd === "" ? null : parseInt(cd, 10);
        const codigoHasta = ch === "" ? null : parseInt(ch, 10);

        let visibles = 0;

        getFilasProductos().forEach(fila => {
            const fTipo = (fila.dataset.tipo || "").toLowerCase();
            const fMarcaId = (fila.dataset.marcaId || "").trim();

            const codStr = (fila.dataset.codigo || "").toString().trim();
            const codNum = parseInt(codStr, 10);

            let ok = true;

            if (tipo && fTipo !== tipo) ok = false;
            if (marcaId && fMarcaId !== marcaId) ok = false;

            if (codigoDesde !== null && !isNaN(codNum) && codNum < codigoDesde) ok = false;
            if (codigoHasta !== null && !isNaN(codNum) && codNum > codigoHasta) ok = false;

            fila.style.display = ok ? "" : "none";
            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = ok ? "" : "none";

            if (ok) visibles++;
        });

        actualizarContador(visibles);
        actualizarSeleccionados();

        // si vista completa está ON, aseguramos expandir los que quedaron visibles
        if (switchVista.checked) setVistaCompleta(true);
    }

    function recargarConFiltros() {
        const url = new URL(window.location.href);
        const params = url.searchParams;
        const modo = params.get("modo");
        const sucursalId = params.get("SucursalId");

        const nuevaUrl = new URL('@Url.Action("Index", "Productos")', window.location.origin);

        if (modo) nuevaUrl.searchParams.set("modo", modo);
        if (sucursalId) nuevaUrl.searchParams.set("SucursalId", sucursalId);

        const tipo = (filtroTipo?.value || "").trim();
        const marcaId = (filtroMarca?.value || "").trim();
        const proveedorId = (filtroProveedor?.value || "").trim();
        const codigoDesde = (filtroCodigoDesde?.value || "").trim();
        const codigoHasta = (filtroCodigoHasta?.value || "").trim();
        const fechaDesde = (filtroFechaDesde?.value || "").trim();
        const fechaHasta = (filtroFechaHasta?.value || "").trim();

        if (tipo) nuevaUrl.searchParams.set("tipo", tipo);
        if (marcaId) nuevaUrl.searchParams.set("marcaId", marcaId);
        if (proveedorId) nuevaUrl.searchParams.set("proveedorId", proveedorId);
        if (codigoDesde) nuevaUrl.searchParams.set("codigoDesde", codigoDesde);
        if (codigoHasta) nuevaUrl.searchParams.set("codigoHasta", codigoHasta);
        if (fechaDesde) nuevaUrl.searchParams.set("fechaDesde", fechaDesde);
        if (fechaHasta) nuevaUrl.searchParams.set("fechaHasta", fechaHasta);

        navegarProductosConLoader(nuevaUrl.toString());
    }

    function aplicarFiltrosAvanzados() {
        if (filtrosPendientesServidor) {
            recargarConFiltros();
            return;
        }

        aplicarFiltrosCliente();
    }

    function limpiarFiltrosAvanzados() {
        ["fTipo","fMarca","fProveedor","fCodigoDesde","fCodigoHasta","fFechaDesde","fFechaHasta"].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = "";
        });

        const url = new URL(window.location.href);
        const tieneFiltrosServidorAplicados = !!(url.searchParams.get("proveedorId")
            || url.searchParams.get("tipo")
            || url.searchParams.get("marcaId")
            || url.searchParams.get("codigoDesde")
            || url.searchParams.get("codigoHasta")
            || url.searchParams.get("fechaDesde")
            || url.searchParams.get("fechaHasta"));

        setMensajeFiltrosPendientes(false);

        if (tieneFiltrosServidorAplicados) {
            const nuevaUrl = new URL('@Url.Action("Index", "Productos")', window.location.origin);
            const modo = url.searchParams.get("modo");
            const sucursalId = url.searchParams.get("SucursalId");
            if (modo) nuevaUrl.searchParams.set("modo", modo);
            if (sucursalId) nuevaUrl.searchParams.set("SucursalId", sucursalId);
            navegarProductosConLoader(nuevaUrl.toString());
            return;
        }

        // mostrar todos
        getFilasProductos().forEach(fila => {
            fila.style.display = "";
            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = "";
        });

        actualizarContador();
        actualizarSeleccionados();

        if (switchVista.checked) setVistaCompleta(true);
    }

    [filtroTipo, filtroMarca].forEach(el => {
        el?.addEventListener("change", function () {
            aplicarFiltrosCliente();
        });
    });

    [filtroCodigoDesde, filtroCodigoHasta].forEach(el => {
        el?.addEventListener("input", function () {
            aplicarFiltrosCliente();
        });
    });

    filtroProveedor?.addEventListener("change", function () {
        setMensajeFiltrosPendientes(true);
    });

    [filtroFechaDesde, filtroFechaHasta].forEach(el => {
