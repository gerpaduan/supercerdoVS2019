    // =========================
    // MODAL PRECIO
    // =========================
    const precioModalState = {
        currentRow: null,
        currentId: 0,
        currentPrecioActual: 0,
        batchPreviewItems: [],
        batchPreviewPercent: null,
        scannerMode: false,
        scannerLocked: false,
        isOpeningVerification: false
    };
    let scannerPrecio = null;

    function normalizarTextoDecimal(valor, permitirSigno) {
        let v = (valor || "").toString();
        v = v.replace(/\./g, ",");
        v = v.replace(permitirSigno ? /[^\d,+-]/g : /[^\d,]/g, "");

        if (permitirSigno) {
            const signo = v.startsWith("-") ? "-" : (v.startsWith("+") ? "+" : "");
            v = signo + v.substring(signo ? 1 : 0).replace(/[+-]/g, "");
        }

        const partes = v.split(",");
        if (partes.length > 2) v = partes[0] + "," + partes.slice(1).join("");

        return v;
    }

    function parseDecimalEs(valor) {
        const texto = (valor || "").toString().trim();
        if (!texto) return NaN;

        const normalizado = texto.replace(/\./g, "").replace(",", ".");
        return parseFloat(normalizado);
    }

    function round2(valor) {
        return Math.round((Number(valor) + Number.EPSILON) * 100) / 100;
    }

    function formatNumberEs(valor, decimales) {
        const numero = Number(valor);
        if (!isFinite(numero)) return "";
        return numero.toLocaleString("es-AR", {
            minimumFractionDigits: decimales,
            maximumFractionDigits: decimales
        });
    }

    function formatCurrencyEs(valor) {
        return "$ " + formatNumberEs(valor, 2);
    }

    function formatPercentEs(valor) {
        const numero = Number(valor);
        if (!isFinite(numero)) return "";
        return formatNumberEs(numero, 2) + "%";
    }

    function getVisiblePriceRows() {
        return getFilasProductos().filter(fila => {
            if (fila.style.display === "none") return false;
            const boton = fila.querySelector('button[title="Modificar precio"]');
            return !!(boton && !boton.disabled);
        });
    }

    function getProductRowById(id) {
        return getFilasProductos().find(fila => Number(fila.dataset.id) === Number(id)) || null;
    }

    function getPrecioActualFila(fila) {
        if (!fila) return NaN;

        const datasetPrecio = parseFloat(fila.dataset.precio || "");
        if (isFinite(datasetPrecio)) return datasetPrecio;

        const tdPrecio = fila.querySelector('[id^="precio_"]');
        if (!tdPrecio) return NaN;
        return parseDecimalEs(tdPrecio.textContent || "");
    }

    function actualizarPrecioFila(id, precio, precioFormateado) {
        const fila = getProductRowById(id);
        if (!fila) return;

        fila.dataset.precio = String(round2(precio)).replace(",", ".");

        const tdPrecio = fila.querySelector('[id^="precio_"]');
        if (tdPrecio) {
            tdPrecio.textContent = precioFormateado || formatCurrencyEs(precio);
        }
    }

    function actualizarVariacionPrecio() {
        const $texto = $("#precioVariacion");
        const precioActual = Number(precioModalState.currentPrecioActual);
        const precioNuevo = parseDecimalEs($("#PrecioKg").val());

        if (!isFinite(precioNuevo) || precioNuevo <= 0) {
            $texto.text("Sin variación");
            return;
        }

        if (!isFinite(precioActual) || precioActual <= 0) {
            $texto.text("Sin variación");
            return;
        }

        const variacion = ((precioNuevo - precioActual) / precioActual) * 100;
        if (Math.abs(variacion) < 0.0001) {
            $texto.text("Sin variación");
        } else if (variacion > 0) {
            $texto.text("Recargo: " + formatPercentEs(variacion));
        } else {
            $texto.text("Descuento: " + formatPercentEs(Math.abs(variacion)));
        }
    }

    function syncPrecioModalVisualState() {
        const escanerActivo = $("#switchEscanerPrecio").is(":checked");
        const modificarLote = !escanerActivo && $("#switchModificarLote").is(":checked");
        const aplicarPorcentaje = modificarLote && $("#switchAplicarPorcentajeTodos").is(":checked");

        precioModalState.scannerMode = escanerActivo;

        $("#bloqueEscanerPrecio").toggleClass("d-none", !escanerActivo);
        $("#scannerPrecioContainer").toggleClass("d-none", !escanerActivo);
        $("#switchModificarLote").prop("disabled", escanerActivo);
        $("#bloqueModificarLote").toggleClass("d-none", !modificarLote);
        $("#bloqueAplicarPorcentajeTodos").toggleClass("d-none", !aplicarPorcentaje);
        $(".js-precio-individual-block").toggleClass("d-none", aplicarPorcentaje);

        $("#btnGuardarPrecioTexto").text(aplicarPorcentaje ? "Verificar cambios" : "Guardar");
        $("#btnGuardarPrecio i")
            .toggleClass("fa-save", !aplicarPorcentaje)
            .toggleClass("fa-clipboard-check", aplicarPorcentaje);
    }

    function limpiarErroresPrecioModal() {
        $("#errorPrecio, #errorPorcentajeLote, #scannerPrecioMsg").addClass("d-none");
    }

    function setScannerPrecioMsg(texto) {
        const $msg = $("#scannerPrecioMsg");
        if (!texto) {
            $msg.addClass("d-none").text("");
        } else {
            $msg.removeClass("d-none").text(texto);
        }
    }

    function resetScannerPrecioFields() {
        precioModalState.currentRow = null;
        precioModalState.currentId = 0;
        precioModalState.currentPrecioActual = 0;
        precioModalState.scannerLocked = false;
        $("#IdCorte").val("");
        $("#CorteDesc").val("");
        $("#PrecioActual").val("");
        $("#PrecioKg").val("");
        $("#CodigoPrecio").val("");
        $("#precioVariacion").text("Sin variación");
        $("#errorPrecio").addClass("d-none");
        setScannerPrecioMsg("");
    }

    function aplicarDatosPrecioModal(resp, fallbackNombre, fallbackPrecio) {
        const descripcion = (resp && resp.descripcion) ? resp.descripcion : fallbackNombre;
        const precioActual = resp && isFinite(Number(resp.precio)) ? Number(resp.precio) : Number(fallbackPrecio);
        const precioNormalizado = isFinite(precioActual) ? round2(precioActual) : 0;

        precioModalState.currentPrecioActual = precioNormalizado;

        $("#CorteDesc").val(descripcion || "");
        $("#PrecioActual").val(formatCurrencyEs(precioNormalizado));
        $("#PrecioKg").val(formatNumberEs(precioNormalizado, 2));
        actualizarVariacionPrecio();
    }

    function cargarProductoPrecioDesdeCodigo(codigoRaw) {
        const codigo = (codigoRaw || "").toString().replace(/\D/g, "");
        if (!codigo) {
            setScannerPrecioMsg("Ingrese un código válido.");
            $("#CodigoPrecio").focus().select();
            return;
        }

        if (precioModalState.scannerLocked) return;

        setScannerPrecioMsg("");

        $.ajax({
            url: '@Url.Action("FindCorteByCodigo", "Productos")',
            type: 'GET',
            data: { codigo: codigo },
            success: function (resp) {
                if (!resp || !resp.existe || !resp.id) {
                    precioModalState.scannerLocked = false;
                    $("#IdCorte").val("");
                    $("#CorteDesc").val("");
                    $("#PrecioActual").val("");
                    $("#PrecioKg").val("");
                    $("#precioVariacion").text("Sin variación");
                    setScannerPrecioMsg("Producto no encontrado");
                    $("#CodigoPrecio").focus().select();
                    return;
                }

                precioModalState.scannerLocked = true;
                precioModalState.currentId = Number(resp.id);
                precioModalState.currentPrecioActual = round2(Number(resp.precio) || 0);
                precioModalState.currentRow = getProductRowById(resp.id);

                $("#IdCorte").val(resp.id);
                $("#CodigoPrecio").val(codigo);
                $("#CorteDesc").val(resp.descripcion || resp.nombre || "");
                $("#PrecioActual").val(formatCurrencyEs(precioModalState.currentPrecioActual));
                $("#PrecioKg").val(formatNumberEs(precioModalState.currentPrecioActual, 2));
                actualizarVariacionPrecio();
                setScannerPrecioMsg("");

                setTimeout(function () {
                    focusNuevoPrecio();
                }, 40);
            },
            error: function () {
                precioModalState.scannerLocked = false;
                setScannerPrecioMsg("Producto no encontrado");
                $("#CodigoPrecio").focus().select();
            }
        });
    }

    function focusNuevoPrecio() {
        const inp = document.getElementById("PrecioKg");
        if (!inp || $("#PrecioKg").closest(".js-precio-individual-block").hasClass("d-none")) return;
        inp.focus();
        inp.select();
    }

    function focusCodigoPrecio() {
        const inp = document.getElementById("CodigoPrecio");
        if (!inp || $("#bloqueEscanerPrecio").hasClass("d-none")) return;
        inp.focus();
        inp.select();
    }

    function focusPorcentajeLote() {
        const inp = document.getElementById("PorcentajeLote");
        if (!inp || $("#bloqueAplicarPorcentajeTodos").hasClass("d-none")) return;
        inp.focus();
        inp.select();
    }

    function abrirModalPrecioParaFila(fila, opciones) {
        const opts = opciones || {};
        if (!fila) return;

        limpiarErroresPrecioModal();

        if (!opts.preserveBatchState) {
            $("#switchEscanerPrecio").prop("checked", false);
            $("#switchModificarLote").prop("checked", false);
            $("#switchAplicarPorcentajeTodos").prop("checked", false);
            $("#PorcentajeLote").val("");
            resetScannerPrecioFields();
        }

        precioModalState.currentRow = fila;
        precioModalState.currentId = Number(fila.dataset.id || 0);

        syncPrecioModalVisualState();
        $("#IdCorte").val(precioModalState.currentId);
        $("#modalPrecio").modal("show");

        const fallbackNombre = fila.dataset.nombre || "";
        const fallbackPrecio = getPrecioActualFila(fila) || 0;
        aplicarDatosPrecioModal(null, fallbackNombre, fallbackPrecio);

        $.ajax({
            url: '@Url.Action("findCorteById", "Productos")',
            type: 'GET',
            data: { id: precioModalState.currentId },
            success: function (resp) {
                aplicarDatosPrecioModal(resp, fallbackNombre, fallbackPrecio);
                setTimeout(function () {
                    if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
                        focusPorcentajeLote();
                    } else {
                        focusNuevoPrecio();
                    }
                }, 80);
            },
            error: function () {
                setTimeout(function () {
                    focusNuevoPrecio();
                }, 80);
            }
        });
    }

    function abrirPopupPrecio(id, nombreTabla, precioTabla, button) {
        const fila = button ? button.closest("tr") : getProductRowById(id);
        if (!fila) return;
        abrirModalPrecioParaFila(fila, { preserveBatchState: false });
    }

    function getPrecioFormPayload(id, precioRaw) {
        return {
            __RequestVerificationToken: $("#formPrecio input[name='__RequestVerificationToken']").val(),
            IdCorte: id,
            PrecioKg: precioRaw
        };
    }

    function postEditarPrecio(id, precioRaw) {
        return $.ajax({
            url: '@Url.Action("EditPrecioCorte", "Productos")',
            type: 'POST',
            data: getPrecioFormPayload(id, precioRaw)
        });
    }

    function getPrecioValidoDesdeInput() {
        let precioRaw = ($("#PrecioKg").val() || "").trim();
        if (precioRaw === "") return null;

        precioRaw = normalizarTextoDecimal(precioRaw, false);
        const numero = parseDecimalEs(precioRaw);
        if (!isFinite(numero) || numero <= 0) return null;

        const normalizado = formatNumberEs(round2(numero), 2);
        $("#PrecioKg").val(normalizado);
        return {
            raw: normalizado,
            numero: round2(numero)
        };
    }

    function getPorcentajeLoteValido() {
        let valor = ($("#PorcentajeLote").val() || "").trim();
        if (!valor) return null;

        valor = normalizarTextoDecimal(valor, true);
        $("#PorcentajeLote").val(valor);

        const numero = parseDecimalEs(valor);
        if (!isFinite(numero) || numero === 0) return null;

        return numero;
    }

    function avanzarSiguienteProductoLote() {
        const filas = getVisiblePriceRows();
        const idActual = Number(precioModalState.currentId);
        const indexActual = filas.findIndex(fila => Number(fila.dataset.id) === idActual);
        const siguiente = indexActual >= 0 ? filas[indexActual + 1] : null;

        if (!siguiente) {
            $("#modalPrecio").modal("hide");
            Swal.fire("Sin más productos", "No hay más productos para modificar con los filtros actuales", "info");
            return;
        }

        abrirModalPrecioParaFila(siguiente, { preserveBatchState: true });
    }

    function construirItemsPreviewPorcentaje(porcentaje) {
        return getVisiblePriceRows().map(fila => {
            const precioAnterior = getPrecioActualFila(fila);
            const nuevoPrecio = isFinite(precioAnterior)
                ? round2(precioAnterior * (1 + (porcentaje / 100)))
                : 0;

            return {
                id: Number(fila.dataset.id),
                nombre: fila.dataset.nombre || "",
                precioAnterior: isFinite(precioAnterior) ? round2(precioAnterior) : 0,
                precioNuevo: nuevoPrecio
            };
        });
    }

    function renderPreviewMasivo() {
        const $tbody = $("#tablaVerificarPrecios tbody");
        $tbody.empty();
        $("#errorPreviewMasivo").addClass("d-none");

        if (precioModalState.batchPreviewPercent === null || !isFinite(precioModalState.batchPreviewPercent)) {
            $("#infoPorcentajePreview").addClass("d-none").text("");
        } else {
            const porcentajeTexto = (precioModalState.batchPreviewPercent > 0 ? "+" : "") + formatPercentEs(precioModalState.batchPreviewPercent);
            $("#infoPorcentajePreview").removeClass("d-none").text("Porcentaje aplicado: " + porcentajeTexto);
        }

        if (!precioModalState.batchPreviewItems.length) {
            $tbody.append('<tr class="js-empty"><td colspan="4" class="text-center text-muted py-4">Sin cambios para verificar.</td></tr>');
            return;
        }

        precioModalState.batchPreviewItems.forEach(function (item) {
            const fila = [
                '<tr data-id="', item.id, '">',
                '<td>', $('<div>').text(item.nombre).html(), '</td>',
                '<td class="text-right js-precio-anterior">', formatCurrencyEs(item.precioAnterior), '</td>',
                '<td><input type="text" class="form-control form-control-sm js-precio-nuevo text-right" value="', formatNumberEs(item.precioNuevo, 2), '" autocomplete="off" inputmode="decimal"></td>',
                '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-preview" title="Quitar"><i class="fas fa-trash"></i></button></td>',
                '</tr>'
            ].join('');
            $tbody.append(fila);
        });
    }

    function abrirModalVerificacionPorcentaje() {
        const porcentaje = getPorcentajeLoteValido();
        if (porcentaje === null) {
            $("#errorPorcentajeLote").removeClass("d-none");
            return;
        }

        limpiarErroresPrecioModal();
        precioModalState.batchPreviewPercent = porcentaje;
        precioModalState.batchPreviewItems = construirItemsPreviewPorcentaje(porcentaje);
        if (!precioModalState.batchPreviewItems.length) {
            Swal.fire("Atención", "No hay productos visibles para modificar con los filtros actuales.", "info");
            return;
        }
        renderPreviewMasivo();
        precioModalState.isOpeningVerification = true;

        $("#modalPrecio").one("hidden.bs.modal.batchVerify", function () {
            $("#modalVerificarPrecios").modal("show");
            precioModalState.isOpeningVerification = false;
        });

        $("#modalPrecio").modal("hide");
    }

    function guardarPrecio() {
        const escanerActivo = $("#switchEscanerPrecio").is(":checked");
        const modificarLote = $("#switchModificarLote").is(":checked");
        const aplicarPorcentaje = modificarLote && $("#switchAplicarPorcentajeTodos").is(":checked");

        if (!escanerActivo && aplicarPorcentaje) {
            abrirModalVerificacionPorcentaje();
            return;
        }

        if (escanerActivo && !precioModalState.currentId) {
            setScannerPrecioMsg("Primero escanee o ingrese un código válido.");
            focusCodigoPrecio();
            return;
        }

        const precioValido = getPrecioValidoDesdeInput();
        if (!precioValido) {
            $("#errorPrecio").removeClass("d-none");
            return;
        }

        limpiarErroresPrecioModal();

        postEditarPrecio(precioModalState.currentId, precioValido.raw)
            .done(function (resp) {
                if (!manejarPermiso(resp)) return;
                actualizarPrecioFila(resp.id, resp.precio, resp.precioFormateado);

                if (escanerActivo) {
                    resetScannerPrecioFields();
                    focusCodigoPrecio();
                } else if (modificarLote) {
                    avanzarSiguienteProductoLote();
                } else {
                    $("#modalPrecio").modal("hide");
                }
            })
            .fail(function () {
                Swal.fire("Error", "Error al actualizar el precio.", "error");
            });
    }

    function obtenerPreviewDesdeTabla() {
        return $("#tablaVerificarPrecios tbody tr").not(".js-empty").map(function () {
            const $tr = $(this);
            const id = Number($tr.data("id"));
            const nombre = ($tr.children().eq(0).text() || "").trim();
            const precioAnterior = parseDecimalEs($tr.find(".js-precio-anterior").text());
            const precioNuevoRaw = ($tr.find(".js-precio-nuevo").val() || "").trim();
            const precioNuevo = parseDecimalEs(precioNuevoRaw);

            return {
                id: id,
                nombre: nombre,
                precioAnterior: precioAnterior,
                precioNuevoRaw: normalizarTextoDecimal(precioNuevoRaw, false),
                precioNuevo: precioNuevo
            };
        }).get();
    }

    function clearPreviewValidation() {
        $("#errorPreviewMasivo").addClass("d-none");
        $("#tablaVerificarPrecios tbody tr").removeClass("table-warning");
        $("#tablaVerificarPrecios .js-precio-nuevo").removeClass("is-invalid");
    }

    function markPreviewInvalidRows(items) {
        clearPreviewValidation();

        const invalidos = items.filter(item => !isFinite(item.precioNuevo) || item.precioNuevo <= 0);
        if (!invalidos.length) return [];

        invalidos.forEach(function (item) {
            const $tr = $('#tablaVerificarPrecios tbody tr[data-id="' + item.id + '"]');
            $tr.addClass("table-warning");
            $tr.find(".js-precio-nuevo").addClass("is-invalid");
        });

        $("#errorPreviewMasivo").removeClass("d-none");
        return invalidos;
    }

    function quitarPreviewInvalidos() {
        const items = obtenerPreviewDesdeTabla();
        const invalidos = items.filter(item => !isFinite(item.precioNuevo) || item.precioNuevo <= 0);

        if (!invalidos.length) {
            Swal.fire("Sin cambios", "No hay cortes con precio 0 o inválido para quitar.", "info");
            return;
        }

        invalidos.forEach(function (item) {
            $('#tablaVerificarPrecios tbody tr[data-id="' + item.id + '"]').remove();
        });

        clearPreviewValidation();

        if (!$("#tablaVerificarPrecios tbody tr").not(".js-empty").length) {
            precioModalState.batchPreviewItems = [];
            renderPreviewMasivo();
            return;
        }

        const primerInput = $("#tablaVerificarPrecios tbody .js-precio-nuevo").get(0);
        focusPrecioPreviewInput(primerInput);
    }

    function guardarCambiosMasivos() {
        const items = obtenerPreviewDesdeTabla();

        if (!items.length) {
            Swal.fire("Atención", "No hay productos para guardar.", "info");
            return;
        }

        const invalidos = markPreviewInvalidRows(items);
        if (invalidos.length) {
            const primerInvalido = $('#tablaVerificarPrecios tbody tr[data-id="' + invalidos[0].id + '"] .js-precio-nuevo').get(0);
            focusPrecioPreviewInput(primerInvalido);
            return;
        }

        const $btn = $("#btnGuardarCambiosMasivos");
        $btn.prop("disabled", true);

        let cadena = Promise.resolve();
        items.forEach(function (item) {
            cadena = cadena.then(function () {
                return postEditarPrecio(item.id, formatNumberEs(round2(item.precioNuevo), 2)).then(function (resp) {
                    if (!manejarPermiso(resp)) {
                        throw new Error("permiso");
                    }
                    actualizarPrecioFila(resp.id, resp.precio, resp.precioFormateado);
                });
            });
        });

        cadena.then(function () {
            $("#modalVerificarPrecios").modal("hide");
            Swal.fire("Guardado", "Se actualizaron los precios seleccionados.", "success");
        }, function (err) {
            if (err && err.message === "permiso") return;
            Swal.fire("Error", "Ocurrió un problema al guardar los cambios masivos.", "error");
        }).then(function () {
            $btn.prop("disabled", false);
        });
    }

    function focusPrecioPreviewInput(input) {
        if (!input) return;
        input.focus();
        input.select();
    }

    function focusNextPrecioPreviewInput(currentInput) {
        const inputs = $("#tablaVerificarPrecios tbody .js-precio-nuevo").toArray();
        if (!inputs.length) return;

        const indexActual = inputs.indexOf(currentInput);
        const nextInput = indexActual >= 0 && indexActual < inputs.length - 1
            ? inputs[indexActual + 1]
            : inputs[0];

        focusPrecioPreviewInput(nextInput);
    }

    $('#modalPrecio').on('shown.bs.modal', function () {
        if ($("#switchEscanerPrecio").is(":checked")) {
            focusCodigoPrecio();
            return;
        }
        if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
            focusPorcentajeLote();
            return;
        }
        focusNuevoPrecio();
    });

    $('#modalPrecio').on('hidden.bs.modal', function () {
        $("#PrecioKg, #PrecioActual, #CorteDesc, #PorcentajeLote").val("");
        limpiarErroresPrecioModal();
        resetScannerPrecioFields();
        if (scannerPrecio) {
            try { scannerPrecio.cerrar(); } catch (e) { }
        }
        if (!precioModalState.isOpeningVerification) {
            $("#switchEscanerPrecio").prop("checked", false);
            $("#switchModificarLote").prop("checked", false);
            $("#switchAplicarPorcentajeTodos").prop("checked", false);
            syncPrecioModalVisualState();
        }
    });

    $('#modalVerificarPrecios').on('hidden.bs.modal', function () {
        precioModalState.batchPreviewItems = [];
        precioModalState.batchPreviewPercent = null;
        renderPreviewMasivo();
    });

    document.addEventListener("DOMContentLoaded", function () {
        const inputPrecio = document.getElementById("PrecioKg");
        const inputPorcentaje = document.getElementById("PorcentajeLote");
        const inputCodigoPrecio = document.getElementById("CodigoPrecio");
        if (!inputPrecio) return;

        inputPrecio.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                guardarPrecio();
            }
        });

        inputPrecio.addEventListener("input", function () {
            this.value = normalizarTextoDecimal(this.value, false);
            actualizarVariacionPrecio();
            $("#errorPrecio").addClass("d-none");
        });

        if (inputPorcentaje) {
            inputPorcentaje.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    guardarPrecio();
                }
            });

            inputPorcentaje.addEventListener("input", function () {
                this.value = normalizarTextoDecimal(this.value, true);
                $("#errorPorcentajeLote").addClass("d-none");
            });
        }

        if (inputCodigoPrecio) {
            inputCodigoPrecio.addEventListener("input", function () {
                this.value = (this.value || "").replace(/\D/g, "");
                setScannerPrecioMsg("");
            });

            inputCodigoPrecio.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    cargarProductoPrecioDesdeCodigo(this.value);
                }
            });
        }

        $("#switchEscanerPrecio, #switchModificarLote, #switchAplicarPorcentajeTodos").on("change", function () {
            if ($("#switchEscanerPrecio").is(":checked")) {
                $("#switchModificarLote").prop("checked", false);
                $("#switchAplicarPorcentajeTodos").prop("checked", false);
                $("#PorcentajeLote").val("");
                resetScannerPrecioFields();
            }

            if (!$("#switchModificarLote").is(":checked")) {
                $("#switchAplicarPorcentajeTodos").prop("checked", false);
                $("#PorcentajeLote").val("");
            }

            syncPrecioModalVisualState();

            if ($("#switchEscanerPrecio").is(":checked")) {
                setTimeout(focusCodigoPrecio, 40);
            } else if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
                setTimeout(focusPorcentajeLote, 40);
            } else {
                setTimeout(focusNuevoPrecio, 40);
            }
        });

        $("#tablaVerificarPrecios").on("input", ".js-precio-nuevo", function () {
            this.value = normalizarTextoDecimal(this.value, false);
            $(this).removeClass("is-invalid");
            $(this).closest("tr").removeClass("table-warning");
            if (!$("#tablaVerificarPrecios .js-precio-nuevo.is-invalid").length) {
                $("#errorPreviewMasivo").addClass("d-none");
            }
        });

        $("#tablaVerificarPrecios").on("keydown", ".js-precio-nuevo", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                focusNextPrecioPreviewInput(this);
            }
        });

        $("#tablaVerificarPrecios").on("click", ".js-remove-preview", function () {
            $(this).closest("tr").remove();
            if (!$("#tablaVerificarPrecios tbody tr").not(".js-empty").length) {
                precioModalState.batchPreviewItems = [];
                renderPreviewMasivo();
            }
        });

        $("#btnGuardarCambiosMasivos").on("click", guardarCambiosMasivos);
        $("#btnQuitarPreciosCero").on("click", quitarPreviewInvalidos);

        if (typeof BarcodeScanner !== "undefined") {
            scannerPrecio = new BarcodeScanner({
                videoSelector: "#videoScannerPrecio",
                containerSelector: "#scannerPrecioContainer",
                onCodeDetected: function (codigoLeido) {
                    if (!$("#switchEscanerPrecio").is(":checked")) return;
                    if (precioModalState.scannerLocked) return;
                    const codigo = String(codigoLeido || "").replace(/\D/g, "");
                    if (!codigo) return;
                    $("#CodigoPrecio").val(codigo);
                    cargarProductoPrecioDesdeCodigo(codigo);
                }
            });
        }

        $("#btnScannerPrecio").on("click", function () {
            if (!scannerPrecio) {
                setScannerPrecioMsg("Este navegador no soporta escaneo por cámara.");
                focusCodigoPrecio();
                return;
            }
            setScannerPrecioMsg("");
            scannerPrecio.iniciar().catch(function () {
                setScannerPrecioMsg("No se pudo iniciar la cámara.");
            });
        });

        $("#btnCerrarScannerPrecio").on("click", function () {
            if (scannerPrecio) scannerPrecio.cerrar();
        });

        $("#btnFlashScannerPrecio").on("click", async function () {
            if (!scannerPrecio) return;
            try {
                const estado = await scannerPrecio.toggleFlash();
                this.classList.toggle("btn-warning", !!estado);
                this.classList.toggle("btn-secondary", !estado);
                this.textContent = estado ? "🔦 Flash ON" : "🔦 Flash";
            } catch (e) { }
        });
    });

    // =========================
    // VER / EDITAR STOCK MODAL
    // =========================
    const stockModalState = {
        currentRow: null,
        currentId: 0
    };

    function verStockSucursales(idCorte, nombre, boton) {
        const fila = boton ? boton.closest("tr") : getProductRowById(idCorte);
        stockModalState.currentRow = fila || null;
        stockModalState.currentId = Number(idCorte);

        $("#contenedorStockSucursalesProducto").html(`<div class="text-muted text-center py-4">Sin datos</div>`);
        $("#stockLoading").removeClass("d-none");

        $("#modalStockSucursales").modal("show");

        $.ajax({
            url: '@Url.Action("StockPorSucursalesProducto", "Stock")',
            type: 'GET',
            data: { idCorte: idCorte },
            success: function (html) {

                $("#stockLoading").addClass("d-none");
                $("#contenedorStockSucursalesProducto").html(html || '<div class="text-danger text-center py-4">No se pudo obtener el stock.</div>');
            },
            error: function () {
                $("#stockLoading").addClass("d-none");
                $("#contenedorStockSucursalesProducto").html(`<div class="text-danger text-center py-4">Error al consultar el stock.</div>`);
            }
        });
    }

    function getVisibleStockRows() {
        return getFilasProductos().filter(fila => {
            if (fila.style.display === "none") return false;
            const boton = fila.querySelector(".js-btn-stock-sucursales");
            return !!(boton && !boton.disabled);
        });
    }

    function avanzarSiguienteProductoLotePuntoStock() {
        const filas = getVisibleStockRows();
        const idActual = Number(stockModalState.currentId);
        const indexActual = filas.findIndex(fila => Number(fila.dataset.id) === idActual);
        const siguiente = indexActual >= 0 ? filas[indexActual + 1] : null;

        if (!siguiente) {
            $("#modalStockSucursales").modal("hide");
            Swal.fire("Sin más productos", "No hay más productos para modificar con los filtros actuales", "info");
            return;
        }

        const boton = siguiente.querySelector(".js-btn-stock-sucursales");
        const nombreSiguiente = siguiente.dataset.nombre || "";
        verStockSucursales(Number(siguiente.dataset.id), nombreSiguiente, boton);
    }

    $("#modalStockSucursales").on("hidden.bs.modal", function () {
        window.modoLotePuntoStockActivo = false;
    });

    // =========================
    // ELIMINAR
    // =========================
    function confirmarEliminar(id, nombre) {
        Swal.fire({
            title: "¿Eliminar producto?",
            text: `Se eliminará: ${nombre}`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar",
            reverseButtons: true,
            focusCancel: true
        }).then(r => {
            if (!r.isConfirmed) return;
            $("#EliminarId").val(id);
            $("#formEliminar").submit();
        });
    }

    // init contador seleccionados (si está modo etiquetas)
    actualizarSeleccionados();

        // =========================
        // PROTECCIÓN SALIDA (modo etiquetas) - SAFE
        // =========================
        function _setProteccionSalida(valor) {
            // preferimos usar tus funciones del layout si están
            if (valor) {
                if (typeof window.activarProteccionSalida === "function") {
                    window.activarProteccionSalida();
                } else {
                    window.__protegerSalida = true;
                }
            } else {
                if (typeof window.desactivarProteccionSalida === "function") {
                    window.desactivarProteccionSalida();
                } else {
                    window.__protegerSalida = false;
                }
            }
        }

        function updateExitProtectionEtiquetas() {
            // Solo aplica si estamos en modo etiquetas (o al menos existe la UI)
            const hayModoEtiquetas = document.querySelector(".chk-etiqueta") != null
                || document.getElementById("lblSeleccionados") != null;

            if (!hayModoEtiquetas) return;

            const checked = document.querySelectorAll(".chk-etiqueta:checked").length;
            _setProteccionSalida(checked > 0);
        }

        // Ejecutar cuando el DOM ya está listo
        document.addEventListener("DOMContentLoaded", function () {
            updateExitProtectionEtiquetas();

            // Cada cambio de checkbox recalcula
            document.addEventListener("change", function (e) {
                if (e.target && e.target.classList.contains("chk-etiqueta")) {
                    updateExitProtectionEtiquetas();
                }
            });
        });

        // Si tu función seleccionarTodos existe, la envolvemos sin romper
        if (typeof window.seleccionarTodos === "function") {
            const _seleccionarTodosOriginal = window.seleccionarTodos;
            window.seleccionarTodos = function (estado) {
                _seleccionarTodosOriginal(estado);
                updateExitProtectionEtiquetas();
            };
        }

        // Si tu función actualizarSeleccionados existe, la envolvemos
        if (typeof window.actualizarSeleccionados === "function") {
            const _actualizarSeleccionadosOriginal = window.actualizarSeleccionados;
            window.actualizarSeleccionados = function () {
                _actualizarSeleccionadosOriginal();
                updateExitProtectionEtiquetas();
            };
        }

        document.addEventListener("click", function (event) {
            const link = event.target.closest ? event.target.closest(".productos-wrap a[href]") : null;
            if (!link) return;
            if (link.target === "_blank" || link.hasAttribute("download")) return;

            const href = link.getAttribute("href") || "";
            if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

            event.preventDefault();
            navegarProductosConLoader(link.href);
        });

            (function () {
                document.addEventListener('keydown', function (e) {
                    // Solo atajos con SHIFT (sin Ctrl / Alt / Meta)
                    if (!e.shiftKey || e.ctrlKey || e.altKey || e.metaKey) return;

                    // No activar si el usuario está escribiendo en un input/textarea/select o contenido editable
                    const target = e.target;
                    const tag = (target.tagName || '').toLowerCase();
                    const isEditable =
                        tag === 'input' ||
                        tag === 'textarea' ||
                        tag === 'select' ||
                        target.isContentEditable;

                    if (isEditable) return;

                    // Obtener letra presionada (ej: Shift+N => "n")
                    const key = (e.key || '').toLowerCase();
                    if (!key || key.length !== 1) return;

                    // Buscar botón/link con data-hotkey igual a la tecla
                    const selector = `[data-hotkey="${key}"]`;
                    const btn = document.querySelector(selector);

                    // Si no existe o está oculto/deshabilitado, salir
                    if (!btn) return;
                    if (btn.disabled) return;
                    if (btn.offsetParent === null) return; // oculto (display:none)

                    // Evitar comportamiento por defecto y ejecutar click
                    e.preventDefault();
                    btn.click();
                });
        })();

    </script>
}

