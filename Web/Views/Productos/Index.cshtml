@model List<Entidades.Corte>

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    var modo = (Request["modo"] ?? "").ToString().ToLower();
    bool modoEtiquetas = (modo == "etiquetas");

    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    var sucursalIdSeleccionada = (ViewBag.SucursalId != null) ? (int)ViewBag.SucursalId : 0;
    bool puedeEditarProducto = ViewBag.PuedeEditarProducto != null && (bool)ViewBag.PuedeEditarProducto;
    bool puedeModificarPreciosProducto = ViewBag.PuedeModificarPreciosProducto != null && (bool)ViewBag.PuedeModificarPreciosProducto;
    bool puedeEliminarProducto = ViewBag.PuedeEliminarProducto != null && (bool)ViewBag.PuedeEliminarProducto;
    var filtroTipoActual = (Request["tipo"] ?? "").ToString();
    int filtroMarcaActual = 0;
    int.TryParse((Request["marcaId"] ?? "0").ToString(), out filtroMarcaActual);
    int filtroProveedorActual = 0;
    int.TryParse((Request["proveedorId"] ?? "0").ToString(), out filtroProveedorActual);
    var filtroCodigoDesdeActual = (Request["codigoDesde"] ?? "").ToString();
    var filtroCodigoHastaActual = (Request["codigoHasta"] ?? "").ToString();
}

<div class="container-fluid productos-wrap">

    <!-- =========================
         TOOLBAR (acciones globales)
         ========================= -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
            <div class="d-flex flex-wrap gap-2">

                <a id="lnkNuevoCorte"
                   data-hotkey="n"
                   class="btn btn-primary"
                   href="@Url.Action("AddOrEdit", "Productos")"
                   title="Atajo: Shift + N">
                    <i class="fas fa-plus mr-1"></i> <span class="atajo-letra">N</span>uevo
                </a>

                <a id="lnkTipos"
                   data-hotkey="t"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Tipos", "Productos")"
                   title="Atajo: Shift + T">
                    <i class="fas fa-tags mr-1"></i> <span class="atajo-letra">T</span>ipos
                </a>

                <a id="lnkMarcas"
                   data-hotkey="m"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Marcas", "Productos")"
                   title="Atajo: Shift + M">
                    <i class="fas fa-industry mr-1"></i> <span class="atajo-letra">M</span>arcas
                </a>

                <a id="lnkEtiquetas"
                   data-hotkey="e"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Index", "Productos", new { modo = "etiquetas" })"
                   title="Atajo: Shift + E">
                    <i class="fas fa-barcode mr-1"></i> <span class="atajo-letra">E</span>tiquetas (PDF)
                </a>

                @if (modoEtiquetas)
                {
                    <a id="lnkVolver"
                       data-hotkey="v"
                       class="btn btn-outline-dark"
                       href="@Url.Action("Index", "Productos")"
                       title="Atajo: Shift + V">
                        <i class="fas fa-arrow-left mr-1"></i> <span class="atajo-letra">V</span>olver
                    </a>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">

            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="switchVistaCompleta">
                <label class="custom-control-label" for="switchVistaCompleta">Vista completa</label>
            </div>

            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="switchFiltrosAvanzados">
                <label class="custom-control-label" for="switchFiltrosAvanzados">Filtros avanzados</label>
            </div>

        </div>
    </div>

    <!-- =========================
         FILTRO SUCURSAL (columna stock simple)
         ========================= -->
    @*<form method="get" id="formStock" class="mb-3" action="@Url.Action("Index","Productos")">
        <input type="hidden" name="modo" value="@(modoEtiquetas ? "etiquetas" : "")" />
        <div class="form-group mb-0">
            <label class="font-weight-bold mb-1">Stock por sucursal (columna simple)</label>
            <select class="form-control" id="SucursalId" name="SucursalId"
                    onchange="document.getElementById('formStock').submit()">
                <option value="">- Seleccione sucursal -</option>

                @foreach (var s in sucursales)
                {
                    <option value="@s.IdSucursal" @(sucursalIdSeleccionada == s.IdSucursal ? "selected" : "")>
                        @s.SucursalNombre
                    </option>
                }
            </select>
            <small class="text-muted">
                Tip: si activás <b>Ver stock sucursales</b>, se agregan columnas por cada sucursal.
            </small>
        </div>
    </form>*@

    <!-- =========================
         BUSCADOR + contador
         ========================= -->
    <div class="row mb-2">
        <div class="col-lg-6 col-md-8">
            <div class="input-group">
                <input type="text" id="buscador" class="form-control" placeholder="Buscar por código o nombre...">
                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>
            <div class="mt-2">
                <span id="contadorProductos" class="text-secondary font-weight-bold"></span>
            </div>
        </div>
    </div>

    <!-- =========================
         FILTROS AVANZADOS (cliente)
         ========================= -->
    <div id="panelFiltrosAvanzados" class="card shadow-sm mb-3 d-none">
        <div class="card-body py-3">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Tipo</label>
                    <select class="form-control" id="fTipo">
                        <option value="">(Todos)</option>
                        @if (ViewBag.Tipos != null)
                        {
                            foreach (var t in (IEnumerable<SelectListItem>)ViewBag.Tipos)
                            {
                                <option value="@t.Value" @(string.Equals(t.Value, filtroTipoActual, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@t.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Marca</label>
                    <select class="form-control" id="fMarca">
                        <option value="">(Todas)</option>
                        @if (ViewBag.Marcas != null)
                        {
                            foreach (var m in (IEnumerable<SelectListItem>)ViewBag.Marcas)
                            {
                                <option value="@m.Value" @(m.Value == filtroMarcaActual.ToString() ? "selected" : "")>@m.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Proveedor</label>
                    <select class="form-control" id="fProveedor">
                        <option value="">(Todos)</option>
                        @if (ViewBag.Proveedores != null)
                        {
                            foreach (var p in (IEnumerable<SelectListItem>)ViewBag.Proveedores)
                            {
                                <option value="@p.Value" @(p.Value == filtroProveedorActual.ToString() ? "selected" : "")>@p.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Código</label>
                    <div class="d-flex align-items-center">
                        <input class="form-control" id="fCodigoDesde" placeholder="Desde" inputmode="numeric" value="@filtroCodigoDesdeActual">
                        <span class="px-2 text-muted font-weight-bold">/</span>
                        <input class="form-control" id="fCodigoHasta" placeholder="Hasta" inputmode="numeric" value="@filtroCodigoHastaActual">
                    </div>
                </div>

                <div class="col-12 mt-2">
                    <div id="mensajeFiltrosPendientes" class="alert alert-warning py-2 px-3 mb-2 d-none">
                        Se modificaron filtros. Presione Aplicar para actualizar los datos.
                    </div>
                </div>

                <div class="col-12 d-flex flex-wrap align-items-center">
                    <button type="button" class="btn btn-sm btn-primary" onclick="aplicarFiltrosAvanzados()">
                        <i class="fas fa-filter mr-1"></i> Aplicar
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ml-2" onclick="limpiarFiltrosAvanzados()">
                        <i class="fas fa-undo mr-1"></i> Limpiar
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- =========================
         CARD TABLA
         ========================= -->
    <div class="card shadow mb-4 tabla-card">
        @if (modoEtiquetas)
        {
            <!-- Barra modo etiquetas -->
            <div class="d-flex flex-wrap justify-content-between align-items-center p-2 border-bottom bg-white">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="seleccionarTodos(true)">
                        <i class="fas fa-check-square mr-1"></i> Tildar todos
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="seleccionarTodos(false)">
                        <i class="fas fa-square mr-1"></i> Destildar todos
                    </button>

                    <span class="text-muted ml-2" id="lblSeleccionados">0 seleccionados</span>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" onclick="generarEtiquetas()">
                        <i class="fas fa-file-pdf mr-1"></i> Generar etiquetas
                    </button>
                </div>
            </div>

            <form id="formEtiquetas" method="post" action="@Url.Action("GenerarEtiquetasPdf", "Productos")" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ids" id="idsEtiquetas" />
            </form>
        }

    <div class="card-body p-0">
        @if (TempData["FlashSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["FlashSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["FlashError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["FlashError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive tabla-full">
            <table class="table table-bordered table-striped tabla-productos mb-0" id="tablaProductos">

                <thead class="thead-dark">
                    <tr>
                        @if (modoEtiquetas)
                        {
                            <th style="width:42px;" class="text-center">✓</th>
                        }

                        <th style="width:110px;">Código</th>
                        <th class="th-producto">Producto</th>

                        @if (sucursalIdSeleccionada != 0)
                        {
                            <th style="width:140px;" class="th-stock-simple">Stock</th>
                        }

                        <!-- columnas dinámicas de stock por sucursal (se muestran sólo si switchStockSucursales ON) -->
                        @foreach (var s in sucursales)
                        {
                            <th class="th-stock-sucursal d-none text-nowrap" data-sucid="@s.IdSucursal">
                                @s.SucursalNombre
                            </th>
                        }

                        <th style="width:130px;">Precio</th>
                        <th style="width:240px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var rowId = $"fila_{item.idCorte}";
                        var detailsId = $"det_{item.idCorte}";

                        <tr id="@rowId"
                            data-id="@item.idCorte"
                            data-codigo="@item.Codigo"
                            data-nombre="@item.CorteDesc"
                            data-precio="@item.PrecioKg.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-tipo="@item.Tipo"
                            data-marca-id="@(item.Marca != null ? item.Marca.IdPersona.ToString() : "")">
                            @if (modoEtiquetas)
                            {
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="chk-etiqueta"
                                           value="@item.idCorte"
                                           onchange="actualizarSeleccionados()" />
                                </td>
                            }

                            <td class="text-nowrap">@item.Codigo</td>

                            <td class="td-producto">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="producto-text text-truncate" title="@item.CorteDesc">
                                        @item.CorteDesc
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-link text-decoration-none btn-detalles"
                                            data-toggle="collapse"
                                            data-target="#@detailsId"
                                            aria-expanded="false"
                                            aria-controls="@detailsId">
                                        <i class="fas fa-chevron-down"></i> Detalles
                                    </button>
                                </div>
                            </td>

                            @if (sucursalIdSeleccionada != 0)
                            {
                                <td class="text-nowrap th-stock-simple">
                                    @item.Stock_EnString @item.StockUnidades
                                </td>
                            }

                            <!-- celdas de stock por sucursal (se muestran sólo si switchStockSucursales ON) -->
                            @foreach (var s in sucursales)
                            {
                                <td class="td-stock-sucursal d-none text-nowrap"
                                    data-sucid="@s.IdSucursal"
                                    id="stk_@s.IdSucursal">
                                    <span class="text-muted">—</span>
                                </td>
                            }

                            <td class="text-nowrap font-weight-bold" id="precio_@item.idCorte">
                                @item.PrecioKg.ToString("C")
                            </td>

                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-warning mr-1"
                                        title="Modificar precio"
                                        onclick="abrirPopupPrecio(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))', '@item.PrecioKg', this)"
                                        @(puedeModificarPreciosProducto ? "" : "disabled")>
                                    <i class="fas fa-dollar-sign"></i>
                                </button>

                                <button type="button" class="btn btn-sm btn-info mr-1"
                                        title="Ver stock por sucursales (modal)"
                                        onclick="verStockSucursales(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))')">
                                    <i class="fas fa-warehouse"></i>
                                </button>

                                <a class="btn btn-sm btn-primary mr-1 @(puedeEditarProducto ? "" : "disabled")"
                                   title="Editar producto"
                                   href="@Url.Action("AddOrEdit", "Productos", new { id = item.idCorte })">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-danger"
                                        title="Eliminar"
                                        onclick="confirmarEliminar(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))')"
                                        @(puedeEliminarProducto ? "" : "disabled")>
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- DETALLES (siempre disponibles) -->
                        <tr class="tr-detalles">
                            @{
                                int baseCols = ((sucursalIdSeleccionada != 0) ? 5 : 4) + sucursales.Count; // incluye columnas stock sucursales (aunque estén ocultas)
                                int colspan = modoEtiquetas ? (baseCols + 1) : baseCols;
                            }
                            <td colspan="@colspan" class="p-0">
                                <div id="@detailsId" class="collapse">
                                    <div class="p-3 bg-light border-top">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div class="mb-2">
                                                    <span class="font-weight-bold">@item.CorteDesc</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted">Tipo:</span>
                                                    <span class="font-weight-bold">@item.Tipo</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Marca:</span>
                                                    <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(item.MarcaNombre) ? item.MarcaNombre : "-")</span>

                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Alícuota IVA:</span>
                                                    <span class="font-weight-bold">@item.AlicuotaIva</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Pesable:</span>
                                                    <span class="font-weight-bold">@(item.Pesable ? "Sí" : "No")</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Habilitado:</span>
                                                    <span class="font-weight-bold">@(item.Habilitado ? "Sí" : "No")</span>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">

                                                <div class="mb-2">
                                                    <span class="text-muted">Punto stock:</span>
                                                    <span class="font-weight-bold">@item.PuntoStock</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">En cierre stock:</span>
                                                    <span class="font-weight-bold">@(item.EnCierreStock ? "Sí" : "No")</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Promedio:</span>
                                                    <span class="font-weight-bold">@item.Promedio</span>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.CorteMaestroNombre))
                                            {
                                                var esPres = item.Presentacion;

                                                <div class="col-lg-6">
                                                    <div class="mb-2">

                                                        @if (esPres)
                                                        {
                                                            <div class="mb-2">

                                                                <span class="text-muted">Presentación:</span>
                                                                <span class="font-weight-bold">@item.CorteMaestroNombre</span>
                                                            </div>
                                                            <span class="text-muted">Unidades:</span>
                                                            <span class="font-weight-bold">
                                                                @item.getCantPresentacion(item.PorcentajeHueso)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <div class="mb-2">

                                                                <span class="text-muted">Corte Maestro:</span>
                                                                <span class="font-weight-bold">@item.CorteMaestroNombre</span>
                                                            </div>
                                                            <span class="text-muted">%:</span>
                                                            <span class="font-weight-bold">
                                                                @item.Porcentaje
                                                            </span>
                                                        }
                                                    </div>

                                                    @if (!esPres)
                                                    {
                                                        <div class="mb-2">
                                                            <span class="text-muted">% Hueso:</span>
                                                            <span class="font-weight-bold">@item.PorcentajeHueso</span>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                        </div>

                                        <div class="mt-2 text-muted small">
                                            ID: <b>@item.idCorte</b>
                                            @* Si tenés CorteMaestro / independiente / etc, lo agregamos acá *@
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
    </div>

    <!-- =========================
         MODAL EDITAR PRECIO
         ========================= -->
    <form id="formPrecio" method="post">
        @Html.AntiForgeryToken()

        <div class="modal fade" id="modalPrecio" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Modificar precio</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="IdCorte" name="IdCorte" />

                        <div class="form-group js-precio-individual-block">
                            <label>Producto</label>
                            <input type="text" id="CorteDesc" class="form-control" readonly>
                        </div>

                        <div class="form-group js-precio-individual-block">
                            <label>Precio actual</label>
                            <input type="text" id="PrecioActual" class="form-control" readonly>
                        </div>

                        <div class="form-group mt-2 js-precio-individual-block">
                            <label>Nuevo precio</label>
                            <input type="text" id="PrecioKg" name="PrecioKg" class="form-control" autocomplete="off">
                            <small id="precioVariacion" class="form-text text-muted">Sin variación</small>
                            <small id="errorPrecio" class="text-danger d-none">El precio ingresado es inválido.</small>
                        </div>

                        <div class="border rounded p-3 mt-3">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="switchModificarLote">
                                <label class="custom-control-label" for="switchModificarLote">Modificar en lote</label>
                            </div>

                            <div id="bloqueModificarLote" class="d-none mt-3">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="switchAplicarPorcentajeTodos">
                                    <label class="custom-control-label" for="switchAplicarPorcentajeTodos">Aplicar porcentaje a todos</label>
                                </div>

                                <div id="bloqueAplicarPorcentajeTodos" class="d-none mt-3">
                                    <div class="form-group mb-2">
                                        <label>Porcentaje</label>
                                        <input type="text" id="PorcentajeLote" class="form-control" autocomplete="off" inputmode="decimal" placeholder="+10 o -5">
                                    </div>
                                    <small class="form-text text-muted mb-0">
                                        Se aplicará el porcentaje a todos los productos visibles actualmente.
                                    </small>
                                    <small id="errorPorcentajeLote" class="text-danger d-none">Ingrese un porcentaje válido distinto de 0.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="btnGuardarPrecio" onclick="guardarPrecio()">
                            <i class="fas fa-save mr-1"></i> <span id="btnGuardarPrecioTexto">Guardar</span>
                        </button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">
                            Cancelar
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <div class="modal fade" id="modalVerificarPrecios" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-verificar-precios" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Verificar cambios de precios</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                        <div>
                            <p class="text-muted mb-1">Se listan los productos visibles actualmente con el nuevo precio propuesto.</p>
                            <small id="infoPorcentajePreview" class="text-muted d-none"></small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnQuitarPreciosCero">
                            Quitar precios 0
                        </button>
                    </div>
                    <small id="errorPreviewMasivo" class="text-danger d-none mb-2 d-block">
                        Revise las filas marcadas antes de guardar.
                    </small>

                    <div class="table-responsive tabla-verificar-precios">
                        <table class="table table-sm table-bordered mb-0" id="tablaVerificarPrecios">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-right" style="width:150px;">Precio anterior</th>
                                    <th class="text-right" style="width:170px;">Precio nuevo</th>
                                    <th style="width:90px;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="js-empty">
                                    <td colspan="4" class="text-center text-muted py-4">Sin cambios para verificar.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="btnGuardarCambiosMasivos">
                        <i class="fas fa-save mr-1"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================
         MODAL VER STOCK (por sucursales)
         ========================= -->
    <div class="modal fade" id="modalStockSucursales" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-warehouse mr-1"></i> Stock por sucursales
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div id="stockLoading" class="text-muted py-3 d-none">
                        <i class="fas fa-spinner fa-spin mr-2"></i> Cargando stock...
                    </div>

                    <div id="contenedorStockSucursalesProducto">
                        <div class="text-muted text-center py-4">Sin datos</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>

            </div>
        </div>
    </div>

    <!-- =========================
         FORM ELIMINAR (POST)
         ========================= -->
    <form id="formEliminar" method="post" action="@Url.Action("Eliminar", "Productos")" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="EliminarId" />
    </form>

</div>

@section Scripts {

    <script>
    // ============================
    // Helpers
    // ============================
    const tabla = document.getElementById("tablaProductos");

    function getFilasProductos() {
        return Array.from(tabla.querySelectorAll("tbody tr"))
            .filter(tr => tr.id && tr.id.startsWith("fila_"));
    }

    function getFilaDetallesDe(filaProducto) {
        const next = filaProducto.nextElementSibling;
        if (next && next.classList.contains("tr-detalles")) return next;
        return null;
    }

    // ============================
    // BUSCADOR + CONTADOR
    // ============================
    const buscador = document.getElementById("buscador");
    const contador = document.getElementById("contadorProductos");

    function actualizarContador(visibles) {
        const total = getFilasProductos().length;
        const cant = (visibles !== undefined) ? visibles : total;
        contador.textContent = `Mostrando ${cant} de ${total} productos`;
    }
    actualizarContador();

    buscador.addEventListener("keyup", function () {
        const valor = (this.value || "").toLowerCase().trim();
        let visibles = 0;

        getFilasProductos().forEach(fila => {
            const codigo = (fila.dataset.codigo || "").toLowerCase();
            const nombre = (fila.dataset.nombre || "").toLowerCase();
            const coincide = codigo.includes(valor) || nombre.includes(valor);

            fila.style.display = coincide ? "" : "none";

            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = coincide ? "" : "none";

            if (coincide) visibles++;
        });

        actualizarContador(visibles);
        actualizarSeleccionados();
    });

    // ============================
    // VISTA COMPLETA (expand/collapse todos)
    // OFF: no expande nada automáticamente, queda botón por fila
    // ON : expande todos los detalles visibles
    // ============================
    const switchVista = document.getElementById("switchVistaCompleta");

    function setVistaCompleta(activa) {
        localStorage.setItem("vistaCompletaProductos", activa ? "1" : "0");

        // sólo afecta filas visibles
        const filas = getFilasProductos().filter(f => f.style.display !== "none");

        filas.forEach(fila => {
            const detRow = getFilaDetallesDe(fila);
            if (!detRow) return;
            const collapse = detRow.querySelector(".collapse");
            if (!collapse) return;

            if (activa) {
                $(collapse).collapse('show');
            } else {
                $(collapse).collapse('hide');
            }
        });
    }

    (function initVista() {
        const saved = localStorage.getItem("vistaCompletaProductos");
        const activa = saved === "1";
        switchVista.checked = activa;
        // aplica al cargar
        setTimeout(() => setVistaCompleta(activa), 50);
    })();

    switchVista.addEventListener("change", function () {
        setVistaCompleta(this.checked);
    });

    // ============================
    // FILTROS AVANZADOS (toggle + filtro cliente)
    // ============================
    const switchFiltros = document.getElementById("switchFiltrosAvanzados");
    const panelFiltros = document.getElementById("panelFiltrosAvanzados");
    const mensajeFiltrosPendientes = document.getElementById("mensajeFiltrosPendientes");
    const filtroTipo = document.getElementById("fTipo");
    const filtroMarca = document.getElementById("fMarca");
    const filtroProveedor = document.getElementById("fProveedor");
    const filtroCodigoDesde = document.getElementById("fCodigoDesde");
    const filtroCodigoHasta = document.getElementById("fCodigoHasta");
    let filtrosPendientesServidor = false;

    function setMensajeFiltrosPendientes(show) {
        filtrosPendientesServidor = show;
        if (mensajeFiltrosPendientes) {
            mensajeFiltrosPendientes.classList.toggle("d-none", !show);
        }
    }

    function toggleFiltrosAvanzados(show) {
        panelFiltros.classList.toggle("d-none", !show);
        localStorage.setItem("filtrosAvanzadosProductos", show ? "1" : "0");
    }

    (function initFiltros() {
        const saved = localStorage.getItem("filtrosAvanzadosProductos");
        const show = saved === "1";
        switchFiltros.checked = show;
        toggleFiltrosAvanzados(show);
    })();

    switchFiltros.addEventListener("change", function () {
        toggleFiltrosAvanzados(this.checked);
    });

    function aplicarFiltrosCliente() {
        const tipo = (filtroTipo?.value || "").toLowerCase();
        const marcaId = (filtroMarca?.value || "").trim();
        const cd = (filtroCodigoDesde?.value || "").trim();
        const ch = (filtroCodigoHasta?.value || "").trim();

        const codigoDesde = cd === "" ? null : parseInt(cd, 10);
        const codigoHasta = ch === "" ? null : parseInt(ch, 10);

        let visibles = 0;

        getFilasProductos().forEach(fila => {
            const fTipo = (fila.dataset.tipo || "").toLowerCase();
            const fMarcaId = (fila.dataset.marcaId || "").trim();

            const codStr = (fila.dataset.codigo || "").toString().trim();
            const codNum = parseInt(codStr, 10);

            let ok = true;

            if (tipo && fTipo !== tipo) ok = false;
            if (marcaId && fMarcaId !== marcaId) ok = false;

            if (codigoDesde !== null && !isNaN(codNum) && codNum < codigoDesde) ok = false;
            if (codigoHasta !== null && !isNaN(codNum) && codNum > codigoHasta) ok = false;

            fila.style.display = ok ? "" : "none";
            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = ok ? "" : "none";

            if (ok) visibles++;
        });

        actualizarContador(visibles);
        actualizarSeleccionados();

        // si vista completa está ON, aseguramos expandir los que quedaron visibles
        if (switchVista.checked) setVistaCompleta(true);
    }

    function recargarConFiltros() {
        const url = new URL(window.location.href);
        const params = url.searchParams;
        const modo = params.get("modo");
        const sucursalId = params.get("SucursalId");

        const nuevaUrl = new URL('@Url.Action("Index", "Productos")', window.location.origin);

        if (modo) nuevaUrl.searchParams.set("modo", modo);
        if (sucursalId) nuevaUrl.searchParams.set("SucursalId", sucursalId);

        const tipo = (filtroTipo?.value || "").trim();
        const marcaId = (filtroMarca?.value || "").trim();
        const proveedorId = (filtroProveedor?.value || "").trim();
        const codigoDesde = (filtroCodigoDesde?.value || "").trim();
        const codigoHasta = (filtroCodigoHasta?.value || "").trim();

        if (tipo) nuevaUrl.searchParams.set("tipo", tipo);
        if (marcaId) nuevaUrl.searchParams.set("marcaId", marcaId);
        if (proveedorId) nuevaUrl.searchParams.set("proveedorId", proveedorId);
        if (codigoDesde) nuevaUrl.searchParams.set("codigoDesde", codigoDesde);
        if (codigoHasta) nuevaUrl.searchParams.set("codigoHasta", codigoHasta);

        window.location.href = nuevaUrl.toString();
    }

    function aplicarFiltrosAvanzados() {
        if (filtrosPendientesServidor) {
            recargarConFiltros();
            return;
        }

        aplicarFiltrosCliente();
    }

    function limpiarFiltrosAvanzados() {
        ["fTipo","fMarca","fProveedor","fCodigoDesde","fCodigoHasta"].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = "";
        });

        const url = new URL(window.location.href);
        const tieneFiltrosServidorAplicados = !!(url.searchParams.get("proveedorId")
            || url.searchParams.get("tipo")
            || url.searchParams.get("marcaId")
            || url.searchParams.get("codigoDesde")
            || url.searchParams.get("codigoHasta"));

        setMensajeFiltrosPendientes(false);

        if (tieneFiltrosServidorAplicados) {
            const nuevaUrl = new URL('@Url.Action("Index", "Productos")', window.location.origin);
            const modo = url.searchParams.get("modo");
            const sucursalId = url.searchParams.get("SucursalId");
            if (modo) nuevaUrl.searchParams.set("modo", modo);
            if (sucursalId) nuevaUrl.searchParams.set("SucursalId", sucursalId);
            window.location.href = nuevaUrl.toString();
            return;
        }

        // mostrar todos
        getFilasProductos().forEach(fila => {
            fila.style.display = "";
            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = "";
        });

        actualizarContador();
        actualizarSeleccionados();

        if (switchVista.checked) setVistaCompleta(true);
    }

    [filtroTipo, filtroMarca].forEach(el => {
        el?.addEventListener("change", function () {
            aplicarFiltrosCliente();
        });
    });

    [filtroCodigoDesde, filtroCodigoHasta].forEach(el => {
        el?.addEventListener("input", function () {
            aplicarFiltrosCliente();
        });
    });

    filtroProveedor?.addEventListener("change", function () {
        setMensajeFiltrosPendientes(true);
    });

    aplicarFiltrosCliente();

    // ============================
    // STOCK SUCURSALES EN COLUMNAS (toggle + AJAX)
    // ============================
    const switchStock = document.getElementById("switchStockSucursales");

    function toggleStockSucursales(show) {
        localStorage.setItem("stockSucursalesProductos", show ? "1" : "0");

        document.querySelectorAll(".th-stock-sucursal, .td-stock-sucursal")
            .forEach(el => el.classList.toggle("d-none", !show));

        // si mostramos, cargamos stocks
        if (show) {
            cargarStocksEnTabla();
        }
    }

    (function initStockSucursales() {
        if (!switchStock) {
            toggleStockSucursales(false);
            return;
        }

        const saved = localStorage.getItem("stockSucursalesProductos");
        const show = saved === "1";
        switchStock.checked = show;
        toggleStockSucursales(show);
    })();

    if (switchStock) {
        switchStock.addEventListener("change", function () {
            toggleStockSucursales(this.checked);
        });
    }

    function cargarStocksEnTabla() {
        // consulta 1 vez: devuelve { success:true, items:[{idCorte, idSucursal, stockTexto}] }
        const ids = getFilasProductos().map(f => parseInt(f.dataset.id, 10)).filter(x => !isNaN(x));
        if (!ids.length) return;

        // loading
        document.querySelectorAll(".td-stock-sucursal").forEach(td => {
            td.innerHTML = `<span class="text-muted">...</span>`;
        });

        $.ajax({
            url: '@Url.Action("GetStocksPorSucursalesTabla", "Productos")',
            type: 'POST',
            data: { ids: ids },
            traditional: true, // importante para arrays
            success: function(resp) {
                if (!resp || resp.success === false) {
                    document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                        td.innerHTML = `<span class="text-danger">Err</span>`;
                    });
                    return;
                }

                // vaciar a "—"
                document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                    td.innerHTML = `<span class="text-muted">—</span>`;
                });

                const items = resp.items || [];
                items.forEach(x => {
                    const tdId = `stk_${x.idCorte}_${x.idSucursal}`;
                    const td = document.getElementById(tdId);
                    if (td) td.innerHTML = `<span class="font-weight-bold">${x.stockTexto ?? x.stock ?? ""}</span>`;
                });
            },
            error: function() {
                document.querySelectorAll(".td-stock-sucursal").forEach(td => {
                    td.innerHTML = `<span class="text-danger">Err</span>`;
                });
            }
        });
    }

    // ============================
    // MODO ETIQUETAS: seleccionar + generar
    // ============================
    function seleccionarTodos(estado) {
        document.querySelectorAll(".chk-etiqueta").forEach(chk => {
            // sólo si la fila está visible
            const tr = chk.closest("tr");
            if (tr && tr.style.display === "none") return;
            chk.checked = estado;
        });
        actualizarSeleccionados();
    }

    function actualizarSeleccionados() {
        const lbl = document.getElementById("lblSeleccionados");
        if (!lbl) return;

        const checks = Array.from(document.querySelectorAll(".chk-etiqueta"))
            .filter(chk => {
                const tr = chk.closest("tr");
                return tr && tr.style.display !== "none" && chk.checked;
            });

        lbl.textContent = `${checks.length} seleccionados`;
    }

    function generarEtiquetas() {
        const checks = Array.from(document.querySelectorAll(".chk-etiqueta"))
            .filter(chk => {
                const tr = chk.closest("tr");
                return tr && tr.style.display !== "none" && chk.checked;
            });

        if (!checks.length) {
            Swal.fire("Atención", "No seleccionaste ningún producto.", "info");
            return;
        }

        const ids = checks.map(x => x.value).join(",");
        document.getElementById("idsEtiquetas").value = ids;
        document.getElementById("formEtiquetas").submit();
    }

    // =========================
    // MODAL PRECIO
    // =========================
    const precioModalState = {
        currentRow: null,
        currentId: 0,
        currentPrecioActual: 0,
        batchPreviewItems: [],
        batchPreviewPercent: null,
        isOpeningVerification: false
    };

    function normalizarTextoDecimal(valor, permitirSigno) {
        let v = (valor || "").toString();
        v = v.replace(/\./g, ",");
        v = v.replace(permitirSigno ? /[^\d,+-]/g : /[^\d,]/g, "");

        if (permitirSigno) {
            const signo = v.startsWith("-") ? "-" : (v.startsWith("+") ? "+" : "");
            v = signo + v.substring(signo ? 1 : 0).replace(/[+-]/g, "");
        }

        const partes = v.split(",");
        if (partes.length > 2) v = partes[0] + "," + partes.slice(1).join("");

        return v;
    }

    function parseDecimalEs(valor) {
        const texto = (valor || "").toString().trim();
        if (!texto) return NaN;

        const normalizado = texto.replace(/\./g, "").replace(",", ".");
        return parseFloat(normalizado);
    }

    function round2(valor) {
        return Math.round((Number(valor) + Number.EPSILON) * 100) / 100;
    }

    function formatNumberEs(valor, decimales) {
        const numero = Number(valor);
        if (!isFinite(numero)) return "";
        return numero.toLocaleString("es-AR", {
            minimumFractionDigits: decimales,
            maximumFractionDigits: decimales
        });
    }

    function formatCurrencyEs(valor) {
        return "$ " + formatNumberEs(valor, 2);
    }

    function formatPercentEs(valor) {
        const numero = Number(valor);
        if (!isFinite(numero)) return "";
        return formatNumberEs(numero, 2) + "%";
    }

    function getVisiblePriceRows() {
        return getFilasProductos().filter(fila => {
            if (fila.style.display === "none") return false;
            const boton = fila.querySelector('button[title="Modificar precio"]');
            return !!(boton && !boton.disabled);
        });
    }

    function getProductRowById(id) {
        return getFilasProductos().find(fila => Number(fila.dataset.id) === Number(id)) || null;
    }

    function getPrecioActualFila(fila) {
        if (!fila) return NaN;

        const datasetPrecio = parseFloat(fila.dataset.precio || "");
        if (isFinite(datasetPrecio)) return datasetPrecio;

        const tdPrecio = fila.querySelector('[id^="precio_"]');
        if (!tdPrecio) return NaN;
        return parseDecimalEs(tdPrecio.textContent || "");
    }

    function actualizarPrecioFila(id, precio, precioFormateado) {
        const fila = getProductRowById(id);
        if (!fila) return;

        fila.dataset.precio = String(round2(precio)).replace(",", ".");

        const tdPrecio = fila.querySelector('[id^="precio_"]');
        if (tdPrecio) {
            tdPrecio.textContent = precioFormateado || formatCurrencyEs(precio);
        }
    }

    function actualizarVariacionPrecio() {
        const $texto = $("#precioVariacion");
        const precioActual = Number(precioModalState.currentPrecioActual);
        const precioNuevo = parseDecimalEs($("#PrecioKg").val());

        if (!isFinite(precioNuevo) || precioNuevo <= 0) {
            $texto.text("Sin variación");
            return;
        }

        if (!isFinite(precioActual) || precioActual <= 0) {
            $texto.text("Sin variación");
            return;
        }

        const variacion = ((precioNuevo - precioActual) / precioActual) * 100;
        if (Math.abs(variacion) < 0.0001) {
            $texto.text("Sin variación");
        } else if (variacion > 0) {
            $texto.text("Recargo: " + formatPercentEs(variacion));
        } else {
            $texto.text("Descuento: " + formatPercentEs(Math.abs(variacion)));
        }
    }

    function syncPrecioModalVisualState() {
        const modificarLote = $("#switchModificarLote").is(":checked");
        const aplicarPorcentaje = modificarLote && $("#switchAplicarPorcentajeTodos").is(":checked");

        $("#bloqueModificarLote").toggleClass("d-none", !modificarLote);
        $("#bloqueAplicarPorcentajeTodos").toggleClass("d-none", !aplicarPorcentaje);
        $(".js-precio-individual-block").toggleClass("d-none", aplicarPorcentaje);

        $("#btnGuardarPrecioTexto").text(aplicarPorcentaje ? "Verificar cambios" : "Guardar");
        $("#btnGuardarPrecio i")
            .toggleClass("fa-save", !aplicarPorcentaje)
            .toggleClass("fa-clipboard-check", aplicarPorcentaje);
    }

    function limpiarErroresPrecioModal() {
        $("#errorPrecio, #errorPorcentajeLote").addClass("d-none");
    }

    function aplicarDatosPrecioModal(resp, fallbackNombre, fallbackPrecio) {
        const descripcion = (resp && resp.descripcion) ? resp.descripcion : fallbackNombre;
        const precioActual = resp && isFinite(Number(resp.precio)) ? Number(resp.precio) : Number(fallbackPrecio);
        const precioNormalizado = isFinite(precioActual) ? round2(precioActual) : 0;

        precioModalState.currentPrecioActual = precioNormalizado;

        $("#CorteDesc").val(descripcion || "");
        $("#PrecioActual").val(formatCurrencyEs(precioNormalizado));
        $("#PrecioKg").val(formatNumberEs(precioNormalizado, 2));
        actualizarVariacionPrecio();
    }

    function focusNuevoPrecio() {
        const inp = document.getElementById("PrecioKg");
        if (!inp || $("#PrecioKg").closest(".js-precio-individual-block").hasClass("d-none")) return;
        inp.focus();
        inp.select();
    }

    function focusPorcentajeLote() {
        const inp = document.getElementById("PorcentajeLote");
        if (!inp || $("#bloqueAplicarPorcentajeTodos").hasClass("d-none")) return;
        inp.focus();
        inp.select();
    }

    function abrirModalPrecioParaFila(fila, opciones) {
        const opts = opciones || {};
        if (!fila) return;

        precioModalState.currentRow = fila;
        precioModalState.currentId = Number(fila.dataset.id || 0);

        limpiarErroresPrecioModal();

        if (!opts.preserveBatchState) {
            $("#switchModificarLote").prop("checked", false);
            $("#switchAplicarPorcentajeTodos").prop("checked", false);
            $("#PorcentajeLote").val("");
        }

        syncPrecioModalVisualState();
        $("#IdCorte").val(precioModalState.currentId);
        $("#modalPrecio").modal("show");

        const fallbackNombre = fila.dataset.nombre || "";
        const fallbackPrecio = getPrecioActualFila(fila) || 0;
        aplicarDatosPrecioModal(null, fallbackNombre, fallbackPrecio);

        $.ajax({
            url: '@Url.Action("findCorteById", "Productos")',
            type: 'GET',
            data: { id: precioModalState.currentId },
            success: function (resp) {
                aplicarDatosPrecioModal(resp, fallbackNombre, fallbackPrecio);
                setTimeout(function () {
                    if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
                        focusPorcentajeLote();
                    } else {
                        focusNuevoPrecio();
                    }
                }, 80);
            },
            error: function () {
                setTimeout(function () {
                    focusNuevoPrecio();
                }, 80);
            }
        });
    }

    function abrirPopupPrecio(id, nombreTabla, precioTabla, button) {
        const fila = button ? button.closest("tr") : getProductRowById(id);
        if (!fila) return;
        abrirModalPrecioParaFila(fila, { preserveBatchState: false });
    }

    function getPrecioFormPayload(id, precioRaw) {
        return {
            __RequestVerificationToken: $("#formPrecio input[name='__RequestVerificationToken']").val(),
            IdCorte: id,
            PrecioKg: precioRaw
        };
    }

    function postEditarPrecio(id, precioRaw) {
        return $.ajax({
            url: '@Url.Action("EditPrecioCorte", "Productos")',
            type: 'POST',
            data: getPrecioFormPayload(id, precioRaw)
        });
    }

    function getPrecioValidoDesdeInput() {
        let precioRaw = ($("#PrecioKg").val() || "").trim();
        if (precioRaw === "") return null;

        precioRaw = normalizarTextoDecimal(precioRaw, false);
        const numero = parseDecimalEs(precioRaw);
        if (!isFinite(numero) || numero <= 0) return null;

        const normalizado = formatNumberEs(round2(numero), 2);
        $("#PrecioKg").val(normalizado);
        return {
            raw: normalizado,
            numero: round2(numero)
        };
    }

    function getPorcentajeLoteValido() {
        let valor = ($("#PorcentajeLote").val() || "").trim();
        if (!valor) return null;

        valor = normalizarTextoDecimal(valor, true);
        $("#PorcentajeLote").val(valor);

        const numero = parseDecimalEs(valor);
        if (!isFinite(numero) || numero === 0) return null;

        return numero;
    }

    function avanzarSiguienteProductoLote() {
        const filas = getVisiblePriceRows();
        const idActual = Number(precioModalState.currentId);
        const indexActual = filas.findIndex(fila => Number(fila.dataset.id) === idActual);
        const siguiente = indexActual >= 0 ? filas[indexActual + 1] : null;

        if (!siguiente) {
            $("#modalPrecio").modal("hide");
            Swal.fire("Sin más productos", "No hay más productos para modificar con los filtros actuales", "info");
            return;
        }

        abrirModalPrecioParaFila(siguiente, { preserveBatchState: true });
    }

    function construirItemsPreviewPorcentaje(porcentaje) {
        return getVisiblePriceRows().map(fila => {
            const precioAnterior = getPrecioActualFila(fila);
            const nuevoPrecio = isFinite(precioAnterior)
                ? round2(precioAnterior * (1 + (porcentaje / 100)))
                : 0;

            return {
                id: Number(fila.dataset.id),
                nombre: fila.dataset.nombre || "",
                precioAnterior: isFinite(precioAnterior) ? round2(precioAnterior) : 0,
                precioNuevo: nuevoPrecio
            };
        });
    }

    function renderPreviewMasivo() {
        const $tbody = $("#tablaVerificarPrecios tbody");
        $tbody.empty();
        $("#errorPreviewMasivo").addClass("d-none");

        if (precioModalState.batchPreviewPercent === null || !isFinite(precioModalState.batchPreviewPercent)) {
            $("#infoPorcentajePreview").addClass("d-none").text("");
        } else {
            const porcentajeTexto = (precioModalState.batchPreviewPercent > 0 ? "+" : "") + formatPercentEs(precioModalState.batchPreviewPercent);
            $("#infoPorcentajePreview").removeClass("d-none").text("Porcentaje aplicado: " + porcentajeTexto);
        }

        if (!precioModalState.batchPreviewItems.length) {
            $tbody.append('<tr class="js-empty"><td colspan="4" class="text-center text-muted py-4">Sin cambios para verificar.</td></tr>');
            return;
        }

        precioModalState.batchPreviewItems.forEach(function (item) {
            const fila = [
                '<tr data-id="', item.id, '">',
                '<td>', $('<div>').text(item.nombre).html(), '</td>',
                '<td class="text-right js-precio-anterior">', formatCurrencyEs(item.precioAnterior), '</td>',
                '<td><input type="text" class="form-control form-control-sm js-precio-nuevo text-right" value="', formatNumberEs(item.precioNuevo, 2), '" autocomplete="off" inputmode="decimal"></td>',
                '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-preview" title="Quitar"><i class="fas fa-trash"></i></button></td>',
                '</tr>'
            ].join('');
            $tbody.append(fila);
        });
    }

    function abrirModalVerificacionPorcentaje() {
        const porcentaje = getPorcentajeLoteValido();
        if (porcentaje === null) {
            $("#errorPorcentajeLote").removeClass("d-none");
            return;
        }

        limpiarErroresPrecioModal();
        precioModalState.batchPreviewPercent = porcentaje;
        precioModalState.batchPreviewItems = construirItemsPreviewPorcentaje(porcentaje);
        if (!precioModalState.batchPreviewItems.length) {
            Swal.fire("Atención", "No hay productos visibles para modificar con los filtros actuales.", "info");
            return;
        }
        renderPreviewMasivo();
        precioModalState.isOpeningVerification = true;

        $("#modalPrecio").one("hidden.bs.modal.batchVerify", function () {
            $("#modalVerificarPrecios").modal("show");
            precioModalState.isOpeningVerification = false;
        });

        $("#modalPrecio").modal("hide");
    }

    function guardarPrecio() {
        const modificarLote = $("#switchModificarLote").is(":checked");
        const aplicarPorcentaje = modificarLote && $("#switchAplicarPorcentajeTodos").is(":checked");

        if (aplicarPorcentaje) {
            abrirModalVerificacionPorcentaje();
            return;
        }

        const precioValido = getPrecioValidoDesdeInput();
        if (!precioValido) {
            $("#errorPrecio").removeClass("d-none");
            return;
        }

        limpiarErroresPrecioModal();

        postEditarPrecio(precioModalState.currentId, precioValido.raw)
            .done(function (resp) {
                if (!manejarPermiso(resp)) return;
                actualizarPrecioFila(resp.id, resp.precio, resp.precioFormateado);

                if (modificarLote) {
                    avanzarSiguienteProductoLote();
                } else {
                    $("#modalPrecio").modal("hide");
                }
            })
            .fail(function () {
                Swal.fire("Error", "Error al actualizar el precio.", "error");
            });
    }

    function obtenerPreviewDesdeTabla() {
        return $("#tablaVerificarPrecios tbody tr").not(".js-empty").map(function () {
            const $tr = $(this);
            const id = Number($tr.data("id"));
            const nombre = ($tr.children().eq(0).text() || "").trim();
            const precioAnterior = parseDecimalEs($tr.find(".js-precio-anterior").text());
            const precioNuevoRaw = ($tr.find(".js-precio-nuevo").val() || "").trim();
            const precioNuevo = parseDecimalEs(precioNuevoRaw);

            return {
                id: id,
                nombre: nombre,
                precioAnterior: precioAnterior,
                precioNuevoRaw: normalizarTextoDecimal(precioNuevoRaw, false),
                precioNuevo: precioNuevo
            };
        }).get();
    }

    function clearPreviewValidation() {
        $("#errorPreviewMasivo").addClass("d-none");
        $("#tablaVerificarPrecios tbody tr").removeClass("table-warning");
        $("#tablaVerificarPrecios .js-precio-nuevo").removeClass("is-invalid");
    }

    function markPreviewInvalidRows(items) {
        clearPreviewValidation();

        const invalidos = items.filter(item => !isFinite(item.precioNuevo) || item.precioNuevo <= 0);
        if (!invalidos.length) return [];

        invalidos.forEach(function (item) {
            const $tr = $('#tablaVerificarPrecios tbody tr[data-id="' + item.id + '"]');
            $tr.addClass("table-warning");
            $tr.find(".js-precio-nuevo").addClass("is-invalid");
        });

        $("#errorPreviewMasivo").removeClass("d-none");
        return invalidos;
    }

    function quitarPreviewInvalidos() {
        const items = obtenerPreviewDesdeTabla();
        const invalidos = items.filter(item => !isFinite(item.precioNuevo) || item.precioNuevo <= 0);

        if (!invalidos.length) {
            Swal.fire("Sin cambios", "No hay cortes con precio 0 o inválido para quitar.", "info");
            return;
        }

        invalidos.forEach(function (item) {
            $('#tablaVerificarPrecios tbody tr[data-id="' + item.id + '"]').remove();
        });

        clearPreviewValidation();

        if (!$("#tablaVerificarPrecios tbody tr").not(".js-empty").length) {
            precioModalState.batchPreviewItems = [];
            renderPreviewMasivo();
            return;
        }

        const primerInput = $("#tablaVerificarPrecios tbody .js-precio-nuevo").get(0);
        focusPrecioPreviewInput(primerInput);
    }

    function guardarCambiosMasivos() {
        const items = obtenerPreviewDesdeTabla();

        if (!items.length) {
            Swal.fire("Atención", "No hay productos para guardar.", "info");
            return;
        }

        const invalidos = markPreviewInvalidRows(items);
        if (invalidos.length) {
            const primerInvalido = $('#tablaVerificarPrecios tbody tr[data-id="' + invalidos[0].id + '"] .js-precio-nuevo').get(0);
            focusPrecioPreviewInput(primerInvalido);
            return;
        }

        const $btn = $("#btnGuardarCambiosMasivos");
        $btn.prop("disabled", true);

        let cadena = Promise.resolve();
        items.forEach(function (item) {
            cadena = cadena.then(function () {
                return postEditarPrecio(item.id, formatNumberEs(round2(item.precioNuevo), 2)).then(function (resp) {
                    if (!manejarPermiso(resp)) {
                        throw new Error("permiso");
                    }
                    actualizarPrecioFila(resp.id, resp.precio, resp.precioFormateado);
                });
            });
        });

        cadena.then(function () {
            $("#modalVerificarPrecios").modal("hide");
            Swal.fire("Guardado", "Se actualizaron los precios seleccionados.", "success");
        }, function (err) {
            if (err && err.message === "permiso") return;
            Swal.fire("Error", "Ocurrió un problema al guardar los cambios masivos.", "error");
        }).then(function () {
            $btn.prop("disabled", false);
        });
    }

    function focusPrecioPreviewInput(input) {
        if (!input) return;
        input.focus();
        input.select();
    }

    function focusNextPrecioPreviewInput(currentInput) {
        const inputs = $("#tablaVerificarPrecios tbody .js-precio-nuevo").toArray();
        if (!inputs.length) return;

        const indexActual = inputs.indexOf(currentInput);
        const nextInput = indexActual >= 0 && indexActual < inputs.length - 1
            ? inputs[indexActual + 1]
            : inputs[0];

        focusPrecioPreviewInput(nextInput);
    }

    $('#modalPrecio').on('shown.bs.modal', function () {
        if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
            focusPorcentajeLote();
            return;
        }
        focusNuevoPrecio();
    });

    $('#modalPrecio').on('hidden.bs.modal', function () {
        $("#PrecioKg, #PrecioActual, #CorteDesc, #PorcentajeLote").val("");
        limpiarErroresPrecioModal();
        if (!precioModalState.isOpeningVerification) {
            $("#switchModificarLote").prop("checked", false);
            $("#switchAplicarPorcentajeTodos").prop("checked", false);
            syncPrecioModalVisualState();
        }
    });

    $('#modalVerificarPrecios').on('hidden.bs.modal', function () {
        precioModalState.batchPreviewItems = [];
        precioModalState.batchPreviewPercent = null;
        renderPreviewMasivo();
    });

    document.addEventListener("DOMContentLoaded", function () {
        const inputPrecio = document.getElementById("PrecioKg");
        const inputPorcentaje = document.getElementById("PorcentajeLote");
        if (!inputPrecio) return;

        inputPrecio.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                guardarPrecio();
            }
        });

        inputPrecio.addEventListener("input", function () {
            this.value = normalizarTextoDecimal(this.value, false);
            actualizarVariacionPrecio();
            $("#errorPrecio").addClass("d-none");
        });

        if (inputPorcentaje) {
            inputPorcentaje.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    guardarPrecio();
                }
            });

            inputPorcentaje.addEventListener("input", function () {
                this.value = normalizarTextoDecimal(this.value, true);
                $("#errorPorcentajeLote").addClass("d-none");
            });
        }

        $("#switchModificarLote, #switchAplicarPorcentajeTodos").on("change", function () {
            if (!$("#switchModificarLote").is(":checked")) {
                $("#switchAplicarPorcentajeTodos").prop("checked", false);
                $("#PorcentajeLote").val("");
            }

            syncPrecioModalVisualState();

            if ($("#switchModificarLote").is(":checked") && $("#switchAplicarPorcentajeTodos").is(":checked")) {
                setTimeout(focusPorcentajeLote, 40);
            } else {
                setTimeout(focusNuevoPrecio, 40);
            }
        });

        $("#tablaVerificarPrecios").on("input", ".js-precio-nuevo", function () {
            this.value = normalizarTextoDecimal(this.value, false);
            $(this).removeClass("is-invalid");
            $(this).closest("tr").removeClass("table-warning");
            if (!$("#tablaVerificarPrecios .js-precio-nuevo.is-invalid").length) {
                $("#errorPreviewMasivo").addClass("d-none");
            }
        });

        $("#tablaVerificarPrecios").on("keydown", ".js-precio-nuevo", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                focusNextPrecioPreviewInput(this);
            }
        });

        $("#tablaVerificarPrecios").on("click", ".js-remove-preview", function () {
            $(this).closest("tr").remove();
            if (!$("#tablaVerificarPrecios tbody tr").not(".js-empty").length) {
                precioModalState.batchPreviewItems = [];
                renderPreviewMasivo();
            }
        });

        $("#btnGuardarCambiosMasivos").on("click", guardarCambiosMasivos);
        $("#btnQuitarPreciosCero").on("click", quitarPreviewInvalidos);
    });

    // =========================
    // VER STOCK MODAL
    // =========================
    function verStockSucursales(idCorte, nombre) {

        $("#contenedorStockSucursalesProducto").html(`<div class="text-muted text-center py-4">Sin datos</div>`);
        $("#stockLoading").removeClass("d-none");

        $("#modalStockSucursales").modal("show");

        $.ajax({
            url: '@Url.Action("StockPorSucursalesProducto", "Stock")',
            type: 'GET',
            data: { idCorte: idCorte },
            success: function (html) {

                $("#stockLoading").addClass("d-none");
                $("#contenedorStockSucursalesProducto").html(html || '<div class="text-danger text-center py-4">No se pudo obtener el stock.</div>');
            },
            error: function () {
                $("#stockLoading").addClass("d-none");
                $("#contenedorStockSucursalesProducto").html(`<div class="text-danger text-center py-4">Error al consultar el stock.</div>`);
            }
        });
    }

    // =========================
    // ELIMINAR
    // =========================
    function confirmarEliminar(id, nombre) {
        Swal.fire({
            title: "¿Eliminar producto?",
            text: `Se eliminará: ${nombre}`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar",
            reverseButtons: true,
            focusCancel: true
        }).then(r => {
            if (!r.isConfirmed) return;
            $("#EliminarId").val(id);
            $("#formEliminar").submit();
        });
    }

    // init contador seleccionados (si está modo etiquetas)
    actualizarSeleccionados();

        // =========================
        // PROTECCIÓN SALIDA (modo etiquetas) - SAFE
        // =========================
        function _setProteccionSalida(valor) {
            // preferimos usar tus funciones del layout si están
            if (valor) {
                if (typeof window.activarProteccionSalida === "function") {
                    window.activarProteccionSalida();
                } else {
                    window.__protegerSalida = true;
                }
            } else {
                if (typeof window.desactivarProteccionSalida === "function") {
                    window.desactivarProteccionSalida();
                } else {
                    window.__protegerSalida = false;
                }
            }
        }

        function updateExitProtectionEtiquetas() {
            // Solo aplica si estamos en modo etiquetas (o al menos existe la UI)
            const hayModoEtiquetas = document.querySelector(".chk-etiqueta") != null
                || document.getElementById("lblSeleccionados") != null;

            if (!hayModoEtiquetas) return;

            const checked = document.querySelectorAll(".chk-etiqueta:checked").length;
            _setProteccionSalida(checked > 0);
        }

        // Ejecutar cuando el DOM ya está listo
        document.addEventListener("DOMContentLoaded", function () {
            updateExitProtectionEtiquetas();

            // Cada cambio de checkbox recalcula
            document.addEventListener("change", function (e) {
                if (e.target && e.target.classList.contains("chk-etiqueta")) {
                    updateExitProtectionEtiquetas();
                }
            });
        });

        // Si tu función seleccionarTodos existe, la envolvemos sin romper
        if (typeof window.seleccionarTodos === "function") {
            const _seleccionarTodosOriginal = window.seleccionarTodos;
            window.seleccionarTodos = function (estado) {
                _seleccionarTodosOriginal(estado);
                updateExitProtectionEtiquetas();
            };
        }

        // Si tu función actualizarSeleccionados existe, la envolvemos
        if (typeof window.actualizarSeleccionados === "function") {
            const _actualizarSeleccionadosOriginal = window.actualizarSeleccionados;
            window.actualizarSeleccionados = function () {
                _actualizarSeleccionadosOriginal();
                updateExitProtectionEtiquetas();
            };
        }

            (function () {
                document.addEventListener('keydown', function (e) {
                    // Solo atajos con SHIFT (sin Ctrl / Alt / Meta)
                    if (!e.shiftKey || e.ctrlKey || e.altKey || e.metaKey) return;

                    // No activar si el usuario está escribiendo en un input/textarea/select o contenido editable
                    const target = e.target;
                    const tag = (target.tagName || '').toLowerCase();
                    const isEditable =
                        tag === 'input' ||
                        tag === 'textarea' ||
                        tag === 'select' ||
                        target.isContentEditable;

                    if (isEditable) return;

                    // Obtener letra presionada (ej: Shift+N => "n")
                    const key = (e.key || '').toLowerCase();
                    if (!key || key.length !== 1) return;

                    // Buscar botón/link con data-hotkey igual a la tecla
                    const selector = `[data-hotkey="${key}"]`;
                    const btn = document.querySelector(selector);

                    // Si no existe o está oculto/deshabilitado, salir
                    if (!btn) return;
                    if (btn.disabled) return;
                    if (btn.offsetParent === null) return; // oculto (display:none)

                    // Evitar comportamiento por defecto y ejecutar click
                    e.preventDefault();
                    btn.click();
                });
        })();

    </script>
}

