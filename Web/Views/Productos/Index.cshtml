    // BUSCADOR + CONTADOR
    // ============================
    const buscador = document.getElementById("buscador");
    const contador = document.getElementById("contadorProductos");

    function actualizarContador(visibles) {
        const total = getFilasProductos().length;
        const cant = (visibles !== undefined) ? visibles : total;
        contador.textContent = `Mostrando ${cant} de ${total} productos`;
    }
    actualizarContador();

    buscador.addEventListener("keyup", function () {
        const valor = (this.value || "").toLowerCase().trim();
        let visibles = 0;

        getFilasProductos().forEach(fila => {
            const codigo = (fila.dataset.codigo || "").toLowerCase();
            const nombre = (fila.dataset.nombre || "").toLowerCase();
            const coincide = codigo.includes(valor) || nombre.includes(valor);

            fila.style.display = coincide ? "" : "none";

            const det = getFilaDetallesDe(fila);
            if (det) det.style.display = coincide ? "" : "none";

            if (coincide) visibles++;
        });

        actualizarContador(visibles);
        actualizarSeleccionados();
    });

    // ============================
    // VISTA COMPLETA (expand/collapse todos)
    // OFF: no expande nada automáticamente, queda botón por fila
    // ON : expande todos los detalles visibles
    // ============================
    const switchVista = document.getElementById("switchVistaCompleta");

    function setVistaCompleta(activa) {
        localStorage.setItem("vistaCompletaProductos", activa ? "1" : "0");

        // sólo afecta filas visibles
        const filas = getFilasProductos().filter(f => f.style.display !== "none");

        filas.forEach(fila => {
            const detRow = getFilaDetallesDe(fila);
            if (!detRow) return;
            const collapse = detRow.querySelector(".collapse");
            if (!collapse) return;

            if (activa) {
                $(collapse).collapse('show');
            } else {
                $(collapse).collapse('hide');
            }
        });
    }

    (function initVista() {
        const saved = localStorage.getItem("vistaCompletaProductos");
        const activa = saved === "1";
        switchVista.checked = activa;
        // aplica al cargar
        setTimeout(() => setVistaCompleta(activa), 50);
    })();

    switchVista.addEventListener("change", function () {
        setVistaCompleta(this.checked);
    });

