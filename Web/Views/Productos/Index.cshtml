@model List<Entidades.Corte>

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Listado de Productos</h1>

    <a href="@Url.Action("Crear", "Productos")" class="btn btn-primary mb-3">
        <i class="fas fa-plus"></i> Nuevo Producto
    </a>

    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Producto</th>
                <th>Tipo</th>
                <th>Precio x Kg</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.CorteDesc</td>
                    <td>@item.Tipo</td>
                    <td>@item.PrecioKg.ToString("C")</td>
                    <td>
                        <a href="@Url.Action("Editar", new { id = item.Codigo })" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="@Url.Action("Eliminar", new { id = item.Codigo })" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
