    // FILTROS AVANZADOS (toggle + filtro cliente)
    // ============================
    const switchFiltros = document.getElementById("switchFiltrosAvanzados");
    const panelFiltros = document.getElementById("panelFiltrosAvanzados");
    const mensajeFiltrosPendientes = document.getElementById("mensajeFiltrosPendientes");
    const filtroTipo = document.getElementById("fTipo");
    const filtroMarca = document.getElementById("fMarca");
    const filtroProveedor = document.getElementById("fProveedor");
    const filtroCodigoDesde = document.getElementById("fCodigoDesde");
