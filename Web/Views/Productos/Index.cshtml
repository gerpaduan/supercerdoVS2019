    function setScannerCatalogoGlobalMsg(mensaje, tipo) {
        const $msg = $("#scannerCatalogoGlobalMsg");
        if (!$msg.length) return;

        if (!mensaje) {
            $msg.addClass("d-none").removeClass("text-danger text-success").text("");
            return;
        }

        $msg.removeClass("d-none text-danger text-success")
            .addClass(tipo === "success" ? "text-success" : "text-danger")
            .text(mensaje);
    }

    function syncFlashButton(selector, estado) {
        const $btn = $(selector);
        if (!$btn.length) return;
        $btn.toggleClass("btn-warning", !!estado);
        $btn.toggleClass("btn-secondary", !estado);
        $btn.text(estado ? "Flash ON" : "Flash");
    }

    function cerrarScannerCatalogoGlobal(manual) {
        if (manual) {
            resetScannerDoubleReadState(scannerCatalogoGlobalState, false);
        }
        if (scannerCatalogoGlobal) {
            try { scannerCatalogoGlobal.cerrar(); } catch (e) { }
        }
        syncFlashButton("#btnFlashCatalogoGlobal", false);
    }

    function limpiarScannerCatalogoGlobal() {
        resetScannerDoubleReadState(scannerCatalogoGlobalState, false);
        $("#txtBuscarCatalogoGlobal").val("").trigger("input");
        setScannerCatalogoGlobalMsg("");
        setAlertCatalogoGlobal("");
    }

    function inicializarScannerCatalogoGlobal() {
        if (typeof BarcodeScanner === "undefined") {
            scannerCatalogoGlobal = null;
            return;
        }

        scannerCatalogoGlobal = new BarcodeScanner({
            videoSelector: "#videoScannerCatalogoGlobal",
            containerSelector: "#scannerCatalogoGlobalContainer",
            onCodeDetected: function (codigoLeido) {
                processDoubleReadCode(scannerCatalogoGlobalState, codigoLeido, {
                    onFirstRead: function () {
                        setScannerCatalogoGlobalMsg("Código detectado. Acerque nuevamente para confirmar.");
                    },
                    onDifferentRead: function () {
                        setScannerCatalogoGlobalMsg("La segunda lectura no coincidió. Se reinició la validación.");
                    },
                    onInvalidRead: function () {
                        setScannerCatalogoGlobalMsg("Código inválido (solo EAN-8 o EAN-13).");
                    },
                    onAcceptedRead: function (codigo) {
                        $("#txtBuscarCatalogoGlobal").val(codigo).trigger("input");
                        setScannerCatalogoGlobalMsg("Código leído correctamente.", "success");
                    },
                    onPauseEnd: function () {
                        setScannerCatalogoGlobalMsg("");
                    }
                });
            }
        });
    }


    $("#modalCatalogoGlobal").on("hidden.bs.modal", function () {
        cerrarScannerCatalogoGlobal(true);
        scannerCatalogoGlobal = null;
        setScannerCatalogoGlobalMsg("");
    });

