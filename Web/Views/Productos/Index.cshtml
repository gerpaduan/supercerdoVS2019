@model List<Entidades.Corte>

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    var modo = (Request["modo"] ?? "").ToString().ToLower();
    bool modoEtiquetas = (modo == "etiquetas");

    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    var sucursalIdSeleccionada = (ViewBag.SucursalId != null) ? (int)ViewBag.SucursalId : 0;
    bool puedeEditarProducto = ViewBag.PuedeEditarProducto != null && (bool)ViewBag.PuedeEditarProducto;
    bool puedeModificarPreciosProducto = ViewBag.PuedeModificarPreciosProducto != null && (bool)ViewBag.PuedeModificarPreciosProducto;
    bool puedeEliminarProducto = ViewBag.PuedeEliminarProducto != null && (bool)ViewBag.PuedeEliminarProducto;
    var filtroTipoActual = (Request["tipo"] ?? "").ToString();
    int filtroMarcaActual = 0;
    int.TryParse((Request["marcaId"] ?? "0").ToString(), out filtroMarcaActual);
    int filtroProveedorActual = 0;
    int.TryParse((Request["proveedorId"] ?? "0").ToString(), out filtroProveedorActual);
    var filtroCodigoDesdeActual = (Request["codigoDesde"] ?? "").ToString();
    var filtroCodigoHastaActual = (Request["codigoHasta"] ?? "").ToString();
    var filtroFechaDesdeActual = (Request["fechaDesde"] ?? "").ToString();
    var filtroFechaHastaActual = (Request["fechaHasta"] ?? "").ToString();
}

<div class="container-fluid productos-wrap">

    <!-- =========================
         TOOLBAR (acciones globales)
         ========================= -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
            <div class="d-flex flex-wrap gap-2">

                <a id="lnkNuevoCorte"
                   data-hotkey="n"
                   class="btn btn-primary"
                   href="@Url.Action("AddOrEdit", "Productos")"
                   title="Atajo: Shift + N">
                    <i class="fas fa-plus mr-1"></i> <span class="atajo-letra">N</span>uevo
                </a>

                <a id="lnkTipos"
                   data-hotkey="t"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Tipos", "Productos")"
                   title="Atajo: Shift + T">
                    <i class="fas fa-tags mr-1"></i> <span class="atajo-letra">T</span>ipos
                </a>

                <a id="lnkMarcas"
                   data-hotkey="m"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Marcas", "Productos")"
                   title="Atajo: Shift + M">
                    <i class="fas fa-industry mr-1"></i> <span class="atajo-letra">M</span>arcas
                </a>

                <a id="lnkEtiquetas"
                   data-hotkey="e"
                   class="btn btn-outline-secondary"
                   href="@Url.Action("Index", "Productos", new { modo = "etiquetas" })"
                   title="Atajo: Shift + E">
                    <i class="fas fa-barcode mr-1"></i> <span class="atajo-letra">E</span>tiquetas (PDF)
                </a>

                <button type="button"
                        id="btnCatalogoGlobal"
                        class="btn btn-outline-info"
                        onclick="abrirCatalogoGlobal()"
                        @(puedeEditarProducto ? "" : "disabled")>
                    <i class="fas fa-globe-americas mr-1"></i> Ver catálogo global
                </button>

                @if (modoEtiquetas)
                {
                    <a id="lnkVolver"
                       data-hotkey="v"
                       class="btn btn-outline-dark"
                       href="@Url.Action("Index", "Productos")"
                       title="Atajo: Shift + V">
                        <i class="fas fa-arrow-left mr-1"></i> <span class="atajo-letra">V</span>olver
                    </a>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">

            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="switchVistaCompleta">
                <label class="custom-control-label" for="switchVistaCompleta">Vista completa</label>
            </div>

            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="switchFiltrosAvanzados">
                <label class="custom-control-label" for="switchFiltrosAvanzados">Filtros avanzados</label>
            </div>

        </div>
    </div>

    <!-- =========================
         FILTRO SUCURSAL (columna stock simple)
         ========================= -->
    @*<form method="get" id="formStock" class="mb-3" action="@Url.Action("Index","Productos")">
        <input type="hidden" name="modo" value="@(modoEtiquetas ? "etiquetas" : "")" />
        <div class="form-group mb-0">
            <label class="font-weight-bold mb-1">Stock por sucursal (columna simple)</label>
            <select class="form-control" id="SucursalId" name="SucursalId"
                    onchange="document.getElementById('formStock').submit()">
                <option value="">- Seleccione sucursal -</option>

                @foreach (var s in sucursales)
                {
                    <option value="@s.IdSucursal" @(sucursalIdSeleccionada == s.IdSucursal ? "selected" : "")>
                        @s.SucursalNombre
                    </option>
                }
            </select>
            <small class="text-muted">
                Tip: si activás <b>Ver stock sucursales</b>, se agregan columnas por cada sucursal.
            </small>
        </div>
    </form>*@

    <!-- =========================
         BUSCADOR + contador
         ========================= -->
    <div class="row mb-2">
        <div class="col-lg-6 col-md-8">
            <div class="input-group">
                <input type="text" id="buscador" class="form-control" placeholder="Buscar por código o nombre...">
                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>
            <div class="mt-2">
                <span id="contadorProductos" class="text-secondary font-weight-bold"></span>
            </div>
        </div>
    </div>

    <!-- =========================
         FILTROS AVANZADOS (cliente)
         ========================= -->
    <div id="panelFiltrosAvanzados" class="card shadow-sm mb-3 d-none">
        <div class="card-body py-3">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Tipo</label>
                    <select class="form-control" id="fTipo">
                        <option value="">(Todos)</option>
                        @if (ViewBag.Tipos != null)
                        {
                            foreach (var t in (IEnumerable<SelectListItem>)ViewBag.Tipos)
                            {
                                <option value="@t.Value" @(string.Equals(t.Value, filtroTipoActual, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@t.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Marca</label>
                    <select class="form-control" id="fMarca">
                        <option value="">(Todas)</option>
                        @if (ViewBag.Marcas != null)
                        {
                            foreach (var m in (IEnumerable<SelectListItem>)ViewBag.Marcas)
                            {
                                <option value="@m.Value" @(m.Value == filtroMarcaActual.ToString() ? "selected" : "")>@m.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Proveedor</label>
                    <select class="form-control" id="fProveedor">
                        <option value="">(Todos)</option>
                        @if (ViewBag.Proveedores != null)
                        {
                            foreach (var p in (IEnumerable<SelectListItem>)ViewBag.Proveedores)
                            {
                                <option value="@p.Value" @(p.Value == filtroProveedorActual.ToString() ? "selected" : "")>@p.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Código</label>
                    <div class="d-flex align-items-center">
                        <input class="form-control" id="fCodigoDesde" placeholder="Desde" inputmode="numeric" value="@filtroCodigoDesdeActual">
                        <span class="px-2 text-muted font-weight-bold">/</span>
                        <input class="form-control" id="fCodigoHasta" placeholder="Hasta" inputmode="numeric" value="@filtroCodigoHastaActual">
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-2">
                    <label class="mb-1 font-weight-bold">Actualizado en período</label>
                    <div class="d-flex align-items-center">
                        <input type="date" class="form-control" id="fFechaDesde" value="@filtroFechaDesdeActual">
                        <span class="px-2 text-muted font-weight-bold">/</span>
                        <input type="date" class="form-control" id="fFechaHasta" value="@filtroFechaHastaActual">
                    </div>
                    <small class="text-muted">Toma la fecha de modificación o, si no existe, la de creación.</small>
                </div>

                <div class="col-12 mt-2">
                    <div id="mensajeFiltrosPendientes" class="alert alert-warning py-2 px-3 mb-2 d-none">
                        Se modificaron filtros. Presione Aplicar para actualizar los datos.
                    </div>
                </div>

                <div class="col-12 d-flex flex-wrap align-items-center">
                    <button type="button" class="btn btn-sm btn-primary" onclick="aplicarFiltrosAvanzados()">
                        <i class="fas fa-filter mr-1"></i> Aplicar
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ml-2" onclick="limpiarFiltrosAvanzados()">
                        <i class="fas fa-undo mr-1"></i> Limpiar
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- =========================
         CARD TABLA
         ========================= -->
    <div class="card shadow mb-4 tabla-card">
        @if (modoEtiquetas)
        {
            <!-- Barra modo etiquetas -->
            <div class="d-flex flex-wrap justify-content-between align-items-center p-2 border-bottom bg-white">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="seleccionarTodos(true)">
                        <i class="fas fa-check-square mr-1"></i> Tildar todos
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="seleccionarTodos(false)">
                        <i class="fas fa-square mr-1"></i> Destildar todos
                    </button>

                    <span class="text-muted ml-2" id="lblSeleccionados">0 seleccionados</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label for="selTamanoEtiqueta" class="text-muted mb-0 mr-1">Tamaño:</label>
                    <select id="selTamanoEtiqueta" class="form-control form-control-sm" style="width:auto;">
                        <option value="chica">Chica (40x30mm)</option>
                        <option value="mediana" selected>Mediana (60x35mm)</option>
                        <option value="grande">Grande (100x50mm)</option>
                    </select>

                    <button type="button" class="btn btn-sm btn-success" onclick="generarEtiquetas()">
                        <i class="fas fa-file-pdf mr-1"></i> Generar etiquetas
                    </button>
                </div>
            </div>

            <form id="formEtiquetas" method="post" action="@Url.Action("GenerarEtiquetasPdf", "Productos")" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ids" id="idsEtiquetas" />
                <input type="hidden" name="tamano" id="tamanoEtiquetas" />
            </form>
        }

    <div class="card-body p-0">
        @if (TempData["FlashError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["FlashError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive tabla-full">
            <table class="table table-bordered table-striped tabla-productos mb-0" id="tablaProductos">

                <thead class="thead-dark">
                    <tr>
                        @if (modoEtiquetas)
                        {
                            <th style="width:42px;" class="text-center">✓</th>
                        }

                        <th class="th-codigo-producto">Código</th>
                        <th class="th-producto">Producto</th>

                        @if (sucursalIdSeleccionada != 0)
                        {
                            <th style="width:140px;" class="th-stock-simple">Stock</th>
                        }

                        <!-- columnas dinámicas de stock por sucursal (se muestran sólo si switchStockSucursales ON) -->
                        @foreach (var s in sucursales)
                        {
                            <th class="th-stock-sucursal d-none text-nowrap" data-sucid="@s.IdSucursal">
                                @s.SucursalNombre
                            </th>
                        }

                        <th style="width:130px;" class="th-precio-producto">Precio</th>
                        <th style="width:240px;" class="th-acciones-producto">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var rowId = $"fila_{item.idCorte}";
                        var detailsId = $"det_{item.idCorte}";

                        <tr id="@rowId"
                            data-id="@item.idCorte"
                            data-codigo="@item.Codigo"
                            data-nombre="@item.CorteDesc"
                            data-precio="@item.PrecioKg.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-tipo="@item.Tipo"
                            data-marca-id="@(item.Marca != null ? item.Marca.IdPersona.ToString() : "")">
                            @if (modoEtiquetas)
                            {
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="chk-etiqueta"
                                           value="@item.idCorte"
                                           onchange="actualizarSeleccionados()" />
                                </td>
                            }

                            <td class="text-nowrap td-codigo-producto">@item.Codigo</td>

                            <td class="td-producto">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="producto-text" title="@item.CorteDesc">
                                        <div class="text-truncate">@item.CorteDesc</div>
                                        <div class="codigo-inline-mobile text-muted">@item.Codigo</div>
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-link text-decoration-none btn-detalles"
                                            data-toggle="collapse"
                                            data-target="#@detailsId"
                                            aria-expanded="false"
                                            aria-controls="@detailsId">
                                        <i class="fas fa-chevron-down"></i><span class="btn-detalles-text"> Detalles</span>
                                    </button>
                                </div>
                            </td>

                            @if (sucursalIdSeleccionada != 0)
                            {
                                <td class="text-nowrap th-stock-simple td-stock-simple">
                                    @item.Stock_EnString @item.StockUnidades
                                </td>
                            }

                            <!-- celdas de stock por sucursal (se muestran sólo si switchStockSucursales ON) -->
                            @foreach (var s in sucursales)
                            {
                                <td class="td-stock-sucursal d-none text-nowrap"
                                    data-sucid="@s.IdSucursal"
                                    id="stk_@s.IdSucursal">
                                    <span class="text-muted">—</span>
                                </td>
                            }

                            <td class="text-nowrap font-weight-bold td-precio-producto" id="precio_@item.idCorte">
                                @item.PrecioKg.ToString("C")
                            </td>

                            <td class="text-nowrap td-acciones-producto">
                                <a class="btn btn-sm btn-primary mr-1 js-editar-producto @(puedeEditarProducto ? "" : "disabled")"
                                   title="Ver producto"
                                   href="@Url.Action("AddOrEdit", "Productos", new { id = item.idCorte })">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-warning mr-1"
                                        title="Modificar precio"
                                        onclick="abrirPopupPrecio(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))', '@item.PrecioKg', this)"
                                        @(puedeModificarPreciosProducto ? "" : "disabled")>
                                    <i class="fas fa-dollar-sign"></i>
                                </button>

                                <button type="button" class="btn btn-sm btn-info mr-1 js-btn-stock-sucursales"
                                        title="Ver / editar stock por sucursales"
                                        onclick="verStockSucursales(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))', this)">
                                    <i class="fas fa-warehouse"></i>
                                </button>

                                <button type="button" class="btn btn-sm btn-danger"
                                        title="Eliminar"
                                        onclick="confirmarEliminar(@item.idCorte, '@(item.CorteDesc?.Replace("'", "\\'"))')"
                                        @(puedeEliminarProducto ? "" : "disabled")>
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- DETALLES (siempre disponibles) -->
                        <tr class="tr-detalles">
                            @{
                                int baseCols = ((sucursalIdSeleccionada != 0) ? 5 : 4) + sucursales.Count; // incluye columnas stock sucursales (aunque estén ocultas)
                                int colspan = modoEtiquetas ? (baseCols + 1) : baseCols;
                            }
                            <td colspan="@colspan" class="p-0">
                                <div id="@detailsId" class="collapse">
                                    <div class="p-3 bg-light border-top">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div class="mb-2">
                                                    <span class="font-weight-bold">@item.CorteDesc</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted">Tipo:</span>
                                                    <span class="font-weight-bold">@item.Tipo</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Marca:</span>
                                                    <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(item.MarcaNombre) ? item.MarcaNombre : "-")</span>

                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Alícuota IVA:</span>
                                                    <span class="font-weight-bold">@item.AlicuotaIva</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Pesable:</span>
                                                    <span class="font-weight-bold">@(item.Pesable ? "Sí" : "No")</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Habilitado:</span>
                                                    <span class="font-weight-bold">@(item.Habilitado ? "Sí" : "No")</span>
                                                </div>
                                            </div>

                                            <div class="col-lg-6">

                                                <div class="mb-2">
                                                    <span class="text-muted">Punto stock:</span>
                                                    <span class="font-weight-bold">@item.PuntoStock</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">En cierre stock:</span>
                                                    <span class="font-weight-bold">@(item.EnCierreStock ? "Sí" : "No")</span>
                                                </div>

                                                <div class="mb-2">
                                                    <span class="text-muted">Promedio:</span>
                                                    <span class="font-weight-bold">@item.Promedio</span>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.CorteMaestroNombre))
                                            {
                                                var esPres = item.Presentacion;

                                                <div class="col-lg-6">
                                                    <div class="mb-2">

                                                        @if (esPres)
                                                        {
                                                            <div class="mb-2">

                                                                <span class="text-muted">Presentación:</span>
                                                                <span class="font-weight-bold">@item.CorteMaestroNombre</span>
                                                            </div>
                                                            <span class="text-muted">Unidades:</span>
                                                            <span class="font-weight-bold">
                                                                @item.getCantPresentacion(item.PorcentajeHueso)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <div class="mb-2">

                                                                <span class="text-muted">Corte Maestro:</span>
                                                                <span class="font-weight-bold">@item.CorteMaestroNombre</span>
                                                            </div>
                                                            <span class="text-muted">%:</span>
                                                            <span class="font-weight-bold">
                                                                @item.Porcentaje
                                                            </span>
                                                        }
                                                    </div>

                                                    @if (!esPres)
                                                    {
                                                        <div class="mb-2">
                                                            <span class="text-muted">% Hueso:</span>
                                                            <span class="font-weight-bold">@item.PorcentajeHueso</span>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                        </div>

                                        <div class="mt-2 text-muted small">
                                            ID: <b>@item.idCorte</b>
                                            @* Si tenés CorteMaestro / independiente / etc, lo agregamos acá *@
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
    </div>

    <!-- =========================
         MODAL EDITAR PRECIO
         ========================= -->
    <form id="formPrecio" method="post">
        @Html.AntiForgeryToken()

        <div class="modal fade" id="modalPrecio" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Modificar precio</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="IdCorte" name="IdCorte" />

                        <div class="border rounded p-3 mb-3">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="switchEscanerPrecio">
                                <label class="custom-control-label" for="switchEscanerPrecio">Mediante escáner de código de barras</label>
                            </div>

                            <div id="bloqueEscanerPrecio" class="d-none mt-3">
                                <div id="scannerPrecioContainer" class="d-none mb-3">
                                    <div class="card shadow-sm">
                                        <div class="card-body p-2">
                                            <div class="scanner-wrapper">
                                                <video id="videoScannerPrecio" autoplay muted playsinline></video>
                                                <div class="scanner-line"></div>
                                            </div>

                                            <div class="d-flex justify-content-between mt-2">
                                                <button type="button" class="btn btn-secondary btn-sm" id="btnFlashScannerPrecio">🔦 Flash</button>
                                                <button type="button" class="btn btn-danger btn-sm" id="btnCerrarScannerPrecio">Cerrar cámara</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group mb-2">
                                    <label>Código</label>
                                    <div class="input-group">
                                        <button type="button" class="btn btn-outline-secondary" id="btnScannerPrecio" title="Escanear código">
                                            <i class="fas fa-barcode"></i>
                                        </button>
                                        <input type="text" id="CodigoPrecio" class="form-control" inputmode="numeric" autocomplete="off" placeholder="Escanee o ingrese el código">
                                    </div>
                                    <small id="scannerPrecioMsg" class="text-danger d-none"></small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group js-precio-individual-block">
                            <label>Producto</label>
                            <input type="text" id="CorteDesc" class="form-control" readonly>
                        </div>

                        <div class="form-group js-precio-individual-block">
                            <label>Precio actual</label>
                            <input type="text" id="PrecioActual" class="form-control" readonly>
                        </div>

                        <div class="form-group mt-2 js-precio-individual-block">
                            <label>Nuevo precio</label>
                            <input type="text" id="PrecioKg" name="PrecioKg" class="form-control" autocomplete="off">
