@model List<Entidades.Corte>

@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">

    <form method="get" id="formStock" class="mb-3" action="@Url.Action("Index","Productos")">

        <!-- COMBO SUCURSALES -->
        <div class="form-group">
            <label class="font-weight-bold">Seleccione una sucursal para mostrar el stock</label>
            <select class="form-control" id="SucursalId" name="SucursalId"
                    onchange="document.getElementById('formStock').submit()">
                <option value="">- Seleccione sucursal -</option>

                @foreach (var s in (List<Entidades.Sucursal>)ViewBag.Sucursales)
                {
                    <option value="@s.IdSucursal"
                            @(ViewBag.SucursalId != null && ViewBag.SucursalId == s.IdSucursal ? "selected" : "")>
                        @s.SucursalNombre
                    </option>
                }
            </select>
        </div>

    </form>


    <!-- 🔍 Buscador -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" id="buscador" class="form-control" placeholder="Buscar por código o nombre...">
                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">

        <div class="mb-2">
            <span id="contadorProductos" class="text-secondary font-weight-bold"></span>
        </div>

        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <label class="mb-0 mr-2">Zoom:</label>
                <input type="range" id="zoomRange" min="0.5" max="1.5" step="0.1" value="1" style="width: 120px;">
            </div>
        </div>

        <div class="card-body">

            <div id="zoomTableContainer" class="tabla-full">
                <div id="zoomWrapper" style="transform-origin: top left; transition: transform 0.2s; display: inline-block;">

                    <table class="table table-bordered table-striped" style="min-width: 900px;">
                        <thead class="thead-dark">
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Precio</th>
                                @*<th>Stock</th>*@
                                @if (ViewBag.SucursalId != null && ViewBag.SucursalId != 0)
                                {
                                    <th>Stock</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr id="fila_@item.idCorte">
                                <td class="col-codigo">@item.Codigo</td>
                                <td class="col-producto">@item.CorteDesc</td>
                                <td class="col-precio" id="precio_@item.idCorte">@item.PrecioKg.ToString("C")</td>
                                @*<td class="col-tipo">@item.Stock_EnString</td>*@

                                @if (ViewBag.SucursalId != null && ViewBag.SucursalId != 0)
                                {
                                    <td class="col-tipo">@item.Stock_EnString @item.StockUnidades</td>
                                }
                                <td>
                                    <button type="button" class="btn btn-sm btn-warning"
                                            onclick="abrirPopupPrecio(@item.idCorte, '@item.CorteDesc', '@item.PrecioKg')">
                                        <i class="fas fa-dollar-sign"></i>
                                    </button>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>

        <!-- ⭐ MODAL PARA EDITAR PRECIO ⭐ -->
        <form id="formPrecio" method="post">
            @Html.AntiForgeryToken()

            <div class="modal fade" id="modalPrecio" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-sm" role="document">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Modificar precio</h5>

                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>

                        </div>

                        <div class="modal-body">

                            <input type="hidden" id="IdCorte" name="IdCorte" />

                            <div class="form-group">
                                <label>Producto</label>
                                <input type="text" id="CorteDesc" class="form-control" readonly>
                            </div>

                            <div class="form-group mt-2">
                                <label>Nuevo precio</label>
                                <input type="text" id="PrecioKg" name="PrecioKg" class="form-control" autocomplete="off">
                                <small id="errorPrecio" class="text-danger d-none">El precio ingresado es inválido.</small>
                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button" class="btn btn-success" onclick="guardarPrecio()">Guardar</button>

                            <button type="button" class="btn btn-secondary" data-dismiss="modal">
                                Cancelar
                            </button>

                        </div>

                    </div>
                </div>
            </div>
        </form>

    </div>

</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    // ============================
    // BUSCADOR
    // ============================
    const buscador = document.getElementById("buscador");
    const filas = document.querySelectorAll("table tbody tr");
    const contador = document.getElementById("contadorProductos");

    actualizarContador();

    buscador.addEventListener("keyup", function () {
        const valor = this.value.toLowerCase();
        let visibles = 0;

        filas.forEach(fila => {
            const codigo = fila.children[0]?.textContent.toLowerCase() || "";
            const producto = fila.children[1]?.textContent.toLowerCase() || "";
            const coincide = codigo.includes(valor) || producto.includes(valor);
            fila.style.display = coincide ? "" : "none";
            if (coincide) visibles++;
        });

        actualizarContador(visibles);
    });

    function actualizarContador(cantidadVisible) {
        const total = filas.length;
        const cantidad = cantidadVisible !== undefined ? cantidadVisible : total;
        contador.textContent = `Mostrando ${cantidad} de ${total} productos`;
    }

    // ============================
    // ZOOM
    // ============================
    const range = document.getElementById('zoomRange');
    const zoomWrapper = document.getElementById('zoomWrapper');

    range.addEventListener('input', () => {
        const scale = parseFloat(range.value);
        zoomWrapper.style.transform = `scale(${scale})`;
    });

    // =========================
    // ABRIR MODAL + FOCO
    // =========================
    function abrirPopupPrecio(id, nombreTabla, precioTabla) {

        $("#errorPrecio").addClass("d-none");

        // Cargar ID y desc por si la consulta demora
        $("#IdCorte").val(id);
        $("#CorteDesc").val(nombreTabla);
        $("#PrecioKg").val(precioTabla);

        // Mostrar el modal YA
        $("#modalPrecio").modal("show");

        // Luego consultar el valor real desde BD
        $.ajax({
            url: '@Url.Action("findCorteById", "Productos")',
            //url: baseUrl + '/Productos/findCorteById',
            type: 'GET',
            data: { id: id },
            success: function (resp) {

                // Cargar datos reales desde la BD
                $("#CorteDesc").val(resp.descripcion);
                $("#PrecioKg").val(resp.precio);

                // Foco en el input con selección
                setTimeout(() => {
                    const inp = document.getElementById("PrecioKg");
                    inp.focus();
                    inp.select();
                }, 80);
            },
            error: function () {
                // Si falla, sigo usando los datos pasados por la tabla
                console.warn("No se pudo obtener el precio desde la BD.");

                setTimeout(() => {
                    const inp = document.getElementById("PrecioKg");
                    inp.focus();
                    inp.select();
                }, 80);
            }
        });
    }


    $('#modalPrecio').on('shown.bs.modal', function () {
        const inp = document.getElementById("PrecioKg");
        inp.focus();
        inp.select();
    });

    $('#modalPrecio').on('hidden.bs.modal', function () {
        $("#PrecioKg").val("");
    });

    // =========================
    // GUARDAR PRECIO
    // =========================
    function guardarPrecio() {

        let precioRaw = $("#PrecioKg").val().trim();

        if (precioRaw === "") {
            $("#errorPrecio").removeClass("d-none");
            return;
        }

        // Convertir punto a coma
        precioRaw = precioRaw.replace(".", ",");

        // Para validar: convertir coma a punto
        let precioNormalizado = precioRaw.replace(",", ".");
        let numero = parseFloat(precioNormalizado);

        if (isNaN(numero) || numero <= 0) {
            $("#errorPrecio").removeClass("d-none");
            return;
        }

        $("#PrecioKg").val(precioRaw); // enviar tal cual

        $.ajax({
            //url: baseUrl + '/Productos/EditPrecioCorte',
            url: '@Url.Action("EditPrecioCorte", "Productos")',
            type: 'POST',
            data: $("#formPrecio").serialize(),
            success: function (resp) {
                $("#precio_" + resp.id).text(resp.precioFormateado);
                $("#modalPrecio").modal("hide");
            },
            error: function () {
                alert("Error al actualizar el precio.");
            }
        });
    }

    // =========================
    // INPUT SIMPLE: punto y coma = coma
    // =========================

    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("PrecioKg");
        if (!input) return;

        // ENTER
        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                guardarPrecio();
            }
        });

        // No formatear, solo limpiar y manejar decimal
        input.addEventListener("input", function () {

            let v = this.value;

            // Reemplazar punto → coma
            v = v.replace(/\./g, ",");

            // Dejar solo números y coma
            v = v.replace(/[^\d,]/g, "");

            // Permitir solo una coma
            let partes = v.split(",");
            if (partes.length > 2) {
                v = partes[0] + "," + partes[1];
            }

            this.value = v;
        });
    });

    // =========================
    // SUCURSAL CAMBIO AUTO
    // =========================

    function onSucursalChange() {
        document.getElementById('formStock').submit();
    }

</script>

<style>
    .tabla-full {
        width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    table {
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .card-body {
            padding: 5px !important;
        }
    }
</style>
