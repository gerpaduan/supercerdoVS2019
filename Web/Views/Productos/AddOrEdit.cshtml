@model CorteUpsertVM
@using System.Collections.Generic
@using System.Web.Mvc

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    bool esEdicion = Model != null && Model.IdCorte > 0;
    bool productoGuardadoContinuo = ViewBag.ProductoGuardadoContinuo != null && System.Convert.ToBoolean(ViewBag.ProductoGuardadoContinuo);
    ViewBag.Title = esEdicion ? "Editar producto" : "Alta de producto";
}

<style>
    .producto-edit-page {
        font-size: .9rem;
    }

    .producto-edit-page .form-control,
    .producto-edit-page .form-select,
    .producto-edit-page select.form-control {
        min-height: 2.6rem;
        font-size: .87rem;
        border-radius: .55rem;
        padding: .32rem .62rem;
    }

    .producto-edit-page .btn:not(.btn-sm) {
        min-height: 2.6rem;
        font-size: .87rem;
        border-radius: .55rem;
        padding: .32rem .7rem;
    }

    .producto-edit-page .form-label,
    .producto-edit-page .form-check-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .32rem;
    }

    .producto-edit-page .small,
    .producto-edit-page small,
    .producto-edit-page .text-muted {
        font-size: .74rem;
        line-height: 1.15;
    }

    .producto-edit-page .alert {
        font-size: .82rem;
    }

    .producto-edit-page .input-group > .btn,
    .producto-edit-page .input-group > .form-control {
        min-height: 2.6rem;
    }

    .producto-edit-card {
        padding: .9rem 1rem !important;
        border-radius: .75rem;
    }

    .producto-edit-section-title {
        font-size: .82rem;
        line-height: 1.05;
        letter-spacing: .03em;
        margin-bottom: .8rem !important;
    }

    html:not(.dark-mode) body .form-switch {
        padding-left: 3rem;
    }

    html:not(.dark-mode) body .form-switch .form-check-input {
        width: 2.55rem;
        height: 1.35rem;
        margin-top: 0.1rem;
        margin-left: -3rem;
        vertical-align: top;
        cursor: pointer;
        border: 1px solid #b8c2d1;
        border-radius: 999px;
        background-color: #dfe6ef;
        background-image: radial-gradient(circle, #ffffff 0 42%, transparent 43%);
        background-repeat: no-repeat;
        background-position: left 0.14rem center;
        background-size: 1rem 1rem;
        -webkit-appearance: none;
        appearance: none;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
        transition: background-color 0.16s ease, border-color 0.16s ease, background-position 0.16s ease, box-shadow 0.16s ease;
    }

    html:not(.dark-mode) body .form-switch .form-check-input:checked {
        background-color: #4e73df;
        border-color: #4e73df;
        background-position: right 0.14rem center;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(78, 115, 223, 0.12);
    }

    html:not(.dark-mode) body .form-switch .form-check-input:focus {
        outline: none;
        box-shadow: 0 0 0 0.16rem rgba(78, 115, 223, 0.2);
    }

    html:not(.dark-mode) body .producto-focus-switch .form-check-input:focus {
        box-shadow: 0 0 0 0.24rem rgba(78, 115, 223, 0.34), inset 0 0 0 1px rgba(15, 23, 42, 0.08);
    }

    .producto-focus-switch:focus-within .form-check-label {
        font-size: .82rem;
        font-weight: 700;
    }

    html:not(.dark-mode) body .form-switch .form-check-input:disabled {
        cursor: default;
        opacity: 1;
        background-color: #e9edf4;
        border-color: #cfd7e3;
    }

    html:not(.dark-mode) body .form-switch .form-check-input:disabled:checked {
        background-color: #4e73df;
        border-color: #4e73df;
        background-position: right 0.14rem center;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(78, 115, 223, 0.12);
    }

    .atajos-acciones {
        font-size: 0.74rem;
        line-height: 1.35;
    }

    .producto-edit-page .row.g-3 {
        row-gap: .8rem !important;
    }

    .producto-edit-page .form-check.form-switch {
        margin-bottom: .55rem !important;
    }

    .producto-edit-page .btn-guardar-destacado,
    .producto-edit-page #btnHabilitarEdicionProducto,
    .producto-edit-page #btnVolverProducto,
    .producto-edit-page #btnSiguienteProducto {
        font-size: .84rem;
    }

    @@media (min-width: 992px) {
        .producto-edit-card {
            padding: .85rem .95rem !important;
        }
    }
</style>

<div class="container-fluid px-2 px-md-3 producto-edit-page">

    <div class="row">
        <div class="col-12 col-lg-7">

            @using (Html.BeginForm("Guardar", "Productos", FormMethod.Post, new { id = "frmCorte", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IdCorte)
                @Html.HiddenFor(m => m.IdMarca)
                @Html.HiddenFor(m => m.IdCorteMaestro)
                @Html.HiddenFor(m => m.Porcentaje)
                @Html.HiddenFor(m => m.PorcentajeHueso)
                @Html.HiddenFor(m => m.AlicuotaIva)
                @Html.HiddenFor(m => m.SiguienteIdEdicion)
                @Html.HiddenFor(m => m.UltimoProductoContinuoId)
                @Html.HiddenFor(m => m.RetomarProductoId)
                @Html.HiddenFor(m => m.FlujoBaseContinuo)
                <input type="hidden" name="EsEdicionFormulario" value="@(esEdicion ? "1" : "0")" />

                <div id="page-urls"
                     data-url-add-or-edit="@Url.Action("AddOrEdit", "Productos")"
                     data-url-marcas="@Url.Action("BuscarMarca", "Productos")"
                     data-url-cortes="@Url.Action("Buscar", "Productos")"
                     data-url-existe-codigo="@Url.Action("FindCorteByCodigo", "Productos")"
                     data-url-autocomplete-global="@(esEdicion ? "" : Url.Action("BuscarProductoGlobalParaAlta", "Productos"))">
                </div>

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                @* El mensaje de "guardado correctamente" ahora lo muestra el cartel
                   generico de _LayoutBase.cshtml (SweetAlert2) -- este div ya no es
                   un banner visual, solo lleva el flag data-recargar que lee el
                   script de mas abajo para saber si toca avanzar solo al siguiente
                   formulario en blanco (modo "carga continua"). *@
                <div id="alertCargaContinua"
                     class="d-none"
                     data-recargar="@(!esEdicion && productoGuardadoContinuo ? "1" : "0")">
                </div>

                <!-- =========================
                 1) DATOS PRINCIPALES
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3 producto-edit-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="mb-0 producto-edit-section-title">Datos del producto</h5>
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-3">
                            <span class="text-muted @(esEdicion ? "" : "d-none")">ID: <b>@Model.IdCorte</b></span>
                            <div class="form-check form-switch mb-0 text-end producto-focus-switch">
                                @Html.CheckBoxFor(m => m.CargaContinua, new { @class = "form-check-input", id = "swCargaContinua", data_edit_readonly_ignore = "true" })
                                <label class="form-check-label fw-semibold" for="swCargaContinua">Carga continua</label>
                            </div>
                        </div>
                    </div>

                    <div id="hintCargaContinuaAlta" class="small text-info mb-3 d-none">
                        Al guardar, se limpia el formulario para cargar el siguiente producto.
                    </div>
                    <div id="hintCargaContinuaEdicion" class="small text-info mb-3 d-none">
                        Al guardar, se abre el siguiente producto visible de la grilla actual.
                    </div>
                    <div class="row g-3">
                        <!-- ?? SCANNER (arriba del C�digo) -->
                        <div class="col-12" id="scannerContainer" style="display:none;">
                            <div class="card shadow-sm">
                                <div class="card-body p-2">

                                    <div class="scanner-wrapper">
                                        <video id="videoScanner" autoplay muted playsinline></video>
                                        <div class="scanner-line"></div>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-between mt-2">
                                        <button type="button" class="btn btn-secondary btn-sm" id="btnFlash">Flash</button>
                                        <button type="button" class="btn btn-warning btn-sm" id="btnLimpiarScanner">Limpiar</button>
                                        <button type="button" class="btn btn-danger btn-sm" id="btnCerrarScanner">Cerrar cámara</button>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Código</label>

                            <div class="input-group">
                                <button type="button" class="btn btn-outline-secondary" id="btnScanner" title="Escanear código">
                                    <i class="fas fa-barcode"></i>
                                </button>
                                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", inputmode = "numeric", placeholder = "EAN / código interno", id = "Codigo", maxlength = "15" })
                            </div>

                            <small id="scannerMsg" class="text-danger d-none"></small>
                            <small id="autocompleteCodigoMsg" class="text-success d-none"></small>
                            <div id="alertCodigoExiste" class="alert alert-warning py-2 px-2 mt-2 mb-0 d-none"></div>
                            <small id="msgCodigoReq" class="text-danger d-none">El campo codigo es obligatorio.</small>
                            <small id="msgCodigoEanInvalido" class="text-danger d-none">El código de barras no es válido (dígito verificador incorrecto).</small>
                            @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-12 col-md-8">
                            <label class="form-label">Nombre</label>
                            @Html.TextBoxFor(m => m.CorteDesc, new { @class = "form-control", maxlength = "50", id = "CorteDesc" })
                            <small id="msgNombreReq" class="text-danger d-none">El campo nombre es obligatorio.</small>
                            @Html.ValidationMessageFor(m => m.CorteDesc, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Precio Kg</label>
                            @Html.TextBoxFor(m => m.PrecioKg, new { @class = "form-control", placeholder = "0,00", id = "PrecioKg", inputmode = "decimal" })
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Tipo</label>
                            @Html.DropDownListFor(m => m.Tipo, Model.Tipos ?? new List<SelectListItem>(),
                                "Seleccione...", new { @class = "form-control", id = "ddlTipo" })
                            <small id="msgTipoReq" class="text-danger d-none">Debe seleccionar un tipo.</small>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">IVA</label>
                            @Html.DropDownListFor(m => m.IdAlicuotaIva, Model.AlicuotasIva ?? new List<SelectListItem>(),
                                "Seleccione...", new { @class = "form-control", id = "ddlIva" })
                            <small id="msgIvaReq" class="text-danger d-none">Debe seleccionar un IVA.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Marca (opcional)</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="txtMarcaNombre"
                                       value="@(Model?.MarcaNombre ?? "")" readonly placeholder="Sin marca" tabindex="-1" />
                                <button type="button" class="btn btn-outline-secondary" id="btnBuscarMarca" title="Buscar marca (F9)" tabindex="-1">
                                    <i class="fas fa-search"></i><span class="d-none d-md-inline ml-1 small">F9</span>
                                </button>
                                <button type="button" class="btn btn-outline-danger" id="btnLimpiarMarca" title="Quitar marca"><i class="fas fa-times"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================
                 2) STOCK Y ESTADO (debajo)
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3 producto-edit-card">
                    <h5 class="mb-3 producto-edit-section-title">Stock y estado</h5>

                    <div class="row g-3">


                        <div class="col-12">
                            <div class="form-check form-switch mb-2 producto-focus-switch">
                                @Html.CheckBoxFor(m => m.Pesable, new { @class = "form-check-input", id = "swPesable" })
                                <label class="form-check-label" for="swPesable">Pesable</label>
                            </div>

                            <div class="form-check form-switch mb-2 producto-focus-switch">
                                @Html.CheckBoxFor(m => m.Habilitado, new { @class = "form-check-input", id = "swHabilitado" })
                                <label class="form-check-label" for="swHabilitado">Habilitado</label>
                            </div>

                            <!-- Oculto a proposito: este flag ahora se activa/desactiva solo desde
                                 /Elaborados/EditarFormula (interruptor "Ingreso Rapido", ver
                                 docs/DECISIONS.md 2026-08-22) -- se sigue posteando su valor actual
                                 sin cambios al guardar el producto desde esta pantalla. -->
                            <div class="form-check form-switch mb-2 producto-focus-switch d-none">
                                @Html.CheckBoxFor(m => m.IngresoRapidoEmbutido, new { @class = "form-check-input", id = "swRapido" })
                                <label class="form-check-label" for="swRapido">Ingreso rápido elaborado</label>
                            </div>

                            <div class="form-check form-switch mb-2 producto-focus-switch">
                                @Html.CheckBoxFor(m => m.EnCierreStock, new { @class = "form-check-input", id = "swCierre" })
                                <label class="form-check-label" for="swCierre">En cierre stock</label>
                            </div>
                            <small id="avisoCierreStockSinIndependiente" class="text-warning mt-n1 mb-2 d-none">
                                Este producto no va a aparecer en el reporte de Cierre de Stock hasta que actives "Independiente" (sección Producto Maestro / Presentación).
                            </small>
                        </div>

                        <div class="col-12 col-md-6 @(esEdicion ? "d-none" : "")">
                            <label class="form-label">
                                Punto Stock (número entero)
                                <button type="button" class="btn btn-sm btn-link p-0 ml-1 align-baseline" id="btnInfoPuntoStock" title="¿Para qué sirve este valor?" tabindex="-1">
                                    <i class="fas fa-info-circle"></i>
                                </button>
                            </label>
                            @Html.TextBoxFor(m => m.PuntoStock, new { @class = "form-control", inputmode = "numeric" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Promedio</label>
                            @Html.TextBoxFor(m => m.Promedio, new { @class = "form-control", placeholder = "0,00" })
                        </div>

                        
                        <div class="col-12 col-md-6 @(esEdicion ? "" : "d-none")">
                        
                            
                            
                                <label class="form-label">Nivel (solo edición)</label>
                                <input class="form-control" value="@Model.Nivel" readonly />
                        
                        
                            
                        </div>


                    </div>
                </div>

                <!-- =========================
                 3) CORTE MAESTRO / PRESENTACIÓN (debajo)
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3 producto-edit-card">
                    <h5 class="mb-3 producto-edit-section-title">Producto maestro / Presentación</h5>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Modo</label>
                            @Html.DropDownListFor(m => m.ModoCorte,
                                new List<SelectListItem> {
                                    new SelectListItem{ Text="Ninguno", Value="Ninguno" },
                                    new SelectListItem{ Text="Producto maestro", Value="CorteMaestro" },
                                    new SelectListItem{ Text="Presentación", Value="Presentacion" },
                                },
                                new { @class = "form-control", id = "ddlModo" })
                        </div>

                        <div class="col-12 col-md-8" id="boxCorteMaestro">
                            <label class="form-label">Producto maestro</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="txtCorteMaestroNombre"
                                       value="@(Model?.CorteMaestroNombre ?? "")"
                                       readonly placeholder="Seleccione un producto maestro..." />
                                <button type="button" class="btn btn-outline-secondary" id="btnBuscarCorteMaestro" title="Buscar producto maestro (F10)">
                                    <i class="fas fa-search"></i><span class="d-none d-md-inline ml-1 small">F10</span>
                                </button>
                                <button type="button" class="btn btn-outline-danger" id="btnLimpiarCorteMaestro"><i class="fas fa-times"></i></button>
                            </div>
                        </div>

                        <div class="col-12" id="boxCorteMaestroCampos">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">% (Porcentaje)</label>
                                    <input type="text" class="form-control" id="txtPorcentaje"
                                           value="@(Model != null ? Model.Porcentaje.ToString() : "0")"
                                           placeholder="0,00" inputmode="decimal" />
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Desperdicio</label>
                                    <input type="text" class="form-control" id="txtDesperdicio"
                                           value="@(Model != null ? Model.PorcentajeHueso.ToString() : "0")"
                                           placeholder="0,00" inputmode="decimal" />
                                </div>
                            </div>
                        </div>


                        <div class="col-12" id="boxPresentacionCampos">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Presentación (unidades)</label>
                                    <input type="text" class="form-control" id="txtPresentacionUnidades"
                                           name="PresentacionUnidades"
                                           value="@(Model?.PresentacionUnidades != null ? Model.PresentacionUnidades.ToString() : "")"
                                           placeholder="Ej: 5" inputmode="decimal" />
                                </div>
                            </div>
                        </div>


                        <div class="col-12" id="boxIndependiente">
                            <div class="form-check form-switch producto-focus-switch d-inline-block">
                                @Html.CheckBoxFor(m => m.Independiente, new { @class = "form-check-input", id = "swIndependiente" })
                                <label class="form-check-label" for="swIndependiente">Independiente</label>
                            </div>
                            <button type="button" class="btn btn-sm btn-link p-0 ml-1 align-baseline" id="btnInfoIndependiente" title="¿Qué significa 'Independiente'?" tabindex="-1">
                                <i class="fas fa-info-circle"></i>
                            </button>
                        </div>

                    </div>
                </div>

                <!-- =========================
                 4) BOTONERA (fija al pie)
                 ========================= -->
                <div class="espacio-botonera-fija"></div>

                <div class="barra-acciones-fija">
                    <div class="barra-acciones-inner d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <a class="btn btn-outline-secondary" id="btnVolverProducto" href="@Url.Action("Index","Productos")" title="Alt+V">
                            <span class="shortcut-letter">V</span>olver
                        </a>

                        <div class="producto-edit-actions-right d-flex flex-column align-items-end">
                            <div class="producto-edit-actions-buttons d-flex gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary d-none"
                                    id="btnSiguienteProducto"
                                    data-edit-readonly-ignore="true"
                                    title="Alt+S">
                                <span class="shortcut-letter">S</span>iguiente
                            </button>
                            <button type="button"
                                    class="btn btn-secondary @(esEdicion ? "" : "d-none")"
                                    id="btnHabilitarEdicionProducto"
                                    data-edit-readonly-ignore="true"
                                    title="Alt+M">
                                <span class="shortcut-letter">M</span>odificar
                            </button>
                            <button type="submit" name="accion" value="guardar" class="btn btn-primary btn-guardar-destacado @(esEdicion ? "d-none" : "")" id="btnGuardarProducto" title="@(esEdicion ? "Alt+G o Alt+C" : "Alt+C o Alt+G")">
                                @if (esEdicion)
                                {
                                    <span><span class="shortcut-letter">G</span>uardar cambios</span>
                                }
                                else
                                {
                                    <span><span class="shortcut-letter">C</span>rear producto</span>
                                }
                            </button>

                            @*<button type="submit" name="accion" value="guardar_nuevo" class="btn btn-outline-primary">
                                    @(esEdicion ? "Guardar y cargar otro" : "Crear y continuar")
                                </button>*@
                            </div>
                            <div class="atajos-acciones small text-muted d-none d-lg-block mt-1 text-right" id="atajosAccionesProducto"></div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<audio id="beep" src="@Url.Content("~/Content/sounds/focus-beep.wav")" preload="auto"></audio>

<!-- MODAL MARCAS -->
<div class="modal fade" id="modalMarcas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fit-screen modal-search-compact-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white modal-search-compact-header">
                <h5 class="modal-title">Buscar marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-search-compact-body">
                <div class="input-group mb-2">
                    <input type="text" class="form-control" id="qMarca" placeholder="Escribí para buscar..." />
                    <button class="btn btn-primary" type="button" id="btnDoBuscarMarca">Buscar</button>
                </div>

                <div class="table-responsive modal-table-scroll" id="wrapTablaMarcas">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Marca</th>
                                <th style="width:35%;">Propietario</th>
                            </tr>
                        </thead>
                        <tbody id="tbMarcas">
                            <tr><td colspan="2" class="text-muted">Cargando marcas...</td></tr>
                        </tbody>
                    </table>
                </div>

                <small class="text-muted d-block mt-2 modal-search-help">
                    Enter = selecciona la primera fila. Doble clic = selecciona la fila.
                </small>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CORTES (Corte Maestro) - reutiliza partial -->
@{
    var vdBuscarCorteMaestro = new ViewDataDictionary();
    vdBuscarCorteMaestro["ModalId"] = "modalBuscarProducto";
    vdBuscarCorteMaestro["ApiUrl"] = Url.Action("ListarProductos", "Productos"); // tu endpoint actual
    vdBuscarCorteMaestro["Titulo"] = "Seleccionar producto";
    vdBuscarCorteMaestro["MostrarPrecio"] = false; // ocultar precio en alta/edici�n
}

@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", vdBuscarCorteMaestro)

<!-- MODAL INFO: que significa "Independiente" -->
<div class="modal fade" id="modalInfoIndependiente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white modal-search-compact-header">
                <h5 class="modal-title">¿Qué significa "Independiente"?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Este producto es derivado de un Producto Maestro (o forma parte de una presentación).
                    El interruptor define si este producto lleva su <strong>propio renglón de stock</strong>,
                    separado del maestro.
                </p>
                <ul>
                    <li>
                        <strong>Activado</strong>: cuando el maestro se vende/consume, a este producto se le
                        descuenta automáticamente su parte según el % que le corresponde (ej. el maestro
                        reparte 40%/60% entre dos derivados — si el maestro consume 10, a este le descuenta 4).
                        Y si vendés este producto directamente, también le resta al maestro.
                    </li>
                    <li>
                        <strong>Desactivado</strong>: este producto no lleva stock propio — todo lo que vendas
                        de él se descuenta directo del maestro, sin quedar registrado acá.
                    </li>
                </ul>
                <p>
                    Dos productos derivados del mismo maestro (hermanos) <strong>nunca se afectan entre sí</strong>,
                    tenga cada uno "Independiente" activado o no. El movimiento siempre pasa por el maestro,
                    nunca de un hermano a otro.
                </p>
                <p class="mb-0">
                    Para que este producto aparezca como renglón en el reporte de "Cierre de Stock" necesita
                    <strong>"Independiente" Y "En cierre stock" activados los dos</strong> — con uno solo no alcanza.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- MODAL INFO: para que sirve el Punto Stock -->
<div class="modal fade" id="modalInfoPuntoStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white modal-search-compact-header">
                <h5 class="modal-title">¿Para qué sirve el Punto Stock?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    Este valor se va a cargar como punto de stock inicial en todas las sucursales existentes al
                    crear el producto. Después se administra por sucursal desde "Ver stock por sucursales".
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const barra = document.querySelector('.barra-acciones-fija');
        if (!barra) return;

        // Busca la columna que contiene el formulario/botonera
        const contenedor = barra.closest('.col-12.col-lg-7')
            || document.querySelector('#frmCorte')?.closest('.col-12.col-lg-7');

        if (!contenedor) return;

        function ajustarBarra() {
            const r = contenedor.getBoundingClientRect();

            barra.style.left = r.left + 'px';
            barra.style.width = r.width + 'px';
        }

        ajustarBarra();

        window.addEventListener('resize', ajustarBarra);
        window.addEventListener('scroll', ajustarBarra, { passive: true });

        // Por si cambia el layout din�micamente (responsive / contenido)
        if (window.ResizeObserver) {
            const ro = new ResizeObserver(ajustarBarra);
            ro.observe(contenedor);
        }
    })();
</script>

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=1")"></script>
    <script>
(function () {
    // =========================
    // URLs
    // =========================
    const $urls = $("#page-urls");
    const urlMarcas = $urls.data("url-marcas");
    const urlCortes = $urls.data("url-cortes");
    const urlExisteCodigo = $urls.data("url-existe-codigo");
    const urlAddOrEdit = $urls.data("url-add-or-edit");
    const urlAutocompleteGlobal = $urls.data("url-autocomplete-global");

    const esEdicion = @((Model?.IdCorte ?? 0) > 0 ? "true" : "false");
    const cargaContinuaInicial = @(Model?.CargaContinua == true ? "true" : "false");
    const idProductoActual = @(Model?.IdCorte ?? 0);
    const STORAGE_ORDEN_EDICION_KEY = "productos_edicion_orden_visible";
    const STORAGE_HISTORIAL_EDICION_KEY = "productos_edicion_historial";
    const STORAGE_MODO_EDICION_ACTIVO_KEY = "productos_edicion_modo_activo";
    const STORAGE_FOCUS_CODIGO_KEY = "productos_focus_codigo";
    const flujoBaseContinuo = '@((Model?.FlujoBaseContinuo ?? "").ToLowerInvariant())';

    // =========================
    // Refs principales
    // =========================
    const $frm = $("#frmCorte");
    const $btnVolver = $("#btnVolverProducto");
    const $btnGuardar = $("#btnGuardarProducto");
    const $btnVerAnteriorProducto = $("#btnVerAnteriorProducto");
    const $btnSiguienteProducto = $("#btnSiguienteProducto");
    const $btnHabilitarEdicionProducto = $("#btnHabilitarEdicionProducto");
    const $atajosAccionesProducto = $("#atajosAccionesProducto");
    const $codigo = $("#Codigo");
    const $precioKg = $("#frmCorte").find("input[name='PrecioKg']").first();
    const $promedio = $("#frmCorte").find("input[name='Promedio']").first();
    const $nombre = $("#CorteDesc");
    const $tipo = $("#ddlTipo");
    const $iva = $("#ddlIva");
    const $pesable = $("#swPesable");
    const $puntoStock = $("#frmCorte").find("input[name='PuntoStock']").first();
    const $idCorteMaestroHidden = $("input[name='IdCorteMaestro']");
    const $presentacionUnidades = $("#txtPresentacionUnidades");
    const $porcentaje = $("#txtPorcentaje");
    const $desperdicio = $("#txtDesperdicio");
    const $swCargaContinua = $("#swCargaContinua");
    const $siguienteIdEdicion = $("input[name='SiguienteIdEdicion']");
    const $ultimoProductoContinuoId = $("input[name='UltimoProductoContinuoId']");
    const $retomarProductoId = $("input[name='RetomarProductoId']");
    const $hintCargaContinuaAlta = $("#hintCargaContinuaAlta");
    const $hintCargaContinuaEdicion = $("#hintCargaContinuaEdicion");

    const $alertCodigoExiste = $("#alertCodigoExiste");
    const $autocompleteCodigoMsg = $("#autocompleteCodigoMsg");
    const $msgCodigoReq = $("#msgCodigoReq");
    const $msgCodigoEanInvalido = $("#msgCodigoEanInvalido");
    const $msgNombreReq = $("#msgNombreReq");
    const $msgTipoReq = $("#msgTipoReq");
    const $msgIvaReq = $("#msgIvaReq");

    let codigoDuplicado = false;
    let codigoEanInvalido = false;
    let xhrCodigo = null;
    let xhrAutocompleteCodigo = null;
    let debounceAutocompleteCodigo = null;
    let ultimoCodigoAutocompletado = "";
    let reenviandoSubmit = false;
    let snapshotEdicionInicial = "";

    // =========================
    // Helpers UI (texto seguro)
    // =========================
    function escapeHtml(str) {
        return (str == null ? "" : String(str))
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function setAutocompleteCodigoMsg(texto) {
        if (!$autocompleteCodigoMsg.length) return;

        if (!texto) {
            $autocompleteCodigoMsg.addClass("d-none").text("");
            return;
        }

        $autocompleteCodigoMsg.removeClass("d-none").text(texto);
    }

    let cargaSolicitudActiva = false;

    function mostrarCargaSolicitud() {
        if (!window.Swal || cargaSolicitudActiva) return;

        cargaSolicitudActiva = true;
        Swal.fire({
            title: "Cargando solicitud...",
            text: "Espere un momento.",
            allowOutsideClick: false,
            allowEscapeKey: false,
            allowEnterKey: false,
            showConfirmButton: false,
            didOpen: function () {
                if (Swal.showLoading) {
                    Swal.showLoading();
                }
            }
        });
    }

    function ocultarCargaSolicitud() {
        if (!cargaSolicitudActiva) return;
        cargaSolicitudActiva = false;

        if (window.Swal && typeof Swal.close === "function") {
            Swal.close();
        }
    }

    function construirSnapshotEdicion() {
        const partes = [];

        $frm.find("input, select, textarea").each(function () {
            const $el = $(this);
            const nombre = ($el.attr("name") || "").trim();
            if (!nombre) return;
            if ($el.is("[type='hidden']")) return;
            if (nombre === "CargaContinua") return;
            if ($el.is("[data-edit-readonly-ignore='true']")) return;

            const tipo = (($el.attr("type") || "") + "").toLowerCase();
            let valor = "";

            if (tipo === "checkbox" || tipo === "radio") {
                valor = $el.prop("checked") ? "1" : "0";
            } else {
                valor = ($el.val() || "").toString().trim();
            }

            partes.push(nombre + "=" + valor);
        });

        return partes.join("|");
    }

    function actualizarSnapshotEdicion() {
        snapshotEdicionInicial = construirSnapshotEdicion();
    }

    function hayCambiosSinGuardar() {
        if (!esEdicion) return false;
        return construirSnapshotEdicion() !== snapshotEdicionInicial;
    }

    function leerOrdenEdicionVisible() {
        try {
            const raw = window.sessionStorage.getItem(STORAGE_ORDEN_EDICION_KEY);
            if (!raw) return [];

            const ids = JSON.parse(raw);
            if (!Array.isArray(ids)) return [];

            return ids
                .map(v => Number(v))
                .filter(v => Number.isFinite(v) && v > 0);
        } catch (e) {
            return [];
        }
    }

    function obtenerSiguienteProductoId() {
        const orden = leerOrdenEdicionVisible();
        if (!orden.length || !idProductoActual) return 0;

        const indexActual = orden.findIndex(id => id === Number(idProductoActual));
        if (indexActual < 0 || indexActual + 1 >= orden.length) return 0;

        return Number(orden[indexActual + 1]) || 0;
    }

    function tieneOrdenEdicionVisibleValido() {
        const orden = leerOrdenEdicionVisible();
        if (!orden.length || !idProductoActual) return false;
        return orden.indexOf(Number(idProductoActual)) >= 0;
    }

    function leerHistorialEdicion() {
        try {
            const raw = window.sessionStorage.getItem(STORAGE_HISTORIAL_EDICION_KEY);
            if (!raw) return [];

            const ids = JSON.parse(raw);
            if (!Array.isArray(ids)) return [];

            return ids
                .map(v => Number(v))
                .filter(v => Number.isFinite(v) && v > 0);
        } catch (e) {
            return [];
        }
    }

    function guardarHistorialEdicion(historial) {
        try {
            const limpio = (historial || [])
                .map(v => Number(v))
                .filter(v => Number.isFinite(v) && v > 0);

            if (!limpio.length) {
                window.sessionStorage.removeItem(STORAGE_HISTORIAL_EDICION_KEY);
                return;
            }

            window.sessionStorage.setItem(STORAGE_HISTORIAL_EDICION_KEY, JSON.stringify(limpio));
        } catch (e) {
        }
    }

    function limpiarHistorialEdicion() {
        try {
            window.sessionStorage.removeItem(STORAGE_HISTORIAL_EDICION_KEY);
        } catch (e) {
        }
    }

    function guardarModoEdicionActivo(activo) {
        try {
            if (activo) {
                window.sessionStorage.setItem(STORAGE_MODO_EDICION_ACTIVO_KEY, "1");
            } else {
                window.sessionStorage.removeItem(STORAGE_MODO_EDICION_ACTIVO_KEY);
            }
        } catch (e) {
        }
    }

    function obtenerModoEdicionActivo() {
        try {
            return window.sessionStorage.getItem(STORAGE_MODO_EDICION_ACTIVO_KEY) === "1";
        } catch (e) {
            return false;
        }
    }

    function obtenerAnteriorProductoId() {
        const historial = leerHistorialEdicion();
        if (!historial.length) return 0;

        return Number(historial[historial.length - 1]) || 0;
    }

    function registrarProductoActualEnHistorial() {
        if (!esEdicion || !(Number(idProductoActual) > 0)) return;

        const historial = leerHistorialEdicion();
        const actual = Number(idProductoActual);

        if (historial[historial.length - 1] === actual) {
            return;
        }

        historial.push(actual);
        guardarHistorialEdicion(historial);
    }

    function consumirAnteriorHistorial() {
        const historial = leerHistorialEdicion();
        if (!historial.length) return 0;

        const anterior = Number(historial.pop()) || 0;
        guardarHistorialEdicion(historial);
        return anterior;
    }

    function obtenerUltimoProductoContinuoId() {
        const id = Number($ultimoProductoContinuoId.val() || 0);
        return Number.isFinite(id) && id > 0 ? id : 0;
    }

    function actualizarUiCargaContinua() {
        const activa = !!$swCargaContinua.prop("checked");
        const siguienteId = esEdicion ? obtenerSiguienteProductoId() : 0;
        const anteriorId = esEdicion ? obtenerAnteriorProductoId() : 0;
        const ultimoProductoId = obtenerUltimoProductoContinuoId();
        const puedeVerAnterior = esEdicion
            ? activa && anteriorId > 0
            : activa && ultimoProductoId > 0 && ultimoProductoId !== Number(idProductoActual || 0);

        $hintCargaContinuaAlta.toggleClass("d-none", esEdicion || !activa);
        $hintCargaContinuaEdicion.toggleClass("d-none", !esEdicion || !activa);
        $btnVerAnteriorProducto.toggleClass("d-none", !puedeVerAnterior);

        if (esEdicion) {
            if (activa && (siguienteId > 0 || anteriorId > 0)) {
                $hintCargaContinuaEdicion.text("En edición puede navegar entre los productos visibles. Si el formulario está habilitado, se advertirá antes de continuar.");
            } else if (activa) {
                $hintCargaContinuaEdicion.text(tieneOrdenEdicionVisibleValido()
                    ? "No hay otros productos visibles en la grilla actual para navegar."
                    : "No se pudo recuperar el orden visible del listado. Vuelva a abrir el producto desde el Index para usar Carga continua.");
            }

            $siguienteIdEdicion.val(activa && siguienteId > 0 ? String(siguienteId) : "");
            $btnSiguienteProducto.toggleClass("d-none", !activa);
            $btnSiguienteProducto.prop("disabled", !(activa && siguienteId > 0));
        } else {
            $siguienteIdEdicion.val("");
            $btnSiguienteProducto.addClass("d-none").prop("disabled", true);
        }

        actualizarTextoAtajosAcciones();
    }

    function actualizarTextoAtajosAcciones() {
        if (!$atajosAccionesProducto.length) return;

        const atajos = [];
        if (esElementoAccion($btnVerAnteriorProducto)) {
            atajos.push("Alt + Flecha izquierda anterior");
        }
        if (esElementoAccion($btnSiguienteProducto)) {
            atajos.push("Alt + Flecha derecha siguiente");
        }

        const editReadonlyApi = window.productosEditReadonly;
        const estaSoloLectura = !editReadonlyApi || editReadonlyApi.isReadOnly();
        const $accionPrincipal = estaSoloLectura ? $btnHabilitarEdicionProducto : $btnGuardar;
        if (esElementoAccion($accionPrincipal)) {
            atajos.push("Alt + Enter modificar/guardar");
        }

        if (!atajos.length) {
            $atajosAccionesProducto.addClass("d-none").text("");
            return;
        }

        $atajosAccionesProducto.removeClass("d-none").text("Atajos: " + atajos.join(", "));
    }

    function irAProductoEdicion(destinoId) {
        const idDestino = Number(destinoId || 0);
        if (!(idDestino > 0)) {
            return;
        }

        const query = new URLSearchParams();
        query.set("id", String(idDestino));
        query.set("cargaContinua", "true");
        query.set("flujoBaseContinuo", "edicion");

        mostrarCargaSolicitud();
        window.location.href = urlAddOrEdit + "?" + query.toString();
    }

    function confirmarNavegacionEdicion(destinoId, esAnterior) {
        const idDestino = Number(destinoId || 0);
        if (!(idDestino > 0)) {
            return;
        }

        const editReadonlyApi = window.productosEditReadonly;
        const estaSoloLectura = !editReadonlyApi || editReadonlyApi.isReadOnly();

        if (estaSoloLectura) {
            guardarModoEdicionActivo(false);
            if (esAnterior) {
                consumirAnteriorHistorial();
            }
            irAProductoEdicion(idDestino);
            return;
        }

        if (!esAnterior) {
            guardarModoEdicionActivo(true);
            registrarProductoActualEnHistorial();
            $swCargaContinua.prop("checked", true);
            $("input[name='FlujoBaseContinuo']").val("edicion");
            $siguienteIdEdicion.val(String(idDestino));
            $retomarProductoId.val("");
            $frm.trigger("submit");
            return;
        }

        if (!hayCambiosSinGuardar()) {
            guardarModoEdicionActivo(true);
            consumirAnteriorHistorial();
            irAProductoEdicion(idDestino);
            return;
        }

        let keyHandler = null;

        Swal.fire({
            title: "Hay cambios sin guardar",
            html: "Si continúa sin guardar, se perderán los cambios del producto actual.",
            icon: "warning",
            showCancelButton: true,
            showDenyButton: true,
            confirmButtonText: "1- Guardar y continuar",
            denyButtonText: "2- Continuar sin guardar",
            cancelButtonText: "3- Cancelar",
            didOpen: function () {
                keyHandler = function (evt) {
                    if (evt.altKey || evt.ctrlKey || evt.metaKey || evt.shiftKey || evt.repeat) {
                        return;
                    }

                    const key = String(evt.key || "");
                    if (key === "1") {
                        evt.preventDefault();
                        Swal.clickConfirm();
                        return;
                    }

                    if (key === "2") {
                        evt.preventDefault();
                        Swal.clickDeny();
                        return;
                    }

                    if (key === "3") {
                        evt.preventDefault();
                        Swal.close();
                    }
                };

                document.addEventListener("keydown", keyHandler, true);
            },
            willClose: function () {
                if (keyHandler) {
                    document.removeEventListener("keydown", keyHandler, true);
                    keyHandler = null;
                }
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                guardarModoEdicionActivo(true);
                $swCargaContinua.prop("checked", true);
                $("input[name='FlujoBaseContinuo']").val("edicion");

                if (esAnterior) {
                    consumirAnteriorHistorial();
                    $retomarProductoId.val(String(idDestino));
                    $siguienteIdEdicion.val("");
                } else {
                    registrarProductoActualEnHistorial();
                    $siguienteIdEdicion.val(String(idDestino));
                    $retomarProductoId.val("");
                }

                $frm.trigger("submit");
                return;
            }

            if (result.isDenied) {
                guardarModoEdicionActivo(true);
                if (esAnterior) {
                    consumirAnteriorHistorial();
                }
                if (!esAnterior) {
                    registrarProductoActualEnHistorial();
                }
                irAProductoEdicion(idDestino);
            }
        });
    }

    function enfocarInputCodigo() {
        const inputCodigo = document.getElementById("Codigo");
        if (!inputCodigo) return;

        try {
            inputCodigo.focus();
            if (typeof inputCodigo.select === "function") {
                inputCodigo.select();
            }
        } catch (e) {
        }
    }

    function enfocarInputCodigoAlFinal() {
        const inputCodigo = document.getElementById("Codigo");
        if (!inputCodigo) return;

        try {
            inputCodigo.focus();

            if (typeof inputCodigo.value === "string" && typeof inputCodigo.setSelectionRange === "function") {
                const largo = inputCodigo.value.length;
                inputCodigo.setSelectionRange(largo, largo);
            }
        } catch (e) {
        }
    }

    function esElementoAccion($elemento) {
        if (!$elemento || !$elemento.length) return false;
        if (!$elemento.is(":visible")) return false;
        if ($elemento.is(":disabled")) return false;
        return true;
    }

    function obtenerElementosTabulables() {
        return $frm
            .find("input, select, textarea, button, a[href], [tabindex]")
            .filter(function () {
                const $el = $(this);
                const tabIndex = this.getAttribute("tabindex");
                const esTabIndexInvalido = tabIndex != null && Number(tabIndex) < 0;

                return !esTabIndexInvalido
                    && !$el.is(":disabled")
                    && $el.is(":visible")
                    && $el.css("visibility") !== "hidden";
            });
    }

    function moverFocoComoTab(reversa) {
        const $elementos = obtenerElementosTabulables();
        if (!$elementos.length) return;

        const actual = document.activeElement;
        let indiceActual = $elementos.index(actual);

        if (indiceActual < 0) {
            indiceActual = reversa ? 0 : -1;
        }

        const siguienteIndice = reversa
            ? (indiceActual <= 0 ? $elementos.length - 1 : indiceActual - 1)
            : (indiceActual + 1 >= $elementos.length ? 0 : indiceActual + 1);

        const siguiente = $elementos.get(siguienteIndice);
        if (!siguiente) return;

        siguiente.focus();

        if ((siguiente.tagName || "").toLowerCase() === "input" && typeof siguiente.select === "function") {
            const type = (siguiente.type || "").toLowerCase();
            if (type !== "checkbox" && type !== "radio" && type !== "button" && type !== "submit") {
                siguiente.select();
            }
        }
    }

    // Variante de moverFocoComoTab anclada a la posicion DOM de un elemento de referencia, no a
    // document.activeElement -- necesaria para volver de un modal (ej. Marcas, Producto Maestro),
    // donde el boton/input que lo abrio tiene tabindex="-1" (excluido a proposito del tabulado) y
    // por eso nunca aparece en obtenerElementosTabulables(); buscar "el siguiente despues del
    // activeElement" ahi no da un resultado util. En cambio, esto busca el primer elemento
    // tabulable que este DESPUES de la referencia en el orden real del documento.
    function moverFocoDespuesDe($referencia) {
        if (!$referencia || !$referencia.length) return;

        const referenciaEl = $referencia.get(0);
        const $elementos = obtenerElementosTabulables();

        for (let i = 0; i < $elementos.length; i++) {
            const el = $elementos.get(i);
            if (referenciaEl.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) {
                el.focus();
                if ((el.tagName || "").toLowerCase() === "input" && typeof el.select === "function") {
                    const type = (el.type || "").toLowerCase();
                    if (type !== "checkbox" && type !== "radio" && type !== "button" && type !== "submit") {
                        el.select();
                    }
                }
                return;
            }
        }
    }

    // =========================
    // Decimales flexibles (coma o punto)
    // - Mientras escribe: muestra con punto (si escribe coma, se convierte a punto)
    // - Antes de enviar: se convierte a coma (binder es-AR)
    // =========================
    function normalizarDecimalTexto(v) {
        v = (v || "").toString().trim();

        // coma -> punto
        v = v.replace(/,/g, ".");

        // dejar solo d�gitos y punto
        v = v.replace(/[^\d.]/g, "");

        // dejar un solo punto decimal
        const partes = v.split(".");
        if (partes.length > 2) {
            v = partes[0] + "." + partes.slice(1).join("");
        }

        return v;
    }

    function parseFloatFlexible(v) {
        const txt = normalizarDecimalTexto(v);
        if (txt === "") return null;

        const n = parseFloat(txt);
        return isNaN(n) ? null : n;
    }

    // Para enviar al POST con cultura es-AR (coma decimal)
    function formatFloatForPost(n) {
        return Number(n).toString().replace(".", ",");
    }

    function normalizarCampoFloatVisible($input) {
        if (!$input || !$input.length) return;
        $input.on("input", function () {
            this.value = normalizarDecimalTexto(this.value);
        });
    }

    normalizarCampoFloatVisible($precioKg);
    normalizarCampoFloatVisible($promedio);
    normalizarCampoFloatVisible($porcentaje);
    normalizarCampoFloatVisible($desperdicio);
    normalizarCampoFloatVisible($presentacionUnidades);

    // Capitaliza solo la primera letra de cada palabra nueva (despues de
    // espacio o al inicio) mientras se tipea -- no fuerza minuscula el resto,
    // para no pelear con siglas tipeadas a proposito (ej. "IVA").
    function capitalizarPrimeraLetraCadaPalabra($input) {
        if (!$input || !$input.length) return;
        $input.on("input", function () {
            const el = this;
            const cursorPos = el.selectionStart;
            const original = el.value;
            const transformado = original.replace(/(^|\s)([a-záéíóúñü])/gi, (m, sep, letra) => sep + letra.toUpperCase());
            if (transformado !== original) {
                el.value = transformado;
                try { el.setSelectionRange(cursorPos, cursorPos); } catch (_) { }
            }
        });
    }

