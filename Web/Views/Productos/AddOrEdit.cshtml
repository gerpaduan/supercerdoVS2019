@model CorteUpsertVM
@using System.Collections.Generic
@using System.Web.Mvc

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    bool esEdicion = Model != null && Model.IdCorte > 0;
    ViewBag.Title = esEdicion ? "Editar producto" : "Alta de producto";
}

<style>
    /* Igualar alto inputs y combos (por si tu bootstrap no los iguala) */
    .form-control, .form-select, select.form-control {
        min-height: 38px;
    }
</style>

<div class="container-fluid px-2 px-md-3">

    <div class="row">
        <div class="col-12 col-lg-7">

            @using (Html.BeginForm("Guardar", "Productos", FormMethod.Post, new { id = "frmCorte", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IdCorte)
                @Html.HiddenFor(m => m.IdMarca)
                @Html.HiddenFor(m => m.IdCorteMaestro)
                @Html.HiddenFor(m => m.Porcentaje)
                @Html.HiddenFor(m => m.PorcentajeHueso)
                @Html.HiddenFor(m => m.AlicuotaIva)

                <div id="page-urls"
                     data-url-marcas="@Url.Action("BuscarMarca", "Productos")"
                     data-url-cortes="@Url.Action("Buscar", "Productos")"
                     data-url-existe-codigo="@Url.Action("FindCorteByCodigo", "Productos")">
                </div>

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <!-- =========================
                 1) DATOS PRINCIPALES
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="mb-0">Datos del producto</h5>
                        @if (esEdicion)
                        {
                            <span class="text-muted">ID: <b>@Model.IdCorte</b></span>
                        }
                    </div>

                    <div class="row g-3">
                        <!-- 🔍 SCANNER (arriba del Código) -->
                        <div class="col-12" id="scannerContainer" style="display:none;">
                            <div class="card shadow-sm">
                                <div class="card-body p-2">

                                    <div class="scanner-wrapper">
                                        <video id="videoScanner" autoplay muted playsinline></video>
                                        <div class="scanner-line"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-2">
                                        <button type="button" class="btn btn-secondary btn-sm" id="btnFlash">🔦 Flash</button>
                                        <button type="button" class="btn btn-danger btn-sm" id="btnCerrarScanner">Cerrar cámara</button>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Código</label>

                            <div class="input-group">
                                <button type="button" class="btn btn-outline-secondary" id="btnScanner" title="Escanear código">
                                    <i class="fas fa-barcode"></i>
                                </button>
                                @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", inputmode = "numeric", placeholder = "EAN / código interno", id = "Codigo", maxlength = "15" })
                            </div>

                            <small id="scannerMsg" class="text-danger d-none"></small>
                            <div id="alertCodigoExiste" class="alert alert-warning py-2 px-2 mt-2 mb-0 d-none"></div>
                            <small id="msgCodigoReq" class="text-danger d-none">El campo codigo es obligatorio.</small>
                            @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-12 col-md-8">
                            <label class="form-label">Nombre</label>
                            @Html.TextBoxFor(m => m.CorteDesc, new { @class = "form-control", maxlength = "50", id = "CorteDesc" })
                            <small id="msgNombreReq" class="text-danger d-none">El campo nombre es obligatorio.</small>
                            @Html.ValidationMessageFor(m => m.CorteDesc, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Precio Kg</label>
                            @Html.TextBoxFor(m => m.PrecioKg, new { @class = "form-control", placeholder = "0,00", id = "PrecioKg", inputmode = "decimal" })
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Tipo</label>
                            @Html.DropDownListFor(m => m.Tipo, Model.Tipos ?? new List<SelectListItem>(),
                                "Seleccione...", new { @class = "form-control", id = "ddlTipo" })
                            <small id="msgTipoReq" class="text-danger d-none">Debe seleccionar un tipo.</small>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">IVA</label>
                            @Html.DropDownListFor(m => m.IdAlicuotaIva, Model.AlicuotasIva ?? new List<SelectListItem>(),
                                "Seleccione...", new { @class = "form-control", id = "ddlIva" })
                            <small id="msgIvaReq" class="text-danger d-none">Debe seleccionar un IVA.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Marca (opcional)</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="txtMarcaNombre"
                                       value="@(Model?.MarcaNombre ?? "")" readonly placeholder="Sin marca" />
                                <button type="button" class="btn btn-outline-secondary" id="btnBuscarMarca" title="Buscar marca">🔎</button>
                                <button type="button" class="btn btn-outline-danger" id="btnLimpiarMarca" title="Quitar marca">✖</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================
                 2) STOCK Y ESTADO (debajo)
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3">
                    <h5 class="mb-3">Stock y estado</h5>

                    <div class="row g-3">


                        <div class="col-12">
                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.Pesable, new { @class = "form-check-input", id = "swPesable" })
                                <label class="form-check-label" for="swPesable">Pesable</label>
                            </div>

                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.Habilitado, new { @class = "form-check-input", id = "swHabilitado" })
                                <label class="form-check-label" for="swHabilitado">Habilitado</label>
                            </div>

                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.IngresoRapidoEmbutido, new { @class = "form-check-input", id = "swRapido" })
                                <label class="form-check-label" for="swRapido">Ingreso rápido elaborado</label>
                            </div>

                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.EnCierreStock, new { @class = "form-check-input", id = "swCierre" })
                                <label class="form-check-label" for="swCierre">En cierre stock</label>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Punto Stock (número entero)</label>
                            @Html.TextBoxFor(m => m.PuntoStock, new { @class = "form-control", inputmode = "numeric" })
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Promedio</label>
                            @Html.TextBoxFor(m => m.Promedio, new { @class = "form-control", placeholder = "0,00" })
                        </div>

                        @if (esEdicion)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label">Nivel (solo edición)</label>
                                <input class="form-control" value="@Model.Nivel" readonly />
                            </div>
                        }


                    </div>
                </div>

                <!-- =========================
                 3) CORTE MAESTRO / PRESENTACIÓN (debajo)
                 ========================= -->
                <div class="p-3 rounded bg-light border mb-3">
                    <h5 class="mb-3">Corte maestro / Presentación</h5>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Modo</label>
                            @Html.DropDownListFor(m => m.ModoCorte,
                                new List<SelectListItem> {
                                    new SelectListItem{ Text="Ninguno", Value="Ninguno" },
                                    new SelectListItem{ Text="Corte maestro", Value="CorteMaestro" },
                                    new SelectListItem{ Text="Presentación", Value="Presentacion" },
                                },
                                new { @class = "form-control", id = "ddlModo" })
                        </div>

                        <div class="col-12 col-md-8" id="boxCorteMaestro">
                            <label class="form-label">Corte maestro</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="txtCorteMaestroNombre"
                                       value="@(Model?.CorteMaestroNombre ?? "")"
                                       readonly placeholder="Seleccione un corte maestro..." />
                                <button type="button" class="btn btn-outline-secondary" id="btnBuscarCorteMaestro">🔎</button>
                                <button type="button" class="btn btn-outline-danger" id="btnLimpiarCorteMaestro">✖</button>
                            </div>
                        </div>

                        <div class="col-12" id="boxCorteMaestroCampos">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">% (Porcentaje)</label>
                                    <input type="text" class="form-control" id="txtPorcentaje"
                                           value="@(Model != null ? Model.Porcentaje.ToString() : "0")"
                                           placeholder="0,00" inputmode="decimal" />
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Desperdicio</label>
                                    <input type="text" class="form-control" id="txtDesperdicio"
                                           value="@(Model != null ? Model.PorcentajeHueso.ToString() : "0")"
                                           placeholder="0,00" inputmode="decimal" />
                                </div>
                            </div>
                        </div>


                        <div class="col-12" id="boxPresentacionCampos">
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Presentación (unidades)</label>

                                    <input type="text" class="form-control" id="txtPresentacionUnidades"
                                           name="PresentacionUnidades"
                                           value="@(Model?.PresentacionUnidades != null ? Model.PresentacionUnidades.ToString() : "")"
                                           placeholder="Ej: 5" inputmode="decimal" />
                                </div>
                            </div>
                        </div>


                        <div class="col-12" id="boxIndependiente">
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.Independiente, new { @class = "form-check-input", id = "swIndependiente" })
                                <label class="form-check-label" for="swIndependiente">Independiente</label>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- =========================
                 4) BOTONERA (fija al pie)
                 ========================= -->
                <div class="espacio-botonera-fija"></div>

                <div class="barra-acciones-fija">
                    <div class="barra-acciones-inner d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index","Productos")">Volver</a>

                        <div class="d-flex gap-2">
                            <button type="submit" name="accion" value="guardar" class="btn btn-primary" id="btnGuardarProducto">
                                @(esEdicion ? "Guardar cambios" : "Crear producto")
                            </button>

                            @*<button type="submit" name="accion" value="guardar_nuevo" class="btn btn-outline-primary">
                                    @(esEdicion ? "Guardar y cargar otro" : "Crear y continuar")
                                </button>*@
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<audio id="beep" src="/Content/sounds/focus-beep.wav" preload="auto"></audio>

<!-- MODAL MARCAS -->
<div class="modal fade" id="modalMarcas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fit-screen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buscar marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-2">
                    <input type="text" class="form-control" id="qMarca" placeholder="Escribí para buscar..." />
                    <button class="btn btn-primary" type="button" id="btnDoBuscarMarca">Buscar</button>
                </div>

                <div class="table-responsive modal-table-scroll" id="wrapTablaMarcas">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Marca</th>
                                <th style="width:35%;">Propietario</th>
                            </tr>
                        </thead>
                        <tbody id="tbMarcas">
                            <tr><td colspan="2" class="text-muted">Cargando marcas...</td></tr>
                        </tbody>
                    </table>
                </div>

                <small class="text-muted d-block mt-2">
                    Enter = selecciona la primera fila. Doble clic = selecciona la fila.
                </small>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CORTES (Corte Maestro) - reutiliza partial -->
@{
    var vdBuscarCorteMaestro = new ViewDataDictionary();
    vdBuscarCorteMaestro["ModalId"] = "modalBuscarProducto";
    vdBuscarCorteMaestro["ApiUrl"] = Url.Action("ListarProductos", "Productos"); // tu endpoint actual
    vdBuscarCorteMaestro["Titulo"] = "Seleccionar producto";
    vdBuscarCorteMaestro["MostrarPrecio"] = false; // ocultar precio en alta/edición
}

@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", vdBuscarCorteMaestro)

<script>
    (function () {
        const barra = document.querySelector('.barra-acciones-fija');
        if (!barra) return;

        // Busca la columna que contiene el formulario/botonera
        const contenedor = barra.closest('.col-12.col-lg-7')
            || document.querySelector('#frmCorte')?.closest('.col-12.col-lg-7');

        if (!contenedor) return;

        function ajustarBarra() {
            const r = contenedor.getBoundingClientRect();

            barra.style.left = r.left + 'px';
            barra.style.width = r.width + 'px';
        }

        ajustarBarra();

        window.addEventListener('resize', ajustarBarra);
        window.addEventListener('scroll', ajustarBarra, { passive: true });

        // Por si cambia el layout dinámicamente (responsive / contenido)
        if (window.ResizeObserver) {
            const ro = new ResizeObserver(ajustarBarra);
            ro.observe(contenedor);
        }
    })();
</script>

@section Scripts {
    <script>
(function () {
    // =========================
    // URLs
    // =========================
    const $urls = $("#page-urls");
    const urlMarcas = $urls.data("url-marcas");
    const urlCortes = $urls.data("url-cortes");
    const urlExisteCodigo = $urls.data("url-existe-codigo");

    const esEdicion = @((Model?.IdCorte ?? 0) > 0 ? "true" : "false");

    // =========================
    // Refs principales
    // =========================
    const $frm = $("#frmCorte");
    const $btnGuardar = $("#btnGuardarProducto");
    const $codigo = $("#Codigo");
    const $precioKg = $("#frmCorte").find("input[name='PrecioKg']").first();
    const $promedio = $("#frmCorte").find("input[name='Promedio']").first();
    const $nombre = $("#CorteDesc");
    const $tipo = $("#ddlTipo");
    const $iva = $("#ddlIva");
    const $puntoStock = $("#frmCorte").find("input[name='PuntoStock']").first();
    const $idCorteMaestroHidden = $("input[name='IdCorteMaestro']");
    const $presentacionUnidades = $("#txtPresentacionUnidades");
    const $porcentaje = $("#txtPorcentaje");
    const $desperdicio = $("#txtDesperdicio");

    const $alertCodigoExiste = $("#alertCodigoExiste");
    const $msgCodigoReq = $("#msgCodigoReq");
    const $msgNombreReq = $("#msgNombreReq");
    const $msgTipoReq = $("#msgTipoReq");
    const $msgIvaReq = $("#msgIvaReq");

    let codigoDuplicado = false;
    let xhrCodigo = null;
    let reenviandoSubmit = false;

    // =========================
    // Helpers UI (texto seguro)
    // =========================
    function escapeHtml(str) {
        return (str == null ? "" : String(str))
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    // =========================
    // Decimales flexibles (coma o punto)
    // - Mientras escribe: muestra con punto (si escribe coma, se convierte a punto)
    // - Antes de enviar: se convierte a coma (binder es-AR)
    // =========================
    function normalizarDecimalTexto(v) {
        v = (v || "").toString().trim();

        // coma -> punto
        v = v.replace(/,/g, ".");

        // dejar solo dígitos y punto
        v = v.replace(/[^\d.]/g, "");

        // dejar un solo punto decimal
        const partes = v.split(".");
        if (partes.length > 2) {
            v = partes[0] + "." + partes.slice(1).join("");
        }

        return v;
    }

    function parseFloatFlexible(v) {
        const txt = normalizarDecimalTexto(v);
        if (txt === "") return null;

        const n = parseFloat(txt);
        return isNaN(n) ? null : n;
    }

    // Para enviar al POST con cultura es-AR (coma decimal)
    function formatFloatForPost(n) {
        return Number(n).toString().replace(".", ",");
    }

    function normalizarCampoFloatVisible($input) {
        if (!$input || !$input.length) return;
        $input.on("input", function () {
            this.value = normalizarDecimalTexto(this.value);
        });
    }

    normalizarCampoFloatVisible($precioKg);
    normalizarCampoFloatVisible($promedio);
    normalizarCampoFloatVisible($porcentaje);
    normalizarCampoFloatVisible($desperdicio);
    normalizarCampoFloatVisible($presentacionUnidades);

    // =========================
    // UI: mostrar/ocultar secciones (Modo)
    // =========================
    const $ddlModo = $("#ddlModo");
    const $boxCorteMaestro = $("#boxCorteMaestro");
    const $boxIndep = $("#boxIndependiente");
    const $boxCMCampos = $("#boxCorteMaestroCampos");
    const $boxPresCampos = $("#boxPresentacionCampos");

    function aplicarModo() {
        const modo = ($ddlModo.val() || "Ninguno");

        if (modo === "Ninguno") {
            $boxCorteMaestro.hide();
            $boxIndep.hide();
            $boxCMCampos.hide();
            $boxPresCampos.hide();

            // Limpieza + enviar cero en hidden
            $("input[name='IdCorteMaestro']").val("");
            $("#txtCorteMaestroNombre").val("");

            $("input[name='Porcentaje']").val("0");
            $("input[name='PorcentajeHueso']").val("0");
            $("#txtPorcentaje").val("0");
            $("#txtDesperdicio").val("0");
            $("#txtPresentacionUnidades").val("");
            return;
        }

        // Para CorteMaestro y Presentación: mostrar selector de corte maestro + independiente
        $boxCorteMaestro.show();
        $boxIndep.show();

        if (modo === "CorteMaestro") {
            $boxCMCampos.show();
            $boxPresCampos.hide();
        } else if (modo === "Presentacion") {
            $boxCMCampos.hide();
            $boxPresCampos.show();
        }
    }

    $ddlModo.on("change", aplicarModo);

    // =========================
    // MODAL MARCAS
    // - abre y carga todas las marcas
    // - foco automático en input
    // - Enter selecciona primera fila
    // - Doble click selecciona
    // - sin botón "Seleccionar"
    // =========================
    let debounceMarcaTimer = null;

    // 👇 guardar el botón que abrió el modal
    let $triggerModalMarcas = null;

    function seleccionarMarcaDesdeFila($row) {
        if (!$row || !$row.length) return;

        const id = $row.data("id");
        const nombre = $row.data("nombre");

        $("input[name='IdMarca']").val(id || "");
        $("#txtMarcaNombre").val(nombre || "");
        $("#modalMarcas").modal("hide");
    }

    $("#btnBuscarMarca").on("click", function () {
        // 👇 GUARDO el botón que abrió
        $triggerModalMarcas = $(this);
        $("#modalMarcas").modal("show");
    });

    $("#btnLimpiarMarca").on("click", function () {
        $("input[name='IdMarca']").val("");
        $("#txtMarcaNombre").val("");
    });

    function renderMarcas(items) {
        const $tb = $("#tbMarcas");

        if (!items || !items.length) {
            $tb.html('<tr><td colspan="2" class="text-muted">Sin resultados</td></tr>');
            return;
        }

        let html = "";
        items.forEach(x => {
            const id = x.id ?? x.Id ?? "";
            const nombre = x.nombre ?? x.Nombre ?? x.marca ?? x.Marca ?? "";
            const propietario = x.propietario ?? x.Propietario ?? x.duenio ?? x.Duenio ?? x.titular ?? x.Titular ?? "";

            html += `
                <tr class="fila-marca"
                    data-id="${escapeHtml(id)}"
                    data-nombre="${escapeHtml(nombre)}"
                    style="cursor:pointer;">
                    <td>${escapeHtml(nombre)}</td>
                    <td>${escapeHtml(propietario)}</td>
                </tr>`;
        });

        $tb.html(html);

        // marcar primera fila
        $tb.find("tr:first").addClass("table-active");
    }

    function buscarMarcas() {
        const q = ($("#qMarca").val() || "").trim();

        $.get(urlMarcas, { q: q })
            .done(renderMarcas)
            .fail(function () {
                $("#tbMarcas").html('<tr><td colspan="2" class="text-danger">Error cargando marcas</td></tr>');
            });
    }

    // Al abrir: foco + cargar todas automáticamente
    $("#modalMarcas").on("shown.bs.modal", function () {
        setTimeout(function () {
            $("#qMarca").focus().select();
        }, 80);

        buscarMarcas(); // q vacío => traer todas
    });


    // al cerrar, devolver foco al botón que lo abrió
    $("#modalMarcas").on("hidden.bs.modal", function () {
        setTimeout(function () {
            if ($triggerModalMarcas && $triggerModalMarcas.length) {
                $triggerModalMarcas.focus();
            } else {
                $("#btnBuscarMarca").focus(); // fallback
            }
        }, 0);
    });

    // Botón Buscar manual
    $("#btnDoBuscarMarca").on("click", buscarMarcas);

    // Búsqueda en vivo (debounce)
    $("#qMarca").on("input", function () {
        clearTimeout(debounceMarcaTimer);
        debounceMarcaTimer = setTimeout(function () {
            buscarMarcas();
        }, 250);
    });

    // Enter => seleccionar fila activa o primera
    $("#qMarca").on("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();

            const $tb = $("#tbMarcas");
            const $sel = $tb.find("tr.table-active:first");
            const $row = $sel.length ? $sel : $tb.find("tr:first");

            if ($row.length && !$row.find("td.text-danger, td.text-muted").length) {
                seleccionarMarcaDesdeFila($row);
            }
        }
    });

    // Click => marcar fila
    $("#tbMarcas").on("click", "tr", function () {
        const $row = $(this);
        if ($row.find("td").length === 1 && ($row.text() || "").match(/Sin resultados|Error|Cargando/i)) return;

        $("#tbMarcas tr").removeClass("table-active");
        $row.addClass("table-active");
    });

    // Doble click => seleccionar
    $("#tbMarcas").on("dblclick", "tr", function () {
        const $row = $(this);
        if ($row.find("td").length === 1 && ($row.text() || "").match(/Sin resultados|Error|Cargando/i)) return;

        seleccionarMarcaDesdeFila($row);
    });

    // =========================
    // MODAL CORTES (Corte Maestro)
    // reutiliza _BuscarProductoModal + script global
    // =========================

    // 👇 guardar el botón que abrió el modal
    let $triggerModalCorteMaestro= null;

    $("#btnBuscarCorteMaestro").on("click", function () {
        if (typeof window.abrirBuscarProductoModal !== "function") {
            alert("No se pudo abrir el buscador de productos. Verificá que el script del modal esté cargado.");
            return;
        }

        $triggerModalCorteMaestro = $(this);

        window.abrirBuscarProductoModal({
            modalSelector: "#modalBuscarProducto", // <-- explícito
            mostrarPrecio: false,
            onSelect: function (producto) {
                $("input[name='IdCorteMaestro']").val(producto.id || "");
                $("#txtCorteMaestroNombre").val(producto.nombre || "");
            }
        });
    });

    $("#btnLimpiarCorteMaestro").on("click", function () {
        $("input[name='IdCorteMaestro']").val("");
        $("#txtCorteMaestroNombre").val("");
    });

    // 👇 NUEVO: al cerrar, devolver foco al botón que lo abrió
    $("#modalBuscarProducto").on("hidden.bs.modal", function () {
        setTimeout(function () {
            if ($triggerModalCorteMaestro && $triggerModalCorteMaestro.length) {
                $triggerModalCorteMaestro.focus();
            } else {
                $("#btnBuscarCorteMaestro").focus(); // fallback
            }
        }, 0);
    });

    // =========================
    // INIT Modo
    // =========================
    function initModoFallback() {
        const modoActual = ($ddlModo.val() || "");
        if (modoActual) return;

        const idCM = parseInt($("input[name='IdCorteMaestro']").val() || "0", 10);
        const ph = parseFloat((($("input[name='PorcentajeHueso']").val() || "0") + "").replace(",", "."));

        if (idCM > 0) {
            $ddlModo.val(ph > 100 ? "Presentacion" : "CorteMaestro");
        } else {
            $ddlModo.val("Ninguno");
        }
    }

    // Default independiente tildado si es alta
    if ($("#swIndependiente").length && $("#swIndependiente").is(":checked") === false && !esEdicion) {
        $("#swIndependiente").prop("checked", true);
    }

    // Defaults pedidos: En cierre stock + Habilitado tildados en ALTA
    if (!esEdicion) {
        $("#swCierre").prop("checked", true);
        $("#swHabilitado").prop("checked", true);
    }

    initModoFallback();
    aplicarModo();

    // =========================
    // ALTA: iniciar código y precio vacíos
    // =========================
    if (!esEdicion) {
        $codigo.val("");
        $precioKg.val(""); // placeholder 0,00 visible
    }

    // =========================
    // Recordar últimos Tipo e IVA (solo alta)
    // =========================
    const LS_TIPO = "producto_alta_ultimo_tipo";
    const LS_IVA = "producto_alta_ultimo_iva";

    function tieneValorSeleccionado($ddl) {
        const v = ($ddl.val() || "").toString();
        return v !== "";
    }

    if (!esEdicion) {
        const tipoGuardado = localStorage.getItem(LS_TIPO);
        const ivaGuardado = localStorage.getItem(LS_IVA);

        if (!tieneValorSeleccionado($tipo) && tipoGuardado && $tipo.find(`option[value="${tipoGuardado}"]`).length) {
            $tipo.val(tipoGuardado);
        }

        if (!tieneValorSeleccionado($iva) && ivaGuardado && $iva.find(`option[value="${ivaGuardado}"]`).length) {
            $iva.val(ivaGuardado);
        }
    }

    $tipo.on("change", function () {
        const v = ($tipo.val() || "").toString();
        if (v !== "") localStorage.setItem(LS_TIPO, v);
    });

    $iva.on("change", function () {
        const v = ($iva.val() || "").toString();
        if (v !== "") localStorage.setItem(LS_IVA, v);
    });

    // =========================
    // Validaciones en vista (cliente)
    // =========================
    function marcarValidez($el, ok) {
        if (!$el || !$el.length) return;
        $el.toggleClass("is-invalid", !ok);
    }

    function esEnteroPositivoTexto(v) {
        v = (v || "").toString().trim();
        return /^\d+$/.test(v) && v !== "0";
    }

    function esEnteroNoNegativoTexto(v) {
        v = (v || "").toString().trim();
        return /^\d+$/.test(v); // permite 0
    }

    function validarCodigo() {
        const v = (($codigo.val() || "") + "").trim();

        // obligatorio + numérico entero
        const ok = esEnteroNoNegativoTexto(v) && v !== "";
        $msgCodigoReq.toggleClass("d-none", ok);
        $codigo.toggleClass("is-invalid", !ok);

        return ok;
    }

    function validarNombre() {
        const ok = (($nombre.val() || "").trim() !== "");
        $msgNombreReq.toggleClass("d-none", ok);
        $nombre.toggleClass("is-invalid", !ok);
        return ok;
    }

    function validarPrecio() {
        const raw = (($precioKg.val() || "") + "").trim();

        // obligatorio
        if (raw === "") {
            marcarValidez($precioKg, false);
            return false;
        }

        // numérico (float) y >= 0
        const n = parseFloatFlexible(raw);
        const ok = (n !== null && n >= 0);

        marcarValidez($precioKg, ok);
        return ok;
    }

    function validarTipo() {
        const ok = (($tipo.val() || "").toString() !== "");
        $msgTipoReq.toggleClass("d-none", ok);
        $tipo.toggleClass("is-invalid", !ok);
        return ok;
    }

    function validarIva() {
        const ok = (($iva.val() || "").toString() !== "");
        $msgIvaReq.toggleClass("d-none", ok);
        $iva.toggleClass("is-invalid", !ok);
        return ok;
    }

    function validarPuntoStock() {
        const raw = (($puntoStock.val() || "") + "").trim();

        // Según lo que pediste: entero, no vacío, >= 0
        if (raw === "") {
            marcarValidez($puntoStock, false);
            return false;
        }

        const ok = esEnteroNoNegativoTexto(raw);
        marcarValidez($puntoStock, ok);
        return ok;
    }

    function validarPromedio() {
        const raw = (($promedio.val() || "") + "").trim();

        // si querés obligatorio, cambiá este return por validación como precio
        if (raw === "") {
            marcarValidez($promedio, true);
            return true; // opcional
        }

        const n = parseFloatFlexible(raw);
        const ok = (n !== null); // si querés >=0: (n !== null && n >= 0)
        marcarValidez($promedio, ok);
        return ok;
    }

    function validarPorcentajeCorteMaestro() {
        const raw = (($porcentaje.val() || "") + "").trim();
        const n = parseFloatFlexible(raw);

        // obligatorio cuando modo = CorteMaestro y > 0
        const ok = (raw !== "" && n !== null && n > 0);
        marcarValidez($porcentaje, ok);
        return ok;
    }

    function validarDesperdicioCorteMaestro() {
        const raw = (($desperdicio.val() || "") + "").trim();
        const n = parseFloatFlexible(raw);

        // obligatorio cuando modo = CorteMaestro y >= 0
        const ok = (raw !== "" && n !== null && n >= 0);
        marcarValidez($desperdicio, ok);
        return ok;
    }

    function validarPresentacionUnidades() {
        const raw = (($presentacionUnidades.val() || "") + "").trim();
        const n = parseFloatFlexible(raw);

        // obligatorio cuando modo = Presentacion y >= 1
        const ok = (raw !== "" && n !== null && n >= 0);
        marcarValidez($presentacionUnidades, ok);
        return ok;
    }

    function validarCorteMaestroSeleccionadoSiAplica() {
        const modo = ($ddlModo.val() || "Ninguno");

        if (modo === "CorteMaestro" || modo === "Presentacion") {
            const ok = (($idCorteMaestroHidden.val() || "") + "").trim() !== "";
            marcarValidez($("#txtCorteMaestroNombre"), ok);
            return ok;
        }

        marcarValidez($("#txtCorteMaestroNombre"), true);
        return true;
    }

    function validarModoDependientes() {
        const modo = ($ddlModo.val() || "Ninguno");
        let ok = true;

        // valida selección de corte maestro si aplica
        if (!validarCorteMaestroSeleccionadoSiAplica()) ok = false;

        if (modo === "CorteMaestro") {
            if (!validarPorcentajeCorteMaestro()) ok = false;
            if (!validarDesperdicioCorteMaestro()) ok = false;

            // limpiar visualmente presentación (sin tocar valor)
            marcarValidez($presentacionUnidades, true);
        }
        else if (modo === "Presentacion") {
            if (!validarPresentacionUnidades()) ok = false;

            // limpiar visualmente porcentaje/desperdicio (sin tocar valor)
            marcarValidez($porcentaje, true);
            marcarValidez($desperdicio, true);
        }
        else {
            // Ninguno
            marcarValidez($("#txtCorteMaestroNombre"), true);
            marcarValidez($porcentaje, true);
            marcarValidez($desperdicio, true);
            marcarValidez($presentacionUnidades, true);
        }

        return ok;
    }

    // Eventos de validación
    $nombre.on("blur input", validarNombre);
    $codigo.on("blur input", validarCodigo);
    $precioKg.on("blur input", validarPrecio);
    $tipo.on("change", validarTipo);
    $iva.on("change", validarIva);
    $puntoStock.on("blur input", validarPuntoStock);
    $promedio.on("blur input", validarPromedio);
    $porcentaje.on("blur input", function () {
        if (($ddlModo.val() || "") === "CorteMaestro") validarPorcentajeCorteMaestro();
    });
    $desperdicio.on("blur input", function () {
        if (($ddlModo.val() || "") === "CorteMaestro") validarDesperdicioCorteMaestro();
    });
    $presentacionUnidades.on("blur input", function () {
        if (($ddlModo.val() || "") === "Presentacion") validarPresentacionUnidades();
    });
    $ddlModo.on("change", function () {
        validarModoDependientes();
    });
    // =========================
    // Validación código duplicado UI
    // =========================
    function setCodigoDuplicadoUI(existe, nombreProducto) {
        codigoDuplicado = !!existe;

        if (codigoDuplicado) {
            const texto = nombreProducto
                ? `El código ya existe para el producto: ${nombreProducto}`
                : "El código ya existe para otro producto.";
            $alertCodigoExiste.removeClass("d-none").text(texto);
        } else {
            $alertCodigoExiste.addClass("d-none").text("");
        }

        // Deshabilitar/habilitar botón crear producto (solo alta)
        if (!esEdicion) {
            $btnGuardar.prop("disabled", codigoDuplicado);
        }
    }

    // =========================
    // Validación código duplicado (PROMISE)
    // - Sirve para blur y para submit
    // =========================
    function validarCodigoExistente() {
        const dfd = $.Deferred();
        const codigo = ($codigo.val() || "").trim();

        if (xhrCodigo && xhrCodigo.readyState !== 4) {
            xhrCodigo.abort();
        }

        if (codigo === "") {
            setCodigoDuplicadoUI(false, "");
            dfd.resolve();
            return dfd.promise();
        }

        xhrCodigo = $.get(urlExisteCodigo, {
                codigo: codigo,
                idExcluir: $("input[name='IdCorte']").val() || 0
            })
            .done(function (data) {
                let existe = false;
                let nombre = "";

                if (data) {
                    // Endpoint mejorado: { existe: true/false, nombre: "..." }
                    if ("existe" in data || "Existe" in data) {
                        existe = !!(data.existe === true || data.Existe === true);
                    } else {
                        // Compatibilidad con endpoint viejo: si devuelve objeto => existe
                        existe = !!(data.id || data.Id || data.descripcion || data.Descripcion);
                    }

                    nombre = data.nombre || data.Nombre || data.descripcion || data.Descripcion || "";
                }

                // Si estás en edición y el código pertenece al mismo producto, no marcar duplicado
                if (esEdicion && data && (data.id || data.Id)) {
                    const idEncontrado = parseInt(data.id || data.Id || 0, 10);
                    const idActual = parseInt($("input[name='IdCorte']").val() || "0", 10);

                    if (idEncontrado > 0 && idActual > 0 && idEncontrado === idActual) {
                        setCodigoDuplicadoUI(false, "");
                        dfd.resolve();
                        return;
                    }
                }

                setCodigoDuplicadoUI(existe, nombre);
                dfd.resolve();
            })
            .fail(function (xhr, status) {
                if (status === "abort") {
                    dfd.reject("abort");
                    return;
                }

                // Compatibilidad endpoint viejo: 404 = no existe
                if (xhr && xhr.status === 404) {
                    setCodigoDuplicadoUI(false, "");
                    dfd.resolve();
                    return;
                }

                // Error real: no bloquear por red
                setCodigoDuplicadoUI(false, "");
                dfd.resolve();
            });

        return dfd.promise();
    }

    $codigo.on("blur", function () {
        validarCodigoExistente();
    });

    // Si cambia el código, limpiar alerta y re-habilitar hasta revalidar
    $codigo.on("input", function () {
        setCodigoDuplicadoUI(false, "");
    });

    // =========================
    // Helpers submit decimales
    // =========================
    function normalizarFloatOpcionalParaPost($input, etiqueta) {
        if (!$input || !$input.length) return true;

        const raw = ($input.val() || "").toString().trim();
        if (raw === "") return true; // opcional, se deja vacío

        const n = parseFloatFlexible(raw);
        if (n === null) {
            alert(`${etiqueta} inválido. Usá números y decimal con coma o punto.`);
            return false;
        }

        $input.val(formatFloatForPost(n)); // COMA para binder .NET (es-AR)
        return true;
    }

    // =========================
    // Submit: SIEMPRE validar código duplicado + luego validar resto
    // =========================
    $("#frmCorte").on("submit", function (e) {

        function enfocarPrimerInvalido() {
            const $first = $frm.find(".is-invalid:visible").first();
            if ($first.length) {
                $first.focus();
                if ($first.is("input[type='text'], input:not([type])")) {
                    try { $first.select(); } catch (_) { }
                }
            }
        }

        // Paso 1: siempre validar código duplicado (aunque no haya salido del input)
        if (!reenviandoSubmit) {
            e.preventDefault();

            validarCodigoExistente().done(function () {
                if (codigoDuplicado) {
                    $codigo.focus().select();
                    return; // NO reenvía
                }

                reenviandoSubmit = true;
                $frm.trigger("submit"); // reingresa y sigue con lógica normal
            });

            return false;
        }

        // Paso 2: submit real (reenvío controlado)
        reenviandoSubmit = false;

        let ok = true;

        // Validaciones base
        if (!validarCodigo()) ok = false;
        if (!validarNombre()) ok = false;
        if (!validarPrecio()) ok = false;
        if (!validarTipo()) ok = false;
        if (!validarIva()) ok = false;
        if (!validarPuntoStock()) ok = false;
        if (!validarPromedio()) ok = false;
        if (!validarModoDependientes()) ok = false;

        // Duplicado (por si quedó marcado)
        if (codigoDuplicado) {
            ok = false;
            $codigo.addClass("is-invalid");
        }

        if (!ok) {
            e.preventDefault();
            enfocarPrimerInvalido();
            return false;
        }

        // =========================
        // Normalización de numéricos para POST (.NET es-AR)
        // =========================

        // Precio Kg (obligatorio en cliente, pero reutilizamos helper)
        if (!normalizarFloatOpcionalParaPost($precioKg, "Precio Kg")) {
            e.preventDefault();
            marcarValidez($precioKg, false);
            $precioKg.focus().select();
            return false;
        }

        // Promedio (opcional o float válido)
        if (!normalizarFloatOpcionalParaPost($promedio, "Promedio")) {
            e.preventDefault();
            marcarValidez($promedio, false);
            $promedio.focus().select();
            return false;
        }

        const modo = ($ddlModo.val() || "Ninguno");

        if (modo === "CorteMaestro") {
            const nPorc = parseFloatFlexible($porcentaje.val() || "");
            const nDesp = parseFloatFlexible($desperdicio.val() || "");

            // Redundancia defensiva (ya validado arriba)
            if (nPorc === null || nPorc <= 0) {
                e.preventDefault();
                marcarValidez($porcentaje, false);
                $porcentaje.focus().select();
                return false;
            }

            if (nDesp === null || nDesp < 0) {
                e.preventDefault();
                marcarValidez($desperdicio, false);
                $desperdicio.focus().select();
                return false;
            }

            // HiddenFor -> valores con coma para binder .NET
            $("input[name='Porcentaje']").val(formatFloatForPost(nPorc));
            $("input[name='PorcentajeHueso']").val(formatFloatForPost(nDesp));
        }

        if (modo === "Presentacion") {
            const u = parseFloatFlexible($("#txtPresentacionUnidades").val() || "");

            // Redundancia defensiva (ya validado arriba)
            if (u === null || u < 1) {
                e.preventDefault();
                marcarValidez($("#txtPresentacionUnidades"), false);
                $("#txtPresentacionUnidades").focus().select();
                return false;
            }

            $("input[name='Porcentaje']").val("100");
            $("input[name='PorcentajeHueso']").val(formatFloatForPost(100 * (u - 1)));
        }

        if (modo === "Ninguno") {
            // Solo hidden para enviar consistente (NO limpiamos visibles)
            $("input[name='IdCorteMaestro']").val("");
            $("input[name='Porcentaje']").val("0");
            $("input[name='PorcentajeHueso']").val("0");
        }

        return true;
    });


    // ======================================================
    //para scrolear cuando el usuario usa tab para saltar de campo en campo
    // ======================================================
    document.querySelectorAll('input, select, textarea').forEach(element => {
        element.addEventListener('focus', () => {
            const scrollMargin = 200; // Por ejemplo, margen para que no quede tapado
            const elementTop = element.getBoundingClientRect().top + window.scrollY;
            window.scrollTo({ top: elementTop - scrollMargin, behavior: 'smooth' });
        });
    });

    // ======================================================
    // SCANNER: EAN-8 / EAN-13 -> setea #Codigo, cierra, foco #CorteDesc
    // ======================================================
    const TIEMPO_RELECTURA = 2000;
    const SEL_CODIGO = "#Codigo";
    const SEL_DESC = "#CorteDesc";
    const SEL_MSG = "#scannerMsg";

    let lastOkCode = "";
    let lastOkAt = 0;

    function beep() {
        const audio = document.getElementById("beep");
        if (!audio) return;
        try {
            audio.currentTime = 0;
            audio.play();
        } catch (e) { }
    }

    function setScannerMsg(text) {
        const el = document.querySelector(SEL_MSG);
        if (!el) return;
        if (!text) {
            el.classList.add("d-none");
            el.textContent = "";
        } else {
            el.textContent = text;
            el.classList.remove("d-none");
        }
    }

    function onlyDigits(s) { return (s || "").toString().replace(/\D/g, ""); }

    function isValidEAN(code) {
        code = onlyDigits(code);
        if (code.length === 13) return isValidEAN13(code);
        if (code.length === 8) return isValidEAN8(code);
        return false;
    }

    function isValidEAN13(code13) {
        if (!/^\d{13}$/.test(code13)) return false;
        let sum = 0;
        for (let i = 0; i < 12; i++) {
            const d = parseInt(code13[i], 10);
            sum += (i % 2 === 0) ? d : d * 3;
        }
        const check = (10 - (sum % 10)) % 10;
        return check === parseInt(code13[12], 10);
    }

    function isValidEAN8(code8) {
        if (!/^\d{8}$/.test(code8)) return false;
        let sum = 0;
        for (let i = 0; i < 7; i++) {
            const d = parseInt(code8[i], 10);
            sum += (i % 2 === 0) ? d * 3 : d;
        }
        const check = (10 - (sum % 10)) % 10;
        return check === parseInt(code8[7], 10);
    }

    if (typeof BarcodeScanner !== "undefined") {
        const scanner = new BarcodeScanner({
            videoSelector: "#videoScanner",
            containerSelector: "#scannerContainer",
            onCodeDetected: function (codigoLeido) {

                const clean = onlyDigits(codigoLeido);
                const now = Date.now();

                if (clean === lastOkCode && (now - lastOkAt) < TIEMPO_RELECTURA) return;

                if (!isValidEAN(clean)) {
                    setScannerMsg("Código inválido (solo EAN-8 o EAN-13). Volvé a enfocar.");
                    return;
                }

                setScannerMsg("");
                lastOkCode = clean;
                lastOkAt = now;

                const $codigoEl = document.querySelector(SEL_CODIGO);
                if ($codigoEl) {
                    $codigoEl.value = clean;
                    $($codigoEl).trigger("input"); // limpia estado de duplicado hasta blur
                }

                beep();
                scanner.cerrar();

                const $desc = document.querySelector(SEL_DESC);
                if ($desc) $desc.focus();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const inputCodigo = document.getElementById('Codigo');
            if (inputCodigo) {
                inputCodigo.focus();
            }
        });

        document.getElementById("btnScanner")?.addEventListener("click", () => {
            setScannerMsg("");
            scanner.iniciar();
        });

        document.getElementById("btnCerrarScanner")?.addEventListener("click", () => {
            setScannerMsg("");
            scanner.cerrar();
        });

        document.getElementById("btnFlash")?.addEventListener("click", async () => {
            const estado = await scanner.toggleFlash();
            const btn = document.getElementById("btnFlash");
            if (!btn) return;

            if (estado) {
                btn.classList.remove("btn-secondary");
                btn.classList.add("btn-warning");
                btn.textContent = "🔦 Flash ON";
            } else {
                btn.classList.remove("btn-warning");
                btn.classList.add("btn-secondary");
                btn.textContent = "🔦 Flash";
            }
        });
    }

})();
    </script>
}

<style>
    /* Scanner */
    #scannerContainer {
        margin-bottom: .75rem;
    }

    .scanner-wrapper {
        position: relative;
        width: 100%;
        height: 160px;
        overflow: hidden;
        background: #000;
        border-radius: 8px;
    }

    #videoScanner {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .scanner-line {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 2px;
        background: red;
        box-shadow: 0 0 6px red;
        animation: scan 1.2s linear infinite;
    }

    @@keyframes scan {
        0% {
            top: 15%;
            opacity: .9;
        }

        50% {
            top: 50%;
            opacity: 1;
        }

        100% {
            top: 85%;
            opacity: .9;
        }
    }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
    }

    /* Modal: que no supere el alto de pantalla */
    .modal-fit-screen .modal-content,
    #modalBuscarProducto .modal-content {
        max-height: calc(100vh - 1.5rem);
    }

    .modal-table-scroll {
        max-height: min(50vh, 420px);
        overflow-y: auto;
    }

    #modalBuscarProducto .table-responsive {
        max-height: min(50vh, 420px);
        overflow-y: auto;
    }

    /* Fila activa (si no se nota bien con tu theme) */
    #tbMarcas tr.table-active,
    #tablaProductos tr.table-active {
        background-color: rgba(13, 110, 253, .12);
    }
    /* Botonera fija inferior */
.espacio-botonera-fija {
    height: 84px; /* reserva espacio para que no tape contenido */
}

