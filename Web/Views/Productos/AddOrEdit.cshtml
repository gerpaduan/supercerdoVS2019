            if ($(e.target).closest(".modal").length) return;
            if (!esElementoAccion($("#btnBuscarMarca"))) return;

            e.preventDefault();
            $("#btnBuscarMarca").trigger("click");
            return;
        }

        if (e.key === "F10" && !e.altKey && !e.ctrlKey && !e.metaKey) {
            if ($(e.target).closest(".modal").length) return;
            if (!esElementoAccion($("#btnBuscarCorteMaestro"))) return;

            e.preventDefault();
            $("#btnBuscarCorteMaestro").trigger("click");
            return;
        }

        if (!e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || e.repeat) return;
        if (document.body.classList.contains("swal2-shown")) return;

        const tecla = (e.key || "").toLowerCase();
        let $destino = null;

        if (tecla === "arrowleft") {
            $destino = $btnVerAnteriorProducto;
        } else if (tecla === "arrowright") {
            $destino = $btnSiguienteProducto;
        } else if (tecla === "enter") {
            const editReadonlyApi = window.productosEditReadonly;
            const estaSoloLectura = !editReadonlyApi || editReadonlyApi.isReadOnly();
            $destino = estaSoloLectura ? $btnHabilitarEdicionProducto : $btnGuardar;
