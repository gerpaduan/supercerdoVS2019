@model Web.Models.MercadoPagoTerminalesIndexVm

@{
    ViewBag.Title = "Terminales Mercado Pago";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid mercadopago-terminales-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Terminales Mercado Pago</h1>
            <p class="text-muted mb-0">Alta de sucursales y terminales Point contra la cuenta de Mercado Pago conectada.</p>
        </div>
        <a href="@Url.Action("Index", "MercadoPago")" class="btn btn-outline-secondary btn-sm">Volver a Mercado Pago</a>
    </div>

    @if (!Model.Conectado)
    {
        <div class="alert alert-warning">
            Primero hay que <a href="@Url.Action("Index", "MercadoPago")">conectar la cuenta de Mercado Pago</a> antes de poder dar de alta sucursales y terminales.
        </div>
    }
    else if (!Model.PuedeAdministrar)
    {
        <div class="alert alert-secondary">
            Solo un usuario administrador puede dar de alta sucursales y terminales.
        </div>
    }

    @foreach (var sucursal in Model.Sucursales)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">@sucursal.NombreSucursal</h5>

                @if (string.IsNullOrWhiteSpace(sucursal.MpStoreId))
                {
                    <p class="text-muted small mb-2">Todavía no está dada de alta en Mercado Pago.</p>

                    if (Model.Conectado && Model.PuedeAdministrar)
                    {
                        using (Html.BeginForm("CrearStore", "MercadoPagoTerminales", FormMethod.Post, new { @class = "form-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idSucursal" value="@sucursal.IdSucursal" />
                            <input type="text" name="calle" class="form-control form-control-sm mr-2 mb-2" placeholder="Calle" required="required" />
                            <input type="text" name="numero" class="form-control form-control-sm mr-2 mb-2" placeholder="Número" required="required" />
                            <input type="text" name="ciudad" class="form-control form-control-sm mr-2 mb-2" placeholder="Ciudad" required="required" />
                            <input type="text" name="provincia" class="form-control form-control-sm mr-2 mb-2" placeholder="Provincia" required="required" />
                            <button type="submit" class="btn btn-primary btn-sm mb-2">Dar de alta en Mercado Pago</button>
                        }
                    }
                }
                else
                {
                    <p class="text-muted small mb-3">Store de Mercado Pago: <code>@sucursal.MpStoreId</code></p>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Alias</th>
                                <th>Caja (POS)</th>
                                <th>Terminal vinculada</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var terminal in sucursal.Terminales)
                            {
                                <tr>
                                    <td>@terminal.Alias</td>
                                    <td><code>@terminal.PosId</code></td>
                                    <td>@(string.IsNullOrWhiteSpace(terminal.TerminalIdMp) ? "-- sin vincular --" : terminal.TerminalIdMp)</td>
                                    <td>
                                        @if (terminal.Activo)
                                        {
                                            <span class="badge badge-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.PuedeAdministrar)
                                        {
                                            if (string.IsNullOrWhiteSpace(terminal.TerminalIdMp))
                                            {
                                                using (Html.BeginForm("VerificarVinculacion", "MercadoPagoTerminales", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idTerminal" value="@terminal.Id" />
                                                    <button type="submit" class="btn btn-outline-primary btn-sm">Verificar vinculación</button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ActivarModoIntegrado", "MercadoPagoTerminales", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idTerminal" value="@terminal.Id" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Activar modo integrado</button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    if (Model.Conectado && Model.PuedeAdministrar)
                    {
                        using (Html.BeginForm("AgregarTerminal", "MercadoPagoTerminales", FormMethod.Post, new { @class = "form-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idSucursal" value="@sucursal.IdSucursal" />
                            <input type="text" name="alias" class="form-control form-control-sm mr-2" placeholder="Alias de la terminal (ej. Caja 1)" required="required" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Agregar terminal</button>
                        }
                    }
                }
            </div>
        </div>
    }
</div>
