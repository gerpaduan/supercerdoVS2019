@model Web.Models.CompraLineasIndexVm
@using Entidades
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
}

<div class="container-fluid px-2 px-md-3" data-lineas-agrupadas-page="compras">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h4 class="mb-2 mb-md-0">Lineas de compra</h4>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Compras", new { idSucursal = Model.IdSucursal, tipoCompra = Model.TipoCompra, texto = Model.Texto, fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss") })">
            <i class="fas fa-arrow-left mr-1"></i> Volver al indice
        </a>
    </div>

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Lineas", "Compras")" class="js-form-filtros-lineas">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Se modificaron filtros principales. Presioná <strong>Buscar</strong> para recargar los datos.
                </div>

                <div class="elaborados-filtros-grid lineas-filtros-grid cols-4">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Sucursal</label>
                        <select name="idSucursal" class="form-control js-filtro-recarga">
                            <option value="-1" @(Model.IdSucursal == -1 ? "selected" : "")>Todas</option>
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha desde</label>
                        <input name="fechaDesde" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha hasta</label>
                        <input name="fechaHasta" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Producto</label>
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="producto" value="@Model.Producto" placeholder="Codigo o descripcion" autocomplete="off" />
                    </div>
                    <div class="form-group mb-0 lineas-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="elaborados-filtro-label">Proveedor</label>
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="proveedor" value="@Model.Texto" placeholder="Proveedor" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="elaborados-filtro-label">Tipo de compra</label>
                        <select class="form-control js-filtro-vivo" data-live-filter="tipoCompra">
                            <option value="">Todos</option>
                            @if (Model.PermiteMediaRes)
                            {
                                <option value="media res" @(Model.TipoCompra == "Media Res" ? "selected" : "")>Media Res</option>
                            }
                            <option value="cortes" @(Model.TipoCompra == "Cortes" ? "selected" : "")>Cortes</option>
                        </select>
                    </div>
                </div>

                <div class="custom-control custom-switch mt-1">
                    <input type="checkbox" class="custom-control-input js-toggle-detalles-general" id="expandirDetallesCompras" />
                    <label class="custom-control-label" for="expandirDetallesCompras">Ver detalles</label>
                </div>
            </form>
        </div>
    </div>

    <div class="lineas-resumen-grid cols-4 mb-3">
        <div class="card border-left-primary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalKg">0,000</div></div></div>
        <div class="card border-left-success shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total pesos</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalImporte">$ 0,00</div></div></div>
        <div class="card border-left-info shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-info text-uppercase mb-1">Cantidad de lineas</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalLineas">0</div></div></div>
        <div class="card border-left-secondary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Cantidad de registros</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalRegistros">0</div></div></div>
    </div>

    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-server @(Model.Compras != null && Model.Compras.Count > 0 ? "d-none" : "")">No se encontraron compras con lineas para los filtros seleccionados.</div>
    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-client d-none">No hay resultados con el filtro en vivo.</div>

    @if (Model.Compras != null)
    {
        foreach (var compra in Model.Compras)
        {
            var proveedor = compra.Campos.FirstOrDefault(x => x.Etiqueta == "Proveedor");
            var tipoCompra = compra.Campos.FirstOrDefault(x => x.Etiqueta == "Tipo de compra");
            <div class="card shadow-sm mb-3 linea-registro-card js-registro-card"
                 data-proveedor="@(proveedor != null ? proveedor.Valor : "")"
                 data-tipoCompra="@(tipoCompra != null ? tipoCompra.Valor : "")">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <div class="linea-resumen-principal">@compra.ResumenCompacto</div>
                            <div class="linea-resumen-secundario">@compra.ResumenSecundario</div>
                        </div>
                        <div class="linea-resumen-tools mt-2 mt-md-0">
                            <span class="badge badge-success badge-pill px-3 py-2">@compra.TotalTexto</span>
                            <a class="btn btn-sm btn-outline-primary" href="@compra.EditUrl">Ver registro</a>
                        </div>
                    </div>
                    <div class="row mt-3 linea-registro-extra d-none">
                        @foreach (var campo in compra.Campos)
                        {
                            <div class="col-12 col-md-4 mb-2">
                                <div class="small text-muted text-uppercase">@campo.Etiqueta</div>
                                <div>@campo.Valor</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-responsive js-sync-scroll-body">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Código producto</th>
                                <th>Producto</th>
                                <th class="text-right">Cantidad / kg</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Total línea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in compra.Lineas)
                            {
                                <tr class="js-linea-row" data-codigo="@linea.Codigo" data-producto="@linea.Producto" data-kg="@linea.CantidadKg" data-total="@linea.Total" data-unidades="0">
                                    <td>@linea.Codigo</td>
                                    <td>@linea.Producto</td>
                                    <td class="text-right">@linea.CantidadKgTexto</td>
                                    <td class="text-right">@linea.PrecioTexto</td>
                                    <td class="text-right">@linea.TotalTexto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")
@Html.Partial("~/Views/Shared/_LineasAgrupadasStyles.cshtml")

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/lineas-agrupadas.js?v=1")"></script>
}
