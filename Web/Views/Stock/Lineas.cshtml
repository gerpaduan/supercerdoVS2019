@model Web.Models.StockLineasIndexVm
@using Entidades
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
}

<div class="container-fluid px-2 px-md-3" data-lineas-agrupadas-page="stock">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h4 class="mb-2 mb-md-0">Lineas de stock</h4>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Stock", new { idSucursal = Model.IdSucursal, tipoCompra = Model.TipoCompra, fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss") })">
            <i class="fas fa-arrow-left mr-1"></i> Volver al indice
        </a>
    </div>

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Lineas", "Stock")" class="js-form-filtros-lineas">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Se modificaron filtros principales. Presioná <strong>Buscar</strong> para recargar los datos.
                </div>

                <div class="elaborados-filtros-grid lineas-filtros-grid cols-4">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="idSucursalStockLineas" class="form-control">
                            <option value="0" @(Model.IdSucursal == 0 ? "selected" : "")>Todas</option>
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha desde</label>
                        <input name="fechaDesde" id="fechaDesdeStockLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha hasta</label>
                        <input name="fechaHasta" id="fechaHastaStockLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Producto</label>
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="producto" value="@Model.Producto" placeholder="Codigo o descripcion" autocomplete="off" />
                    </div>
                    <div class="form-group mb-0 lineas-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block" id="btnBuscarStockLineas">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                        </button>
                    </div>
                </div>

                <div class="mt-2">
                    <div id="estadoBusquedaStockLineas" class="text-muted small">Resultados actualizados.</div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="elaborados-filtro-label">Tipo de operación</label>
                        <select class="form-control js-filtro-vivo" data-live-filter="tipoOperacion">
                            <option value="">Todos</option>
                            <option value="ingreso stock" @(Model.TipoCompra == "Ingreso Stock" ? "selected" : "")>Ingreso</option>
                            <option value="egreso stock" @(Model.TipoCompra == "Egreso Stock" ? "selected" : "")>Egreso</option>
                            <option value="cierre stock" @(Model.TipoCompra == "Cierre Stock" ? "selected" : "")>Cierre</option>
                            <option value="pesaje cortes" @(Model.TipoCompra == "Pesaje Cortes" ? "selected" : "")>Pesaje</option>
                            <option value="ajuste stock" @(Model.TipoCompra == "Ajuste Stock" ? "selected" : "")>Ajuste</option>
                        </select>
                    </div>
                </div>

                <div class="custom-control custom-switch mt-1">
                    <input type="checkbox" class="custom-control-input js-toggle-detalles-general" id="expandirDetallesStock" />
                    <label class="custom-control-label" for="expandirDetallesStock">Ver detalles</label>
                </div>
            </form>
        </div>
    </div>

    <div class="lineas-resumen-grid cols-4 mb-3">
        <div class="card border-left-primary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalKg">0,000</div></div></div>
        <div class="card border-left-success shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total pesos</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalImporte">$ 0,00</div></div></div>
        <div class="card border-left-info shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-info text-uppercase mb-1">Cantidad de lineas</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalLineas">0</div></div></div>
        <div class="card border-left-secondary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Cantidad de registros</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalRegistros">0</div></div></div>
    </div>

    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-server @(Model.Registros != null && Model.Registros.Count > 0 ? "d-none" : "")">No se encontraron registros de stock con lineas para los filtros seleccionados.</div>
    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-client d-none">No hay resultados con el filtro en vivo.</div>

    @if (Model.Registros != null)
    {
        foreach (var registro in Model.Registros)
        {
            var tipoOperacion = registro.Campos.FirstOrDefault(x => x.Etiqueta == "Tipo de operacion");
            <div class="card shadow-sm mb-3 linea-registro-card js-registro-card"
                 data-tipoOperacion="@(tipoOperacion != null ? tipoOperacion.Valor : "")">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <div class="linea-resumen-principal">@registro.ResumenCompacto</div>
                            <div class="linea-resumen-secundario">@registro.ResumenSecundario</div>
                        </div>
                        <div class="linea-resumen-tools mt-2 mt-md-0">
                            <span class="badge badge-primary badge-pill px-3 py-2">@registro.TotalKg.ToString("N3") kg</span>
                            <a class="btn btn-sm btn-outline-primary" href="@registro.EditUrl">Ver registro</a>
                        </div>
                    </div>
                    <div class="row mt-3 linea-registro-extra d-none">
                        @foreach (var campo in registro.Campos)
                        {
                            <div class="col-12 col-md-4 mb-2">
                                <div class="small text-muted text-uppercase">@campo.Etiqueta</div>
                                <div>@campo.Valor</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-responsive js-sync-scroll-body">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Código producto</th>
                                <th>Producto</th>
                                <th class="text-right">Cantidad / kg</th>
                                <th class="text-center">Tipo / signo</th>
                                <th>Observación línea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in registro.Lineas)
                            {
                                <tr class="js-linea-row" data-codigo="@linea.Codigo" data-producto="@linea.Producto" data-kg="@linea.CantidadKg" data-total="0" data-unidades="0">
                                    <td>@linea.Codigo</td>
                                    <td>@linea.Producto</td>
                                    <td class="text-right">@linea.CantidadKgTexto</td>
                                    <td class="text-center">@linea.Signo</td>
                                    <td>@linea.Observacion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")
@Html.Partial("~/Views/Shared/_LineasAgrupadasStyles.cshtml")

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('.js-form-filtros-lineas');
            if (!form) return;

            var inputSucursal = document.getElementById('idSucursalStockLineas');
            var inputFechaDesde = document.getElementById('fechaDesdeStockLineas');
            var inputFechaHasta = document.getElementById('fechaHastaStockLineas');
            var alerta = document.getElementById('alertaFiltrosPendientes');
            var estado = document.getElementById('estadoBusquedaStockLineas');
            var btnBuscar = document.getElementById('btnBuscarStockLineas');
            var btnTexto = btnBuscar ? btnBuscar.querySelector('.btn-buscar-texto') : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
            };

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            function actualizarAviso() {
                if (!alerta) return;
                alerta.classList.toggle('d-none', !hayFechasPendientes());
            }

            function setBuscando(mensaje) {
                if (btnBuscar) btnBuscar.disabled = true;
                if (btnTexto) btnTexto.textContent = ' Cargando...';
                if (estado) estado.textContent = mensaje || 'Actualizando búsqueda...';
            }

            function enviarEnVivo() {
                setBuscando('Actualizando búsqueda en vivo...');

                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                }

                form.submit();
            }

            if (inputFechaDesde) {
                inputFechaDesde.addEventListener('change', actualizarAviso);
            }

            if (inputFechaHasta) {
                inputFechaHasta.addEventListener('change', actualizarAviso);
            }

            if (inputSucursal) {
                inputSucursal.addEventListener('change', enviarEnVivo);
            }

            form.addEventListener('submit', function () {
                fechasAplicadas = {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
                };
                actualizarAviso();
                setBuscando('Actualizando búsqueda...');
            });
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/lineas-agrupadas.js?v=1")"></script>
}
