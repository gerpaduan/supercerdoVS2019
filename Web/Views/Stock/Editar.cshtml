@model Web.Models.StockEditVm
@using System
@using System.Collections.Generic
@using System.Web
@using System.Web.Helpers
@using Entidades

@{
    bool renderInlineScripts = Request != null && Request.IsAjaxRequest();
    Layout = renderInlineScripts ? null : "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = Model.EsEdicion ? "Modificar Stock" : "Nuevo Stock";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    bool esPesaje = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.PesajeCortes), StringComparison.OrdinalIgnoreCase);
    bool esAjuste = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.AjusteStock), StringComparison.OrdinalIgnoreCase);
    bool esEgreso = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.EgresoStock), StringComparison.OrdinalIgnoreCase);
    bool permiteNegativo = esAjuste || esEgreso;
    bool tieneCompraVinculadaPesaje = esPesaje && Model.IdPesajeAjustado.HasValue && Model.IdPesajeAjustado.Value > 0;
    bool mostrarGuardarSinPesaje = Model.GuardarSinPesaje
        || ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Any(e => string.Equals(e.ErrorMessage, "Ingrese los kilos de medias para el pesaje.", StringComparison.OrdinalIgnoreCase));
    var modalProductoData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarProductoStock" },
        { "ApiUrl", Url.Action("BuscarCorte", "Stock") },
        { "Titulo", "Buscar Producto de Stock" },
        { "MostrarPrecio", "false" }
    };
}

<div class="container-fluid px-2 px-md-3 stock-page stock-form-compact" data-stock-page="1">
    <div id="stockDraftBanner" class="alert alert-warning d-none" role="alert">
        Se encontró un borrador local de este movimiento de stock.
        <button type="button" class="btn btn-sm btn-warning ml-2" data-action="restore-draft">Recuperar</button>
        <button type="button" class="btn btn-sm btn-outline-dark ml-2" data-action="clear-draft">Limpiar borrador</button>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Stock")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
        <span id="stockEstadoAjusteBadge"
              class="badge badge-pill @(string.Equals(Model.Estado, "Actualizado", StringComparison.OrdinalIgnoreCase) ? "badge-success" : "badge-warning") px-3 py-2 @(!esPesaje || string.IsNullOrWhiteSpace(Model.Estado) ? "d-none" : "")">
            Ajuste: <span id="stockEstadoAjusteTexto">@Model.Estado</span>
        </span>
    </div>

    <div class="card shadow-sm stock-panel-card">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form id="formStock" method="post" action="@Url.Action("Guardar", "Stock")" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdCompra)
                @Html.HiddenFor(m => m.TipoCompra)
                @Html.HiddenFor(m => m.IdProveedor)
                @Html.HiddenFor(m => m.IdPesajeAjustado)
                @Html.HiddenFor(m => m.DraftKey)
                <div id="lineasHiddenContainer"></div>
                <div id="pesajesVinculadosHiddenContainer"></div>

                <div class="row">
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="IdSucursal">Sucursal</label>
                            <select id="IdSucursal" name="IdSucursal" class="form-control">
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="FechaCompra">Fecha</label>
                            <input type="datetime-local"
                                   id="FechaCompra"
                                   name="FechaCompra"
                                   class="form-control"
                                   value="@Model.FechaCompra.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="form-group">
                            <label for="TipoCompraVisual">Acción</label>
                            <div class="input-group">
                                <select id="TipoCompraVisual" class="form-control app-product-highlight stock-action-highlight" disabled>
                                    <option value="Ingreso Stock" @(string.Equals(Model.TipoCompra, "Ingreso Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Ingreso</option>
                                    <option value="Egreso Stock" @(string.Equals(Model.TipoCompra, "Egreso Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Egreso</option>
                                    <option value="Cierre Stock" @(string.Equals(Model.TipoCompra, "Cierre Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Cierre</option>
                                    <option value="Ajuste Stock" @(string.Equals(Model.TipoCompra, "Ajuste Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Ajuste</option>
                                    <option value="Pesaje Cortes" @(string.Equals(Model.TipoCompra, "Pesaje Cortes", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Pesaje</option>
                                </select>
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-secondary stock-action-button" id="btnHabilitarTipoCompra" title="Habilitar cambio de acción">
                                        <i class="fas fa-edit mr-1"></i> Cambiar
                                    </button>
                                </div>
                            </div>
                            <small class="form-text text-muted">La acción se desbloquea sólo cuando presiona cambiar.</small>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        @Html.Partial("_AdvertenciaPermisoFecha")
                    </div>
                </div>

                <div class="row @(esPesaje ? "" : "d-none")" id="bloquePesajeStock">
                        <div class="col-12 col-lg-4">
                            <div class="form-group">
                                <label for="razonSocial">Proveedor</label>
                                <div class="input-group">
                                    <input type="text" id="razonSocial" class="form-control" value="@Model.ProveedorNombre" placeholder="Seleccione un proveedor" readonly />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-primary" id="btnBuscarProveedor" title="Buscar proveedor (F9)">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="btnLimpiarProveedor" title="Limpiar proveedor">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <small class="form-text text-muted" id="lblProveedorCuit">@(!string.IsNullOrWhiteSpace(Model.ProveedorCuit) ? ("CUIT: " + Model.ProveedorCuit) : "Sin proveedor seleccionado")</small>
                                <div class="stock-compra-vinculada-box mt-2 @((tieneCompraVinculadaPesaje && !Model.EsEdicion) ? "" : "d-none")" id="stockCompraVinculadaBox">
                                    <div class="small text-uppercase font-weight-bold mb-2">
                                        Compra vinculada
                                        <span id="stockCompraVinculadaId" class="ml-1">@(tieneCompraVinculadaPesaje ? "#" + Model.IdPesajeAjustado.Value : "")</span>
                                    </div>
                                    <div id="stockCompraVinculadaEstado" class="font-weight-bold @(!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada) ? "" : "d-none")">@Model.EstadoCompraVinculada</div>
                                    <div id="stockCompraVinculadaDatos" class="@(!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada) ? "d-none" : "")">
                                        <div class="small text-muted">Proveedor</div>
                                        <div class="font-weight-bold" id="stockCompraVinculadaProveedor">@(!string.IsNullOrWhiteSpace(Model.ProveedorCompraVinculada) ? Model.ProveedorCompraVinculada : "-")</div>
                                        <div class="small text-muted mt-2">Fecha de compra</div>
                                        <div class="font-weight-bold" id="stockCompraVinculadaFecha">@(Model.FechaCompraVinculada.HasValue ? Model.FechaCompraVinculada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="form-group">
                                <label for="CantMedias">Cant.Medias</label>
                                <input type="number" id="CantMedias" name="CantMedias" class="form-control" min="1" step="1" value="@(Model.CantMedias.HasValue ? Model.CantMedias.Value.ToString() : "")" />
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="form-group">
                                <label for="KgsMedias">Kgs.Medias</label>
                                <input type="text" id="KgsMedias" name="KgsMedias" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" value="@(Model.KgsMedias.HasValue ? Model.KgsMedias.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                <div class="mt-2 @(mostrarGuardarSinPesaje ? "" : "d-none")" id="wrapGuardarSinPesaje">
                                    <div class="custom-control custom-switch">
                                        @Html.CheckBoxFor(m => m.GuardarSinPesaje, new { @class = "custom-control-input", id = "GuardarSinPesaje" })
                                        <label class="custom-control-label" for="GuardarSinPesaje">Guardar sin pesaje</label>
                                    </div>
                                    <small class="form-text text-muted">Guardar Kgs.Medias en 0</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2 @(esPesaje ? "" : "d-none")" id="wrapBtnSeleccionarCompraPesaje">
                            <div class="form-group mb-lg-0">
                                <label class="d-none d-lg-block">&nbsp;</label>
                                <button type="button" class="btn btn-outline-primary btn-block" id="btnSeleccionarCompraPesaje">
                                    <i class="fas fa-shopping-basket mr-1"></i> Vincular compra
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2 @(esPesaje ? "" : "d-none")" id="wrapBtnVincularPesaje">
                            <div class="form-group mb-lg-0">
                                <label class="d-none d-lg-block">&nbsp;</label>
                                <button type="button" class="btn btn-outline-info btn-block" id="btnVincularPesajes">
                                    <i class="fas fa-link mr-1"></i> Vincular pesajes
                                </button>
                            </div>
                        </div>
                </div>

                <div class="row">
                    <div class="col-12 col-xl-8">
                        @if (Model.EsEdicion && esPesaje)
                        {
                            <div class="stock-compra-vinculada-box @(tieneCompraVinculadaPesaje ? "" : "d-none")">
                                <div class="small text-uppercase font-weight-bold mb-2">
                                    Compra vinculada
                                    <span class="ml-1">@(tieneCompraVinculadaPesaje ? "#" + Model.IdPesajeAjustado.Value : "")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada))
                                {
                                    <div class="font-weight-bold">@Model.EstadoCompraVinculada</div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-12 col-md-6 mb-2">
                                            <div class="text-muted small">Proveedor</div>
                                            <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorCompraVinculada) ? Model.ProveedorCompraVinculada : "-")</div>
                                        </div>
                                        <div class="col-12 col-md-6 mb-2">
                                            <div class="text-muted small">Fecha de compra</div>
                                            <div class="font-weight-bold">@(Model.FechaCompraVinculada.HasValue ? Model.FechaCompraVinculada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="text-muted small">Cant.Medias</div>
                                            <div class="font-weight-bold">@(Model.CantMediasCompraVinculada.HasValue ? Model.CantMediasCompraVinculada.Value.ToString() : "-")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="text-muted small">Kgs.Medias</div>
                                            <div class="font-weight-bold">@(Model.KgsCompraVinculada.HasValue ? Model.KgsCompraVinculada.Value.ToString("N2") : "-")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.EsEdicion && esAjuste)
                        {
                            <div class="stock-pesaje-ajustado-box">
                                <div class="small text-uppercase font-weight-bold mb-2">
                                    @(Model.IdPesajeAjustado.HasValue && Model.IdPesajeAjustado.Value > 0
                                        ? "Pesaje vinculado #" + Model.IdPesajeAjustado.Value
                                        : "Pesaje vinculado")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.EstadoPesajeAjustado))
                                {
                                    <div class="font-weight-bold">@Model.EstadoPesajeAjustado</div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-12 col-md-6 mb-2">
                                            <div class="text-muted small">Proveedor</div>
                                            <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorPesajeAjustado) ? Model.ProveedorPesajeAjustado : "-")</div>
                                        </div>
                                        <div class="col-12 col-md-6 mb-2">
                                            <div class="text-muted small">Fecha del pesaje</div>
                                            <div class="font-weight-bold">@(Model.FechaPesajeAjustado.HasValue ? Model.FechaPesajeAjustado.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="text-muted small">Cant.Medias</div>
                                            <div class="font-weight-bold">@(Model.CantMediasPesajeAjustado.HasValue ? Model.CantMediasPesajeAjustado.Value.ToString() : "-")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="text-muted small">Kgs.Medias</div>
                                            <div class="font-weight-bold">@(Model.KgsPesajeAjustado.HasValue ? Model.KgsPesajeAjustado.Value.ToString("N2") : "-")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-12 col-xl-8">
                        <div class="border rounded p-3 mb-3 stock-section-box">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-0 stock-section-title">Agregar producto</h6>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="custom-control custom-switch mr-2">
                                        <input type="checkbox" class="custom-control-input" id="chkBalanzaLinea" checked />
                                        <label class="custom-control-label" for="chkBalanzaLinea">Balanza</label>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVerAcumulados" data-edit-readonly-ignore="true">
                                        <i class="fas fa-layer-group mr-1"></i> Ver acumulados
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-info @(esPesaje ? "" : "d-none")" id="btnVerPorcentajePesaje" data-edit-readonly-ignore="true">
                                        <i class="fas fa-percent mr-1"></i> Ver Porc(%)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary @(string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.CierreStock), StringComparison.OrdinalIgnoreCase) ? "" : "d-none")" id="btnProductosNoCargados">
                                        <i class="fas fa-list mr-1"></i> Productos no cargados
                                    </button>
                                </div>
                            </div>

                            <div id="balanzaStatusWrapStock">
                                <div class="small text-muted mb-2">
                                    Conexión balanza: <span id="estadoBalanzaStock">Desconocida</span>
                                </div>
                                <div class="progress mb-3" style="height:4px;">
                                    <div id="barraBalanzaStock" class="progress-bar" role="progressbar" style="width:0%"></div>
                                </div>
                            </div>

                            @Html.Partial("~/Views/Shared/_ScannerCodigoBarra.cshtml")

                            <div class="row align-items-end">
                                <div class="col-12 col-md-3 col-lg-3">
                                    <div class="form-group">
                                        <label for="txtCodigoProducto">Código</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <button type="button" class="btn btn-outline-secondary" id="btnScanner" title="Escanear código de barra">
                                                    <i class="fas fa-barcode"></i>
                                                </button>
                                            </div>
                                            <input type="number" id="txtCodigoProducto" class="form-control" min="0" step="1" autocomplete="off" style="min-width:13ch;" />
                                        </div>
                                        <small id="scannerMsg" class="text-danger d-none"></small>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5 col-lg-6">
                                    <div class="form-group">
                                        <label for="txtProductoNombre">Producto</label>
                                        <div class="input-group">
                                            <input type="hidden" id="txtProductoId" />
                                            <input type="hidden" id="txtProductoPesable" />
                                            <input type="hidden" id="txtProductoTipo" />
                                            <input type="hidden" id="txtProductoPromedio" />
                                            <input type="text" id="txtProductoNombre" class="form-control app-product-highlight" readonly />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnBuscarProducto" title="Buscar producto (F10)">
                                                    <i class="fas fa-search"></i>
                                                    <span class="d-none d-lg-inline ml-1">F10</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-8 col-md-3 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCantKgs" id="lblCantidadStock">Cantidad</label>
                                        <input type="text" id="txtCantKgs" class="form-control solo-decimal" inputmode="decimal" enterkeyhint="done" autocomplete="off" style="min-width:8ch;" />
                                    </div>
                                </div>
                                <div class="col-4 col-md-1">
                                    <div class="form-group">
                                        <label class="d-block invisible mb-0">&nbsp;</label>
                                        <button type="button" class="btn btn-primary btn-block d-flex align-items-center justify-content-center" id="btnAgregarLineaStock" title="Agregar">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="stockFeedback" class="alert alert-success py-2 px-3 mb-3 d-none"></div>
                        <div id="stockWarning" class="alert alert-warning py-2 px-3 mb-3 d-none"></div>
                        <div id="stockPesajesVinculadosInfo" class="alert alert-info py-2 px-3 mb-3 d-none"></div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm stock-table-compact" id="tablaLineasStock">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-right" style="width:120px;">Cantidad</th>
                                        <th class="text-center" style="width:70px;">bal</th>
                                        <th style="width:160px;">Creado</th>
                                        <th style="width:70px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="card bg-light stock-panel-card stock-summary-card">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-2 stock-section-title">Resumen</h6>
                                <div class="d-flex justify-content-between">
                                    <span>Total items</span>
                                    <strong id="totalItems">@Model.CantItems</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Total cantidad</span>
                                    <strong id="totalKg">@Model.TotalKg.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</strong>
                                </div>
                                <hr />
                                <div class="small text-muted">
                                    Acción: <strong id="stockAccionActual">@Model.TipoCompra</strong>
                                </div>
                            </div>
                        </div>
                        <small class="form-text text-muted mt-2" id="txtAyudaCantidad">
                            @(permiteNegativo ? "Puede ingresar valores positivos o negativos según el ajuste o egreso." : "")
                        </small>
                        <div class="card stock-panel-card mt-3">
                            <div class="card-body">
                                <div class="form-group mb-0">
                                    <label for="Observaciones">Observaciones</label>
                                    @Html.TextAreaFor(m => m.Observaciones, 2, 1, new { @class = "form-control js-auto-resize", id = "Observaciones", style = "min-height: calc(1.5em * 2 + 1rem); overflow:hidden; resize:vertical;" })
                                </div>
                            </div>
                        </div>
                        @if (Model.EsEdicion)
                        {
                            <div class="card stock-panel-card mt-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="small text-muted">Creado</div>
                                            <div class="font-weight-bold">@Model.Creado</div>
                                            <div class="small text-muted">@Model.CreadoPor</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="small text-muted">Actualizado</div>
                                            <div class="font-weight-bold">@Model.Actualizado</div>
                                            <div class="small text-muted">@Model.ActualizadoPor</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (Model.EsEdicion)
                    {
                        <button type="button"
                                class="btn btn-primary mr-2 mb-2"
                                id="btnHabilitarEdicionStock"
                                data-edit-readonly-ignore="true"
                                @(Model.PuedeHabilitarEdicion ? "" : "disabled")>
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>
                    }
                    <button type="submit" class="btn btn-success mr-2 mb-2 @(Model.EsEdicion ? "d-none" : "")" id="btnGuardarStock">
                        <i class="fas fa-save mr-1"></i> Guardar stock
                    </button>
                    <a href="@Url.Action("Index", "Stock")" class="btn btn-outline-secondary mb-2">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade modal-stock-compact" id="modalVincularPesajesStock" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Vincular pesajes</h5>
