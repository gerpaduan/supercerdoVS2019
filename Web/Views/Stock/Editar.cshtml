@model Web.Models.StockEditVm
@using System
@using System.Collections.Generic
@using System.Web
@using System.Web.Helpers
@using Entidades

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = Model.EsEdicion ? "Modificar Stock" : "Nuevo Stock";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    bool esPesaje = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.PesajeCortes), StringComparison.OrdinalIgnoreCase);
    bool esAjuste = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.AjusteStock), StringComparison.OrdinalIgnoreCase);
    bool esEgreso = string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.EgresoStock), StringComparison.OrdinalIgnoreCase);
    bool permiteNegativo = esAjuste || esEgreso;
    var modalProductoData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarProductoStock" },
        { "ApiUrl", Url.Action("BuscarCorte", "Stock") },
        { "Titulo", "Buscar Producto de Stock" },
        { "MostrarPrecio", "false" }
    };
}

<div class="container-fluid px-2 px-md-3 stock-page" data-stock-page="1">
    <div id="stockDraftBanner" class="alert alert-warning d-none" role="alert">
        Se encontró un borrador local de este movimiento de stock.
        <button type="button" class="btn btn-sm btn-warning ml-2" data-action="restore-draft">Recuperar</button>
        <button type="button" class="btn btn-sm btn-outline-dark ml-2" data-action="clear-draft">Limpiar borrador</button>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Stock")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.Estado))
        {
            <span class="badge badge-pill @(Model.Estado.Equals("Actualizado", StringComparison.OrdinalIgnoreCase) ? "badge-success" : "badge-warning") px-3 py-2">
                Estado: @Model.Estado
            </span>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form id="formStock" method="post" action="@Url.Action("Guardar", "Stock")" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdCompra)
                @Html.HiddenFor(m => m.TipoCompra)
                @Html.HiddenFor(m => m.IdProveedor)
                @Html.HiddenFor(m => m.DraftKey)
                <div id="lineasHiddenContainer"></div>

                <div class="row">
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="IdSucursal">Sucursal</label>
                            <select id="IdSucursal" name="IdSucursal" class="form-control">
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="FechaCompra">Fecha</label>
                            <input type="datetime-local"
                                   id="FechaCompra"
                                   name="FechaCompra"
                                   class="form-control"
                                   value="@Model.FechaCompra.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="form-group">
                            <label for="TipoCompraVisual">Acción</label>
                            <div class="input-group">
                                <select id="TipoCompraVisual" class="form-control" disabled>
                                    <option value="Ingreso Stock" @(string.Equals(Model.TipoCompra, "Ingreso Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Ingreso</option>
                                    <option value="Egreso Stock" @(string.Equals(Model.TipoCompra, "Egreso Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Egreso</option>
                                    <option value="Cierre Stock" @(string.Equals(Model.TipoCompra, "Cierre Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Cierre</option>
                                    <option value="Ajuste Stock" @(string.Equals(Model.TipoCompra, "Ajuste Stock", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Ajuste</option>
                                    <option value="Pesaje Cortes" @(string.Equals(Model.TipoCompra, "Pesaje Cortes", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Pesaje</option>
                                </select>
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-secondary" id="btnHabilitarTipoCompra" title="Habilitar cambio de acción">
                                        <i class="fas fa-edit mr-1"></i> Cambiar
                                    </button>
                                </div>
                            </div>
                            <small class="form-text text-muted">La acción se desbloquea sólo cuando presiona cambiar.</small>
                        </div>
                    </div>
                </div>

                <div class="row @(esPesaje ? "" : "d-none")" id="bloquePesajeStock">
                        <div class="col-12 col-lg-6">
                            <div class="form-group">
                                <label for="razonSocial">Proveedor</label>
                                <div class="input-group">
                                    <input type="text" id="razonSocial" class="form-control" value="@Model.ProveedorNombre" placeholder="Seleccione un proveedor" readonly />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-primary" id="btnBuscarProveedor" title="Buscar proveedor (F9)">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="btnLimpiarProveedor" title="Limpiar proveedor">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <small class="form-text text-muted" id="lblProveedorCuit">@(!string.IsNullOrWhiteSpace(Model.ProveedorCuit) ? ("CUIT: " + Model.ProveedorCuit) : "Sin proveedor seleccionado")</small>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="form-group">
                                <label for="CantMedias">Cant.Medias</label>
                                <input type="number" id="CantMedias" name="CantMedias" class="form-control" min="1" step="1" value="@(Model.CantMedias.HasValue ? Model.CantMedias.Value.ToString() : "")" />
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="form-group">
                                <label for="KgsMedias">Kgs.Medias</label>
                                <input type="text" id="KgsMedias" name="KgsMedias" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" value="@(Model.KgsMedias.HasValue ? Model.KgsMedias.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                            </div>
                        </div>
                </div>

                <div class="row">
                    <div class="col-12 col-xl-8">
                    </div>
                    <div class="col-12 col-xl-4">
                        @if (Model.EsEdicion)
                        {
                            <div class="row">
                                <div class="col-6">
                                    <div class="small text-muted">Creado</div>
                                    <div class="font-weight-bold">@Model.Creado</div>
                                    <div class="small text-muted">@Model.CreadoPor</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Actualizado</div>
                                    <div class="font-weight-bold">@Model.Actualizado</div>
                                    <div class="small text-muted">@Model.ActualizadoPor</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-12 col-xl-8">
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-0">Agregar producto</h6>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="custom-control custom-switch mr-2">
                                        <input type="checkbox" class="custom-control-input" id="chkBalanzaLinea" checked />
                                        <label class="custom-control-label" for="chkBalanzaLinea">Balanza</label>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVerAcumulados">
                                        <i class="fas fa-layer-group mr-1"></i> Ver acumulados
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary @(string.Equals(Model.TipoCompra, Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.CierreStock), StringComparison.OrdinalIgnoreCase) ? "" : "d-none")" id="btnProductosNoCargados">
                                        <i class="fas fa-list mr-1"></i> Productos no cargados
                                    </button>
                                </div>
                            </div>

                            <div class="row align-items-end">
                                <div class="col-12 col-md-3 col-lg-3">
                                    <div class="form-group">
                                        <label for="txtCodigoProducto">Código</label>
                                        <input type="number" id="txtCodigoProducto" class="form-control" min="0" step="1" autocomplete="off" style="min-width:13ch;" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-5 col-lg-6">
                                    <div class="form-group">
                                        <label for="txtProductoNombre">Producto</label>
                                        <div class="input-group">
                                            <input type="hidden" id="txtProductoId" />
                                            <input type="hidden" id="txtProductoPesable" />
                                            <input type="hidden" id="txtProductoTipo" />
                                            <input type="hidden" id="txtProductoPromedio" />
                                            <input type="text" id="txtProductoNombre" class="form-control" readonly />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnBuscarProducto" title="Buscar producto (F10)">
                                                    <i class="fas fa-search"></i>
                                                    <span class="d-none d-lg-inline ml-1">F10</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-8 col-md-3 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCantKgs" id="lblCantidadStock">Cantidad</label>
                                        <input type="text" id="txtCantKgs" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" style="min-width:8ch;" />
                                    </div>
                                </div>
                                <div class="col-4 col-md-1">
                                    <button type="button" class="btn btn-primary btn-block mb-3 d-flex align-items-center justify-content-center" id="btnAgregarLineaStock" title="Agregar">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="stockFeedback" class="alert alert-success py-2 px-3 mb-3 d-none"></div>
                        <div id="stockWarning" class="alert alert-warning py-2 px-3 mb-3 d-none"></div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="tablaLineasStock">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-right" style="width:120px;">Cantidad</th>
                                        <th class="text-center" style="width:70px;">bal</th>
                                        <th style="width:160px;">Creado</th>
                                        <th style="width:70px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-uppercase text-muted">Resumen</h6>
                                <div class="d-flex justify-content-between">
                                    <span>Total items</span>
                                    <strong id="totalItems">@Model.CantItems</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Total cantidad</span>
                                    <strong id="totalKg">@Model.TotalKg.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</strong>
                                </div>
                                <hr />
                                <div class="small text-muted">
                                    Acción: <strong id="stockAccionActual">@Model.TipoCompra</strong>
                                </div>
                            </div>
                        </div>
                        <small class="form-text text-muted mt-2" id="txtAyudaCantidad">
                            @(permiteNegativo ? "Puede ingresar valores positivos o negativos según el ajuste o egreso." : "")
                        </small>
                        <div class="form-group mt-3 mb-0 col-xl-12 px-0">
                            <label for="Observaciones">Observaciones</label>
                            @Html.TextAreaFor(m => m.Observaciones, 2, 1, new { @class = "form-control js-auto-resize", id = "Observaciones", style = "min-height: calc(1.5em * 2 + 1rem); overflow:hidden; resize:vertical;" })
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    <button type="submit" class="btn btn-success mr-2 mb-2" id="btnGuardarStock">
                        <i class="fas fa-save mr-1"></i> Guardar stock
                    </button>
                    <a href="@Url.Action("Index", "Stock")" class="btn btn-outline-secondary mb-2">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalProductosNoCargadosStock" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-no-cargados-stock" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Productos no cargados</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning py-2 px-3 mb-3" id="stockNoCargadosContexto">
                    <div><strong>Sucursal:</strong> <span id="lblSucursalNoCargadosContexto">@Model.SucursalNombre</span></div>
                    <div><strong>Fecha:</strong> <span id="lblFechaNoCargadosContexto">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="mt-2 mb-0">
                        EstÃ¡ trabajando sobre esta sucursal. Si fue seleccionada por error, el stock actual puede no coincidir y generar diferencias importantes.
                    </div>
                </div>

                <div id="stockNoCargadosWarning" class="alert alert-warning py-2 px-3 mb-3 d-none"></div>
                <div id="stockNoCargadosInfo" class="alert alert-info py-2 px-3 mb-3 d-none"></div>

                <div class="row align-items-end mb-3">
                    <div class="col-12 col-lg-5">
                        <label for="txtBuscarNoCargadosStock">Buscar</label>
                        <input type="text" id="txtBuscarNoCargadosStock" class="form-control" placeholder="Código o descripción" autocomplete="off" />
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="filtroStockNoCargados">Filtro</label>
                        <select id="filtroStockNoCargados" class="form-control">
                            <option value="todos">Todos</option>
                            <option value="con-stock">Con stock</option>
                            <option value="sin-stock">Sin stock</option>
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="small text-muted">Pendientes</div>
                        <div class="font-weight-bold" id="lblPendientesNoCargados">0 productos</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="small text-muted">Seleccionados</div>
                        <div class="font-weight-bold" id="lblSeleccionadosNoCargados">0</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center mb-3 gap-2">
                    <button type="button" class="btn btn-success mr-2 mb-2" id="btnAgregarNoCargadosStockActual">
                        <i class="fas fa-plus mr-1"></i> Agregar con stock actual
                    </button>
                    <button type="button" class="btn btn-outline-secondary mb-2" id="btnAgregarNoCargadosSinStock">
                        <i class="fas fa-minus-circle mr-1"></i> Agregar como sin stock (0,000)
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" id="tablaNoCargadosStock">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:55px;" class="text-center">
                                    <input type="checkbox" id="chkSeleccionarTodosNoCargados" />
                                </th>
                                <th style="width:120px;">Código</th>
                                <th>Producto / Descripción</th>
                                <th class="text-right" style="width:130px;">Stock actual</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAcumuladosStock" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Acumulados del stock</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:120px;">Código</th>
                                <th>Producto</th>
                                <th class="text-right" style="width:120px;">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyAcumuladosStock"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="contenedorModalPersonaStock"></div>
@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", modalProductoData)

@section Scripts {
    <style>
        @@media (min-width: 992px) {
            .modal-no-cargados-stock {
                max-width: 50vw;
            }
        }

        #tablaNoCargadosStock tbody tr {
            cursor: pointer;
        }

        #tablaNoCargadosStock tbody tr:nth-child(even) {
            background-color: #fafafa;
        }

        #tablaNoCargadosStock tbody tr + tr td {
            border-top: 1px solid #e9ecef;
        }
    </style>
    <script src="@Url.Content("~/Scripts/app/stock.js?v=15")"></script>
    <script>
        (function () {
            if (!window.StockUI || typeof window.StockUI.init !== "function") {
                return;
            }

            window.StockUI.init({
                formSelector: "#formStock",
                modalProductoSelector: "#modalBuscarProductoStock",
                initialLines: @Html.Raw(Json.Encode(Model.Lineas ?? new List<Web.Models.StockLineaVm>())),
                tipoCompra: "@Model.TipoCompra",
                draftKey: "@Model.DraftKey",
                permiteCantidadNegativa: @(permiteNegativo ? "true" : "false"),
                esEgreso: @(esEgreso ? "true" : "false"),
                esPesaje: @(esPesaje ? "true" : "false"),
                balanzaUrl: "http://localhost:5100/peso",
                proveedorDefaultId: @Model.IdProveedor,
                proveedorDefaultNombre: "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ProveedorNombre ?? ""))",
                proveedorDefaultCuit: "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ProveedorCuit ?? ""))",
                urls: {
                    buscarCorte: "@Url.Action("BuscarCorte", "Stock")",
                    buscarCortePorCodigo: "@Url.Action("BuscarCortePorCodigo", "Stock")",
                    productosNoCargadosCierre: "@Url.Action("ProductosNoCargadosCierre", "Stock")",
                    personaBuscarModal: "@ViewBag.UrlBuscarPersonaModal",
                    personaListar: "@ViewBag.UrlPersonaListar"
                }
            });
        })();
    </script>
}
