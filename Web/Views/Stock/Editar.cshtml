            background-color: #fafafa;
        }

        #tablaNoCargadosStock tbody tr + tr td {
            border-top: 1px solid #e9ecef;
        }

        #tablaPorcCortesStock tbody tr:last-child {
            font-weight: 700;
            background-color: #f8f9fa;
        }

        html:not(.dark-mode) #btnVincularPesajes:hover,
        html:not(.dark-mode) #btnVincularPesajes:focus,
        body:not(.dark-mode) #btnVincularPesajes:hover,
        body:not(.dark-mode) #btnVincularPesajes:focus {
            background-color: #17a2b8;
            border-color: #17a2b8;
            color: #fff;
        }

        html.dark-mode #tablaPorcCortesStock tbody tr:last-child td,
        body.dark-mode #tablaPorcCortesStock tbody tr:last-child td {
            background-color: #2f3541;
            color: #f8f9fc;
        }
    </style>
    @* Este modo no pasa por _LayoutBase.cshtml, asi que scanner.js/ZXing no estan
       cargados todavia: se agregan aca para que el boton de escanear funcione
       igual que en el modo con layout completo. *@
    <script src="@Url.Content("~/Content/vendor/zxing/zxing.min.js")"></script>
    <script src="@Url.Content("~/Scripts/app/scanner.js")"></script>
    <script src="@Url.Content("~/Scripts/carnisys.balanza.js?v=6")"></script>
    <script src="@Url.Content("~/Scripts/app/stock.js?v=36")"></script>
    <script src="@Url.Content("~/Scripts/app/barcode-code-input.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/busqueda-feedback.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/edit-page-guard.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=3")"></script>
    <script>
        (function () {
            if (!window.StockUI || typeof window.StockUI.init !== "function") {
                return;
            }

            // La vista puede entrar por AJAX; por eso la inicialización queda inline, igual que en otras pantallas modales.
            window.StockUI.init({
                formSelector: "#formStock",
                modalProductoSelector: "#modalBuscarProductoStock",
                initialLines: @Html.Raw(Json.Encode(Model.Lineas ?? new List<Web.Models.StockLineaVm>())),
                tipoCompra: "@Model.TipoCompra",
                draftKey: "@Model.DraftKey",
                permiteCantidadNegativa: @(permiteNegativo ? "true" : "false"),
                esEgreso: @(esEgreso ? "true" : "false"),
                esPesaje: @(esPesaje ? "true" : "false"),
                balanzaUrl: "http://localhost:5100/peso",
                proveedorDefaultId: @Model.IdProveedor,
                proveedorDefaultNombre: "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ProveedorNombre ?? ""))",
                proveedorDefaultCuit: "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ProveedorCuit ?? ""))",
                urls: {
                    buscarCorte: "@Url.Action("BuscarCorte", "Stock")",
                    buscarCortePorCodigo: "@Url.Action("BuscarCortePorCodigo", "Stock")",
                    ultimasComprasPesaje: "@Url.Action("UltimasComprasPesaje", "Stock")",
                    ultimosPesajesVinculables: "@Url.Action("UltimasComprasPesaje", "Stock")",
                    detalleCompraPesaje: "@Url.Action("DetalleCompraPesaje", "Stock")",
                    verPorcentajesPesaje: "@Url.Action("VerPorcentajesPesaje", "Stock")",
                    generarAjustePesaje: "@Url.Action("GenerarAjustePesaje", "Stock")",
                    productosNoCargadosCierre: "@Url.Action("ProductosNoCargadosCierre", "Stock")",
                    personaBuscarModal: "@ViewBag.UrlBuscarPersonaModal",
                    personaListar: "@ViewBag.UrlPersonaListar"
                }
            });

            window.EditReadOnly && window.EditReadOnly.init({
                formSelector: "#formStock",
                soloLecturaInicial: @(Model.SoloLecturaInicial ? "true" : "false"),
                modifyButtonSelector: "#btnHabilitarEdicionStock",
                saveButtonSelector: "#btnGuardarStock",
                onStateChanged: function (readOnly, $form) {
                    if (window.StockUI && typeof window.StockUI.syncPrimaryAction === "function") {
                        window.StockUI.syncPrimaryAction($form);
                    }
                }
            });

            // Escanear codigo de barra: pisa #txtCodigoProducto y dispara el mismo
            // Enter que ya usa la busqueda manual (stock.js), asi reusa la logica
            // existente de buscar producto + foco en Cantidad sin duplicarla.
            window.BarcodeCodeInput && window.BarcodeCodeInput.attach({
