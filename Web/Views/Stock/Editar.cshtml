@if (renderInlineScripts)
{
    <style>
        @@media (min-width: 992px) {
            .modal-no-cargados-stock {
                max-width: 50vw;
            }
        }

        #tablaNoCargadosStock tbody tr {
            cursor: pointer;
        }

