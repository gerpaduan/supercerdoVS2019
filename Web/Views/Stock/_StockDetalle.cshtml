@model Web.Models.CompraIndexDetalleVm
@using System

@{
    string detalleError = ViewBag.StockDetalleError as string ?? "";
}

@if (!string.IsNullOrWhiteSpace(detalleError))
{
    <div class="text-danger">@detalleError</div>
}
else if (Model == null)
{
    <div class="text-muted">No se pudieron cargar los detalles del movimiento.</div>
}
else
{
    var referenciaPesaje = Model.IdPesajeRelacionado.HasValue ? Model.IdPesajeRelacionado.Value.ToString() : "";
    var referenciaAjuste = Model.IdAjusteRelacionado.HasValue ? Model.IdAjusteRelacionado.Value.ToString() : "";
    var observaciones = !string.IsNullOrWhiteSpace(Model.Observaciones) ? Model.Observaciones : "-";
    var usuarioCreacion = !string.IsNullOrWhiteSpace(Model.UsuarioCreacion) ? Model.UsuarioCreacion : "-";
    var fechaCreacion = Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var usuarioActualizacion = !string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) ? Model.UsuarioActualizacion : "-";
    var fechaActualizacion = Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var sucursalDetalle = !string.IsNullOrWhiteSpace(Model.Sucursal) ? Model.Sucursal : "-";
    var tipoDetalle = !string.IsNullOrWhiteSpace(Model.TipoCompra) ? Model.TipoCompra : "-";

    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="mb-2"><span class="text-muted">ID del registro:</span> <span class="font-weight-bold">@Model.IdCompra</span></div>
            @if (Model.EsPesaje && Model.IdAjusteRelacionado.HasValue)
            {
                <div class="mb-2">
                    <span class="text-muted">Referencia:</span>
                    <span class="badge badge-pill badge-success ml-2">Aj. #@referenciaAjuste</span>
                </div>
            }
            else if (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue)
            {
                <div class="mb-2">
                    <span class="text-muted">Referencia:</span>
                    <span class="badge badge-pill badge-info">Pesaje #@referenciaPesaje</span>
                </div>
            }
            <div class="mb-2"><span class="text-muted">Observaciones:</span> <span class="font-weight-bold">@observaciones</span></div>
            <div class="mb-2"><span class="text-muted">Quién lo creó:</span> <span class="font-weight-bold">@usuarioCreacion</span></div>
            <div class="mb-2"><span class="text-muted">Fecha de creación:</span> <span class="font-weight-bold">@fechaCreacion</span></div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="mb-2"><span class="text-muted">Quién lo actualizó:</span> <span class="font-weight-bold">@usuarioActualizacion</span></div>
            <div class="mb-2"><span class="text-muted">Fecha de actualización:</span> <span class="font-weight-bold">@fechaActualizacion</span></div>
            <div class="mb-2"><span class="text-muted">Sucursal:</span> <span class="font-weight-bold">@sucursalDetalle</span></div>
            <div class="mb-2"><span class="text-muted">Acción:</span> <span class="font-weight-bold">@tipoDetalle</span></div>
        </div>
    </div>
    if (Model.EsPesaje && Model.IdCompraVinculada.HasValue && Model.IdCompraVinculada.Value > 0)
    {
        <div class="stock-relacionado-box stock-relacionado-compra mt-3">
            <div class="small text-uppercase font-weight-bold mb-2">Compra vinculada #@Model.IdCompraVinculada.Value</div>
            @if (!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada))
            {
                <div class="font-weight-bold">@Model.EstadoCompraVinculada</div>
            }
            else
            {
                <div class="row">
                    <div class="col-12 col-md-3 mb-2 mb-md-0">
                        <div class="text-muted">Fecha de compra</div>
                        <div class="font-weight-bold">@(Model.FechaCompraVinculada.HasValue ? Model.FechaCompraVinculada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                    </div>
                    <div class="col-12 col-md-4 mb-2 mb-md-0">
                        <div class="text-muted">Proveedor</div>
                        <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorCompraVinculada) ? Model.ProveedorCompraVinculada : "-")</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted">Cant.Medias</div>
                        <div class="font-weight-bold">@(Model.CantMediasCompraVinculada.HasValue ? Model.CantMediasCompraVinculada.Value.ToString() : "-")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Kgs.Medias</div>
                        <div class="font-weight-bold">@(Model.KgsCompraVinculada.HasValue ? Model.KgsCompraVinculada.Value.ToString("N2") : "-")</div>
                    </div>
                </div>
            }
        </div>
    }
    if (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue && Model.IdPesajeRelacionado.Value > 0)
    {
        <div class="stock-relacionado-box stock-relacionado-pesaje mt-3">
            <div class="small text-uppercase font-weight-bold mb-2">Pesaje asociado #@Model.IdPesajeRelacionado.Value</div>
            @if (!string.IsNullOrWhiteSpace(Model.EstadoPesajeRelacionado))
            {
                <div class="font-weight-bold">@Model.EstadoPesajeRelacionado</div>
            }
            else
            {
                <div class="row">
                    <div class="col-12 col-md-3 mb-2 mb-md-0">
                        <div class="text-muted">Fecha del pesaje</div>
                        <div class="font-weight-bold">@(Model.FechaPesajeRelacionado.HasValue ? Model.FechaPesajeRelacionado.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                    </div>
                    <div class="col-12 col-md-4 mb-2 mb-md-0">
                        <div class="text-muted">Proveedor</div>
                        <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorPesajeRelacionado) ? Model.ProveedorPesajeRelacionado : "-")</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted">Cant.Medias</div>
                        <div class="font-weight-bold">@(Model.CantMediasPesajeRelacionado.HasValue ? Model.CantMediasPesajeRelacionado.Value.ToString() : "-")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Kgs.Medias</div>
                        <div class="font-weight-bold">@(Model.KgsPesajeRelacionado.HasValue ? Model.KgsPesajeRelacionado.Value.ToString("N2") : "-")</div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="table-responsive mt-3">
        <table class="table table-sm table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Código producto</th>
                    <th>Producto</th>
                    <th class="text-right">Cantidad / kg</th>
                    <th class="text-center">Balanza</th>
                    <th>Creado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lineas == null || Model.Lineas.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay líneas para este movimiento.</td>
                    </tr>
                }
                else
                {
                    foreach (var linea in Model.Lineas)
                    {
                        <tr>
                            <td>@linea.Codigo</td>
                            <td>@linea.Producto</td>
                            <td class="text-right">@linea.CantidadKgTexto</td>
                            <td class="text-center">@(linea.Balanza ? "Si" : "-")</td>
                            <td>@(!string.IsNullOrWhiteSpace(linea.CreadoTexto) ? linea.CreadoTexto : "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
