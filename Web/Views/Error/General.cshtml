@{
    Layout = null;
    string requestedUrl = ViewBag.RequestedUrl as string ?? "";
    string errorType = ViewBag.ErrorType as string ?? "";
    string errorMessage = ViewBag.ErrorMessage as string ?? "";
    string innerErrorType = ViewBag.InnerErrorType as string ?? "";
    string innerErrorMessage = ViewBag.InnerErrorMessage as string ?? "";
    string errorStack = ViewBag.ErrorStack as string ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error inesperado</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8f9fc;
            color: #212529;
        }

        .error-wrap {
            max-width: 760px;
            margin: 60px auto;
            padding: 0 16px;
        }

        .error-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
            padding: 32px 24px;
            text-align: center;
        }

        .error-code {
            font-size: 48px;
            font-weight: 700;
            color: #c92a2a;
            margin-bottom: 8px;
        }

        .error-title {
            margin: 0 0 12px;
            font-size: 28px;
        }

        .error-text {
            margin: 0 0 20px;
            color: #495057;
            line-height: 1.5;
        }

        .error-url {
            margin: 0 0 24px;
            padding: 10px 12px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            color: #6c757d;
            word-break: break-word;
        }

        .error-actions a {
            display: inline-block;
            margin: 0 6px 8px;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
        }

        .error-detail {
            margin: 0 0 24px;
            padding: 12px 14px;
            background: #fff5f5;
            border: 1px solid #f1aeb5;
            border-radius: 8px;
            color: #842029;
            text-align: left;
            word-break: break-word;
        }

        .error-detail pre {
            margin: 8px 0 0;
            white-space: pre-wrap;
            font-size: 12px;
            line-height: 1.4;
        }

        .btn-primary {
            background: #0d6efd;
            color: #fff;
        }

        .btn-secondary {
            border: 1px solid #ced4da;
            color: #495057;
            background: #fff;
        }
    </style>
</head>
<body>
    <div class="error-wrap">
        <div class="error-card">
            <div class="error-code">500</div>
            <h1 class="error-title">Ocurrio un error al procesar la solicitud</h1>
            <p class="error-text">
                Intenta nuevamente en unos instantes. Si el problema continua, vuelve al inicio e intenta retomar la operacion.
            </p>
            @if (!string.IsNullOrWhiteSpace(requestedUrl))
            {
                <div class="error-url">@requestedUrl</div>
            }
            @if (!string.IsNullOrWhiteSpace(errorMessage) || !string.IsNullOrWhiteSpace(innerErrorMessage))
            {
                <div class="error-detail">
                    @if (!string.IsNullOrWhiteSpace(errorType) || !string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div><strong>Error:</strong> @(string.IsNullOrWhiteSpace(errorType) ? errorMessage : errorType + " - " + errorMessage)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(innerErrorType) || !string.IsNullOrWhiteSpace(innerErrorMessage))
                    {
                        <div style="margin-top:8px;"><strong>Inner:</strong> @(string.IsNullOrWhiteSpace(innerErrorType) ? innerErrorMessage : innerErrorType + " - " + innerErrorMessage)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorStack))
                    {
                        <pre>@errorStack</pre>
                    }
                </div>
            }
            <div class="error-actions">
                <a href="@Url.Content("~/")" class="btn-primary">Ir al inicio</a>
                <a href="javascript:history.back()" class="btn-secondary">Volver</a>
            </div>
        </div>
    </div>
</body>
</html>
