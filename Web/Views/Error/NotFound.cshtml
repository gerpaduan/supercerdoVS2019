@{
    Layout = null;
    string requestedUrl = ViewBag.RequestedUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>URL no encontrada</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8f9fc;
            color: #212529;
        }

        .notfound-wrap {
            max-width: 760px;
            margin: 60px auto;
            padding: 0 16px;
        }

        .notfound-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
            padding: 32px 24px;
            text-align: center;
        }

        .notfound-code {
            font-size: 48px;
            font-weight: 700;
            color: #d39e00;
            margin-bottom: 8px;
        }

        .notfound-title {
            margin: 0 0 12px;
            font-size: 28px;
        }

        .notfound-text {
            margin: 0 0 20px;
            color: #495057;
            line-height: 1.5;
        }

        .notfound-url {
            margin: 0 0 24px;
            padding: 10px 12px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            color: #6c757d;
            word-break: break-word;
        }

        .notfound-actions a {
            display: inline-block;
            margin: 0 6px 8px;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
        }

        .btn-primary {
            background: #0d6efd;
            color: #fff;
        }

        .btn-secondary {
            border: 1px solid #ced4da;
            color: #495057;
            background: #fff;
        }
    </style>
</head>
<body>
    <div class="notfound-wrap">
        <div class="notfound-card">
            <div class="notfound-code">404</div>
            <h1 class="notfound-title">La URL solicitada no existe</h1>
            <p class="notfound-text">
                La direccion que intentaste abrir no fue encontrada o ya no esta disponible.
            </p>
            @if (!string.IsNullOrWhiteSpace(requestedUrl))
            {
                <div class="notfound-url">@requestedUrl</div>
            }
            <div class="notfound-actions">
                <a href="/" class="btn-primary">Ir al inicio</a>
                <a href="javascript:history.back()" class="btn-secondary">Volver</a>
            </div>
        </div>
    </div>
</body>
</html>
