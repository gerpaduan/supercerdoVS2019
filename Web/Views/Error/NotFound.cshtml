@{
    Layout = null;
    string requestedUrl = ViewBag.RequestedUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recurso no encontrado</title>
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/css/sb-admin-2.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow border-0">
                    <div class="card-body p-5 text-center">
                        <div class="display-4 text-warning mb-3">
                            <i class="fas fa-search"></i>
                        </div>
                        <h1 class="h3 text-gray-900 mb-3">No encontramos lo que buscabas</h1>
                        <p class="text-muted mb-4">
                            El recurso solicitado no existe, cambió de ubicación o ya no está disponible.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(requestedUrl))
                        {
                            <p class="small text-muted mb-4">@requestedUrl</p>
                        }
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mr-2">
                            Ir al inicio
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            Volver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
