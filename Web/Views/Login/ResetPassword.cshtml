@model Web.Models.PasswordResetVm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>CarniSysWeb - Restablecer contraseña</title>
    <link href="@Url.Content("~/Content/vendor/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/sb-admin-2.min.css")" rel="stylesheet" />
</head>
<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-5">
                        <h1 class="h4 text-gray-900 mb-3">Restablecer contraseña</h1>

                        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                        {
                            <div class="alert alert-warning">
                                @Model.Mensaje
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        @if (!Model.TokenValido)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("ForgotPassword", "Login")">Solicitar un nuevo enlace</a>
                            </div>
                        }
                        else
                        {
                            using (Html.BeginForm("ResetPassword", "Login", FormMethod.Post, new { novalidate = "novalidate" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Token)

                                <div class="form-group">
                                    @Html.PasswordFor(
                                        m => m.NuevaClave,
                                        new
                                        {
                                            @class = "form-control form-control-user",
                                            placeholder = "Nueva contraseña",
                                            autocomplete = "new-password"
                                        })
                                    @Html.ValidationMessageFor(m => m.NuevaClave, "", new { @class = "text-danger small d-block mt-1" })
                                </div>

                                <div class="form-group">
                                    @Html.PasswordFor(
                                        m => m.ConfirmarClave,
                                        new
                                        {
                                            @class = "form-control form-control-user",
                                            placeholder = "Confirmar contraseña",
                                            autocomplete = "new-password"
                                        })
                                    @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "text-danger small d-block mt-1" })
                                </div>

                                <div class="small text-muted mb-3">
                                    Recomendación de seguridad: usá una contraseña larga, con mayúsculas, minúsculas, números y, si querés, símbolos. Igualmente podés guardar una clave de 1 o más caracteres.
                                </div>

                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    Guardar nueva contraseña
                                </button>
                            }
                        }

                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Login")">Volver al login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
</body>
</html>
