@model Web.Models.UnlockAccountVm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>CarniSysWeb - Desbloquear cuenta</title>
    <link href="@Url.Content("~/Content/vendor/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/sb-admin-2.min.css")" rel="stylesheet" />
</head>
<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-5">
                        <h1 class="h4 text-gray-900 mb-3">Desbloquear cuenta</h1>

                        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                        {
                            <div class="alert alert-warning">
                                @Model.Mensaje
                            </div>
                        }

                        @if (!Model.TokenValido)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("Index", "Login")">Volver al login</a>
                            </div>
                        }
                        else
                        {
                            <p class="text-gray-600">Tu cuenta se bloqueó por varios intentos fallidos de contraseña. Hacé clic en el botón para desbloquearla.</p>

                            using (Html.BeginForm("UnlockAccount", "Login", FormMethod.Post, new { novalidate = "novalidate" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Token)

                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    Desbloquear mi cuenta
                                </button>
                            }

                            <div class="text-center mt-3">
                                <a href="@Url.Action("Index", "Login")">Volver al login</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
</body>
</html>
