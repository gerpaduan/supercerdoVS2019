@model Web.Models.LoginIndexVm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>CarniSysWeb - Login</title>
    <link href="@Url.Content("~/Content/vendor/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/sb-admin-2.min.css")" rel="stylesheet" />
    <style>
        .login-logo {
            width: 100%;
            max-width: 100%;
            display: block;
            margin-bottom: 20px;
        }

        .login-links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .login-links a {
            font-size: .9rem;
        }

        .location-status {
            border-radius: 12px;
            padding: .85rem 1rem;
            margin-bottom: 1rem;
            font-size: .9rem;
            border: 1px solid #d1d3e2;
            background: #f8f9fc;
            color: #5a5c69;
        }

        .location-status.ok {
            background: #edfdf3;
            border-color: #b7ebc6;
            color: #1e7e34;
        }

        .location-status.warn {
            background: #fff8e1;
            border-color: #ffe08a;
            color: #8a6d1d;
        }

        .location-status.error {
            background: #fff0f0;
            border-color: #f5b5b5;
            color: #a61e1e;
        }
    </style>
</head>
<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-5">
                        <img src="@Url.Content("~/Content/img/CarniSys_Login.png")" alt="Logo" class="login-logo" />
                        <h1 class="h4 text-gray-900 mb-4">Iniciar sesión</h1>

                        @if (!string.IsNullOrWhiteSpace(Model.Success))
                        {
                            <div class="alert alert-success">
                                @Model.Success
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Error))
                        {
                            <div class="alert alert-danger">
                                @Model.Error
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { @class = "user", novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.ReturnUrl)
                            @Html.HiddenFor(m => m.Latitud, new { id = "Latitud" })
                            @Html.HiddenFor(m => m.Longitud, new { id = "Longitud" })
                            @Html.HiddenFor(m => m.PrecisionMetros, new { id = "PrecisionMetros" })

                            <div id="locationStatus" class="location-status warn">
                                Detectando ubicaciÃ³n del dispositivo. Si tu sucursal exige validaciÃ³n, vas a necesitar permitir el acceso a la ubicaciÃ³n.
                            </div>

                            <div class="form-group">
                                @Html.TextBoxFor(
                                    m => m.Usuario,
                                    new
                                    {
                                        @class = "form-control form-control-user",
                                        placeholder = "Usuario o Email",
                                        autocomplete = "username"
                                    })
                                @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger small d-block mt-1" })
                            </div>

                            <div class="form-group">
                                @Html.PasswordFor(
                                    m => m.Clave,
                                    new
                                    {
                                        @class = "form-control form-control-user",
                                        placeholder = "Contraseña",
                                        autocomplete = "current-password"
                                    })
                                @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger small d-block mt-1" })
                            </div>

                            <button type="submit" class="btn btn-primary btn-user btn-block">
                                Ingresar
                            </button>

                            <div class="login-links">
                                <a href="@Url.Action("ForgotPassword", "Login")">Olvidé mi contraseña</a>
                                <span class="text-muted small">Acceso seguro</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        (function () {
            var status = document.getElementById("locationStatus");
            var latitud = document.getElementById("Latitud");
            var longitud = document.getElementById("Longitud");
            var precision = document.getElementById("PrecisionMetros");

            function setStatus(css, message) {
                if (!status) {
                    return;
                }

                status.className = "location-status " + css;
                status.textContent = message;
            }

            function setCoordinates(position) {
                if (!position || !position.coords) {
                    setStatus("error", "No fue posible obtener la ubicaciÃ³n del dispositivo. Si tu sucursal la requiere, habilitala e intentÃ¡ nuevamente.");
                    return;
                }

                latitud.value = typeof position.coords.latitude === "number"
                    ? position.coords.latitude.toFixed(7)
                    : "";
                longitud.value = typeof position.coords.longitude === "number"
                    ? position.coords.longitude.toFixed(7)
                    : "";
                precision.value = typeof position.coords.accuracy === "number"
                    ? position.coords.accuracy.toFixed(2)
                    : "";

                var mensaje = "UbicaciÃ³n detectada correctamente.";
                if (precision.value) {
                    mensaje += " PrecisiÃ³n aproximada: " + precision.value + " metros.";
                }

                setStatus("ok", mensaje);
            }

            function onError(error) {
                var mensaje = "No fue posible obtener la ubicaciÃ³n del dispositivo.";

                if (error && error.code === 1) {
                    mensaje = "La ubicaciÃ³n fue bloqueada. Si tu sucursal exige validaciÃ³n, debÃ©s permitir la ubicaciÃ³n para iniciar sesiÃ³n.";
                } else if (error && error.code === 2) {
                    mensaje = "La ubicaciÃ³n no estÃ¡ disponible en este momento. IntentÃ¡ nuevamente.";
                } else if (error && error.code === 3) {
                    mensaje = "La detecciÃ³n de ubicaciÃ³n demorÃ³ demasiado. IntentÃ¡ nuevamente.";
                }

                setStatus("error", mensaje);
            }

            if (!window.isSecureContext) {
                setStatus("warn", "La geolocalizaciÃ³n del navegador puede requerir HTTPS. Si tu sucursal exige validaciÃ³n, usÃ¡ el sitio en un contexto seguro.");
            }

            if (!navigator.geolocation) {
                setStatus("error", "Este navegador no soporta geolocalizaciÃ³n. Si tu sucursal exige validaciÃ³n, necesitÃ¡s usar un navegador compatible.");
                return;
            }

            navigator.geolocation.getCurrentPosition(
                setCoordinates,
                onError,
                {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                });
        })();
    </script>
</body>
</html>
