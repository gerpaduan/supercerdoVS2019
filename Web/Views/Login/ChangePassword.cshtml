@model Web.Models.ChangePasswordVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = "Cambiar clave";
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7 col-md-9">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cambiar clave</h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Success))
                {
                    <div class="alert alert-success">
                        @Model.Success
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false)
                    </div>
                }

                @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post, new { novalidate = "novalidate", id = "formChangePassword" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        @Html.LabelFor(m => m.ClaveActual)
                        @Html.PasswordFor(
                            m => m.ClaveActual,
                            new
                            {
                                @class = "form-control",
                                autocomplete = "current-password"
                            })
                        @Html.ValidationMessageFor(m => m.ClaveActual, "", new { @class = "text-danger small d-block mt-1" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.NuevaClave)
                        @Html.PasswordFor(
                            m => m.NuevaClave,
                            new
                            {
                                @class = "form-control",
                                autocomplete = "new-password"
                            })
                        @Html.ValidationMessageFor(m => m.NuevaClave, "", new { @class = "text-danger small d-block mt-1" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ConfirmarClave)
                        @Html.PasswordFor(
                            m => m.ConfirmarClave,
                            new
                            {
                                @class = "form-control",
                                autocomplete = "new-password"
                            })
                        @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "text-danger small d-block mt-1" })
                    </div>

                    <div class="small text-muted mb-3">
                        La nueva contraseña no puede contener espacios en blanco.
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-link pl-0">Volver</a>
                        <button type="submit" class="btn btn-primary" id="btnGuardarChangePassword">
                            Guardar nueva clave
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        window.EditPageGuard && window.EditPageGuard.init({
            formSelector: "#formChangePassword",
            saveButtonSelector: "#btnGuardarChangePassword"
        });
    </script>
}
