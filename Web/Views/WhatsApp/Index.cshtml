@model Web.Models.WhatsAppConfiguracionVm

@{
    ViewBag.Title = "WhatsApp";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    var mensajesValidacion = ViewData.ModelState.Values
        .SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();
}

<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Configuración de WhatsApp</h1>
            <p class="text-muted mb-0">Parámetros por empresa para integrar WhatsApp Cloud API oficial de Meta.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (mensajesValidacion.Any())
            {
                <div class="alert alert-danger">
                    <ul class="mb-0 pl-3">
                        @foreach (var mensaje in mensajesValidacion)
                        {
                            <li>@mensaje</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MensajePermiso))
            {
                <div class="alert alert-info">
                    @Model.MensajePermiso
                </div>
            }

            @using (Html.BeginForm("Guardar", "WhatsApp", FormMethod.Post, new { id = "formWhatsApp", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdConfiguracionWhatsApp)
                @Html.HiddenFor(m => m.IdEmpresa)

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>IdEmpresa</label>
                        <input type="text" class="form-control" value="@Model.IdEmpresa" readonly="readonly" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Estado</label>
                        <div class="custom-control custom-switch mt-2">
                            @Html.CheckBoxFor(m => m.Activo, new { @class = "custom-control-input", id = "Activo" })
                            <label class="custom-control-label" for="Activo">Habilitar integración</label>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(m => m.MetaApiVersion)
                        @Html.TextBoxFor(m => m.MetaApiVersion, new { @class = "form-control", autocomplete = "off", placeholder = "v22.0" })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(m => m.PhoneNumberId)
                        @Html.TextBoxFor(m => m.PhoneNumberId, new { @class = "form-control", autocomplete = "off" })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(m => m.BusinessAccountId)
                        @Html.TextBoxFor(m => m.BusinessAccountId, new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.AccessToken)
                    @Html.TextAreaFor(m => m.AccessToken, 5, 20, new { @class = "form-control", autocomplete = "off", spellcheck = "false" })
                    <small class="form-text text-muted">Se guarda por empresa y se usará en las próximas etapas para enviar documentos por la API oficial.</small>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    <button type="button"
                            class="btn btn-primary mr-2 mb-2"
                            id="btnHabilitarEdicionWhatsApp"
                            data-edit-readonly-ignore="true">
                        <i class="fas fa-edit mr-1"></i> Modificar
                    </button>

                    <button type="submit"
                            class="btn btn-success mr-2 mb-2 @(Model.SoloLecturaInicial ? "d-none" : "")"
                            id="btnGuardarWhatsApp">
                        <i class="fas fa-save mr-1"></i> Guardar
                    </button>

                    <a class="btn btn-outline-secondary mb-2" href="@Url.Action("Index", "Home")">
                        Volver
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=1")"></script>
    <script>
        window.EditReadOnly && window.EditReadOnly.init({
            formSelector: "#formWhatsApp",
            soloLecturaInicial: @(Model.SoloLecturaInicial ? "true" : "false"),
            modifyButtonSelector: "#btnHabilitarEdicionWhatsApp",
            saveButtonSelector: "#btnGuardarWhatsApp"
        });
    </script>
}
