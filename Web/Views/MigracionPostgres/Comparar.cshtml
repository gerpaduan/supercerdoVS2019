@model Web.Models.ComparacionPersonaVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Persona #@ViewBag.IdPersonaBuscada</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 2) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no la deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>idPersona</th><td>@Model.SqlServer.IdPersona</td></tr>
                        <tr><th>idEmpresa</th><td>@Model.SqlServer.IdEmpresa</td></tr>
                        <tr><th>RazonSocial</th><td>@Model.SqlServer.RazonSocial</td></tr>
                        <tr><th>Identificacion</th><td>@Model.SqlServer.Identificacion</td></tr>
                        <tr><th>Cuit</th><td>@Model.SqlServer.Cuit</td></tr>
                        <tr><th>Email</th><td>@Model.SqlServer.Email</td></tr>
                        <tr><th>Iva</th><td>@Model.SqlServer.Iva</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no la deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>idPersona</th><td>@Model.Postgres.IdPersona</td></tr>
                        <tr><th>idEmpresa</th><td>@Model.Postgres.IdEmpresa</td></tr>
                        <tr><th>RazonSocial</th><td>@Model.Postgres.RazonSocial</td></tr>
                        <tr><th>Identificacion</th><td>@Model.Postgres.Identificacion</td></tr>
                        <tr><th>Cuit</th><td>@Model.Postgres.Cuit</td></tr>
                        <tr><th>Email</th><td>@Model.Postgres.Email</td></tr>
                        <tr><th>Iva</th><td>@Model.Postgres.Iva</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idPersona:</label>
    <input type="number" name="idPersona" class="form-control mr-2" style="width:120px" value="@ViewBag.IdPersonaBuscada" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
