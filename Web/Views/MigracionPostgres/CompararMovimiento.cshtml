@model Web.Models.ComparacionMovimientoVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Movimiento #@ViewBag.IdMovimientoBuscado</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 11b) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null || Model.SqlServer.IdMovimiento == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdMovimiento</th><td>@Model.SqlServer.IdMovimiento</td></tr>
                        <tr><th>FechaMovimiento</th><td>@Model.SqlServer.FechaMovimiento</td></tr>
                        <tr><th>SucursalOrigen</th><td>@(Model.SqlServer.SucursalOrigen?.sucursal) (id @(Model.SqlServer.SucursalOrigen?.idSucursal))</td></tr>
                        <tr><th>SucursalDestino</th><td>@(Model.SqlServer.SucursalDestino?.sucursal) (id @(Model.SqlServer.SucursalDestino?.idSucursal))</td></tr>
                        <tr><th>IdMovOrigen</th><td>@Model.SqlServer.IdMovOrigen</td></tr>
                        <tr><th>Observaciones</th><td>@Model.SqlServer.Observaciones</td></tr>
                        <tr><th>Creado</th><td>@Model.SqlServer.Creado</td></tr>
                        <tr><th>Actualizado</th><td>@Model.SqlServer.Actualizado</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.SqlServer.CreadoPor?.Nombre)</td></tr>
                        <tr><th>ActualizadoPor</th><td>@(Model.SqlServer.ActualizadoPor?.Nombre)</td></tr>
                        <tr>
                            <th>ListaCortesPorMov</th>
                            <td>
                                @if (Model.SqlServer.ListaCortesPorMov != null)
                                {
                                    foreach (var c in Model.SqlServer.ListaCortesPorMov)
                                    {
                                        <div>@(c.Corte?.corte): @c.CantKg kg / @c.CantUnidad un @(c.PesoBalanza ? "(balanza)" : "")</div>
                                    }
                                }
                            </td>
                        </tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.IdMovimiento == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdMovimiento</th><td>@Model.Postgres.IdMovimiento</td></tr>
                        <tr><th>FechaMovimiento</th><td>@Model.Postgres.FechaMovimiento</td></tr>
                        <tr><th>SucursalOrigen</th><td>@(Model.Postgres.SucursalOrigen?.sucursal) (id @(Model.Postgres.SucursalOrigen?.idSucursal))</td></tr>
                        <tr><th>SucursalDestino</th><td>@(Model.Postgres.SucursalDestino?.sucursal) (id @(Model.Postgres.SucursalDestino?.idSucursal))</td></tr>
                        <tr><th>IdMovOrigen</th><td>@Model.Postgres.IdMovOrigen</td></tr>
                        <tr><th>Observaciones</th><td>@Model.Postgres.Observaciones</td></tr>
                        <tr><th>Creado</th><td>@Model.Postgres.Creado</td></tr>
                        <tr><th>Actualizado</th><td>@Model.Postgres.Actualizado</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.Postgres.CreadoPor?.Nombre)</td></tr>
                        <tr><th>ActualizadoPor</th><td>@(Model.Postgres.ActualizadoPor?.Nombre)</td></tr>
                        <tr>
                            <th>ListaCortesPorMov</th>
                            <td>
                                @if (Model.Postgres.ListaCortesPorMov != null)
                                {
                                    foreach (var c in Model.Postgres.ListaCortesPorMov)
                                    {
                                        <div>@(c.Corte?.corte): @c.CantKg kg / @c.CantUnidad un @(c.PesoBalanza ? "(balanza)" : "")</div>
                                    }
                                }
                            </td>
                        </tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idMovimiento:</label>
    <input type="number" name="idMovimiento" class="form-control mr-2" style="width:120px" value="@ViewBag.IdMovimientoBuscado" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
