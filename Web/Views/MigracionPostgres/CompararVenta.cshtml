@model Web.Models.ComparacionVentaVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Venta #@ViewBag.IdVentaBuscada</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 7) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdVenta</th><td>@Model.SqlServer.IdVenta</td></tr>
                        <tr><th>FechaVenta</th><td>@Model.SqlServer.FechaVenta</td></tr>
                        <tr><th>Estado</th><td>@Model.SqlServer.Estado</td></tr>
                        <tr><th>FormaPago</th><td>@Model.SqlServer.FormaPago</td></tr>
                        <tr><th>EnCtaCte</th><td>@Model.SqlServer.EnCtaCte</td></tr>
                        <tr><th>NroRemito</th><td>@Model.SqlServer.NroRemito</td></tr>
                        <tr><th>Vendedor</th><td>@(Model.SqlServer.Vendedor?.Nombre)</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.SqlServer.Sucursal?.SucursalNombre)</td></tr>
                        <tr><th>Persona</th><td>@(Model.SqlServer.Persona?.razonSocial) (id @Model.SqlServer.IdPersona)</td></tr>
                        <tr><th>TotalImporte</th><td>@Model.SqlServer.TotalImporte</td></tr>
                        <tr><th>CantItems</th><td>@Model.SqlServer.CantItems</td></tr>
                        <tr><th>LineasVenta</th><td>@(Model.SqlServer.LineasVenta?.Count ?? 0)</td></tr>
                    </table>
                    if (Model.SqlServer.LineasVenta != null && Model.SqlServer.LineasVenta.Count > 0)
                    {
                        <table class="table table-sm mb-0 mt-2">
                            <tr><th>IdLineaVenta</th><th>Corte</th><th>CantKg</th><th>PrecioKg</th></tr>
                            @foreach (var l in Model.SqlServer.LineasVenta)
                            {
                                <tr><td>@l.IdLineaVenta</td><td>@(l.Corte?.CorteDesc)</td><td>@l.CantKg</td><td>@l.PrecioKg</td></tr>
                            }
                        </table>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdVenta</th><td>@Model.Postgres.IdVenta</td></tr>
                        <tr><th>FechaVenta</th><td>@Model.Postgres.FechaVenta</td></tr>
                        <tr><th>Estado</th><td>@Model.Postgres.Estado</td></tr>
                        <tr><th>FormaPago</th><td>@Model.Postgres.FormaPago</td></tr>
                        <tr><th>EnCtaCte</th><td>@Model.Postgres.EnCtaCte</td></tr>
                        <tr><th>NroRemito</th><td>@Model.Postgres.NroRemito</td></tr>
                        <tr><th>Vendedor</th><td>@(Model.Postgres.Vendedor?.Nombre)</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.Postgres.Sucursal?.SucursalNombre)</td></tr>
                        <tr><th>Persona</th><td>@(Model.Postgres.Persona?.razonSocial) (id @Model.Postgres.IdPersona)</td></tr>
                        <tr><th>TotalImporte</th><td>@Model.Postgres.TotalImporte</td></tr>
                        <tr><th>CantItems</th><td>@Model.Postgres.CantItems</td></tr>
                        <tr><th>LineasVenta</th><td>@(Model.Postgres.LineasVenta?.Count ?? 0)</td></tr>
                    </table>
                    if (Model.Postgres.LineasVenta != null && Model.Postgres.LineasVenta.Count > 0)
                    {
                        <table class="table table-sm mb-0 mt-2">
                            <tr><th>IdLineaVenta</th><th>Corte</th><th>CantKg</th><th>PrecioKg</th></tr>
                            @foreach (var l in Model.Postgres.LineasVenta)
                            {
                                <tr><td>@l.IdLineaVenta</td><td>@(l.Corte?.CorteDesc)</td><td>@l.CantKg</td><td>@l.PrecioKg</td></tr>
                            }
                        </table>
                    }
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idVenta:</label>
    <input type="number" name="idVenta" class="form-control mr-2" style="width:120px" value="@ViewBag.IdVentaBuscada" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
