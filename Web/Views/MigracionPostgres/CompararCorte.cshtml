@model Web.Models.ComparacionCorteVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Corte #@ViewBag.IdCorteBuscado</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 6) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCorte</th><td>@Model.SqlServer.IdCorte</td></tr>
                        <tr><th>Codigo</th><td>@Model.SqlServer.Codigo</td></tr>
                        <tr><th>Corte</th><td>@Model.SqlServer.CorteDesc</td></tr>
                        <tr><th>Tipo</th><td>@Model.SqlServer.Tipo</td></tr>
                        <tr><th>PrecioKg</th><td>@Model.SqlServer.PrecioKg</td></tr>
                        <tr><th>Habilitado</th><td>@Model.SqlServer.Habilitado</td></tr>
                        <tr><th>EnCierreStock</th><td>@Model.SqlServer.EnCierreStock</td></tr>
                        <tr><th>Nivel</th><td>@Model.SqlServer.Nivel</td></tr>
                        <tr><th>IdEmpresa</th><td>@Model.SqlServer.IdEmpresa</td></tr>
                        <tr><th>Marca</th><td>@(Model.SqlServer.Marca?.RazonSocial)</td></tr>
                        <tr><th>CorteMaestro</th><td>@(Model.SqlServer.CorteMaestro?.CorteDesc)</td></tr>
                        <tr><th>IdAlicuotaIva / AlicuotaIva</th><td>@Model.SqlServer.IdAlicuotaIva / @Model.SqlServer.AlicuotaIva</td></tr>
                        <tr><th>Pesable</th><td>@Model.SqlServer.Pesable</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCorte</th><td>@Model.Postgres.IdCorte</td></tr>
                        <tr><th>Codigo</th><td>@Model.Postgres.Codigo</td></tr>
                        <tr><th>Corte</th><td>@Model.Postgres.CorteDesc</td></tr>
                        <tr><th>Tipo</th><td>@Model.Postgres.Tipo</td></tr>
                        <tr><th>PrecioKg</th><td>@Model.Postgres.PrecioKg</td></tr>
                        <tr><th>Habilitado</th><td>@Model.Postgres.Habilitado</td></tr>
                        <tr><th>EnCierreStock</th><td>@Model.Postgres.EnCierreStock</td></tr>
                        <tr><th>Nivel</th><td>@Model.Postgres.Nivel</td></tr>
                        <tr><th>IdEmpresa</th><td>@Model.Postgres.IdEmpresa</td></tr>
                        <tr><th>Marca</th><td>@(Model.Postgres.Marca?.RazonSocial)</td></tr>
                        <tr><th>CorteMaestro</th><td>@(Model.Postgres.CorteMaestro?.CorteDesc)</td></tr>
                        <tr><th>IdAlicuotaIva / AlicuotaIva</th><td>@Model.Postgres.IdAlicuotaIva / @Model.Postgres.AlicuotaIva</td></tr>
                        <tr><th>Pesable</th><td>@Model.Postgres.Pesable</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idCorte:</label>
    <input type="number" name="idCorte" class="form-control mr-2" style="width:120px" value="@ViewBag.IdCorteBuscado" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
