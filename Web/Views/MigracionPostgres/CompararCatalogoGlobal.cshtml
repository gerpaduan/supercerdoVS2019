@model Web.Models.ComparacionCatalogoGlobalVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar CatalogoGlobalProducto</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual) -- @(Model.SqlServer?.Count ?? 0) filas</div>
            <div class="card-body" style="max-height:600px; overflow-y:auto;">
                @if (Model.SqlServer == null || Model.SqlServer.Count == 0)
                {
                    <p class="text-muted mb-0">Sin filas.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCorte</th><th>Codigo</th><th>Corte</th><th>Tipo</th><th>PrecioKg</th><th>Habilitado</th><th>Marca</th><th>CorteMaestro</th></tr>
                        @foreach (var p in Model.SqlServer)
                        {
                            <tr>
                                <td>@p.IdCorte</td>
                                <td>@p.Codigo</td>
                                <td>@p.CorteDesc</td>
                                <td>@p.Tipo</td>
                                <td>@p.PrecioKg</td>
                                <td>@p.Habilitado</td>
                                <td>@p.MarcaNombre</td>
                                <td>@p.CorteMaestroNombre</td>
                            </tr>
                        }
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo) -- @(Model.Postgres?.Count ?? 0) filas</div>
            <div class="card-body" style="max-height:600px; overflow-y:auto;">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.Count == 0)
                {
                    <p class="text-muted mb-0">Sin filas.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCorte</th><th>Codigo</th><th>Corte</th><th>Tipo</th><th>PrecioKg</th><th>Habilitado</th><th>Marca</th><th>CorteMaestro</th></tr>
                        @foreach (var p in Model.Postgres)
                        {
                            <tr>
                                <td>@p.IdCorte</td>
                                <td>@p.Codigo</td>
                                <td>@p.CorteDesc</td>
                                <td>@p.Tipo</td>
                                <td>@p.PrecioKg</td>
                                <td>@p.Habilitado</td>
                                <td>@p.MarcaNombre</td>
                                <td>@p.CorteMaestroNombre</td>
                            </tr>
                        }
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Busqueda:</label>
    <input type="text" name="busqueda" class="form-control mr-2" style="width:180px" value="@ViewBag.Busqueda" />
    <label class="mr-2">Tipo:</label>
    <input type="text" name="tipo" class="form-control mr-2" style="width:140px" value="@ViewBag.Tipo" />
    <label class="mr-2">Pagina:</label>
    <input type="number" name="pagina" class="form-control mr-2" style="width:80px" value="@ViewBag.Pagina" />
    <label class="mr-2">Cantidad:</label>
    <input type="number" name="cantidad" class="form-control mr-2" style="width:80px" value="@ViewBag.Cantidad" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
