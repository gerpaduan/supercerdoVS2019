@model Web.Models.ComparacionPermisosUsuarioVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Permisos de Usuario #@ViewBag.IdUsuarioBuscado</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 13b) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual) -- @(Model.SqlServer?.Count ?? 0) permisos</div>
            <div class="card-body" style="max-height:600px; overflow-y:auto;">
                @if (Model.SqlServer == null || Model.SqlServer.Count == 0)
                {
                    <p class="text-muted mb-0">No se encontro.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdForm</th><th>Formulario</th><th>DiasVer</th><th>DiasEditar</th><th>SoloPropios</th></tr>
                        @foreach (var p in Model.SqlServer)
                        {
                            <tr>
                                <td>@p.IdForm</td>
                                <td>@(p.Formulario?.NombreForm)</td>
                                <td>@p.DiasPermitidosVer</td>
                                <td>@p.DiasPermitidosEditar</td>
                                <td>@p.SoloRegistrosPropios</td>
                            </tr>
                        }
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo) -- @(Model.Postgres?.Count ?? 0) permisos</div>
            <div class="card-body" style="max-height:600px; overflow-y:auto;">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.Count == 0)
                {
                    <p class="text-muted mb-0">No se encontro.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdForm</th><th>Formulario</th><th>DiasVer</th><th>DiasEditar</th><th>SoloPropios</th></tr>
                        @foreach (var p in Model.Postgres)
                        {
                            <tr>
                                <td>@p.IdForm</td>
                                <td>@(p.Formulario?.NombreForm)</td>
                                <td>@p.DiasPermitidosVer</td>
                                <td>@p.DiasPermitidosEditar</td>
                                <td>@p.SoloRegistrosPropios</td>
                            </tr>
                        }
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idUsuario:</label>
    <input type="number" name="idUsuario" class="form-control mr-2" style="width:120px" value="@ViewBag.IdUsuarioBuscado" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
