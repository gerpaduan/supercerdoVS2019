@model Web.Models.ComparacionFacturaVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Factura #@ViewBag.IdFactuElecBuscado</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 12c) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null || Model.SqlServer.Id == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>Id</th><td>@Model.SqlServer.Id</td></tr>
                        <tr><th>PtoVtaAfip</th><td>@Model.SqlServer.PtoVtaAfip</td></tr>
                        <tr><th>FechaEmisionAfip</th><td>@Model.SqlServer.FechaEmisionAfip</td></tr>
                        <tr><th>CodTipoCbteAfip</th><td>@Model.SqlServer.CodTipoCbteAfip</td></tr>
                        <tr><th>NroCbteAfip</th><td>@Model.SqlServer.NroCbteAfip</td></tr>
                        <tr><th>RazonSocialAFIP</th><td>@Model.SqlServer.RazonSocialAFIP</td></tr>
                        <tr><th>CAE</th><td>@Model.SqlServer.CAE1</td></tr>
                        <tr><th>ImporteTotal</th><td>@Model.SqlServer.ImporteTotal</td></tr>
                        <tr><th>IdVenta</th><td>@Model.SqlServer.IdVenta</td></tr>
                        <tr><th>Error</th><td>@Model.SqlServer.Error</td></tr>
                        <tr><th>Venta.IdVenta</th><td>@(Model.SqlServer.Venta?.IdVenta)</td></tr>
                        <tr>
                            <th>ListaAlicuota</th>
                            <td>
                                @if (Model.SqlServer.ListaAlicuota != null)
                                {
                                    foreach (var a in Model.SqlServer.ListaAlicuota)
                                    {
                                        <div>IVA @a.Iva%: base @a.BaseImponible, importe @a.Importe</div>
                                    }
                                }
                            </td>
                        </tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.Id == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>Id</th><td>@Model.Postgres.Id</td></tr>
                        <tr><th>PtoVtaAfip</th><td>@Model.Postgres.PtoVtaAfip</td></tr>
                        <tr><th>FechaEmisionAfip</th><td>@Model.Postgres.FechaEmisionAfip</td></tr>
                        <tr><th>CodTipoCbteAfip</th><td>@Model.Postgres.CodTipoCbteAfip</td></tr>
                        <tr><th>NroCbteAfip</th><td>@Model.Postgres.NroCbteAfip</td></tr>
                        <tr><th>RazonSocialAFIP</th><td>@Model.Postgres.RazonSocialAFIP</td></tr>
                        <tr><th>CAE</th><td>@Model.Postgres.CAE1</td></tr>
                        <tr><th>ImporteTotal</th><td>@Model.Postgres.ImporteTotal</td></tr>
                        <tr><th>IdVenta</th><td>@Model.Postgres.IdVenta</td></tr>
                        <tr><th>Error</th><td>@Model.Postgres.Error</td></tr>
                        <tr><th>Venta.IdVenta</th><td>@(Model.Postgres.Venta?.IdVenta)</td></tr>
                        <tr>
                            <th>ListaAlicuota</th>
                            <td>
                                @if (Model.Postgres.ListaAlicuota != null)
                                {
                                    foreach (var a in Model.Postgres.ListaAlicuota)
                                    {
                                        <div>IVA @a.Iva%: base @a.BaseImponible, importe @a.Importe</div>
                                    }
                                }
                            </td>
                        </tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idFactuElec:</label>
    <input type="number" name="idFactuElec" class="form-control mr-2" style="width:120px" value="@ViewBag.IdFactuElecBuscado" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
