@model Web.Models.ComparacionSucursalVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Sucursal #@ViewBag.IdSucursalBuscada</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 3) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no la deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>idSucursal</th><td>@Model.SqlServer.IdSucursal</td></tr>
                        <tr><th>idEmpresa</th><td>@Model.SqlServer.IdEmpresa</td></tr>
                        <tr><th>SucursalNombre</th><td>@Model.SqlServer.SucursalNombre</td></tr>
                        <tr><th>Direccion</th><td>@Model.SqlServer.Direccion</td></tr>
                        <tr><th>Localidad</th><td>@Model.SqlServer.Localidad</td></tr>
                        <tr><th>Empresa</th><td>@(Model.SqlServer.Empresa?.NombreFantasia)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no la deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>idSucursal</th><td>@Model.Postgres.IdSucursal</td></tr>
                        <tr><th>idEmpresa</th><td>@Model.Postgres.IdEmpresa</td></tr>
                        <tr><th>SucursalNombre</th><td>@Model.Postgres.SucursalNombre</td></tr>
                        <tr><th>Direccion</th><td>@Model.Postgres.Direccion</td></tr>
                        <tr><th>Localidad</th><td>@Model.Postgres.Localidad</td></tr>
                        <tr><th>Empresa</th><td>@(Model.Postgres.Empresa?.NombreFantasia)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idSucursal:</label>
    <input type="number" name="idSucursal" class="form-control mr-2" style="width:120px" value="@ViewBag.IdSucursalBuscada" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
