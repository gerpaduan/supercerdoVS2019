@model Web.Models.ComparacionEgresoCajaVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar EgresoCaja #@ViewBag.IdEgresoCajaBuscado</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 8) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null || Model.SqlServer.Id == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>Id</th><td>@Model.SqlServer.Id</td></tr>
                        <tr><th>Fecha</th><td>@Model.SqlServer.Fecha</td></tr>
                        <tr><th>TipoEgresoCaja</th><td>@Model.SqlServer.TipoEgresoCaja (id @Model.SqlServer.IdTipoEgresoCaja)</td></tr>
                        <tr><th>Descripcion</th><td>@Model.SqlServer.Descripcion</td></tr>
                        <tr><th>Detalle</th><td>@Model.SqlServer.Detalle</td></tr>
                        <tr><th>Monto</th><td>@Model.SqlServer.Monto</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.SqlServer.Sucursal?.idSucursal)</td></tr>
                        <tr><th>Tabla/IdTabla</th><td>@Model.SqlServer.Tabla / @Model.SqlServer.IdTabla</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.SqlServer.CreadoPorUser?.Nombre) (id @Model.SqlServer.CreadoPor)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.Id == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>Id</th><td>@Model.Postgres.Id</td></tr>
                        <tr><th>Fecha</th><td>@Model.Postgres.Fecha</td></tr>
                        <tr><th>TipoEgresoCaja</th><td>@Model.Postgres.TipoEgresoCaja (id @Model.Postgres.IdTipoEgresoCaja)</td></tr>
                        <tr><th>Descripcion</th><td>@Model.Postgres.Descripcion</td></tr>
                        <tr><th>Detalle</th><td>@Model.Postgres.Detalle</td></tr>
                        <tr><th>Monto</th><td>@Model.Postgres.Monto</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.Postgres.Sucursal?.idSucursal)</td></tr>
                        <tr><th>Tabla/IdTabla</th><td>@Model.Postgres.Tabla / @Model.Postgres.IdTabla</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.Postgres.CreadoPorUser?.Nombre) (id @Model.Postgres.CreadoPor)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idEgresoCaja:</label>
    <input type="number" name="idEgresoCaja" class="form-control mr-2" style="width:120px" value="@ViewBag.IdEgresoCajaBuscado" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
