@model Web.Models.ComparacionCompraVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="mb-3">
    <h4 class="mb-1">Migracion Postgres: comparar Compra #@ViewBag.IdCompraBuscada</h4>
    <p class="text-muted mb-0">Herramienta de verificacion del piloto (Etapa 9) -- no es una pantalla de producto. Tenant de la sesion actual: @ViewBag.IdEmpresaSesion.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">SQL Server (capa actual)</div>
            <div class="card-body">
                @if (Model.SqlServer == null || Model.SqlServer.IdCompra == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCompra</th><td>@Model.SqlServer.IdCompra</td></tr>
                        <tr><th>NroRemito</th><td>@Model.SqlServer.NroRemito</td></tr>
                        <tr><th>FechaCompra</th><td>@Model.SqlServer.FechaCompra</td></tr>
                        <tr><th>Proveedor</th><td>@(Model.SqlServer.Proveedor?.razonSocial) (id @(Model.SqlServer.Proveedor?.idPersona))</td></tr>
                        <tr><th>TipoCompra</th><td>@Model.SqlServer.TipoCompra</td></tr>
                        <tr><th>CantMedias</th><td>@Model.SqlServer.CantMedias</td></tr>
                        <tr><th>KgsMedias</th><td>@Model.SqlServer.KgsMedias</td></tr>
                        <tr><th>IdPesajeAjustado</th><td>@Model.SqlServer.IdPesajeAjustado</td></tr>
                        <tr><th>EnCtaCte</th><td>@Model.SqlServer.EnCtaCte</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.SqlServer.Sucursal?.idSucursal)</td></tr>
                        <tr><th>Estado</th><td>@Model.SqlServer.Estado</td></tr>
                        <tr><th>Observaciones</th><td>@Model.SqlServer.Observaciones</td></tr>
                        <tr><th>Creado</th><td>@Model.SqlServer.Creado</td></tr>
                        <tr><th>Actualizado</th><td>@Model.SqlServer.Actualizado</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.SqlServer.CreadoPor?.Nombre)</td></tr>
                        <tr><th>ActualizadoPor</th><td>@(Model.SqlServer.ActualizadoPor?.Nombre)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Postgres (piloto nuevo)</div>
            <div class="card-body">
                @if (ViewBag.ErrorPostgres != null)
                {
                    <p class="text-danger mb-0"><strong>Error:</strong> @ViewBag.ErrorPostgres</p>
                }
                else if (Model.Postgres == null || Model.Postgres.IdCompra == 0)
                {
                    <p class="text-muted mb-0">No se encontro (o RLS no lo deja ver a este tenant).</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tr><th>IdCompra</th><td>@Model.Postgres.IdCompra</td></tr>
                        <tr><th>NroRemito</th><td>@Model.Postgres.NroRemito</td></tr>
                        <tr><th>FechaCompra</th><td>@Model.Postgres.FechaCompra</td></tr>
                        <tr><th>Proveedor</th><td>@(Model.Postgres.Proveedor?.razonSocial) (id @(Model.Postgres.Proveedor?.idPersona))</td></tr>
                        <tr><th>TipoCompra</th><td>@Model.Postgres.TipoCompra</td></tr>
                        <tr><th>CantMedias</th><td>@Model.Postgres.CantMedias</td></tr>
                        <tr><th>KgsMedias</th><td>@Model.Postgres.KgsMedias</td></tr>
                        <tr><th>IdPesajeAjustado</th><td>@Model.Postgres.IdPesajeAjustado</td></tr>
                        <tr><th>EnCtaCte</th><td>@Model.Postgres.EnCtaCte</td></tr>
                        <tr><th>Sucursal</th><td>@(Model.Postgres.Sucursal?.idSucursal)</td></tr>
                        <tr><th>Estado</th><td>@Model.Postgres.Estado</td></tr>
                        <tr><th>Observaciones</th><td>@Model.Postgres.Observaciones</td></tr>
                        <tr><th>Creado</th><td>@Model.Postgres.Creado</td></tr>
                        <tr><th>Actualizado</th><td>@Model.Postgres.Actualizado</td></tr>
                        <tr><th>CreadoPor</th><td>@(Model.Postgres.CreadoPor?.Nombre)</td></tr>
                        <tr><th>ActualizadoPor</th><td>@(Model.Postgres.ActualizadoPor?.Nombre)</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<form method="get" class="form-inline">
    <label class="mr-2">Probar otro idCompra:</label>
    <input type="number" name="idCompra" class="form-control mr-2" style="width:120px" value="@ViewBag.IdCompraBuscada" />
    <button type="submit" class="btn btn-primary">Comparar</button>
</form>
