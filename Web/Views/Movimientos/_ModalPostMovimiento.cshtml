<div class="modal fade" id="modalPostMovimiento" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title mb-0">Movimiento guardado</h5>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3" style="font-size:1.05rem;">Que deseas hacer ahora?</p>

                <button class="btn btn-secondary btn-lg btn-block mb-2" id="btnPostMovimientoNoImprimir" type="button">
                    <span class="badge badge-light mr-2">1</span>
                    No imprimir
                </button>

                <div class="d-flex mb-2">
                    <button class="btn btn-outline-primary btn-lg flex-grow-1 mr-2" id="btnPostMovimientoImprimir" type="button">
                        <span class="badge badge-primary mr-2">2</span>
                        <span id="lblMovimientoTicketAccion">Imprimir</span>
                    </button>

                    <button class="btn btn-outline-secondary btn-lg" id="btnCambiarTicketMovimiento" type="button" title="Cambiar tamaño de ticket">
                        Cambiar
                    </button>
                </div>

                <div class="collapse mb-2" id="bloqueTicketOpcionesMovimiento">
                    <div class="card card-body p-2">
                        <button class="btn btn-outline-primary btn-block mb-2 btnTicketMovimientoOpt" type="button" data-mm="58">
                            Ticket 58 mm
                        </button>

                        <button class="btn btn-outline-primary btn-block btnTicketMovimientoOpt" type="button" data-mm="80">
                            Ticket 80 mm
                        </button>

                        <small class="text-muted mt-2 d-block">
                            Elegi un tamaño y se imprimira automaticamente.
                        </small>
                    </div>
                </div>

                <button class="btn btn-dark btn-lg btn-block mb-2" id="btnPostMovimientoPdf" type="button">
                    <span class="badge badge-light mr-2">3</span>
                    Generar PDF
                </button>

                <button class="btn btn-success btn-lg btn-block" id="btnPostMovimientoWhatsapp" type="button">
                    <span class="badge badge-light mr-2">4</span>
                    <i class="fab fa-whatsapp mr-2"></i>Enviar a WhatsApp
                </button>

                <div class="mt-3 pt-2 border-top text-left">
                    <div class="small text-muted mb-2" id="estadoAgenteMovimiento">
                        Impresión local: usando navegador.
                    </div>

                    <div class="d-flex">
                        <button class="btn btn-outline-info btn-sm flex-grow-1 mr-2" id="btnConfigurarAgenteMovimiento" type="button">
                            Configurar impresora
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" id="btnDescargarAgenteMovimiento" href="@Url.Action("DescargarAgenteImpresion", "Movimientos")">
                            Descargar agente
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfigAgenteMovimiento" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configurar impresora local</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-none" id="msgConfigAgenteMovimiento"></div>

                <div class="form-group">
                    <label for="cmbImpresoraAgenteMovimiento">Impresora</label>
                    <select class="form-control" id="cmbImpresoraAgenteMovimiento"></select>
                </div>

                <div class="form-group mb-0">
                    <label for="cmbMmAgenteMovimiento">Tamaño ticket</label>
                    <select class="form-control" id="cmbMmAgenteMovimiento">
                        <option value="58">58 mm</option>
                        <option value="80">80 mm</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" type="button" id="btnGuardarConfigAgenteMovimiento">Guardar</button>
            </div>
        </div>
    </div>
</div>
