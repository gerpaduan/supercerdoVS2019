@model Web.Models.MovimientoEditVm
@using System.Collections.Generic
@using System.Web
@using Entidades

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    var modalProductoData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarProductoMovimiento" },
        { "ApiUrl", Url.Action("BuscarProducto", "Movimientos") },
        { "Titulo", "Buscar producto para Movimiento" },
        { "MostrarPrecio", "false" }
    };
}

<div class="container-fluid px-2 px-md-3 movimiento-page" data-movimiento-page="1">
    <div id="movimientoDraftBanner" class="alert alert-warning d-none" role="alert">
        Se encontró un borrador local de este movimiento.
        <button type="button" class="btn btn-sm btn-warning ml-2" data-action="restore-draft">Recuperar</button>
        <button type="button" class="btn btn-sm btn-outline-dark ml-2" data-action="clear-draft">Limpiar borrador</button>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Movimientos")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
        @if (Model.EsEdicion)
        {
            <button type="button" class="btn btn-outline-primary" id="btnImprimirMovimiento">
                <i class="fas fa-print mr-1"></i> Imprimir
            </button>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form id="formMovimiento" method="post" action="@Url.Action("Guardar", "Movimientos")" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdMovimiento)
                @Html.HiddenFor(m => m.EmpresaCuit)
                <div id="lineasHiddenContainer"></div>

                <div class="row">
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="IdSucursalOrigen">Sucursal origen</label>
                            <select id="IdSucursalOrigen" name="IdSucursalOrigen" class="form-control">
                                <option value="0">Seleccione...</option>
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursalOrigen ? "selected" : "")>@sucursal.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="IdSucursalDestino">Sucursal destino</label>
                            <select id="IdSucursalDestino" name="IdSucursalDestino" class="form-control">
                                <option value="0">Seleccione...</option>
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursalDestino ? "selected" : "")>@sucursal.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="FechaMovimiento">Fecha</label>
                            <input type="datetime-local"
                                   id="FechaMovimiento"
                                   name="FechaMovimiento"
                                   class="form-control"
                                   value="@Model.FechaMovimiento.ToString("yyyy-MM-ddTHH:mm")" />
                            @Html.Partial("_AdvertenciaPermisoFecha")
                        </div>
                    </div>
                </div>

                @if (Model.EsEdicion)
                {
                    <div class="row mb-3">
                        <div class="col-12 col-lg-3">
                            <div class="small text-muted">Movimiento origen</div>
                            <div class="font-weight-bold">@Model.IdMovimientoOrigen</div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="small text-muted">Movimiento destino</div>
                            <div class="font-weight-bold">@Model.IdMovimientoDestino</div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="small text-muted">Creado</div>
                            <div class="font-weight-bold">@Model.Creado</div>
                            <div class="small text-muted">@Model.CreadoPor</div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="small text-muted">Actualizado</div>
                            <div class="font-weight-bold">@Model.Actualizado</div>
                            <div class="small text-muted">@Model.ActualizadoPor</div>
                        </div>
                    </div>
                }

                <hr />

                <div class="row">
                    <div class="col-12 col-xl-8">
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-0">Agregar producto</h6>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="custom-control custom-switch mr-2">
                                        <input type="checkbox" class="custom-control-input" id="chkBalanzaLinea" checked />
                                        <label class="custom-control-label" for="chkBalanzaLinea">Balanza</label>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVerAcumulados">
                                        <i class="fas fa-layer-group mr-1"></i> Ver acumulados
                                    </button>
                                </div>
                            </div>

                            <div id="balanzaStatusWrapMovimiento">
                                <div class="small text-muted mb-2">
                                    Conexión balanza: <span id="estadoBalanzaMovimiento">Desconocida</span>
                                </div>
                                <div class="progress mb-3" style="height:4px;">
                                    <div id="barraBalanzaMovimiento" class="progress-bar" role="progressbar" style="width:0%"></div>
                                </div>
                            </div>

                            <div id="movimientoFeedback" class="alert alert-success py-2 px-3 mb-3 d-none"></div>
                            <div id="movimientoWarning" class="alert alert-warning py-2 px-3 mb-3 d-none"></div>

                            <div class="row align-items-end">
                                <div class="col-12 col-md-4 col-lg-3">
                                    <div class="form-group">
                                        <label for="txtCodigoProducto">Código</label>
                                        <input type="number" id="txtCodigoProducto" class="form-control" min="0" step="1" autocomplete="off" style="min-width:15ch;" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-8 col-lg-5">
                                    <div class="form-group">
                                        <label for="txtProductoNombre">Producto</label>
                                        <div class="input-group">
                                            <input type="hidden" id="txtProductoId" />
                                            <input type="hidden" id="txtProductoPesable" />
                                            <input type="hidden" id="txtProductoTipo" />
                                            <input type="hidden" id="txtProductoPromedio" />
                                            <input type="text" id="txtProductoNombre" class="form-control" readonly />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnBuscarProducto" title="Buscar producto (F10)">
                                                    <i class="fas fa-search"></i>
                                                    <span class="d-none d-lg-inline ml-1">F10</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCantUnidad">Cant.Un.</label>
                                        <input type="number" id="txtCantUnidad" class="form-control" min="0" step="1" />
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCantKgs">Kgs.</label>
                                        <input type="text" id="txtCantKgs" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" />
                                    </div>
                                </div>
                            </div>

                            <div class="custom-control custom-checkbox mb-3 d-none" id="wrapPermitirIngreso">
                                <input type="checkbox" class="custom-control-input" id="chkPermitirIngreso" />
                                <label class="custom-control-label" for="chkPermitirIngreso">Permitir ingreso</label>
                                <small class="form-text text-muted">Presione <strong>+</strong> para registrar.</small>
                            </div>

                            <button type="button" class="btn btn-primary" id="btnAgregarProducto">
                                <i class="fas fa-plus mr-1"></i> Agregar producto
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="tablaLineasMovimiento">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width:110px;">Código</th>
                                        <th>Producto</th>
                                        <th class="text-right" style="width:110px;">Cant.Un.</th>
                                        <th class="text-right" style="width:110px;">Kilos</th>
                                        <th class="text-center" style="width:90px;">Balanza</th>
                                        <th class="text-center" style="width:130px;">Permitir ingreso</th>
                                        <th style="width:70px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-uppercase text-muted">Resumen</h6>
                                <div class="d-flex justify-content-between">
                                    <span>Total items</span>
                                    <strong id="lblTotalItems">0</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Total unidades</span>
                                    <strong id="lblTotalUnidades">0</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Total kilos</span>
                                    <strong id="lblTotalKilos">0.000</strong>
                                </div>
                                <hr />
                                <div class="small text-muted">
                                    Usuario: <strong>@Model.UsuarioNombre</strong>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-3 mb-0">
                            <label for="Observaciones">Observaciones</label>
                            <textarea id="Observaciones"
                                      name="Observaciones"
                                      class="form-control js-auto-resize"
                                      rows="2"
                                      style="min-height: calc(1.5em * 2 + 1rem); overflow:hidden; resize:none;"
                                      maxlength="250">@Model.Observaciones</textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (Model.EsEdicion)
                    {
                        <button type="button"
                                class="btn btn-primary mr-2 mb-2"
                                id="btnHabilitarEdicionMovimiento"
                                data-edit-readonly-ignore="true">
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>
                    }
                    <button type="submit" class="btn btn-success mr-2 mb-2 @(Model.EsEdicion ? "d-none" : "")" id="btnGuardarMovimiento">
                        <i class="fas fa-save mr-1"></i> Guardar movimiento
                    </button>
                    <a href="@Url.Action("Index", "Movimientos")" class="btn btn-outline-secondary mb-2">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAcumuladosMovimiento" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Acumulados del movimiento</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:110px;">Código</th>
                                <th>Producto</th>
                                <th class="text-right" style="width:110px;">Cant.Un.</th>
                                <th class="text-right" style="width:110px;">Kilos</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyAcumuladosMovimiento"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", modalProductoData)
@Html.Partial("~/Views/Movimientos/_ModalPostMovimiento.cshtml")

@section Scripts {
    <script>
        window.movimientosConfig = {
            draftKey: 'movimiento_draft_@(Model.EsEdicion ? Model.IdMovimiento.ToString() : "new")',
            urlBuscarProductoPorCodigo: '@Url.Action("BuscarProductoPorCodigo", "Movimientos")',
            redirectUrl: '@Url.Action("Index", "Movimientos")',
            imprimirUrl: '@(Model.EsEdicion ? Url.Action("ImprimirTicket", "Movimientos", new { id = Model.IdMovimiento }) : "")',
            imprimirPayloadUrl: '@(Model.EsEdicion ? Url.Action("ImprimirTicketPayload", "Movimientos", new { id = Model.IdMovimiento }) : "")',
            pdfUrl: '@(Model.EsEdicion ? Url.Action("ImprimirPdf", "Movimientos", new { id = Model.IdMovimiento }) : "")',
            whatsappTexto: '@(Model.EsEdicion ? HttpUtility.JavaScriptStringEncode("Movimiento " + Model.IdMovimiento + " - " + Url.Action("ImprimirPdf", "Movimientos", new { id = Model.IdMovimiento }, Request.Url.Scheme)) : "")',
            balanzaUrl: 'http://localhost:5100/peso',
            soloLecturaInicial: @(Model.EsEdicion ? "true" : "false")
        };
        window.movimientoLineasIniciales = @Html.Raw(Json.Encode(Model.Lineas ?? new List<Web.Models.MovimientoLineaVm>()));
    </script>
    <script src="@Url.Content("~/Scripts/carnisys.balanza.js?v=6")"></script>
    <script src="@Url.Content("~/Scripts/app/print-agent.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-postmovimiento.js?v=7")"></script>
    <script src="@Url.Content("~/Scripts/app/movimientos.js?v=19")"></script>
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=1")"></script>
    <script>
        window.EditReadOnly && window.EditReadOnly.init({
            formSelector: "#formMovimiento",
            soloLecturaInicial: @(Model.EsEdicion ? "true" : "false"),
            modifyButtonSelector: "#btnHabilitarEdicionMovimiento",
            saveButtonSelector: "#btnGuardarMovimiento",
            onStateChanged: function (readOnly) {
                if (window.MovimientosEdit && typeof window.MovimientosEdit.setReadOnly === "function") {
                    window.MovimientosEdit.setReadOnly(readOnly);
                }
            }
        });
    </script>
}
