@model Web.Models.ElaboradoRapidoEditVm
@using System.Collections.Generic
@using System.Web.Helpers
@using Entidades

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = Model.EsDesarme ? "Desarme de elaborado" : "Ingreso rápido";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    bool esAnulado = string.Equals(Model.Estado ?? "", "Anulado", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-2 px-md-3 elaborados-page" data-elaborados-page="ingreso-rapido-edicion">
    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <a class="btn btn-outline-secondary mb-2" href="@Url.Action(Model.EsDesarme ? "Desarme" : "IngresoRapido", "Elaborados")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
        @if (esAnulado)
        {
            <span class="badge badge-danger px-3 py-2 text-uppercase">Anulado</span>
        }
        else if (Model.EsDesarme)
        {
            <span class="badge badge-info px-3 py-2 text-uppercase">Desarme</span>
        }
        else
        {
            <span class="badge badge-primary px-3 py-2 text-uppercase">Ingreso rápido</span>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form id="formIngresoRapidoElaborado" method="post" action="@Url.Action("GuardarIngresoRapido", "Elaborados")" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="EsDesarme" value="@(Model.EsDesarme ? "true" : "false")" />
                <input type="hidden" name="IdEmbutido" value="@Model.IdEmbutido" />
                <input type="hidden" name="IdElaborado" value="@Model.IdElaborado" />
                @if (Model.EsEdicion && esAnulado)
                {
                    <div class="alert alert-secondary" role="alert">
                        El elaborado fue anulado y no puede ser modificado.
                    </div>
                }

                @if (Model.EsEdicion && !esAnulado)
                {
                    <div class="alert alert-warning" role="alert">
                        Al guardar esta modificación se anula primero el registro actual y luego se crea uno nuevo con los datos actualizados.
                    </div>
                }

                <div class="row">
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="IdSucursalRapido">Sucursal</label>
                            <select id="IdSucursalRapido" name="IdSucursal" class="form-control" @(esAnulado ? "disabled" : "")>
                                <option value="0">Seleccione...</option>
                                @foreach (var sucursal in sucursales)
                                {
                                    <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label for="FechaEmbutidoRapido">Fecha</label>
                            <input type="datetime-local"
                                   id="FechaEmbutidoRapido"
                                   name="FechaEmbutido"
                                   class="form-control"
                                   value="@Model.FechaEmbutido.ToString("yyyy-MM-ddTHH:mm:ss")"
                                   step="1"
                                   @(esAnulado ? "readonly" : "") />
                            @Html.Partial("~/Views/Shared/_AdvertenciaPermisoFecha.cshtml")
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label>Usuario</label>
                            <input type="text" class="form-control" value="@Model.UsuarioNombre" readonly />
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="row">
                        <div class="col-12 col-lg-3">
                            <div class="form-group">
                                <label>Código</label>
                                <input type="text" class="form-control" value="@Model.CodigoElaborado" readonly />
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="form-group">
                                <label>Elaborado</label>
                                <input type="text" class="form-control" value="@Model.Elaborado" readonly />
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="form-group mb-0">
                                <label for="RecetaRapido">Receta</label>
                                <textarea id="RecetaRapido" class="form-control js-auto-receta" rows="2" readonly>@Model.Receta</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-xl-4">
                        <div class="card border-left-@(Model.EsDesarme ? "info" : "primary") shadow-sm mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <div class="text-xs font-weight-bold text-uppercase mb-1 @(Model.EsDesarme ? "text-info" : "text-primary")">
                                            @(Model.EsDesarme ? "Cantidad a desarmar" : "Cantidad a elaborar")
                                        </div>
                                        <div class="small text-muted">
                                            @(Model.EsDesarme ? "La fórmula se mostrará en negativo." : "La fórmula se calcula automáticamente en vivo.")
                                        </div>
                                    </div>
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="chkBalanzaRapido" checked @(esAnulado ? "disabled" : "") />
                                        <label class="custom-control-label" for="chkBalanzaRapido">Balanza</label>
                                    </div>
                                </div>

                                <input type="text"
                                       id="CantidadRapida"
                                       name="Cantidad"
                                       class="form-control form-control-lg solo-decimal text-right"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       value="@(Model.Cantidad > 0 ? Model.Cantidad.ToString("0.###", System.Globalization.CultureInfo.GetCultureInfo("es-AR")) : "")"
                                       @(esAnulado ? "readonly" : "") />

                                <div id="alertaBalanzaRapido" class="alert alert-warning py-2 px-3 mt-3 mb-0 d-none"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-8">
                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                    <h6 class="font-weight-bold text-uppercase text-muted mb-0">Fórmula calculada</h6>
                                    <div class="small text-muted">Se guardan todos los ingredientes de la fórmula</div>
                                </div>

                                <div class="table-responsive formula-elaborado-wrap">
                                    <table class="table table-sm table-bordered mb-0" id="tablaFormulaRapida">
                                        <thead>
                                            <tr>
                                                <th>Ingrediente</th>
                                                <th class="d-none">%</th>
                                                <th class="text-right" style="width:120px;">Kgs</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>

                                <hr />
                                <div class="d-flex justify-content-between">
                                    <span>Total fórmula</span>
                                    <strong id="lblTotalFormulaRapida">0.000</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (!esAnulado)
                    {
                        <button type="submit" class="btn btn-success mr-2 mb-2" id="btnGuardarIngresoRapido">
                            <i class="fas fa-save mr-1"></i> @(Model.EsDesarme ? "Guardar desarme" : "Guardar ingreso rápido")
                        </button>
                    }
                    @if (Model.EsEdicion && Model.PuedeAnular)
                    {
                        <button type="button" class="btn btn-outline-danger mr-2 mb-2" id="btnAnularIngresoRapido">
                            <i class="fas fa-ban mr-1"></i> Anular
                        </button>
                    }
                    <a href="@Url.Action("Index", "Elaborados")" class="btn btn-outline-secondary mb-2" data-ignore-exit="1">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

<style>
    .js-auto-receta {
        overflow: hidden;
        resize: vertical;
    }

    #tablaFormulaRapida th:nth-child(2),
    #tablaFormulaRapida td:nth-child(2) {
        display: none;
    }
</style>

@section Scripts {
    <script>
        window.elaboradosIngresoRapidoConfig = {
            esDesarme: @(Model.EsDesarme ? "true" : "false"),
            esPesable: @(Model.EsPesableElaborado ? "true" : "false"),
            guardarUrl: '@Url.Action("GuardarIngresoRapido", "Elaborados")',
            anularUrl: '@Url.Action("Anular", "Elaborados")',
            redirectUrl: '@Url.Action("Index", "Elaborados")',
            balanzaUrl: 'http://localhost:5100/peso',
            esAnulado: @(esAnulado ? "true" : "false"),
            puedeAnular: @(Model.PuedeAnular ? "true" : "false"),
            initialFormula: @Html.Raw(Json.Encode(Model.Formula ?? new List<Web.Models.ElaboradoFormulaLineaVm>()))
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/elaborados-rapido.js?v=3")"></script>
}
