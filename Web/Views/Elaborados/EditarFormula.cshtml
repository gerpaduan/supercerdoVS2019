@model Web.Models.ElaboradoFormulaEditVm
@using System.Collections.Generic
@using System.Web.Helpers
@using System.Web.Mvc

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = Model.EsEdicion ? "Modificar formula" : "Nueva formula";

    var modalElaboradoData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarElaboradoFormula" },
        { "ApiUrl", Url.Action("BuscarProducto", "Elaborados") },
        { "Titulo", "Buscar elaborado" },
        { "MostrarPrecio", "false" }
    };

    var modalIngredienteData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarIngredienteFormula" },
        { "ApiUrl", Url.Action("BuscarProducto", "Elaborados") },
        { "Titulo", "Buscar ingrediente" },
        { "MostrarPrecio", "false" }
    };
}

<div class="container-fluid px-2 px-md-3 elaborados-page" data-formula-page="editar">
    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <a class="btn btn-outline-secondary mb-2" href="@Url.Action("Formulas", "Elaborados")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm elaborados-panel-card elaborados-form-compact">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form id="formEditarFormula" method="post" action="@Url.Action("GuardarFormula", "Elaborados")" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdFormula)
                <div id="lineasFormulaHiddenContainer"></div>

                <div class="row">
                    <div class="col-12 col-lg-3">
                        <div class="form-group">
                            <label>Usuario</label>
                            <input type="text" class="form-control" value="@Model.UsuarioNombre" readonly />
                        </div>
                    </div>
                    @if (Model.EsEdicion)
                    {
                        <div class="col-12 col-lg-3">
                            <div class="form-group">
                                <label>Creado</label>
                                <input type="text" class="form-control" value="@Model.CreadoPor | @Model.Creado" readonly />
                            </div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="form-group">
                                <label>Actualizado</label>
                                <input type="text" class="form-control" value="@Model.ActualizadoPor | @Model.Actualizado" readonly />
                            </div>
                        </div>
                    }
                </div>

                <div class="border rounded p-3 mb-3 elaborados-section-box">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                        <h6 class="font-weight-bold text-uppercase text-muted mb-0 elaborados-section-title">Elaborado</h6>
                    </div>

                    <div id="formulaErrorElaboradoExistente" class="alert alert-warning py-2 px-3 mb-3 d-none">
                        El elaborado ya posee una formula. Modifique la existente.
                    </div>

                    <div id="formulaInfoIngresoRapido" class="alert alert-info py-2 px-3 mb-3 @(Model.EsIngresoRapidoElaborado ? "" : "d-none")">
                        Este elaborado es de Ingreso Rapido. El sistema calculara automaticamente un Ajuste de Formula para que el resultado final represente 1 unidad.
                        @if (Model.CodigoProductoGenerico > 0)
                        {
                            <span class="d-block mt-1">Se usa el codigo generico <strong>@Model.CodigoProductoGenerico</strong>@(!string.IsNullOrWhiteSpace(Model.NombreProductoGenerico) ? (" - " + Model.NombreProductoGenerico) : "") para realizar el ajuste.</span>
                        }
                    </div>

                    <div class="row align-items-end">
                        <div class="col-12 col-md-3 col-lg-2">
                            <div class="form-group">
                                <label for="txtCodigoElaboradoFormula">Codigo</label>
                                <input type="number" id="txtCodigoElaboradoFormula" class="form-control" min="0" step="1" autocomplete="off" value="@(Model.CodigoElaborado > 0 ? Model.CodigoElaborado.ToString() : "")" />
                            </div>
                        </div>
                        <div class="col-12 col-md-9 col-lg-5">
                            <div class="form-group">
                                <label for="txtElaboradoFormulaNombre">Elaborado</label>
                                <div class="input-group">
                                    <input type="hidden" id="IdElaborado" name="IdElaborado" value="@Model.IdElaborado" />
                                    <input type="hidden" id="txtElaboradoEsPesableFormula" value="@(Model.EsPesableElaborado ? "true" : "false")" />
                                    <input type="hidden" id="txtElaboradoIngresoRapidoFormula" value="@(Model.EsIngresoRapidoElaborado ? "true" : "false")" />
                                    <input type="text" id="txtElaboradoFormulaNombre" class="form-control" value="@Model.Elaborado" readonly />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-primary" id="btnBuscarElaboradoFormula" title="Buscar elaborado (F9)">
                                            <i class="fas fa-search"></i>
                                            <span class="d-none d-lg-inline ml-1">F9</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="form-group mb-0">
                                <label for="Receta">Receta</label>
                                <textarea id="Receta" name="Receta" class="form-control js-auto-receta" rows="2">@Model.Receta</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-xl-8">
                        <div class="border rounded p-3 mb-3 elaborados-section-box">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-0 elaborados-section-title">Ingredientes de la formula</h6>
                            </div>

                            <div id="formulaFeedback" class="alert alert-success py-2 px-3 mb-3 d-none"></div>

                            <div class="row align-items-end">
                                <div class="col-12 col-md-3">
                                    <div class="form-group">
                                        <label for="txtCodigoIngredienteFormula">Codigo</label>
                                        <input type="number" id="txtCodigoIngredienteFormula" class="form-control" min="0" step="1" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <div class="form-group">
                                        <label for="txtIngredienteFormulaNombre">Ingrediente</label>
                                        <div class="input-group">
                                            <input type="hidden" id="txtIngredienteFormulaId" />
                                            <input type="text" id="txtIngredienteFormulaNombre" class="form-control" readonly />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnBuscarIngredienteFormula" title="Buscar ingrediente (F10)">
                                                    <i class="fas fa-search"></i>
                                                    <span class="d-none d-lg-inline ml-1">F10</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-2">
                                    <div class="form-group">
                                        <label for="txtPorcentajeFormula" id="lblValorFormulaInput">@Model.EtiquetaValorFormula</label>
                                        <input type="text" id="txtPorcentajeFormula" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-8 col-md-2 col-lg-1">
                                    <div class="form-group mb-3">
                                        <div class="custom-control custom-checkbox formula-auto-wrap">
                                            <input type="checkbox" class="custom-control-input" id="chkAgregarAutoFormula" @(Model.EsIngresoRapidoElaborado ? "checked" : "") />
                                            <label class="custom-control-label" for="chkAgregarAutoFormula">Auto</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2 col-lg-1">
                                    <button type="button" class="btn btn-primary btn-block mb-3 formula-btn-add" id="btnAgregarLineaFormula" title="Agregar">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive mb-3">
                            <table class="table table-bordered table-sm elaborados-table-compact" id="tablaLineasFormula">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width:110px;">Codigo</th>
                                        <th>Ingrediente</th>
                                        <th class="text-right" style="width:120px;" id="lblValorFormulaColumna">@Model.EtiquetaValorFormula</th>
                                        <th class="text-center" style="width:90px;">Auto</th>
                                        <th style="width:70px;">Accion</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="card bg-light elaborados-panel-card elaborados-summary-card">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-uppercase text-muted elaborados-section-title">Totales</h6>
                                <div class="d-flex justify-content-between">
                                    <span id="lblTotalPrincipalTexto">@((Model.EsPesableElaborado) ? "Total porcentaje" : "Total unidades")</span>
                                    <strong id="lblTotalPorcentaje">@Model.TotalPorcentaje.ToString("N2")</strong>
                                </div>
                                <div class="d-flex justify-content-between @(Model.EsPesableElaborado ? "" : "d-none")" id="filaTotalSecundario">
                                    <span>Equivalencia en unidades</span>
                                    <strong id="lblTotalUnidades">@Model.TotalUnidades.ToString("N2")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (Model.EsEdicion && Model.SoloLecturaInicial)
                    {
                        <button type="button" class="btn btn-primary mr-2 mb-2" id="btnHabilitarEdicionFormula">
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>
                    }
                    <button type="submit" class="btn btn-success mr-2 mb-2 @(Model.EsEdicion && Model.SoloLecturaInicial ? "d-none" : "")" id="btnGuardarFormula">
                        <i class="fas fa-save mr-1"></i> Guardar formula
                    </button>
                    <a href="@Url.Action("Formulas", "Elaborados")" class="btn btn-outline-secondary mb-2">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", modalElaboradoData)
@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", modalIngredienteData)
@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

<style>
    .js-auto-receta {
        overflow: hidden;
        resize: vertical;
    }

    .formula-auto-wrap {
        margin-top: 2.35rem;
    }

    .formula-btn-add {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(1.5em + .75rem + 2px);
    }

    .formula-btn-add i {
        margin: 0;
    }
</style>

@section Scripts {
    <script>
        (function () {
            var $form = $('#formEditarFormula');
            var state = {
                lineas: @Html.Raw(Json.Encode(Model.Lineas ?? new List<Web.Models.ElaboradoFormulaEditLineaVm>())),
                esPesable: @Html.Raw(Json.Encode(Model.EsPesableElaborado)),
                esIngresoRapido: @Html.Raw(Json.Encode(Model.EsIngresoRapidoElaborado)),
                codigoGenerico: @Model.CodigoProductoGenerico,
                nombreGenerico: @Html.Raw(Json.Encode(Model.NombreProductoGenerico ?? "")),
                soloLectura: @Html.Raw(Json.Encode(Model.SoloLecturaInicial)),
                codigoElaboradoInicial: @Model.CodigoElaborado
            };

            function toNumber(value) {
                if (value === null || value === undefined) return 0;
                if (typeof value === "number") return value;
                value = value.toString().replace(/\./g, '').replace(',', '.');
                var parsed = parseFloat(value);
                return isNaN(parsed) ? 0 : parsed;
            }

            function formatValue(value) {
                return (toNumber(value)).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function targetValorVisible() {
                return state.esPesable ? 100 : 1;
            }

            function valorLabel() {
                return state.esPesable ? 'Porcentaje' : 'Unidad';
            }

            function updateModeLabels() {
                $('#lblValorFormulaInput').text(valorLabel());
                $('#lblValorFormulaColumna').text(valorLabel());
                $('#lblTotalPrincipalTexto').text(state.esPesable ? 'Total porcentaje' : 'Total unidades');
                $('#filaTotalSecundario').toggleClass('d-none', !state.esPesable);

                if (state.esIngresoRapido) {
                    var texto = 'Este elaborado es de Ingreso Rapido. El sistema calculara automaticamente un Ajuste de Formula para que el resultado final represente 1 unidad.';
                    if (state.codigoGenerico > 0) {
                        texto += ' Se usa el codigo generico ' + state.codigoGenerico + (state.nombreGenerico ? (' - ' + state.nombreGenerico) : '') + ' para realizar el ajuste.';
                    }
                    $('#formulaInfoIngresoRapido').removeClass('d-none').text(texto);
                } else {
                    $('#formulaInfoIngresoRapido').addClass('d-none').text('');
                }
            }

            function setReadOnly(readOnly) {
                state.soloLectura = readOnly;
                $('#txtCodigoElaboradoFormula, #txtCodigoIngredienteFormula, #txtPorcentajeFormula, #Receta').prop('readonly', readOnly);
                $('#btnBuscarElaboradoFormula, #btnBuscarIngredienteFormula, #btnAgregarLineaFormula, .js-remove-linea-formula').prop('disabled', readOnly);
                $('#chkAgregarAutoFormula').prop('disabled', readOnly);
                $('#btnGuardarFormula').toggleClass('d-none', readOnly);
                $('#btnHabilitarEdicionFormula').toggleClass('d-none', !readOnly);
            }

            function syncAjusteFormula() {
                state.lineas = state.lineas.filter(function (linea) { return !linea.EsAjusteFormula; });
                if (!state.esIngresoRapido || !state.codigoGenerico) return;

                var total = 0;
                state.lineas.forEach(function (linea) {
                    total += toNumber(linea.Porcentaje);
                });

                state.lineas.unshift({
                    IdCorte: 0,
                    Codigo: state.codigoGenerico,
                    Producto: state.nombreGenerico || 'Ajuste de Formula',
                    Porcentaje: targetValorVisible() - total,
                    AgregarAuto: true,
                    EsAjusteFormula: true
                });
            }

            function rebuildHidden() {
                var html = '';
                var index = 0;

                state.lineas.forEach(function (linea) {
                    if (linea.EsAjusteFormula) return;

                    html += '<input type="hidden" name="Lineas[' + index + '].IdCorte" value="' + (linea.IdCorte || 0) + '" />';
                    html += '<input type="hidden" name="Lineas[' + index + '].Codigo" value="' + (linea.Codigo || 0) + '" />';
                    html += '<input type="hidden" name="Lineas[' + index + '].Producto" value="' + $('<div/>').text(linea.Producto || '').html() + '" />';
                    html += '<input type="hidden" name="Lineas[' + index + '].Porcentaje" value="' + formatValue(linea.Porcentaje || 0).replace('.', '').replace(',', '.') + '" />';
                    html += '<input type="hidden" name="Lineas[' + index + '].AgregarAuto" value="' + (linea.AgregarAuto ? 'true' : 'false') + '" />';
                    index++;
                });

                $('#lineasFormulaHiddenContainer').html(html);
            }

            function renderLineas() {
                syncAjusteFormula();
                rebuildHidden();

                var html = '';
                var total = 0;
                state.lineas.forEach(function (linea, index) {
                    total += toNumber(linea.Porcentaje);
                    html += '<tr>';
                    html += '<td>' + (linea.Codigo || '') + '</td>';
                    html += '<td>' + (linea.Producto || '') + '</td>';
                    html += '<td class="text-right">' + formatValue(linea.Porcentaje) + '</td>';
                    html += '<td class="text-center">' + (linea.AgregarAuto ? 'Si' : 'No') + '</td>';
                    html += '<td>';
                    if (!linea.EsAjusteFormula) {
                        html += '<button type="button" class="btn btn-sm btn-outline-danger js-remove-linea-formula" data-index="' + index + '"' + (state.soloLectura ? ' disabled' : '') + '><i class="fas fa-trash"></i></button>';
                    }
                    html += '</td>';
                    html += '</tr>';
                });

                $('#tablaLineasFormula tbody').html(html);
                $('#lblTotalPorcentaje').text(formatValue(total));
                $('#lblTotalUnidades').text(formatValue(state.esPesable ? (total / 100) : total));
            }

            function limpiarIngrediente() {
                $('#txtCodigoIngredienteFormula').val('');
                $('#txtIngredienteFormulaId').val('');
                $('#txtIngredienteFormulaNombre').val('');
                $('#txtPorcentajeFormula').val('');
                $('#chkAgregarAutoFormula').prop('checked', false);
            }

            function setProducto($codigo, $id, $nombre, resp) {
                $codigo.val(resp && resp.codigo ? resp.codigo : '');
                $id.val(resp && resp.id ? resp.id : '');
                $nombre.val(resp && resp.nombre ? resp.nombre : '');
            }

            function buscarPorCodigo($codigo, callback) {
                var codigo = parseInt($codigo.val(), 10) || 0;
                if (!codigo) {
                    if (callback) callback();
                    return;
                }

                $.get('@Url.Action("BuscarProductoPorCodigo", "Elaborados")', { codigo: codigo })
                    .done(function (resp) {
                        if (!resp || !resp.ok) {
                            if (window.Swal) Swal.fire('Producto', (resp && resp.mensaje) || 'No se encontro el producto.', 'warning');
                            else alert((resp && resp.mensaje) || 'No se encontro el producto.');
                            return;
                        }

                        if ($codigo.is('#txtCodigoElaboradoFormula')) {
                            setProducto($('#txtCodigoElaboradoFormula'), $('#IdElaborado'), $('#txtElaboradoFormulaNombre'), resp);
                            state.esPesable = !!resp.pesable;
                            state.esIngresoRapido = !!resp.ingresoRapido;
                        } else {
                            setProducto($('#txtCodigoIngredienteFormula'), $('#txtIngredienteFormulaId'), $('#txtIngredienteFormulaNombre'), resp);
                        }

                        updateModeLabels();
                        renderLineas();
                        if (callback) callback(resp);
                    });
            }

            function openModal(selector, focusSelector, onSelected) {
                var $modal = $(selector);
                $modal.off('producto:seleccionado.formula').on('producto:seleccionado.formula', function (e, producto) {
                    if (!producto) return;
                    if (selector === '#modalBuscarElaboradoFormula') {
                        $('#txtCodigoElaboradoFormula').val(producto.Codigo || producto.codigo || '');
                        $('#IdElaborado').val(producto.IdCorte || producto.id || '');
                        $('#txtElaboradoFormulaNombre').val(producto.CorteDesc || producto.nombre || '');
                        state.esPesable = !!(producto.Pesable || producto.pesable);
                        state.esIngresoRapido = !!(producto.IngresoRapidoEmbutido || producto.ingresoRapido);
                    } else {
                        $('#txtCodigoIngredienteFormula').val(producto.Codigo || producto.codigo || '');
                        $('#txtIngredienteFormulaId').val(producto.IdCorte || producto.id || '');
                        $('#txtIngredienteFormulaNombre').val(producto.CorteDesc || producto.nombre || '');
                    }
                    updateModeLabels();
                    renderLineas();
                    if (onSelected) onSelected(producto);
                });
                $modal.modal('show');
                if (focusSelector) {
                    window.setTimeout(function () { $(focusSelector).focus(); }, 250);
                }
            }

            $('#btnBuscarElaboradoFormula').on('click', function () {
                openModal('#modalBuscarElaboradoFormula', '#txtCodigoElaboradoFormula', function () {
                    $('#txtCodigoIngredienteFormula').focus();
                });
            });

            $('#btnBuscarIngredienteFormula').on('click', function () {
                openModal('#modalBuscarIngredienteFormula', '#txtCodigoIngredienteFormula');
            });

            $('#btnAgregarLineaFormula').on('click', function () {
                var idCorte = parseInt($('#txtIngredienteFormulaId').val(), 10) || 0;
                var codigo = parseInt($('#txtCodigoIngredienteFormula').val(), 10) || 0;
                var producto = $('#txtIngredienteFormulaNombre').val() || '';
                var porcentaje = toNumber($('#txtPorcentajeFormula').val());

                if (!idCorte || !producto) {
                    if (window.Swal) Swal.fire('Ingredientes', 'Debe seleccionar un ingrediente.', 'warning');
                    else alert('Debe seleccionar un ingrediente.');
                    return;
                }

                state.lineas.push({
                    IdCorte: idCorte,
                    Codigo: codigo,
                    Producto: producto,
                    Porcentaje: porcentaje,
                    AgregarAuto: $('#chkAgregarAutoFormula').is(':checked'),
                    EsAjusteFormula: false
                });

                limpiarIngrediente();
                renderLineas();
                $('#txtCodigoIngredienteFormula').focus();
            });

            $(document).on('click', '.js-remove-linea-formula', function () {
                var index = parseInt($(this).attr('data-index'), 10);
                if (isNaN(index)) return;
                state.lineas.splice(index, 1);
                renderLineas();
            });

            $('#txtCodigoElaboradoFormula').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); buscarPorCodigo($(this), function () { $('#txtCodigoIngredienteFormula').focus(); }); }
            });

            $('#txtCodigoIngredienteFormula').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); buscarPorCodigo($(this), function () { $('#txtPorcentajeFormula').focus().select(); }); }
            });

            $('#txtPorcentajeFormula').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); $('#btnAgregarLineaFormula').trigger('click'); }
            });

            $('#btnHabilitarEdicionFormula').on('click', function () {
                setReadOnly(false);
                $('#txtCodigoIngredienteFormula').focus();
            });

            updateModeLabels();
            renderLineas();
            setReadOnly(state.soloLectura);
        })();
    </script>
}
