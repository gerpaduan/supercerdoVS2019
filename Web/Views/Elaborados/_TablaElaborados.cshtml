@model Web.Models.ElaboradoIndexVm
@using System
@using System.Globalization

@{
    var cultura = CultureInfo.GetCultureInfo("es-AR");
    int totalColumnas = 7;
}

<div class="table-responsive tabla-full">
    <table class="table table-bordered table-hover mb-0">
        <thead class="thead-light">
            <tr>
                <th style="width:160px;">Fecha</th>
                <th>Sucursal</th>
                <th>Elaborado</th>
                <th class="text-right" style="width:120px;">Kgs</th>
                <th class="text-center" style="width:70px;">Obs.</th>
                <th style="width:120px;">Estado</th>
                <th style="width:220px;">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyElaborados">
            @if (Model == null || Model.Items == null || Model.Items.Count == 0)
            {
                <tr class="js-elaborado-empty-server">
                    <td colspan="@totalColumnas" class="text-center text-muted py-4">No se encontraron elaborados para los filtros seleccionados.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var rowClass = !string.IsNullOrWhiteSpace(item.Estado)
                        ? "elaborados-row-anulado"
                        : (item.EsDesarme ? "table-info" : "");
                    var detailId = "detElaborado_" + item.Id;
                    var codigo = item.Codigo;
                    var descripcion = item.Elaborado ?? "";
                    var observaciones = item.Observaciones ?? "";
                    bool esIngresoRapido = item.EsIngresoRapido;
                    var urlModificar = esIngresoRapido
                        ? Url.Action("EditarIngresoRapido", "Elaborados", new { id = item.Id, esDesarme = item.EsDesarme })
                        : Url.Action("Carga", "Elaborados", new { id = item.Id });

                    <tr class="@rowClass js-elaborado-row"
                        data-elaborado="@((descripcion ?? "").ToLowerInvariant())"
                        data-codigo="@codigo"
                        data-kgs="@item.Kgs.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-observaciones="@((observaciones ?? "").ToLowerInvariant())"
                        data-estado="@((item.Estado ?? "").ToLowerInvariant())"
                        data-detail-id="@detailId">
                        <td>@(item.Fecha == DateTime.MinValue ? "" : item.Fecha.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                        <td>@item.Sucursal</td>
                        <td>
                            <div class="font-weight-bold">@descripcion</div>
                            <div class="elaborados-codigo-inline">cod: @(codigo > 0 ? codigo.ToString() : "-")</div>
                        </td>
                        <td class="text-right">@item.Kgs.ToString("N3", cultura)</td>
                        <td class="text-center">
                            @if (!string.IsNullOrWhiteSpace(observaciones))
                            {
                                <span class="badge badge-pill badge-info" title="@observaciones">1</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Estado))
                            {
                                <span class="font-weight-bold text-danger">@item.Estado</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-left text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@urlModificar" title="Ver elaborado">
                                <i class="fas fa-eye"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-link text-decoration-none btn-detalles-elaborado"
                                    data-target="#@detailId"
                                    aria-expanded="false"
                                    aria-controls="@detailId"
                                    title="Detalles"
                                    aria-label="Detalles">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </td>
                    </tr>
                    <tr class="js-elaborado-detail-row" data-parent-detail-id="@detailId">
                        <td colspan="@totalColumnas" class="p-0">
                            <div id="@detailId" class="collapse elaborado-detalle-collapse">
                                <div class="p-3 border-top elaborados-detalle-wrap">
                                    <div class="js-elaborado-detalle-container text-muted"
                                         data-elaborado-id="@item.Id"
                                         data-loaded="false">
                                        Cargando detalles...
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<style>
    .elaborados-page .tabla-full .table {
        font-size: .84rem;
    }

    .elaborados-page .tabla-full .table th,
    .elaborados-page .tabla-full .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .elaborados-page .tabla-full .table thead th,
    .elaborados-page .tabla-full .table > thead > tr > th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    .elaborados-page .tabla-full .btn-sm {
        padding: .18rem .42rem;
        line-height: 1.15;
    }

    .elaborados-page .elaborados-codigo-inline {
        font-size: .72rem;
        color: #6c757d;
        line-height: 1.1;
        margin-top: .12rem;
    }

    .elaborados-page .elaborados-row-anulado > td {
        background-color: #fff3cd;
    }

    .elaborados-page .elaborados-detalle-wrap {
        background-color: #f8f9fa;
    }

    html.dark-mode .elaborados-page .elaborados-row-anulado > td,
    body.dark-mode .elaborados-page .elaborados-row-anulado > td {
        background-color: #5c4712;
        color: #f3f4f6;
    }

    html.dark-mode .elaborados-page .elaborados-row-anulado .font-weight-bold,
    html.dark-mode .elaborados-page .elaborados-row-anulado .text-muted,
    html.dark-mode .elaborados-page .elaborados-row-anulado .elaborados-codigo-inline,
    body.dark-mode .elaborados-page .elaborados-row-anulado .font-weight-bold,
    body.dark-mode .elaborados-page .elaborados-row-anulado .text-muted,
    body.dark-mode .elaborados-page .elaborados-row-anulado .elaborados-codigo-inline {
        color: #f3f4f6 !important;
    }

    html.dark-mode .elaborados-page .elaborados-row-anulado .badge-info,
    body.dark-mode .elaborados-page .elaborados-row-anulado .badge-info {
        background-color: #0f4c81;
        color: #eaf4ff;
    }

    html.dark-mode .elaborados-page .elaborados-detalle-wrap,
    body.dark-mode .elaborados-page .elaborados-detalle-wrap {
        background-color: #1f2937;
        border-top-color: #374151 !important;
    }

    @@media (min-width: 1200px) {
        .elaborados-page .tabla-full .table {
            font-size: .81rem;
        }

        .elaborados-page .tabla-full .table thead th,
        .elaborados-page .tabla-full .table > thead > tr > th {
            font-size: .69rem !important;
        }
    }
</style>
