@model Web.Models.ElaboradoIndexVm
@using System
@using System.Collections.Generic
@using System.Globalization

@{
    var detalles = Model != null ? Model.Detalles : new Dictionary<int, Web.Models.ElaboradoDetalleVm>();
    var cultura = CultureInfo.GetCultureInfo("es-AR");
    int totalColumnas = 8;
}

<div class="table-responsive tabla-full">
    <table class="table table-bordered table-hover mb-0">
        <thead class="thead-light">
            <tr>
                <th style="width:160px;">Fecha</th>
                <th>Sucursal</th>
                <th style="width:110px;">Código</th>
                <th>Elaborado</th>
                <th class="text-right" style="width:120px;">Kgs</th>
                <th class="text-center" style="width:70px;">Obs.</th>
                <th style="width:120px;">Estado</th>
                <th style="width:220px;">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyElaborados">
            @if (Model == null || Model.Items == null || Model.Items.Count == 0)
            {
                <tr class="js-elaborado-empty-server">
                    <td colspan="@totalColumnas" class="text-center text-muted py-4">No se encontraron elaborados para los filtros seleccionados.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var rowClass = !string.IsNullOrWhiteSpace(item.Estado)
                        ? "table-warning"
                        : (item.EsDesarme ? "table-info" : "");
                    var detalle = detalles.ContainsKey(item.Id) ? detalles[item.Id] : null;
                    var detailId = "detElaborado_" + item.Id;
                    var codigo = item.Codigo > 0 ? item.Codigo : (detalle != null ? detalle.Codigo : 0);
                    var descripcion = !string.IsNullOrWhiteSpace(item.Elaborado) ? item.Elaborado : (detalle != null ? detalle.Elaborado : "");
                    var observaciones = !string.IsNullOrWhiteSpace(item.Observaciones) ? item.Observaciones : (detalle != null ? detalle.Observaciones : "");
                    bool esIngresoRapido = item.EsIngresoRapido || (detalle != null && detalle.EsIngresoRapido);
                    var urlModificar = esIngresoRapido
                        ? Url.Action("EditarIngresoRapido", "Elaborados", new { id = item.Id, esDesarme = item.EsDesarme })
                        : Url.Action("Carga", "Elaborados", new { id = item.Id });

                    <tr class="@rowClass js-elaborado-row"
                        data-elaborado="@((descripcion ?? "").ToLowerInvariant())"
                        data-codigo="@codigo"
                        data-observaciones="@((observaciones ?? "").ToLowerInvariant())"
                        data-estado="@((item.Estado ?? "").ToLowerInvariant())"
                        data-detail-id="@detailId">
                        <td>@(item.Fecha == DateTime.MinValue ? "" : item.Fecha.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                        <td>@item.Sucursal</td>
                        <td>@(codigo > 0 ? codigo.ToString() : "-")</td>
                        <td>@descripcion</td>
                        <td class="text-right">@item.Kgs.ToString("N3", cultura)</td>
                        <td class="text-center">
                            @if (!string.IsNullOrWhiteSpace(observaciones))
                            {
                                <span class="badge badge-pill badge-info" title="@observaciones">1</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Estado))
                            {
                                <span class="font-weight-bold text-danger">@item.Estado</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@urlModificar">
                                Modificar
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-link text-decoration-none btn-detalles-elaborado"
                                    data-target="#@detailId"
                                    aria-expanded="false"
                                    aria-controls="@detailId">
                                <i class="fas fa-chevron-down"></i> Detalles
                            </button>
                        </td>
                    </tr>
                    <tr class="js-elaborado-detail-row" data-parent-detail-id="@detailId">
                        <td colspan="@totalColumnas" class="p-0">
                            <div id="@detailId" class="collapse elaborado-detalle-collapse">
                                <div class="p-3 bg-light border-top">
                                    @if (detalle == null)
                                    {
                                        <div class="text-muted">No se pudieron cargar los detalles del elaborado.</div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-12 col-lg-6">
                                                <div class="mb-2"><span class="text-muted">ID del registro:</span> <span class="font-weight-bold">@detalle.Id</span></div>
                                                <div class="mb-2"><span class="text-muted">Elaborado:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Elaborado) ? detalle.Elaborado : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Código:</span> <span class="font-weight-bold">@(detalle.Codigo > 0 ? detalle.Codigo.ToString() : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Observaciones:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Observaciones) ? detalle.Observaciones : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Receta:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Receta) ? detalle.Receta : "-")</span></div>
                                            </div>
                                            <div class="col-12 col-lg-6">
                                                <div class="mb-2"><span class="text-muted">Quién lo creó:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.UsuarioCreacion) ? detalle.UsuarioCreacion : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Fecha de creación:</span> <span class="font-weight-bold">@(detalle.FechaCreacion.HasValue ? detalle.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Quién lo actualizó:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.UsuarioActualizacion) ? detalle.UsuarioActualizacion : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Fecha de actualización:</span> <span class="font-weight-bold">@(detalle.FechaActualizacion.HasValue ? detalle.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Sucursal:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Sucursal) ? detalle.Sucursal : "-")</span></div>
                                                <div class="mb-2"><span class="text-muted">Estado:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Estado) ? detalle.Estado : "-")</span></div>
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            <div class="text-muted text-uppercase small font-weight-bold mb-2">Ingredientes utilizados</div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered mb-0">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th style="width:120px;">Código</th>
                                                            <th>Producto</th>
                                                            <th class="text-right" style="width:120px;">Kgs</th>
                                                            <th class="text-center" style="width:90px;">Balanza</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (detalle.IngredientesUtilizados == null || detalle.IngredientesUtilizados.Count == 0)
                                                        {
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted">No se encontraron ingredientes utilizados.</td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            foreach (var linea in detalle.IngredientesUtilizados)
                                                            {
                                                                <tr>
                                                                    <td>@(linea.Codigo > 0 ? linea.Codigo.ToString() : "-")</td>
                                                                    <td>@(!string.IsNullOrWhiteSpace(linea.Producto) ? linea.Producto : "-")</td>
                                                                    <td class="text-right">@linea.Kgs.ToString("N3", cultura)</td>
                                                                    <td class="text-center">@(linea.PesoBalanza ? "Sí" : "No")</td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
