@model Web.Models.ElaboradoDetalleVm
@using System.Globalization

@{
    var cultura = CultureInfo.GetCultureInfo("es-AR");
}

@if (Model == null)
{
    <div class="text-muted">No se pudieron cargar los detalles del elaborado.</div>
}
else
{
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="mb-2"><span class="text-muted">ID del registro:</span> <span class="font-weight-bold">@Model.Id</span></div>
            <div class="mb-2"><span class="text-muted">Elaborado:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.Elaborado) ? Model.Elaborado : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Código:</span> <span class="font-weight-bold">@(Model.Codigo > 0 ? Model.Codigo.ToString() : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Observaciones:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.Observaciones) ? Model.Observaciones : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Receta:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.Receta) ? Model.Receta : "-")</span></div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="mb-2"><span class="text-muted">Quién lo creó:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.UsuarioCreacion) ? Model.UsuarioCreacion : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Fecha de creación:</span> <span class="font-weight-bold">@(Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Quién lo actualizó:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) ? Model.UsuarioActualizacion : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Fecha de actualización:</span> <span class="font-weight-bold">@(Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Sucursal:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.Sucursal) ? Model.Sucursal : "-")</span></div>
            <div class="mb-2"><span class="text-muted">Estado:</span> <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.Estado) ? Model.Estado : "-")</span></div>
        </div>
    </div>

    <div class="mt-3">
        <div class="text-muted text-uppercase small font-weight-bold mb-2">Ingredientes utilizados</div>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width:120px;">Código</th>
                        <th>Producto</th>
                        <th class="text-right" style="width:120px;">Kgs</th>
                        <th class="text-center" style="width:90px;">Balanza</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.IngredientesUtilizados == null || Model.IngredientesUtilizados.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No se encontraron ingredientes utilizados.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var linea in Model.IngredientesUtilizados)
                        {
                            <tr>
                                <td>@(linea.Codigo > 0 ? linea.Codigo.ToString() : "-")</td>
                                <td>@(!string.IsNullOrWhiteSpace(linea.Producto) ? linea.Producto : "-")</td>
                                <td class="text-right">@linea.Kgs.ToString("N3", cultura)</td>
                                <td class="text-center">@(linea.PesoBalanza ? "Sí" : "No")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
