@model Web.Models.ElaboradoIndexVm
@using System
@using System.Collections.Generic
@using System.Globalization
@using Entidades

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = "Elaborados";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    var cultura = CultureInfo.GetCultureInfo("es-AR");
    string successMessage = TempData["ElaboradosSuccessMessage"] as string ?? "";
    string alertaPermisoFecha = ViewBag.AlertaPermisoFecha as string ?? "";
}

<div class="container-fluid px-2 px-md-3 elaborados-page"
     data-elaborados-page="index"
     data-detalle-url="@Url.Action("Detalle", "Elaborados")">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div id="elaboradosSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(alertaPermisoFecha))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @alertaPermisoFecha
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Elaborados")" id="formFiltrosElaborados">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Cambiaste sucursal o fechas. Presioná <strong>Buscar</strong> para actualizar la búsqueda.
                </div>

                <div class="elaborados-filtros-grid">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="idSucursal">Sucursal</label>
                        <select id="idSucursal" name="idSucursal" class="form-control js-filtro-recarga">
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="elaborado">Nombre elaborado</label>
                        <input id="elaborado" name="elaborado" type="text" class="form-control js-filtro-vivo-elaborados" value="@Model.Elaborado" autocomplete="off" />
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="fechaDesde">Fecha desde</label>
                        <input id="fechaDesde" name="fechaDesde" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                        @Html.Partial("_AdvertenciaPermisoFecha")
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="fechaHasta">Fecha hasta</label>
                        <input id="fechaHasta" name="fechaHasta" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>

                    <div class="form-group mb-0 elaborados-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block" id="btnBuscarElaborados">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                        </button>
                    </div>
                </div>

                <div class="mt-2">
                    <div id="estadoBusquedaElaborados" class="text-muted small">Resultados actualizados.</div>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 col-md-4">
            <div class="card border-left-primary shadow-sm h-100 elaborados-total-card">
                <div class="card-body">
                    <div class="elaborados-total-label text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg</div>
                    <div class="elaborados-total-value font-weight-bold text-gray-800" id="lblTotalKgElaborados">@Model.TotalKg.ToString("N3", cultura)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end align-items-center mb-2">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="switchVistaCompletaElaborados">
            <label class="custom-control-label" for="switchVistaCompletaElaborados">Ver detalles</label>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @Html.Partial("~/Views/Elaborados/_TablaElaborados.cshtml", Model)
        </div>
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

@section Scripts {
    <script>
        (function () {
            document.addEventListener("keydown", function (event) {
                if (!event.altKey) return;

                var target = event.target;
                var tagName = target && target.tagName ? target.tagName.toUpperCase() : "";
                var isEditable = target && (target.isContentEditable || tagName === "INPUT" || tagName === "TEXTAREA" || tagName === "SELECT");
                if (isEditable) return;

                var key = (event.key || "").toLowerCase();
                if (key === "n" || key === "enter") {
                    event.preventDefault();
                    window.location.href = '@Url.Action("Carga", "Elaborados")';
                } else if (key === "v") {
                    event.preventDefault();
                    window.location.href = '@Url.Action("Lineas", "Elaborados")';
                }
            });

            var storageKey = "elaborados_index_filters_v1";
            var restoreKey = "elaborados_restore_enabled_v1";
            var form = document.getElementById('formFiltrosElaborados');
            var inputFechaDesde = document.getElementById('fechaDesde');
            var inputFechaHasta = document.getElementById('fechaHasta');
            var inputSucursal = document.getElementById('idSucursal');
            var inputElaborado = document.getElementById('elaborado');
            var fechaDesdeDefault = '@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")';

            function limpiarStorageElaborados() {
                if (!window.sessionStorage) return;
                window.sessionStorage.removeItem(storageKey);
                window.sessionStorage.removeItem("elaborados_lineas_filters_v1");
                window.sessionStorage.removeItem(restoreKey);
            }

            function vieneDesdeModuloElaborados() {
                if (!document.referrer) return false;

                try {
                    var refUrl = new URL(document.referrer);
                    return refUrl.origin === window.location.origin
                        && /\/Elaborados(\/|$)/i.test(refUrl.pathname || "");
                } catch (e) {
                    return false;
                }
            }

            function buildState() {
                return {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : "",
                    idSucursal: inputSucursal ? inputSucursal.value : "",
                    elaborado: inputElaborado ? inputElaborado.value : ""
                };
            }

            function saveState() {
                if (!form || !window.sessionStorage) return;
                window.sessionStorage.setItem(storageKey, JSON.stringify(buildState()));
            }

            function restoreStateIfNeeded() {
                if (!form || !window.sessionStorage || window.location.search) return;
                if (window.sessionStorage.getItem(restoreKey) !== "1") {
                    if (!vieneDesdeModuloElaborados()) {
                        limpiarStorageElaborados();
                    }
                    return;
                }

                var raw = window.sessionStorage.getItem(storageKey);
                window.sessionStorage.removeItem(restoreKey);
                if (!raw) return;

                try {
                    var state = JSON.parse(raw);
                    var params = new URLSearchParams();
                    if (state.idSucursal) params.set("idSucursal", state.idSucursal);
                    if (state.elaborado) params.set("elaborado", state.elaborado);
                    if (state.fechaDesde && state.fechaDesde >= fechaDesdeDefault) params.set("fechaDesde", state.fechaDesde);
                    if (state.fechaHasta) params.set("fechaHasta", state.fechaHasta);

                    var query = params.toString();
                    if (query) {
                        window.location.replace(form.action + "?" + query);
                    }
                } catch (e) {
                    limpiarStorageElaborados();
                }
            }

            restoreStateIfNeeded();
            saveState();

            if (form) {
                form.addEventListener("submit", function () {
                    saveState();
                    var btnBuscar = document.getElementById("btnBuscarElaborados");
                    var btnTexto = btnBuscar ? btnBuscar.querySelector(".btn-buscar-texto") : null;
                    var estado = document.getElementById("estadoBusquedaElaborados");
                    var alerta = document.getElementById("alertaFiltrosPendientes");

                    if (btnBuscar) {
                        btnBuscar.disabled = true;
                    }

                    if (btnTexto) {
                        btnTexto.textContent = " Cargando...";
                    }

                    if (estado) {
                        estado.textContent = "Actualizando búsqueda...";
                    }

                    if (alerta) {
                        alerta.classList.add("d-none");
                    }
                });
                form.querySelectorAll("input, select").forEach(function (el) {
                    el.addEventListener("change", saveState);
                    el.addEventListener("input", saveState);
                });
            }

            var successAlert = document.getElementById('elaboradosSuccessAlert');
            if (successAlert) {
                window.setTimeout(function () {
                    $(successAlert).alert('close');
                }, 3000);
            }
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/elaborados.js?v=2")"></script>
}
