@model Web.Models.ElaboradoLineasIndexVm
@using System
@using System.Collections.Generic
@using Entidades

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = "Lineas de elaborado";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    string alertaPermisoFecha = ViewBag.AlertaPermisoFecha as string ?? "";
}

<div class="container-fluid px-2 px-md-3 elaborados-page" data-elaborados-page="lineas">
    @if (!string.IsNullOrWhiteSpace(alertaPermisoFecha))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @alertaPermisoFecha
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Lineas", "Elaborados")" id="formFiltrosLineasElaborados">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Cambiaste sucursal o fechas. Presiona <strong>Buscar</strong> para actualizar la busqueda.
                </div>

                <div class="elaborados-filtros-grid">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="idSucursal">Sucursal</label>
                        <select id="idSucursal" name="idSucursal" class="form-control js-filtro-recarga">
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" @(sucursal.IdSucursal == Model.IdSucursal ? "selected" : "")>@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="descripcion">Descripcion</label>
                        <input id="descripcion" name="descripcion" type="text" class="form-control js-filtro-vivo-lineas" value="@Model.Descripcion" autocomplete="off" />
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="fechaDesde">Fecha desde</label>
                        <input id="fechaDesde" name="fechaDesde" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                        @Html.Partial("_AdvertenciaPermisoFecha")
                    </div>

                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="fechaHasta">Fecha hasta</label>
                        <input id="fechaHasta" name="fechaHasta" type="datetime-local" step="1" class="form-control js-filtro-recarga" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>

                    <div class="form-group mb-0 elaborados-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block" id="btnBuscarLineasElaborados">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>

                <div class="custom-control custom-switch mt-3">
                    <input type="checkbox" class="custom-control-input" id="soloIngredientes" />
                    <label class="custom-control-label" for="soloIngredientes">Filtrar solo ingredientes</label>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 col-md-4">
            <div class="card border-left-primary shadow-sm h-100 elaborados-total-card elaborados-summary-card">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg lineas</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalKg.ToString("N3")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm elaborados-panel-card">
        <div class="card-body p-0">
            <div class="table-responsive js-sync-scroll-body">
                <table class="table table-hover mb-0 elaborados-table-compact">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:150px;">Fecha</th>
                            <th>Sucursal</th>
                            <th style="width:110px;">Cod.Elab</th>
                            <th>Elaborado</th>
                            <th style="width:110px;">Cod.Ingr.</th>
                            <th>Ingrediente</th>
                            <th class="text-right" style="width:110px;">Cant.</th>
                            <th style="width:120px;">Estado</th>
                            <th style="width:140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyLineasElaborados">
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr class="js-linea-empty-server">
                                <td colspan="9" class="text-center text-muted py-4">No se encontraron lineas para los filtros seleccionados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                var urlSeleccion = item.EsIngresoRapido
                                    ? Url.Action("EditarIngresoRapido", "Elaborados", new { id = item.Id, esDesarme = item.EsDesarme })
                                    : Url.Action("Carga", "Elaborados", new { id = item.Id });
                                <tr class="@(!string.IsNullOrWhiteSpace(item.Estado) ? "table-warning" : "") js-linea-row"
                                    data-elaborado="@((item.Elaborado ?? "").ToLowerInvariant())"
                                    data-ingrediente="@((item.Ingrediente ?? "").ToLowerInvariant())"
                                    data-cod-elaborado="@item.CodigoElaborado"
                                    data-cod-ingrediente="@item.CodigoIngrediente"
                                    data-estado="@((item.Estado ?? "").ToLowerInvariant())">
                                    <td>@(item.Fecha == DateTime.MinValue ? "" : item.Fecha.ToString("dd/MM/yyyy HH:mm"))</td>
                                    <td>@item.Sucursal</td>
                                    <td>@item.CodigoElaborado</td>
                                    <td>@item.Elaborado</td>
                                    <td>@item.CodigoIngrediente</td>
                                    <td>@item.Ingrediente</td>
                                    <td class="text-right">@item.Kgs.ToString("N3")</td>
                                    <td>@item.Estado</td>
                                    <td class="text-left elaborados-table-actions">
                                        <a class="btn btn-sm btn-outline-primary" href="@urlSeleccion">Seleccionar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

@section Scripts {
    <script>
        (function () {
            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                    window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
                }
            }

            function navegarConLoader(url, useReplace) {
                if (!url) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    if (useReplace) {
                        window.location.replace(url);
                    } else {
                        window.location.href = url;
                    }
                }, 0);
            }

            function submitConLoader() {
                showNavigationLoading("Cargando solicitud...");
            }

            var storageKey = "elaborados_lineas_filters_v1";
            var restoreKey = "elaborados_restore_enabled_v1";
            var form = document.getElementById('formFiltrosLineasElaborados');
            var inputFechaDesde = document.getElementById('fechaDesde');
            var inputFechaHasta = document.getElementById('fechaHasta');
            var inputSucursal = document.getElementById('idSucursal');
            var inputDescripcion = document.getElementById('descripcion');
            var fechaDesdeDefault = '@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")';

            function limpiarStorageElaborados() {
                if (!window.sessionStorage) return;
                window.sessionStorage.removeItem("elaborados_index_filters_v1");
                window.sessionStorage.removeItem(storageKey);
                window.sessionStorage.removeItem(restoreKey);
            }

            function vieneDesdeModuloElaborados() {
                if (!document.referrer) return false;

                try {
                    var refUrl = new URL(document.referrer);
                    return refUrl.origin === window.location.origin
                        && /\/Elaborados(\/|$)/i.test(refUrl.pathname || "");
                } catch (e) {
                    return false;
                }
            }

            function buildState() {
                return {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : "",
                    idSucursal: inputSucursal ? inputSucursal.value : "",
                    descripcion: inputDescripcion ? inputDescripcion.value : ""
                };
            }

            function saveState() {
                if (!form || !window.sessionStorage) return;
                window.sessionStorage.setItem(storageKey, JSON.stringify(buildState()));
            }

            function restoreStateIfNeeded() {
                if (!form || !window.sessionStorage || window.location.search) return;
                if (window.sessionStorage.getItem(restoreKey) !== "1") {
                    if (!vieneDesdeModuloElaborados()) {
                        limpiarStorageElaborados();
                    }
                    return;
                }

                var raw = window.sessionStorage.getItem(storageKey);
                window.sessionStorage.removeItem(restoreKey);
                if (!raw) return;

                try {
                    var state = JSON.parse(raw);
                    var params = new URLSearchParams();
                    if (state.idSucursal) params.set("idSucursal", state.idSucursal);
                    if (state.descripcion) params.set("descripcion", state.descripcion);
                    if (state.fechaDesde && state.fechaDesde >= fechaDesdeDefault) params.set("fechaDesde", state.fechaDesde);
                    if (state.fechaHasta) params.set("fechaHasta", state.fechaHasta);

                    var query = params.toString();
                    if (query) {
                        navegarConLoader(form.action + "?" + query, true);
                    }
                } catch (e) {
                    limpiarStorageElaborados();
                }
            }

            restoreStateIfNeeded();
            saveState();

            if (form) {
                form.addEventListener("submit", function () {
                    saveState();
                    submitConLoader();
                });
                form.querySelectorAll("input, select").forEach(function (el) {
                    el.addEventListener("change", saveState);
                    el.addEventListener("input", saveState);
                });
            }

            document.addEventListener("click", function (event) {
                var link = event.target.closest ? event.target.closest('.elaborados-page a[href]') : null;
                if (!link) return;
                if (link.target === "_blank" || link.hasAttribute("download")) return;

                var href = link.getAttribute("href") || "";
                if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

                event.preventDefault();
                navegarConLoader(link.href, false);
            });
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/elaborados.js?v=2")"></script>
}
