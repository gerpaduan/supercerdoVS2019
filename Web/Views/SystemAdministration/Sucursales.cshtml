@model Web.Models.SystemAdministrationSucursalIndexVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="sysadmin-sucursales-page">
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
    <div>
        <h4 class="mb-1">Sucursales</h4>
        <p class="text-muted mb-0">Administracion de sucursales asociadas a cada empresa.</p>
    </div>
    <a class="btn btn-primary mt-3 mt-md-0" href="@Url.Action("EditarSucursal", "SystemAdministration", new { idEmpresa = Model.FiltroEmpresaId })">
        <i class="fas fa-plus mr-1"></i>Nueva sucursal
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="form-group col-md-5 mb-0">
                <label>Empresa</label>
                @Html.DropDownListFor(m => m.FiltroEmpresaId, Model.Empresas, new { @class = "form-control", id = "filtroEmpresaSucursales" })
            </div>
            <div class="form-group col-md-4 mb-0">
                <label>Sucursal</label>
                <input type="text" class="form-control" id="filtroSucursalTexto" placeholder="Buscar por sucursal..." autocomplete="off" />
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Sucursal</th>
                        <th>Direccion</th>
                        <th>Localidad</th>
                        <th>Pto. venta</th>
                        @if (Model.TieneTelefono)
                        {
                            <th>Telefono</th>
                        }
                        @if (Model.TieneActiva)
                        {
                            <th>Estado</th>
                        }
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@(Model.TieneTelefono && Model.TieneActiva ? 8 : (Model.TieneTelefono || Model.TieneActiva ? 7 : 6))" class="text-center text-muted py-4">
                                No hay sucursales cargadas para el filtro seleccionado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr data-id-empresa="@item.IdEmpresa" data-sucursal="@((item.Sucursal ?? "").ToLowerInvariant())">
                                <td>@item.EmpresaNombre</td>
                                <td>@item.Sucursal</td>
                                <td>@item.Direccion</td>
                                <td>@item.Localidad</td>
                                <td>@(item.CodPuntoVentaAfip > 0 ? item.CodPuntoVentaAfip.ToString() : "-")</td>
                                @if (Model.TieneTelefono)
                                {
                                    <td>@item.Telefono</td>
                                }
                                @if (Model.TieneActiva)
                                {
                                    <td>
                                        <span class="badge @(item.Activa ? "badge-success" : "badge-secondary")">
                                            @(item.Activa ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                }
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditarSucursal", "SystemAdministration", new { id = item.IdSucursal })">Editar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

<style>
    .sysadmin-sucursales-page {
        font-size: .9rem;
    }

    .sysadmin-sucursales-page .card-body {
        padding: .82rem 1rem;
    }

    .sysadmin-sucursales-page .form-control,
    .sysadmin-sucursales-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .sysadmin-sucursales-page label,
    .sysadmin-sucursales-page .col-form-label {
        font-size: .8rem;
    }

    .sysadmin-sucursales-page .alert,
    .sysadmin-sucursales-page .small,
    .sysadmin-sucursales-page .text-muted,
    .sysadmin-sucursales-page .form-text {
        font-size: .8rem !important;
    }

    .sysadmin-sucursales-page .table {
        font-size: .84rem;
    }

    .sysadmin-sucursales-page .table th,
    .sysadmin-sucursales-page .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .sysadmin-sucursales-page .table thead th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    @@media (min-width: 1200px) {
        .sysadmin-sucursales-page .form-control,
        .sysadmin-sucursales-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }

        .sysadmin-sucursales-page .table {
            font-size: .81rem;
        }

        .sysadmin-sucursales-page .table thead th {
            font-size: .69rem !important;
        }
    }
</style>

@section Scripts {
<script>
    (function () {
        // Filtros por empresa + texto de sucursal, 100% en vivo (cliente): el server siempre
        // trae todas las sucursales (ver SystemAdministrationController.Sucursales) marcadas
        // con data-id-empresa/data-sucursal -- este script solo oculta/muestra filas, sin ida
        // al servidor. Ambos filtros se combinan con AND.
        // Va en la seccion Scripts (se renderiza despues de jquery.min.js en _LayoutBase.cshtml) --
        // si fuera un script suelto mas arriba en el body, $ todavia no existiria al ejecutarse.
        var $select = $("#filtroEmpresaSucursales");
        var $texto = $("#filtroSucursalTexto");
        var $tbody = $(".sysadmin-sucursales-page tbody").first();
        var colspan = @(Model.TieneTelefono && Model.TieneActiva ? 8 : (Model.TieneTelefono || Model.TieneActiva ? 7 : 6));

        function aplicarFiltros() {
            var idEmpresa = $select.val() || "0";
            var texto = ($texto.val() || "").toLowerCase().trim();
            var visibles = 0;

            $tbody.find("tr[data-id-empresa]").each(function () {
                var $fila = $(this);
                var visible = idEmpresa === "0" || $fila.attr("data-id-empresa") === idEmpresa;

                if (visible && texto) {
                    visible = ($fila.attr("data-sucursal") || "").indexOf(texto) >= 0;
                }

                $fila.toggleClass("d-none", !visible);
                if (visible) visibles += 1;
            });

            $tbody.find(".sysadmin-sucursales-empty-filter").remove();
            if (visibles === 0 && $tbody.find("tr[data-id-empresa]").length > 0) {
                $tbody.append('<tr class="sysadmin-sucursales-empty-filter"><td colspan="' + colspan + '" class="text-center text-muted py-4">No hay sucursales para el filtro seleccionado.</td></tr>');
            }
        }

        $select.on("change", aplicarFiltros);
        $texto.on("input", aplicarFiltros);
        aplicarFiltros();
    })();
</script>
}
