@model Web.Models.SystemAdministrationUsuarioEditVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="card shadow-sm sysadmin-editar-usuario-page">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">@(Model.EsEdicion ? "Modificar usuario" : "Nuevo usuario")</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Usuarios", "SystemAdministration", new { idEmpresa = Model.IdEmpresa })">
            <i class="fas fa-arrow-left mr-1"></i>Volver
        </a>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("GuardarUsuario", "SystemAdministration", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="validation-summary-valid text-danger mb-3" data-valmsg-summary="true">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Empresa</label>
                    @Html.DropDownListFor(m => m.IdEmpresa, Model.Empresas, "Seleccione empresa", new { @class = "form-control", id = "IdEmpresa" })
                    @Html.ValidationMessageFor(m => m.IdEmpresa, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-4">
                    <label>Sucursal</label>
                    @Html.DropDownListFor(m => m.IdSucursalUser, Model.Sucursales, "Sin sucursal por defecto", new { @class = "form-control", id = "IdSucursalUser" })
                </div>
                <div class="form-group col-md-4">
                    <label>Nombre</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Usuario</label>
                    @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-4">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-2">
                    <label>Clave</label>
                    @Html.PasswordFor(m => m.Clave, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-2">
                    <label>Confirmar clave</label>
                    @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <div class="custom-control custom-switch mt-4">
                        @Html.CheckBoxFor(m => m.Admin, new { @class = "custom-control-input" })
                        <label class="custom-control-label" for="Admin">Administrador</label>
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <div class="custom-control custom-switch mt-4">
                        @Html.CheckBoxFor(m => m.Activo, new { @class = "custom-control-input" })
                        <label class="custom-control-label" for="Activo">Activo</label>
                    </div>
                </div>
                <div class="form-group col-md-4">
                    <div class="custom-control custom-switch mt-4">
                        @Html.CheckBoxFor(m => m.PermitirLoginFueraSucursal, new { @class = "custom-control-input" })
                        <label class="custom-control-label" for="PermitirLoginFueraSucursal">Permitir login fuera de sucursal</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Guardar usuario</button>
            </div>
        }
    </div>
</div>

<style>
    .sysadmin-editar-usuario-page {
        font-size: .9rem;
    }

    .sysadmin-editar-usuario-page .card-body {
        padding: .82rem 1rem;
    }

    .sysadmin-editar-usuario-page .form-control,
    .sysadmin-editar-usuario-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .sysadmin-editar-usuario-page label,
    .sysadmin-editar-usuario-page .col-form-label {
        font-size: .8rem;
    }

    .sysadmin-editar-usuario-page .alert,
    .sysadmin-editar-usuario-page .small,
    .sysadmin-editar-usuario-page .text-muted,
    .sysadmin-editar-usuario-page .form-text {
        font-size: .8rem !important;
    }

    @@media (min-width: 1200px) {
        .sysadmin-editar-usuario-page .form-control,
        .sysadmin-editar-usuario-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }
    }
</style>

<script>
    (function () {
        var empresa = document.getElementById("IdEmpresa");
        var sucursal = document.getElementById("IdSucursalUser");
        if (!empresa || !sucursal) {
            return;
        }

        empresa.addEventListener("change", function () {
            var idEmpresa = empresa.value || "0";
            fetch('@Url.Action("SucursalesPorEmpresa", "SystemAdministration")?idEmpresa=' + encodeURIComponent(idEmpresa), {
                credentials: 'same-origin'
            })
                .then(function (r) { return r.json(); })
                .then(function (items) {
                    sucursal.innerHTML = '<option value="0">Sin sucursal por defecto</option>';
                    (items || []).forEach(function (item) {
                        var option = document.createElement("option");
                        option.value = item.value;
                        option.textContent = item.text;
                        sucursal.appendChild(option);
                    });
                });
        });
    })();
</script>
