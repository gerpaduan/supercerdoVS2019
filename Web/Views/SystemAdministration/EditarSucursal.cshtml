@model Web.Models.SystemAdministrationSucursalEditVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">@(Model.EsEdicion ? "Modificar sucursal" : "Nueva sucursal")</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Sucursales", "SystemAdministration", new { idEmpresa = Model.IdEmpresa })">
            <i class="fas fa-arrow-left mr-1"></i>Volver
        </a>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("GuardarSucursal", "SystemAdministration", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdSucursal)

            <div class="validation-summary-valid text-danger mb-3" data-valmsg-summary="true">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-5">
                    <label>Empresa</label>
                    @Html.DropDownListFor(m => m.IdEmpresa, Model.Empresas, "Seleccione empresa", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.IdEmpresa, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-4">
                    <label>Sucursal</label>
                    @Html.TextBoxFor(m => m.Sucursal, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Sucursal, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-3">
                    <label>Punto de venta AFIP</label>
                    @Html.TextBoxFor(m => m.CodPuntoVentaAfip, new { @class = "form-control", type = "number", min = "0" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-5">
                    <label>Direccion</label>
                    @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-3">
                    <label>Localidad</label>
                    @Html.TextBoxFor(m => m.Localidad, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-2">
                    <label>Provincia</label>
                    @Html.TextBoxFor(m => m.Provincia, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-2">
                    <label>Pais</label>
                    @Html.TextBoxFor(m => m.Pais, new { @class = "form-control" })
                </div>
            </div>

            if (Model.TieneTelefono || Model.TieneActiva)
            {
                <div class="form-row">
                    @if (Model.TieneTelefono)
                    {
                        <div class="form-group col-md-4">
                            <label>Telefono</label>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                        </div>
                    }

                    @if (Model.TieneActiva)
                    {
                        <div class="form-group col-md-4">
                            <div class="custom-control custom-switch mt-4">
                                @Html.CheckBoxFor(m => m.Activa, new { @class = "custom-control-input" })
                                <label class="custom-control-label" for="Activa">Sucursal activa</label>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="form-group">
                <label>Observaciones</label>
                @Html.TextAreaFor(m => m.Observaciones, 3, 1, new { @class = "form-control" })
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Guardar sucursal</button>
            </div>
        }
    </div>
</div>
