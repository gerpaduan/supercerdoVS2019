@model Web.Models.SystemAdministrationAltaRapidaVm
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Alta rapida de empresa</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Empresas", "SystemAdministration")">
            <i class="fas fa-arrow-left mr-1"></i>Volver
        </a>
    </div>
    <div class="card-body">
        <p class="text-muted">En una sola pantalla podes crear la empresa, la primera sucursal y el usuario administrador inicial.</p>

        @using (Html.BeginForm("GuardarAltaRapidaEmpresa", "SystemAdministration", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="validation-summary-valid text-danger mb-3" data-valmsg-summary="true">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>

            <div class="border rounded p-3 mb-4">
                <h6 class="font-weight-bold text-primary mb-3">Datos de empresa</h6>
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label>Razon social</label>
                        @Html.TextBoxFor(m => m.Empresa.RazonSocialAfip, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>CUIT</label>
                        @Html.TextBoxFor(m => m.Empresa.Cuit, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-4">
                        <label>Condicion IVA</label>
                        @Html.TextBoxFor(m => m.Empresa.CondicionIVA, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Nombre fantasia</label>
                        @Html.TextBoxFor(m => m.Empresa.NombreFantasia, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-4">
                        <label>Domicilio</label>
                        @Html.TextBoxFor(m => m.Empresa.Domicilio, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-2">
                        <label>Telefono</label>
                        @Html.TextBoxFor(m => m.Empresa.Telefono, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-2">
                        <label>Email</label>
                        @Html.TextBoxFor(m => m.Empresa.Email, new { @class = "form-control", type = "email" })
                    </div>
                </div>
            </div>

            <div class="border rounded p-3 mb-4">
                <h6 class="font-weight-bold text-primary mb-3">Primera sucursal</h6>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Sucursal</label>
                        @Html.TextBoxFor(m => m.Sucursal.Sucursal, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-4">
                        <label>Direccion</label>
                        @Html.TextBoxFor(m => m.Sucursal.Direccion, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-2">
                        <label>Localidad</label>
                        @Html.TextBoxFor(m => m.Sucursal.Localidad, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-2">
                        <label>Pto. venta AFIP</label>
                        @Html.TextBoxFor(m => m.Sucursal.CodPuntoVentaAfip, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                </div>
                <div class="form-row">
                    @if (Model.TieneTelefonoSucursal)
                    {
                        <div class="form-group col-md-3">
                            <label>Telefono sucursal</label>
                            @Html.TextBoxFor(m => m.Sucursal.Telefono, new { @class = "form-control" })
                        </div>
                    }
                    <div class="form-group col-md-3">
                        <label>Provincia</label>
                        @Html.TextBoxFor(m => m.Sucursal.Provincia, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>Pais</label>
                        @Html.TextBoxFor(m => m.Sucursal.Pais, new { @class = "form-control" })
                    </div>
                    @if (Model.TieneActivaSucursal)
                    {
                        <div class="form-group col-md-3">
                            <div class="custom-control custom-switch mt-4">
                                @Html.CheckBoxFor(m => m.Sucursal.Activa, new { @class = "custom-control-input" })
                                <label class="custom-control-label" for="Sucursal_Activa">Sucursal activa</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="border rounded p-3 mb-4">
                <h6 class="font-weight-bold text-primary mb-3">Usuario administrador inicial</h6>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Nombre</label>
                        @Html.TextBoxFor(m => m.Usuario.Nombre, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>Usuario</label>
                        @Html.TextBoxFor(m => m.Usuario.Usuario, new { @class = "form-control", autocomplete = "off" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>Email</label>
                        @Html.TextBoxFor(m => m.Usuario.Email, new { @class = "form-control", type = "email" })
                    </div>
                    <div class="form-group col-md-2">
                        <div class="custom-control custom-switch mt-4">
                            @Html.CheckBoxFor(m => m.Usuario.Admin, new { @class = "custom-control-input" })
                            <label class="custom-control-label" for="Usuario_Admin">Administrador</label>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Clave</label>
                        @Html.PasswordFor(m => m.Usuario.Clave, new { @class = "form-control", autocomplete = "new-password" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>Confirmar clave</label>
                        @Html.PasswordFor(m => m.Usuario.ConfirmarClave, new { @class = "form-control", autocomplete = "new-password" })
                    </div>
                    <div class="form-group col-md-3">
                        <div class="custom-control custom-switch mt-4">
                            @Html.CheckBoxFor(m => m.Usuario.Activo, new { @class = "custom-control-input" })
                            <label class="custom-control-label" for="Usuario_Activo">Usuario activo</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Crear empresa completa</button>
            </div>
        }
    </div>
</div>
