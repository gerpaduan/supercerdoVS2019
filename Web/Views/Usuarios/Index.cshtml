@model Web.Models.UsuarioIndexVm

@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid usuarios-index-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        @if (Model.PuedeAdministrar)
        {
            <a class="btn btn-primary mt-2 mt-md-0" href="@Url.Action("Editar", "Usuarios")">
                <i class="fas fa-plus mr-1"></i> Crear usuario nuevo
            </a>
        }
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="row align-items-end">
                <div class="col-12 col-lg-6">
                    <label for="filtroUsuarios" class="font-weight-bold mb-1">Buscar usuario</label>
                    <div class="input-group">
                        <input type="text" id="filtroUsuarios" class="form-control" placeholder="Buscar por id, nombre, usuario o email" autocomplete="off" />
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 mt-2 mt-lg-0 text-lg-right">
                    <span id="contadorUsuarios" class="text-muted small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0" id="tablaUsuarios">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:70px;">ID</th>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th style="width:90px;">Admin</th>
                            <th style="width:90px;">Activo</th>
                            <th style="width:100px;">Bloqueado</th>
                            <th>Email</th>
                            <th style="width:130px;">ID Sucursal User</th>
                            <th style="width:110px;">ID Empresa</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">No hay usuarios para mostrar.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="js-usuario-row"
                                    data-search="@((item.Id + " " + (item.Nombre ?? "") + " " + (item.Usuario ?? "") + " " + (item.Email ?? "") + " " + item.IdEmpresa + " " + item.IdSucursalUser).ToLowerInvariant())">
                                    <td>@item.Id</td>
                                    <td>@item.Nombre</td>
                                    <td>@item.Usuario</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Admin ? "badge-success" : "badge-secondary")">@(item.Admin ? "Sí" : "No")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.Activo ? "badge-primary" : "badge-dark")">@(item.Activo ? "Sí" : "No")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Bloqueado)
                                        {
                                            <span class="badge badge-danger">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">No</span>
                                        }
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        @item.IdSucursalUser
                                        @if (!string.IsNullOrWhiteSpace(item.SucursalNombre))
                                        {
                                            <div class="small text-muted">@item.SucursalNombre</div>
                                        }
                                    </td>
                                    <td>@item.IdEmpresa</td>
                                    <td>
                                        @if (Model.PuedeAdministrar)
                                        {
                                            <a class="btn btn-sm btn-outline-primary mr-1 mb-1" href="@Url.Action("Editar", "Usuarios", new { id = item.Id })">
                                                Modificar
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary mb-1" href="@Url.Action("Permisos", "Usuarios", new { id = item.Id })">
                                                Ver permisos
                                            </a>
                                            if (item.Bloqueado)
                                            {
                                                using (Html.BeginForm("DesbloquearUsuario", "Usuarios", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("id", item.Id)
                                                    <button type="submit" class="btn btn-sm btn-outline-danger mb-1" onclick="return confirm('¿Desbloquear esta cuenta?');">
                                                        Desbloquear
                                                    </button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .usuarios-index-page .card-body {
        padding: .82rem 1rem;
    }

    .usuarios-index-page .font-weight-bold.mb-1 {
        font-size: .76rem;
        font-weight: 600 !important;
        color: #495057;
        margin-bottom: .18rem !important;
    }

    .usuarios-index-page .form-control,
    .usuarios-index-page .input-group-text {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .usuarios-index-page #contadorUsuarios {
        font-size: .8rem;
    }

    .usuarios-index-page #tablaUsuarios {
        font-size: .84rem;
    }

    .usuarios-index-page #tablaUsuarios th,
    .usuarios-index-page #tablaUsuarios td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .usuarios-index-page #tablaUsuarios thead th,
    .usuarios-index-page #tablaUsuarios > thead > tr > th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .usuarios-index-page #tablaUsuarios .btn {
        font-size: .78rem;
        padding: .23rem .5rem;
    }

    .usuarios-index-page #tablaUsuarios .badge {
        font-size: .7rem;
    }

    @@media (min-width: 1200px) {
        .usuarios-index-page .mb-3 {
            margin-bottom: .85rem !important;
        }

        .usuarios-index-page .card-body {
            padding: .7rem .85rem;
        }

        .usuarios-index-page .form-control,
        .usuarios-index-page .input-group-text {
            font-size: .84rem !important;
            min-height: 2.15rem !important;
            padding: .28rem .56rem !important;
        }

        .usuarios-index-page #tablaUsuarios {
            font-size: .8rem;
        }

        .usuarios-index-page #tablaUsuarios thead th,
        .usuarios-index-page #tablaUsuarios > thead > tr > th {
            font-size: .69rem !important;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var $filtro = $('#filtroUsuarios');
            var $rows = $('#tablaUsuarios tbody .js-usuario-row');
            var $contador = $('#contadorUsuarios');

            function aplicarFiltro() {
                var texto = ($filtro.val() || '').toLowerCase().trim();
                var visibles = 0;

                $rows.each(function () {
                    var $row = $(this);
                    var search = String($row.data('search') || '');
                    var visible = !texto || search.indexOf(texto) >= 0;
                    $row.toggleClass('d-none', !visible);
                    if (visible) visibles++;
                });

                $contador.text(visibles + ' usuario(s) visible(s)');
            }

            $filtro.on('input', aplicarFiltro);
            aplicarFiltro();
        })();
    </script>
}
