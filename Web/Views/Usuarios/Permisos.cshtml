@model Web.Models.UsuarioPermisosVm

@{
    ViewBag.Title = "Permisos de usuario";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid usuarios-permisos-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h2 class="h5 mb-0 text-muted">@Model.UsuarioNombre</h2>
        </div>
        <a class="btn btn-outline-secondary mt-2 mt-md-0" href="@Url.Action("Index", "Usuarios")">
            <i class="fas fa-arrow-left mr-1"></i> Volver al listado
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            @if (Model.SoloLectura)
            {
                <div class="alert alert-secondary">
                    La grilla se muestra en modo solo lectura porque no tiene permisos para editar usuarios.
                </div>
            }

            @using (Html.BeginForm("GuardarPermisos", "Usuarios", FormMethod.Post, new { id = "formPermisosUsuario", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdUsuario)

                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Nombre del permiso</th>
                                <th>Detalle</th>
                                <th class="text-center" style="width:95px;">Puede ver</th>
                                <th style="width:120px;">Días ver</th>
                                <th class="text-center" style="width:105px;">Puede editar</th>
                                <th style="width:120px;">Días editar</th>
                                <th style="width:140px;">Alcance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < (Model.Items != null ? Model.Items.Count : 0); i++)
                            {
                                <tr>
                                    <td>
                                        @Html.HiddenFor(m => m.Items[i].IdForm)
                                        @Html.HiddenFor(m => m.Items[i].NombrePermiso)
                                        @Html.HiddenFor(m => m.Items[i].Detalle)
                                        @Model.Items[i].NombrePermiso
                                    </td>
                                    <td>@Model.Items[i].Detalle</td>
                                    <td class="text-center align-middle">
                                        <div class="custom-control custom-switch d-inline-block">
                                            @if (Model.SoloLectura)
                                            {
                                                @Html.CheckBoxFor(m => m.Items[i].PuedeVer, new
                                                {
                                                    @class = "custom-control-input js-puede-ver",
                                                    id = "PuedeVer_" + i,
                                                    @disabled = "disabled"
                                                })
                                            }
                                            else
                                            {
                                                @Html.CheckBoxFor(m => m.Items[i].PuedeVer, new
                                                {
                                                    @class = "custom-control-input js-puede-ver",
                                                    id = "PuedeVer_" + i
                                                })
                                            }
                                            <label class="custom-control-label" for="@("PuedeVer_" + i)"></label>
                                        </div>
                                        @if (Model.SoloLectura)
                                        {
                                            @Html.HiddenFor(m => m.Items[i].PuedeVer)
                                        }
                                    </td>
                                    <td>
                                        @if (Model.SoloLectura)
                                        {
                                            @Html.TextBoxFor(m => m.Items[i].DiasVer, new
                                            {
                                                @class = "form-control form-control-sm js-dias-ver",
                                                type = "number",
                                                min = "0",
                                                @disabled = "disabled"
                                            })
                                            @Html.HiddenFor(m => m.Items[i].DiasVer)
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(m => m.Items[i].DiasVer, new
                                            {
                                                @class = "form-control form-control-sm js-dias-ver",
                                                type = "number",
                                                min = "0"
                                            })
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="custom-control custom-switch d-inline-block">
                                            @if (Model.SoloLectura)
                                            {
                                                @Html.CheckBoxFor(m => m.Items[i].PuedeEditar, new
                                                {
                                                    @class = "custom-control-input js-puede-editar",
                                                    id = "PuedeEditar_" + i,
                                                    @disabled = "disabled"
                                                })
                                            }
                                            else
                                            {
                                                @Html.CheckBoxFor(m => m.Items[i].PuedeEditar, new
                                                {
                                                    @class = "custom-control-input js-puede-editar",
                                                    id = "PuedeEditar_" + i
                                                })
                                            }
                                            <label class="custom-control-label" for="@("PuedeEditar_" + i)"></label>
                                        </div>
                                        @if (Model.SoloLectura)
                                        {
                                            @Html.HiddenFor(m => m.Items[i].PuedeEditar)
                                        }
                                    </td>
                                    <td>
                                        @if (Model.SoloLectura)
                                        {
                                            @Html.TextBoxFor(m => m.Items[i].DiasEditar, new
                                            {
                                                @class = "form-control form-control-sm js-dias-editar",
                                                type = "number",
                                                min = "0",
                                                @disabled = "disabled"
                                            })
                                            @Html.HiddenFor(m => m.Items[i].DiasEditar)
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(m => m.Items[i].DiasEditar, new
                                            {
                                                @class = "form-control form-control-sm js-dias-editar",
                                                type = "number",
                                                min = "0"
                                            })
                                        }
                                    </td>
                                    <td>
                                        @if (Model.SoloLectura)
                                        {
                                            @Html.DropDownListFor(m => m.Items[i].SoloRegistrosPropios,
                                                new List<SelectListItem>
                                                {
                                                    new SelectListItem { Text = "Propios", Value = "true", Selected = Model.Items[i].SoloRegistrosPropios },
                                                    new SelectListItem { Text = "Todos", Value = "false", Selected = !Model.Items[i].SoloRegistrosPropios }
                                                },
                                                new
                                                {
                                                    @class = "form-control form-control-sm js-alcance",
                                                    @disabled = "disabled"
                                                })
                                            @Html.HiddenFor(m => m.Items[i].SoloRegistrosPropios)
                                        }
                                        else
                                        {
                                            @Html.DropDownListFor(m => m.Items[i].SoloRegistrosPropios,
                                                new List<SelectListItem>
                                                {
                                                    new SelectListItem { Text = "Propios", Value = "true", Selected = Model.Items[i].SoloRegistrosPropios },
                                                    new SelectListItem { Text = "Todos", Value = "false", Selected = !Model.Items[i].SoloRegistrosPropios }
                                                },
                                                new
                                                {
                                                    @class = "form-control form-control-sm js-alcance"
                                                })
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (!Model.SoloLectura)
                    {
                        <button type="submit" class="btn btn-success mr-2 mb-2">
                            <i class="fas fa-save mr-1"></i> Guardar permisos
                        </button>
                    }
                    <a class="btn btn-outline-secondary mb-2" href="@Url.Action("Index", "Usuarios")">
                        Volver
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .usuarios-permisos-page {
        font-size: .9rem;
    }

    .usuarios-permisos-page .card-body {
        padding: .82rem 1rem;
    }

    .usuarios-permisos-page .form-control,
    .usuarios-permisos-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .usuarios-permisos-page .alert,
    .usuarios-permisos-page .small,
    .usuarios-permisos-page .text-muted,
    .usuarios-permisos-page .form-text {
        font-size: .8rem !important;
    }

    .usuarios-permisos-page .table {
        font-size: .84rem;
    }

    .usuarios-permisos-page .table th,
    .usuarios-permisos-page .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .usuarios-permisos-page .table thead th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    @@media (min-width: 1200px) {
        .usuarios-permisos-page .form-control,
        .usuarios-permisos-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }

        .usuarios-permisos-page .table {
            font-size: .81rem;
        }

        .usuarios-permisos-page .table thead th {
            font-size: .69rem !important;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            // idForm del formulario "Cierres de Caja" -- mismo valor hardcodeado que en
            // UsuariosController.GuardarPermisos (ahí esta el comentario completo de por
            // que no hay forma de resolverlo por clave estable desde este modelo).
            var ID_FORM_CIERRES_DE_CAJA = 9;

            function idFormDeFila($row) {
                return parseInt($row.find('input[name$=".IdForm"]').val(), 10);
            }

            function syncRow($row) {
                var puedeVer = $row.find('.js-puede-ver').is(':checked');

                // Regla de negocio: en "Cierres de Caja", Ver el historial (con su ventana
                // de dias atras) habilita tambien Editar (modificar un cierre historico),
                // con los mismos dias -- no son dos permisos independientes para este
                // formulario en particular. Se grisan Editar y Dias editar porque quedan
                // derivados de Ver, no se cargan aparte -- pero "Alcance" (Propios/Todos)
                // sigue siendo una eleccion real e independiente aunque Editar este
                // derivado, asi que se deja editable igual que en cualquier fila con
                // Editar tildado (si quedara disabled, un <select> disabled no se postea y
                // el servidor terminaria guardando "Todos" por default en vez de respetar
                // lo elegido). El server (GuardarPermisos) fuerza el mismo mirror de
                // Ver->Editar al guardar, esto es solo para que la grilla no muestre
                // temporalmente un estado que el guardado va a pisar.
                if (idFormDeFila($row) === ID_FORM_CIERRES_DE_CAJA) {
                    $row.find('.js-puede-editar').prop('checked', puedeVer).prop('disabled', true);
                    $row.find('.js-dias-editar').val(puedeVer ? $row.find('.js-dias-ver').val() : 0).prop('disabled', true);
                    $row.find('.js-alcance').prop('disabled', !puedeVer);
                    $row.find('.js-dias-ver').prop('disabled', !puedeVer);

                    if (!puedeVer) {
                        $row.find('.js-dias-ver').val(0);
                        $row.find('.js-alcance').val('true');
                    }

                    return;
                }

                var puedeEditar = $row.find('.js-puede-editar').is(':checked');

                $row.find('.js-dias-ver').prop('disabled', !puedeVer);
                $row.find('.js-dias-editar').prop('disabled', !puedeEditar);
                $row.find('.js-alcance').prop('disabled', !puedeEditar);

                if (!puedeVer) {
                    $row.find('.js-dias-ver').val(0);
                }

                if (!puedeEditar) {
                    $row.find('.js-dias-editar').val(0);
                    $row.find('.js-alcance').val('true');
                }
            }

            $('#formPermisosUsuario tbody tr').each(function () {
                syncRow($(this));
            });

            $(document).on('change', '.js-puede-ver, .js-puede-editar', function () {
                syncRow($(this).closest('tr'));
            });

            // Para Cierres de Caja, "Dias editar" espeja "Dias ver" en vivo mientras se
            // tipea, no solo al tildar/destildar el switch.
            $(document).on('input change', '.js-dias-ver', function () {
                var $row = $(this).closest('tr');
                if (idFormDeFila($row) === ID_FORM_CIERRES_DE_CAJA) {
                    syncRow($row);
                }
            });
        })();
    </script>
}
