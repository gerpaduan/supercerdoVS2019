@model System.Data.DataTable
@using System.Data
@using System.Collections.Generic
@using System.Globalization
@using System.Linq

@functions {
    string Valor(DataRow row, string columna)
    {
        if (row == null || row.Table == null || !row.Table.Columns.Contains(columna) || row[columna] == DBNull.Value)
            return "";

        return Convert.ToString(row[columna]);
    }

    string NormalizarNombreColumna(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "";

        return new string(nombre.Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            .ToArray())
            .Replace(" ", "")
            .Trim()
            .ToLowerInvariant();
    }

    string ValorFlexible(DataRow row, params string[] columnas)
    {
        if (row == null || row.Table == null || columnas == null || columnas.Length == 0)
            return "";

        foreach (string columna in columnas)
        {
            if (string.IsNullOrWhiteSpace(columna))
                continue;

            if (row.Table.Columns.Contains(columna) && row[columna] != DBNull.Value)
                return Convert.ToString(row[columna]);
        }

        foreach (DataColumn column in row.Table.Columns)
        {
            string nombreActual = NormalizarNombreColumna(column.ColumnName);

            foreach (string columna in columnas)
            {
                if (NormalizarNombreColumna(columna) == nombreActual && row[column] != DBNull.Value)
                    return Convert.ToString(row[column]);
            }
        }

        return "";
    }

    int ValorIntFlexible(DataRow row, params string[] columnas)
    {
        int valor;
        return int.TryParse(ValorFlexible(row, columnas), out valor) ? valor : 0;
    }

    string Descripcion(DataRow row)
    {
        if (row == null || row.Table == null)
            return "";

        foreach (DataColumn column in row.Table.Columns)
        {
            string nombre = column.ColumnName;
            string nombreSinAcentos = new string(nombre.Normalize(System.Text.NormalizationForm.FormD)
                .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                .ToArray());

            if (string.Equals(nombreSinAcentos, "Descripcion", StringComparison.OrdinalIgnoreCase))
                return Valor(row, nombre);
        }

        return "";
    }

    string Fecha(DataRow row, string columna)
    {
        DateTime fecha;
        return DateTime.TryParse(Valor(row, columna), out fecha) ? fecha.ToString("dd/MM/yyyy HH:mm") : Valor(row, columna);
    }

    string Monto(DataRow row)
    {
        decimal monto;
        string valor = Valor(row, "Monto");
        if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.CurrentCulture, out monto) ||
            decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out monto))
            return monto.ToString("N2");

        return valor;
    }

    string Id(DataRow row)
    {
        return Valor(row, "id");
    }

    bool EsPagoElectronico(DataRow row)
    {
        return string.Equals(Valor(row, "TipoEgresoCaja"), "Pago Electronico", StringComparison.OrdinalIgnoreCase);
    }

    bool EsCtaCte(DataRow row)
    {
        return string.Equals(Valor(row, "TipoEgresoCaja"), "Cta Cte", StringComparison.OrdinalIgnoreCase);
    }

    bool EsPagoCobro(DataRow row)
    {
        string tipo = Valor(row, "TipoEgresoCaja");
        if (string.IsNullOrWhiteSpace(tipo))
            return false;

        string tipoNormalizado = tipo.Replace(" ", "");
        return tipoNormalizado.IndexOf("Pago", StringComparison.OrdinalIgnoreCase) >= 0 &&
               tipoNormalizado.IndexOf("Cobro", StringComparison.OrdinalIgnoreCase) >= 0;
    }

    bool EsAnulacion(DataRow row)
    {
        return Descripcion(row).StartsWith("ANULACION", StringComparison.OrdinalIgnoreCase);
    }

    bool FueReemplazadoPorAnulacion(DataRow row, ISet<string> descripcionesAnuladas)
    {
        if (row == null || descripcionesAnuladas == null || descripcionesAnuladas.Count == 0)
            return false;

        return descripcionesAnuladas.Contains(Descripcion(row));
    }

    bool EsEgresoCajaModificado(DataRow row)
    {
        if (row == null)
            return false;

        if (EsPagoCobro(row) || EsCtaCte(row) || EsPagoElectronico(row) || EsAnulacion(row))
            return false;

        return !string.IsNullOrWhiteSpace(Valor(row, "Actualizado"));
    }

    string Categoria(DataRow row)
    {
        if (EsPagoCobro(row))
            return "Pago | Cobro";
        if (EsCtaCte(row))
            return "Cta Cte";
        if (EsPagoElectronico(row))
            return "Pago electronico";
        return "Egreso de caja";
    }
}

@{
    int items = Model != null ? Model.Rows.Count : 0;
    decimal total = 0;
    bool modoActividades = ViewBag.ModoActividades != null && (bool)ViewBag.ModoActividades;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    var idsModificables = ViewBag.IdsEgresosModificables as HashSet<int> ?? new HashSet<int>();
    var comprasModificables = ViewBag.ComprasModificables as Dictionary<int, int> ?? new Dictionary<int, int>();
    var descripcionesAnuladas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    string returnUrlActual = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(Request.RawUrl ?? ""));
    string sucursalActividad = ViewBag.SucursalActividad as string ?? "";

    if (Model != null && Model.Columns.Contains("Monto"))
    {
        foreach (DataRow row in Model.Rows)
        {
            decimal monto;
            string valor = Convert.ToString(row["Monto"]);
            if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.CurrentCulture, out monto) ||
                decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out monto))
            {
                total += monto;
            }

            string descripcion = Descripcion(row);
            if (descripcion.StartsWith("ANULACION:", StringComparison.OrdinalIgnoreCase))
            {
                string descripcionOriginal = descripcion.Substring("ANULACION:".Length).Trim();
                if (!string.IsNullOrWhiteSpace(descripcionOriginal))
                {
                    descripcionesAnuladas.Add(descripcionOriginal);
                }
            }
        }
    }
}

@if (!modoActividades)
{
    <div class="egresos-resumen">
        <div>
            <span class="text-muted">Items</span>
            <strong>@items</strong>
        </div>
        <div>
            <span class="text-muted">Total</span>
            <strong>$ @total.ToString("N2")</strong>
        </div>
    </div>
}

<div class="table-responsive egresos-tabla-desktop">
    <table class="table table-sm table-bordered table-hover mb-0">
        <thead class="thead-light">
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Descripcion</th>
                <th class="text-right">Monto</th>
                <th class="text-center" style="width:70px;">Detalle</th>
                <th>Sucursal</th>
                <th class="text-nowrap">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron egresos.</td>
                </tr>
            }
            else
            {
                int index = 0;
                foreach (DataRow row in Model.Rows)
                {
                    index++;
                    string id = Id(row);
                    string detalleId = "egreso_det_" + (!string.IsNullOrWhiteSpace(id) ? id : index.ToString());
                    bool esAnulacion = EsAnulacion(row);
                    bool esHistorico = !esAnulacion && FueReemplazadoPorAnulacion(row, descripcionesAnuladas);
                    bool esEgresoModificado = !esHistorico && EsEgresoCajaModificado(row);
                    int idInt;
                    bool puedeModificarEgreso = int.TryParse(id, out idInt) && idsModificables.Contains(idInt);
                    int idCompraRelacionado = int.TryParse(id, out idInt) && comprasModificables.ContainsKey(idInt) ? comprasModificables[idInt] : 0;
                    bool puedeModificarCompra = idCompraRelacionado > 0;
                    bool mostrarBotonModificar = (puedeModificarEgreso || puedeModificarCompra) && !string.IsNullOrWhiteSpace(id);
                    string sucursalFila = ValorFlexible(row, "Sucursal", "sucursal");
                    if (string.IsNullOrWhiteSpace(sucursalFila))
                    {
                        sucursalFila = sucursalActividad;
                    }
                    string urlModificar = puedeModificarCompra
                        ? Url.Action("ModificarCompra", "Compras", new { id = idCompraRelacionado, origen = desdePos ? "pos" : "layout" })
                        : "";
                    string tipoModificacion = puedeModificarCompra ? "compra" : "egreso";

                    <tr class="egreso-row @((esAnulacion || esHistorico) ? "egreso-row-anulado" : "")" data-id="@id">
                        <td class="text-nowrap">@Fecha(row, "Fecha")</td>
                        <td>
                            @Valor(row, "TipoEgresoCaja")
                            @if (modoActividades)
                            {
                                <div class="small text-muted mt-1 d-none">@Categoria(row)</div>
                            }
                        </td>
                        <td>
                            @Descripcion(row)
                            @if (esHistorico)
                            {
                                <div class="small text-muted mt-1">Registro anterior reemplazado por una modificacion.</div>
                            }
                            else if (esEgresoModificado)
                            {
                                <div class="small text-muted mt-1">Registro modificado. Verificar cambios.</div>
                            }
                        </td>
                        <td class="text-right text-nowrap">$ @Monto(row)</td>
                        <td class="text-center">
                            @{ var detalleTexto = Valor(row, "Detalle"); }
                            @if (!string.IsNullOrWhiteSpace(detalleTexto))
                            {
                                <span class="badge badge-pill badge-info" title="@detalleTexto">1</span>
                            }
                        </td>
                        <td>@sucursalFila</td>
                        <td class="text-nowrap">
                            <button type="button"
                                    class="btn btn-sm btn-link text-decoration-none btn-detalle-egreso"
                                    data-toggle="collapse"
                                    data-target="#@detalleId"
                                    aria-expanded="false"
                                    aria-controls="@detalleId"
                                    title="Detalles"
                                    aria-label="Detalles">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            @if (mostrarBotonModificar)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-primary btn-modificar-egreso"
                                        data-id="@id"
                                        data-id-compra="@(puedeModificarCompra ? idCompraRelacionado : 0)"
                                        data-url="@urlModificar"
                                        data-tipo-modificacion="@tipoModificacion"
                                        title="Modificar"
                                        aria-label="Modificar">
                                    <i class="fas fa-edit"></i>
                                </button>
                            }
                        </td>
                    </tr>
                    <tr class="egreso-detalle-row">
                        <td colspan="7" class="p-0">
                            <div id="@detalleId" class="collapse egreso-detalle-collapse">
                                <div class="p-3 border-top egreso-detalle-wrap">
                                    <div class="egreso-detalle-meta-card">
                                        <div class="egreso-detalle-meta-row egreso-detalle-principal">
                                            <span class="text-muted d-block">Detalle</span>
                                            <span class="egreso-detalle-valor-principal">@(string.IsNullOrWhiteSpace(Valor(row, "Detalle")) ? "-" : Valor(row, "Detalle"))</span>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-md-3 mb-2">
                                                <span class="text-muted d-block">Sucursal</span>
                                                <span class="font-weight-bold">@sucursalFila</span>
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <span class="text-muted d-block">Creado por</span>
                                                <span class="font-weight-bold">@Valor(row, "Creado Por")</span>
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <span class="text-muted d-block">Creado</span>
                                                <span class="font-weight-bold">@Fecha(row, "Creado")</span>
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <span class="text-muted d-block">Actualizado por</span>
                                                <span class="font-weight-bold">@Valor(row, "Actualizado Por")</span>
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <span class="text-muted d-block">Actualizado</span>
                                                <span class="font-weight-bold">@Fecha(row, "Actualizado")</span>
                                            </div>
                                            <div class="col-md-3 mb-2 mb-md-0">
                                                <span class="text-muted d-block">ID</span>
                                                <span class="font-weight-bold">@id</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="egresos-cards-mobile">
    @if (Model == null || Model.Rows.Count == 0)
    {
        <div class="text-center text-muted py-4">No se encontraron egresos.</div>
    }
    else
    {
        int index = 0;
        foreach (DataRow row in Model.Rows)
        {
            index++;
            string id = Id(row);
            string detalleId = "egreso_card_det_" + (!string.IsNullOrWhiteSpace(id) ? id : index.ToString());
            bool esAnulacion = EsAnulacion(row);
            bool esHistorico = !esAnulacion && FueReemplazadoPorAnulacion(row, descripcionesAnuladas);
            bool esEgresoModificado = !esHistorico && EsEgresoCajaModificado(row);
            int idInt;
            bool puedeModificarEgreso = int.TryParse(id, out idInt) && idsModificables.Contains(idInt);
            int idCompraRelacionado = int.TryParse(id, out idInt) && comprasModificables.ContainsKey(idInt) ? comprasModificables[idInt] : 0;
            bool puedeModificarCompra = idCompraRelacionado > 0;
            bool mostrarBotonModificar = (puedeModificarEgreso || puedeModificarCompra) && !string.IsNullOrWhiteSpace(id);
            string sucursalFila = ValorFlexible(row, "Sucursal", "sucursal");
            if (string.IsNullOrWhiteSpace(sucursalFila))
            {
                sucursalFila = sucursalActividad;
            }
            string urlModificar = puedeModificarCompra
                ? Url.Action("ModificarCompra", "Compras", new { id = idCompraRelacionado, origen = desdePos ? "pos" : "layout" })
                : "";
            string tipoModificacion = puedeModificarCompra ? "compra" : "egreso";

            <div class="egreso-card @((esAnulacion || esHistorico) ? "egreso-row-anulado" : "")">
                <div class="egreso-card-top">
                    <strong>
                        @Valor(row, "TipoEgresoCaja")
                        @if (modoActividades)
                        {
                            <div class="small text-muted mt-1 d-none">@Categoria(row)</div>
                        }
                    </strong>
                    <span>$ @Monto(row)</span>
                </div>
                <div class="egreso-card-line">@Fecha(row, "Fecha")</div>
                <div class="egreso-card-line">
                    @Descripcion(row)
                    @if (esHistorico)
                    {
                        <div class="small text-muted mt-1">Registro anterior reemplazado por una modificacion.</div>
                    }
                    else if (esEgresoModificado)
                    {
                        <div class="small text-muted mt-1">Registro modificado. Verificar cambios.</div>
                    }
                </div>
                <div class="d-flex flex-wrap mt-2">
                    <button type="button"
                            class="btn btn-sm btn-link text-decoration-none pl-0 btn-detalle-egreso"
                            data-toggle="collapse"
                            data-target="#@detalleId"
                            aria-expanded="false"
                            aria-controls="@detalleId"
                            title="Detalles"
                            aria-label="Detalles">
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    @if (mostrarBotonModificar)
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary btn-modificar-egreso"
                                data-id="@id"
                                data-id-compra="@(puedeModificarCompra ? idCompraRelacionado : 0)"
                                data-url="@urlModificar"
                                data-tipo-modificacion="@tipoModificacion"
                                title="Modificar"
                                aria-label="Modificar">
                            <i class="fas fa-edit"></i>
                        </button>
                    }
                </div>
                <div id="@detalleId" class="collapse egreso-detalle-collapse">
                    @if (!string.IsNullOrWhiteSpace(Valor(row, "Detalle")))
                    {
                        <div class="egreso-card-detail">@Valor(row, "Detalle")</div>
                    }
                    <div class="egreso-card-line">Sucursal: @sucursalFila</div>
                    <div class="egreso-card-line">Creado: @Fecha(row, "Creado")</div>
                    <div class="egreso-card-line">Creado por: @Valor(row, "Creado Por")</div>
                    <div class="egreso-card-line">Actualizado: @Fecha(row, "Actualizado")</div>
                    <div class="egreso-card-line">Actualizado por: @Valor(row, "Actualizado Por")</div>
                </div>
            </div>
        }
    }
</div>
