<div class="modal fade"
     id="modalAbrirCaja"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow">

            <!-- Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-cash-register mr-2"></i>
                    Apertura de Caja
                </h5>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <!-- Sucursal -->
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="fas fa-store mr-1"></i> Sucursal
                    </label>
                    <input type="text"
                           class="form-control bg-light"
                           value="@ViewBag.SucursalNombre"
                           readonly>
                </div>

                <!-- Fecha y hora -->
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="far fa-clock mr-1"></i> Fecha y hora
                    </label>
                    <input type="text"
                           id="fechaHoraApertura"
                           class="form-control bg-light"
                           readonly>
                </div>

                <!-- Monto inicial -->
                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="fas fa-dollar-sign mr-1"></i> Caja inicial
                    </label>
                    <input type="text"
                           id="montoInicial"
                           class="form-control form-control-lg"
                           placeholder="Ingrese monto inicial">
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer d-block">

                <button type="button"
                        class="btn btn-success btn-block btn-lg"
                        onclick="abrirCaja()">
                    <i class="fas fa-unlock mr-2"></i>
                    Abrir Caja
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-block"
                        id="btnCancelarAbrirCaja">
                    Cancelar
                </button>

            </div>

        </div>
    </div>
</div>
