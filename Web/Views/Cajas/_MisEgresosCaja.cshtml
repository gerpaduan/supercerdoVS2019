@model System.Data.DataTable

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    string mensaje = ViewBag.Mensaje as string;
    decimal total = ViewBag.TotalVisible != null ? (decimal)ViewBag.TotalVisible : 0;
    int cantidadItems = Model != null ? Model.Rows.Count : 0;
    string filtroActividad = ViewBag.FiltroActividad as string ?? "todos";
    bool permitirNuevo = ViewBag.PermitirNuevo == null || (bool)ViewBag.PermitirNuevo;
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    string tituloActividades = ViewBag.TituloActividades as string ?? "Mis actividades";
    string subtituloActividades = ViewBag.SubtituloActividades as string;
    bool mostrarResumenMisActividades = ViewBag.MostrarResumenMisActividades == null || (bool)ViewBag.MostrarResumenMisActividades;
}

<div class="egresos-pos mis-actividades-modal @(desdePos ? "mis-actividades-pos-compacta" : "")">
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-warning m-3">@mensaje</div>
    }
    else
    {
        <div class="egresos-pos-toolbar">
            <div class="egresos-pos-toolbar-main">
                @if (!string.IsNullOrWhiteSpace(subtituloActividades))
                {
                    <small class="text-muted d-block">@subtituloActividades</small>
                }
                <span class="mis-actividades-items-badge" title="Cantidad de items mostrados en la tabla">
                    @cantidadItems item@(cantidadItems == 1 ? "" : "s")
                </span>
            </div>
            <div class="egresos-pos-toolbar-actions">
                <button type="button" class="btn btn-outline-primary" id="btnAbrirMisVentasDesdeActividades">
                    <i class="fas fa-shopping-cart mr-1"></i> Mis ventas
                </button>
                <div class="egresos-actividad-filtros" role="group" aria-label="Filtro de actividades">
                    <button type="button" class="btn btn-sm @(filtroActividad == "todos" ? "btn-primary" : "btn-outline-primary")" data-filtro-actividad="todos">Todos</button>
                    <button type="button" class="btn btn-sm @(filtroActividad == "gastos" ? "btn-primary" : "btn-outline-primary")" data-filtro-actividad="gastos">Egresos de caja</button>
                    <button type="button" class="btn btn-sm @(filtroActividad == "pagoElectronico" ? "btn-primary" : "btn-outline-primary")" data-filtro-actividad="pagoElectronico">Pagos electronicos</button>
                    <button type="button" class="btn btn-sm @(filtroActividad == "ctaCte" ? "btn-primary" : "btn-outline-primary")" data-filtro-actividad="ctaCte">Cta Cte</button>
                </div>
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="switchVistaCompletaEgresos">
                    <label class="custom-control-label" for="switchVistaCompletaEgresos">Vista completa</label>
                </div>
                @if (permitirNuevo)
                {
                    <button type="button" class="btn btn-success" id="btnNuevoEgresoDesdeMis">
                        <i class="fas fa-plus mr-1"></i> Nuevo Egreso
                    </button>
                }
            </div>
        </div>

        <div class="px-3 pb-3">
            @if (mostrarResumenMisActividades)
            {
                <div class="egresos-resumen">
                    <div>
                        <span class="text-muted">El total corresponde solo a egresos de caja</span>
                        <strong>$ @total.ToString("N2")</strong>
                    </div>
                </div>
            }
            <div id="misActividadesContenido">
                @Html.Partial("~/Views/Cajas/_EgresosCajaTabla.cshtml", Model)
            </div>
        </div>
    }
</div>

<script>
    (function () {
        $(document)
            .off("click.misEgresos", "#btnNuevoEgresoDesdeMis")
            .on("click.misEgresos", "#btnNuevoEgresoDesdeMis", function () {
                if (window.POSEgresos && typeof window.POSEgresos.abrirNuevo === "function") {
                    window.POSEgresos.abrirNuevo();
                    return;
                }

                if (window.EgresosCaja && typeof window.EgresosCaja.abrirNuevo === "function") {
                    window.EgresosCaja.abrirNuevo();
                }
            })
            .off("click.misActividadesFiltro", "[data-filtro-actividad]")
            .on("click.misActividadesFiltro", "[data-filtro-actividad]", function () {
                var filtro = $(this).data("filtro-actividad") || "todos";
                if (window.POSEgresos && typeof window.POSEgresos.abrirMis === "function") {
                    window.POSEgresos.abrirMis(filtro);
                    return;
                }

                if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirActividades === "function") {
                    window.CajasAbiertas.idCierreActividadActual = @idCierreActividad;
                    window.CajasAbiertas.abrirActividades(@idCierreActividad, filtro);
                }
            })
            .off("click.misVentasDesdeActividades", "#btnAbrirMisVentasDesdeActividades")
            .on("click.misVentasDesdeActividades", "#btnAbrirMisVentasDesdeActividades", function () {
                if (window.POSVentas && typeof window.POSVentas.abrirMis === "function") {
                    window.POSVentas.abrirMis();
                    return;
                }

                if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirVentas === "function") {
                    window.CajasAbiertas.abrirVentas(@idCierreActividad);
                }
            });
    })();
</script>

