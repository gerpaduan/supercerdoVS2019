@model System.Data.DataTable

@{
    ViewBag.Title = "Cajas Abiertas";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    int? idSucursal = ViewBag.IdSucursal;
    string buscar = ViewBag.Buscar ?? "";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">

    <!-- Filtros -->
    <form id="formFiltros">
        <div class="row mb-3">

            <!-- Combo sucursal -->
            <div class="col-md-3">
                <select name="idSucursal" id="idSucursal" class="form-control">
                    <option value="">-- Seleccione una sucursal --</option>

                    @foreach (var s in sucursales)
                    {
                        <option value="@s.IdSucursal" @(s.IdSucursal == idSucursal ? "selected" : "")>
                            @s.SucursalNombre
                        </option>
                    }
                </select>
            </div>

            <!-- Buscar vendedor -->
            <div class="col-md-3">
                <div class="input-group">
                    <input type="text"
                           name="buscar"
                           id="buscarVendedor"
                           value="@buscar"
                           class="form-control"
                           placeholder="buscar vendedor"
                           onkeyup="filtrar()" />

                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="filtrar()">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- BOTÓN CIERRE MULTIPLE (NO IMPLEMENTADO AÚN) -->
    <button id="btnCerrarMultiple" class="btn btn-danger mb-3" style="display:none;">
        Cerrar Cajas Seleccionadas
    </button>

    <!-- Área que se actualiza con AJAX -->
    <div id="tablaResultado">
        @Html.Partial("_TablaCajasAbiertas", Model)
    </div>

</div>
<!-- Modal Cerrar Caja -->
<div class="modal fade" id="modalCerrarCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Cerrar Caja</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="cerrarCajaError" class="alert alert-danger d-none"></div>

                <form id="formCerrarCaja">

                    <!-- CAMBIO CLAVE: el hidden debe ser Id -->
                    <input type="hidden" id="Id" name="Id" />

                    <div class="row">
                        <div class="col-md-4">
                            <label>Caja</label>
                            <input type="text" id="CajaDesc" class="form-control" readonly />
                        </div>

                        <div class="col-md-4">
                            <label>Apertura</label>
                            <input type="text" id="FechaApertura" class="form-control" readonly />
                        </div>

                        <div class="col-md-4">
                            <label>Usuario</label>
                            <input type="text" id="Usuario" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <label>Total Sistema</label>
                            <input type="text" id="TotalSistema" class="form-control" readonly />
                        </div>

                        <div class="col-md-4">
                            <label>Total Cargado</label>
                            <input type="text" id="TotalCargado" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label>Diferencia</label>
                            <input type="text" id="Diferencia" class="form-control" readonly />
                        </div>
                    </div>

                </form>


            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="guardarCierreCaja()">Cerrar Caja</button>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        //// Cerrar caja individual
        //$(document).on("click", ".btnCerrar", function () {

        //    let id = $(this).data("id");

        //    if (!confirm("¿Cerrar esta caja?")) return;

        //    $.post("/Cajas/CerrarCaja", { id: id }, function (r) {
        //        if (r.ok) filtrar();   // recarga solo la tabla, no la página
        //        else alert(r.msg);
        //    });
        //});


        function filtrar() {

            let idSucursal = $("#idSucursal").val();
            let buscar = $("#buscarVendedor").val();

            // guardar posición del cursor
            let txt = document.getElementById("buscarVendedor");
            let pos = txt.selectionStart;

            $.ajax({
                url: '/Cajas/CajasAbiertas',
                type: 'GET',
                data: {
                    idSucursal: idSucursal,
                    buscar: buscar,
                    ajax: true
                },
                success: function (html) {
                    $("#tablaResultado").html(html);

                    setTimeout(() => {
                        const input = document.getElementById("buscarVendedor");
                        if (input) {
                            input.focus();
                            input.setSelectionRange(pos, pos);
                        }
                    }, 30);
                }
            });
        }

        // Cambiar sucursal → filtrar automáticamente
        $("#idSucursal").change(function () {
            filtrar();
        });


        //SCRIPT PARA ABRIR MODAL CERRAR CAJA
        function abrirModalCerrarCaja(Id) {
            $("#cerrarCajaError").addClass("d-none").text("");

            $.ajax({
                url: '/Cajas/ObtenerDatosCierre',
                type: 'GET',
                data: { id: Id },
                success: function (data) {

                    // CAMBIO CLAVE AQUÍ
                    $("#Id").val(data.id);

                    $("#CajaDesc").val(data.caja);
                    $("#FechaApertura").val(data.fechaApertura);
                    $("#Usuario").val(data.usuario);

                    $("#TotalSistema").val(data.totalSistema);
                    $("#TotalCargado").val("");
                    $("#Diferencia").val("");

                    $("#modalCerrarCaja").modal("show");
                }
            });
        }


            $("#TotalCargado").on("input", function () {
                let sistema = parseFloat($("#TotalSistema").val()) || 0;
            let cargado = parseFloat($("#TotalCargado").val()) || 0;

            $("#Diferencia").val((cargado - sistema).toFixed(2));
        });

        function guardarCierreCaja() {
            $.ajax({
                url: '/Cajas/CerrarCaja',
                type: 'POST',
                data: $("#formCerrarCaja").serialize(),
                success: function (resp) {

                    if (!resp.ok) {
                        $("#cerrarCajaError").removeClass("d-none").text(resp.error);
                        return;
                    }

                    // recargar tabla
                    location.reload();
                }
            });
        }


    </script>
}
