@model System.Data.DataTable

@{
    ViewBag.Title = "Cajas Abiertas";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    int? idSucursal = ViewBag.IdSucursal;
    string buscar = ViewBag.Buscar ?? "";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">

    <form id="formFiltros">
        <div class="row mb-3">
            <!-- Combo sucursal -->
            <div class="col-md-3">
                <select name="idSucursal" id="idSucursal" class="form-control">
                    <option value="">-- Todas las sucursales --</option>
                    @foreach (var s in sucursales)
                    {
                        <option value="@s.IdSucursal" @(s.IdSucursal == idSucursal ? "selected" : "")>
                            @s.SucursalNombre
                        </option>
                    }
                </select>
            </div>

            <!-- Buscar vendedor -->
            <div class="col-md-3">
                <div class="input-group">
                    <input type="text"
                           name="buscar"
                           id="buscarVendedor"
                           value="@buscar"
                           class="form-control"
                           placeholder="buscar vendedor"
                           onkeyup="filtrar()" />

                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="filtrar()">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Área que se actualiza con AJAX -->
    <div id="tablaResultado">
        @Html.Partial("_TablaCajasAbiertas", Model)
    </div>

</div>

<div class="modal fade" id="modalEgresoCaja" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalEgresoCajaTitulo">Nuevo Egreso de Caja</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="contenedorEgresoCaja">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Actividades -->
<div class="modal fade" id="modalActividadesCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Actividades</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div id="contenedorActividadesCaja" class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cerrar Caja -->
<div class="modal fade" id="modalCerrarCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Cerrar Caja</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="cerrarCajaError" class="alert alert-danger d-none"></div>

                <form id="formCerrarCaja">

                    <input type="hidden" id="Id" name="Id" />

                    <label id="labelSucursal">Nombre de Sucursal</label>
                    <hr />
                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja</label>
                            <input type="text" id="CajaDesc" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <label>Apertura</label>
                            <input type="text" id="FechaApertura" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja Inicial</label>
                            <input type="text" id="CajaInicial" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <input type="hidden" id="Usuario" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-5">
                            <label>Ventas</label>
                            <input type="text" id="Ventas" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <label>EgresosCaja</label>
                            <input type="number" step="0.01" id="EgresosCaja" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja Cierre</label>
                            <input type="text" step="0.01" id="CajaCierre" name="CajaCierre" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>

                        <div class="col-md-5">
                            <label>Diferencia</label>
                            <input type="text" id="Diferencia" name="Diferencia" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Importe Retirado</label>
                            <input type="text" id="ImporteRetirado" name="ImporteRetirado" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>
                        <div class="col-md-5">
                            <label>Queda en Caja</label>
                            <input type="text" id="CajaInicioSiguiente" name="CajaInicioSiguiente" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="guardarCierreCaja()">Cerrar Caja</button>
                <button class="btn btn-secondary" data-dismiss="modal" onclick="modalCerrarCaja()">Cancelar</button>
            </div>

        </div>
    </div>
</div>

<style>
    @@media (min-width: 992px) {
        #modalActividadesCaja .modal-dialog {
            width: 60%;
            max-width: none;
        }
    }
</style>

@section Scripts {
    <script>
        window.EgresosCajaUrls = {
            nuevo: '@Url.Action("NuevoEgresoCaja", "Cajas")',
            guardar: '@Url.Action("GuardarEgresoCaja", "Cajas")'
        };
        window.VentasCajaUrls = {
            mis: '@Url.Action("MisVentas", "Ventas")',
            detalle: '@Url.Action("DetalleVenta", "Ventas")'
        };

        function filtrar() {
            const idSucursal = $("#idSucursal").val() || "";
            const buscar = $("#buscarVendedor").val() || "";

            let pos = 0;
            const txt = document.getElementById("buscarVendedor");
            if (txt && document.activeElement === txt && typeof txt.selectionStart === "number") {
                pos = txt.selectionStart;
            }

            $.ajax({
                url: '@Url.Action("CajasAbiertas", "Cajas")',
                type: 'GET',
                data: {
                    idSucursal: idSucursal,
                    buscar: buscar,
                    ajax: true
                },
                cache: false,
                success: function (html) {
                    $("#tablaResultado").html(html);

                    if (txt) {
                        setTimeout(() => {
                            txt.focus();
                            try {
                                txt.setSelectionRange(pos, pos);
                            } catch (e) { }
                        }, 30);
                    }
                }
            });
        }

        $(document).on('change', '#idSucursal', function () {
            filtrar();
        });

        $(function () {
            filtrar();
        });

        $(document)
            .off('show.bs.modal.cajasStack', '#modalActividadesCaja, #modalEgresoCaja, #modalCerrarCaja')
            .on('show.bs.modal.cajasStack', '#modalActividadesCaja, #modalEgresoCaja, #modalCerrarCaja', function () {
                var zIndex = 1040 + (10 * $('.modal.show').length);
                $(this).css('z-index', zIndex);

                setTimeout(function () {
                    $('.modal-backdrop').not('.modal-stack').last()
                        .css('z-index', zIndex - 1)
                        .addClass('modal-stack');
                }, 0);
            });

        function abrirModalActividades(idCierre, filtroActividad) {
            window.CajasAbiertas = window.CajasAbiertas || {};
            window.CajasAbiertas.idCierreActividadActual = idCierre;
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: '@Url.Action("ActividadesCaja", "Cajas")',
                type: 'GET',
                data: {
                    idCierre: idCierre,
                    filtroActividad: filtroActividad || "todos"
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function (xhr) {
                    let mensaje = "No se pudieron cargar las actividades de la caja.";
                    if (xhr && xhr.responseText) {
                        mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                    }
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">' + $('<div>').text(mensaje).html() + '</div>');
                }
            });
        }

        function abrirModalVentas(idCierre) {
            window.CajasAbiertas = window.CajasAbiertas || {};
            window.CajasAbiertas.idCierreActividadActual = idCierre;
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: window.VentasCajaUrls.mis,
                type: 'GET',
                data: {
                    idCierre: idCierre
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function (xhr) {
                    let mensaje = "No se pudieron cargar las ventas de la caja.";
                    if (xhr && xhr.responseText) {
                        mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                    }
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">' + $('<div>').text(mensaje).html() + '</div>');
                }
            });
        }

        function abrirDetalleVenta(idVenta, idCierre) {
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: window.VentasCajaUrls.detalle,
                type: 'GET',
                data: {
                    id: idVenta,
                    modal: true,
                    idCierre: idCierre
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function () {
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">No se pudo cargar el detalle de la venta.</div>');
                }
            });
        }

        window.CajasAbiertas = window.CajasAbiertas || {};
        window.CajasAbiertas.abrirActividades = abrirModalActividades;
        window.CajasAbiertas.abrirVentas = abrirModalVentas;
        window.CajasAbiertas.abrirDetalleVenta = abrirDetalleVenta;

        function abrirModalCerrarCaja(Id) {
            $("#cerrarCajaError").addClass("d-none").text("");

            $.ajax({
                url: '@Url.Action("ObtenerDatosCierre", "Cajas")',
                type: 'GET',
                data: { id: Id },
                success: function (data) {
                    $("#Id").val(data.id);
                    $("#labelSucursal").text("Caja | " + data.suc);
                    $("#CajaDesc").val(data.vendedor);
                    $("#FechaApertura").val(data.fechaApertura);
                    $("#CajaInicial").val(data.cajaInicial);
                    $("#Usuario").val(data.usuario);
                    $("#Ventas").val(data.ventas);
                    $("#EgresosCaja").val(data.egresosCaja);
                    $("#Diferencia").val("");
                    $("#modalCerrarCaja").modal("show");
                }
            });
        }

        $('#modalCerrarCaja').on('hidden.bs.modal', function () {
            $(this).find('input:not([type="hidden"])').val('');
            $(this).find('textarea').val('');
            $(this).find('select').prop('selectedIndex', 0);
            $('.text-danger').addClass('d-none').text('');
        });

        function esNumeroValido(v) {
            return /^-?\d*(\.\d+)?$/.test(v);
        }

        function guardarCierreCaja() {
            let data = {
                Id: $("#Id").val(),
                CajaCierre: $("#CajaCierre").val(),
                Diferencia: $("#Diferencia").val(),
                ImporteRetirado: $("#ImporteRetirado").val(),
                CajaInicioSiguiente: $("#CajaInicioSiguiente").val()
            };

            $.ajax({
                url: '@Url.Action("CerrarCaja", "Cajas")',
                type: 'POST',
                data: data,
                success: function (resp) {
                    if (!resp.ok) {
                        $("#cerrarCajaError").removeClass("d-none").text(resp.error);
                        return;
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Caja cerrada',
                        text: 'La caja se cerró correctamente',
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: '#4e73df'
                    }).then(() => {
                        let idSucursal = $("#idSucursal").val() || "";
                        window.location.href = '/Cajas/CajasAbiertas?idSucursal=' + idSucursal + '&buscar=';
                    });
                }
            });
        }

        function toFloat(value) {
            let v = value.trim();
            if (v === "") return 0;
            v = v.replace(",", ".");
            return parseFloat(v) || 0;
        }

        function validarNumero(input) {
            let v = input.value;
            v = v.replace(/[^\d.,]/g, "");
            v = v.replace(",", ".");

            const partes = v.split(".");
            if (partes.length > 2) {
                v = partes[0] + "." + partes[1];
            }

            input.value = v;
        }

        function recalcularCierre() {
            let cajaInicial = toFloat($("#CajaInicial").val());
            let ventas = toFloat($("#Ventas").val());
            let gastos = toFloat($("#EgresosCaja").val());
            let cajaCierre = toFloat($("#CajaCierre").val());
            let importeRetirado = toFloat($("#ImporteRetirado").val());

            let diferencia = (gastos + cajaCierre) - (cajaInicial + ventas);

            if ($("#CajaCierre").val().length > 0)
                $("#Diferencia").val(diferencia.toFixed(2));
            else
                $("#Diferencia").val("");

            let cajaInicioSiguiente = cajaCierre - importeRetirado;
            $("#CajaInicioSiguiente").val(cajaInicioSiguiente.toFixed(2));

            colorearDiferencia();
        }

        function colorearDiferencia() {
            let valor = parseFloat($("#Diferencia").val().replace(",", "."));

            if (isNaN(valor)) {
                $("#Diferencia").css("background-color", "white");
                return;
            }

            if (valor >= -100 && valor <= 100) {
                $("#Diferencia").css("background-color", "#c8f7c5");
            }
            else if ((valor > 100 && valor <= 300) || (valor < -100 && valor >= -300)) {
                $("#Diferencia").css("background-color", "#fff3b0");
            }
            else {
                $("#Diferencia").css("background-color", "#f7c6c6");
            }
        }
    </script>
    <script src="@Url.Content("~/Scripts/app/egresos-caja.js?v=3")"></script>
}
