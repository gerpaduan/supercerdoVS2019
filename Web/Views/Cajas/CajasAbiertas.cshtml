@model System.Data.DataTable

@{
    ViewBag.Title = "Cajas Abiertas";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    int? idSucursal = ViewBag.IdSucursal;
    string buscar = ViewBag.Buscar ?? "";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid">

    <!-- Filtros -->
    <form id="formFiltros">
        <div class="row mb-3">

            <!-- Combo sucursal -->
            <div class="col-md-3">
                <select name="idSucursal" id="idSucursal" class="form-control">
                    <option value="">-- Seleccione una sucursal --</option>

                    @foreach (var s in sucursales)
                    {
                        <option value="@s.IdSucursal" @(s.IdSucursal == idSucursal ? "selected" : "")>
                            @s.SucursalNombre
                        </option>
                    }
                </select>
            </div>

            <!-- Buscar vendedor -->
            <div class="col-md-3">
                <div class="input-group">
                    <input type="text"
                           name="buscar"
                           id="buscarVendedor"
                           value="@buscar"
                           class="form-control"
                           placeholder="buscar vendedor"
                           onkeyup="filtrar()" />

                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" onclick="filtrar()">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- BOTÓN CIERRE MULTIPLE (NO IMPLEMENTADO AÚN) -->
    <button id="btnCerrarMultiple" class="btn btn-danger mb-3" style="display:none;">
        Cerrar Cajas Seleccionadas
    </button>

    <!-- Área que se actualiza con AJAX -->
    <div id="tablaResultado">
        @Html.Partial("_TablaCajasAbiertas", Model)
    </div>

</div>
<!-- Modal Cerrar Caja -->
<div class="modal fade" id="modalCerrarCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Cerrar Caja</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="cerrarCajaError" class="alert alert-danger d-none"></div>

                <form id="formCerrarCaja">

                    <!-- ID oculto -->
                    <input type="hidden" id="Id" name="Id" />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja</label>
                            <input type="text" id="CajaDesc" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <label>Apertura</label>
                            <input type="text" id="FechaApertura" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja Inicial</label>
                            <input type="text" id="CajaInicial" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <input type="hidden" id="Usuario" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-5">
                            <label>Ventas</label>
                            <input type="text" id="Ventas" class="form-control" readonly />
                        </div>

                        <div class="col-md-5">
                            <label>EgresosCaja</label>
                            <input type="number" step="0.01" id="EgresosCaja" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Caja Cierre</label>
                            <input type="text" step="0.01" id="CajaCierre" name="CajaCierre" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>

                        <div class="col-md-5">
                            <label>Diferencia</label>
                            <input type="text" id="Diferencia" name="Diferencia" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-5">
                            <label>Importe Retirado</label>
                            <input type="text" id="ImporteRetirado" name="ImporteRetirado" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>
                        <div class="col-md-5">
                            <label>Queda en Caja</label>
                            <input type="text" id="CajaInicioSiguiente" name="CajaInicioSiguiente" class="form-control" readonly />

                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="guardarCierreCaja()">Cerrar Caja</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filtrar() {

            let idSucursal = $("#idSucursal").val();
            let buscar = $("#buscarVendedor").val();

            // guardar posición del cursor
            let txt = document.getElementById("buscarVendedor");
            let pos = txt.selectionStart;

            $.ajax({
                url: '/Cajas/CajasAbiertas',
                type: 'GET',
                data: {
                    idSucursal: idSucursal,
                    buscar: buscar,
                    ajax: true
                },
                success: function (html) {
                    $("#tablaResultado").html(html);

                    setTimeout(() => {
                        const input = document.getElementById("buscarVendedor");
                        if (input) {
                            input.focus();
                            input.setSelectionRange(pos, pos);
                        }
                    }, 30);
                }
            });
        }

        // Cambiar sucursal → filtrar automáticamente
        $("#idSucursal").change(function () {
            filtrar();
        });


        //SCRIPT PARA ABRIR MODAL CERRAR CAJA
        function abrirModalCerrarCaja(Id) {
            $("#cerrarCajaError").addClass("d-none").text("");

            $.ajax({
                url: '/Cajas/ObtenerDatosCierre',
                type: 'GET',
                data: { id: Id },
                success: function (data) {

                    // CAMBIO CLAVE AQUÍ
                    $("#Id").val(data.id);

                    $("#CajaDesc").val(data.vendedor);
                    $("#FechaApertura").val(data.fechaApertura);
                    $("#CajaInicial").val(data.cajaInicial);
                    $("#Usuario").val(data.usuario);

                    $("#Ventas").val(data.ventas);
                    $("#EgresosCaja").val(data.egresosCaja);
                    $("#Diferencia").val("");

                    $("#modalCerrarCaja").modal("show");
                }
            });
        }


        function esNumeroValido(v) {
            return /^-?\d*(\.\d+)?$/.test(v);
        }

        function guardarCierreCaja() {

            let data = {
                Id: $("#Id").val(),                     // ← CAMBIADO
                CajaCierre: $("#CajaCierre").val(),
                Diferencia: $("#Diferencia").val(),
                ImporteRetirado: $("#ImporteRetirado").val(),
                CajaInicioSiguiente: $("#CajaInicioSiguiente").val()
            };

            $.ajax({
                url: '/Cajas/CerrarCaja',
                type: 'POST',
                data: data,
                success: function (resp) {

                    if (!resp.ok) {
                        $("#cerrarCajaError").removeClass("d-none").text(resp.error);
                        return;
                    }

                    location.reload();
                }
            });
        }


        //function guardarCierreCaja() {

        //    if (!esNumeroValido($("#CajaCierre").val()) ||
        //        !esNumeroValido($("#ImporteRetirado").val())) {

        //        $("#cerrarCajaError").removeClass("d-none")
        //            .text("Ingrese valores numéricos válidos.");
        //        return;
        //    }

        //    $.ajax({
        //        url: '/Cajas/CerrarCaja',
        //        type: 'POST',
        //        data: $("#formCerrarCaja").serialize(),
        //        success: function (resp) {

        //            if (!resp.ok) {
        //                $("#cerrarCajaError").removeClass("d-none").text(resp.error);
        //                return;
        //            }

        //            // recargar tabla
        //            location.reload();
        //        }
        //    });
        //}

        function toFloat(value) {
            let v = value.trim();
            if (v === "") return 0;
            v = v.replace(",", "."); // por si ingresan coma
            return parseFloat(v) || 0;
        }

        function validarNumero(input) {
            let v = input.value;

            // Solo dígitos, coma o punto
            v = v.replace(/[^\d.,]/g, "");

            // Reemplazar coma por punto (unifica formato)
            v = v.replace(",", ".");

            // Evitar más de 1 punto
            const partes = v.split(".");
            if (partes.length > 2) {
                v = partes[0] + "." + partes[1]; // corta el excedente
            }

            input.value = v;
        }


        function recalcularCierre() {

            let cajaInicial = toFloat($("#CajaInicial").val());
            let ventas = toFloat($("#Ventas").val());
            let gastos = toFloat($("#EgresosCaja").val());
            let cajaCierre = toFloat($("#CajaCierre").val());
            let importeRetirado = toFloat($("#ImporteRetirado").val());

            // Calcula diferencia
            let diferencia = (gastos + cajaCierre) - (cajaInicial + ventas);

            if ($("#CajaCierre").val().length > 0)
                $("#Diferencia").val(diferencia.toFixed(2));
            else
                $("#Diferencia").val("");

            // Calcula caja para el siguiente inicio
            let cajaInicioSiguiente = cajaCierre - importeRetirado;
            $("#CajaInicioSiguiente").val(cajaInicioSiguiente.toFixed(2));
        }


    </script>
}
