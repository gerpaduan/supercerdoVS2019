@model System.Data.DataTable

@{
    ViewBag.Title = "Cajas Abiertas";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    bool puedeCambiarSucursalCaja = ViewBag.PuedeCambiarSucursalCaja != null && (bool)ViewBag.PuedeCambiarSucursalCaja;
    int? idSucursal = ViewBag.IdSucursal;
    string buscar = ViewBag.Buscar ?? "";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid px-2 px-md-3 cajas-page cajas-form-compact">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-3 cajas-panel-card">
        <div class="card-body">
            <form id="formFiltros">
                <div class="row mb-3">
                    <div class="col-12 col-md-4 col-xl-3">
                        <label for="idSucursal" class="cajas-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="idSucursal" class="form-control">
                            <option value="">-- Todas las sucursales --</option>
                            @foreach (var s in sucursales)
                            {
                                <option value="@s.IdSucursal" @(s.IdSucursal == idSucursal ? "selected" : "")>
                                    @s.SucursalNombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-5 col-xl-4">
                        <label for="buscarVendedor" class="cajas-filtro-label">Vendedor</label>
                        <div class="input-group">
                            <input type="text"
                                   name="buscar"
                                   id="buscarVendedor"
                                   value="@buscar"
                                   class="form-control"
                                   placeholder="buscar vendedor"
                                   onkeyup="filtrar()" />

                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button" id="btnBuscarCajasAbiertas" onclick="filtrar()">
                                    <span class="btn-buscar-texto">Buscar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="estadoBusquedaCajasAbiertas" class="text-muted small">Resultados actualizados.</div>
            </form>
        </div>
    </div>

    <div id="tablaResultado" class="cajas-resultado-wrap">
        @Html.Partial("_TablaCajasAbiertas", Model)
    </div>

    <style>
        .cajas-page {
            font-size: .9rem;
        }

        .cajas-page .cajas-panel-card {
            border: 1px solid #e9ecef;
            border-radius: .75rem;
        }

        .cajas-page .cajas-panel-card > .card-body,
        .cajas-page .cajas-panel-card .card-body {
            padding: .8rem .92rem;
        }

        .cajas-page .cajas-filtro-label {
            font-size: .76rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: .18rem;
        }

        .cajas-page .cajas-form-compact .form-control,
        .cajas-page .cajas-form-compact .input-group-text,
        .cajas-page .cajas-form-compact .btn:not(.btn-sm) {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
            border-radius: .52rem;
        }

        .cajas-page .small,
        .cajas-page .text-muted {
            font-size: .76rem !important;
        }

        .cajas-page #tablaCajas {
            font-size: .82rem;
        }

        .cajas-page #tablaCajas th,
        .cajas-page #tablaCajas td {
            padding: .36rem .48rem;
            vertical-align: middle;
            line-height: 1.12;
        }

        .cajas-page #tablaCajas thead th,
        .cajas-page #tablaCajas > thead > tr > th {
            font-size: .72rem !important;
            line-height: 1.05;
            padding-top: .42rem;
            padding-bottom: .42rem;
            text-transform: uppercase;
            letter-spacing: .02em;
        }

        .cajas-page #tablaCajas .btn-sm {
            padding: .18rem .42rem;
            line-height: 1.12;
            font-size: .76rem;
        }

        @@media (min-width: 1200px) {
            .cajas-page .cajas-panel-card > .card-body,
            .cajas-page .cajas-panel-card .card-body {
                padding: .72rem .84rem;
            }

            .cajas-page .cajas-form-compact .form-control,
            .cajas-page .cajas-form-compact .input-group-text,
            .cajas-page .cajas-form-compact .btn:not(.btn-sm) {
                min-height: 2.02rem;
                font-size: .81rem;
                padding: .24rem .5rem;
            }

            .cajas-page #tablaCajas {
                font-size: .79rem;
            }

            .cajas-page #tablaCajas thead th,
            .cajas-page #tablaCajas > thead > tr > th {
                font-size: .69rem !important;
            }
        }
    </style>

</div>

@if (puedeCambiarSucursalCaja)
{
    <div class="modal fade" id="modalCambioSucursalCaja" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Cambiar sucursal de caja abierta</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="CambioSucursalIdCierre" />
                    <input type="hidden" id="CambioSucursalIdActual" />

                    <div class="alert alert-warning mb-3">
                        Esta accion corregira la sucursal de la caja y de todas las operaciones asociadas. Usar solo cuando el cajero trabajo por error en una sucursal incorrecta.
                    </div>

                    <div id="cambioSucursalCajaError" class="alert alert-danger d-none"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Cajero</label>
                            <input type="text" id="CambioSucursalUsuarioCaja" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label>Apertura</label>
                            <input type="text" id="CambioSucursalFechaInicio" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Sucursal actual</label>
                            <input type="text" id="CambioSucursalActualNombre" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label>Nueva sucursal</label>
                            <select id="CambioSucursalNueva" class="form-control">
                                <option value="">Seleccionar sucursal...</option>
                                @foreach (var s in sucursales)
                                {
                                    <option value="@s.IdSucursal">@s.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label>Vista previa</label>
                        <div id="cambioSucursalCajaPreview" class="border rounded p-3 bg-light text-muted">
                            Selecciona la nueva sucursal para calcular los registros que se van a corregir.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnConfirmarCambioSucursalCaja" class="btn btn-warning" onclick="confirmarCambioSucursalCaja()" disabled>Cambiar sucursal</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="modalEgresoCaja" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalEgresoCajaTitulo">Nuevo Egreso de Caja</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="contenedorEgresoCaja">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Actividades -->
<div class="modal fade" id="modalActividadesCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Actividades</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div id="contenedorActividadesCaja" class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cerrar Caja -->
<div class="modal fade" id="modalCerrarCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Cerrar Caja</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="cerrarCajaError" class="alert alert-danger d-none"></div>

                <form id="formCerrarCaja">

                    <input type="hidden" id="Id" name="Id" />

                    <div class="mb-2">
                        <label class="mb-1">Sucursal</label>
                        <div id="labelSucursal" class="font-weight-bold"></div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <label>Usuario Inicio</label>
                            <input type="text" id="CajaDesc" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6 order-2 order-md-1">
                            <label>Caja Inicial</label>
                            <input type="text" id="CajaInicial" class="form-control" readonly />
                        </div>

                        <div class="col-md-6 order-1 order-md-2">
                            <label>Apertura</label>
                            <input type="text" id="FechaApertura" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Ventas</label>
                            <input type="text" id="Ventas" class="form-control" readonly />
                        </div>

                        <div class="col-md-6">
                            <label>EgresosCaja</label>
                            <input type="number" step="0.01" id="EgresosCaja" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Caja Cierre</label>
                            <input type="text" step="0.01" id="CajaCierre" name="CajaCierre" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>

                        <div class="col-md-6">
                            <label>Diferencia</label>
                            <input type="text" id="Diferencia" name="Diferencia" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Importe Retirado</label>
                            <input type="text" id="ImporteRetirado" name="ImporteRetirado" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>
                        <div class="col-md-6">
                            <label>Queda en Caja</label>
                            <input type="text" id="CajaInicioSiguiente" name="CajaInicioSiguiente" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                    <input type="hidden" id="Usuario" class="form-control" readonly />

                </form>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="guardarCierreCaja()">Cerrar Caja</button>
                <button class="btn btn-secondary" data-dismiss="modal" onclick="modalCerrarCaja()">Cancelar</button>
            </div>

        </div>
    </div>
</div>

<style>
    @@media (min-width: 992px) {
        #modalActividadesCaja .modal-dialog {
            width: 60%;
            max-width: none;
        }

        #modalCerrarCaja .modal-dialog {
            max-width: 620px;
            margin: 0.75rem auto;
        }

        #modalCerrarCaja .modal-content {
            max-height: calc(100vh - 1.5rem);
        }

        #modalCerrarCaja .modal-body {
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
            overflow-y: auto;
        }

        #modalCerrarCaja .modal-footer {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }

        #modalCerrarCaja hr {
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        #modalCerrarCaja label {
            margin-bottom: 0.15rem;
            font-size: 0.95rem;
        }

        #modalCerrarCaja .row {
            margin-bottom: 0.35rem;
        }

        #modalCerrarCaja .form-control {
            min-height: calc(1.35em + 0.45rem + 2px);
            padding-top: 0.2rem;
            padding-bottom: 0.2rem;
            font-size: 0.95rem;
        }

        #modalCerrarCaja .modal-header {
            padding-top: 0.6rem;
            padding-bottom: 0.6rem;
        }

        #modalCerrarCaja .modal-title {
            font-size: 1.1rem;
        }

        #modalCerrarCaja #Diferencia,
        #modalCerrarCaja #CajaInicioSiguiente {
            font-size: 1.1rem !important;
        }
    }
</style>

@section Scripts {
    <script>
        window.EgresosCajaUrls = {
            nuevo: '@Url.Action("NuevoEgresoCaja", "Cajas")',
            guardar: '@Url.Action("GuardarEgresoCaja", "Cajas")'
        };
        window.VentasCajaUrls = {
            mis: '@Url.Action("MisVentas", "Ventas")',
            detalle: '@Url.Action("DetalleVenta", "Ventas")'
        };
        window.CambioSucursalCajaUrls = {
            preview: '@Url.Action("PreviewCambioSucursalCaja", "Cajas")',
            guardar: '@Url.Action("CambiarSucursalCaja", "Cajas")'
        };

        function setBuscandoCajasAbiertas(buscando, mensaje) {
            const $btn = $("#btnBuscarCajasAbiertas");
            const $texto = $btn.find(".btn-buscar-texto");
            const $estado = $("#estadoBusquedaCajasAbiertas");

            $btn.prop("disabled", buscando);
            $texto.text(buscando ? "Cargando..." : "Buscar");
            $estado.text(mensaje || (buscando ? "Actualizando búsqueda..." : "Resultados actualizados."));
        }

        function filtrar() {
            const idSucursal = $("#idSucursal").val() || "";
            const buscar = $("#buscarVendedor").val() || "";

            let pos = 0;
            const txt = document.getElementById("buscarVendedor");
            if (txt && document.activeElement === txt && typeof txt.selectionStart === "number") {
                pos = txt.selectionStart;
            }

            setBuscandoCajasAbiertas(true);
            $("#tablaResultado").html('<div class="p-4 text-center text-muted">Cargando resultados...</div>');

            $.ajax({
                url: '@Url.Action("CajasAbiertas", "Cajas")',
                type: 'GET',
                data: {
                    idSucursal: idSucursal,
                    buscar: buscar,
                    ajax: true
                },
                cache: false,
                success: function (html) {
                    $("#tablaResultado").html(html);

                    if (txt) {
                        setTimeout(() => {
                            txt.focus();
                            try {
                                txt.setSelectionRange(pos, pos);
                            } catch (e) { }
                        }, 30);
                    }
                },
                error: function () {
                    $("#tablaResultado").html('<div class="alert alert-danger m-3 mb-0">No se pudo actualizar la búsqueda.</div>');
                    $("#estadoBusquedaCajasAbiertas").text("Ocurrió un error al actualizar la búsqueda.");
                },
                complete: function () {
                    const mensaje = $("#estadoBusquedaCajasAbiertas").text();
                    setBuscandoCajasAbiertas(false, mensaje === "Actualizando búsqueda..." ? "Resultados actualizados." : mensaje);
                }
            });
        }

        $(document).on('change', '#idSucursal', function () {
            filtrar();
        });

        $(function () {
            filtrar();
        });

        $(document)
            .off('show.bs.modal.cajasStack', '#modalActividadesCaja, #modalEgresoCaja, #modalCerrarCaja, #modalCambioSucursalCaja')
            .on('show.bs.modal.cajasStack', '#modalActividadesCaja, #modalEgresoCaja, #modalCerrarCaja, #modalCambioSucursalCaja', function () {
                var zIndex = 1040 + (10 * $('.modal.show').length);
                $(this).css('z-index', zIndex);

                setTimeout(function () {
                    $('.modal-backdrop').not('.modal-stack').last()
                        .css('z-index', zIndex - 1)
                        .addClass('modal-stack');
                }, 0);
            });

        function abrirModalActividades(idCierre, filtroActividad) {
            window.CajasAbiertas = window.CajasAbiertas || {};
            window.CajasAbiertas.idCierreActividadActual = idCierre;
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: '@Url.Action("ActividadesCaja", "Cajas")',
                type: 'GET',
                data: {
                    idCierre: idCierre,
                    filtroActividad: filtroActividad || "todos"
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function (xhr) {
                    let mensaje = "No se pudieron cargar las actividades de la caja.";
                    if (xhr && xhr.responseText) {
                        mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                    }
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">' + $('<div>').text(mensaje).html() + '</div>');
                }
            });
        }

        function abrirModalVentas(idCierre) {
            window.CajasAbiertas = window.CajasAbiertas || {};
            window.CajasAbiertas.idCierreActividadActual = idCierre;
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: window.VentasCajaUrls.mis,
                type: 'GET',
                data: {
                    idCierre: idCierre
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function (xhr) {
                    let mensaje = "No se pudieron cargar las ventas de la caja.";
                    if (xhr && xhr.responseText) {
                        mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                    }
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">' + $('<div>').text(mensaje).html() + '</div>');
                }
            });
        }

        function abrirDetalleVenta(idVenta, idCierre) {
            $("#contenedorActividadesCaja").html('<div class="p-4 text-center text-muted">Cargando...</div>');
            $("#modalActividadesCaja").modal("show");

            $.ajax({
                url: window.VentasCajaUrls.detalle,
                type: 'GET',
                data: {
                    id: idVenta,
                    modal: true,
                    idCierre: idCierre
                },
                cache: false,
                success: function (html) {
                    if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                        window.EgresosCaja.renderConScripts(html, "#contenedorActividadesCaja");
                        return;
                    }

                    $("#contenedorActividadesCaja").html(html);
                },
                error: function () {
                    $("#contenedorActividadesCaja").html('<div class="alert alert-danger m-3">No se pudo cargar el detalle de la venta.</div>');
                }
            });
        }

        window.CajasAbiertas = window.CajasAbiertas || {};
        window.CajasAbiertas.abrirActividades = abrirModalActividades;
        window.CajasAbiertas.abrirVentas = abrirModalVentas;
        window.CajasAbiertas.abrirDetalleVenta = abrirDetalleVenta;

        function abrirModalCambioSucursal(idCierre, idSucursalActual, sucursalActual, vendedor, fechaInicio) {
            $("#CambioSucursalIdCierre").val(idCierre);
            $("#CambioSucursalIdActual").val(idSucursalActual);
            $("#CambioSucursalUsuarioCaja").val(vendedor || "");
            $("#CambioSucursalFechaInicio").val(fechaInicio || "");
            $("#CambioSucursalActualNombre").val(sucursalActual || "");
            $("#CambioSucursalNueva").val("");
            $("#CambioSucursalNueva option").prop("disabled", false);
            if (idSucursalActual) {
                $("#CambioSucursalNueva option[value='" + idSucursalActual + "']").prop("disabled", true);
            }
            $("#cambioSucursalCajaError").addClass("d-none").text("");
            $("#cambioSucursalCajaPreview").removeClass("text-danger").addClass("text-muted").html("Selecciona la nueva sucursal para calcular los registros que se van a corregir.");
            $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
            $("#modalCambioSucursalCaja").modal("show");
        }

        function renderPreviewCambioSucursalCaja(resp) {
            if (!resp || !resp.ok) {
                $("#cambioSucursalCajaPreview").removeClass("text-muted").addClass("text-danger").text((resp && resp.mensaje) || "No se pudo generar la vista previa.");
                $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
                return;
            }

            const mensaje = $('<div>').text(resp.mensaje || "").html();
            let html = '<div class="mb-2"><strong>Rango:</strong> ' + $('<div>').text(resp.fechaDesde + ' - ' + resp.fechaHasta).html() + '</div>';
            html += '<div class="mb-2"><strong>Origen:</strong> ' + $('<div>').text(resp.sucursalActual || "").html() + '</div>';
            html += '<div class="mb-3"><strong>Destino:</strong> ' + $('<div>').text(resp.sucursalNueva || "").html() + '</div>';

            if (resp.tablas && resp.tablas.length) {
                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-2"><thead><tr><th>Tabla</th><th class="text-right">Registros</th></tr></thead><tbody>';
                resp.tablas.forEach(function (item) {
                    html += '<tr><td>' + $('<div>').text(item.tabla).html() + '</td><td class="text-right">' + item.cantidad + '</td></tr>';
                });
                html += '</tbody></table></div>';
            }

            html += '<div class="small ' + (resp.puedeEjecutar ? 'text-muted' : 'text-danger') + '">' + mensaje + '</div>';
            $("#cambioSucursalCajaPreview").removeClass("text-muted text-danger").html(html);
            $("#btnConfirmarCambioSucursalCaja").prop("disabled", !resp.puedeEjecutar);
        }

        function cargarPreviewCambioSucursalCaja() {
            const idCierre = $("#CambioSucursalIdCierre").val();
            const idSucursalNueva = $("#CambioSucursalNueva").val();

            if (!idCierre || !idSucursalNueva) {
                $("#cambioSucursalCajaPreview").removeClass("text-danger").addClass("text-muted").html("Selecciona la nueva sucursal para calcular los registros que se van a corregir.");
                $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
                return;
            }

            $("#cambioSucursalCajaError").addClass("d-none").text("");
            $("#cambioSucursalCajaPreview").removeClass("text-danger").addClass("text-muted").html("Calculando vista previa...");
            $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);

            $.ajax({
                url: window.CambioSucursalCajaUrls.preview,
                type: 'GET',
                data: {
                    idCierre: idCierre,
                    idSucursalNueva: idSucursalNueva
                },
                cache: false,
                success: function (resp) {
                    renderPreviewCambioSucursalCaja(resp);
                },
                error: function (xhr) {
                    let mensaje = "No se pudo generar la vista previa.";
                    if (xhr && xhr.responseText) {
                        mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                    }
                    renderPreviewCambioSucursalCaja({ ok: false, mensaje: mensaje });
                }
            });
        }

        function confirmarCambioSucursalCaja() {
            const idCierre = $("#CambioSucursalIdCierre").val();
            const idSucursalNueva = $("#CambioSucursalNueva").val();

            if (!idCierre || !idSucursalNueva) {
                $("#cambioSucursalCajaError").removeClass("d-none").text("Selecciona la nueva sucursal antes de continuar.");
                return;
            }

            Swal.fire({
                icon: 'warning',
                title: 'Confirmar cambio de sucursal',
                text: 'Esta accion corregira la sucursal de la caja y de todas las operaciones asociadas. Usar solo cuando el cajero trabajo por error en una sucursal incorrecta.',
                showCancelButton: true,
                confirmButtonText: 'Cambiar sucursal',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#f0ad4e'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

                $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
                $.ajax({
                    url: window.CambioSucursalCajaUrls.guardar,
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val(),
                        IdCierre: idCierre,
                        IdSucursalNueva: idSucursalNueva
                    },
                    success: function (resp) {
                        if (!resp || !resp.ok) {
                            $("#cambioSucursalCajaError").removeClass("d-none").text((resp && resp.mensaje) || "No se pudo cambiar la sucursal.");
                            $("#btnConfirmarCambioSucursalCaja").prop("disabled", false);
                            return;
                        }

                        $("#modalCambioSucursalCaja").modal("hide");
                        Swal.fire({
                            icon: 'success',
                            title: 'Sucursal corregida',
                            text: resp.mensaje || 'La sucursal de la caja se actualizo correctamente.',
                            confirmButtonText: 'Aceptar',
                            confirmButtonColor: '#4e73df'
                        }).then(() => {
                            filtrar();
                        });
                    },
                    error: function (xhr) {
                        let mensaje = "No se pudo cambiar la sucursal.";
                        if (xhr && xhr.responseText) {
                            mensaje = xhr.responseText.replace(/<[^>]+>/g, "").trim() || mensaje;
                        }
                        $("#cambioSucursalCajaError").removeClass("d-none").text(mensaje);
                        $("#btnConfirmarCambioSucursalCaja").prop("disabled", false);
                    }
                });
            });
        }

        $(document).on('change', '#CambioSucursalNueva', function () {
            cargarPreviewCambioSucursalCaja();
        });

        function abrirModalCerrarCaja(Id) {
            $("#cerrarCajaError").addClass("d-none").text("");

            $.ajax({
                url: '@Url.Action("ObtenerDatosCierre", "Cajas")',
                type: 'GET',
                data: { id: Id },
                success: function (data) {
                    $("#Id").val(data.id);
                    $("#labelSucursal").text(data.suc);
                    $("#CajaDesc").val(data.vendedor);
                    $("#FechaApertura").val(data.fechaApertura);
                    $("#CajaInicial").val(data.cajaInicial);
                    $("#Usuario").val(data.usuario);
                    $("#Ventas").val(data.ventas);
                    $("#EgresosCaja").val(data.egresosCaja);
                    $("#Diferencia").val("");
                    $("#modalCerrarCaja").modal("show");
                }
            });
        }

        $('#modalCerrarCaja').on('shown.bs.modal', function () {
            window.setTimeout(function () {
                $("#CajaCierre").trigger("focus").trigger("select");
            }, 100);
        });

        $('#modalCerrarCaja').on('hidden.bs.modal', function () {
            $(this).find('input:not([type="hidden"])').val('');
            $(this).find('textarea').val('');
            $(this).find('select').prop('selectedIndex', 0);
            $('.text-danger').addClass('d-none').text('');
        });

        $(document).on('keydown', '#CajaCierre, #ImporteRetirado', function (e) {
            if (e.key !== 'Enter') {
                return;
            }

            e.preventDefault();

            if (this.id === 'CajaCierre') {
                $("#ImporteRetirado").trigger("focus").trigger("select");
                return;
            }

            if (this.id === 'ImporteRetirado') {
                $("#modalCerrarCaja .modal-footer .btn-danger").trigger("focus");
            }
        });

        $('#modalCambioSucursalCaja').on('hidden.bs.modal', function () {
            $("#CambioSucursalIdCierre").val('');
            $("#CambioSucursalIdActual").val('');
            $("#CambioSucursalUsuarioCaja").val('');
            $("#CambioSucursalFechaInicio").val('');
            $("#CambioSucursalActualNombre").val('');
            $("#CambioSucursalNueva").val('');
            $("#CambioSucursalNueva option").prop("disabled", false);
            $("#cambioSucursalCajaError").addClass("d-none").text('');
            $("#cambioSucursalCajaPreview").removeClass("text-danger").addClass("text-muted").html('Selecciona la nueva sucursal para calcular los registros que se van a corregir.');
            $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
        });

        function esNumeroValido(v) {
            return /^-?\d*(\.\d+)?$/.test(v);
        }

        function guardarCierreCaja() {
            let data = {
                Id: $("#Id").val(),
                CajaCierre: $("#CajaCierre").val(),
                Diferencia: $("#Diferencia").val(),
                ImporteRetirado: $("#ImporteRetirado").val(),
                CajaInicioSiguiente: $("#CajaInicioSiguiente").val()
            };

            $.ajax({
                url: '@Url.Action("CerrarCaja", "Cajas")',
                type: 'POST',
                data: data,
                success: function (resp) {
                    if (!resp.ok) {
                        $("#cerrarCajaError").removeClass("d-none").text(resp.error);
                        return;
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Caja cerrada',
                        text: 'La caja se cerró correctamente',
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: '#4e73df',
                        focusConfirm: true
                    }).then(() => {
                        let idSucursal = $("#idSucursal").val() || "";
                        window.location.href = '@Url.Action("CajasAbiertas", "Cajas")' + '?idSucursal=' + encodeURIComponent(idSucursal) + '&buscar=';
                    });
                }
            });
        }

        function toFloat(value) {
            let v = value.trim();
            if (v === "") return 0;
            v = v.replace(",", ".");
            return parseFloat(v) || 0;
        }

        function validarNumero(input) {
            let v = input.value;
            v = v.replace(/[^\d.,]/g, "");
            v = v.replace(",", ".");

            const partes = v.split(".");
            if (partes.length > 2) {
                v = partes[0] + "." + partes[1];
            }

            input.value = v;
        }

        function recalcularCierre() {
            let cajaInicial = toFloat($("#CajaInicial").val());
            let ventas = toFloat($("#Ventas").val());
            let gastos = toFloat($("#EgresosCaja").val());
            let cajaCierre = toFloat($("#CajaCierre").val());
            let importeRetirado = toFloat($("#ImporteRetirado").val());

            let diferencia = (gastos + cajaCierre) - (cajaInicial + ventas);

            if ($("#CajaCierre").val().length > 0)
                $("#Diferencia").val(diferencia.toFixed(2));
            else
                $("#Diferencia").val("");

            let cajaInicioSiguiente = cajaCierre - importeRetirado;
            $("#CajaInicioSiguiente").val(cajaInicioSiguiente.toFixed(2));

            colorearDiferencia();
        }

        function colorearDiferencia() {
            let valor = parseFloat($("#Diferencia").val().replace(",", "."));

            if (isNaN(valor)) {
                $("#Diferencia").css("background-color", "white");
                return;
            }

            if (valor >= -100 && valor <= 100) {
                $("#Diferencia").css("background-color", "#c8f7c5");
            }
            else if ((valor > 100 && valor <= 300) || (valor < -100 && valor >= -300)) {
                $("#Diferencia").css("background-color", "#fff3b0");
            }
            else {
                $("#Diferencia").css("background-color", "#f7c6c6");
            }
        }
    </script>
    <script src="@Url.Content("~/Scripts/app/egresos-caja.js?v=7")"></script>
}
