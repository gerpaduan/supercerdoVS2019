@model Web.Models.PuntoExpendioEditVm
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    var modalProductoData = new ViewDataDictionary
    {
        { "ModalId", "modalBuscarProductoPuntoExpendio" },
        { "ApiUrl", Url.Action("BuscarProducto", "PuntosExpendio") },
        { "Titulo", "Buscar producto para Punto de expendio" },
        { "MostrarPrecio", "true" }
    };

    bool haySectores = Model.SectoresDisponibles != null && Model.SectoresDisponibles.Count > 0;
}

<div class="container-fluid px-2 px-md-3 punto-expendio-page" data-punto-expendio-page="1">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="@Url.Action("Sectores", "PuntosExpendio")">
                <i class="fas fa-layer-group mr-1"></i> Sectores
            </a>

            @if (Model.EsGuardado)
            {
                <a class="btn btn-success" href="@Url.Action("Abrir", "PuntosExpendio")">
                    <i class="fas fa-plus mr-1"></i> Nuevo punto
                </a>
                <button type="button" class="btn btn-primary" id="btnImprimirPuntoExpendio" data-imprimir-url="@Url.Action("ImprimirTicket", "PuntosExpendio", new { id = Model.IdExpendio })">
                    <i class="fas fa-print mr-1"></i> Imprimir ticket
                </button>
            }
            else if (haySectores)
            {
                <button type="button" class="btn btn-outline-primary" id="btnCambiarSector">
                    <i class="fas fa-store mr-1"></i> Seleccionar sector
                </button>
            }
        </div>
    </div>

    @if (Model.EsGuardado)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Nro. expendio</div>
                        <div class="h4 mb-0">@Model.IdExpendio</div>
                    </div>
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Sector</div>
                        <div class="font-weight-bold">@Model.Sector</div>
                    </div>
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Fecha</div>
                        <div class="font-weight-bold">@Model.FechaExpendio.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Identificación cliente</div>
                        <div class="font-weight-bold">@(string.IsNullOrWhiteSpace(Model.IdentificacionCliente) ? "-" : Model.IdentificacionCliente)</div>
                    </div>
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Sucursal</div>
                        <div class="font-weight-bold">@Model.SucursalNombre</div>
                    </div>
                    <div class="col-12 col-lg-3 mb-3">
                        <div class="small text-muted">Vendedor</div>
                        <div class="font-weight-bold">@Model.VendedorNombre</div>
                    </div>
                    <div class="col-12 col-lg-2 mb-3">
                        <div class="small text-muted">Items</div>
                        <div class="font-weight-bold">@Model.CantItems</div>
                    </div>
                    <div class="col-12 col-lg-2 mb-3">
                        <div class="small text-muted">Kgs.</div>
                        <div class="font-weight-bold">@Model.TotalKilos.ToString("N3")</div>
                    </div>
                    <div class="col-12 col-lg-2 mb-3">
                        <div class="small text-muted">Total</div>
                        <div class="font-weight-bold">$ @Model.TotalImporte.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.EsGuardado && !haySectores)
    {
        <div class="alert alert-warning">
            No hay sectores configurados para esta empresa.
            <a class="alert-link" href="@Url.Action("Sectores", "PuntosExpendio")">Crear sectores</a>
        </div>
    }

    @if (!Model.EsGuardado && haySectores && string.IsNullOrWhiteSpace(Model.Sector))
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5 class="mb-3">Seleccioná un sector para abrir el punto de expendio</h5>
                <p class="text-muted mb-4">El sector define el puesto de trabajo con el que se registrará el expendio.</p>
                <button type="button" class="btn btn-primary btn-lg" id="btnSeleccionarSectorInicial">
                    <i class="fas fa-store mr-1"></i> Elegir sector
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Sector))
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-12 col-lg-3">
                        <div class="form-group mb-0">
                            <label>Sector</label>
                            <input type="text" class="form-control" value="@Model.Sector" readonly />
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group mb-0">
                            <label>Fecha</label>
                            <input type="text" class="form-control" value="@Model.FechaExpendio.ToString("dd/MM/yyyy HH:mm")" readonly="@(Model.EsGuardado ? "readonly" : null)" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group mb-0">
                            <label>Sucursal</label>
                            <input type="text" class="form-control" value="@Model.SucursalNombre" readonly />
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="form-group mb-0">
                            <label>Vendedor</label>
                            <input type="text" class="form-control" value="@Model.VendedorNombre" readonly />
                        </div>
                    </div>
                </div>

                @if (!Model.EsGuardado)
                {
                    using (Html.BeginForm("Guardar", "PuntosExpendio", FormMethod.Post, new { id = "formPuntoExpendio", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Sector)
                        @Html.HiddenFor(m => m.IdExpendio)
                        @Html.HiddenFor(m => m.EsGuardado)
                        <div id="lineasHiddenContainer"></div>

                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-12 col-lg-4">
                                <div class="form-group">
                                    <label for="FechaExpendio">Fecha del expendio</label>
                                    @Html.TextBoxFor(m => m.FechaExpendio, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", id = "FechaExpendio" })
                                </div>
                            </div>
                            <div class="col-12 col-lg-8">
                                <div class="form-group">
                                    <label for="IdentificacionCliente">Identificación cliente</label>
                                    @Html.TextBoxFor(m => m.IdentificacionCliente, new { @class = "form-control", id = "IdentificacionCliente", maxlength = "120", autocomplete = "off", placeholder = "Dato libre para identificar al cliente" })
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h6 class="font-weight-bold text-uppercase text-muted mb-0">Agregar producto</h6>
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="chkBalanzaLinea" checked />
                                    <label class="custom-control-label" for="chkBalanzaLinea">Balanza</label>
                                </div>
                            </div>

                            <div class="row align-items-end">
                                <div class="col-12 col-md-3 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCodigoProductoExpendio">Código</label>
                                        <input type="number" id="txtCodigoProductoExpendio" class="form-control" min="0" step="1" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-9 col-lg-5">
                                    <div class="form-group">
                                        <label for="txtProductoNombreExpendio">Producto</label>
                                        <div class="input-group">
                                            <input type="hidden" id="txtProductoIdExpendio" />
                                            <input type="text" id="txtProductoNombreExpendio" class="form-control app-product-highlight" readonly />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary" id="btnBuscarProductoExpendio" title="Buscar producto (F10)">
                                                    <i class="fas fa-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtCantKgsExpendio">Kgs.</label>
                                        <input type="text" id="txtCantKgsExpendio" class="form-control solo-decimal" inputmode="decimal" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="form-group">
                                        <label for="txtPrecioKgExpendio">Precio/Kg</label>
                                        <input type="text"
                                               id="txtPrecioKgExpendio"
                                               class="form-control solo-decimal"
                                               inputmode="decimal"
                                               autocomplete="off"
                                               @(Model.PermiteEditarPrecio ? "" : "readonly=\"readonly\"") />
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 col-lg-1">
                                    <button type="button" class="btn btn-primary btn-block" id="btnAgregarLineaExpendio">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div id="puntoExpendioWarning" class="alert alert-warning py-2 px-3 mb-0 d-none"></div>
                        </div>

                        <div class="row">
                            <div class="col-12 col-xl-8">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0" id="tablaLineasPuntoExpendio">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width:110px;">Código</th>
                                                <th>Producto</th>
                                                <th class="text-right" style="width:110px;">Kgs.</th>
                                                <th class="text-right" style="width:130px;">Precio/Kg</th>
                                                <th class="text-right" style="width:130px;">Total</th>
                                                <th class="text-center" style="width:90px;">Balanza</th>
                                                <th style="width:70px;">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12 col-xl-4">
                                <div class="card bg-light mt-3 mt-xl-0">
                                    <div class="card-body">
                                        <h6 class="font-weight-bold text-uppercase text-muted">Resumen</h6>
                                        <div class="d-flex justify-content-between">
                                            <span>Total items</span>
                                            <strong id="lblTotalItemsExpendio">@Model.CantItems</strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Total kilos</span>
                                            <strong id="lblTotalKilosExpendio">@Model.TotalKilos.ToString("N3")</strong>
                                        </div>
                                        <hr />
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>Total</span>
                                            <strong id="lblTotalImporteExpendio">$ @Model.TotalImporte.ToString("N2")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 d-flex flex-wrap align-items-center">
                            <button type="submit" class="btn btn-success mr-2 mb-2" id="btnGuardarPuntoExpendio">
                                <i class="fas fa-save mr-1"></i> Guardar punto de expendio
                            </button>
                            <a href="@Url.Action("Abrir", "PuntosExpendio")" class="btn btn-outline-secondary mb-2">
                                Cancelar
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width:110px;">Código</th>
                                    <th>Producto</th>
                                    <th class="text-right" style="width:110px;">Kgs.</th>
                                    <th class="text-right" style="width:130px;">Precio/Kg</th>
                                    <th class="text-right" style="width:130px;">Total</th>
                                    <th class="text-center" style="width:90px;">Balanza</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Lineas == null || Model.Lineas.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No hay líneas cargadas.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var linea in Model.Lineas)
                                    {
                                        <tr>
                                            <td>@linea.Codigo</td>
                                            <td>@linea.Producto</td>
                                            <td class="text-right">@linea.CantKg.ToString("N3")</td>
                                            <td class="text-right">$ @linea.PrecioKg.ToString("N2")</td>
                                            <td class="text-right">$ @linea.Total.ToString("N2")</td>
                                            <td class="text-center">@(linea.PesoBalanza ? "Sí" : "No")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalSectoresPuntoExpendio" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title mb-0">Seleccionar sector</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="text" id="txtBuscarSectorExpendio" class="form-control mb-3" placeholder="Buscar sector..." autocomplete="off" />

                <div class="list-group" id="listaSectoresExpendio">
                    @if (!haySectores)
                    {
                        <div class="text-muted">No hay sectores disponibles.</div>
                    }
                    else
                    {
                        foreach (var sector in Model.SectoresDisponibles)
                        {
                            <button type="button" class="list-group-item list-group-item-action js-sector-item" data-sector="@sector">@sector</button>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-secondary" href="@Url.Action("Sectores", "PuntosExpendio")">Administrar sectores</a>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Productos/_BuscarProductoModal.cshtml", modalProductoData)

@section Scripts {
    <script>
        (function () {
            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                    window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
                }
            }

            var form = document.getElementById("formPuntoExpendio");
            if (form) {
                form.addEventListener("submit", function () {
                    showNavigationLoading("Cargando solicitud...");
                });
            }

            document.addEventListener("click", function (event) {
                var link = event.target.closest ? event.target.closest(".punto-expendio-page a[href]") : null;
                if (!link) return;
                if (link.target === "_blank" || link.hasAttribute("download")) return;

                var href = link.getAttribute("href") || "";
                if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

                event.preventDefault();
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    window.location.href = link.href;
                }, 0);
            });
        })();
    </script>
    <script>
        window.puntoExpendioConfig = {
            urlBuscarProductoPorCodigo: '@Url.Action("BuscarProductoPorCodigo", "PuntosExpendio")',
            urlAbrir: '@Url.Action("Abrir", "PuntosExpendio")',
            sectorSeleccionado: '@(Model.Sector ?? "")',
            permiteEditarPrecio: @(Model.PermiteEditarPrecio ? "true" : "false"),
            esGuardado: @(Model.EsGuardado ? "true" : "false")
        };
        window.puntoExpendioLineasIniciales = @Html.Raw(Json.Encode(Model.Lineas ?? new List<Web.Models.PuntoExpendioLineaVm>()));
        window.EditPageGuard && window.EditPageGuard.init({
            formSelector: "#formPuntoExpendio",
            saveButtonSelector: "#btnGuardarPuntoExpendio"
        });
    </script>
    <script src="@Url.Content("~/Scripts/app/puntos-expendio.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/busqueda-feedback.js?v=2")"></script>
}
