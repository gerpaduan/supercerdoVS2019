@model Entidades.Venta
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Text

@{
    Layout = null;

    int mm = ViewBag.TicketMm != null ? (int)ViewBag.TicketMm : 58;
    int cantMaxChar = mm == 80 ? 43 : 30;
    var sb = new StringBuilder();
    string barcodeValue = "PE" + Model.IdExpendio + "F";
    var barcodeBits = new List<int>();

    Func<string, string> truncar = texto =>
    {
        string valor = texto ?? "";
        return valor.Length <= cantMaxChar ? valor : valor.Substring(0, cantMaxChar);
    };

    Func<string, string> centrar = texto =>
    {
        string valor = truncar(texto ?? "");
        int libres = Math.Max(0, cantMaxChar - valor.Length);
        int izquierda = libres / 2;
        return new string(' ', izquierda) + valor;
    };

    Func<string, string, string> extremos = (izquierda, derecha) =>
    {
        string i = izquierda ?? "";
        string d = derecha ?? "";
        if (i.Length > 18) i = i.Substring(0, 18);
        if (d.Length > 18) d = d.Substring(0, 18);
        int espacios = Math.Max(1, cantMaxChar - i.Length - d.Length);
        return i + new string(' ', espacios) + d;
    };

    Action<string> linea = texto => sb.AppendLine(texto ?? "");

    string guion = new string('-', 20);
    linea(centrar(Model.Sector ?? ""));
    linea("");
    linea(truncar("Nro Expendio: " + Model.IdExpendio));
    linea(truncar("Id.Cliente: " + (Model.IdentificacionExpendio ?? "")));
    linea(extremos("Fecha: " + Model.FechaVenta.ToString("dd/MM/yyyy"), "Hora: " + Model.FechaVenta.ToString("HH:mm:ss")));
    linea(guion);

    foreach (var item in Model.LineasVenta ?? new List<Entidades.LineaVenta>())
    {
        string cantidad = item.CantKg.ToString("F3") + " x " + item.PrecioKg.ToString("N2");
        linea(truncar(cantidad));

        string producto = ((item.Corte != null ? item.Corte.codigo.ToString() + " " : "") +
            (item.Corte != null ? (!string.IsNullOrWhiteSpace(item.Corte.corte) ? item.Corte.corte : item.Corte.CorteDesc) : "")).Trim();

        if (producto.Length > 22)
        {
            producto = producto.Substring(0, 22);
        }

        string total = (item.CantKg * item.PrecioKg).ToString("N2");
        int espacios = Math.Max(1, cantMaxChar - producto.Length - total.Length);
        linea(producto + new string(' ', espacios) + total);
    }

    linea("-------".PadLeft(cantMaxChar));
    string totalTexto = Model.TotalImporte.ToString("N2");
    linea("Total" + new string(' ', Math.Max(1, cantMaxChar - "Total".Length - totalTexto.Length)) + totalTexto);
    linea("");
    linea(truncar("Articulos: " + ((Model.LineasVenta ?? new List<Entidades.LineaVenta>()).Count)));
    linea(truncar("Cajero: " + (Model.Vendedor != null ? Model.Vendedor.Id.ToString() : "")));
    linea(centrar("Gracias por su visita"));
    linea(" ");
    linea(" ");
    linea(" ");
    string ticketTexto = sb.ToString();
    string ticketClass = mm == 80 ? "ticket-80mm" : "ticket-58mm";

    foreach (char ch in barcodeValue)
    {
        int ascii = (int)ch;
        for (int bit = 6; bit >= 0; bit--)
        {
            barcodeBits.Add(((ascii >> bit) & 1) == 1 ? 2 : 1);
        }

        barcodeBits.Add(1);
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Punto de expendio @Model.IdExpendio</title>
    <style>
        @@page {
            margin: 0;
            size: @(mm == 80 ? "80mm" : "58mm") auto;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #fff;
            color: #000;
            font-family: Consolas, "Courier New", monospace;
        }

        body.ticket-58mm {
            width: 58mm;
        }

        body.ticket-80mm {
            width: 80mm;
        }

        .ticket-text {
            margin: 0;
            padding: 3mm 2.5mm;
            white-space: pre-wrap;
            font-size: 12px;
            line-height: 1.22;
        }

        .ticket-code {
            padding: 0 2.5mm 4mm;
            text-align: center;
            page-break-inside: avoid;
        }

        .ticket-barcode-visual {
            display: inline-flex;
            align-items: flex-end;
            justify-content: center;
            gap: 1px;
            margin: 0 auto 1.5mm;
            padding: 2mm 1.5mm 0;
        }

        .ticket-barcode-bar {
            display: block;
            width: 0;
            height: 18mm;
            border-left-style: solid;
            border-left-color: #000;
        }

        .ticket-barcode-bar.w1 {
            border-left-width: 1px;
        }

        .ticket-barcode-bar.w2 {
            border-left-width: 2px;
        }

        .ticket-code-label {
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 1mm;
        }

        .ticket-code-value {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0;
        }
    </style>
</head>
<body class="@ticketClass" onload="window.print()">
    <pre class="ticket-text">@ticketTexto</pre>
    <div class="ticket-code">
        <div class="ticket-barcode-visual" aria-hidden="true">
            @foreach (var bitWidth in barcodeBits)
            {
                <span class="ticket-barcode-bar w@(bitWidth > 1 ? 2 : 1)"></span>
            }
        </div>
        <div class="ticket-code-label">Codigo expendio</div>
        <div class="ticket-code-value">@barcodeValue</div>
    </div>
    
    @for (int i = 0; i < 10; i++)
    {
        <pre class="ticket-text">&nbsp;</pre>
    }
</body>
</html>
