    @@media (min-width: 1400px) {
        /* Bug preexistente encontrado y corregido: esta regla convertia
           .pos-topbar-expendio en una grilla de 2 columnas (250px + resto),
           esperando que .pos-topbar-header ocupara la segunda columna -- pero
           esa clase no existe en el markup actual de Expendio (0 usos en el
           archivo). Sin ese segundo elemento, .pos-topbar-grid (el unico hijo
           real) caia entero en la primera columna de ~250-320px, aplastando
           sus propias 4 columnas (Cliente/Sucursal/Fecha/Acciones) contra ese
           ancho angosto -- mientras el resto del espacio (~1200px en una
           pantalla de 1536px) quedaba vacio. Confirmado con Chrome real
           (getBoundingClientRect) en viewport >=1400px. Se saca el split de
           2 columnas: .pos-topbar-expendio vuelve a su regla base
           (flex-direction: column, linea ~515), dejando que .pos-topbar-grid
           ocupe todo el ancho como ya hace correctamente en <1400px. */

        .pos-topbar-grid {
            /* Columna de acciones (4ta) ampliada de minmax(110px,.45fr) a minmax(400px,1fr):
               con el ancho angosto original, "Duplicar POS" + "Salir" no entraban en una sola
               linea, hacian wrap (via .pos-topbar-item-actions-group flex-wrap) y la segunda
               linea quedaba fuera de la celda (min-height:50px) y se recortaba por este mismo
               overflow:hidden -- "Salir" desaparecia visualmente. Confirmado con Chrome real
               (getBoundingClientRect) en viewport 1536px. Se le resta ancho a sucursal/fecha
               (sobraba: su contenido es corto y no lo necesitaba). */
            grid-template-columns: minmax(290px, 1.1fr) minmax(150px, .5fr) minmax(165px, .55fr) minmax(400px, 1fr);
            gap: .35rem;
            height: 100%;
            overflow: hidden;
        }

        .pos-topbar-item {
            min-height: 50px;
        }

        .pos-topbar-item {
            padding: .34rem .46rem;
        }

        .pos-topbar-item-cliente {
            grid-column: auto;
            min-width: 0;
            max-width: none;
            padding: .28rem .4rem;
        }

        .pos-topbar-label {
            font-size: .62rem;
        }

        .pos-topbar-value {
            font-size: .82rem;
        }

        .pos-expendio-page .pos-btn-layout {
            min-height: 100%;
            white-space: nowrap;
            padding-left: .8rem;
            padding-right: .8rem;
        }

