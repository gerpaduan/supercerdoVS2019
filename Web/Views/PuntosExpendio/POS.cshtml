    .pos-expendio-page .pos-topbar-item-actions-group .pos-btn-layout {
        /* Bug preexistente encontrado: esta regla y la base ".pos-expendio-page .pos-btn-layout"
           (width:100%, mas abajo en el archivo) tenian la MISMA especificidad (0,2,0 vs 0,2,0)
           -- por orden de aparicion en el CSS ganaba la base, asi que "Duplicar POS" y "Salir"
