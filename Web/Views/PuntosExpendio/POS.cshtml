        .input-group.input-group-sm > .input-group-append > .btn {
            min-height: 34px;
        }

        #razonSocial {
            font-size: calc(1rem + 1pt);
            font-weight: 700;
        }
    }

    @@media (max-width: 1399.98px) and (min-width: 992px) {
