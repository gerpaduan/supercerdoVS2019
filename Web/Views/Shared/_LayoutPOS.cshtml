@{
    Layout = null;
    var user = Session["Usuario"] as Entidades.Usuario;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewBag.Title - Punto de Venta</title>

    <!-- Fuentes y estilos SB Admin 2 -->
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">
    <link href="~/Content/css/sb-admin-2.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fc;
        }

        .pos-container {
            padding: 0 1.5rem;
        }

        .navbar-pos {
            background: #4e73df;
            color: white;
            padding: 0.75rem 1rem;
        }

            .navbar-pos .title {
                font-size: 1.3rem;
                font-weight: 700;
            }

        .user-info {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .content-wrapper {
            margin-top: 1rem;
        }
    </style>
</head>
<body id="page-top">

    <!-- Topbar POS -->
    <nav class="navbar navbar-expand navbar-pos topbar mb-4 static-top shadow">
        <div class="title">PUNTO DE VENTA</div>

        <button id="btn-toggle-fullscreen" class="btn btn-sm btn-light ml-3">Pantalla completa</button>

        <ul class="navbar-nav ml-auto">
            @if (user != null)
            {
                <li class="nav-item dropdown no-arrow">
                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                        <span class="mr-2 d-none d-lg-inline text-white user-info">@user.Nombre</span>
                        <img class="img-profile rounded-circle" src="~/Content/img/user.png" />
                    </a>
                    <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                        <a class="dropdown-item" href="~/Home/Index">
                            <i class="fas fa-home fa-sm fa-fw mr-2 text-gray-400"></i> Volver al sistema
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="~/Login/Logout">
                            <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i> Cerrar sesión
                        </a>
                    </div>
                </li>
            }
        </ul>
    </nav>

    <!-- Contenido principal -->
    <div class="container-fluid pos-container">
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts SB Admin 2 -->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Content/js/sb-admin-2.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
