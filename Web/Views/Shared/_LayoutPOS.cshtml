                -webkit-overflow-scrolling: touch !important;
                display: block !important;
                padding-bottom: 10px;
            }

                .tabla-full table {
                    width: max-content !important;
                    min-width: 900px !important;
                }
        }

        /* ===== TOPBAR: botón tema prolijo ===== */
        .topbar-icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
