@{
    var user = Session["Usuario"] as Entidades.Usuario;

    var controller = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    var action = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();

    if (user == null && !(controller == "Login" && action == "Index"))
    {
        Response.Redirect("~/Login/Index");
    }
}
<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>CarniSys web - Dashboard</title>

    <!-- Custom styles for this template-->
    <link href="@Url.Content("~/Content/vendor/fontawesome-free/css/all.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/sb-admin-2.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/custom.css")" rel="stylesheet" />
    <!-- TU CSS -->
    <link href="@Url.Content("~/Content/css/dark-mode.css?v=6")" rel="stylesheet" />

    <style>
        @@media (max-width: 992px) {
            .tabla-full {
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch !important;
                display: block !important;
                padding-bottom: 10px;
            }

                .tabla-full table {
                    width: max-content !important;
                    min-width: 900px !important;
                }
        }
    </style>

    <!-- Variable global para AJAX -->
    <script>
        var baseUrl = '@Url.Content("~/")';

        function manejarPermiso(resp) {
            if (resp && resp.error) {
                Swal.fire("Permiso denegado", resp.error, "error");
                return false;
            }
            return true;
        }


    </script>


</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">
                <!-- Topbar -->
                <nav class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    @*<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">*@

                    <!-- Título de la sección (IZQUIERDA) -->
                    <span class="navbar-text text-light h5 mr-3" style="font-weight: bold;">
                        @ViewBag.Title
                    </span>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <!-- Nav Item - Search Dropdown (Visible Only XS) -->
                        <!--<li class="nav-item dropdown no-arrow d-sm-none">
                        <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-search fa-fw"></i>
                        </a>-->
                        <!-- Dropdown - Messages -->
                        <!--<div class="dropdown-menu dropdown-menu-right p-3 shadow animated--grow-in"
                                 aria-labelledby="searchDropdown">
                                <form class="form-inline mr-auto w-100 navbar-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control bg-light border-0 small"
                                               placeholder="Search for..." aria-label="Search"
                                               aria-describedby="basic-addon2">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="button">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </li>-->
                        <li class="nav-item">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="toggleDarkMode">
                                <label class="form-check-label" for="toggleDarkMode">Modo nocturno</label>
                            </div>
                        </li>
                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle d-flex align-items-center"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">

                                <span class="mr-2 d-none d-lg-inline text-light small">
                                    @(Session["Usuario"] != null
                                        ? ((Entidades.Usuario)Session["Usuario"]).Nombre
                                        : "")
                                </span>

                                <i class="fas fa-user-circle fa-2x text-light"></i>
                            </a>

                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                @*<a class="dropdown-item" href="#">
                                        <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Profile
                                    </a>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Settings
                                    </a>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-list fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Activity Log
                                    </a>*@
                                @*<div class="dropdown-divider"></div>*@
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Logout
                                </a>
                            </div>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->
                <!-- Aquí se muestra el contenido dinámico de cada vista -->
                <div id="pos-container">
                    @RenderBody()
                </div>


            </div>
            <!-- End of Main Content -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">¿Desea salir?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Selecciona "Cerrar sesión" abajo si deseas finalizar tu sesión actual.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                    <a class="btn btn-primary" href="@Url.Action("Logout", "Login")">Cerrar sesión</a>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL SESIÓN EXPIRADA -->
    <div class="modal fade"
         id="modalSesionExpirada"
         tabindex="-1"
         data-bs-backdrop="static"
         data-bs-keyboard="false">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        Sesión expirada
                    </h5>
                </div>

                <div class="modal-body text-center">
                    <p class="mb-2">
                        La sesión se cerró por seguridad.
                    </p>
                    <p class="fw-bold mb-0">
                        Presione <strong>Reingresar</strong> para continuar.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-danger w-100"
                            onclick="redirigirLogin()">
                        Reingresar
                    </button>
                </div>

            </div>
        </div>
    </div>


    <!-- Scripts -->
    <script src="@Url.Content("~/Content/vendor/jquery/jquery.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/jquery-easing/jquery.easing.min.js")"></script>
    <script src="@Url.Content("~/Content/js/sb-admin-2.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/app/persona-buscar.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/forma-pago.js?v=5")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-postventa.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-productos.js?")"></script>



    <script src="@Url.Content("~/Content/js/scripts.js?v=2")"></script>

    <script>
        window.keepAliveUrl = '@Url.Action("KeepAlive", "Session")';
        window.loginUrl = '@Url.Action("Index", "Login")';
        window.buscarProductoUrl = '@Url.Action("BuscarProducto", "Ventas")';
    </script>


    @RenderSection("Scripts", required: false)


    <style>

        /* Base */
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden; /* 🔴 nunca scroll del body */
        }

        /* Cadena de altura */
        #page-top,
        #wrapper,
        #content-wrapper {
            height: 100%;
        }

        /* Layout principal */
        #content-wrapper {
            display: flex;
            flex-direction: column;
        }

        /* Topbar: alto fijo */
        .card-header {
            flex: 0 0 auto;
        }

        /* Contenedor dinámico */
        #pos-container {
            flex: 1 1 auto; /* ocupa el resto */
            overflow: auto; /* scroll SOLO acá */
            padding: 0;
            min-height: 0; /* 🔑 evita overflow fantasma */
        }
    </style>

</body>
</html>
