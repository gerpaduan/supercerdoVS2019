    <link href="@Url.Content("~/Content/css/sb-admin-2.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/custom.css?v=2")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/dark-mode.css?v=9")" rel="stylesheet" />

    <style>
