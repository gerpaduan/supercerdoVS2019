        body.dark-mode .card-header {
            background-color: #1d293a !important;
            color: #e6e6e6 !important;
            border-bottom: 1px solid #3c3f45;
        }
    </style>    

    <!-- Variable global para AJAX -->
    <script>
        var baseUrl = '@Url.Content("~/")';
        window.AppUrls = window.AppUrls || {};
        window.AppUrls.homeIndex = '@Url.Action("Index", "Home")';
        window.AppUrls.cajasAbiertas = '@Url.Action("CajasAbiertas", "Cajas")';
        window.AppUrls.ventasPos = '@Url.Action("POS", "Ventas")';
        window.AppUrls.ventasImprimir = '@Url.Action("ImprimirTicket", "Ventas")';
        window.AppUrls.ventasImprimirPayload = '@Url.Action("ImprimirTicketPayload", "Ventas")';
        window.AppUrls.ventasGenerarFactura = '@Url.Action("GenerarFactura", "Ventas")';
        window.AppUrls.ventasCerrarSinFacturar = '@Url.Action("CerrarVentaSinFacturar", "Ventas")';
        window.AppUrls.ventasGenerarNotaCredito = '@Url.Action("GenerarNotaCredito", "Ventas")';

        function manejarPermiso(resp) {
            if (resp && resp.error) {
                Swal.fire("Permiso denegado", resp.error, "error");
                return false;
            }
            return true;
        }
    </script>

</head>

