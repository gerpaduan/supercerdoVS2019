    <!-- =========================================================
    ANTI-FLASH (modo oscuro): aplica clase ANTES del primer paint
    ========================================================= -->
    <script>
        (function () {
            try {
                var mode = localStorage.getItem("carnisys-theme"); // "dark" | "light"
                if (mode === "dark") {
                    document.documentElement.classList.add("dark-mode");
                }
            } catch (e) { }
        })();
    </script>

    <style>
        /* Evita el flash blanco (aplica aunque todavía no cargó tu CSS) */
        html, body {
            height: 100%;
            margin: 0;
        }

            html.dark-mode, html.dark-mode body {
                background: #0f1724 !important;
                color: rgba(255,255,255,.92);
            }

            html.dark-mode {
                color-scheme: dark;
            }
    </style>

