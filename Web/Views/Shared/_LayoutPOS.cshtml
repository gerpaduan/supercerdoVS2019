         data-bs-keyboard="false">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Sesión expirada</h5>
                </div>

                <div class="modal-body text-center">
                    <p class="mb-2">La sesión se cerró por seguridad.</p>
                    <p class="fw-bold mb-0">
                        Presione <strong>Reingresar</strong> para continuar.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-danger w-100"
                            onclick="redirigirLogin()">
                        Reingresar
                    </button>
                </div>

            </div>
        </div>
    </div>


    <script>
        const urlCambiarSucursal = '@Url.Action("CambiarSucursal", "Login")';
        window.keepAliveUrl = '@Url.Action("KeepAlive", "Session")';
    </script>

    <!-- Scripts -->
    <script src="@Url.Content("~/Content/vendor/jquery/jquery.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/jquery-easing/jquery.easing.min.js")"></script>
    <script src="@Url.Content("~/Content/js/sb-admin-2.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/Scripts/app/pos-guard.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/persona-buscar.js?v=7")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-postventa.js?v=20")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-sucursales.js")"></script>
<script src="@Url.Content("~/Scripts/app/forma-pago.js?v=29")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-productos.js?v=6")"></script>
    <script src="@Url.Content("~/Scripts/app/factura-electronica.js?v=9")"></script>
    <script src="@Url.Content("~/Scripts/app/scanner.js")"></script>
    <script src="@Url.Content("~/Content/js/scripts.js")"></script>
    <link rel="manifest" href="@Url.Content("~/manifest.json")" />
    <meta name="theme-color" content="#0d6efd" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />


    <script>
        window.keepAliveUrl = '@Url.Action("KeepAlive", "Session")';
        window.loginUrl = '@Url.Action("Index", "Login")';
        window.buscarProductoUrl = '@Url.Action("BuscarProducto", "Ventas")';
    </script>

    @RenderSection("Scripts", required: false)

    <!-- ✅ Theme toggle (luna/sol) -->
    <script>
        (function () {
            const STORAGE_KEY = "carnisys-theme"; // "dark" | "light"

            function setTheme(mode) {
                const isDark = (mode === "dark");

                document.documentElement.classList.toggle("dark-mode", isDark);
                if (document.body) {
                    document.body.classList.toggle("dark-mode", isDark);
                }

                const btn = document.getElementById("btnToggleTheme");
                const ico = document.getElementById("icoTheme");
                if (btn && ico) {
                    ico.className = isDark ? "fas fa-sun" : "fas fa-moon";
                    btn.title = isDark ? "Activar modo claro" : "Activar modo oscuro";
                    btn.classList.toggle("btn-dark", isDark);
                    btn.classList.toggle("btn-light", !isDark);
                }

                try { localStorage.setItem(STORAGE_KEY, mode); } catch (e) { }
            }

            function toggleTheme(e) {
                if (e) e.preventDefault();
                const current = (localStorage.getItem(STORAGE_KEY) || "light");
                setTheme(current === "dark" ? "light" : "dark");
            }

            document.addEventListener("DOMContentLoaded", function () {
                const saved = (localStorage.getItem(STORAGE_KEY) || "light");
                setTheme(saved);

                const btn = document.getElementById("btnToggleTheme");
                if (btn) btn.addEventListener("click", toggleTheme);
            });
        })();
    </script>

    <!-- =========================================================
       LAYOUT POS: la clave para que tu vista POS pueda “llenar alto”
       - En desktop: sin scroll del navegador
       - #pos-container ocupa el resto debajo de la topbar
       ========================================================= -->
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        #page-top, #wrapper, #content-wrapper, #content {
            height: 100%;
            min-height: 0;
        }

        #content-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        #content {
            display: flex;
            flex-direction: column;
            min-height: 0;
            flex: 1 1 auto;
        }

        nav.card-header {
            flex: 0 0 auto;
        }

        #pos-container {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden; /* desktop */
            padding: 0;
            background-color: #f8f9fc; /* light mode default */
        }

        /* Dark mode override */
        body.dark-mode #pos-container {
            background-color: #1d293a !important;
        }

        /* Desktop: NO scroll del navegador */
        @@media (min-width: 992px) {
            html, body {
                overflow: hidden !important;
            }

            #pos-container {
                overflow: hidden !important;
            }
        }

        /* Mobile/tablet: scroll normal */
        @@media (max-width: 991.98px) {
            html, body {
                overflow: auto !important;
            }

            #pos-container {
                overflow: visible !important;
            }
        }
    </style>

</body>
</html>
