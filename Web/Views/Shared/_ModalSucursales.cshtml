@{
    var usuario = Session["Usuario"] as Entidades.Usuario;
}
<div class="modal fade" id="modalSucursales" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-store mr-2"></i> Cambiar Sucursal
                </h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">

                @foreach (var s in ViewBag.Sucursales as List<Entidades.Sucursal>)
                {
                    bool activa = s.IdSucursal == usuario.IdSucursal;

                    <button class="btn btn-block mb-2 btnSucursal
                             @(activa ? "btn-primary" : "btn-outline-secondary")"
                            data-id="@s.IdSucursal"
                            data-nombre="@s.SucursalNombre"
                            @(activa ? "disabled" : "")>
                        @s.SucursalNombre
                    </button>
                }

            </div>

        </div>
    </div>
</div>
