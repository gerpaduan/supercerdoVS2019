@{

    string seccion = ViewBag.Seccion ?? "esta sección";
    string mensajePermiso = ViewBag.MensajePermiso as string;
    ViewBag.Title = seccion;// "Acceso Denegado";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

@*<div class="container text-center mt-5">
        <h1 class="text-danger">Acceso denegado</h1>
        <p>No tienes permisos para realizar esta acción.</p>
    </div>*@

<div class="container-fluid mt-5">

    <div class="text-center">
        <h4 class="text-danger">Acceso Denegado</h4>
        <p class="text-gray-500 mb-4">@(string.IsNullOrWhiteSpace(mensajePermiso) ? "No tenés permisos para acceder a esta sección." : mensajePermiso)</p>

        <button class="btn btn-secondary mt-4" onclick="volverAtras()">
            ← Volver
        </button>
    </div>

</div>

<script>
    function volverAtras() {
        if (document.referrer) {
            window.location = document.referrer;   // vuelve a la última pantalla real
        } else {
            history.back();                        // fallback por si no hay referrer
        }
    }
</script>
