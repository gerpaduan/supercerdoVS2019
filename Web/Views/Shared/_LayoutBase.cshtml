    @*CARTEL ADVERTENCIA AL SALIR*@
    <script>
        // Estado global
        window.__protegerSalida = false;

        function activarProteccionSalida() {
            window.__protegerSalida = true;
        }

        function desactivarProteccionSalida() {
            window.__protegerSalida = false;
        }

        // Evento para cierre/recarga del navegador
        window.addEventListener("beforeunload", function (e) {
            if (!window.__protegerSalida) return;

            e.preventDefault();
            e.returnValue = "";
        });

        /**************************************************
         * INTERCEPTAR SOLO BOTONES Y LINKS DE SALIDA
         **************************************************/
        $(document).on("click", "a:not([data-ignore-exit]), button[data-navega]", function (e) {

            if (!window.__protegerSalida) return;

            let url = $(this).attr("href");

            // Si no navega (botón sin link) → no hacer nada
            if (!url) return;

            e.preventDefault();

            Swal.fire({
                title: "¿Salir?",
                text: "Los cambios que hiciste podrían no haberse guardado.",
                icon: "warning",

                showCancelButton: true,
                confirmButtonText: "Salir igual",
                cancelButtonText: "Cancelar",

                // Que CANCELAR sea el botón por defecto
                reverseButtons: true,
                focusCancel: true,

                allowOutsideClick: false,
                allowEscapeKey: true,

                customClass: {
                    popup: 'swal2-popup-mid'
                }
            }).then(result => {
                if (result.isConfirmed) {
                    desactivarProteccionSalida();
                    window.location.href = url;
                }
            });
        });

        /* ======================================================
        REGLA GLOBAL PARA INPUTS CON DECIMALES
        Clase: solo-decimal
        ====================================================== */

        $(document).on("input", ".solo-decimal", function () {
            let v = $(this).val();

            // 1) Quitar todo excepto números, puntos y comas
            v = v.replace(/[^0-9.,]/g, "");

            // 2) Si tiene coma y punto → eliminar puntos (miles)
            if (v.includes(",") && v.includes(".")) {
                v = v.replace(/\./g, ""); // saco miles
            }

            // 3) Reemplazar coma por punto
            v = v.replace(/,/g, ".");

            // 4) Permitir solo UN punto
            let partes = v.split(".");
            if (partes.length > 2) {
                v = partes[0] + "." + partes.slice(1).join("");
            }

            $(this).val(v);
        });


        // ======================================================
        // OPCIONAL: Al pegar texto, limpiar automáticamente
        // ======================================================
        $(document).on("paste", ".solo-decimal", function (e) {
            let t = (e.originalEvent || e).clipboardData.getData("text");

            // misma lógica del input
            t = t.replace(/[^0-9.,]/g, "");

            if (t.includes(",") && t.includes(".")) {
                t = t.replace(/\./g, "");
            }

            t = t.replace(/,/g, ".");

            let partes = t.split(".");
            if (partes.length > 2) {
                t = partes[0] + "." + partes.slice(1).join("");
            }

            // Reemplaza el pegado con contenido limpio
            e.preventDefault();
            $(this).val(t).trigger("input");
        });


        if ("serviceWorker" in navigator) {
            window.addEventListener("load", function () {
                navigator.serviceWorker.register("/sw.js")
                    .then(function (registration) {
                        console.log("Service Worker registrado con éxito.");

                        // Pedir la última URL visitada
                        if (registration.active) {
                            registration.active.postMessage({ type: "GET_LAST_URL" });
                        }

                        // Escuchar la respuesta con la URL
                        navigator.serviceWorker.addEventListener("message", (event) => {
                            if (event.data.type === "LAST_URL") {
                                if (window.location.pathname === "/") {
                                    window.location.href = event.data.url;
                                }
                            }
                        });
                    })
                    .catch(function (error) {
                        console.error("Error al registrar el Service Worker:", error);
                    });
            });
        }


    </script>

    @if (TempData["AlertMsg"] != null)
    {
        <script>
        (function () {
            var type = '@(TempData["AlertType"] ?? "info")';
            var title = '@(TempData["AlertTitle"] ?? "Aviso")';
            var msg = '@TempData["AlertMsg"]';

            if (window.Swal) {
                Swal.fire({ icon: type, title: title, text: msg });
            } else {
                alert(title + "\n\n" + msg);
            }
        })();
        </script>
    }
