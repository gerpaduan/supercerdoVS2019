@model Entidades.Pago
@using System.Globalization

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool requestAjax = Request != null && Request.IsAjaxRequest();
    bool renderComoModal = desdePos || renderSinLayout || requestAjax;
    bool usuarioAdmin = ViewBag.UsuarioAdmin != null && (bool)ViewBag.UsuarioAdmin;
    bool mostrarSucursales = !desdePos || usuarioAdmin;
    string estiloComboSucursales = mostrarSucursales ? "" : "display:none;";
    var chequeBusquedaPagoViewData = new ViewDataDictionary(ViewData);
    chequeBusquedaPagoViewData["ChequeBusquedaEnPago"] = true;
    var personaView = ViewBag.Persona as Entidades.Persona;
    int personaIdView = personaView != null ? personaView.IdPersona : 0;
    string persona = personaView != null ? (personaView.RazonSocial ?? "") : "";
    decimal saldo = ViewBag.SaldoPersona != null ? Convert.ToDecimal(ViewBag.SaldoPersona) : 0;
    var sucursalesView = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();

    ViewBag.Title = "Agregar / Editar Pago";
    Layout = renderComoModal ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string returnUrlView = ViewBag.ReturnUrl as string;
    string urlVolver = !string.IsNullOrWhiteSpace(returnUrlView)
        ? returnUrlView
        : Url.Action("CtaCtePersona", "Finanzas", new
        {
            idPersona = personaIdView,
            fechaDesde = DateTime.Today.ToString("yyyy-MM-dd")
        });
    bool soloLecturaInicial = Model != null && Model.Id > 0;
    bool altaSinOperacionInicial = !soloLecturaInicial;
}

<div class="container-fluid">

    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">

            <!-- =======================
             CABECERA PERSONA + SALDO
             ======================= -->
            <div class="pago-cabecera">
                <div class="pago-cabecera-persona">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary pago-volver-btn"
                            onclick="volverDesdePago()"
                            title="Volver"
                            aria-label="Volver">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <h5 class="mb-0"><strong>@persona</strong></h5>
                </div>
                <h5 class="mb-0 pago-cabecera-saldo">
                    <span>Saldo:</span>
                    @if (saldo >= 0)
                    {
                        <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                </h5>
            </div>

            @if (Model != null && Model.Id > 0)
            {
                <div class="d-flex justify-content-end mb-3">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            id="btnImprimirPago"
                            data-imprimir-url="@ViewBag.ImprimirPagoUrl"
                            data-imprimir-payload-url="@ViewBag.ImprimirPagoPayloadUrl"
                            data-pdf-url="@ViewBag.ImprimirPagoPdfUrl">
                        <i class="fas fa-print mr-1"></i> Imprimir
                    </button>
                </div>
            }

            <div class="card shadow mb-4">
                <div class="card-body">

                    @using (Html.BeginForm("AddOrEditPagoPost", "Finanzas", FormMethod.Post, new { @id = "formPago" }))
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" id="urlVolverPago" value="@urlVolver" />
                        @Html.HiddenFor(m => m.Id)

                        <input type="hidden" id="idPersona" name="idPersona" value="@personaIdView" />
                        <input type="hidden" name="desdePos" value="@(renderComoModal.ToString().ToLower())" />

                        <div class="form-group pago-operacion-grupo">
                            <label>¿Qué desea registrar?</label>
                            <div class="pago-operacion-ayuda">Seleccione primero la operación para continuar. Atajos: `1` pagar, `2` cobrar.</div>
                            <div class="pago-operacion-selector" role="radiogroup" aria-label="Qué desea registrar">
                                <button type="button"
                                        class="pago-operacion-opcion"
                                        data-operacion-valor="true"
                                        aria-pressed="false">
                                    <span class="pago-operacion-icono pago-operacion-icono-pagar">
                                        <i class="fas fa-arrow-up"></i>
                                    </span>
                                    <span class="pago-operacion-contenido">
                                        <strong>Realizar un pago</strong>
                                        <small>Salida de dinero hacia proveedor o persona</small>
                                    </span>
                                </button>

                                <button type="button"
                                        class="pago-operacion-opcion"
                                        data-operacion-valor="false"
                                        aria-pressed="false">
                                    <span class="pago-operacion-icono pago-operacion-icono-cobrar">
                                        <i class="fas fa-arrow-down"></i>
                                    </span>
                                    <span class="pago-operacion-contenido">
                                        <strong>Recibir un cobro</strong>
                                        <small>Ingreso de dinero desde cliente o persona</small>
                                    </span>
                                </button>
                            </div>

                            <select id="AProveedor" name="AProveedor" class="form-control pago-operacion-select">
                                @if (altaSinOperacionInicial)
                                {
                                    <option value="" selected="selected"></option>
                                }
                                <option value="true" @(!altaSinOperacionInicial && Model.AProveedor ? "selected" : "")>Realizar un pago</option>
                                <option value="false" @(!altaSinOperacionInicial && !Model.AProveedor ? "selected" : "")>Recibir un cobro</option>
                            </select>

                            <div id="pagoOperacionResumen" class="pago-operacion-resumen pago-operacion-pago @(altaSinOperacionInicial ? "d-none" : "")" aria-live="polite">
                                <i class="fas fa-arrow-up mr-1"></i>
                                <strong>Operación seleccionada</strong>
                                <span></span>
                            </div>
                        </div>

                        <div id="comboSucursales" class="mb-3 pago-requiere-operacion" style="@estiloComboSucursales">
                            <div class="form-group">
                                <label>Sucursal</label>
                                <select class="form-control" id="SucursalId" name="SucursalId">
                                    <option value="">- Seleccione sucursal -</option>

                                    @foreach (var s in sucursalesView)
                                    {
                                        <option value="@s.IdSucursal"
                                                @((Model.Sucursal?.IdSucursal == s.IdSucursal || ViewBag.SucursalId == s.IdSucursal) ? "selected" : "")>
                                            @s.SucursalNombre
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group pago-requiere-operacion">
                            @Html.LabelFor(m => m.Fecha)
                            @Html.TextBoxFor(
                                m => m.Fecha,
                                "{0:yyyy-MM-ddTHH:mm}",
                                new { @class = "form-control", type = "datetime-local" }
                            )
                        </div>

                        <div class="form-group pago-requiere-operacion">
                            @Html.LabelFor(m => m.NroRecibo)
                            @Html.TextBoxFor(m => m.NroRecibo, new { @class = "form-control", type = "nroRecibo" })
                        </div>

                        <div class="form-group pago-requiere-operacion">
                            @Html.Label("Forma de pago")
                            @Html.EnumDropDownListFor(m => m.FormaPago_, new { @class = "form-control", id = "formaPago" })
                        </div>

                        <div id="pagoModoResumen" class="pago-modo-resumen pago-modo-neutro pago-requiere-operacion" aria-live="polite">
                            <div class="pago-modo-badge" id="pagoModoBadge">Pago simple</div>
                            <div class="pago-modo-texto">
                                <strong id="pagoModoTitulo">Importe manual</strong>
                                <span id="pagoModoDescripcion">Ingresá el importe total del pago.</span>
                            </div>
                        </div>

                        <div class="form-group importe-destacado pago-requiere-operacion">
                            <label>Importe</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Importe, new
                                {
                                    @class = "form-control solo-decimal",
                                    id = "importe",
                                    type = "text",
                                    autocomplete = "off",
                                    @readonly = soloLecturaInicial ? "readonly" : null
                                })
                                <div class="input-group-append">
                                    <button type="button"
                                            class="btn btn-outline-secondary js-calculadora-billetes-launch js-calculadora-billetes-pago js-calculadora-billetes-pago-importe d-none"
                                            data-cb-context="pago"
                                            data-cb-input="#importe"
                                            data-cb-detail="#Observaciones, #Detalle, #descripcion"
                                            title="Calcular efectivo">
                                        <i class="fas fa-money-bill-wave"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="bloqueEfectivo" class="bloque-pago pago-requiere-operacion" style="display:none;">
                            <div class="form-group">
                                <h5 class="text-primary">Efectivo</h5>

                                <div class="input-group">
                                    @Html.TextBox(
                                        "Efectivo",
                                        Model.Efectivo.ToString("0.00", CultureInfo.InvariantCulture),
                                        new
                                        {
                                            @class = "form-control solo-decimal",
                                            id = "Efectivo",
                                            type = "text"
                                        }
                                    )
                                    <div class="input-group-append">
                                        <button type="button"
                                                class="btn btn-outline-secondary js-calculadora-billetes-launch js-calculadora-billetes-pago js-calculadora-billetes-pago-efectivo d-none"
                                                data-cb-context="pago"
                                                data-cb-input="#Efectivo"
                                                data-cb-detail="#Observaciones, #Detalle, #descripcion"
                                                title="Calcular efectivo">
                                            <i class="fas fa-money-bill-wave"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="bloqueCheques" class="bloque-pago pago-requiere-operacion" style="display:none;">

                            <h5 class="mt-1 mb-3 text-primary">Cheques</h5>

                            <div class="form-group">
                                <label>Número de Cheque</label>

                                <div class="input-group">
                                    <input type="text" id="txtNroCheque" class="form-control" placeholder="Ingrese número de cheque...">

                                    <div class="input-group-append">
                                        <button type="button" id="btnAgregarCheque" class="btn btn-primary">Agregar</button>
                                        <button type="button" id="btnBuscarCheques" class="btn btn-info">Buscar</button>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered" id="tablaCheques">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Número</th>
                                            <th>Banco</th>
                                            <th>Fecha Pago</th>
                                            <th>Importe</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div class="form-group">
                                <label>Total Cheques</label>
                                <input type="text" id="txtTotalCheques" class="form-control solo-decimal" readonly value="0">
                            </div>

                        </div>

                        <div class="form-group pago-requiere-operacion">
                            @Html.LabelFor(m => m.Observaciones)
                            @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 3 })
                        </div>

                        <input type="hidden" id="ChequesJson" name="ChequesJson" />

                        <button type="button"
                                id="btnHabilitarEdicionPago"
                                class="btn btn-primary btn-block mb-2 @(soloLecturaInicial ? "" : "d-none")"
                                data-edit-readonly-ignore="true">
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>

                        <button type="submit"
                                id="btnGuardarPago"
                                onclick="if (!@renderComoModal.ToString().ToLower() && typeof desactivarProteccionSalida === 'function') { desactivarProteccionSalida(); }"
                                class="btn btn-success btn-block pago-requiere-operacion @(soloLecturaInicial ? "d-none" : "")">
                            Guardar pago
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalBuscarCheques" tabindex="-1" role="dialog" aria-labelledby="modalBuscarChequesLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Buscar Cheques</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                @Html.Partial("_ChequeBusquedaTabla", null, chequeBusquedaPagoViewData)
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>

@Html.Partial("_ModalPostPago")
@Html.Partial("_ModalAltaCheque")

<div class="modal fade" id="modalDetalleCheque" tabindex="-1" role="dialog" aria-labelledby="modalDetalleChequeLabel" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalDetalleChequeLabel">Detalle del cheque</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Numero</small>
                        <strong id="detalleChequeNumero">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Estado</small>
                        <strong id="detalleChequeEstado">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Origen</small>
                        <strong id="detalleChequeOrigen">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Banco</small>
                        <strong id="detalleChequeBanco">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Recibido de</small>
                        <strong id="detalleChequeRecibidoDe">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Entregado a</small>
                        <strong id="detalleChequeEntregadoA">-</strong>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Observaciones</small>
                        <div id="detalleChequeObservaciones" class="detalle-cheque-box">-</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@if (renderComoModal)
{
    @Html.Partial("_AddOrEditPagoScripts")
    <script>
        (function (window, $) {
            if (!window || !$) return;

            function parseMontoCalculadoraPago(texto) {
                var valor = (texto || "").toString().replace(/\$/g, "").replace(/\s+/g, "").trim();
                if (!valor) {
                    return "0.00";
                }

                var ultimaComa = valor.lastIndexOf(",");
                var ultimoPunto = valor.lastIndexOf(".");
                if (ultimaComa >= 0 && ultimoPunto >= 0) {
                    if (ultimaComa > ultimoPunto) {
                        valor = valor.replace(/\./g, "").replace(",", ".");
                    } else {
                        valor = valor.replace(/,/g, "");
                    }
                } else {
                    valor = valor.replace(",", ".");
                }

                var numero = parseFloat(valor);
                return isNaN(numero) ? "0.00" : numero.toFixed(2);
            }

            function dispararEventosPago(control, eventos) {
                if (!control || !eventos || !eventos.length) {
                    return;
                }

                eventos.forEach(function (nombre) {
                    var evt;
                    try {
                        evt = new Event(nombre, { bubbles: true });
                    } catch (e) {
                        evt = document.createEvent("Event");
                        evt.initEvent(nombre, true, true);
                    }

                    control.dispatchEvent(evt);
                });
            }

            function esModoMixtoPago() {
                var valor = ($("#formaPago").val() || "").toString().trim().toLowerCase();
                var texto = ($("#formaPago option:selected").text() || "").toString().trim().toLowerCase();
                return valor === "eftvocheque" || valor === "efvtocheque" || texto === "eftvocheque" || texto === "efvtocheque";
            }

            $(document)
                .off("click.pagoMontoCalculadora", "#btnAceptarCalculadoraBilletes")
                .on("click.pagoMontoCalculadora", "#btnAceptarCalculadoraBilletes", function () {
                    var lblTotal = document.getElementById("lblCalculadoraBilletesTotal");
                    var valor = parseMontoCalculadoraPago(lblTotal ? lblTotal.textContent : "");
                    var input = esModoMixtoPago()
                        ? document.getElementById("Efectivo")
                        : document.getElementById("importe");

                    if (!input) {
                        return;
                    }

                    input.value = valor;
                    dispararEventosPago(input, ["input", "change", "keyup"]);
                });
        })(window, window.jQuery);

        window.urls = {
            guardarCheque: '@Url.Action("GuardarCheque", "Finanzas")',
            buscarChequePorNro: '@Url.Action("BuscarChequePorNro", "Finanzas")',
            getCheques: '@Url.Action("GetCheques", "Finanzas")'
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/modal-cheque.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/print-agent.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/modal-postpago.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/pago-cheques.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/pago-ux.js?v=5")"></script>
    <script src="@Url.Content("~/Scripts/app/edit-page-guard.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=2")"></script>
    <script>
        window.PagoCheques && window.PagoCheques.init({
            desdePos: true,
            guardarCheque: window.urls.guardarCheque,
            buscarChequePorNro: window.urls.buscarChequePorNro,
            getCheques: window.urls.getCheques
        });
        window.PagoUX && window.PagoUX.init();
        window.CalculadoraBilletesTargets && window.CalculadoraBilletesTargets.syncPago();
        window.EditReadOnly && window.EditReadOnly.init({
            formSelector: "#formPago",
            soloLecturaInicial: @(soloLecturaInicial ? "true" : "false"),
            modifyButtonSelector: "#btnHabilitarEdicionPago",
            saveButtonSelector: "#btnGuardarPago",
            onStateChanged: function (readOnly) {
                window.pagoEdicionHabilitada = !readOnly;
                if (typeof window.actualizarVisibilidadPago === "function") {
                    window.actualizarVisibilidadPago();
                }
            }
        });
    </script>
}
