@model Entidades.Pago
@using System.Globalization

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool requestAjax = Request != null && Request.IsAjaxRequest();
    bool renderComoModal = desdePos || renderSinLayout || requestAjax;
    bool usuarioAdmin = ViewBag.UsuarioAdmin != null && (bool)ViewBag.UsuarioAdmin;
    bool mostrarSucursales = !desdePos || usuarioAdmin;
    string estiloComboSucursales = mostrarSucursales ? "" : "display:none;";
    var chequeBusquedaPagoViewData = new ViewDataDictionary(ViewData);
    chequeBusquedaPagoViewData["ChequeBusquedaEnPago"] = true;

    ViewBag.Title = "Agregar / Editar Pago";
    Layout = renderComoModal ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string persona = ViewBag.Persona.RazonSocial;
    decimal saldo = ViewBag.SaldoPersona;

    string returnUrlView = ViewBag.ReturnUrl as string;
    string urlVolver = !string.IsNullOrWhiteSpace(returnUrlView)
        ? returnUrlView
        : Url.Action("CtaCtePersona", "Finanzas", new
        {
            idPersona = ViewBag.Persona.IdPersona,
            fechaDesde = DateTime.Today.ToString("yyyy-MM-dd")
        });
}

<div class="container-fluid">

    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">

            <!-- =======================
             CABECERA PERSONA + SALDO
             ======================= -->
            <div class="pago-cabecera">
                <div class="pago-cabecera-persona">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary pago-volver-btn"
                            onclick="volverDesdePago()"
                            title="Volver"
                            aria-label="Volver">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <h5 class="mb-0"><strong>@persona</strong></h5>
                </div>
                <h5 class="mb-0 pago-cabecera-saldo">
                    <span>Saldo:</span>
                    @if (saldo >= 0)
                    {
                        <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                </h5>
            </div>

            <div class="card shadow mb-4">
                <div class="card-body">

                    @using (Html.BeginForm("AddOrEditPagoPost", "Finanzas", FormMethod.Post, new { @id = "formPago" }))
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" id="urlVolverPago" value="@urlVolver" />
                        @Html.HiddenFor(m => m.Id)

                        <input type="hidden" id="idPersona" name="idPersona" value="@ViewBag.Persona.IdPersona" />
                        <input type="hidden" name="desdePos" value="@(renderComoModal.ToString().ToLower())" />

                        <div id="comboSucursales" class="mb-3" style="@estiloComboSucursales">
                            <div class="form-group">
                                <label>Sucursal</label>
                                <select class="form-control" id="SucursalId" name="SucursalId">
                                    <option value="">- Seleccione sucursal -</option>

                                    @foreach (var s in (List<Entidades.Sucursal>)ViewBag.Sucursales)
                                    {
                                        <option value="@s.IdSucursal"
                                                @((Model.Sucursal?.IdSucursal == s.IdSucursal || ViewBag.SucursalId == s.IdSucursal) ? "selected" : "")>
                                            @s.SucursalNombre
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group pago-operacion-grupo">
                            <label>Tipo de Operación</label>
                            <div class="pago-operacion-selector" role="radiogroup" aria-label="Tipo de Operación">
                                <button type="button"
                                        class="pago-operacion-opcion"
                                        data-operacion-valor="true"
                                        aria-pressed="false">
                                    <span class="pago-operacion-icono pago-operacion-icono-pagar">
                                        <i class="fas fa-arrow-up"></i>
                                    </span>
                                    <span class="pago-operacion-contenido">
                                        <strong>Pagar</strong>
                                        <small>Egreso</small>
                                    </span>
                                </button>

                                <button type="button"
                                        class="pago-operacion-opcion"
                                        data-operacion-valor="false"
                                        aria-pressed="false">
                                    <span class="pago-operacion-icono pago-operacion-icono-cobrar">
                                        <i class="fas fa-arrow-down"></i>
                                    </span>
                                    <span class="pago-operacion-contenido">
                                        <strong>Cobrar</strong>
                                        <small>Ingreso</small>
                                    </span>
                                </button>
                            </div>

                            @Html.DropDownListFor(
                                m => m.AProveedor,
                                new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Pagar (egreso)", Value = "true"},
                                    new SelectListItem { Text = "Cobrar (ingreso)", Value = "false"}
                                },
                                new { @class = "form-control pago-operacion-select" }
                            )

                            <div id="pagoOperacionResumen" class="pago-operacion-resumen pago-operacion-pago" aria-live="polite">
                                <i class="fas fa-arrow-up mr-1"></i>
                                <strong>Estás registrando un PAGO</strong>
                                <span>Salida de dinero de caja o cuenta corriente.</span>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Fecha)
                            @Html.TextBoxFor(
                                m => m.Fecha,
                                "{0:yyyy-MM-ddTHH:mm}",
                                new { @class = "form-control", type = "datetime-local" }
                            )
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.NroRecibo)
                            @Html.TextBoxFor(m => m.NroRecibo, new { @class = "form-control", type = "nroRecibo" })
                        </div>

                        <div class="form-group">
                            @Html.Label("Forma de pago")
                            @Html.EnumDropDownListFor(m => m.FormaPago_, new { @class = "form-control", id = "formaPago" })
                        </div>

                        <div id="pagoModoResumen" class="pago-modo-resumen pago-modo-neutro" aria-live="polite">
                            <div class="pago-modo-badge" id="pagoModoBadge">Pago simple</div>
                            <div class="pago-modo-texto">
                                <strong id="pagoModoTitulo">Importe manual</strong>
                                <span id="pagoModoDescripcion">Ingresá el importe total del pago.</span>
                            </div>
                        </div>

                        <div class="form-group importe-destacado">
                            <label>Importe</label>
                            @Html.TextBoxFor(m => m.Importe, new
                            {
                                @class = "form-control solo-decimal",
                                id = "importe",
                                type = "text",
                                autocomplete = "off"
                            })
                        </div>

                        <div id="bloqueEfectivo" class="bloque-pago" style="display:none;">
                            <div class="form-group">
                                <h5 class="text-primary">Efectivo</h5>

                                @Html.TextBox(
                                    "Efectivo",
                                    Model.Efectivo.ToString("0.00", CultureInfo.InvariantCulture),
                                    new
                                    {
                                        @class = "form-control solo-decimal",
                                        id = "Efectivo",
                                        type = "text"
                                    }
                                )
                            </div>
                        </div>

                        <div id="bloqueCheques" class="bloque-pago" style="display:none;">

                            <h5 class="mt-1 mb-3 text-primary">Cheques</h5>

                            <div class="form-group">
                                <label>Número de Cheque</label>

                                <div class="input-group">
                                    <input type="text" id="txtNroCheque" class="form-control" placeholder="Ingrese número de cheque...">

                                    <div class="input-group-append">
                                        <button type="button" id="btnAgregarCheque" class="btn btn-primary">Agregar</button>
                                        <button type="button" id="btnBuscarCheques" class="btn btn-info">Buscar</button>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered" id="tablaCheques">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Número</th>
                                            <th>Banco</th>
                                            <th>Fecha Pago</th>
                                            <th>Importe</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div class="form-group">
                                <label>Total Cheques</label>
                                <input type="text" id="txtTotalCheques" class="form-control solo-decimal" readonly value="0">
                            </div>

                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Observaciones)
                            @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 3 })
                        </div>

                        <input type="hidden" id="ChequesJson" name="ChequesJson" />

                        <button type="submit"
                                id="btnGuardarPago"
                                onclick="if (!@renderComoModal.ToString().ToLower() && typeof desactivarProteccionSalida === 'function') { desactivarProteccionSalida(); }"
                                class="btn btn-success btn-block">
                            Guardar pago
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalBuscarCheques" tabindex="-1" role="dialog" aria-labelledby="modalBuscarChequesLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Buscar Cheques</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                @Html.Partial("_ChequeBusquedaTabla", null, chequeBusquedaPagoViewData)

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>

@Html.Partial("_ModalAltaCheque")

<div class="modal fade" id="modalDetalleCheque" tabindex="-1" role="dialog" aria-labelledby="modalDetalleChequeLabel" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalDetalleChequeLabel">Detalle del cheque</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Numero</small>
                        <strong id="detalleChequeNumero">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Estado</small>
                        <strong id="detalleChequeEstado">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Origen</small>
                        <strong id="detalleChequeOrigen">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Banco</small>
                        <strong id="detalleChequeBanco">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Recibido de</small>
                        <strong id="detalleChequeRecibidoDe">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Entregado a</small>
                        <strong id="detalleChequeEntregadoA">-</strong>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Observaciones</small>
                        <div id="detalleChequeObservaciones" class="detalle-cheque-box">-</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@if (renderComoModal)
{
    @Html.Partial("_AddOrEditPagoScripts")
    <script>
        window.urls = {
            guardarCheque: '@Url.Action("GuardarCheque", "Finanzas")',
            buscarChequePorNro: '@Url.Action("BuscarChequePorNro", "Finanzas")',
            getCheques: '@Url.Action("GetCheques", "Finanzas")'
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/modal-cheque.js?v=3")"></script>
    <script src="@Url.Content("~/Scripts/app/pago-cheques.js?v=2")"></script>
    <script src="@Url.Content("~/Scripts/app/pago-ux.js?v=2")"></script>
    <script>
        window.PagoCheques && window.PagoCheques.init({
            desdePos: true,
            guardarCheque: window.urls.guardarCheque,
            buscarChequePorNro: window.urls.buscarChequePorNro,
            getCheques: window.urls.getCheques
        });
        window.PagoUX && window.PagoUX.init();
    </script>
}
else
{
    @section Scripts{
        @Html.Partial("_AddOrEditPagoScripts")
        <script>
            window.urls = {
                guardarCheque: '@Url.Action("GuardarCheque", "Finanzas")',
                buscarChequePorNro: '@Url.Action("BuscarChequePorNro", "Finanzas")',
                getCheques: '@Url.Action("GetCheques", "Finanzas")'
            };
        </script>
        <script src="@Url.Content("~/Scripts/app/modal-cheque.js?v=3")"></script>
        <script src="@Url.Content("~/Scripts/app/pago-cheques.js?v=2")"></script>
        <script src="@Url.Content("~/Scripts/app/pago-ux.js?v=2")"></script>
        <script>
            window.PagoCheques && window.PagoCheques.init({
                desdePos: false,
                guardarCheque: window.urls.guardarCheque,
                buscarChequePorNro: window.urls.buscarChequePorNro,
                getCheques: window.urls.getCheques
            });
            window.PagoUX && window.PagoUX.init();
        </script>
    }
}

<style>
    .importe-destacado label {
        font-weight: bold;
        font-size: 1.1rem;
    }

    .importe-destacado input {
        font-weight: bold;
        font-size: 1.3rem;
    }

    .bloque-pago {
        background: #f7f7f7;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 12px;
        margin-bottom: 12px;
        transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .bloque-pago.activo {
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, .12);
        background: #fbfcff;
    }

    .pago-cabecera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        border: 1px solid #b8d6f5;
        border-radius: 8px;
        background: #eef6ff;
        color: #1f3b64;
        padding: .55rem .75rem;
        margin-bottom: .75rem;
    }

    .pago-cabecera-persona {
        display: flex;
        align-items: center;
        gap: .55rem;
        min-width: 0;
    }

    .pago-cabecera-persona h5 {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pago-volver-btn {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 8px;
        background: #fff;
    }

    .pago-cabecera-saldo {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    .pago-operacion-selector {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .6rem;
        margin-bottom: .55rem;
    }

    .pago-operacion-opcion {
        display: flex;
        align-items: center;
        gap: .65rem;
        min-height: 64px;
        width: 100%;
        border: 1px solid #dbe5f3;
        border-radius: 8px;
        background: #fff;
        color: #334155;
        padding: .65rem .75rem;
        text-align: left;
        transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }

    .pago-operacion-opcion:hover,
    .pago-operacion-opcion:focus {
        border-color: #9fb3d8;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, .12);
        outline: none;
    }

    .pago-operacion-opcion.activo-pagar {
        border-color: #e2a4a4;
        background: #fff6f6;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, .12);
    }

    .pago-operacion-opcion.activo-cobrar {
        border-color: #9bd3ad;
        background: #f4fbf6;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, .12);
    }

    .pago-operacion-icono {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .pago-operacion-icono-pagar {
        background: #fde2e2;
        color: #b4232d;
    }

    .pago-operacion-icono-cobrar {
        background: #dcf5e3;
        color: #1f7a46;
    }

    .pago-operacion-contenido {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .pago-operacion-contenido strong {
        line-height: 1.15;
        font-size: 1rem;
    }

    .pago-operacion-contenido small {
        color: #64748b;
        font-size: .76rem;
        line-height: 1.2;
    }

    .pago-operacion-select {
        display: none;
    }

    .pago-operacion-resumen {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .25rem .35rem;
        border-radius: 8px;
        padding: .45rem .65rem;
        font-size: .86rem;
        border: 1px solid #dbe5f3;
    }

    .pago-operacion-resumen span {
        color: #64748b;
    }

    .pago-operacion-pago {
        border-color: #efc2c2;
        background: #fff7f7;
        color: #9f1f2a;
    }

    .pago-operacion-cobro {
        border-color: #bfe6ca;
        background: #f3fbf6;
        color: #1f7a46;
    }

    @@media (max-width: 575.98px) {
        .pago-cabecera {
            align-items: flex-start;
            flex-direction: column;
        }

        .pago-cabecera-saldo {
            padding-left: 2.45rem;
        }

        .pago-operacion-selector {
            grid-template-columns: 1fr;
        }
    }

    .pago-modo-resumen {
        display: flex;
        align-items: center;
        gap: .55rem;
        border-radius: 10px;
        padding: .45rem .7rem;
        margin-bottom: .75rem;
        border: 1px solid #dbe5f3;
        background: #f8fafc;
    }

    .pago-modo-badge {
        flex: 0 0 auto;
        border-radius: 999px;
        padding: .18rem .5rem;
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .02em;
        text-transform: uppercase;
        background: #e9eef8;
        color: #35539a;
    }

    .pago-modo-texto {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .pago-modo-texto strong {
        color: #1f2937;
        line-height: 1.1;
        font-size: .82rem;
        font-weight: 600;
    }

    .pago-modo-texto span {
        color: #64748b;
        font-size: .74rem;
        line-height: 1.2;
    }

    .pago-modo-neutro {
        border-color: #dbe5f3;
        background: #f8fafc;
    }

    .pago-modo-neutro .pago-modo-badge {
        background: #e9eef8;
        color: #35539a;
    }

    .pago-modo-efectivo {
        border-color: #c8ead6;
        background: #f3fbf6;
    }

    .pago-modo-efectivo .pago-modo-badge {
        background: #dff5e7;
        color: #1f7a46;
    }

    .pago-modo-cheque {
        border-color: #d7def8;
        background: #f5f7ff;
    }

    .pago-modo-cheque .pago-modo-badge {
        background: #e4e9ff;
        color: #3451b2;
    }

    .pago-modo-mixto {
        border-color: #f3dbba;
        background: #fff8ef;
    }

    .pago-modo-mixto .pago-modo-badge {
        background: #ffe8c7;
        color: #9a5a12;
    }

    #tablaBusquedaCheques tbody tr.is-selected {
        background: rgba(13, 110, 253, 0.12);
    }

    .detalle-cheque-box {
        min-height: 72px;
        border: 1px solid #dbe5f3;
        border-radius: 8px;
        background: #f8fafc;
        padding: .75rem;
        white-space: pre-wrap;
    }

    .modal.modal-fondo-activo .modal-dialog {
        transform: scale(.992);
        transition: transform .16s ease;
    }

    .modal .modal-content.modal-content-fondo-activo {
        background: #eef2f7;
        border-color: #cfd8e3;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .16);
        opacity: .92;
    }

    .modal .modal-content.modal-content-fondo-activo .modal-header {
        background-color: #7b8794 !important;
        border-bottom-color: #cfd8e3;
    }

    .modal .modal-content.modal-content-fondo-activo .modal-body,
    .modal .modal-content.modal-content-fondo-activo .modal-footer {
        background: #f4f7fb;
    }
</style>
