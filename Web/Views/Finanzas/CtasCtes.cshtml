@model System.Data.DataTable

@{
    ViewBag.Title = "Cuentas Corrientes";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    string buscar = ViewBag.Buscar ?? "";
    string ordenSaldo = ViewBag.OrdenSaldo ?? "DESC";
}

<div class="container-fluid">

    <!-- PANEL SUPERIOR DE BÚSQUEDA -->
    <div class="card shadow mb-4">
        <div class="card-body">

            <div class="form-inline">

                <div class="form-group mr-2">
                    <div class="input-group">
                        <input type="text" id="txtBuscar" class="form-control" placeholder="Buscar por Razón social o identificación...">
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- GRILLA -->
    <div class="card shadow">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="tablaCtasCtes" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>

                            @foreach (System.Data.DataColumn col in Model.Columns)
                            {
                                if (col.ColumnName.ToLower() == "saldo")
                                {
                                    <th>
                                        @col.ColumnName

                                        <!-- Botón ordenar -->
                                        <a href="@Url.Action("CtasCtes", "Finanzas", new { buscar = buscar, ordenSaldo = ordenSaldo == "ASC" ? "DESC" : "ASC" })"
                                           class="btn btn-sm btn-light ml-2">
                                            @(ordenSaldo == "ASC" ? "↓" : "↑")
                                        </a>
                                    </th>
                                }
                                else
                                {
                                    <th>@col.ColumnName</th>
                                }
                            }

                        </tr>
                    </thead>

                    <tbody id="tbodyCtas">
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            <tr onclick="irACtaCte(this)" style="cursor:pointer;">
                                @foreach (var item in row.ItemArray)
                                {
                                    <td>@item</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<script>

    // ==============================
    // FORMATEAR COLUMNA SALDO
    // ==============================
    window.addEventListener("DOMContentLoaded", function () {

        try {
            let cabeceras = document.querySelectorAll("#tablaCtasCtes thead th");
            let indiceSaldo = -1;

            cabeceras.forEach((th, i) => {
                if (th.innerText.trim().toLowerCase().startsWith("saldo")) {
                    indiceSaldo = i;
                }
            });

            if (indiceSaldo >= 0) {
                let filas = document.querySelectorAll("#tablaCtasCtes tbody tr");

                filas.forEach(fila => {
                    let celda = fila.children[indiceSaldo];
                    let valor = celda.innerText.replace(",", ".").trim();

                    if (!isNaN(valor) && valor !== "") {
                        celda.innerText = parseFloat(valor).toFixed(2);
                    }
                });
            }
        } catch (e) {
            console.error("Error formateando columna Saldo:", e);
        }

    });

    // ==============================
    // REDIRECCIÓN AL HACER CLICK
    // ==============================
    function irACtaCte(row) {
        let id = row.children[0].innerText.trim();
        let url = '@Url.Action("CuentaCorriente", "Finanzas")' + '?id=' + id;
        window.location.href = url;
    }

    // ==============================
    // BÚSQUEDA EN VIVO SIN DB
    // ==============================
    const txtBuscar = document.getElementById("txtBuscar");

    txtBuscar.addEventListener("input", function () {

        let filtro = this.value.toLowerCase();
        let filas = document.querySelectorAll("#tbodyCtas tr");

        filas.forEach(fila => {

            let textoFila = fila.innerText.toLowerCase();

            if (textoFila.includes(filtro)) {
                fila.style.display = "";
            } else {
                fila.style.display = "none";
            }

        });

    });

</script>

<style>
    #txtBuscar {
        min-width: 350px;
    }

    @@media (max-width: 576px) {
        .input-group {
            width: 100% !important;
            display: flex;
        }
    }
</style>
