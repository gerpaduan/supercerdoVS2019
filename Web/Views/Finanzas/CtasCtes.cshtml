@model System.Data.DataTable

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;

    ViewBag.Title = "Cuentas Corrientes";
    Layout = desdePos ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string buscar = ViewBag.Buscar ?? "";
    string ordenSaldo = ViewBag.OrdenSaldo ?? "DESC";
}
<div class="container-fluid">

    <!-- PANEL SUPERIOR DE BÚSQUEDA -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="form-inline">
                <div class="form-group mr-2 w-100">
                    <!-- w-100 para que ocupe todo -->
                    <div class="input-group w-100">
                        <input type="text" id="txtBuscar" class="form-control" placeholder="Buscar por Razón social o identificación...">
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- GRILLA -->
    <div class="card shadow">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="tablaCtasCtes" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>

                            @foreach (System.Data.DataColumn col in Model.Columns)
                            {
                                if (col.ColumnName.ToLower() == "saldo")
                                {
                                    <th>
                                        @col.ColumnName

                                        <!-- Botón ordenar -->
                                        <a href="@Url.Action("CtasCtes", "Finanzas", new { buscar = buscar, ordenSaldo = ordenSaldo == "ASC" ? "DESC" : "ASC", desdePos = desdePos })"
                                           class="btn btn-sm btn-light ml-2"
                                           data-pos-ajax="@(desdePos ? "true" : "false")"
                                           data-pos-title="Cuentas corrientes">
                                            @(ordenSaldo == "ASC" ? "↓" : "↑")
                                        </a>
                                    </th>
                                }
                                else
                                {
                                    <th>@col.ColumnName</th>
                                }
                            }

                        </tr>
                    </thead>

                    <tbody id="tbodyCtas">
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            <tr onclick="irACtaCte(this)" style="cursor:pointer;">
                                @foreach (var item in row.ItemArray)
                                {
                                    <td>@item</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<script>
    window.addEventListener("DOMContentLoaded", function () {
        try {
            let cabeceras = document.querySelectorAll("#tablaCtasCtes thead th");
            let indiceSaldo = -1;

            cabeceras.forEach((th, i) => {
                if (th.innerText.trim().toLowerCase().startsWith("saldo")) {
                    indiceSaldo = i;
                }
            });

            if (indiceSaldo >= 0) {
                let filas = document.querySelectorAll("#tablaCtasCtes tbody tr");

                filas.forEach(fila => {
                    let celda = fila.children[indiceSaldo];
                    let valor = celda.innerText.replace(",", ".").trim();

                    if (!isNaN(valor) && valor !== "") {
                        celda.innerText = parseFloat(valor).toFixed(2);
                    }
                });
            }
        } catch (e) {
            console.error("Error formateando columna Saldo:", e);
        }
    });

    function irACtaCte(row) {
        let id = row.children[0].innerText.trim();

        let hoy = new Date();
        hoy.setMonth(hoy.getMonth() - 1);
        let fechaDesde = hoy.toISOString().split('T')[0];

        let url = '@Url.Action("CtaCtePersona", "Finanzas")'
                  + '?idPersona=' + encodeURIComponent(id)
                  + '&fechaDesde=' + encodeURIComponent(fechaDesde)
                  + '&desdePos=@(desdePos.ToString().ToLower())';

        if (@Html.Raw(desdePos.ToString().ToLower()) && window.POSFinanzas) {
            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        window.location.href = url;
    }

    const txtBuscar = document.getElementById("txtBuscar");

    txtBuscar.addEventListener("input", function () {
        let filtro = this.value.toLowerCase();
        let filas = document.querySelectorAll("#tbodyCtas tr");

        filas.forEach(fila => {
            let textoFila = fila.innerText.toLowerCase();
            fila.style.display = textoFila.includes(filtro) ? "" : "none";
        });
    });
</script>

<style>

    /* Siempre permitir que el input crezca */
    #txtBuscar {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
    }

    /* ----- PANTALLAS GRANDES ----- */
    .form-inline {
        display: flex;
        flex-wrap: nowrap; /* evita que se baje el icono */
        width: 100%;
    }

        .form-inline .form-group {
            flex: 1; /* ocupa todo el espacio */
        }

    .input-group {
        width: 100%;
        display: flex;
        flex-wrap: nowrap; /* icono siempre al lado */
    }

    /* ----- PANTALLAS PEQUEÑAS ----- */
    @@media (max-width: 576px) {

        .form-inline {
            display: block;
            width: 100%;
        }

        .form-group,
        .input-group {
            width: 100% !important;
        }

        .input-group {
            display: flex;
            flex-wrap: nowrap; /* evita salto de línea */
        }

            .input-group .form-control {
                min-width: 0;
                flex: 1 1 auto;
            }
    }
</style>
