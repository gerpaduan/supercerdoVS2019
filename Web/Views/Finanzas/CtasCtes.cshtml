@model System.Data.DataTable

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool ocultarSaldo = ViewBag.OcultarSaldo != null && (bool)ViewBag.OcultarSaldo;

    ViewBag.Title = "Cuentas Corrientes";
    Layout = (desdePos || renderSinLayout) ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string buscar = ViewBag.Buscar ?? "";
    string ordenSaldo = ViewBag.OrdenSaldo ?? "DESC";
}
<div class="container-fluid ctactes-index-page">

    <!-- PANEL SUPERIOR DE BÚSQUEDA -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="form-inline">
                <div class="form-group mr-2 w-100">
                    <!-- w-100 para que ocupe todo -->
                    <div class="input-group w-100">
                        <input type="text" id="txtBuscar" class="form-control" value="@buscar" placeholder="Buscar por Nombre Identif. y/o Razón social..." oninput="filtrarCtasCtesVivo()" onkeyup="filtrarCtasCtesVivo()">
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- GRILLA -->
    <div class="card shadow">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="tablaCtasCtes" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>

                            @foreach (System.Data.DataColumn col in Model.Columns)
                            {
                                if (col.ColumnName.ToLower() == "saldo")
                                {
                                    <th>
                                        @col.ColumnName

                                        <!-- Botón ordenar -->
                                        @if (!ocultarSaldo)
                                        {
                                            <a href="@Url.Action("CtasCtes", "Finanzas", new { buscar = buscar, ordenSaldo = ordenSaldo == "ASC" ? "DESC" : "ASC", desdePos = desdePos })"
                                               class="btn btn-sm btn-light ml-2"
                                               data-pos-ajax="@(desdePos ? "true" : "false")"
                                               data-pos-title="Cuentas corrientes">
                                                @(ordenSaldo == "ASC" ? "↓" : "↑")
                                            </a>
                                        }
                                    </th>
                                }
                                else
                                {
                                    <th>@col.ColumnName</th>
                                }
                            }

                        </tr>
                    </thead>

                    <tbody id="tbodyCtas">
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            <tr onclick="irACtaCte(this)" style="cursor:pointer;">
                                @foreach (System.Data.DataColumn col in Model.Columns)
                                {
                                    if (string.Equals(col.ColumnName, "Saldo", StringComparison.OrdinalIgnoreCase))
                                    {
                                        decimal saldoFila = row[col] == DBNull.Value ? 0m : Convert.ToDecimal(row[col]);
                                        <td>@(ocultarSaldo ? "***" : saldoFila.ToString("N2"))</td>
                                    }
                                    else
                                    {
                                        <td>@row[col]</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<script>
    function irACtaCte(row) {
        let id = row.children[0].innerText.trim();

        let hoy = new Date();
        hoy.setMonth(hoy.getMonth() - 1);
        let fechaDesde = hoy.toISOString().split('T')[0];

        let url = '@Url.Action("CtaCtePersona", "Finanzas")'
                  + '?idPersona=' + encodeURIComponent(id)
                  + '&fechaDesde=' + encodeURIComponent(fechaDesde)
                  + '&returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search)
                  + '&desdePos=@(desdePos.ToString().ToLower())';

        if (@Html.Raw(desdePos.ToString().ToLower()) && window.POSFinanzas) {
            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        window.location.href = url;
    }

    function normalizarTextoCtas(valor) {
        return (valor || "")
            .toString()
            .toLowerCase()
            .replace(/[áàäâ]/g, "a")
            .replace(/[éèëê]/g, "e")
            .replace(/[íìïî]/g, "i")
            .replace(/[óòöô]/g, "o")
            .replace(/[úùüû]/g, "u")
            .replace(/ñ/g, "n")
            .replace(/\s+/g, " ")
            .trim();
    }

    function filtrarCtasCtesVivo() {
        var input = document.getElementById("txtBuscar");
        var tbody = document.getElementById("tbodyCtas");
        var tabla = document.getElementById("tablaCtasCtes");
        if (!input || !tbody || !tabla) return;

        var filtro = normalizarTextoCtas(input.value);
        var headers = tabla.querySelectorAll("thead th");
        var idxNombreIdentif = -1;
        var idxRazonSocial = -1;

        for (var i = 0; i < headers.length; i++) {
            var textoHeader = normalizarTextoCtas(headers[i].innerText || headers[i].textContent || "");
            if (textoHeader.indexOf("nombre identif") >= 0 || textoHeader.indexOf("identificacion") >= 0) {
                idxNombreIdentif = i;
            }
            if (textoHeader.indexOf("razon social") >= 0) {
                idxRazonSocial = i;
            }
        }

        var filas = tbody.getElementsByTagName("tr");
        for (var rowIndex = 0; rowIndex < filas.length; rowIndex++) {
            var fila = filas[rowIndex];
            var celdas = fila.getElementsByTagName("td");
            var textoNombre = idxNombreIdentif >= 0 && celdas[idxNombreIdentif]
                ? normalizarTextoCtas(celdas[idxNombreIdentif].innerText || celdas[idxNombreIdentif].textContent || "")
                : "";
            var textoRazon = idxRazonSocial >= 0 && celdas[idxRazonSocial]
                ? normalizarTextoCtas(celdas[idxRazonSocial].innerText || celdas[idxRazonSocial].textContent || "")
                : "";
            var textoFila = (textoNombre + " " + textoRazon).trim();

            if (!textoFila) {
                textoFila = normalizarTextoCtas(fila.innerText || fila.textContent || "");
            }

            fila.style.display = !filtro || textoFila.indexOf(filtro) >= 0 ? "" : "none";
        }
    }

    (function () {
        const $txtBuscar = $("#txtBuscar");
        const $tbody = $("#tbodyCtas");
        const $tabla = $("#tablaCtasCtes");
        let indiceNombreIdentif = -1;
        let indiceRazonSocial = -1;

        function normalizarTexto(texto) {
            return (texto || "")
                .toString()
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/\s+/g, " ")
                .trim();
        }

        function formatearSaldo() {
            try {
                let indiceSaldo = -1;

                $tabla.find("thead th").each(function (i) {
                    if ($(this).text().trim().toLowerCase().startsWith("saldo")) {
                        indiceSaldo = i;
                    }
                });

                if (indiceSaldo < 0) return;

                $tbody.find("tr").each(function () {
                    const celda = this.children[indiceSaldo];
                    if (!celda) return;

                    const valor = (celda.innerText || "").replace(",", ".").trim();
                    if (!isNaN(valor) && valor !== "") {
                        celda.innerText = parseFloat(valor).toFixed(2);
                    }
                });
            } catch (e) {
                console.error("Error formateando columna Saldo:", e);
            }
        }

        function filasVisibles() {
            return $tbody.find("tr").filter(function () {
                return $(this).css("display") !== "none";
            });
        }

        function detectarColumnasBusqueda() {
            indiceNombreIdentif = -1;
            indiceRazonSocial = -1;

            $tabla.find("thead th").each(function (i) {
                const texto = normalizarTexto($(this).clone().children().remove().end().text() || "");

                if (texto.includes("nombre identif") || texto.includes("identificacion") || texto.includes("identif.")) {
                    indiceNombreIdentif = i;
                }

                if (texto.includes("razon social")) {
                    indiceRazonSocial = i;
                }
            });
        }

        function marcarSeleccion($fila) {
            $tbody.find("tr").removeClass("is-selected");
            if ($fila && $fila.length) {
                $fila.addClass("is-selected");
            }
        }

        function asegurarSeleccionVisible() {
            const $visibles = filasVisibles();
            if (!$visibles.length) {
                marcarSeleccion($());
                return;
            }

            const $actual = $visibles.filter(".is-selected").first();
            if ($actual.length) return;

            marcarSeleccion($visibles.first());
        }

        function filtrarCuentas() {
            const filtro = normalizarTexto($txtBuscar.val() || "");

            $tbody.find("tr").each(function () {
                const celdas = this.children;
                const textoNombreIdentif = indiceNombreIdentif >= 0 && celdas[indiceNombreIdentif]
                    ? normalizarTexto(celdas[indiceNombreIdentif].innerText || celdas[indiceNombreIdentif].textContent || "")
                    : "";
                const textoRazonSocial = indiceRazonSocial >= 0 && celdas[indiceRazonSocial]
                    ? normalizarTexto(celdas[indiceRazonSocial].innerText || celdas[indiceRazonSocial].textContent || "")
                    : "";
                const textoBusqueda = (textoNombreIdentif + " " + textoRazonSocial).trim()
                    || normalizarTexto($(this).text() || "");

                this.style.display = !filtro || textoBusqueda.includes(filtro) ? "" : "none";
            });

            asegurarSeleccionVisible();
        }

        function moverSeleccion(delta) {
            const $visibles = filasVisibles();
            if (!$visibles.length) return;

            let indexActual = $visibles.index($visibles.filter(".is-selected").first());
            if (indexActual < 0) indexActual = 0;

            const nuevoIndex = Math.max(0, Math.min($visibles.length - 1, indexActual + delta));
            const $nueva = $visibles.eq(nuevoIndex);

            marcarSeleccion($nueva);

            if ($nueva.length && $nueva[0].scrollIntoView) {
                $nueva[0].scrollIntoView({ block: "nearest" });
            }
        }

        function abrirFilaSeleccionada() {
            const $fila = filasVisibles().filter(".is-selected").first();
            if ($fila.length) {
                irACtaCte($fila[0]);
            }
        }

        function enfocarBuscador() {
            if (!$txtBuscar.length) return;

            function intentarFoco() {
                const input = $txtBuscar.get(0);
                if (!input) return;

                input.focus();
                $txtBuscar.trigger("focus");
                $txtBuscar.trigger("select");
                asegurarSeleccionVisible();
            }

            setTimeout(intentarFoco, 0);
            setTimeout(intentarFoco, 120);
            setTimeout(intentarFoco, 260);
        }

        formatearSaldo();
        detectarColumnasBusqueda();
        filtrarCuentas();
        filtrarCtasCtesVivo();
        enfocarBuscador();

        $txtBuscar
            .off(".ctasCtes")
            .on("input.ctasCtes", function () {
                filtrarCuentas();
            })
            .on("keydown.ctasCtes", function (e) {
                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    moverSeleccion(1);
                    return;
                }

                if (e.key === "ArrowUp") {
                    e.preventDefault();
                    moverSeleccion(-1);
                    return;
                }

                if (e.key === "Enter") {
                    e.preventDefault();
                    abrirFilaSeleccionada();
                }
            });

        $tbody
            .off("click.ctasCtes", "tr")
            .on("click.ctasCtes", "tr", function () {
                marcarSeleccion($(this));
            });
    })();
</script>

<style>
    .ctactes-index-page .card-body {
        padding: .82rem 1rem;
    }

    .ctactes-index-page .card.mb-4 {
        margin-bottom: .9rem !important;
    }

    .ctactes-index-page .form-control,
    .ctactes-index-page .input-group-text {
        font-size: .87rem;
    }

    .ctactes-index-page #tablaCtasCtes {
        font-size: .84rem;
    }

    .ctactes-index-page #tablaCtasCtes th,
    .ctactes-index-page #tablaCtasCtes td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .ctactes-index-page #tablaCtasCtes thead th,
    .ctactes-index-page #tablaCtasCtes > thead > tr > th {
        font-size: .73rem;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        padding-top: .38rem;
        padding-bottom: .38rem;
        line-height: 1.1;
    }

    .ctactes-index-page #tablaCtasCtes thead.thead-dark th,
    .ctactes-index-page #tablaCtasCtes .thead-dark th {
        font-size: .73rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        padding-top: .38rem;
        padding-bottom: .38rem;
        line-height: 1.1;
    }

    .ctactes-index-page #tablaCtasCtes .btn {
        font-size: .74rem;
        padding: .18rem .44rem;
    }

    /* Siempre permitir que el input crezca */
    #txtBuscar {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
    }

    #tbodyCtas tr.is-selected {
        background: rgba(13, 110, 253, 0.12);
    }

    @@media (min-width: 1200px) {
        .ctactes-index-page .card-body {
            padding: .7rem .85rem;
        }

        .ctactes-index-page .form-control,
        .ctactes-index-page .input-group-text {
            font-size: .84rem;
        }

        .ctactes-index-page #tablaCtasCtes {
            font-size: .8rem;
        }

        .ctactes-index-page #tablaCtasCtes thead th,
        .ctactes-index-page #tablaCtasCtes > thead > tr > th {
            font-size: .68rem;
        }

        .ctactes-index-page #tablaCtasCtes thead.thead-dark th,
        .ctactes-index-page #tablaCtasCtes .thead-dark th {
            font-size: .68rem !important;
            padding-top: .34rem;
            padding-bottom: .34rem;
        }
    }

    /* ----- PANTALLAS GRANDES ----- */
    .form-inline {
        display: flex;
        flex-wrap: nowrap; /* evita que se baje el icono */
        width: 100%;
    }

        .form-inline .form-group {
            flex: 1; /* ocupa todo el espacio */
        }

    .input-group {
        width: 100%;
        display: flex;
        flex-wrap: nowrap; /* icono siempre al lado */
    }

    /* ----- PANTALLAS PEQUEÑAS ----- */
    @@media (max-width: 576px) {

        .form-inline {
            display: block;
            width: 100%;
        }

        .form-group,
        .input-group {
            width: 100% !important;
        }

        .input-group {
            display: flex;
            flex-wrap: nowrap; /* evita salto de línea */
        }

            .input-group .form-control {
                min-width: 0;
                flex: 1 1 auto;
            }
    }
</style>
