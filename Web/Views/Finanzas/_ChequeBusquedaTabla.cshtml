@{
    string filtroEstado = ViewBag.FiltroEstado ?? "";
    string filtroNroCheque = ViewBag.FiltroNroCheque ?? "";
    string filtroDesde = ViewBag.FiltroDesde ?? "";
    bool chequeBusquedaEnPago = ViewBag.ChequeBusquedaEnPago != null && (bool)ViewBag.ChequeBusquedaEnPago;
}

<div class="row mb-3">
    <div class="col-md-3">
        <label>Estado</label>
        <select id="filtroEstado" class="form-control">
            <option value="">-- Todos --</option>
            <option value="PENDIENTE" @(filtroEstado == "PENDIENTE" ? "selected" : "")>Pendiente</option>
            <option value="ENTREGADO" @(filtroEstado == "ENTREGADO" ? "selected" : "")>Entregado</option>
            <option value="DEPOSITADO" @(filtroEstado == "DEPOSITADO" ? "selected" : "")>Depositado</option>
            <option value="ACREDITADO" @(filtroEstado == "ACREDITADO" ? "selected" : "")>Acreditado</option>
            <option value="RECHAZADO" @(filtroEstado == "RECHAZADO" ? "selected" : "")>Rechazado</option>
        </select>
    </div>

    <div class="col-md-3">
        <label>Nro Cheque</label>
        <input type="text" id="filtroNroCheque" class="form-control" placeholder="Buscar por numero" value="@filtroNroCheque">
    </div>

    <div class="col-md-3">
        <label>Fecha desde</label>
        <input type="date" id="filtroDesde" class="form-control" value="@filtroDesde">
    </div>

    <div class="col-md-3">
        <label>&nbsp;</label>
        <button type="button" class="btn btn-primary btn-block" id="btnFiltrarCheques">
            <i class="fas fa-filter mr-1"></i> Buscar
        </button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="tablaBusquedaCheques" width="100%" cellspacing="0">
        <thead class="thead-light">
            <tr>
                <th>ID</th>
                <th>Nro Cheque</th>
                <th>Banco</th>
                <th>Importe</th>
                <th>Fecha Pago</th>
                <th>Estado</th>
                <th>Titular</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@if (chequeBusquedaEnPago)
{
    <div class="small text-muted mt-2">
        Doble clic sobre un cheque para cargarlo al pago.
    </div>
}

