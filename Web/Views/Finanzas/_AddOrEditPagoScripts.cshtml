@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
}

<script>
(function (window, $) {
    if (!window || !$) return;

    var desdePosPago = @Html.Raw((desdePos ? "true" : "false"));
    var pagoEsAlta = @Html.Raw((Model == null || Model.Id == 0 ? "true" : "false"));
    var pagoSoloLecturaInicial = @Html.Raw((Model != null && Model.Id > 0 ? "true" : "false"));
    var pagoEdicionHabilitada = !pagoSoloLecturaInicial;
    window.pagoEdicionHabilitada = pagoEdicionHabilitada;
    var operacionPendienteSeleccion = pagoEsAlta;
    var operacionCompactaExpandida = pagoEsAlta;
    var cambioProgramaticoPago = false;
    var estadoPagoForm = {
        ultimaFormaPago: "",
        ultimoAProveedor: ""
    };

    window.swalPago = function (opciones) {
        var base = {
            allowOutsideClick: false
        };

        if (desdePosPago) {
            var target =
                document.querySelector("#modalDetalleCheque.show .modal-content") ||
                document.querySelector("#modalAltaCheque.show .modal-content") ||
                document.querySelector("#modalBuscarCheques.show .modal-content") ||
                document.querySelector("#modalPagoPOS.show .modal-content") ||
                document.querySelector("#modalFinanzasPOS.show .modal-content") ||
                document.body;

            base.target = target;
        }

        return Swal.fire(Object.assign(base, opciones || {}));
    };

    window.volverDesdePago = function () {
        if (desdePosPago) {
            $("#modalPagoPOS").modal("hide");
            return;
        }

        if (typeof desactivarProteccionSalida === "function") {
            desactivarProteccionSalida();
        }

        var urlVolver = $("#urlVolverPago").val();
        if (urlVolver) {
            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation("Cargando solicitud...");
            }
            window.location.href = urlVolver;
            return;
        }

        window.history.back();
    };

    window.PagoChequeSeed = [
        @if (Model != null && Model.Cheques != null)
        {
            for (int i = 0; i < Model.Cheques.Count; i++)
            {
                var c = Model.Cheques[i];
<text>{ Id: @c.Id, NroCheque: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.NroCheque))', Banco: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.Banco))', FechaPago: '@c.FechaPago.ToString("yyyy-MM-dd")', Importe: @c.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture) }@(i < Model.Cheques.Count - 1 ? "," : "")</text>
            }
        }
    ];

    function normalizarFormaPago(valor, texto) {
        var valorNorm = (valor || "").toString().trim().toLowerCase();
        var textoNorm = (texto || "").toString().trim().toLowerCase();

        return {
            valor: valorNorm,
            texto: textoNorm
        };
    }

    function esFormaCheque(valor, texto) {
        var fp = normalizarFormaPago(valor, texto);
        return fp.valor === "cheque" ||
            fp.valor === "eftvocheque" ||
            fp.valor === "efvtocheque" ||
            fp.texto === "cheque" ||
            fp.texto === "eftvocheque" ||
            fp.texto === "efvtocheque";
    }

    function esFormaMixta(valor, texto) {
        var fp = normalizarFormaPago(valor, texto);
        return fp.valor === "eftvocheque" ||
            fp.valor === "efvtocheque" ||
            fp.texto === "eftvocheque" ||
            fp.texto === "efvtocheque";
    }

    function tieneChequesAsignados() {
        return $("#tablaCheques tbody tr").length > 0;
    }

    function obtenerNumeroChequesAsignados() {
        var numeros = [];
        $("#tablaCheques tbody tr").each(function () {
            var nro = ($(this).find("td:eq(0)").text() || "").trim();
            if (nro) {
                numeros.push(nro);
            }
        });
        return numeros;
    }

    function revertirFormaPago(valorAnterior) {
        cambioProgramaticoPago = true;
        $("#formaPago").val(valorAnterior);
        cambioProgramaticoPago = false;
        setTimeout(actualizarVisibilidad, 0);
        if (window.PagoUX && typeof window.PagoUX.actualizarResumenModo === "function") {
            window.PagoUX.actualizarResumenModo();
        }
    }

    function revertirAProveedor(valorAnterior) {
        cambioProgramaticoPago = true;
        $("#AProveedor").val(valorAnterior);
        cambioProgramaticoPago = false;
        actualizarOperacionPago();
    }

    function actualizarOperacionPago() {
        var $grupo = $(".pago-operacion-grupo");
        var $compacto = $("#pagoOperacionCompacto");
        var $compactoTitulo = $("#pagoOperacionCompactoTitulo");
        var $compactoDescripcion = $("#pagoOperacionCompactoDescripcion");
        var $compactoIcono = $compacto.find(".pago-operacion-compacto-icono i");

        if (operacionPendienteSeleccion) {
            $(".pago-operacion-opcion")
                .removeClass("activo-pagar activo-cobrar pago-operacion-inactiva")
                .attr("aria-pressed", "false");

            $grupo.removeClass("pago-operacion-contraida");
            $compacto.addClass("d-none");
            $("#pagoOperacionResumen").addClass("d-none");
            return;
        }

        var esPago = ($("#AProveedor").val() || "").toString().toLowerCase() === "true";
        var $opciones = $(".pago-operacion-opcion");
        var $resumen = $("#pagoOperacionResumen");
        var $guardar = $("#btnGuardarPago");

        $opciones
            .removeClass("activo-pagar activo-cobrar")
            .addClass("pago-operacion-inactiva")
            .attr("aria-pressed", "false");

        $opciones.filter("[data-operacion-valor='" + (esPago ? "true" : "false") + "']")
            .removeClass("pago-operacion-inactiva")
            .addClass(esPago ? "activo-pagar" : "activo-cobrar")
            .attr("aria-pressed", "true");

        if ($resumen.length) {
            $resumen.removeClass("d-none");
            $resumen
                .removeClass("pago-operacion-pago pago-operacion-cobro")
                .addClass(esPago ? "pago-operacion-pago" : "pago-operacion-cobro")
                .html(esPago
                    ? '<i class="fas fa-arrow-up mr-1"></i><strong>Operación seleccionada: Realizar un pago</strong><span>Salida de dinero hacia proveedor o persona.</span>'
                    : '<i class="fas fa-arrow-down mr-1"></i><strong>Operación seleccionada: Recibir un cobro</strong><span>Ingreso de dinero desde cliente o persona.</span>');
        }

        if ($compacto.length) {
            $compacto
                .removeClass("d-none")
                .toggleClass("pago-operacion-pago", esPago)
                .toggleClass("pago-operacion-cobro", !esPago);

            if ($compactoTitulo.length) {
                $compactoTitulo.text(esPago ? "Realizar un pago" : "Recibir un cobro");
            }

            if ($compactoDescripcion.length) {
                $compactoDescripcion.text(esPago
                    ? "Salida de dinero hacia proveedor o persona."
                    : "Ingreso de dinero desde cliente o persona.");
            }

            if ($compactoIcono.length) {
                $compactoIcono
                    .removeClass("fa-arrow-up fa-arrow-down")
                    .addClass(esPago ? "fa-arrow-up" : "fa-arrow-down");
            }
        }

        var contraer = !operacionCompactaExpandida;
        $grupo.toggleClass("pago-operacion-contraida", contraer);

        if ($guardar.length) {
            $guardar
                .removeClass("btn-success btn-danger")
                .addClass(esPago ? "btn-danger" : "btn-success")
                .text(esPago ? "Guardar pago" : "Guardar cobro");
        }
    }

    function setOperacionPendiente(pendiente) {
        operacionPendienteSeleccion = !!pendiente;

        var $form = $("#formPago");
        var $bloqueados = $form.find(".pago-requiere-operacion");
        var $controles = $bloqueados.find("input, select, textarea, button").not("[type='hidden']");
        var puedeHabilitarControles = !pagoSoloLecturaInicial || pagoEdicionHabilitada;

        $form.toggleClass("pago-operacion-pendiente", operacionPendienteSeleccion);
        if (operacionPendienteSeleccion) {
            $controles.prop("disabled", true);
        } else if (puedeHabilitarControles) {
            $controles.prop("disabled", false);
        }

        if (operacionPendienteSeleccion) {
            $("#btnGuardarPago").addClass("d-none").prop("disabled", true);
        } else if (!pagoSoloLecturaInicial) {
            $("#btnGuardarPago").removeClass("d-none").prop("disabled", false);
        }

        actualizarOperacionPago();
    }

    function focoEnControlEditable() {
        var el = document.activeElement;
        if (!el) return false;

        var tag = (el.tagName || "").toLowerCase();
        if (tag === "textarea" || tag === "select") return true;
        if (tag !== "input") return false;

        var tipo = (el.type || "").toLowerCase();
        return tipo !== "button" && tipo !== "checkbox" && tipo !== "radio";
    }

    function tieneObservacionesPago() {
        return $.trim($("#Observaciones").val() || "").length > 0;
    }

    function actualizarBloqueObservacionesPago() {
        var $bloque = $(".pago-observaciones-bloque");
        var $contenido = $("#pagoObservacionesContenido");
        var $boton = $("#btnToggleObservacionesPago");
        if (!$bloque.length || !$contenido.length || !$boton.length) {
            return;
        }

        var tieneTexto = tieneObservacionesPago();
        var estaContraido = $bloque.hasClass("pago-observaciones-contraido");

        if (!tieneTexto && estaContraido) {
            $boton.text("Agregar");
            return;
        }

        if (estaContraido) {
            $boton.text("Ver");
            return;
        }

        $boton.text("Ocultar");
    }

    function enfocarPrimerCampoPago() {
        if (desdePosPago) {
            return;
        }

        enfocarCampoPagoConReintento("#SucursalId", "#Fecha");
    }

    function enfocarSucursalPago() {
        if (desdePosPago) {
            return;
        }

        enfocarCampoPagoConReintento("#SucursalId", "#Fecha");
    }

    function enfocarCampoPagoConReintento(selectorPrincipal, selectorAlternativo) {
        var intentos = 0;
        var maxIntentos = 8;

        function resolverCampo() {
            var $cardBody = $("#formPago").closest(".card-body");
            var $campo = $cardBody.find(selectorPrincipal + ":visible:not(:disabled)");
            if (!$campo.length && selectorAlternativo) {
                $campo = $cardBody.find(selectorAlternativo + ":visible:not(:disabled)");
            }
            return $campo;
        }

        function intentar() {
            intentos++;

            var $campo = resolverCampo();
            if (!$campo.length) {
                if (intentos < maxIntentos) {
                    setTimeout(intentar, 70);
                }
                return;
            }

            var control = $campo.get(0);
            if (!control) {
                return;
            }

            control.focus();

            if (document.activeElement === control) {
                return;
            }

            if (intentos < maxIntentos) {
                setTimeout(intentar, 70);
            }
        }

        setTimeout(intentar, 40);
    }

    function seleccionarOperacionPago(valor, forzarFocoSucursal) {
        valor = (valor || "").toString();
        if (!valor) {
            return;
        }

        operacionCompactaExpandida = false;
        $("#AProveedor").val(valor).trigger("change");

        if (forzarFocoSucursal) {
            enfocarSucursalPago();
        }
    }

    function validarChequesContraTipoOperacion(esAProveedor, onComplete) {
        var numeros = obtenerNumeroChequesAsignados();

        if (!numeros.length) {
            onComplete(true);
            return;
        }

        var pagoId = $("#Id").val() || 0;
        var mensajes = [];
        var pendientes = numeros.length;

        numeros.forEach(function (numero) {
            $.get(window.urls.buscarChequePorNro, {
                numero: numero,
                pagoId: pagoId,
                esAProveedor: esAProveedor
            }).done(function (resp) {
                if (!resp || !resp.ok) {
                    mensajes.push((resp && resp.mensaje) || ("El cheque " + numero + " no es válido para esta operación."));
                }
            }).fail(function () {
                mensajes.push("No se pudo validar el cheque " + numero + ".");
            }).always(function () {
                pendientes--;
                if (pendientes === 0) {
                    if (mensajes.length) {
                        window.swalPago({
                            icon: "warning",
                            title: "Validación",
                            text: mensajes[0]
                        });
                        onComplete(false);
                        return;
                    }

                    onComplete(true);
                }
            });
        });
    }

    function actualizarVisibilidad() {
        if (operacionPendienteSeleccion) {
            $("#bloqueCheques").hide();
            $("#bloqueEfectivo").hide();
            $("#importe").prop("readonly", true);
            return;
        }

        var valor = ($("#formaPago").val() || "").toString().trim().toLowerCase();
        var texto = ($("#formaPago option:selected").text() || "").toString().trim().toLowerCase();
        var bloquearImporte = !pagoEdicionHabilitada;

        var esCheque = esFormaCheque(valor, texto);
        var esMixto = esFormaMixta(valor, texto);

        if (esCheque) {
            $("#bloqueCheques").show();
            $("#importe").prop("readonly", true);

            if (esMixto) {
                $("#bloqueEfectivo").show();
            } else {
                $("#bloqueEfectivo").hide();
                $("#Efectivo").val(0);
            }

            if (window.PagoCheques) {
                window.PagoCheques.recalcularTotales();
            }
            return;
        }

        $("#bloqueCheques").hide();
        $("#bloqueEfectivo").hide();
        $("#importe").prop("readonly", bloquearImporte);

        if (window.PagoCheques) {
            window.PagoCheques.clearCheques();
        } else {
            $("#tablaCheques tbody").empty();
            $("#txtTotalCheques").val(0);
        }
    }

    window.actualizarVisibilidadPago = function () {
        pagoEdicionHabilitada = !!window.pagoEdicionHabilitada;
        actualizarVisibilidad();
    };

    $(document)
        .off("change.posPagoProteccion keyup.posPagoProteccion", "#formPago input, #formPago select, #formPago textarea")
        .on("change.posPagoProteccion keyup.posPagoProteccion", "#formPago input, #formPago select, #formPago textarea", function () {
            if (!desdePosPago && typeof activarProteccionSalida === "function") {
                activarProteccionSalida();
            }
        })
        .off("change.posPago", "#formaPago")
        .on("change.posPago", "#formaPago", function () {
            if (operacionPendienteSeleccion) return;
            if (cambioProgramaticoPago) return;

            var valorNuevo = $(this).val();
            var textoNuevo = $("#formaPago option:selected").text();
            var valorAnterior = estadoPagoForm.ultimaFormaPago || valorNuevo;
            var textoAnterior = $("#formaPago option[value='" + valorAnterior + "']").text();

            if (!esFormaCheque(valorNuevo, textoNuevo) && tieneChequesAsignados()) {
                window.swalPago({
                    icon: "warning",
                    title: "Validación",
                    text: "Para cambiar la forma de pago primero debe quitar los cheques asignados."
                });
                revertirFormaPago(valorAnterior);
                return;
            }

            var efectivoActual = parseFloat($("#Efectivo").val() || "0") || 0;
            if (esFormaCheque(valorNuevo, textoNuevo) &&
                !esFormaMixta(valorNuevo, textoNuevo) &&
                esFormaMixta(valorAnterior, textoAnterior) &&
                efectivoActual > 0) {
                window.swalPago({
                    icon: "warning",
                    title: "Validación",
                    text: "El campo Efectivo tiene asignado un importe. Bórralo o ponelo en 0 para cambiar la forma de pago."
                });
                revertirFormaPago(valorAnterior);
                return;
            }

            estadoPagoForm.ultimaFormaPago = valorNuevo;
            actualizarVisibilidad();
        })
        .off("change.posPagoOperacion", "#AProveedor")
        .on("change.posPagoOperacion", "#AProveedor", function () {
            var valorActual = ($(this).val() || "").toString();
            if (valorActual === "") {
                setOperacionPendiente(true);
                setTimeout(actualizarVisibilidad, 0);
                return;
            }

            if (operacionPendienteSeleccion) {
                setOperacionPendiente(false);
                setTimeout(actualizarVisibilidad, 0);
            }

            if (cambioProgramaticoPago) return;

            var valorAnterior = estadoPagoForm.ultimoAProveedor || $(this).val();
            var valorNuevo = $(this).val();

            if (valorAnterior === valorNuevo) {
                actualizarOperacionPago();
                setTimeout(actualizarVisibilidad, 0);
                enfocarSucursalPago();
                return;
            }

            validarChequesContraTipoOperacion(valorNuevo === "true", function (ok) {
                if (!ok) {
                    revertirAProveedor(valorAnterior);
                    return;
                }

                estadoPagoForm.ultimoAProveedor = valorNuevo;
                actualizarOperacionPago();
                setTimeout(actualizarVisibilidad, 0);
                enfocarSucursalPago();
            });
        })
        .off("click.posPagoOperacion", ".pago-operacion-opcion")
        .on("click.posPagoOperacion", ".pago-operacion-opcion", function (event) {
            event.preventDefault();
            $(this).trigger("blur");

            var valor = ($(this).attr("data-operacion-valor") || "").toString();
            seleccionarOperacionPago(valor);
        })
        .off("click.posPagoOperacionExpandir", "#btnCambiarOperacionPago")
        .on("click.posPagoOperacionExpandir", "#btnCambiarOperacionPago", function (event) {
            event.preventDefault();
            operacionCompactaExpandida = true;
            $(".pago-operacion-grupo").removeClass("pago-operacion-contraida");
            $("#pagoOperacionCompacto").addClass("d-none");
            $(".pago-operacion-expandible .pago-operacion-opcion[aria-pressed='true']").trigger("focus");
        })
        .off("click.posPagoObservaciones", "#btnToggleObservacionesPago")
        .on("click.posPagoObservaciones", "#btnToggleObservacionesPago", function (event) {
            event.preventDefault();
            var $bloque = $(".pago-observaciones-bloque");
            var contraer = !$bloque.hasClass("pago-observaciones-contraido");
            $bloque.toggleClass("pago-observaciones-contraido", contraer);
            actualizarBloqueObservacionesPago();

            if (!contraer) {
                setTimeout(function () {
                    $("#Observaciones").trigger("focus");
                }, 30);
            }
        })
        .off("keydown.posPagoOperacion", ".pago-operacion-opcion")
        .on("keydown.posPagoOperacion", ".pago-operacion-opcion", function (event) {
            if (event.key !== "Enter" && event.key !== " ") return;

            event.preventDefault();
            event.stopPropagation();
            if (typeof event.stopImmediatePropagation === "function") {
                event.stopImmediatePropagation();
            }

            var valor = ($(this).attr("data-operacion-valor") || "").toString();
            $(this).trigger("blur");
            seleccionarOperacionPago(valor, true);
        })
        .off("keyup.posPagoOperacion", ".pago-operacion-opcion")
        .on("keyup.posPagoOperacion", ".pago-operacion-opcion", function (event) {
            if (event.key !== "Enter" && event.key !== " ") return;

            event.preventDefault();
            $(this).trigger("blur");
            event.stopPropagation();
            if (typeof event.stopImmediatePropagation === "function") {
                event.stopImmediatePropagation();
            }
        })
        .off("keydown.posPagoAtajos")
        .on("keydown.posPagoAtajos", function (event) {
            if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
            if (focoEnControlEditable()) return;

            if (event.key === "1") {
                event.preventDefault();
                $(".pago-operacion-opcion[data-operacion-valor='true']").trigger("click");
                return;
            }

            if (event.key === "2") {
                event.preventDefault();
                $(".pago-operacion-opcion[data-operacion-valor='false']").trigger("click");
            }
        })
        .off("submit.posPagoOperacion", "#formPago")
        .on("submit.posPagoOperacion", "#formPago", function (event) {
            if (!operacionPendienteSeleccion) return;

            event.preventDefault();
            window.swalPago({
                icon: "warning",
                title: "Validación",
                text: "Seleccione primero si desea realizar un pago o recibir un cobro."
            });
            return false;
        })
        .off("input.posPago", "#Efectivo")
        .on("input.posPago", "#Efectivo", function () {
            if (window.PagoCheques) {
                window.PagoCheques.recalcularTotales();
            }
        })
        .off("input.posPagoObservaciones", "#Observaciones")
        .on("input.posPagoObservaciones", "#Observaciones", function () {
            actualizarBloqueObservacionesPago();
        })
        .off("click.posPagoModificar", "#btnHabilitarEdicionPago")
        .on("click.posPagoModificar", "#btnHabilitarEdicionPago", function () {
            pagoEdicionHabilitada = true;
            window.pagoEdicionHabilitada = true;
            setTimeout(actualizarVisibilidad, 0);
        });

    $(document).ready(function () {
        estadoPagoForm.ultimaFormaPago = $("#formaPago").val() || "";

        if (pagoEsAlta) {
            cambioProgramaticoPago = true;
            $("#AProveedor").val("");
            cambioProgramaticoPago = false;
            estadoPagoForm.ultimoAProveedor = "";
            setOperacionPendiente(true);
            operacionCompactaExpandida = true;
            $(".pago-operacion-opcion[data-operacion-valor='true']").trigger("focus");
            $(".pago-observaciones-bloque").addClass("pago-observaciones-contraido");
        } else {
            estadoPagoForm.ultimoAProveedor = $("#AProveedor").val() || "";
            setOperacionPendiente(false);
            operacionCompactaExpandida = false;
            $("#SucursalId").trigger("focus");
            $(".pago-observaciones-bloque").toggleClass("pago-observaciones-contraido", !tieneObservacionesPago());
        }

        setTimeout(actualizarVisibilidad, 0);
        actualizarOperacionPago();
        actualizarBloqueObservacionesPago();
    });
})(window, jQuery);
</script>
