<div class="modal fade" id="modalPostPago" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title mb-0">Pago guardado</h5>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3" style="font-size:1.05rem;">Que deseas hacer ahora?</p>

                <button class="btn btn-secondary btn-lg btn-block mb-2" id="btnPostPagoNoImprimir" type="button">
                    <span class="badge badge-light mr-2">1</span>
                    No imprimir
                </button>

                <div class="d-flex mb-2">
                    <button class="btn btn-outline-primary btn-lg flex-grow-1 mr-2" id="btnPostPagoImprimir" type="button">
                        <span class="badge badge-primary mr-2">2</span>
                        <span id="lblPagoTicketAccion">Imprimir</span>
                    </button>

                    <button class="btn btn-outline-secondary btn-lg" id="btnCambiarTicketPago" type="button" title="Cambiar tamaño de ticket">
                        Cambiar
                    </button>
                </div>

                <div class="collapse mb-2" id="bloqueTicketOpcionesPago">
                    <div class="card card-body p-2">
                        <button class="btn btn-outline-primary btn-block mb-2 btnTicketPagoOpt" type="button" data-mm="58">
                            Ticket 58 mm
                        </button>

                        <button class="btn btn-outline-primary btn-block btnTicketPagoOpt" type="button" data-mm="80">
                            Ticket 80 mm
                        </button>

                        <small class="text-muted mt-2 d-block">
                            Elegi un tamaño y se imprimira automaticamente.
                        </small>
                    </div>
                </div>

                <button class="btn btn-dark btn-lg btn-block mb-2" id="btnPostPagoPdf" type="button">
                    <span class="badge badge-light mr-2">3</span>
                    Generar PDF
                </button>

                <button class="btn btn-success btn-lg btn-block" id="btnPostPagoEmail" type="button">
                    <span class="badge badge-light mr-2">4</span>
                    <i class="fas fa-envelope mr-2"></i>Enviar por email
                </button>

                <div class="mt-3 pt-2 border-top text-left">
                    <div class="small text-muted mb-2" id="estadoAgentePago">
                        Impresión local: usando navegador.
                    </div>

                    <div class="d-flex">
                        <button class="btn btn-outline-info btn-sm flex-grow-1 mr-2" id="btnConfigurarAgentePago" type="button">
                            Configurar impresora
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" id="btnDescargarAgentePago" href="@Url.Action("DescargarAgenteImpresion", "Finanzas")">
                            Descargar agente
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEmailPago" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Enviar recibo por email</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">
                    El recibo PDF se adjuntará automáticamente al email.
                </p>

                <div class="form-group">
                    <label for="ppEmailDestino">Email destino</label>
                    <input type="email" class="form-control" id="ppEmailDestino" maxlength="200" placeholder="cliente@dominio.com">
                </div>

                <div class="form-group">
                    <label for="ppEmailAsunto">Asunto</label>
                    <input type="text" class="form-control" id="ppEmailAsunto" maxlength="200">
                </div>

                <div class="form-group mb-2">
                    <label for="ppEmailMensaje">Mensaje</label>
                    <textarea class="form-control" id="ppEmailMensaje" rows="6"></textarea>
                </div>

                <div class="alert alert-danger d-none mb-0" id="ppEmailError"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" type="button" id="btnConfirmarEmailPago">
                    <i class="fas fa-paper-plane mr-1"></i> Enviar email
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfigAgentePago" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configurar impresora local</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-none" id="msgConfigAgentePago"></div>

                <div class="form-group">
                    <label for="cmbImpresoraAgentePago">Impresora</label>
                    <select class="form-control" id="cmbImpresoraAgentePago"></select>
                </div>

                <div class="form-group mb-0">
                    <label for="cmbMmAgentePago">Tamaño ticket</label>
                    <select class="form-control" id="cmbMmAgentePago">
                        <option value="58">58 mm</option>
                        <option value="80">80 mm</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" type="button" id="btnGuardarConfigAgentePago">Guardar</button>
            </div>
        </div>
    </div>
</div>
