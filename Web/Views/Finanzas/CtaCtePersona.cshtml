</style>

<script>
    (function () {
        if (@Html.Raw((desdePos || renderSinLayout ? "true" : "false"))) {
            return;
        }

        function showNavigationLoading(message) {
            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
            }
        }

        var form = document.querySelector('#ctactePersonaContainer form[action*="CtaCtePersona"]');
        if (form) {
            form.addEventListener("submit", function () {
                showNavigationLoading("Cargando solicitud...");
            });
        }

        ["btnVolverCtasCtesPersona", "btnNuevoPagoCtaCteDesktop", "btnNuevoPagoCtaCteMobile"].forEach(function (id) {
            var link = document.getElementById(id);
            if (!link) return;

            link.addEventListener("click", function (event) {
                event.preventDefault();
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    window.location.href = link.href;
                }, 0);
            });
        });
    })();
</script>

<script>
    (function () {
        var returnUrl = '@returnUrl';
        var desdePos = @Html.Raw((desdePos ? "true" : "false"));

        window.verMovimientoCtaCte = function (tabla, idTabla) {
        var tablaNorm = String(tabla || "").toLowerCase();
        var returnUrlEncoded = encodeURIComponent(returnUrl);

        if (tablaNorm === "ventas") {
            var urlDetalleVenta = '@Url.Action("DetalleVenta", "Ventas")'
                + '?id=' + encodeURIComponent(idTabla)
                + '&returnUrl=' + returnUrlEncoded;

            if (desdePos && window.POSFinanzas) {
                urlDetalleVenta += '&modal=true&desdePos=true';
                window.POSFinanzas.cargar(urlDetalleVenta, "Detalle de venta");
                return;
            }

            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation("Cargando solicitud...");
            }
            window.location.href = urlDetalleVenta;
            return;
        }

        var url = '@Url.Action("verMovimientoCtaCte", "Finanzas", new { idPersona = ViewBag.IdPersona })'
                    + '&returnUrl=' + returnUrlEncoded
                    + '&tabla=' + encodeURIComponent(tabla)
                    + '&idTabla=' + encodeURIComponent(idTabla)
                    + '&desdePos=' + desdePos;

        if (desdePos && window.POSFinanzas) {
            if (tablaNorm === "pagos") {
                window.POSFinanzas.cargarPago(url, "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
            window.ModalRequestLoading.trackNavigation("Cargando solicitud...");
        }
        window.location.href = url;
        };
    })();
</script>
<script>
    // El layout carga jQuery al final del body, asi que este bloque se ejecuta antes de que exista $.
    // Sin esperarlo, el $(document) de mas abajo cortaba la funcion con ReferenceError y quedaban
    // muertos los atajos de teclado y los handlers del modal de mail. Por eso se espera a jQuery.
    function inicializarCtaCtePersona() {
        var desdePos = @Html.Raw((desdePos ? "true" : "false"));
        var puedeExportarCuentaCorriente = @Html.Raw((puedeExportarCuentaCorriente ? "true" : "false"));
        var ctaCteEmailConfigUrl = '@Url.Action("ObtenerDatosEmailCuentaCorriente", "Finanzas")';
        var ctaCteEmailSendUrl = '@Url.Action("EnviarCuentaCorrienteEmail", "Finanzas")';
        var ctaCteFechaDesde = '@fechaDesde';
        var ctaCteIdPersona = @ViewBag.IdPersona;

        function esEmailValido(email) {
            return new RegExp('^[^\\s\\x40]+\\x40[^\\s\\x40]+\\.[^\\s\\x40]+$').test(String(email || '').trim());
        }

        function obtenerMostrarAnuladosActual() {
            return $("#chkMostrarAnulados").is(":checked") || $("#chkMostrarAnuladosMobile").is(":checked");
        }

        function abrirModalEmailCuentaCorriente() {
            if (!puedeExportarCuentaCorriente) return;

            $("#ccEmailError").addClass("d-none").text("");
            $("#ccEmailDestino").val("");
            $("#ccEmailAsunto").val("");
            $("#ccEmailMensaje").val("");
            $("#ccEmailFormato").val("pdf");
            $("#btnConfirmarEmailCtaCte").prop("disabled", true);

            $.getJSON(ctaCteEmailConfigUrl, {
                idPersona: ctaCteIdPersona,
                fechaDesde: ctaCteFechaDesde,
                mostrarAnulados: obtenerMostrarAnuladosActual(),
                desdePos: desdePos
            }).done(function (resp) {
                if (!resp || !resp.ok) {
                    Swal.fire({ icon: "error", title: "Email", text: (resp && resp.msg) || "No se pudieron recuperar los datos del email." });
                    return;
                }

                $("#ccEmailDestino").val(resp.email || "");
                $("#ccEmailAsunto").val(resp.asunto || "");
                $("#ccEmailMensaje").val(resp.mensaje || "");
                $("#btnConfirmarEmailCtaCte").prop("disabled", false);
                $("#modalEmailCtaCte").modal("show");
            }).fail(function () {
                Swal.fire({ icon: "error", title: "Email", text: "No se pudieron recuperar los datos del email." });
            });
        }

        function confirmarEmailCuentaCorriente() {
            var payload = {
                idPersona: ctaCteIdPersona,
                fechaDesde: ctaCteFechaDesde,
                mostrarAnulados: obtenerMostrarAnuladosActual(),
                desdePos: desdePos,
                emailDestino: ($("#ccEmailDestino").val() || "").trim(),
                asunto: ($("#ccEmailAsunto").val() || "").trim(),
                mensaje: ($("#ccEmailMensaje").val() || "").trim(),
                formato: ($("#ccEmailFormato").val() || "pdf").trim()
            };

            if (!payload.emailDestino) {
                $("#ccEmailError").removeClass("d-none").text("Ingresa el email destino.");
                return;
            }

            if (!esEmailValido(payload.emailDestino)) {
                $("#ccEmailError").removeClass("d-none").text("Ingresa un email válido.");
                return;
            }

            if (!payload.asunto) {
                $("#ccEmailError").removeClass("d-none").text("Ingresa el asunto del mail.");
                return;
            }

            $("#ccEmailError").addClass("d-none").text("");
            $("#btnConfirmarEmailCtaCte").prop("disabled", true);

            $.ajax({
                url: ctaCteEmailSendUrl,
                type: "POST",
                dataType: "json",
                data: payload
            }).done(function (resp) {
                if (!resp || !resp.ok) {
                    $("#btnConfirmarEmailCtaCte").prop("disabled", false);
                    $("#ccEmailError").removeClass("d-none").text((resp && resp.msg) || "No se pudo enviar el mail.");
                    return;
                }

                $("#modalEmailCtaCte").modal("hide");
                Swal.fire({ icon: "success", title: "Email", text: resp.msg || "La cuenta corriente se envió correctamente." });
            }).fail(function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.msg) || "No se pudo enviar el mail.";
                $("#btnConfirmarEmailCtaCte").prop("disabled", false);
                $("#ccEmailError").removeClass("d-none").text(msg);
            });
        }

        function focoEnControlEditable() {
            var el = document.activeElement;
            if (!el) return false;

            var tag = (el.tagName || "").toLowerCase();
            if (tag === "textarea" || tag === "select") return true;
            if (tag !== "input") return false;

            var tipo = (el.type || "").toLowerCase();
            return tipo !== "button" && tipo !== "checkbox" && tipo !== "radio";
        }

        function abrirNuevoPagoDesdeAtajo() {
            var btn = document.getElementById("btnNuevoPagoCtaCteDesktop");
            if (!btn || btn.offsetParent === null) {
                btn = document.getElementById("btnNuevoPagoCtaCteMobile");
            }

            if (!btn) return;
            btn.click();
        }

        function obtenerFechaDesdeVisible() {
            var $input = $('#ctactePersonaContainer input[name="fechaDesde"]:visible:not(:disabled)').first();
            return $input.length ? $input : $();
        }

        function obtenerBotonFiltrarVisible() {
            var $btn = $('#btnFiltrarCtaCteDesktop:visible:not(:disabled)').first();
            if (!$btn.length) {
                $btn = $('#btnFiltrarCtaCteMobile:visible:not(:disabled)').first();
            }

            return $btn;
        }

        function enfocarFechaDesde() {
            var $input = obtenerFechaDesdeVisible();
            if (!$input.length) return;

            window.setTimeout(function () {
                $input.trigger('focus');
            }, 0);
        }

        function filtrarCuentaCorrienteDesdeFecha(input) {
            var $input = $(input);
            var $form = $input.closest('form');
            if (!$form.length) return;

            var $btn = obtenerBotonFiltrarVisible();
            if ($btn.length) {
                $btn.trigger('click');
                return;
            }

            if ($form[0] && typeof $form[0].requestSubmit === 'function') {
                $form[0].requestSubmit();
                return;
            }

            $form.trigger('submit');
        }

        function volverFinanzasDesdeAtajo() {
            var btnVolver = document.getElementById('btnVolverCtasCtesPersona');
            if (btnVolver) {
                btnVolver.click();
                return;
            }

            window.location.href = '@hrefBotonVolver';
        }

        function esCampoFechaCuentaCorriente(target) {
            if (!target || !target.id) return false;
            return target.id === 'ctacteFechaDesdeDesktop' || target.id === 'ctacteFechaDesdeMobile';
        }

        function esAtajoNuevoPagoCuentaCorriente(event) {
            if (!event || !event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.repeat) {
                return false;
            }

            var key = String(event.key || '');
            var code = String(event.code || '');

            return key === '+' || key === 'Add' || code === 'NumpadAdd' || key === 'Enter';
        }

        function bindAtajosCuentaCorrienteCaptura() {
            if (window.__ctacteAtajosCapturaBound) {
                return;
            }

            window.__ctacteAtajosCapturaBound = true;

            window.addEventListener('keydown', function (event) {
                if (event.defaultPrevented) return;

                if (esCampoFechaCuentaCorriente(event.target) && !event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.key === 'Enter') {
                    event.preventDefault();
                    event.stopPropagation();
                    filtrarCuentaCorrienteDesdeFecha(event.target);
                    return;
                }

                if (esAtajoNuevoPagoCuentaCorriente(event)) {
                    event.preventDefault();
                    event.stopPropagation();
                    abrirNuevoPagoDesdeAtajo();
                    return;
                }

                if (!event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.repeat) return;

                var key = String(event.key || '').toLowerCase();

                if (key === 'f') {
                    event.preventDefault();
                    event.stopPropagation();
                    enfocarFechaDesde();
                    return;
                }

                if (key === 's' && !desdePos) {
                    event.preventDefault();
                    event.stopPropagation();
                    volverFinanzasDesdeAtajo();
                }
            }, true);
        }

        $(document)
            .off("change.ctacteMostrarAnulados", "#chkMostrarAnulados, #chkMostrarAnuladosMobile")
            .on("change.ctacteMostrarAnulados", "#chkMostrarAnulados, #chkMostrarAnuladosMobile", function () {
                if (!desdePos) {
                    return;
                }

                $("#mostrarAnuladosHidden").val(this.checked ? "true" : "false");

                var $form = $(this).closest("form");
                $form.trigger("submit");
            });

        $(document)
            .off("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]')
            .on("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]', function () {
                var checkedDesktop = $("#chkMostrarAnulados").is(":checked");
                var checkedMobile = $("#chkMostrarAnuladosMobile").is(":checked");
                $("#mostrarAnuladosHidden").val((checkedDesktop || checkedMobile) ? "true" : "false");
            })
            .off("click.ctacteEnviarMail", "#btnEnviarMailCtaCteDesktop, #btnEnviarMailCtaCteMobile")
            .on("click.ctacteEnviarMail", "#btnEnviarMailCtaCteDesktop, #btnEnviarMailCtaCteMobile", function () {
                abrirModalEmailCuentaCorriente();
            })
            .off("click.ctacteConfirmarMail", "#btnConfirmarEmailCtaCte")
            .on("click.ctacteConfirmarMail", "#btnConfirmarEmailCtaCte", function () {
                confirmarEmailCuentaCorriente();
            })
            .off("input.ctacteMailInputs", "#ccEmailDestino, #ccEmailAsunto, #ccEmailMensaje")
            .on("input.ctacteMailInputs", "#ccEmailDestino, #ccEmailAsunto, #ccEmailMensaje", function () {
                $("#ccEmailError").addClass("d-none").text("");
            })
            .off("shown.bs.modal.ctacteMail", "#modalEmailCtaCte")
            .on("shown.bs.modal.ctacteMail", "#modalEmailCtaCte", function () {
                $("#ccEmailDestino").trigger("focus");
            })
            .off("keydown.ctacteFechaDesde", '#ctactePersonaContainer input[name="fechaDesde"]')
            .on("keydown.ctacteFechaDesde", '#ctactePersonaContainer input[name="fechaDesde"]', function (event) {
                if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
                if (event.key !== 'Enter') return;

                event.preventDefault();
                filtrarCuentaCorrienteDesdeFecha(this);
            })
            .off("keydown.ctacteNuevoPago")
            .on("keydown.ctacteNuevoPago", function (event) {
                if (esAtajoNuevoPagoCuentaCorriente(event)) {
                    event.preventDefault();
                    abrirNuevoPagoDesdeAtajo();
                    return;
                }

                if (!event.altKey || event.ctrlKey || event.metaKey) return;
                var key = String(event.key || '').toLowerCase();

                if (key === 'f' && !event.shiftKey) {
                    event.preventDefault();
                    enfocarFechaDesde();
                    return;
                }

                if (key === 's' && !event.shiftKey && !desdePos) {
                    event.preventDefault();
                    volverFinanzasDesdeAtajo();
                    return;
                }
            });

        bindAtajosCuentaCorrienteCaptura();
    }

    (function esperarJQuery() {
        if (!window.jQuery) {
            window.setTimeout(esperarJQuery, 50);
            return;
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", inicializarCtaCtePersona, { once: true });
            return;
        }

        inicializarCtaCtePersona();
    })();
</script>

<style>
    #tablaPersona .ctacte-color-positivo {
        color: green;
    }

    #tablaPersona .ctacte-color-negativo {
        color: red;
    }

    #tablaPersona td, #tablaPersona th {
        white-space: nowrap;
    }

    #tablaPersona thead th[data-sort-type] {
        cursor: pointer;
        user-select: none;
        position: relative;
        padding-right: 1.15rem;
    }

    #tablaPersona thead th[data-sort-type]::after {
        content: " ";
        position: absolute;
        right: .38rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, .72);
        font-size: .62rem;
    }

    #tablaPersona thead th.sort-asc::after {
        content: "▲";
    }

    #tablaPersona thead th.sort-desc::after {
        content: "▼";
    }

    #tablaPersona tr.ctacte-row-historico td {
        color: #6c757d;
        text-decoration: line-through;
        opacity: 0.8;
    }

    #tablaPersona tr.ctacte-row-modificado:not(.ctacte-row-historico) {
        background-color: #fff8e1;
    }

    #tablaPersona tr.ctacte-row-sin-operacion {
        cursor: default !important;
    }

    html.dark-mode #tablaPersona .ctacte-color-positivo,
    body.dark-mode #tablaPersona .ctacte-color-positivo {
        color: #55d88a !important;
    }

    html.dark-mode #tablaPersona .ctacte-color-negativo,
    body.dark-mode #tablaPersona .ctacte-color-negativo {
        color: #ff7f7f !important;
    }

    html.dark-mode .ctacte-page .ctacte-btn-mail,
    body.dark-mode .ctacte-page .ctacte-btn-mail {
        color: #8ec5ff !important;
        border-color: #5aa9ff !important;
        background-color: transparent !important;
    }

    html.dark-mode .ctacte-page .ctacte-btn-mail i,
    body.dark-mode .ctacte-page .ctacte-btn-mail i {
        color: inherit !important;
    }

    html.dark-mode .ctacte-page .ctacte-btn-mail:hover,
    html.dark-mode .ctacte-page .ctacte-btn-mail:focus,
    body.dark-mode .ctacte-page .ctacte-btn-mail:hover,
    body.dark-mode .ctacte-page .ctacte-btn-mail:focus {
        color: #0f1720 !important;
        background-color: #8ec5ff !important;
        border-color: #8ec5ff !important;
    }
</style>

<script>
    (function () {
        var tabla = document.getElementById("tablaPersona");
        if (!tabla || !tabla.tHead || !tabla.tBodies.length) return;

        var tbody = tabla.tBodies[0];
        var headers = Array.from(tabla.tHead.querySelectorAll("th[data-sort-type]"));
        var sortState = {
            index: 3,
            direction: "asc"
        };

        function parseNumber(value) {
            var normalized = (value || "")
                .toString()
                .replace(/\./g, "")
                .replace(",", ".")
                .replace(/[^\d.-]/g, "");
            var parsed = parseFloat(normalized);
            return isNaN(parsed) ? 0 : parsed;
        }

        function parseDate(value) {
            var match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec((value || "").toString().trim());
            if (!match) return 0;
            return new Date(parseInt(match[3], 10), parseInt(match[2], 10) - 1, parseInt(match[1], 10)).getTime();
        }

        function getCellSortValue(row, index, type) {
            var cell = row.cells[index];
            var text = cell ? (cell.textContent || "").trim() : "";

            if (type === "number") return parseNumber(text);
            if (type === "date") return parseDate(text);
            return text.toLowerCase();
        }

        function getRowId(row) {
            var cell = row && row.cells && row.cells.length ? row.cells[0] : null;
            var text = cell ? (cell.textContent || "").trim() : "";
            var parsed = parseInt(text, 10);
            return isNaN(parsed) ? -1 : parsed;
        }

        function updateHeaderState(activeHeader, direction) {
            headers.forEach(function (header) {
                header.classList.remove("sort-asc", "sort-desc");
            });

            if (activeHeader) {
                activeHeader.classList.add(direction === "asc" ? "sort-asc" : "sort-desc");
            }
        }

        function sortByColumn(index, type, direction, activeHeader) {
            var rows = Array.from(tbody.rows).map(function (row, originalIndex) {
                return {
                    row: row,
                    value: getCellSortValue(row, index, type),
                    originalIndex: originalIndex
                };
            });

            rows.sort(function (a, b) {
                if (type === "date") {
                    var idA = getRowId(a.row);
                    var idB = getRowId(b.row);
                    var esSaldoAnteriorA = idA === 0;
                    var esSaldoAnteriorB = idB === 0;

                    if (esSaldoAnteriorA !== esSaldoAnteriorB) {
                        if (direction === "asc") {
                            return esSaldoAnteriorA ? -1 : 1;
                        }

                        return esSaldoAnteriorA ? 1 : -1;
                    }
                }

                if (a.value < b.value) return direction === "asc" ? -1 : 1;
                if (a.value > b.value) return direction === "asc" ? 1 : -1;
                return a.originalIndex - b.originalIndex;
            });

            rows.forEach(function (item) {
                tbody.appendChild(item.row);
            });

            updateHeaderState(activeHeader, direction);
        }

        headers.forEach(function (header) {
            header.addEventListener("click", function () {
                var index = parseInt(header.getAttribute("data-sort-index"), 10);
                var type = header.getAttribute("data-sort-type") || "text";
                var direction = (sortState.index === index && sortState.direction === "asc") ? "desc" : "asc";

                sortState.index = index;
                sortState.direction = direction;
                sortByColumn(index, type, direction, header);
            });
        });

        if (headers.length) {
            var headerInicial = headers.find(function (header) {
                return parseInt(header.getAttribute("data-sort-index"), 10) === sortState.index;
            });

            if (headerInicial) {
                sortByColumn(
                    sortState.index,
                    headerInicial.getAttribute("data-sort-type") || "date",
                    sortState.direction,
                    headerInicial
                );
            }
        }
    })();
</script>
