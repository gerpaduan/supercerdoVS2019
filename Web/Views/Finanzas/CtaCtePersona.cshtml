@model System.Data.DataTable
@using System.Collections.Generic

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool mostrarAnulados = ViewBag.MostrarAnulados != null && (bool)ViewBag.MostrarAnulados;
    bool ocultarSaldo = ViewBag.OcultarSaldo != null && (bool)ViewBag.OcultarSaldo;
    bool mostrarSoloUltimosRegistros = ViewBag.MostrarSoloUltimosRegistros != null && (bool)ViewBag.MostrarSoloUltimosRegistros;
    bool mostrarSoloMovimientosCajaActual = ViewBag.MostrarSoloMovimientosCajaActual != null && (bool)ViewBag.MostrarSoloMovimientosCajaActual;
    bool puedeExportarCuentaCorriente = ViewBag.PuedeExportarCuentaCorriente != null && (bool)ViewBag.PuedeExportarCuentaCorriente;
    bool ocultarFiltroFechaDesde = ViewBag.OcultarFiltroFechaDesde != null && (bool)ViewBag.OcultarFiltroFechaDesde;
    int cantidadUltimosRegistros = ViewBag.CantidadUltimosRegistros != null ? (int)ViewBag.CantidadUltimosRegistros : 0;

    ViewBag.Title = "Cuenta Corriente";
    Layout = (desdePos || renderSinLayout) ? null : "~/Views/Shared/_LayoutBase.cshtml";

    var personaObj = ViewBag.Persona as Entidades.Persona;
    string persona = personaObj != null ? (personaObj.RazonSocial ?? "") : "";
    decimal saldo = ViewBag.SaldoPersona;
    string fechaDesde = ViewBag.FechaDesde ?? "";
    string returnUrlCtaCte = ViewBag.ReturnUrlCtaCte as string ?? "";
    bool mostrarBotonVolver = !desdePos && !renderSinLayout;
    string hrefBotonVolver = !string.IsNullOrWhiteSpace(returnUrlCtaCte)
        ? returnUrlCtaCte
        : Url.Action("CtasCtes", "Finanzas");
    var returnUrl = Convert.ToBase64String(
         System.Text.Encoding.UTF8.GetBytes(Request.RawUrl)
     );

    Func<System.Data.DataRow, string> claveMovimiento = row =>
        string.Join("|",
            Convert.ToString(row["Tabla"]),
            Convert.ToString(row["IdTabla"]),
            Convert.ToString(row["Sucursal"]));

    var ultimoIdPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var cantidadPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    bool tieneColumnaNroDoc = Model != null && Model.Columns.Contains("NroDoc");

    foreach (System.Data.DataRow row in Model.Rows)
    {
        string clave = claveMovimiento(row);
        int id = Convert.ToInt32(row["ID"]);

        if (!ultimoIdPorClave.ContainsKey(clave) || id > ultimoIdPorClave[clave])
        {
            ultimoIdPorClave[clave] = id;
        }

        cantidadPorClave[clave] = cantidadPorClave.ContainsKey(clave)
            ? cantidadPorClave[clave] + 1
            : 1;
    }
}

<div id="ctactePersonaContainer" class="container-fluid px-2 px-md-3 ctacte-page ctacte-form-compact">
    <!-- =======================
         CABECERA PERSONA + SALDO
         ======================= -->
    <div class="alert alert-primary d-flex justify-content-between align-items-center ctacte-header-box">
        <div class="d-flex align-items-center">
            @if (mostrarBotonVolver)
            {
                <a href="@hrefBotonVolver" class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverCtasCtesPersona">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h5 class="mb-0"><strong>@persona</strong></h5>
        </div>
        <div>
            @if (!ocultarSaldo)
            {
                <h5 class="mb-0">
                    Saldo:
                    @if (saldo >= 0)
                    {
                        <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                </h5>
            }
        </div>
    </div>

    <!-- =======================
         FILTROS: SOLO FECHA DESDE
         ======================= -->
    <div class="card shadow-sm mb-3 ctacte-panel-card">
        <div class="card-body">

            <form method="get"
                  action="@Url.Action("CtaCtePersona", "Finanzas")"
                  data-pos-ajax="@(desdePos ? "true" : "false")"
                  data-pos-title="Cuenta corriente">

                <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />
                <input type="hidden" name="desdePos" value="@(desdePos.ToString().ToLower())" />
                @if (desdePos)
                {
                    <input type="hidden" name="mostrarAnulados" id="mostrarAnuladosHidden" value="@(mostrarAnulados.ToString().ToLower())" />
                }
                <input type="hidden" name="returnUrl" value="@returnUrlCtaCte" />
                @if (ocultarFiltroFechaDesde)
                {
                    <input type="hidden" name="fechaDesde" value="@fechaDesde" />
                }

                <div class="d-none d-md-flex justify-content-between align-items-center ctacte-toolbar-row">
                    <div class="d-flex align-items-center ctacte-filtros-group">
                        @if (!ocultarFiltroFechaDesde)
                        {
                            <div class="input-group ctacte-fecha-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Desde</span>
                                </div>
                                <input type="date" name="fechaDesde" value="@fechaDesde" class="form-control" id="ctacteFechaDesdeDesktop" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="submit" id="btnFiltrarCtaCteDesktop">
                                        <i class="fas fa-filter"></i> Filtrar
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="custom-control custom-switch ctacte-anulados-switch">
                            @if (!desdePos)
                            {
                                <input type="checkbox"
                                       class="custom-control-input"
                                       id="chkMostrarAnulados"
                                       name="mostrarAnulados"
                                       value="true"
                                       onchange="this.form.submit();"
                                       @(mostrarAnulados ? "checked" : "") />
                            }
                            else
                            {
                                <input type="checkbox"
                                       class="custom-control-input"
                                       id="chkMostrarAnulados"
                                       @(mostrarAnulados ? "checked" : "") />
                            }
                            <label class="custom-control-label" for="chkMostrarAnulados">
                                Mostrar anulados
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center ctacte-acciones-row">
                        <a href="@Url.Action("AddOrEditPago", "Finanzas",
            new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                           class="btn btn-success mr-2"
                           id="btnNuevoPagoCtaCteDesktop"
                           data-pos-ajax="@(desdePos ? "true" : "false")"
                           data-pos-title="Pago / Cobro">
                            <i class="fas fa-plus"></i> Agregar Pago / Cobro
                        </a>

                        @if (puedeExportarCuentaCorriente)
                        {
                            <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados, desdePos = desdePos })"
                               class="btn btn-outline-danger mr-2">
                                <i class="fas fa-file-pdf"></i> PDF
                            </a>

                            <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados, desdePos = desdePos })"
                               class="btn btn-outline-success mr-2">
                                <i class="fas fa-file-excel"></i> Excel
                            </a>

                            <button type="button"
                                    class="btn btn-outline-primary ctacte-btn-mail"
                                    id="btnEnviarMailCtaCteDesktop">
                                <i class="fas fa-envelope"></i> Enviar por mail
                            </button>
                        }
                    </div>
                </div>

                <!-- BOTONES PARA MOBILE (xs - sm) -->
                <div class="d-md-none mt-3">
                    @if (!ocultarFiltroFechaDesde)
                    {
                        <div class="input-group mb-2 ctacte-filtros-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Desde</span>
                            </div>
                            <input type="date" name="fechaDesde" value="@fechaDesde" class="form-control" id="ctacteFechaDesdeMobile" />
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit" id="btnFiltrarCtaCteMobile">
                                    <i class="fas fa-filter"></i> Filtrar
                                </button>
                            </div>
                        </div>
                    }

                    <div class="custom-control custom-switch mb-3">
                        @if (!desdePos)
                        {
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="chkMostrarAnuladosMobile"
                                   name="mostrarAnulados"
                                   value="true"
                                   onchange="this.form.submit();"
                                   @(mostrarAnulados ? "checked" : "") />
                        }
                        else
                        {
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="chkMostrarAnuladosMobile"
                                   @(mostrarAnulados ? "checked" : "") />
                        }
                        <label class="custom-control-label" for="chkMostrarAnuladosMobile">
                            Mostrar anulados
                        </label>
                    </div>

                    <!-- Agregar Pago / Cobro 100% -->
                    <a href="@Url.Action("AddOrEditPago", "Finanzas",
        new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                       class="btn btn-success btn-block mb-2"
                       id="btnNuevoPagoCtaCteMobile"
                       data-pos-ajax="@(desdePos ? "true" : "false")"
                       data-pos-title="Pago / Cobro">
                        <i class="fas fa-plus"></i> Agregar Pago / Cobro
                    </a>

                    @if (puedeExportarCuentaCorriente)
                    {
                        <div class="row no-gutters">
                            <div class="col-6 pr-1">
                                <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados, desdePos = desdePos })"
                                   class="btn btn-outline-danger btn-block"
                                   target="@(desdePos ? "_blank" : "_self")">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </a>
                            </div>
                            <div class="col-6 pl-1">
                                <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados, desdePos = desdePos })"
                                   class="btn btn-outline-success btn-block"
                                   target="@(desdePos ? "_blank" : "_self")">
                                    <i class="fas fa-file-excel"></i> Excel
                                </a>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-outline-primary btn-block mt-2 ctacte-btn-mail"
                                id="btnEnviarMailCtaCteMobile">
                            <i class="fas fa-envelope"></i> Enviar por mail
                        </button>
                    }
                </div>

            </form>

        </div>
    </div>


    <!-- =======================
         TABLA COMPLETA
         ======================= -->
    <div class="card shadow-sm ctacte-panel-card">
        <div class="card-body p-2">
            @if (mostrarSoloMovimientosCajaActual)
            {
                <div class="alert alert-info py-2 px-3 mb-2">
                    Mostrando sólo los movimientos creados por el usuario actual desde la apertura de su caja.
                </div>
            }
            else if (mostrarSoloUltimosRegistros && cantidadUltimosRegistros > 0)
            {
                <div class="alert alert-info py-2 px-3 mb-2">
                    Mostrando los últimos @cantidadUltimosRegistros registros.
                </div>
            }

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-sm ctacte-table-compact" id="tablaPersona" width="100%" cellspacing="0">

                    <thead class="thead-dark">
                        <tr>

                            <!-- ID oculto -->
                            <th style="display:none;">ID</th>

                            <th @(desdePos ? "data-sort-type=\"date\" data-sort-index=\"3\"" : "")>Fecha</th>
                            <th data-sort-type="text" data-sort-index="4">Operación</th>
                            <th data-sort-type="text" data-sort-index="5">Tipo</th>
                            <th data-sort-type="text" data-sort-index="6">Nro.Doc</th>
                            <th data-sort-type="text" data-sort-index="7">Detalle</th>
                            <th data-sort-type="number" data-sort-index="8" style="text-align:right;">Importe</th>
                            <th data-sort-type="number" data-sort-index="9" style="text-align:right;">Saldo</th>
                            <th data-sort-type="text" data-sort-index="10">Sucursal</th>

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string clave = claveMovimiento(row);
                            int id = Convert.ToInt32(row["ID"]);
                            decimal importeFila = Convert.ToDecimal(row["Importe"]);
                            bool importePositivo = importeFila >= 0;
                            string claseColorOperacion = importePositivo ? "ctacte-color-positivo" : "ctacte-color-negativo";
                            string tipoImporte = importePositivo ? "Crédito" : "Débito";
                            bool tieneMasVersiones = cantidadPorClave.ContainsKey(clave) && cantidadPorClave[clave] > 1;
                            bool esVersionActual = ultimoIdPorClave.ContainsKey(clave) && ultimoIdPorClave[clave] == id;
                            bool esHistorico = tieneMasVersiones && !esVersionActual;
                            bool esPago = string.Equals(Convert.ToString(row["Tabla"]), "Pagos", StringComparison.OrdinalIgnoreCase);
                            bool mostrarAdvertenciaAdmin = tieneMasVersiones && !esPago;
                            string tablaMovimiento = Convert.ToString(row["Tabla"]);
                            int idTablaMovimiento = 0;
                            bool tieneOperacion = !string.IsNullOrWhiteSpace(tablaMovimiento)
                                && int.TryParse(Convert.ToString(row["IdTabla"]), out idTablaMovimiento)
                                && idTablaMovimiento > 0;

                            <tr
                                @if (tieneOperacion)
                                {
                                    @:onclick="verMovimientoCtaCte('@tablaMovimiento', @idTablaMovimiento)"
                                }
                                class="@(esHistorico ? "ctacte-row-historico" : "") @(mostrarAdvertenciaAdmin ? "ctacte-row-modificado" : "") @(!tieneOperacion ? "ctacte-row-sin-operacion" : "")"
                                style="cursor:@(tieneOperacion ? "pointer" : "default");">

                                <!-- ID oculto -->
                                <td name="id" style="display:none;">@row["ID"]</td>
                                <td name="tabla" style="display:none;">@row["Tabla"]</td>
                                <td name="idTabla" style="display:none;">@row["IdTabla"]</td>

                                <td>@Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy")</td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">
                                    @row["Tabla"]
                                    @if (esHistorico)
                                    {
                                        <span class="badge badge-secondary ml-1">Versión anterior</span>
                                    }
                                    else if (mostrarAdvertenciaAdmin)
                                    {
                                        <span class="badge badge-warning ml-1">Modificado</span>
                                    }
                                </td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">
                                    @tipoImporte
                                </td>
                                <td>@(tieneColumnaNroDoc ? Convert.ToString(row["NroDoc"]) : "")</td>
                                <td>
                                    [ID: @row["IdTabla"]] @row["Detalle"]
                                    @if (!tieneOperacion)
                                    {
                                        <div class="small text-muted mt-1">Sin operación asociada.</div>
                                    }
                                    @if (esHistorico && esPago)
                                    {
                                        <div class="small text-muted mt-1">Registro anterior anulado por modificación.</div>
                                    }
                                    else if (!esHistorico && mostrarAdvertenciaAdmin)
                                    {
                                        <div class="small text-warning mt-1">Verificar cambios del registro original.</div>
                                    }
                                </td>

                                <td class="@claseColorOperacion" style="text-align:right; font-weight:bold;">
                                    @importeFila.ToString("N2")
                                </td>

                                <td style="text-align:right;">
                                    @(ocultarSaldo ? "***" : Convert.ToDecimal(row["Saldo"]).ToString("N2"))
                                </td>

                                <td>@row["Sucursal"]</td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@if (puedeExportarCuentaCorriente)
{
    <div class="modal fade" id="modalEmailCtaCte" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Enviar cuenta corriente por mail</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="ccEmailFormato">Adjuntar como</label>
                        <select class="form-control" id="ccEmailFormato">
                            <option value="pdf">PDF</option>
                            <option value="excel">Excel</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="ccEmailDestino">Email destino</label>
                        <input type="email" class="form-control" id="ccEmailDestino" maxlength="200" placeholder="cliente@dominio.com">
                    </div>

                    <div class="form-group">
                        <label for="ccEmailAsunto">Asunto</label>
                        <input type="text" class="form-control" id="ccEmailAsunto" maxlength="200">
                    </div>

                    <div class="form-group mb-2">
                        <label for="ccEmailMensaje">Mensaje</label>
                        <textarea class="form-control" id="ccEmailMensaje" rows="6"></textarea>
                    </div>

                    <div class="alert alert-danger d-none mb-0" id="ccEmailError"></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" type="button" id="btnConfirmarEmailCtaCte">
                        <i class="fas fa-paper-plane mr-1"></i> Enviar mail
                    </button>
                </div>
            </div>
        </div>
    </div>
}

