<script>
    const returnUrl = '@returnUrl';
    const desdePos = @Html.Raw((desdePos ? "true" : "false"));

    function verMovimientoCtaCte(tabla, idTabla) {
        const tablaNorm = String(tabla || "").toLowerCase();
        const returnUrlEncoded = encodeURIComponent(returnUrl);

        if (tablaNorm === "ventas") {
            let urlDetalleVenta = '@Url.Action("DetalleVenta", "Ventas")'
                + '?id=' + encodeURIComponent(idTabla)
                + '&returnUrl=' + returnUrlEncoded;

            if (desdePos && window.POSFinanzas) {
                urlDetalleVenta += '&modal=true&desdePos=true';
                window.POSFinanzas.cargar(urlDetalleVenta, "Detalle de venta");
                return;
            }

            window.location.href = urlDetalleVenta;
            return;
        }

        let url = '@Url.Action("verMovimientoCtaCte", "Finanzas", new { idPersona = ViewBag.IdPersona })'
                    + '&returnUrl=' + returnUrlEncoded
                    + '&tabla=' + encodeURIComponent(tabla)
                    + '&idTabla=' + encodeURIComponent(idTabla)
                    + '&desdePos=' + desdePos;

        if (desdePos && window.POSFinanzas) {
            if (tablaNorm === "pagos") {
                window.POSFinanzas.cargarPago(url, "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        window.location.href = url;
    }
</script>
<script>
    (function () {
        function focoEnControlEditable() {
            var el = document.activeElement;
            if (!el) return false;

            var tag = (el.tagName || "").toLowerCase();
            if (tag === "textarea" || tag === "select") return true;
            if (tag !== "input") return false;

            var tipo = (el.type || "").toLowerCase();
            return tipo !== "button" && tipo !== "checkbox" && tipo !== "radio";
        }

        function abrirNuevoPagoDesdeAtajo() {
            var btn = document.getElementById("btnNuevoPagoCtaCteDesktop");
            if (!btn || btn.offsetParent === null) {
                btn = document.getElementById("btnNuevoPagoCtaCteMobile");
            }

            if (!btn) return;
            btn.click();
        }

        $(document)
            .off("change.ctacteMostrarAnulados", "#chkMostrarAnulados, #chkMostrarAnuladosMobile")
            .on("change.ctacteMostrarAnulados", "#chkMostrarAnulados, #chkMostrarAnuladosMobile", function () {
                if (!desdePos) {
                    return;
                }

                $("#mostrarAnuladosHidden").val(this.checked ? "true" : "false");

                var $form = $(this).closest("form");
                $form.trigger("submit");
            });

        $(document)
            .off("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]')
            .on("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]', function () {
                var checkedDesktop = $("#chkMostrarAnulados").is(":checked");
                var checkedMobile = $("#chkMostrarAnuladosMobile").is(":checked");
                $("#mostrarAnuladosHidden").val((checkedDesktop || checkedMobile) ? "true" : "false");
            })
            .off("keydown.ctacteNuevoPago")
            .on("keydown.ctacteNuevoPago", function (event) {
                if (!event.altKey || event.ctrlKey || event.metaKey) return;
                if (focoEnControlEditable()) return;

                var esMas =
                    event.key === "+" ||
                    event.code === "NumpadAdd" ||
                    (event.shiftKey && event.key === "=");

                if (!esMas) return;

                event.preventDefault();
                abrirNuevoPagoDesdeAtajo();
            });
    })();
</script>

<style>
    #tablaPersona .ctacte-color-positivo {
        color: green;
    }

    #tablaPersona .ctacte-color-negativo {
        color: red;
    }

    #tablaPersona td, #tablaPersona th {
        white-space: nowrap;
    }

    #tablaPersona thead th[data-sort-type] {
