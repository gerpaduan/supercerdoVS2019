@model System.Data.DataTable
@using System.Collections.Generic

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool mostrarAnulados = ViewBag.MostrarAnulados != null && (bool)ViewBag.MostrarAnulados;

    ViewBag.Title = "Cuenta Corriente";
    Layout = (desdePos || renderSinLayout) ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string persona = ViewBag.Persona.RazonSocial;
    decimal saldo = ViewBag.SaldoPersona;
    string fechaDesde = ViewBag.FechaDesde ?? "";
    string returnUrlCtaCte = ViewBag.ReturnUrlCtaCte as string ?? "";
    bool mostrarBotonVolver = !desdePos && !renderSinLayout;
    string hrefBotonVolver = !string.IsNullOrWhiteSpace(returnUrlCtaCte)
        ? returnUrlCtaCte
        : Url.Action("CtasCtes", "Finanzas");
    var returnUrl = Convert.ToBase64String(
         System.Text.Encoding.UTF8.GetBytes(Request.RawUrl)
     );

    Func<System.Data.DataRow, string> claveMovimiento = row =>
        string.Join("|",
            Convert.ToString(row["Tabla"]),
            Convert.ToString(row["IdTabla"]),
            Convert.ToString(row["Sucursal"]));

    var ultimoIdPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var cantidadPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    bool tieneColumnaNroDoc = Model != null && Model.Columns.Contains("NroDoc");

    foreach (System.Data.DataRow row in Model.Rows)
    {
        string clave = claveMovimiento(row);
        int id = Convert.ToInt32(row["ID"]);

        if (!ultimoIdPorClave.ContainsKey(clave) || id > ultimoIdPorClave[clave])
        {
            ultimoIdPorClave[clave] = id;
        }

        cantidadPorClave[clave] = cantidadPorClave.ContainsKey(clave)
            ? cantidadPorClave[clave] + 1
            : 1;
    }
}

<div id="ctactePersonaContainer" class="container-fluid px-2 px-md-3 ctacte-page ctacte-form-compact">
    <!-- =======================
         CABECERA PERSONA + SALDO
         ======================= -->
    <div class="alert alert-primary d-flex justify-content-between align-items-center ctacte-header-box">
        <div class="d-flex align-items-center">
            @if (mostrarBotonVolver)
            {
                <a href="@hrefBotonVolver" class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverCtasCtesPersona">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h5 class="mb-0"><strong>@persona</strong></h5>
        </div>
        <div>
            <h5 class="mb-0">
                Saldo:
                @if (saldo >= 0)
                {
                    <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                }
                else
                {
                    <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                }
            </h5>
        </div>
    </div>

    <!-- =======================
         FILTROS: SOLO FECHA DESDE
         ======================= -->
    <div class="card shadow-sm mb-3 ctacte-panel-card">
        <div class="card-body">

            <form method="get"
                  action="@Url.Action("CtaCtePersona", "Finanzas")"
                  data-pos-ajax="@(desdePos ? "true" : "false")"
                  data-pos-title="Cuenta corriente">

                <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />
                <input type="hidden" name="desdePos" value="@(desdePos.ToString().ToLower())" />
                @if (desdePos)
                {
                    <input type="hidden" name="mostrarAnulados" id="mostrarAnuladosHidden" value="@(mostrarAnulados.ToString().ToLower())" />
                }
                <input type="hidden" name="returnUrl" value="@returnUrlCtaCte" />

                <!-- FECHA + FILTRAR: usamos input-group para que queden SIEMPRE en la misma línea -->
                <div class="input-group mb-3 ctacte-filtros-group" style="max-width: 520px;">
                    <div class="input-group-prepend">
                        <span class="input-group-text">Desde</span>
                    </div>
                    <input type="date" name="fechaDesde" value="@fechaDesde" class="form-control" />
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-filter"></i> Filtrar
                        </button>
                    </div>

                    <div class="custom-control custom-switch">
                        @if (!desdePos)
                        {
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="chkMostrarAnulados"
                                   name="mostrarAnulados"
                                   value="true"
                                   onchange="this.form.submit();"
                                   @(mostrarAnulados ? "checked" : "") />
                        }
                        else
                        {
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="chkMostrarAnulados"
                                   @(mostrarAnulados ? "checked" : "") />
                        }
                        <label class="custom-control-label" for="chkMostrarAnulados">
                            Mostrar anulados
                        </label>
                    </div>
                </div>

                <!-- BOTONES PARA DESKTOP (md+) -->
                <div class="d-none d-md-flex justify-content-end align-items-center ctacte-acciones-row">
                    <a href="@Url.Action("AddOrEditPago", "Finanzas",
        new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                       class="btn btn-success mr-2"
                       data-pos-ajax="@(desdePos ? "true" : "false")"
                       data-pos-title="Pago / Cobro">
                        <i class="fas fa-plus"></i> Agregar Pago / Cobro
                    </a>

                    <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                       class="btn btn-outline-danger mr-2">
                        <i class="fas fa-file-pdf"></i> PDF
                    </a>

                    <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                       class="btn btn-outline-success">
                        <i class="fas fa-file-excel"></i> Excel
                    </a>
                </div>

                <!-- BOTONES PARA MOBILE (xs - sm) -->
                <div class="d-md-none mt-3">
                    <!-- Agregar Pago / Cobro 100% -->
                    <a href="@Url.Action("AddOrEditPago", "Finanzas",
        new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                       class="btn btn-success btn-block mb-2"
                       data-pos-ajax="@(desdePos ? "true" : "false")"
                       data-pos-title="Pago / Cobro">
                        <i class="fas fa-plus"></i> Agregar Pago / Cobro
                    </a>

                    <!-- PDF y EXCEL: en la misma línea, 50% cada uno -->
                    <div class="row no-gutters">
                        <div class="col-6 pr-1">
                            <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                               class="btn btn-outline-danger mr-2"
                               target="@(desdePos ? "_blank" : "_self")">
                                <i class="fas fa-file-pdf"></i> PDF
                            </a>

                        </div>
                        <div class="col-6 pl-1">
                            <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                               class="btn btn-outline-success"
                               target="@(desdePos ? "_blank" : "_self")">
                                <i class="fas fa-file-excel"></i> Excel
                            </a>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>


    <!-- =======================
         TABLA COMPLETA
         ======================= -->
    <div class="card shadow-sm ctacte-panel-card">
        <div class="card-body p-2">

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-sm ctacte-table-compact" id="tablaPersona" width="100%" cellspacing="0">

                    <thead class="thead-dark">
                        <tr>

                            <!-- ID oculto -->
                            <th style="display:none;">ID</th>

                            <th>Fecha</th>
                            <th>Operación</th>
                            <th>Tipo</th>
                            <th>Nro.Doc</th>
                            <th>Detalle</th>
                            <th style="text-align:right;">Importe</th>
                            <th style="text-align:right;">Saldo</th>
                            <th>Sucursal</th>

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string clave = claveMovimiento(row);
                            int id = Convert.ToInt32(row["ID"]);
                            decimal importeFila = Convert.ToDecimal(row["Importe"]);
                            bool importePositivo = importeFila >= 0;
                            string claseColorOperacion = importePositivo ? "ctacte-color-positivo" : "ctacte-color-negativo";
                            string tipoImporte = importePositivo ? "Crédito" : "Débito";
                            bool tieneMasVersiones = cantidadPorClave.ContainsKey(clave) && cantidadPorClave[clave] > 1;
                            bool esVersionActual = ultimoIdPorClave.ContainsKey(clave) && ultimoIdPorClave[clave] == id;
                            bool esHistorico = tieneMasVersiones && !esVersionActual;
                            bool esPago = string.Equals(Convert.ToString(row["Tabla"]), "Pagos", StringComparison.OrdinalIgnoreCase);
                            bool mostrarAdvertenciaAdmin = tieneMasVersiones && !esPago;
                            string tablaMovimiento = Convert.ToString(row["Tabla"]);
                            int idTablaMovimiento = 0;
                            bool tieneOperacion = !string.IsNullOrWhiteSpace(tablaMovimiento)
                                && int.TryParse(Convert.ToString(row["IdTabla"]), out idTablaMovimiento)
                                && idTablaMovimiento > 0;

                            <tr
                                @if (tieneOperacion)
                                {
                                    @:onclick="verMovimientoCtaCte('@tablaMovimiento', @idTablaMovimiento)"
                                }
                                class="@(esHistorico ? "ctacte-row-historico" : "") @(mostrarAdvertenciaAdmin ? "ctacte-row-modificado" : "") @(!tieneOperacion ? "ctacte-row-sin-operacion" : "")"
                                style="cursor:@(tieneOperacion ? "pointer" : "default");">

                                <!-- ID oculto -->
                                <td name="id" style="display:none;">@row["ID"]</td>
                                <td name="tabla" style="display:none;">@row["Tabla"]</td>
                                <td name="idTabla" style="display:none;">@row["IdTabla"]</td>

                                <td>@Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy")</td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">
                                    @row["Tabla"]
                                    @if (esHistorico)
                                    {
                                        <span class="badge badge-secondary ml-1">Versión anterior</span>
                                    }
                                    else if (mostrarAdvertenciaAdmin)
                                    {
                                        <span class="badge badge-warning ml-1">Modificado</span>
                                    }
                                </td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">
                                    @tipoImporte
                                </td>
                                <td>@(tieneColumnaNroDoc ? Convert.ToString(row["NroDoc"]) : "")</td>
                                <td>
                                    [ID: @row["IdTabla"]] @row["Detalle"]
                                    @if (!tieneOperacion)
                                    {
                                        <div class="small text-muted mt-1">Sin operación asociada.</div>
                                    }
                                    @if (esHistorico && esPago)
                                    {
                                        <div class="small text-muted mt-1">Registro anterior anulado por modificación.</div>
                                    }
                                    else if (!esHistorico && mostrarAdvertenciaAdmin)
                                    {
                                        <div class="small text-warning mt-1">Verificar cambios del registro original.</div>
                                    }
                                </td>

                                <td class="@claseColorOperacion" style="text-align:right; font-weight:bold;">
                                    @importeFila.ToString("N2")
                                </td>

                                <td style="text-align:right;">
                                    @Convert.ToDecimal(row["Saldo"]).ToString("N2")
                                </td>

                                <td>@row["Sucursal"]</td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<style>
    .ctacte-page {
        font-size: .9rem;
    }

    .ctacte-page .ctacte-panel-card {
        border: 1px solid #e9ecef;
        border-radius: .75rem;
    }

    .ctacte-page .ctacte-panel-card > .card-body,
    .ctacte-page .ctacte-panel-card .card-body {
        padding: .8rem .92rem;
    }

    .ctacte-page .ctacte-header-box {
        padding: .62rem .82rem;
        margin-bottom: .85rem;
        border-radius: .75rem;
    }

    .ctacte-page .ctacte-form-compact .form-control,
    .ctacte-page .ctacte-form-compact .input-group-text,
    .ctacte-page .ctacte-form-compact .btn:not(.btn-sm) {
        min-height: 2.15rem;
        font-size: .84rem;
        padding: .28rem .56rem;
        border-radius: .52rem;
    }

    .ctacte-page .ctacte-filtros-group {
        gap: .35rem;
        align-items: center;
    }

    .ctacte-page .ctacte-filtros-group .custom-control {
        margin-left: .55rem;
    }

    .ctacte-page .ctacte-acciones-row .btn {
        font-size: .82rem;
        padding: .28rem .58rem;
    }

    .ctacte-page .small,
    .ctacte-page .text-muted,
    .ctacte-page .custom-control-label {
        font-size: .76rem !important;
    }

    .ctacte-page .ctacte-table-compact {
        font-size: .82rem;
    }

    .ctacte-page .ctacte-table-compact th,
    .ctacte-page .ctacte-table-compact td {
        padding: .36rem .48rem;
        vertical-align: middle;
        line-height: 1.12;
    }

    .ctacte-page .ctacte-table-compact thead th,
    .ctacte-page .ctacte-table-compact > thead > tr > th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .ctacte-page .ctacte-table-compact .badge {
        font-size: .7rem;
    }

    @@media (min-width: 1200px) {
        .ctacte-page .ctacte-panel-card > .card-body,
        .ctacte-page .ctacte-panel-card .card-body {
            padding: .72rem .84rem;
        }

        .ctacte-page .ctacte-form-compact .form-control,
        .ctacte-page .ctacte-form-compact .input-group-text,
        .ctacte-page .ctacte-form-compact .btn:not(.btn-sm) {
            min-height: 2.02rem;
            font-size: .81rem;
            padding: .24rem .5rem;
        }

        .ctacte-page .ctacte-table-compact {
            font-size: .79rem;
        }

        .ctacte-page .ctacte-table-compact thead th,
        .ctacte-page .ctacte-table-compact > thead > tr > th {
            font-size: .69rem !important;
        }
    }
</style>

<script>
    const returnUrl = '@returnUrl';
    const desdePos = @Html.Raw((desdePos ? "true" : "false"));

    function verMovimientoCtaCte(tabla, idTabla) {
        const tablaNorm = String(tabla || "").toLowerCase();
        const returnUrlEncoded = encodeURIComponent(returnUrl);

        if (tablaNorm === "ventas") {
            let urlDetalleVenta = '@Url.Action("DetalleVenta", "Ventas")'
                + '?id=' + encodeURIComponent(idTabla)
                + '&returnUrl=' + returnUrlEncoded;

            if (desdePos && window.POSFinanzas) {
                urlDetalleVenta += '&modal=true&desdePos=true';
                window.POSFinanzas.cargar(urlDetalleVenta, "Detalle de venta");
                return;
            }

            window.location.href = urlDetalleVenta;
            return;
        }

        let url = '@Url.Action("verMovimientoCtaCte", "Finanzas", new { idPersona = ViewBag.IdPersona })'
                    + '&returnUrl=' + returnUrlEncoded
                    + '&tabla=' + encodeURIComponent(tabla)
                    + '&idTabla=' + encodeURIComponent(idTabla)
                    + '&desdePos=' + desdePos;

        if (desdePos && window.POSFinanzas) {
            if (tablaNorm === "pagos") {
                window.POSFinanzas.cargarPago(url, "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        window.location.href = url;
    }
</script>
<script>
    (function () {
        $(document)
            .off("change.ctacteMostrarAnulados", "#chkMostrarAnulados")
            .on("change.ctacteMostrarAnulados", "#chkMostrarAnulados", function () {
                if (!desdePos) {
                    return;
                }

                $("#mostrarAnuladosHidden").val(this.checked ? "true" : "false");

                var $form = $(this).closest("form");
                $form.trigger("submit");
            });

        $(document)
            .off("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]')
            .on("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]', function () {
                $("#mostrarAnuladosHidden").val($("#chkMostrarAnulados").is(":checked") ? "true" : "false");
            });
    })();
</script>

<style>
    #tablaPersona .ctacte-color-positivo {
        color: green;
    }

    #tablaPersona .ctacte-color-negativo {
        color: red;
    }

    #tablaPersona td, #tablaPersona th {
        white-space: nowrap;
    }

    #tablaPersona tr.ctacte-row-historico td {
        color: #6c757d;
        text-decoration: line-through;
        opacity: 0.8;
    }

    #tablaPersona tr.ctacte-row-modificado:not(.ctacte-row-historico) {
        background-color: #fff8e1;
    }

    #tablaPersona tr.ctacte-row-sin-operacion {
        cursor: default !important;
    }

    html.dark-mode #tablaPersona .ctacte-color-positivo,
    body.dark-mode #tablaPersona .ctacte-color-positivo {
        color: #55d88a !important;
    }

    html.dark-mode #tablaPersona .ctacte-color-negativo,
    body.dark-mode #tablaPersona .ctacte-color-negativo {
        color: #ff7f7f !important;
    }
</style>
