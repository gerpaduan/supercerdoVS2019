@model System.Data.DataTable
@using System.Collections.Generic

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool mostrarAnulados = ViewBag.MostrarAnulados != null && (bool)ViewBag.MostrarAnulados;

    ViewBag.Title = "Cuenta Corriente";
    Layout = (desdePos || renderSinLayout) ? null : "~/Views/Shared/_LayoutBase.cshtml";

    string persona = ViewBag.Persona.RazonSocial;
    decimal saldo = ViewBag.SaldoPersona;
    string fechaDesde = ViewBag.FechaDesde ?? "";
    var returnUrl = Convert.ToBase64String(
         System.Text.Encoding.UTF8.GetBytes(Request.RawUrl)
     );

    Func<System.Data.DataRow, string> claveMovimiento = row =>
        string.Join("|",
            Convert.ToString(row["Tabla"]),
            Convert.ToString(row["IdTabla"]),
            Convert.ToString(row["Sucursal"]));

    var ultimoIdPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var cantidadPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    foreach (System.Data.DataRow row in Model.Rows)
    {
        string clave = claveMovimiento(row);
        int id = Convert.ToInt32(row["ID"]);

        if (!ultimoIdPorClave.ContainsKey(clave) || id > ultimoIdPorClave[clave])
            ultimoIdPorClave[clave] = id;

        cantidadPorClave[clave] = cantidadPorClave.ContainsKey(clave)
            ? cantidadPorClave[clave] + 1
            : 1;
    }
}

<div class="container-fluid p-0" style="@(desdePos ? "display:flex; flex-direction:column;" : "height:100vh; display:flex; flex-direction:column;")">
    <!-- =======================
         CABECERA PERSONA + SALDO
         ======================= -->
    <div class="alert alert-primary d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0"><strong>@persona</strong></h5>
        </div>
        <div>
            <h5 class="mb-0">
                Saldo:
                @if (saldo >= 0)
                {
                    <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                }
                else
                {
                    <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                }
            </h5>
        </div>
    </div>

    <!-- =======================
         FILTROS: SOLO FECHA DESDE
         ======================= -->
    <div class="card shadow mb-3">
        <div class="card-body">

            <form method="get"
                  action="@Url.Action("CtaCtePersona", "Finanzas")"
                  data-pos-ajax="@(desdePos ? "true" : "false")"
                  data-pos-title="Cuenta corriente">

                <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />
                <input type="hidden" name="desdePos" value="@(desdePos.ToString().ToLower())" />
                <input type="hidden" name="mostrarAnulados" id="mostrarAnuladosHidden" value="@(mostrarAnulados.ToString().ToLower())" />

                <!-- FECHA + FILTRAR: usamos input-group para que queden SIEMPRE en la misma línea -->
                <div class="input-group mb-3" style="max-width: 520px;">
                    <div class="input-group-prepend">
                        <span class="input-group-text">Desde</span>
                    </div>
                    <input type="date" name="fechaDesde" value="@fechaDesde" class="form-control" />
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-filter"></i> Filtrar
                        </button>
                    </div>

                    <div class="custom-control custom-switch">
                        <input type="checkbox"
                               class="custom-control-input"
                               id="chkMostrarAnulados"
                               @(mostrarAnulados ? "checked" : "") />
                        <label class="custom-control-label" for="chkMostrarAnulados">
                            Mostrar anulados
                        </label>
                    </div>
                </div>

                <!-- BOTONES PARA DESKTOP (md+) -->
                <div class="d-none d-md-flex justify-content-end align-items-center">
                    <a href="@Url.Action("AddOrEditPago", "Finanzas",
        new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                       class="btn btn-success mr-2"
                       data-pos-ajax="@(desdePos ? "true" : "false")"
                       data-pos-title="Pago / Cobro">
                        <i class="fas fa-plus"></i> Agregar Pago / Cobro
                    </a>

                    <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                       class="btn btn-outline-danger mr-2">
                        <i class="fas fa-file-pdf"></i> PDF
                    </a>

                    <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                       class="btn btn-outline-success">
                        <i class="fas fa-file-excel"></i> Excel
                    </a>
                </div>

                <!-- BOTONES PARA MOBILE (xs - sm) -->
                <div class="d-md-none mt-3">
                    <!-- Agregar Pago / Cobro 100% -->
                    <a href="@Url.Action("AddOrEditPago", "Finanzas",
        new { idPersona = ViewBag.IdPersona, returnUrl = returnUrl, desdePos = desdePos })"
                       class="btn btn-success btn-block mb-2"
                       data-pos-ajax="@(desdePos ? "true" : "false")"
                       data-pos-title="Pago / Cobro">
                        <i class="fas fa-plus"></i> Agregar Pago / Cobro
                    </a>

                    <!-- PDF y EXCEL: en la misma línea, 50% cada uno -->
                    <div class="row no-gutters">
                        <div class="col-6 pr-1">
                            <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                               class="btn btn-outline-danger mr-2"
                               target="@(desdePos ? "_blank" : "_self")">
                                <i class="fas fa-file-pdf"></i> PDF
                            </a>

                        </div>
                        <div class="col-6 pl-1">
                            <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde = fechaDesde, mostrarAnulados = mostrarAnulados })"
                               class="btn btn-outline-success"
                               target="@(desdePos ? "_blank" : "_self")">
                                <i class="fas fa-file-excel"></i> Excel
                            </a>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>


    <!-- =======================
         TABLA CON SCROLL
         ======================= -->
    <div class="card shadow" style="flex:1 1 auto; overflow:hidden;">
        <div class="card-body p-2" style="height:100%; overflow:hidden;">

            <div style="height:100%; overflow-y:auto;">

                <table class="table table-bordered table-hover" id="tablaPersona" width="100%" cellspacing="0">

                    <thead class="thead-dark">
                        <tr>

                            <!-- ID oculto -->
                            <th style="display:none;">ID</th>

                            <th>Fecha</th>
                            <th>Operación</th>
                            <th>Detalle</th>
                            <th style="text-align:right;">Importe</th>
                            <th style="text-align:right;">Saldo</th>
                            <th>Sucursal</th>

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string clave = claveMovimiento(row);
                            int id = Convert.ToInt32(row["ID"]);
                            bool tieneMasVersiones = cantidadPorClave.ContainsKey(clave) && cantidadPorClave[clave] > 1;
                            bool esVersionActual = ultimoIdPorClave.ContainsKey(clave) && ultimoIdPorClave[clave] == id;
                            bool esHistorico = tieneMasVersiones && !esVersionActual;
                            bool esPago = string.Equals(Convert.ToString(row["Tabla"]), "Pagos", StringComparison.OrdinalIgnoreCase);
                            bool mostrarAdvertenciaAdmin = tieneMasVersiones && !esPago;

                            <tr onclick="verMovimientoCtaCte('@row["Tabla"]', @row["IdTabla"])"
                                class="@(esHistorico ? "ctacte-row-historico" : "") @(mostrarAdvertenciaAdmin ? "ctacte-row-modificado" : "")"
                                style="cursor:pointer;">

                                <!-- ID oculto -->
                                <td name="id" style="display:none;">@row["ID"]</td>
                                <td name="tabla" style="display:none;">@row["Tabla"]</td>
                                <td name="idTabla" style="display:none;">@row["IdTabla"]</td>

                                <td>@Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy")</td>
                                <td>
                                    @row["Tabla"]
                                    @if (esHistorico)
                                    {
                                        <span class="badge badge-secondary ml-1">Versión anterior</span>
                                    }
                                    else if (mostrarAdvertenciaAdmin)
                                    {
                                        <span class="badge badge-warning ml-1">Modificado</span>
                                    }
                                </td>
                                <td>
                                    [ID: @row["IdTabla"]] @row["Detalle"]
                                    @if (esHistorico && esPago)
                                    {
                                        <div class="small text-muted mt-1">Registro anterior anulado por modificación.</div>
                                    }
                                    else if (!esHistorico && mostrarAdvertenciaAdmin)
                                    {
                                        <div class="small text-warning mt-1">Verificar cambios del registro original.</div>
                                    }
                                </td>

                                <td style="text-align:right; color:@(Convert.ToDecimal(row["Importe"]) >= 0 ? "green" : "red"); font-weight:bold;">
                                    @Convert.ToDecimal(row["Importe"]).ToString("N2")
                                </td>

                                <td style="text-align:right;">
                                    @Convert.ToDecimal(row["Saldo"]).ToString("N2")
                                </td>

                                <td>@row["Sucursal"]</td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<script>
    const returnUrl = '@returnUrl';
    const desdePos = @Html.Raw((desdePos ? "true" : "false"));

    function verMovimientoCtaCte(tabla, idTabla) {
        const tablaNorm = String(tabla || "").toLowerCase();

        let url = '@Url.Action("verMovimientoCtaCte", "Finanzas", new { idPersona = ViewBag.IdPersona })'
                    + '&returnUrl=' + returnUrl
                    + '&tabla=' + encodeURIComponent(tabla)
                    + '&idTabla=' + encodeURIComponent(idTabla)
                    + '&desdePos=' + desdePos;

        if (desdePos && window.POSFinanzas) {
            if (tablaNorm === "pagos") {
                window.POSFinanzas.cargarPago(url, "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, "Cuenta corriente");
            return;
        }

        window.location.href = url;
    }
</script>
<script>
    (function () {
        $(document)
            .off("change.ctacteMostrarAnulados", "#chkMostrarAnulados")
            .on("change.ctacteMostrarAnulados", "#chkMostrarAnulados", function () {
                $("#mostrarAnuladosHidden").val(this.checked ? "true" : "false");
                $(this).closest("form").trigger("submit");
            });

        $(document)
            .off("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]')
            .on("submit.ctacteMostrarAnulados", 'form[action*="CtaCtePersona"]', function () {
                $("#mostrarAnuladosHidden").val($("#chkMostrarAnulados").is(":checked") ? "true" : "false");
            });
    })();
</script>

}

<style>
    #tablaPersona td, #tablaPersona th {
        white-space: nowrap;
    }

    #tablaPersona tr.ctacte-row-historico td {
        color: #6c757d;
        text-decoration: line-through;
        opacity: 0.8;
    }

    #tablaPersona tr.ctacte-row-modificado:not(.ctacte-row-historico) {
        background-color: #fff8e1;
    }
</style>
