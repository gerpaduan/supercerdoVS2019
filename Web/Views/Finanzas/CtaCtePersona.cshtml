        padding: .28rem .56rem;
        border-radius: .52rem;
    }

    .ctacte-page .ctacte-filtros-group {
        gap: .35rem;
        align-items: center;
    }

    .ctacte-page .ctacte-toolbar-row {
        gap: .75rem;
    }

    .ctacte-page .ctacte-fecha-group {
        max-width: 286px;
    }

    .ctacte-page .ctacte-fecha-group .input-group-text,
    .ctacte-page .ctacte-fecha-group .form-control,
    .ctacte-page .ctacte-fecha-group .btn {
        min-height: 1.92rem;
        font-size: .78rem;
        padding: .18rem .42rem;
    }

    .ctacte-page .ctacte-fecha-group .input-group-text {
        padding-left: .38rem;
        padding-right: .38rem;
    }

    .ctacte-page .ctacte-anulados-switch {
        margin-left: .35rem;
    }

    .ctacte-page .ctacte-anulados-switch .custom-control-label,
    .ctacte-page .custom-control.custom-switch .custom-control-label {
        color: #495057 !important;
