@{
    // Pantalla dedicada de login del operador para el modulo "Ventas" -- ver
    // VentasController.AutorizarModuloVentas y docs/DECISIONS.md ("Login de operador para el
    // modulo Ventas"). Usuario de produccion sin operador autorizado todavia: se lo trae aca en
    // vez de tapar el contenido real de Index/Lineas/DetalleVenta con un @@if -- esas vistas no
    // fueron diseñadas para tolerar un Model nulo. Al autorizar, vuelve directo a returnUrl.
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    ViewBag.Title = "Autorizar operador";
    ViewBag.Seccion = "Ventas";
    string returnUrlModulo = ViewBag.ReturnUrlModuloVentas as string ?? Url.Action("Index", "Home");
}

@Html.AntiForgeryToken()

<div class="container-fluid mt-5">
    <div class="text-center">
        <h4 class="text-primary"><i class="fas fa-user-shield mr-1"></i> Autorizate para continuar</h4>
        <p class="text-gray-500 mb-4">Esta sesión usa la cuenta de producción -- identificate con tu usuario y contraseña para ver Ventas.</p>
    </div>
</div>

@Html.Partial("~/Views/Shared/_ModalSeleccionUsuario.cshtml")

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/seleccion-usuario.js?v=2")"></script>
    <script>
        (function () {
            var usuariosActivos = @Html.Raw(Json.Encode(ViewBag.UsuariosActivosEmpresa as System.Collections.Generic.List<object> ?? new System.Collections.Generic.List<object>()));
            var urlAutorizar = '@Url.Action("AutorizarOperadorModuloVentas", "Ventas")';
            var returnUrlModulo = @Html.Raw(Json.Encode(returnUrlModulo));

            function pedirOperador() {
                window.SeleccionUsuario.abrir({
                    titulo: 'Autorizate para operar en Ventas',
                    usuarios: usuariosActivos,
                    requierePassword: true,
                    validarUrl: urlAutorizar
                }).then(function () {
                    window.location.href = returnUrlModulo;
                }).catch(function () {
                    // Cancelo el login (Escape/backdrop/"Cancelar"): sin operador no hay Ventas.
                    window.location.href = '@Url.Action("Index", "Home")';
                });
            }

            // Red de seguridad: si el modal se cierra sin resolver (ver seleccion-usuario.js,
            // su propio hidden.bs.modal), el Promise de .abrir() no se resuelve NI se rechaza --
            // sin esto el .catch() no correria nunca y la pantalla quedaria colgada.
            $(document).on('hidden.bs.modal', '#modalSeleccionUsuario', function () {
                if (!$(this).data('resuelto')) {
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });

            pedirOperador();
        })();
    </script>
}
