@model Entidades.Venta

@{
    ViewBag.Title = "Detalle Ventas";
    bool modoModal = ViewBag.ModoModal != null && (bool)ViewBag.ModoModal;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    string returnUrlDetalle = ViewBag.ReturnUrlDetalle as string ?? "";
    Layout = modoModal ? null : "~/Views/Shared/_LayoutBase.cshtml";
    var index = 1;
    bool mostrarBotonVolver = modoModal || !string.IsNullOrWhiteSpace(returnUrlDetalle);
    string hrefBotonVolver = (!modoModal && !string.IsNullOrWhiteSpace(returnUrlDetalle)) ? returnUrlDetalle : "#";
    string returnUrlPosDetalle = Url.Action("POS", "Ventas", new { abrirDetalleVentaId = Model.IdVenta, returnUrlDetalle = returnUrlDetalle });
    bool tieneFacturaVenta = ViewBag.TieneFacturaVenta != null && (bool)ViewBag.TieneFacturaVenta;
    bool tieneNotaCreditoVenta = ViewBag.TieneNotaCreditoVenta != null && (bool)ViewBag.TieneNotaCreditoVenta;
    int idNotaCreditoVenta = ViewBag.IdNotaCreditoVenta != null ? (int)ViewBag.IdNotaCreditoVenta : 0;
}

<div class="card shadow mb-4 w-100 w-md-50 @(modoModal ? "" : "mx-auto") vista-venta @(modoModal ? "vista-venta-modal" : "")">
    <!-- Encabezado -->
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            @if (mostrarBotonVolver)
            {
                <a href="@hrefBotonVolver" class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverListadoVentasDetalle">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h6 class="m-0 font-weight-bold text-primary">Detalle de Venta</h6>
        </div>
        <span class="badge badge-info">#@Model.IdVenta</span>
    </div>

    <div class="card-body bg-white">
        <!-- Cliente y forma de pago -->
        <div class="row mb-3">
            <div class="col-md-6">
                <h5 class="font-weight-bold text-dark">
                    Cliente: <span class="text-muted">@Model.Persona.razonSocial</span>
                </h5>
            </div>
            <div class="col-md-6 text-md-right">
                <h5 class="font-weight-bold text-dark">
                    <span class="text-muted">@Model.FechaVenta</span>
                </h5>
            </div>
            <div class="col-md-6">
                <h5 class="font-weight-bold text-dark">
                    Tipo Comprobante: <span class="text-muted">@Model.TipoComprobante</span>
                </h5>
            </div>
            <div class="col-md-6 text-md-right">
                <h5 class="font-weight-bold text-dark">
                    Forma de pago: <span class="text-muted">@Model.FormaPago</span>
                </h5>
            </div>
        </div>

        @if (tieneFacturaVenta || tieneNotaCreditoVenta)
        {
            <div class="alert alert-light border mb-3">
                @if (tieneFacturaVenta)
                {
                    <div><strong>Factura asociada:</strong> sí</div>
                }
                @if (tieneNotaCreditoVenta && idNotaCreditoVenta > 0)
                {
                    <div>
                        <strong>Nota de crédito asociada:</strong>
                        <a href="@Url.Action("DetalleFactura", "Ventas", new { id = idNotaCreditoVenta, returnUrl = returnUrlDetalle })">ver detalle</a>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="alert alert-light border mb-4">
                <div class="font-weight-bold text-secondary mb-1">
                    <i class="fas fa-sticky-note mr-2"></i>Comentario
                </div>
                <div class="text-dark comentario-venta">@Model.Observaciones</div>
            </div>
        }

        <div class="venta-lineas bg-white">
            @foreach (var linea in Model.LineasVenta)
            {
            <div class="mb-3">
                <!-- Nombre del producto en negrita -->
                <div>
                    #@index <strong>@linea.Corte.CorteDesc</strong> (cod: @linea.Corte.codigo)&nbsp;&nbsp;
                </div>


                <!-- Enumeración + código + detalle -->
                <div class="d-flex justify-content-between">
                    <!-- Parte izquierda -->
                    <div>
                        &nbsp;&nbsp;&nbsp;&nbsp; @linea.CantKg.ToString("0.###") x @linea.PrecioKg.ToString("C")
                    </div>

                    <!-- Parte derecha: total -->
                    <div class="text-right font-weight-bold">
                        @((linea.CantKg * linea.PrecioKg).ToString("C"))
                    </div>
                </div>
            </div>          index++;
}
        </div>

    </div>

    <!-- Total -->
    <div class="row mt-3">
        <div class="col text-right">
            <h4 class="font-weight-bold">
                Total Venta: <span class="text-success">@Model.TotalImporte.ToString("C")   </span>
            </h4>
        </div>
    </div>

    <!-- Botones -->
    <div class="row mt-4">
        <div class="col">
            @if (ViewBag.PuedeModificarVenta != null && (bool)ViewBag.PuedeModificarVenta)
            {
                <a href="@Url.Action("POS", "Ventas", new { idVentaEditar = Model.IdVenta, returnUrl = (modoModal && desdePos ? returnUrlPosDetalle : ""), returnUrlDetalle = returnUrlDetalle })"
                   class="btn btn-light btn-block text-left mb-2">
                    <i class="fas fa-edit mr-2"></i> Modificar venta
                </a>
            }
            else if (ViewBag.MotivoNoPuedeModificarVenta != null && !string.IsNullOrWhiteSpace(ViewBag.MotivoNoPuedeModificarVenta.ToString()))
            {
                <div class="alert alert-warning py-2 mb-2">
                    No se habilita "Modificar venta": @ViewBag.MotivoNoPuedeModificarVenta
                </div>
            }
            @if (ViewBag.PuedeCambiarFormaPago != null && (bool)ViewBag.PuedeCambiarFormaPago)
            {
                <a href="@Url.Action("POS", "Ventas", new { idVentaEditar = Model.IdVenta, soloFormaPago = true, returnUrl = (modoModal && desdePos ? returnUrlPosDetalle : Url.Action("DetalleVenta", "Ventas", new { id = Model.IdVenta, returnUrl = returnUrlDetalle })), returnUrlDetalle = returnUrlDetalle })"
                   class="btn btn-light btn-block text-left mb-2">
                    <i class="fas fa-sync-alt mr-2"></i> Cambiar Forma de Pago
                </a>
            }
            else if (ViewBag.MotivoNoPuedeCambiarFormaPago != null && !string.IsNullOrWhiteSpace(ViewBag.MotivoNoPuedeCambiarFormaPago.ToString()))
            {
                <div class="alert alert-warning py-2 mb-2">
                    No se habilita "Cambiar Forma de Pago": @ViewBag.MotivoNoPuedeCambiarFormaPago
                </div>
            }
            <button type="button"
                    class="btn btn-light btn-block text-left mb-2"
                    id="btnFacturaDetalleVenta">
                <i class="fas fa-file-invoice-dollar mr-2"></i> Factura
            </button>
            @*<a class="btn btn-light btn-block text-left"
               asp-controller="Ventas"
               asp-action="Imprimir"
               asp-route-id="@Model.IdVenta">
                <i class="fas fa-print mr-2"></i> Imprimir Factura
            </a>*@

            <button type="button"
                    class="btn btn-light btn-block text-left"
                    id="btnImprimirDetalleVenta"
                    title="Imprimir">
                <i class="fas fa-print mr-2"></i> Imprimir
            </button>

        </div>
    </div>

</div>

@if (!modoModal)
{
    <div class="modal fade" id="modalFacturaElectronica" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="contenedorFacturaElectronica">
            </div>
        </div>
    </div>

    @Html.Partial("~/Views/Ventas/_ModalPostVenta.cshtml")
}


<style>
    .venta-lineas {
        background-color: #fff; /* fondo blanco */
    }

        .venta-lineas .mb-3 {
            padding: .5rem 0;
            border: none; /* sin bordes */
        }

        .venta-lineas .font-weight-bold {
            margin-bottom: .25rem;
        }



    /* Solo en pantallas grandes */
    @@media (min-width: 992px) {
        .vista-venta {
            width: 60% !important;
            max-width: none; /* anula reglas de container */
            margin: 0 !important; /* elimina auto margins de Bootstrap */
            padding-left: 0;
            padding-right: 0;
        }
    }

    .vista-venta-modal {
        width: 100% !important;
        max-width: 700px;
        margin: 0 auto 1rem auto !important;
    }

    .vista-venta-modal .card-body,
    .vista-venta-modal .card-header {
        text-align: left;
    }

    .vista-venta-modal .row {
        margin-left: 0;
        margin-right: 0;
    }

    .vista-venta-modal .col {
        padding-left: 0;
        padding-right: 0;
    }

    @@media (min-width: 992px) {
        .vista-venta-modal {
            width: 100% !important;
            margin: 0 auto 1rem auto !important;
            padding-left: 0;
            padding-right: 0;
        }
    }

    .comentario-venta {
        white-space: pre-wrap;
    }
</style>

<script>
    (function () {
            function volverDetalleVenta() {
                var returnUrl = @Html.Raw(Json.Encode(returnUrlDetalle));

                if (returnUrl) {
                    if (@(modoModal && desdePos ? "true" : "false") && window.POSFinanzas && typeof window.POSFinanzas.cargar === "function") {
                        window.POSFinanzas.cargar(returnUrl, "Cuenta corriente");
                        return;
                    }

                    window.location.href = returnUrl;
                    return;
                }

                if (@(desdePos ? "true" : "false") && window.POSVentas && typeof window.POSVentas.abrirMis === "function") {
                    window.POSVentas.abrirMis();
                    return;
                }

                if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirVentas === "function") {
                    window.CajasAbiertas.abrirVentas(@idCierreActividad);
                    return;
                }

                window.history.back();
            }

            function enlazarBotonVolverDetalle() {
                var btn = document.getElementById("btnVolverListadoVentasDetalle");
                if (!btn || btn.dataset.volverDetalleBound === "true") return;

                btn.dataset.volverDetalleBound = "true";
                btn.addEventListener("click", function (event) {
                    event.preventDefault();
                    volverDetalleVenta();
                });
            }

            function enlazarBotonImprimirTicketDetalle() {
                var btn = document.getElementById("btnImprimirDetalleVenta");
                if (!btn || btn.dataset.imprimirDetalleBound === "true") return;

                btn.dataset.imprimirDetalleBound = "true";
                btn.addEventListener("click", function () {
                    if (btn.disabled) return;
                    if (!window.PostModal || typeof window.PostModal.openVenta !== "function") return;

                    window.PostModal.openVenta(@Model.IdVenta, {
                        origen: 'detalle',
                        whatsapp: @Html.Raw(Json.Encode(Model.Persona != null ? (Model.Persona.Telefono ?? "") : "")),
                        pdfUrl: '@Url.Action("Imprimir", "Ventas", new { id = Model.IdVenta })'
                    });
                });
            }

            function enlazarBotonFacturaDetalle() {
                var btn = document.getElementById("btnFacturaDetalleVenta");
                if (!btn || btn.dataset.facturaDetalleBound === "true") return;

                btn.dataset.facturaDetalleBound = "true";
                btn.addEventListener("click", function () {
                    if (!window.VentasFacturaModal || typeof window.VentasFacturaModal.abrir !== "function") {
                        if (window.Swal) {
                            Swal.fire("Factura", "No se pudo abrir el visor de factura.", "error");
                        }
                        return;
                    }

                    window.VentasFacturaModal.abrir(@Model.IdVenta, { volverAPostVenta: false });
                });
            }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", enlazarBotonVolverDetalle);
            document.addEventListener("DOMContentLoaded", enlazarBotonImprimirTicketDetalle);
            document.addEventListener("DOMContentLoaded", enlazarBotonFacturaDetalle);
        } else {
            enlazarBotonVolverDetalle();
            enlazarBotonImprimirTicketDetalle();
            enlazarBotonFacturaDetalle();
        }
    })();
</script>

@if (!modoModal)
{
    @section Scripts {
        <script src="@Url.Content("~/Scripts/app/print-agent.js?v=3")"></script>
        <script src="@Url.Content("~/Scripts/app/modal-postventa.js?v=18")"></script>
        <script src="@Url.Content("~/Scripts/app/factura-electronica.js?v=6")"></script>
    }
}
