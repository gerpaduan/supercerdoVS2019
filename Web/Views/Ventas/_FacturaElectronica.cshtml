@model Web.Models.DTO.FacturaElectronicaDTO

<!-- Modal Factura Electrónica -->
<div class="modal-header bg-success text-white py-2">
    <h6 class="modal-title">Generar Factura Electrónica</h6>
    <button type="button" class="close text-white" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<form id="formFacturaElectronica">

    <!-- ===== Hidden ===== -->
    <input type="hidden" name="IdVenta" value="@Model.IdVenta" />
    <input type="hidden" name="IdFactura" value="@Model.IdFactura" />
    <input type="hidden" name="NroCbteAfip" value="@Model.NroCbteAfip" />
    <input type="hidden" name="CAE" value="@Model.CAE" />
    <input type="hidden" name="FecVtoCAE" value="@Model.FecVtoCAE" />

    <div class="modal-body">

        <!-- ================= CLIENTE ================= -->
        <h6 class="font-weight-bold text-success">Datos del Cliente</h6>

        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Razón Social / Nombre</label>
                <input type="text" name="RazonSocialAFIP"
                       class="form-control form-control-sm"
                       value="@Model.RazonSocialAFIP">
            </div>

            <div class="col-md-3 mb-2">
                <label>Documento</label>
                <input type="text" name="NroDocAfip"
                       class="form-control form-control-sm"
                       value="@Model.NroDocAfip">
            </div>

            <div class="col-md-3 mb-2">
                <label>Condición IVA</label>
                <input type="text" name="CondicionIvaAFIP"
                       class="form-control form-control-sm"
                       value="@Model.CondicionIvaAFIP">
            </div>

            <div class="col-md-12 mb-2">
                <label>Domicilio</label>
                <input type="text" name="DomicilioAFIP"
                       class="form-control form-control-sm"
                       value="@Model.DomicilioAFIP">
            </div>

            <div class="col-md-6 mb-2">
                <label>Email</label>
                <input type="email" name="Email"
                       class="form-control form-control-sm"
                       value="@Model.Email">
            </div>

            <div class="col-md-6 mb-2">
                <label>WhatsApp</label>
                <input type="text" name="Whatsapp"
                       class="form-control form-control-sm"
                       value="@Model.Whatsapp">
            </div>
        </div>

        <!-- ================= COMPROBANTE ================= -->
        <h6 class="font-weight-bold text-success mt-3">Datos del Comprobante</h6>

        <div class="row">
            <div class="col-md-3 mb-2">
                <label>Tipo</label>
                <select name="CodTipoCbteAfip" class="form-control form-control-sm">
                    <option value="1" @(Model.CodTipoCbteAfip == 1 ? "selected" : "")>Factura A</option>
                    <option value="6" @(Model.CodTipoCbteAfip == 6 ? "selected" : "")>Factura B</option>
                    <option value="11" @(Model.CodTipoCbteAfip == 11 ? "selected" : "")>Factura C</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <label>Forma de Pago</label>
                <input type="text" name="FormaPago"
                       class="form-control form-control-sm"
                       value="@Model.FormaPago">
            </div>

            <div class="col-md-3 mb-2">
                <label>Punto de Venta</label>
                <input type="text" name="PtoVtaAfip"
                       class="form-control form-control-sm"
                       value="@Model.PtoVtaAfip">
            </div>

            <div class="col-md-3 mb-2">
                <label>Fecha</label>
                <input type="date" name="FechaEmisionAfip"
                       class="form-control form-control-sm"
                       value="@Model.FechaEmisionAfip?.ToString(" yyyy-MM-dd")">
            </div>
        </div>

        <!-- ================= IMPORTES ================= -->
        <h6 class="font-weight-bold text-success mt-3">Importes</h6>

        <div class="row">
            <div class="col-md-4 mb-2">
                <label>Neto Gravado</label>
                <input type="text" name="ImporteNetoGravado"
                       class="form-control form-control-sm text-right"
                       value="@Model.ImporteNetoGravado.ToString("0.00")">
            </div>

            <div class="col-md-4 mb-2">
                <label>IVA</label>
                <input type="text" name="Iva"
                       class="form-control form-control-sm text-right"
                       value="@Model.Iva.ToString("0.00")">
            </div>

            <div class="col-md-4 mb-2">
                <label>Total</label>
                <input type="text" name="ImporteTotal"
                       class="form-control form-control-sm text-right font-weight-bold"
                       value="@Model.ImporteTotal.ToString("0.00")">
            </div>
        </div>

        <!-- ================= DETALLE ================= -->
        <h6 class="font-weight-bold text-success mt-3">Detalle</h6>

        <div class="table-responsive border rounded">
            <table class="table table-sm table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th class="text-right">Cant</th>
                        <th class="text-right">Precio</th>
                        <th class="text-right">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Detalle)
                    {
                        <tr>
                            <td>@l.Codigo</td>
                            <td>@l.Descripcion</td>
                            <td class="text-right">@l.CantKg.ToString("0.000")</td>
                            <td class="text-right">@l.PrecioKg.ToString("0.00")</td>
                            <td class="text-right">@((l.CantKg * l.PrecioKg).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- ================= FOOTER ================= -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
            Cancelar
        </button>
        <button type="submit" class="btn btn-success btn-sm">
            <i class="fas fa-file-invoice"></i> Generar Factura
        </button>
    </div>

</form>
