<div class="modal fade" id="modalPostVenta" tabindex="-1" role="dialog" aria-hidden="true"
     data-context="venta"
     data-venta-id="0"
     data-factura-id="0"
     data-nro=""
     data-cae=""
     data-whatsapp=""
     data-pdf-url=""
     data-imprimir-payload-url=""
     data-email-config-url="@Url.Action("ObtenerDatosEmailComprobante", "Ventas")"
     data-email-send-url="@Url.Action("EnviarComprobanteEmail", "Ventas")">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">

            <!-- HEADER (sin X) -->
            <div class="modal-header bg-success text-white">
                <div class="w-100">
                    <h5 class="modal-title mb-0" id="pvModalTitle">¡Venta completada! ✔</h5>
                    <small class="d-block" id="pvModalSubTitle" style="opacity:.9; display:none;"></small>
                </div>
            </div>

            <!-- BODY -->
            <div class="modal-body text-center">

                <p class="mb-3" style="font-size:1.1rem;" id="pvPregunta">
                    ¿Qué deseas hacer ahora?
                </p>

                <!-- 1) NO IMPRIMIR -->
                <button class="btn btn-secondary btn-lg btn-block mb-2" id="btnPostVenta1" type="button">
                    <span class="badge badge-light mr-2">1</span>
                    <span id="pvLblNoImprimirBtn">No imprimir</span>
                </button>

                <!-- 2) TICKET + CAMBIAR -->
                <div class="d-flex mb-2">
                    <button class="btn btn-outline-primary btn-lg flex-grow-1 mr-2"
                            id="btnPostVenta2"
                            type="button">
                        <span class="badge badge-primary mr-2">2</span>
                        <span id="lblTicketAccion">Ticket</span>
                    </button>

                    <button class="btn btn-outline-secondary btn-lg"
                            id="btnCambiarTicket"
                            type="button"
                            title="Cambiar tamaño de ticket">
                        Cambiar
                    </button>
                </div>

                <!-- Opciones Ticket -->
                <div class="collapse mb-2" id="bloqueTicketOpciones">
                    <div class="card card-body p-2">

                        <button class="btn btn-outline-primary btn-block mb-2 btnTicketOpt"
                                id="btnTicket58"
                                type="button"
                                data-mm="58">
                            🧾 58 mm
                        </button>

                        <button class="btn btn-outline-primary btn-block btnTicketOpt"
                                id="btnTicket80"
                                type="button"
                                data-mm="80">
                            🧾 80 mm
                        </button>

                        <small class="text-muted mt-2 d-block">
                            Elegí un tamaño y se imprimirá automáticamente.
                        </small>
                    </div>
                </div>

                <!-- 3) FACTURA -->
                <button class="btn btn-info btn-lg btn-block mb-2" id="btnPostVenta3" type="button">
                    <span class="badge badge-light mr-2">3</span>
                    <span id="pvLblFacturaBtn">Factura</span>
                </button>

                <!-- 4) PDF -->
                <button class="btn btn-dark btn-lg btn-block mb-2"
                        id="btnPostVenta4"
                        type="button"
                        data-venta-pdf-url="@Url.Action("Imprimir", "Ventas")">
                    <span class="badge badge-light mr-2">4</span>
                    <span id="pvLblPdfBtn">Generar PDF</span>
                </button>

                <!-- 5) EMAIL -->
                <button class="btn btn-success btn-lg btn-block" id="btnPostVenta5" type="button">
                    <span class="badge badge-light mr-2">5</span>
                    <i class="fas fa-envelope mr-2"></i>
                    <span id="pvLblWpBtn">Enviar por email</span>
                </button>

                <div class="mt-3 pt-2 border-top text-left">
                    <div class="small text-muted mb-2" id="estadoAgenteVenta">
                        Impresión local: usando navegador.
                    </div>

                    <div class="d-flex">
                        <button class="btn btn-outline-info btn-sm flex-grow-1 mr-2" id="btnConfigurarAgenteVenta" type="button">
                            Configurar impresora
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" id="btnDescargarAgenteVenta" href="@Url.Action("DescargarAgenteImpresion", "Ventas")">
                            Descargar agente
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfigAgenteVenta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configurar impresora local</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-none" id="msgConfigAgenteVenta"></div>

                <div class="form-group">
                    <label for="cmbImpresoraAgenteVenta">Impresora</label>
                    <select class="form-control" id="cmbImpresoraAgenteVenta"></select>
                </div>

                <div class="form-group mb-0">
                    <label for="cmbMmAgenteVenta">Tamaño ticket</label>
                    <select class="form-control" id="cmbMmAgenteVenta">
                        <option value="58">58 mm</option>
                        <option value="80">80 mm</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" type="button" id="btnGuardarConfigAgenteVenta">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEmailVenta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Enviar comprobante por email</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">
                    El comprobante PDF se adjuntará automáticamente al email.
                </p>

                <div class="form-group">
                    <label for="pvEmailDestino">Email destino</label>
                    <input type="email" class="form-control" id="pvEmailDestino" maxlength="200" placeholder="cliente@dominio.com">
                </div>

                <div class="form-group">
                    <label for="pvEmailAsunto">Asunto</label>
                    <input type="text" class="form-control" id="pvEmailAsunto" maxlength="200">
                </div>

                <div class="form-group mb-2">
                    <label for="pvEmailMensaje">Mensaje</label>
                    <textarea class="form-control" id="pvEmailMensaje" rows="6"></textarea>
                </div>

                <div class="form-group mb-2 d-none" id="pvEmailAdjuntarDetalleWrap">
                    <div class="custom-control custom-switch text-left">
                        <input type="checkbox" class="custom-control-input" id="pvEmailAdjuntarDetalle">
                        <label class="custom-control-label" for="pvEmailAdjuntarDetalle">Adjuntar detalle de la venta</label>
                    </div>
                </div>

                <div class="alert alert-danger d-none mb-0" id="pvEmailError"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" type="button" id="btnConfirmarEmailVenta">
                    <i class="fas fa-paper-plane mr-1"></i> Enviar email
                </button>
            </div>
        </div>
    </div>
</div>
