                <button class="btn btn-info btn-lg btn-block mb-2" id="btnFacturaElectronica">
                    <i class="fas fa-file-invoice mr-1"></i> Factura Electrónica
                </button>

                <button class="btn btn-secondary btn-lg btn-block" id="btnNoImprimir">
                    <i class="fas fa-times mr-1"></i> No imprimir
                </button>

            </div>

        </div>
