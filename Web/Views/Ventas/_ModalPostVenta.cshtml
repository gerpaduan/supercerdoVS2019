<div class="modal fade" id="modalPostVenta" tabindex="-1" role="dialog" aria-hidden="true"
     data-context="venta"
     data-venta-id="0"
     data-factura-id="0"
     data-nro=""
     data-cae=""
     data-whatsapp=""
     data-pdf-url="">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">

            <!-- HEADER (sin X) -->
            <div class="modal-header bg-success text-white">
                <div class="w-100">
                    <h5 class="modal-title mb-0" id="pvModalTitle">¡Venta completada! ✔</h5>
                    <small class="d-block" id="pvModalSubTitle" style="opacity:.9; display:none;"></small>
                </div>
            </div>

            <!-- BODY -->
            <div class="modal-body text-center">

                <p class="mb-3" style="font-size:1.1rem;" id="pvPregunta">
                    ¿Qué deseas hacer ahora?
                </p>

                <!-- 1) NO IMPRIMIR -->
                <button class="btn btn-secondary btn-lg btn-block mb-2" id="btnPostVenta1" type="button">
                    <span class="badge badge-light mr-2">1</span>
                    No imprimir
                </button>

                <!-- 2) TICKET + CAMBIAR -->
                <div class="d-flex mb-2">
                    <button class="btn btn-outline-primary btn-lg flex-grow-1 mr-2"
                            id="btnPostVenta2"
                            type="button">
                        <span class="badge badge-primary mr-2">2</span>
                        <span id="lblTicketAccion">Ticket</span>
                    </button>

                    <button class="btn btn-outline-secondary btn-lg"
                            id="btnCambiarTicket"
                            type="button"
                            title="Cambiar tamaño de ticket">
                        Cambiar
                    </button>
                </div>

                <!-- Opciones Ticket -->
                <div class="collapse mb-2" id="bloqueTicketOpciones">
                    <div class="card card-body p-2">

                        <button class="btn btn-outline-primary btn-block mb-2 btnTicketOpt"
                                id="btnTicket58"
                                type="button"
                                data-mm="58">
                            🧾 58 mm
                        </button>

                        <button class="btn btn-outline-primary btn-block btnTicketOpt"
                                id="btnTicket80"
                                type="button"
                                data-mm="80">
                            🧾 80 mm
                        </button>

                        <small class="text-muted mt-2 d-block">
                            Elegí un tamaño y se imprimirá automáticamente.
                        </small>
                    </div>
                </div>

                <!-- 3) FACTURA -->
                <button class="btn btn-info btn-lg btn-block mb-2" id="btnPostVenta3" type="button">
                    <span class="badge badge-light mr-2">3</span>
                    <span id="pvLblFacturaBtn">Factura</span>
                </button>

                <!-- 4) PDF -->
                <button class="btn btn-dark btn-lg btn-block mb-2" id="btnPostVenta4" type="button">
                    <span class="badge badge-light mr-2">4</span>
                    <span id="pvLblPdfBtn">Generar PDF</span>
                </button>

                <!-- 5) WHATSAPP -->
                <button class="btn btn-success btn-lg btn-block" id="btnPostVenta5" type="button">
                    <span class="badge badge-light mr-2">5</span>
                    <i class="fab fa-whatsapp mr-2"></i>
                    <span id="pvLblWpBtn">Enviar a WhatsApp</span>
                </button>

            </div>
        </div>
    </div>
</div>