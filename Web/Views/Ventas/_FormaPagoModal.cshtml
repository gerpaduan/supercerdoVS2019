
<div class="modal fade" id="modalFormaPago" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-money-bill-wave"></i> Seleccione la Forma de Pago
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <!-- Pago Mixto -->
                <div class="form-group form-check mb-4">
                    <input type="checkbox"
                           class="form-check-input"
                           id="chkPagoMixto">
                    <label class="form-check-label font-weight-bold"
                           for="chkPagoMixto">
                        Pago Mixto
                    </label>
                </div>

                <!-- Botones -->
                <div class="row text-center">

                    <div class="col-4 mb-3">
                        <button class="btn btn-success btn-block btn-forma-pago"
                                data-tipo="Efectivo">
                            <i class="fas fa-money-bill"></i><br>Efectivo
                        </button>
                    </div>

                    <div class="col-4 mb-3">
                        <button class="btn btn-info btn-block btn-forma-pago"
                                data-tipo="Débito">
                            <i class="fas fa-credit-card"></i><br>Débito
                        </button>
                    </div>

                    <div class="col-4 mb-3">
                        <button class="btn btn-warning btn-block btn-forma-pago"
                                data-tipo="Crédito">
                            <i class="fas fa-credit-card"></i><br>Crédito
                        </button>
                    </div>

                    <div class="col-4 mb-3">
                        <button class="btn btn-secondary btn-block btn-forma-pago"
                                data-tipo="Cuenta Corriente">
                            <i class="fas fa-university"></i><br>Cta. Cte.
                        </button>
                    </div>

                    <div class="col-4 mb-3">
                        <button class="btn btn-dark btn-block btn-forma-pago"
                                data-tipo="QR">
                            <i class="fas fa-qrcode"></i><br>QR
                        </button>
                    </div>

                    <div class="col-4 mb-3">
                        <button class="btn btn-primary btn-block btn-forma-pago"
                                data-tipo="Transferencia">
                            <i class="fas fa-exchange-alt"></i><br>Transferencia
                        </button>
                    </div>

                </div>

                <!-- Bloque Pago Mixto -->
                <div id="bloquePagoMixto" class="border-top pt-3 mt-3" style="display:none;">

                    <div class="form-group">
                        <label>Efectivo</label>
                        <input type="number"
                               class="form-control"
                               id="montoEfectivo"
                               placeholder="Monto en efectivo">
                    </div>

                    <div class="form-group">
                        <label id="labelOtroPago">Otro Medio</label>
                        <input type="number"
                               class="form-control"
                               id="montoOtroPago"
                               placeholder="Monto">
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>
