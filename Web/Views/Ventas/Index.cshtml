@model List<Entidades.Venta>


@{
    ViewBag.Title = "Ventas";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    // Valores por defecto si el modelo viene vacío
    var fechaHoy = DateTime.Now.ToString("yyyy-MM-dd");
}


<div class="container-fluid  p-0 vista-venta">

    <!-- Filtro por fechas, sucursal y búsqueda rápida -->
    <div class="card mb-3 shadow-sm p-3 buscador-card filtros-ventas-card">
        <form id="formFiltroFechas" method="get" action="@Url.Action("Index")" class="w-100">
            <div class="filtros-ventas-stack">
                <div class="filtros-fila filtros-fila-fechas">
                    <div class="form-group mb-0">
                        <label for="fechaDesde" class="filtro-label">Desde</label>
                        <input type="datetime-local"
                               id="fechaDesde"
                               name="fechaDesde"
                               class="form-control"
                               value="@(string.IsNullOrEmpty(Request["fechaDesde"])
? DateTime.Today.ToString("yyyy-MM-ddTHH:mm")
: Request["fechaDesde"])" />
                        @Html.Partial("~/Views/Shared/_AdvertenciaPermisoFecha.cshtml")
                    </div>

                    <div class="form-group mb-0">
                        <label for="fechaHasta" class="filtro-label">Hasta</label>
                        <input type="datetime-local"
                               id="fechaHasta"
                               name="fechaHasta"
                               class="form-control"
                               value="@(string.IsNullOrEmpty(Request["fechaHasta"])
? DateTime.Today.ToString("yyyy-MM-ddT23:59")
: Request["fechaHasta"])" />
                    </div>

                    <div class="form-group mb-0 filtro-accion">
                        <label class="filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit"
                                id="btnFiltrarFechas"
                                class="btn btn-primary btn-block"
                                disabled>
                            Aplicar
                        </button>
                    </div>
                </div>

                <div class="filtros-fila filtros-fila-sucursal">
                    <div class="form-group mb-0 filtro-sucursal">
                        <label for="idSucursal" class="filtro-label">Sucursal</label>
                        <select id="idSucursal" name="idSucursal" class="form-control"
                                onchange="this.form.submit()">
                            <option value="">Todas las sucursales</option>

                            @foreach (var s in ViewBag.Sucursales)
                            {
                                <option value="@s.IdSucursal"
                                        @(ViewBag.IdSucursalSeleccionada == s.IdSucursal ? "selected" : "")>
                                    @s.SucursalNombre
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="filtros-fila filtros-fila-busqueda">
                    <div class="form-group mb-0">
                        <label for="buscadorVendedor" class="filtro-label">Vendedor</label>
                        <input type="text"
                               id="buscadorVendedor"
                               class="form-control"
                               placeholder="Nombre del vendedor" />
                    </div>

                    <div class="form-group mb-0">
                        <label for="buscadorCliente" class="filtro-label">Cliente</label>
                        <input type="text"
                               id="buscadorCliente"
                               class="form-control"
                               placeholder="Nombre o identificación" />
                    </div>

                    <div class="form-group mb-0">
                        <label for="btnFiltroFormaPago" class="filtro-label">Forma de pago</label>
                        <div class="dropdown w-100 filtro-forma-pago-dropdown" id="filtroFormaPagoDropdown">
                            <button class="btn btn-light btn-block text-left filtro-forma-pago-btn"
                                    type="button"
                                    id="btnFiltroFormaPago"
                                    data-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <span id="filtroFormaPagoTexto">Todas las formas de pago</span>
                                <span id="filtroFormaPagoBadge" class="badge badge-primary d-none ml-2">0</span>
                                <i class="fas fa-chevron-down float-right mt-1 text-muted"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right w-100 filtro-forma-pago-menu p-2"
                                 aria-labelledby="btnFiltroFormaPago">
                                <button type="button" class="dropdown-item filtro-forma-pago-clear px-2" id="btnLimpiarFormaPago">
                                    Todas las formas de pago
                                </button>
                                <div class="dropdown-divider my-2"></div>
                                @foreach (Entidades.Venta.FormaPagoEnum fp
                                        in Enum.GetValues(typeof(Entidades.Venta.FormaPagoEnum)))
                                {
                                    var formaPagoNombre = fp.ToString();
                                    <label class="dropdown-item filtro-forma-pago-item px-2 mb-0">
                                        <input type="checkbox"
                                               class="mr-2 chk-forma-pago"
                                               value="@formaPagoNombre"
                                               data-label="@formaPagoNombre" />
                                        <span>@formaPagoNombre</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>



    <!-- 🧮 Total del período -->

    @if (ViewBag.TotalFiltrado != null)
    {
        <div class="card mb-2 shadow-sm" style="padding: 6px 10px;">
            <div class="d-flex justify-content-between">
                <h5 id="cantFiltrado" class="text-muted m-0" style="font-weight: 500;">
                    Cant.: @Model.Count
                </h5>

                @*<h5 class="text-muted m-0" style="font-weight: 500;">
                        Total: @(( (decimal)ViewBag.TotalFiltrado ).ToString("C"))
                    </h5>*@
                <h5 id="totalFiltrado" class="text-muted m-0" style="font-weight: 500;">
                    Total: @(((decimal)ViewBag.TotalFiltrado).ToString("C"))
                </h5>

            </div>
        </div>
    }

    <!-- 🧾 Listado de ventas -->
    <div class="card shadow-sm ventas-card w-100">
        <div class="card-body p-0">
            @{
                ViewBag.ModoModalVentas = false;
                ViewBag.DetalleVentaBaseUrl = Url.Action("DetalleVenta", "Ventas");
            }
            @Html.Partial("~/Views/Ventas/_TablaVentas.cshtml", Model)
        </div>
    </div>
</div>

@section Scripts {

    <!-- Select2 (después de jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>

        $(document).ready(function () {

            const $form = $('#formFiltroFechas');

            if ($form.length === 0) {
                console.warn('formFiltroFechas NO encontrado');
                return;
            }

            const $fechaDesde = $('#fechaDesde');
            const $fechaHasta = $('#fechaHasta');
            const $btnFiltrar = $('#btnFiltrarFechas');

            const fechaDesdeInicial = $fechaDesde.val();
            const fechaHastaInicial = $fechaHasta.val();

            function fechasValidas() {
                if (!$fechaDesde.val() || !$fechaHasta.val()) return false;
                return new Date($fechaDesde.val()) <= new Date($fechaHasta.val());
            }

            function verificarCambios() {
                const cambio =
                    $fechaDesde.val() !== fechaDesdeInicial ||
                    $fechaHasta.val() !== fechaHastaInicial;

                const valido = fechasValidas();

                $fechaDesde.toggleClass('is-invalid', !valido);
                $fechaHasta.toggleClass('is-invalid', !valido);

                $btnFiltrar.prop('disabled', !(cambio && valido));
            }

            $fechaDesde.on('change input', verificarCambios);
            $fechaHasta.on('change input', verificarCambios);

            $form.on('submit', function (e) {
                if (!fechasValidas()) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });

        });

        const buscadorCliente = document.getElementById("buscadorCliente");
        const buscadorVendedor = document.getElementById("buscadorVendedor");
        const filtroFormaPagoChecks = Array.from(document.querySelectorAll(".chk-forma-pago"));
        const filtroFormaPagoTexto = document.getElementById("filtroFormaPagoTexto");
        const filtroFormaPagoBadge = document.getElementById("filtroFormaPagoBadge");
        const btnLimpiarFormaPago = document.getElementById("btnLimpiarFormaPago");
        const ventas = document.querySelectorAll(".venta-item");

        function getFormasPagoSeleccionadas() {
            return filtroFormaPagoChecks
                .filter(chk => chk.checked)
                .map(chk => (chk.value || "").toLowerCase());
        }

        function actualizarResumenFormaPago() {
            const seleccionadas = filtroFormaPagoChecks.filter(chk => chk.checked);
            const cantidad = seleccionadas.length;

            if (cantidad === 0) {
                filtroFormaPagoTexto.textContent = "Todas las formas de pago";
                filtroFormaPagoBadge.classList.add("d-none");
                return;
            }

            if (cantidad === 1) {
                filtroFormaPagoTexto.textContent = seleccionadas[0].dataset.label || seleccionadas[0].value || "Forma de pago";
                filtroFormaPagoBadge.classList.add("d-none");
                return;
            }

            filtroFormaPagoTexto.textContent = "Forma de pago";
            filtroFormaPagoBadge.textContent = cantidad.toString();
            filtroFormaPagoBadge.classList.remove("d-none");
        }

        function aplicarFiltros() {

            const textoCliente = (buscadorCliente?.value || "").toLowerCase();
            const textoVendedor = (buscadorVendedor?.value || "").toLowerCase();
            const formasPagoSeleccionadas = getFormasPagoSeleccionadas();

            let total = 0;
            let cant = 0;

            ventas.forEach(v => {

                const cliente = (v.dataset.cliente || "").toLowerCase();
                const identificacion = (v.dataset.identificacion || "").toLowerCase();
                const vendedor = (v.dataset.vendedor || "").toLowerCase();
                const formaPago = (v.dataset.formaPago || "").toLowerCase();

                const coincideCliente =
                    !textoCliente ||
                    cliente.includes(textoCliente) ||
                    identificacion.includes(textoCliente);

                const coincideVendedor =
                    !textoVendedor ||
                    vendedor.includes(textoVendedor);

                const coincideFormaPago =
                    formasPagoSeleccionadas.length === 0 ||
                    formasPagoSeleccionadas.includes(formaPago);

                const mostrar =
                    coincideCliente &&
                    coincideVendedor &&
                    coincideFormaPago;

                v.style.display = mostrar ? "" : "none";

                if (mostrar) {
                    const valor = parseFloat(
                        v.querySelector(".importe")?.dataset.valor || 0
                    );
                    total += valor;
                    cant++;
                }
            });

            // actualizar total
            document.getElementById("totalFiltrado").textContent =
                "Total: " + total.toLocaleString("es-AR", {
                    style: "currency",
                    currency: "ARS"
                });

            document.getElementById("cantFiltrado").textContent = "Cant: " + cant.toString();

            // mostrar / ocultar mensaje "No hay coincidencias"
            document.querySelectorAll(".fecha-grupo").forEach(f => {
                const tieneVentas = Array.from(
                    f.nextElementSibling?.parentNode.children || []
                ).some(li => li.classList.contains("venta-item") && li.style.display !== "none");

                f.style.display = tieneVentas ? "" : "none";
            });
        }

        buscadorCliente?.addEventListener("input", aplicarFiltros);
        buscadorVendedor?.addEventListener("input", aplicarFiltros);
        filtroFormaPagoChecks.forEach(chk => {
            chk.addEventListener("change", function () {
                actualizarResumenFormaPago();
                aplicarFiltros();
            });
        });

        btnLimpiarFormaPago?.addEventListener("click", function (e) {
            e.preventDefault();
            filtroFormaPagoChecks.forEach(chk => {
                chk.checked = false;
            });
            actualizarResumenFormaPago();
            aplicarFiltros();
        });

        document.querySelector(".filtro-forma-pago-menu")?.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        actualizarResumenFormaPago();

    </script>
}


<style>
    /* Mantengo tus estilos actuales */
    .venta-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        padding: 10px 15px;
    }

    .venta-icono {
        flex: 0 0 auto;
        margin-right: 10px;
    }

    .venta-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Estilo general para escritorio */
    .venta-tipo-persona {
        word-wrap: break-word; /* permite cortar palabras largas */
        /*overflow-wrap: break-word*/; /* asegura compatibilidad */
        white-space: normal;
    }

    /* En pantallas pequeñas (celulares) */
    @@media (max-width: 576px) {
        .venta-tipo-persona {
            max-width: 17ch;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }
    }

    .venta-id {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .venta-obs {
        font-size: 0.8rem;
        color: #4f5d75;
        margin-top: .15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 30rem;
    }

    .venta-total {
        text-align: right;
        flex: 0 0 auto;
    }

        .venta-total .importe {
            font-weight: bold;
            color: #28a745;
        }

    .venta-item:hover {
        background-color: #f8f9fc;
    }

    .filtros-ventas-card {
        border: 1px solid #e9ecef;
        border-radius: .75rem;
    }

    .filtros-ventas-stack {
        display: grid;
        gap: .85rem;
    }

    .filtros-fila {
        display: grid;
        gap: .85rem;
    }

    .filtro-label {
        font-size: .85rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .35rem;
    }

    .filtros-ventas-card .form-control {
        min-height: 2.65rem;
        border-radius: .55rem;
    }

    .filtros-ventas-card .btn {
        min-height: 2.65rem;
        border-radius: .55rem;
    }

    .filtro-forma-pago-btn {
        border: 1px solid #ced4da;
        background: #fff;
        color: #495057;
        font-weight: 400;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .filtro-forma-pago-btn:focus,
    .filtro-forma-pago-btn:hover {
        background: #fff;
        color: #495057;
    }

    .filtro-forma-pago-menu {
        max-height: 320px;
        overflow-y: auto;
        border-radius: .7rem;
        box-shadow: 0 .35rem 1rem rgba(0, 0, 0, .12);
    }

    .filtro-forma-pago-item {
        display: flex;
        align-items: center;
        cursor: pointer;
        border-radius: .45rem;
    }

    .filtro-forma-pago-item:hover,
    .filtro-forma-pago-clear:hover {
        background-color: #f8f9fc;
    }

    /* Solo en pantallas grandes */
    @@media (min-width: 992px) {
        .vista-venta {
            width: 60%;
            max-width: none; /* anula reglas de container */
            margin: 0 !important; /* elimina auto margins de Bootstrap */
            padding-left: 0;
            padding-right: 0;
        }
    }

    @@media (min-width: 1200px) {
        .filtros-fila-fechas {
            grid-template-columns: 1.15fr 1.15fr 140px;
            align-items: end;
        }

        .filtro-sucursal {
            max-width: 420px;
        }

        .filtros-fila-busqueda {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }

    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .filtros-fila-fechas,
        .filtros-fila-busqueda {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filtro-accion {
            grid-column: 2;
        }

        .filtros-fila-sucursal {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .filtros-fila {
            grid-template-columns: 1fr;
        }
    }
</style>
