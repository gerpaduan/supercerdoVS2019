@model List<Entidades.Venta>

@{
    ViewBag.Title = "Ventas";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
}

<div class="container-fluid p-0">

    <!-- 🔍 Buscador y filtros -->
    <div class="card mb-3 shadow-sm buscador-card w-100">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center filters">
            <div class="flex-grow-1 mr-3 mb-2 w-100 w-md-auto">
                <input type="text" id="buscador" class="form-control w-100" placeholder="Buscar cliente, operación o tipo de venta..." />
            </div>

            <div class="filters d-flex flex-wrap align-items-center w-100 w-md-auto">
                <select id="periodo" class="form-control mr-2 mb-2 w-100 w-md-auto">
                    <option value="">Período</option>
                    <option value="hoy">Hoy</option>
                    <option value="ayer">Ayer</option>
                    <option value="semana">Últimos 7 días</option>
                    <option value="mes">Últimos 30 días</option>
                </select>

                <select id="estado" class="form-control mr-2 mb-2 w-100 w-md-auto">
                    <option value="">Estado</option>
                    <option value="pagado">Pagado</option>
                    <option value="pendiente">Pendiente</option>
                    <option value="cancelado">Cancelado</option>
                </select>

                <select id="formaPago" class="form-control mr-2 mb-2 w-100 w-md-auto" multiple>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Debito">Débito</option>
                    <option value="Credito">Crédito</option>
                    <option value="Qr">QR</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="CtaCte">Cuenta Corriente</option>
                </select>

                <select id="tipoComprobante" class="form-control mb-2 w-100 w-md-auto" multiple>
                    <option value="X">X</option>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 🧾 Listado -->
    <div class="card shadow-sm ventas-card w-100">
        <div class="card-body p-0">
            <ul id="listaVentas" class="list-group list-group-flush">
                @foreach (var ventaAgrupada in Model.GroupBy(v => v.FechaVenta.Date))
                {
                    <li class="list-group-item bg-light font-weight-bold">
                        @ventaAgrupada.Key.ToString("dd/MM/yyyy")
                    </li>

                    @foreach (var venta in ventaAgrupada)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center venta-item flex-wrap w-100">
                            <div class="d-flex align-items-center mb-2 mb-md-0">
                                <div class="icono mr-3">
                                    @if (!string.IsNullOrEmpty(venta.FormaPago) && venta.FormaPago.ToLower().Contains("qr"))
                                    {
                                        <i class="fas fa-qrcode fa-2x text-primary"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-mobile-alt fa-2x text-secondary"></i>
                                    }
                                </div>
                                <div>
                                    <div class="font-weight-bold">@venta.TipoComprobante - @venta.FormaPago</div>
                                    <div class="text-muted small">idVenta @venta.IdVenta</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-success font-weight-bold">+ @venta.TotalImporte.ToString("C")</div>
                                <div class="text-muted small">@venta.FechaVenta.ToString("HH:mm") hs</div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>

<script>
    const buscador = document.getElementById("buscador");
    const lista = document.getElementById("listaVentas");
    const filas = lista.querySelectorAll(".venta-item");

    buscador.addEventListener("input", () => {
        const texto = buscador.value.toLowerCase();
        filas.forEach(fila => {
            const contenido = fila.textContent.toLowerCase();
            fila.style.display = contenido.includes(texto) ? "" : "none";
        });
    });
</script>

<style>
    .filters select {
        min-width: 130px;
    }

    select[multiple] {
        height: 80px;
    }

    .venta-item:hover {
        background-color: #f8f9fc;
    }

    .icono i {
        width: 32px;
        text-align: center;
    }

    /* ✅ Estilo responsive */
    @@media (max-width: 768px) {
        .buscador-card,
        .ventas-card {
            border-radius: 0;
            box-shadow: none;
            margin: 0;
        }

        .card-body {
            padding: 10px !important;
        }

        .filters {
            flex-direction: column !important;
            align-items: stretch !important;
        }

            .filters select,
            #buscador {
                width: 100% !important;
                margin-right: 0 !important;
            }

        .container-fluid {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    }
</style>
