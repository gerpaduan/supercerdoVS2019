@model List<Entidades.Venta>


@{
    ViewBag.Title = "Ventas";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    // Valores por defecto si el modelo viene vacío
    var fechaHoy = DateTime.Now.ToString("yyyy-MM-dd");
}


<div class="container-fluid  p-0 vista-venta">

    <!-- 🗓 Filtro por fechas y Sucursal -->
    <div class="card mb-3 shadow-sm p-3">
        <form id="formFiltroFechas" method="get" action="@Url.Action("Index")" class="w-100">

            <!-- ⭐ FILA 1: Fechas + Botón -->
            <div class="form-inline mb-3">

                <div class="form-group mr-3">
                    <label for="fechaDesde" class="mr-1">Desde:</label>
                    <input type="datetime-local"
                           id="fechaDesde"
                           name="fechaDesde"
                           class="form-control"
                           value="@(string.IsNullOrEmpty(Request["fechaDesde"])
? DateTime.Today.ToString("yyyy-MM-ddTHH:mm")
: Request["fechaDesde"])" />
                </div>

                <div class="form-group mr-3">
                    <label for="fechaHasta" class="mr-1">Hasta:</label>
                    <input type="datetime-local"
                           id="fechaHasta"
                           name="fechaHasta"
                           class="form-control"
                           value="@(string.IsNullOrEmpty(Request["fechaHasta"])
? DateTime.Today.ToString("yyyy-MM-ddT23:59")
: Request["fechaHasta"])" />
                </div>

                <button type="submit"
                        id="btnFiltrarFechas"
                        class="btn btn-primary"
                        disabled>
                    Filtrar fechas
                </button>
            </div>

            <!-- ⭐ FILA 2: Sucursal y Cliente -->
            <div class="form-inline">

                <!-- Sucursal -->
                <div class="form-group mr-3">
                    @*<label for="idSucursal" class="mr-1">Sucursal:</label>*@
                    <select id="idSucursal" name="idSucursal" class="form-control"
                            onchange="this.form.submit()">
                        <option value="">— Sucursal (todas) —</option>

                        @foreach (var s in ViewBag.Sucursales)
                        {
                            <option value="@s.IdSucursal"
                                    @(ViewBag.IdSucursalSeleccionada == s.IdSucursal ? "selected" : "")>
                                @s.SucursalNombre
                            </option>
                        }
                    </select>
                </div>
                <!-- Vendedor -->
                <div class="form-group mr-3">

                    <input type="text"
                           id="buscadorVendedor"
                           class="form-control"
                           placeholder="Buscar vendedor..." />
                </div>

                <!-- Cliente -->
                <div class="form-group mr-3">
                    <input type="text" id="buscadorCliente" class="form-control"
                           placeholder="Buscar cliente..." />
                </div>

                <!-- Forma de pago -->
                <div class="form-group mr-3">
                    <select id="formaPago"
                            name="formaPago"
                            class="form-control">
                        <option value="">— Forma de pago (todas) —</option>

                        @foreach (Entidades.Venta.FormaPagoEnum fp
                                in Enum.GetValues(typeof(Entidades.Venta.FormaPagoEnum)))
                        {
                            <option value="@fp.ToString()">
                                @fp.ToString()
                            </option>
                        }

                    </select>
                </div>



            </div>

        </form>
    </div>



    <!-- 🧮 Total del período -->

    @if (ViewBag.TotalFiltrado != null)
    {
        <div class="card mb-2 shadow-sm" style="padding: 6px 10px;">
            <div class="d-flex justify-content-between">
                <h5 id="cantFiltrado" class="text-muted m-0" style="font-weight: 500;">
                    Cant.: @Model.Count
                </h5>

                @*<h5 class="text-muted m-0" style="font-weight: 500;">
                        Total: @(( (decimal)ViewBag.TotalFiltrado ).ToString("C"))
                    </h5>*@
                <h5 id="totalFiltrado" class="text-muted m-0" style="font-weight: 500;">
                    Total: @(((decimal)ViewBag.TotalFiltrado).ToString("C"))
                </h5>

            </div>
        </div>
    }

    <!-- 🧾 Listado de ventas -->
    <div class="card shadow-sm ventas-card w-100">
        <div class="card-body p-0">
            <ul id="listaVentas" class="list-group list-group-flush">
                @if (Model.Count == 0)
                {
                    <li class="list-group-item text-center text-muted py-4">
                        <i class="fas fa-search fa-2x mb-2"></i><br />
                        No hay coincidencias
                    </li>
                }
                @foreach (var ventaAgrupada in Model.GroupBy(v => v.FechaVenta.Date))
                {
                    if (ventaAgrupada.Any())   // ✅ solo imprime si hay ventas
                    {
                        <li class="list-group-item bg-light font-weight-bold fecha-grupo">
                            @ventaAgrupada.Key.ToString("dd/MM/yyyy")
                        </li>

                        foreach (var venta in ventaAgrupada)
                        {
                            <li class="list-group-item venta-item"
                                data-forma-pago="@venta.FormaPago.ToString()"
                                data-cliente="@venta.Persona.razonSocial"
                                data-identificacion="@venta.Persona.Identificacion"
                                data-vendedor="@venta.Vendedor.Nombre.ToLower()"
                                onclick="location.href='@Url.Action("DetalleVenta","Ventas", new { id = venta.IdVenta })'">
                                <div class="venta-icono">
                                    @if (!string.IsNullOrEmpty(venta.FormaPago))
                                    {
                                        switch (venta.FormaPago.ToLower())
                                        {
                                            case "efectivo":
                                                <i class="fas fa-money-bill-wave fa-2x text-success"></i>
                                                break;
                                            case "qr":
                                                <i class="fas fa-qrcode fa-2x text-primary"></i>
                                                break;
                                            case "debito":
                                            case "credito":
                                                <i class="fas fa-credit-card fa-2x text-info"></i>
                                                break;
                                            case "ctacte":
                                                <i class="fas fa-university fa-2x text-warning"></i>
                                                break;
                                            case "transferencia":
                                                <i class="fas fa-exchange-alt fa-2x text-secondary"></i>
                                                break;
                                            default:
                                                <i class="fas fa-money-check fa-2x text-muted"></i>
                                                break;
                                        }
                                    }
                                </div>

                                <div class="venta-info">
                                    <div class="venta-tipo-persona font-weight-bold">
                                        @venta.TipoComprobante - @venta.FormaPago
                                    </div>
                                    @if (!@Entidades.Persona.esConsumidorFinal(@venta.Persona))
                                    {
                                        <div class="venta-tipo-persona font-weight-bold">
                                            a @venta.Persona.razonSocial
                                        </div>
                                    }
                                    <div class="venta-id">Caja: @venta.Vendedor.Nombre</div>
                                    <div class="venta-id">idVenta @venta.IdVenta</div>
                                </div>

                                <div class="venta-total">
                                    <div class="importe @(venta.TotalImporte <= 0 ? "text-danger font-weight-bold" : "")"
                                         data-valor="@venta.TotalImporte">
                                        @((venta.TotalImporte > 0 ? "+ " : "") + venta.TotalImporte.ToString("C"))
                                    </div>

                                    <div class="text-muted small">
                                        @venta.FechaVenta.ToString("HH:mm") hs
                                    </div>
                                </div>
                            </li>
                        }
                    }
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {

    <!-- Select2 (después de jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>

        $(document).ready(function () {

            const $form = $('#formFiltroFechas');

            if ($form.length === 0) {
                console.warn('formFiltroFechas NO encontrado');
                return;
            }

            const $fechaDesde = $('#fechaDesde');
            const $fechaHasta = $('#fechaHasta');
            const $btnFiltrar = $('#btnFiltrarFechas');

            const fechaDesdeInicial = $fechaDesde.val();
            const fechaHastaInicial = $fechaHasta.val();

            function fechasValidas() {
                if (!$fechaDesde.val() || !$fechaHasta.val()) return false;
                return new Date($fechaDesde.val()) <= new Date($fechaHasta.val());
            }

            function verificarCambios() {
                const cambio =
                    $fechaDesde.val() !== fechaDesdeInicial ||
                    $fechaHasta.val() !== fechaHastaInicial;

                const valido = fechasValidas();

                $fechaDesde.toggleClass('is-invalid', !valido);
                $fechaHasta.toggleClass('is-invalid', !valido);

                $btnFiltrar.prop('disabled', !(cambio && valido));
            }

            $fechaDesde.on('change input', verificarCambios);
            $fechaHasta.on('change input', verificarCambios);

            $form.on('submit', function (e) {
                if (!fechasValidas()) {
                    e.preventDefault();
                    return false;
                }
                return true;
            });

        });

        const buscadorCliente = document.getElementById("buscadorCliente");
        const buscadorVendedor = document.getElementById("buscadorVendedor");
        const filtroFormaPago = document.getElementById("formaPago");
        const ventas = document.querySelectorAll(".venta-item");

        function aplicarFiltros() {

            const textoCliente = (buscadorCliente?.value || "").toLowerCase();
            const textoVendedor = (buscadorVendedor?.value || "").toLowerCase();
            const formaPagoSel = (filtroFormaPago?.value || "").toLowerCase();

            let total = 0;
            let cant = 0;
            let algunaVisible = false;

            ventas.forEach(v => {

                const cliente = (v.dataset.cliente || "").toLowerCase();
                const identificacion = (v.dataset.identificacion || "").toLowerCase();
                const vendedor = (v.dataset.vendedor || "").toLowerCase();
                const formaPago = (v.dataset.formaPago || "").toLowerCase();

                const coincideCliente =
                    !textoCliente ||
                    cliente.includes(textoCliente) ||
                    identificacion.includes(textoCliente);

                const coincideVendedor =
                    !textoVendedor ||
                    vendedor.includes(textoVendedor);

                const coincideFormaPago =
                    !formaPagoSel ||
                    formaPago === formaPagoSel;

                const mostrar =
                    coincideCliente &&
                    coincideVendedor &&
                    coincideFormaPago;

                v.style.display = mostrar ? "" : "none";

                if (mostrar) {
                    algunaVisible = true;

                    const valor = parseFloat(
                        v.querySelector(".importe")?.dataset.valor || 0
                    );
                    total += valor;
                    cant++;
                }
            });

            // actualizar total
            document.getElementById("totalFiltrado").textContent =
                "Total: " + total.toLocaleString("es-AR", {
                    style: "currency",
                    currency: "ARS"
                });

            document.getElementById("cantFiltrado").textContent = "Cant: " + cant.toString();

            // mostrar / ocultar mensaje "No hay coincidencias"
            document.querySelectorAll(".fecha-grupo").forEach(f => {
                const tieneVentas = Array.from(
                    f.nextElementSibling?.parentNode.children || []
                ).some(li => li.classList.contains("venta-item") && li.style.display !== "none");

                f.style.display = tieneVentas ? "" : "none";
            });
        }

        buscadorCliente?.addEventListener("input", aplicarFiltros);
        buscadorVendedor?.addEventListener("input", aplicarFiltros);
        filtroFormaPago?.addEventListener("change", aplicarFiltros);

    </script>
}


<style>
    /* Mantengo tus estilos actuales */
    .venta-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        padding: 10px 15px;
    }

    .venta-icono {
        flex: 0 0 auto;
        margin-right: 10px;
    }

    .venta-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Estilo general para escritorio */
    .venta-tipo-persona {
        word-wrap: break-word; /* permite cortar palabras largas */
        /*overflow-wrap: break-word*/; /* asegura compatibilidad */
        white-space: normal;
    }

    /* En pantallas pequeñas (celulares) */
    @@media (max-width: 576px) {
        .venta-tipo-persona {
            max-width: 17ch;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }
    }

    .venta-id {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .venta-total {
        text-align: right;
        flex: 0 0 auto;
    }

        .venta-total .importe {
            font-weight: bold;
            color: #28a745;
        }

    .venta-item:hover {
        background-color: #f8f9fc;
    }

    /* Solo en pantallas grandes */
    @@media (min-width: 992px) {
        .vista-venta {
            width: 60%;
            max-width: none; /* anula reglas de container */
            margin: 0 !important; /* elimina auto margins de Bootstrap */
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>
