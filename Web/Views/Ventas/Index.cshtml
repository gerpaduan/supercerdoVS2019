@model List<Entidades.Venta>

@{
    ViewBag.Title = "Ventas";
    Layout = "~/Views/Shared/_LayoutBase.cshtml";

    // Valores por defecto si el modelo viene vacío
    var fechaHoy = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid p-0">

    <!-- 🗓 Filtro por fechas y Sucursal -->
    <div class="card mb-3 shadow-sm p-3">
        <form method="get" action="@Url.Action("Index")" class="w-100">

            <!-- ⭐ FILA 1: Fechas + Botón -->
            <div class="form-inline mb-3">

                <div class="form-group mr-3">
                    <label for="fechaDesde" class="mr-1">Desde:</label>
                    <input type="date" id="fechaDesde" name="fechaDesde" class="form-control"
                           value="@(string.IsNullOrEmpty(Request["fechaDesde"]) ? fechaHoy : Request["fechaDesde"])" />
                </div>

                <div class="form-group mr-3">
                    <label for="fechaHasta" class="mr-1">Hasta:</label>
                    <input type="date" id="fechaHasta" name="fechaHasta" class="form-control"
                           value="@(string.IsNullOrEmpty(Request["fechaHasta"]) ? fechaHoy : Request["fechaHasta"])" />
                </div>

                <button type="submit"
                        id="btnFiltrarFechas"
                        class="btn btn-secondary"
                        disabled>
                    Filtrar fechas
                </button>
            </div>

            <!-- ⭐ FILA 2: Sucursal y Cliente -->
            <div class="form-inline">

                <!-- Sucursal -->
                <div class="form-group mr-3">
                    <label for="idSucursal" class="mr-1">Sucursal:</label>
                    <select id="idSucursal" name="idSucursal" class="form-control"
                            onchange="this.form.submit()">
                        <option value="">— Todas —</option>

                        @foreach (var s in ViewBag.Sucursales)
                        {
                            <option value="@s.IdSucursal"
                                    @(ViewBag.IdSucursalSeleccionada == s.IdSucursal ? "selected" : "")>
                                @s.SucursalNombre
                            </option>
                        }
                    </select>
                </div>

                <!-- Cliente -->
                <div class="form-group flex-grow-1">
                    <input type="text" id="buscadorCliente" class="form-control w-100"
                           placeholder="Buscar cliente..." />
                </div>

            </div>

        </form>
    </div>



    <!-- 🧮 Total del período -->

    @if (ViewBag.TotalFiltrado != null)
    {
        <div class="card mb-2 shadow-sm" style="padding: 6px 10px;">
            <div class="text-right m-0">
                <h5 class="text-muted" style="font-weight: 500; margin: 0;">
                    Total: @(( (decimal)ViewBag.TotalFiltrado ).ToString("C"))
                </h5>
            </div>
        </div>
    }

    <!-- 🧾 Listado de ventas -->
    <div class="card shadow-sm ventas-card w-100">
        <div class="card-body p-0">
            <ul id="listaVentas" class="list-group list-group-flush">
                @if (Model.Count == 0)
                {
                    <li class="list-group-item text-center text-muted py-4">
                        <i class="fas fa-search fa-2x mb-2"></i><br />
                        No hay coincidencias
                    </li>
                }
                @foreach (var ventaAgrupada in Model.GroupBy(v => v.FechaVenta.Date))
                {
                    <li class="list-group-item bg-light font-weight-bold">
                        @ventaAgrupada.Key.ToString("dd/MM/yyyy")
                    </li>

                    foreach (var venta in ventaAgrupada)
                    {
                        <li class="list-group-item venta-item" data-cliente="@venta.Persona.razonSocial">
                            <div class="venta-icono">
                                @if (!string.IsNullOrEmpty(venta.FormaPago))
                                {
                                    switch (venta.FormaPago.ToLower())
                                    {
                                        case "efectivo":
                                            <i class="fas fa-money-bill-wave fa-2x text-success"></i>
                                            break;
                                        case "qr":
                                            <i class="fas fa-qrcode fa-2x text-primary"></i>
                                            break;
                                        case "debito":
                                        case "credito":
                                            <i class="fas fa-credit-card fa-2x text-info"></i>
                                            break;
                                        case "ctacte":
                                            <i class="fas fa-university fa-2x text-warning"></i>
                                            break;
                                        case "transferencia":
                                            <i class="fas fa-exchange-alt fa-2x text-secondary"></i>
                                            break;
                                        default:
                                            <i class="fas fa-money-check fa-2x text-muted"></i>
                                            break;
                                    }
                                }
                            </div>

                            <div class="venta-info">
                                <div class="venta-tipo-persona font-weight-bold">
                                    @venta.TipoComprobante - @venta.FormaPago
                                </div>
                                @if (!@Entidades.Persona.esConsumidorFinal(@venta.Persona))
                                {
                                    <div class="venta-tipo-persona font-weight-bold">
                                        a @venta.Persona.razonSocial
                                    </div>
                                }
                                <div class="venta-id">Caja: @venta.Vendedor.Nombre</div>
                                <div class="venta-id">idVenta @venta.IdVenta</div>
                            </div>

                            <div class="venta-total">
                                <div class="importe">+ @venta.TotalImporte.ToString("C")</div>
                                <div class="text-muted small">@venta.FechaVenta.ToString("HH:mm") hs</div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>


<script>
    const buscador = document.getElementById("buscador");
    const lista = document.getElementById("listaVentas");
    const filas = lista.querySelectorAll(".venta-item");

    buscador?.addEventListener("input", () => {
        const texto = buscador.value.toLowerCase();
        filas.forEach(fila => {
            const contenido = fila.textContent.toLowerCase();
            fila.style.display = contenido.includes(texto) ? "" : "none";
        });
    });


    const buscadorCliente = document.getElementById("buscadorCliente");
    const ventas = document.querySelectorAll(".venta-item");

    buscadorCliente.addEventListener("input", () => {
        const texto = buscadorCliente.value.toLowerCase();

        ventas.forEach(v => {
            const cliente = (v.dataset.cliente || "").toLowerCase();
            v.style.display = cliente.includes(texto) ? "" : "none";
        });
    });

    const fechaDesde = document.getElementById("fechaDesde");
    const fechaHasta = document.getElementById("fechaHasta");
    const btnFiltrar = document.getElementById("btnFiltrarFechas");

    // Guardar valores originales
    const fechaDesdeInicial = fechaDesde.value;
    const fechaHastaInicial = fechaHasta.value;

    function verificarCambios() {
    const modificado =
    (fechaDesde.value !== fechaDesdeInicial) ||
    (fechaHasta.value !== fechaHastaInicial);

    if (modificado) {
        btnFiltrar.disabled = false;
    btnFiltrar.classList.remove("btn-secondary");
    btnFiltrar.classList.add("btn-primary");
    } else {
        btnFiltrar.disabled = true;
    btnFiltrar.classList.remove("btn-primary");
    btnFiltrar.classList.add("btn-secondary");
    }
}

    fechaDesde.addEventListener("change", verificarCambios);
    fechaHasta.addEventListener("change", verificarCambios);
</script>

<style>
    /* Mantengo tus estilos actuales */
    .venta-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        padding: 10px 15px;
    }

    .venta-icono {
        flex: 0 0 auto;
        margin-right: 10px;
    }

    .venta-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    .venta-tipo-persona {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .venta-id {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .venta-total {
        text-align: right;
        flex: 0 0 auto;
    }

        .venta-total .importe {
            font-weight: bold;
            color: #28a745;
        }

    .venta-item:hover {
        background-color: #f8f9fc;
    }
</style>
