@model Entidades.FacturaElectronica
@* Partial: Modal Factura Electrónica (SB Admin 2 style) *@

<div class="modal fade" id="modalFacturaElectronica" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Factura electrónica</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="row gx-2">
                    <div class="col-12 mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong id="fe-letra-num">-</strong>
                                <div class="text-muted small" id="fe-tipo-desc">-</div>
                            </div>
                            <div class="text-end">
                                <div class="small text-muted">Punto de venta</div>
                                <div id="fe-ptovta" class="fw-bold">-</div>
                                <div class="small text-muted">Nº comprobante</div>
                                <div id="fe-nro" class="fw-bold">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <table class="table table-sm mb-2">
                            <tbody>
                                <tr>
                                    <th class="w-25">Fecha emisión</th>
                                    <td id="fe-fecha">-</td>
                                    <th>CAE</th>
                                    <td id="fe-cae">-</td>
                                </tr>
                                <tr>
                                    <th>Vto. CAE</th>
                                    <td id="fe-vto-cae">-</td>
                                    <th>Condición IVA</th>
                                    <td id="fe-cond-iva">-</td>
                                </tr>
                                <tr>
                                    <th>Tipo Doc.</th>
                                    <td id="fe-tipo-doc">-</td>
                                    <th>Nº Doc.</th>
                                    <td id="fe-nro-doc">-</td>
                                </tr>
                                <tr>
                                    <th>Razón social</th>
                                    <td id="fe-razon" colspan="3">-</td>
                                </tr>
                                <tr>
                                    <th>Domicilio</th>
                                    <td id="fe-domicilio" colspan="3">-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-12">
                        <div class="row gx-2">
                            <div class="col-sm-4">
                                <div class="card border-0 bg-light p-2">
                                    <div class="small text-muted">Neto gravado</div>
                                    <div id="fe-neto" class="h5 m-0">$ 0,00</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="card border-0 bg-light p-2">
                                    <div class="small text-muted">IVA</div>
                                    <div id="fe-iva" class="h5 m-0">$ 0,00</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="card border-0 bg-light p-2">
                                    <div class="small text-muted">Total</div>
                                    <div id="fe-total" class="h4 m-0 text-primary">$ 0,00</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel Nota de Crédito (se muestra condicionalmente) -->
                    <div class="col-12 mt-3 d-none" id="fe-panel-notacredito">
                        <div class="card border-warning">
                            <div class="card-header bg-warning text-dark">
                                Nota de Crédito
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <label class="form-label small">Motivo</label>
                                    <input id="fe-nc-motivo" class="form-control" placeholder="Motivo nota de crédito" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Importe a bonificar</label>
                                    <input id="fe-nc-importe" class="form-control text-end" placeholder="0.00" inputmode="decimal" />
                                </div>
                                <div class="text-end">
                                    <button id="fe-aplicar-nc" class="btn btn-outline-warning">Generar Nota de Crédito</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <div class="me-auto text-muted small" id="fe-idventa">Id venta: -</div>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                <button id="fe-imprimir" type="button" class="btn btn-primary">
                    <i class="fas fa-print me-2"></i>Imprimir / Descargar
                </button>
            </div>
        </div>
    </div>
</div>

<script>(function () {
  // Rellenar modal con datos. opts may include: model (object) OR fields, showNotaCredito (bool), printUrl (string)
  window.abrirFacturaElectronicaModal = function (opts) {
    opts = opts || {};
    var data = opts.model || {};
    // Normalizar strings
    var t = function (v) { return (v === null || typeof v === 'undefined' || v === '') ? '-' : v; };
    // Fechas
    var fecha = data.FechaEmisionAfip ? new Date(data.FechaEmisionAfip).toLocaleString('es-AR') : t(data.FechaEmisionAfip);
    $('#fe-fecha').text(fecha);
    $('#fe-ptovta').text(t(data.PtoVtaAfip));
    $('#fe-nro').text(t(data.NroCbteAfip));
    $('#fe-cae').text(t(data.CAE1));
    $('#fe-vto-cae').text(t(data.FecVtoCAE));
    $('#fe-tipo-doc').text(t(data.TipoDocAfip));
    $('#fe-nro-doc').text(t(data.NroDocAfip));
    $('#fe-razon').text(t(data.RazonSocialAFIP));
    $('#fe-cond-iva').text(t(data.CondicionIvaAFIP));
    $('#fe-domicilio').text(t(data.DomicilioAFIP));
    $('#fe-neto').text(formatMoney(data.ImporteNetoGravado));
    $('#fe-iva').text(formatMoney(data.Iva));
    $('#fe-total').text(formatMoney(data.ImporteTotal));
    $('#fe-letra-num').text(getLetraYNumero(data));
    $('#fe-tipo-desc').text(t(data.DescTipoCbteAfip));
    $('#fe-idventa').text('Id venta: ' + (data.IdVenta || '-'));

    // Nota de credito: mostrar solo si explicitado y factura existente (Id > 0)
    var showNC = Boolean(opts.showNotaCredito) && (data.Id && data.Id > 0);
    if (showNC) {
      $('#fe-panel-notacredito').removeClass('d-none');
    } else {
      $('#fe-panel-notacredito').addClass('d-none');
    }

    // Abrir modal
    $('#modalFacturaElectronica').modal('show');

    // almacenar print url override en el botón
    var printUrl = opts.printUrl || (window.api && window.api.venta && window.api.venta.imprimir) || '@Url.Action("ImprimirTicket", "Ventas")';
    $('#fe-imprimir').off('click').on('click', function () {
      // si hay Id o NroCbte, abrir la URL con parámetros
      var id = data.Id || data.IdVenta || '';
      var nro = data.NroCbteAfip || '';
      var url = printUrl;
      if (id) {
        url += (url.indexOf('?') === -1 ? '?' : '&') + 'id=' + encodeURIComponent(id);
      } else if (nro) {
        url += (url.indexOf('?') === -1 ? '?' : '&') + 'nro=' + encodeURIComponent(nro);
      }
      // fallback: si la URL está vacía, mostrar log
      if (!url) {
        console.warn('No se indicó URL de impresión');
        return;
      }
      window.open(url, '_blank');
    });

    // Generar NC handler (debe enviar a tu backend; aquí solo dispara evento)
    $('#fe-aplicar-nc').off('click').on('click', function () {
      var motivo = $('#fe-nc-motivo').val().trim();
      var importe = parseFloat(String($('#fe-nc-importe').val()).replace(',', '.')) || 0;
      if (!motivo || importe <= 0) {
        Swal.fire({ icon: 'warning', title: 'Datos incompletos', text: 'Ingrese motivo e importe válido' });
        return;
      }
      // publica evento para que quien use el partial haga la petición Ajax
      $(document).trigger('factura:generarNotaCredito', [{ factura: data, motivo: motivo, importe: importe }]);
      $('#modalFacturaElectronica').modal('hide');
    });
  };

  function formatMoney(v) {
    try {
      if (v == null || v === '') return '$ 0,00';
      var n = parseFloat(String(v).replace(',', '.'));
      if (isNaN(n)) return '$ 0,00';
      return '$ ' + n.toFixed(2).replace('.', ',');
    } catch (e) { return '$ 0,00'; }
  }

  function getLetraYNumero(d) {
    var letra = (d && d.CodTipoCbteAfip) ? (function (c) {
      switch (parseInt(c, 10)) {
        case 1: case 3: return 'A';
        case 6: case 8: return 'B';
        case 11: case 13: return 'C';
        default: return '';
      }
    })(d.CodTipoCbteAfip) : '';
    var nro = d && d.NroCbteAfip ? d.NroCbteAfip : '';
    return (letra ? letra + ' ' : '') + nro;
  }

})();</script>