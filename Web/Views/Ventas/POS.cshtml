@model Entidades.Venta

@{ ViewBag.Title = "CarniSys web | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";
}



<!-- Vista: Punto de Venta (CSHTML) - SB Admin 2 estilo -->
<div class="container-fluid p-2" id="pos-app">

    <div class="card shadow-lg border-0">

        <button class="btn btn-sm btn-light me-2" id="btn-toggle-fullscreen">Pantalla completa</button>
        <div class="card-body" style="min-height:600px;">
            <div class="row h-100">

                <!-- ===================== -->
                <!-- LISTA DE PRODUCTOS / CARRITO -->
                <!-- ===================== -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="card shadow mb-3">
                        <div class="card-body p-2">

                            <table class="table table-sm tabla-productos">
                                <tbody id="tablaItems">

                                    <!-- Estado vacío -->
                                    <tr id="filaVacia">
                                        <td class="text-muted text-center py-3">
                                            No hay productos agregados
                                        </td>
                                    </tr>

                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>


                <!--  Interacción / lector -->
                <div class="col-lg-6 d-flex flex-column">
                    <!-- ====================== -->
                    <!--   CÓDIGO DE PRODUCTO   -->
                    <!-- ====================== -->
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">
                                    <i class="fas fa-barcode"></i>
                                </span>

                                <!-- ESTE INPUT ES EL TUYO ORIGINAL -->
                                <input type="text" id="inputCodigo" class="form-control"
                                       placeholder="Esperando lectura..." autocomplete="off" autofocus />

                                <!-- Botón para abrir modal de digitar -->
                                <button class="btn btn-outline-secondary"
                                        id="btnAgregarManual"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDigitarCodigo">
                                    Digitar
                                </button>
                            </div>
                        </div>
                    </div>


                    <!-- ====================== -->
                    <!--   INFO DEL PRODUCTO   -->
                    <!-- ====================== -->
                    <div id="producto-info" class="p-3 rounded bg-light border">

                        <!-- Nombre y Precio -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 id="prodNombre" class="fw-bold text-muted m-0">Info producto...</h4>
                            <div id="prodPrecio" class="fw-bold text-muted m-0"></div>
                        </div>

                        <!-- Cantidad y Subtotal -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="w-50 me-2">
                                <label class="form-label">Cantidad / Peso (kg)</label>
                                <input type="text" id="inputCantidad" class="form-control form-control-lg" disabled />
                            </div>

                            <div class="text-end w-50">
                                <label class="form-label d-block">Subtotal</label>
                                <h4 id="prodSubtotal" class="fw-bold text-muted m-0">$ 0,00</h4>
                            </div>
                        </div>

                        <!-- Botón agregar -->
                        <button id="btnAgregarProducto" class="btn btn-success btn-lg w-100" disabled>
                            ➕ Agregar a la venta
                        </button>

                    </div>



                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="m-0">Subtotal</h3>
                            <h2 id="lblSubtotal" class="m-0">$ 0,00</h2>
                        </div>

                        <div class="text-end">
                            <button class="btn btn-warning btn-lg me-2">Frutas y Frescos</button>
                            <button class="btn btn-info btn-lg me-2" id="btn-comentario">Ingresar Comentario</button>
                            <button class="btn btn-success btn-lg" id="btnFinalizar">Finalizar y Pagar</button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="row g-2">
                            <div class="col-4">
                                <button class="btn btn-outline-danger w-100" id="btnCancelarItem">Cancelar ítem</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-outline-secondary w-100" id="btnLimpiar">Limpiar</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-outline-primary w-100" id="btnAyuda">Ayuda</button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <small class="text-muted">Conexión balanza: <span id="estadoBalanza">Desconocida</span></small>
                        <div class="progress mt-1" style="height:8px;">
                            <div id="barraBalanza" class="progress-bar" role="progressbar" style="width:0%"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- MODAL: DIGITAR CÓDIGO -->
<div class="modal fade" id="modalDigitarCodigo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Digitar código</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input id="txtCodigoManual" class="form-control form-control-lg text-center mb-3" placeholder="Ingrese código" />
                <div class="row g-2">
                    @{ for (int r = 1; r <= 9; r++)
                        { <text>
                                <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">@r</button></div>
                        </text>;
                    } }
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3" id="key-back">←</button></div>
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">0</button></div>
                    <div class="col-4"><button class="btn btn-success w-100 py-3" id="key-ok">OK</button></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PESABLE: muestra cuando un producto es por kg -->
<div class="modal fade" id="modalPesable" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Producto Pesable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div>Ingrese peso o use la balanza</div>
                <input id="txtPesoPesable" class="form-control form-control-lg text-center my-2" />
                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" id="btnAgregarPesable">Agregar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        let typingTimer = null;
        let productoSeleccionado = null;
        let precioActual = 0;

        // ================================
        // BÚSQUEDA EN VIVO
        // ================================
        $("#inputCodigo").on("keyup", function () {
            let cod = $(this).val().trim();
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => terminarEscritura(cod), 250);
        });

        function terminarEscritura(codigo) {

            if (codigo === "") {
                mostrarEsperando();
                return;
            }

            $.ajax({
                url: "/Ventas/BuscarProducto",
                method: "GET",
                data: { codigo: codigo },

                success: function (data) {
                    if (!data || data.error) {
                        mostrarSinCoincidencia();
                        return;
                    }

                    mostrarProducto(data);
                    productoSeleccionado = data;
                },

                error: function () {
                    mostrarSinCoincidencia();
                }
            });
        }

        // --------------------------------------------------------------------
        //  ESTADOS DEL PANEL
        // --------------------------------------------------------------------

        // PRODUCTO ENCONTRADO
        function mostrarProducto(p) {

            $("#prodNombre")
                .text(p.nombre)
                .removeClass("text-muted")
                .addClass("fw-bold");

            $("#prodPrecio")
                .text("$ " + p.precioKg.toLocaleString("es-AR"))
                .removeClass("text-muted")
                .addClass("fw-bold");

            precioActual = p.precioKg;

            $("#inputCantidad")
                .prop("disabled", false)
                //.val(p.pesable ? obtenerPesoBalanza() : "")
                .focus();

            $("#prodSubtotal").text("$ 0,00");
            calcularSubtotal();

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // NO HAY COINCIDENCIA
        function mostrarSinCoincidencia() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Sin coincidencia")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio")
                .text("")
                .addClass("text-muted");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // ESTADO INICIAL
        function mostrarEsperando() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Esperando código…")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio").text("");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // --------------------------------------------------------------------
        // CALCULAR SUBTOTAL EN VIVO
        // --------------------------------------------------------------------
        $("#inputCantidad").on("input", calcularSubtotal);

        function calcularSubtotal() {

            let cant = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cant) || cant <= 0 || precioActual <= 0) {
                $("#prodSubtotal").text("$ 0,00");
                $("#btnAgregarProducto").prop("disabled", true);
                return;
            }

            let subtotal = cant * precioActual;

            $("#prodSubtotal").text(
                "$ " + subtotal.toLocaleString("es-AR", {
                    minimumFractionDigits: 2
                })
            );

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // ====================================================
        // BUSCAR PRODUCTO (ya lo usás)
        // ====================================================
        function seleccionarProducto(data) {
            productoSeleccionado = data;
        }

        // ====================================================
        // AGREGAR CUANDO PRESIONA ENTER EN CANTIDAD
        // ====================================================
        $("#inputCantidad").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                agregarProducto();
            }
        });

        $("#btnAgregarProducto").on("click", function () {
            agregarProducto();
        });

        // ====================================================
        // FUNCIÓN PRINCIPAL PARA AGREGAR
        // ====================================================
        function agregarProducto() {

            if (!productoSeleccionado) {
                alert("Selecciona un producto primero");
                return;
            }

            let cantidad = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cantidad) || cantidad <= 0) {
                alert("Cantidad inválida");
                return;
            }

            $.ajax({
                url: "/Ventas/AgregarProducto",
                method: "POST",
                data: {
                    idCorte: productoSeleccionado.id,
                    cantidadKg: cantidad
                },
                success: function (r) {

                    if (!r.ok) {
                        alert(r.error ?? "Error al agregar");
                        return;
                    }

                    renderTablaProductos(r.lineas);

                    // limpiar campos
                    $("#inputCodigo").val("").focus();
                    $("#inputCantidad").val("");
                    $("#prodSubtotal").text("$ 0,00");

                    productoSeleccionado = null;
                }
            });
        }

        // ====================================================
        // RENDER DE LA TABLA (mantiene tu diseño)
        // ====================================================
        function renderTablaProductos(lineas) {

            let tbody = $("#tablaItems");
            tbody.empty();

            if (!lineas || lineas.length === 0) {
                tbody.append(`
                <tr id="filaVacia">
                    <td class="text-muted text-center py-3">
                        No hay productos agregados
                    </td>
                </tr>
            `);
                return;
            }

            lineas.forEach(l => {
                tbody.append(`
                <tr data-id="${l.index}" class="fila-item">
                    <td>
                        <div class="fw-bold">
                            #${l.index} <strong>${l.producto}</strong> (cod: ${l.codigo})
                        </div>

                        <div class="d-flex justify-content-between item-detalle">
                            <span>${l.cant} x ${l.precio}</span>
                            <span class="fw-bold">${l.subtotal}</span>
                        </div>
                    </td>
                </tr>
            `);
            });
        }

        // Fullscreen toggle
        document.getElementById('btn-toggle-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
        });

    </script>
}

<style>
    .fila-item {
        cursor: pointer;
    }

        .fila-item:hover {
            background: #f2f2f2;
        }

    .tabla-productos td {
        border: none;
        padding-bottom: 1rem;
        padding-top: 0.5rem;
    }

    .item-detalle {
        font-size: 0.95rem;
        color: #444;
    }
</style>