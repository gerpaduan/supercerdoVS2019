    .fila-item {
        cursor: pointer;
    }

        .fila-item:hover {
            background: #f2f2f2;
        }

    .tabla-productos td {
        border: none;
        padding-bottom: 1rem;
        padding-top: 0.5rem;
    }

    .item-detalle {
        font-size: 0.95rem;
        color: #444;
    }


    .keyboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 60px);
        gap: 8px;
    }

    /* Botones normales */
    .btn-key {
        height: 100%;
        font-size: 1.2rem;
        font-weight: 600;
    }

    /* ENTER ocupa 2 filas */
    .btn-enter {
        grid-row: span 2;
        font-size: 1.1rem;
        font-weight: bold;
    }

    /* El 0 ocupa 2 columnas */
    .key-zero {
        grid-column: span 2;
    }


    /* Línea delicada de separación vertical */
    .key-separator {
        border-left: 1px solid rgba(0, 0, 0, 0.1);
        padding-left: 8px;
    }

    /* ===== BOTÓN POS ===== */
    .btn-agregar-pos {
        height: 56px;
        white-space: nowrap; /* NO se parte */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 10px;
    }
    /* Ajuste en pantallas chicas */
    @@media (max-width: 576px) {
        .btn-key,
        .btn-enter {
            font-size: 1.2rem;
            padding: 14px 0;
        }

        .btn-agregar-pos {
            height: 52px; /* misma sensación táctil */
            font-size: 1rem;
        }
    }
</style>
