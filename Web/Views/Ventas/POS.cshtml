            // ocultar botones
            $("#btnEliminarItem").addClass("d-none");
            $("#btnMostrarBonificar").addClass("d-none");
        });


        $("#chkPorcentaje").change(function () {

            const activo = this.checked;

            $("#txtPorcentaje").prop("disabled", !activo).val("");
            $("#txtPrecioKg").prop("readonly", activo);

            if (activo)
                $("#txtPorcentaje").focus();
            else
                $("#txtPrecioKg").focus().select();
        });

        $("#btnAplicarBonificacion").click(function () {

            let precioNuevo = parseFloat($("#txtPrecioKg").val().replace(",", "."));
            if (isNaN(precioNuevo) || precioNuevo <= 0) {
                alert("Precio inválido");
                return;
            }

            lineaSeleccionada.precio = `$ ${precioNuevo.toFixed(2)}`;

            const subtotal = precioNuevo * parseFloat(lineaSeleccionada.cant);
            lineaSeleccionada.subtotal = `$ ${subtotal.toFixed(2)}`;

            const bonificacion = parseFloat(
                $("#txtPorcentaje").val().replace(",", ".")
            ) || 0;

            lineaSeleccionada.bonificacion = bonificacion;

            //renderTablaProductos(carrito);

            const r = {
                ok: true,
                lineas: carrito
            };

            // mismo flujo que AJAX success
            renderTablaProductos(r.lineas);
            recalcularTotal();

            $("#modalLineaVenta").modal("hide");
        });

        $("#chkPorcentaje").on("change", function () {

            const porModo = $(this).is(":checked");

            $("#txtPorcentaje").prop("readonly", !porModo);
            $("#txtPrecioKg").prop("readonly", porModo);

            if (porModo) {
                $("#txtPorcentaje").focus();
                $("#lblTipoPorcentaje").text("% bonificacion (- para recargo)");
            } else {
                $("#txtPrecioKg").focus();
                $("#lblTipoPorcentaje").text("% bonificación");
            }
        });

        $("#txtPrecioKg").on("input", function () {

            if ($("#chkPorcentaje").is(":checked")) return;

            const precioOriginal = parseFloat($("#modalPrecio").data("precio"));
            const precioNuevo = parseFloat($(this).val().replace(",", "."));
            const cantidad = parseFloat($("#modalCantidad").val().replace(",", "."));

            if (isNaN(precioNuevo) || precioNuevo <= 0 || isNaN(precioOriginal)) {
                $("#txtPorcentaje").val("");
                $("#modalSubtotal").val("");
                return;
            }

            let porcentaje = (1 - (precioNuevo / precioOriginal)) * 100;
            porcentaje = Math.round(porcentaje * 100) / 100;

            $("#txtPorcentaje").val(porcentaje);

            if (porcentaje > 0) {
                $("#lblTipoPorcentaje").text("% bonificación");
            } else if (porcentaje < 0) {
                $("#lblTipoPorcentaje").text("% recargo");
            } else {
                $("#lblTipoPorcentaje").text("%");
            }

            $("#modalSubtotal").val((precioNuevo * cantidad).toFixed(2));
        });


        $("#txtPorcentaje").on("input", function () {

            if (!$("#chkPorcentaje").is(":checked")) return;

            const precioOriginal = parseFloat($("#modalPrecio").data("precio"));
            const porcentaje = parseFloat($(this).val().replace(",", "."));
            const cantidad = parseFloat($("#modalCantidad").val().replace(",", "."));

            if (isNaN(precioOriginal) || isNaN(porcentaje) || isNaN(cantidad)) {
                $("#txtPrecioKg").val("");
                $("#modalSubtotal").val("");
                return;
            }

            // determinar si es bonificación o recargo
            const tipo = -1;//(porcentaje < 0) ? -1 : 1;
            const precioNuevo = precioOriginal * (1 + ((porcentaje * tipo) / 100));
            const subtotal = precioNuevo * cantidad;

            $("#txtPrecioKg").val(precioNuevo.toFixed(2));
            $("#modalSubtotal").val(subtotal.toFixed(2));
        });


        $("#btnEliminarItem").click(function () {

            if (!confirm("¿Eliminar el producto?")) return;

            const idx = carrito.findIndex(l => l.index === lineaSeleccionada.index);

            if (idx !== -1) {
                carrito[idx].anulado = true;
            }

            const r = {
                ok: true,
                lineas: carrito
            };

            // mismo flujo que AJAX success
            renderTablaProductos(r.lineas);

            recalcularTotal();

            $("#modalLineaVenta").modal("hide");

            // limpiar campos
            $("#inputCodigo").val("").focus();
        });

        /////////////
        ///FIN MODAL LINEA VENTA
        ////////////


        // URLs generadas por MVC (seguras para cualquier entorno)
        window.api = window.api || {};

        window.api.venta = {
            finalizar: '@Url.Action("FinalizarVenta", "Ventas")',
            imprimir: '@Url.Action("ImprimirTicket", "Ventas")',
        };

        window.api.persona = {
            listar: '@Url.Action("Listar", "Personas")',
            buscar: '@Url.Action("Buscar", "Personas")'
        };

    </script>
}

