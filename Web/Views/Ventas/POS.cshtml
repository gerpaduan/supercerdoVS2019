        ////TECLADO
        let inputActivo = null;

        document.addEventListener("DOMContentLoaded", () => {
            inputActivo = document.getElementById("inputCodigo");
            inputActivo.focus();
        });

        document.addEventListener("focusin", e => {
            if (e.target.tagName === "INPUT") {
