@model Entidades.Venta

@{ ViewBag.Title = "CarniSys web | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";
}


<style>
    /* =============================
   FIX REAL PARA SB ADMIN 2 POS
   ============================= */

    html, body {
        height: 100%;
        overflow: hidden;
    }

    #wrapper {
        height: 100vh !important;
    }

    #content-wrapper {
        height: 100% !important;
    }

    #content {
        height: 100% !important;
        display: flex;
        flex-direction: column;
    }

    #pos-app {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

        /* Card del POS */
        #pos-app > .card {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        #pos-app .card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* La fila principal */
        #pos-app .row.flex-grow-1 {
            flex: 1;
            min-height: 0;
        }

        /* Columna izquierda */
        #pos-app .carrito-col {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
        }

        /* SCROLL REAL */
        #pos-app .zona-tabla {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

    /* Total y botones no crecen */
    .zona-total,
    .zona-botones {
        flex-shrink: 0;
    }


</style>


