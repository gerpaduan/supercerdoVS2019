        // --------------------------------------------------------------------
        function recalcularTotal() {
            let total = 0;

            carrito.forEach(l => {

                if (!l.anulado) {
                    // l.subtotal viene como "$ 123.45"
                    const valor = parseFloat(
                        l.subtotal.replace("$", "").replace(",", ".")
                    );

                    if (!isNaN(valor)) {
                        total += valor;
                    }
                }
            });

            $("#lblSubtotal").text(
                `$ ${total.toFixed(2).replace(".", ",")}`
            );
        }

        function obtenerTotalVenta() {

            let texto = $('#lblSubtotal').text() || '0';

            // Limpia símbolos y convierte a número
            texto = texto
                .replace('$', '')
                .replace(/\./g, '')
                .replace(',', '.')
                .trim();

            let total = parseFloat(texto);

            return isNaN(total) ? 0 : total;
        }

