    // INICIO FINANZAS POS
    $(function () {
        if (!document.getElementById("pos-app")) return;

        function focoCodigoPOS() {
            var inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch (e) { }
            }
        }

        function renderConScripts(html, selectorContenedor, onComplete) {
            var $contenedor = $(selectorContenedor);
            var $tmp = $("<div>").html(html);
            var scripts = [];

            $tmp.find("script").each(function () {
                scripts.push({
                    src: this.getAttribute("src"),
                    code: this.text || this.textContent || this.innerHTML || ""
                });
                $(this).remove();
            });

            $contenedor.html($tmp.html());

            function normalizarSrc(src) {
                try {
                    return new URL(src, document.baseURI).href;
                } catch (e) {
                    return src;
                }
            }

            function yaExisteScript(srcNormalizado) {
                return Array.from(document.scripts).some(function (s) {
                    return s.src && normalizarSrc(s.src) === srcNormalizado;
                });
            }

            function ejecutarScript(index) {
                if (index >= scripts.length) {
                    if (typeof onComplete === "function") {
                        onComplete();
                    }
                    return;
                }

                var item = scripts[index];

                if (item.src) {
                    var srcNormalizado = normalizarSrc(item.src);

                    if (yaExisteScript(srcNormalizado)) {
                        ejecutarScript(index + 1);
                        return;
                    }

                    var nuevo = document.createElement("script");
                    nuevo.src = srcNormalizado;
                    nuevo.async = false;
                    nuevo.setAttribute("data-pos-loaded", "true");

                    nuevo.onload = function () {
                        ejecutarScript(index + 1);
                    };

                    nuevo.onerror = function () {
                        console.error("No se pudo cargar el script:", srcNormalizado);
                        ejecutarScript(index + 1);
                    };

                    document.body.appendChild(nuevo);
                    return;
                }

                $.globalEval(item.code);
                ejecutarScript(index + 1);
            }

            ejecutarScript(0);
        }

        function reportarPerfPos(payload) {
            if (!payload) return;

            var data = {
                categoria: payload.categoria || "POS",
                nombre: payload.nombre || "Modal",
                totalMs: payload.totalMs || 0,
                detalle: payload.detalle || "",
                reqId: payload.reqId || "",
                url: payload.url || ""
            };

            try {
                if (navigator.sendBeacon) {
                    var formData = new FormData();
                    Object.keys(data).forEach(function (key) {
                        formData.append(key, data[key]);
                    });
                    navigator.sendBeacon('@Url.Action("ClientPerf", "Session")', formData);
                    return;
                }
            } catch (e) { }

            $.ajax({
                url: '@Url.Action("ClientPerf", "Session")',
                type: "POST",
                data: data
            });
        }

        function enfocarBuscadorFinanzasPOS() {
            function intentar() {
                var input = document.getElementById("txtBuscar");
                if (!input) return;

                input.focus();
                try { input.select(); } catch (e) { }

                var evt = $.Event("pos:finanzas-buscador-activo");
                $(document).trigger(evt);
            }

            setTimeout(intentar, 0);
            setTimeout(intentar, 120);
            setTimeout(intentar, 260);
        }

        function mostrarErrorFinanzas(msg) {
            var html = '<div class="alert alert-danger m-3 mb-0">' + msg + '</div>';
            $("#contenedorFinanzasPOS").html(html);
        }

        function mostrarErrorPago(msg) {
            var html = '<div class="alert alert-danger m-3 mb-0">' + msg + '</div>';
            $("#contenedorPagoPOS").html(html);
        }

        window.POSFinanzas = {
            cargar: function (url, titulo) {
                if (window.POSGuard && !window.POSGuard.startAction("finanzas:cargar")) {
                    return;
                }

                var esDetalleVenta = !!url && url.indexOf("/Ventas/DetalleVenta") >= 0;
                var esMisVentas = !!url && url.indexOf("/Ventas/MisVentas") >= 0;
                var esMisActividades = !!url && url.indexOf("/Cajas/MisEgresosCaja") >= 0;
                var esCompra = !!url && url.indexOf("/Compras/Editar") >= 0;
                var esCtasCtes = !!url && url.indexOf("/Finanzas/CtasCtes") >= 0;
                var inicioTotal = performance.now();

                $("#modalFinanzasPOS")
                    .removeClass("modal-egreso-pos-compacto modal-detalle-venta-pos-compacto modal-mis-ventas-pos-compacto modal-mis-actividades-pos-compacto modal-compra-pos-layout modal-ctasctes-pos-compacto")
                    .toggleClass("modal-compra-pos-layout", esCompra)
                    .toggleClass("modal-ctasctes-pos-compacto", esCtasCtes)
                    .toggleClass("modal-mis-actividades-pos-compacto", esMisActividades)
                    .toggleClass("modal-mis-ventas-pos-compacto", esMisVentas)
                    .toggleClass("modal-detalle-venta-pos-compacto", esDetalleVenta);
                $("#modalFinanzasPOSTitle").text(titulo || "Finanzas");
                $("#contenedorFinanzasPOS").html(window.POSModalLoading.html("Cargando..."));
                window.POSModalLoading?.show('Cargando solicitud...');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('finanzas', function () {
                        $("#modalFinanzasPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSModalLoading?.hide();
                    window.POSGuard?.endAction("finanzas:cargar");
                    return;
                }

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html, textStatus, xhr) {
                        var finAjax = performance.now();
                        var inicioRender = finAjax;
                        var reqId = xhr && typeof xhr.getResponseHeader === "function"
                            ? (xhr.getResponseHeader("X-CarniSys-Request-Id") || "")
                            : "";

                        renderConScripts(html, "#contenedorFinanzasPOS", function () {
                            window.POSModalLoading?.hide();
                            var finRender = performance.now();
                            reportarPerfPos({
                                categoria: "POS",
                                nombre: esCtasCtes
                                    ? "F2-CtasCtes"
                                    : (esMisActividades
                                        ? "F6-MisActividades"
                                        : (esMisVentas
                                            ? "Ventas-MisVentas"
                                            : (esDetalleVenta ? "Ventas-DetalleVenta" : "ModalFinanzas"))),
                                totalMs: Math.round(finRender - inicioTotal),
                                reqId: reqId,
                                url: url,
                                detalle: "ajax=" + Math.round(finAjax - inicioTotal) + " ms"
                                    + " | render=" + Math.round(finRender - inicioRender) + " ms"
                                    + " | html=" + (html ? html.length : 0)
                            });
                            enfocarBuscadorFinanzasPOS();
                        });
                    },
                    error: function () {
                        window.POSModalLoading?.hide();
                        mostrarErrorFinanzas("No se pudo cargar el contenido de finanzas.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("finanzas:cargar");
                    }
                });
            },

            cargarPago: function (url, titulo) {
                if (window.POSGuard && !window.POSGuard.startAction("pago:cargar")) {
                    return;
                }

                $("#modalPagoPOSTitle").text(titulo || "Pago / Cobro");
                $("#contenedorPagoPOS").html(window.POSModalLoading.html("Cargando..."));
                window.POSModalLoading?.show('Cargando solicitud...');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('pagoPos', function () {
                        $("#modalPagoPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSModalLoading?.hide();
                    window.POSGuard?.endAction("pago:cargar");
                    return;
                }

                setTimeout(function () {
                    $("body").addClass("modal-open");
                }, 0);

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        window.POSModalLoading?.hide();
                        renderConScripts(html, "#contenedorPagoPOS");
                    },
                    error: function () {
                        window.POSModalLoading?.hide();
                        mostrarErrorPago("No se pudo cargar el pago.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("pago:cargar");
                    }
                });
            },

            abrirCtasCtes: function () {
                var url = '@Url.Action("CtasCtes", "Finanzas", new { desdePos = true })';
                this.cargar(url, "Cuentas corrientes");
            },

            abrirCtaCtePersona: function (idPersona, fechaDesde) {
                var url = '@Url.Action("CtaCtePersona", "Finanzas")'
