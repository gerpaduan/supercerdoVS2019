@model dynamic
@{
    Layout = "~/Views/Shared/_LayoutBase.cshtml";
    var cajaId = Model?.CajaId ?? 1;
}

<!-- Vista: Punto de Venta (CSHTML) - SB Admin 2 estilo -->
<div class="container-fluid p-2" id="pos-app">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="m-0">Punto de Venta - <small class="text-light">@ViewBag.Tienda ?? "Mi Tienda"</small></h4>
            </div>
            <div class="d-flex align-items-center">
                <span class="me-3">Caja <strong>@cajaId</strong></span>
                <button class="btn btn-sm btn-light me-2" id="btn-toggle-fullscreen">Pantalla completa</button>
                <button class="btn btn-sm btn-outline-light" id="btn-cerrar-caja">Cerrar Caja</button>
            </div>
        </div>

        <div class="card-body" style="min-height:600px;">
            <div class="row h-100">
                <!-- IZQUIERDA: Interacción / lector -->
                <div class="col-lg-7 d-flex flex-column">

                    <div class="text-center mb-3">
                        <img src="~/images/barcode-example.png" alt="lector" width="260" />
                        <h5 class="mt-2">Pase el código del producto por el lector</h5>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                <input type="text" id="inputCodigo" class="form-control" placeholder="Esperando lectura..." autofocus />
                                <button class="btn btn-outline-secondary" id="btnAgregarManual" data-bs-toggle="modal" data-bs-target="#modalDigitarCodigo">Digitar</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="m-0">Subtotal</h3>
                            <h2 id="lblSubtotal" class="m-0">$ 0,00</h2>
                        </div>

                        <div class="text-end">
                            <button class="btn btn-warning btn-lg me-2">Frutas y Frescos</button>
                            <button class="btn btn-info btn-lg me-2" id="btn-comentario">Ingresar Comentario</button>
                            <button class="btn btn-success btn-lg" id="btnFinalizar">Finalizar y Pagar</button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="row g-2">
                            <div class="col-4">
                                <button class="btn btn-outline-danger w-100" id="btnCancelarItem">Cancelar ítem</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-outline-secondary w-100" id="btnLimpiar">Limpiar</button>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-outline-primary w-100" id="btnAyuda">Ayuda</button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <small class="text-muted">Conexión balanza: <span id="estadoBalanza">Desconocida</span></small>
                        <div class="progress mt-1" style="height:8px;">
                            <div id="barraBalanza" class="progress-bar" role="progressbar" style="width:0%"></div>
                        </div>
                    </div>

                </div>

                <!-- DERECHA: Tabla items -->
                <div class="col-lg-5 d-flex flex-column">
                    <div class="card border-0 shadow-sm mb-2">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <h5 class="m-0">Productos agregados</h5>
                            <div><small id="lblItemsCount">0 items</small></div>
                        </div>
                        <div class="card-body p-0" style="max-height:460px; overflow:auto;">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">Precio</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaItems">
                                    <tr id="fila-vacia"><td colspan="3" class="text-center text-muted py-4">No hay productos</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <div>
                                <button class="btn btn-sm btn-outline-secondary" id="btn-switch-dark">Modo oscuro</button>
                            </div>
                            <div class="text-end">
                                <strong>Total: </strong> <span id="lblTotal">$ 0,00</span>
                            </div>
                        </div>
                    </div>

                    <!-- Panel cliente / segunda pantalla -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">Pantalla Cliente</div>
                        <div class="card-body">
                            <div id="clientePantalla">Bienvenido - Pase un producto</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- MODAL: DIGITAR CÓDIGO -->
<div class="modal fade" id="modalDigitarCodigo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Digitar código</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <input id="txtCodigoManual" class="form-control form-control-lg text-center mb-3" placeholder="Ingrese código" />
                <div class="row g-2">
                    @{ for (int r = 1; r <= 9; r++)
                        { <text>
                                <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">@r</button></div>
                        </text>;
                    } }
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3" id="key-back">←</button></div>
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">0</button></div>
                    <div class="col-4"><button class="btn btn-success w-100 py-3" id="key-ok">OK</button></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PESABLE: muestra cuando un producto es por kg -->
<div class="modal fade" id="modalPesable" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Producto Pesable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div>Ingrese peso o use la balanza</div>
                <input id="txtPesoPesable" class="form-control form-control-lg text-center my-2" />
                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" id="btnAgregarPesable">Agregar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Variables internas
        let items = [];
        let subtotal = 0;

        // Formateo simple de moneda (adaptar a cultura si hace falta)
        function fmtCurrency(n) { return new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS'}).format(n); }

        function renderTabla() {
            const tbody = document.getElementById('tablaItems');
            tbody.innerHTML = '';
            if (items.length===0) {
                tbody.innerHTML = '<tr id="fila-vacia"><td colspan="3" class="text-center text-muted py-4">No hay productos</td></tr>';
                document.getElementById('lblItemsCount').innerText = '0 items';
                document.getElementById('lblSubtotal').innerText = fmtCurrency(0);
                document.getElementById('lblTotal').innerText = fmtCurrency(0);
                document.getElementById('clientePantalla').innerText = 'Bienvenido - Pase un producto';
                return;
            }
            items.forEach((it, idx)=>{
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${it.nombre}</td><td class="text-end">${it.cantidad}</td><td class="text-end">${fmtCurrency(it.total)}</td>`;
                tbody.appendChild(tr);
            });
            const total = items.reduce((s,i)=>s+i.total,0);
            document.getElementById('lblItemsCount').innerText = items.length + ' items';
            document.getElementById('lblSubtotal').innerText = fmtCurrency(total);
            document.getElementById('lblTotal').innerText = fmtCurrency(total);
            document.getElementById('clientePantalla').innerText = items[items.length-1].nombre + ' - ' + fmtCurrency(items[items.length-1].total);
        }

        // Simula llamada al servidor para obtener producto por código
        async function fetchProductoPorCodigo(codigo) {
            // Reemplazar por fetch real: /Productos/GetByBarcode?codigo=...
            // Ejemplo de respuesta:
            // { ok:true, data: { id:1, nombre:'Carne x', precioKg:1200, esPesable:true } }
            return new Promise(resolve=>{
                setTimeout(()=>{
                    // datos simulados
                    const esPesable = codigo.endsWith('9'); // solo ejemplo
                    resolve({ ok:true, data: { id: codigo, nombre: 'Producto ' + codigo, precioKg: 1200, precioUnitario:250, esPesable: esPesable } });
                },200);
            });
        }

        // Agregar producto (no pesable)
        function agregarProducto(producto, cantidad=1, peso=null) {
            let total = producto.esPesable && peso ? producto.precioKg * parseFloat(peso) : (producto.precioUnitario || producto.precioKg) * cantidad;
            items.push({ id: producto.id, nombre: producto.nombre, cantidad: producto.esPesable? peso : cantidad, total: total });
            renderTabla();
            playBeep();
        }

        // Beep al agregar
        function playBeep() {
            try{
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const o = ctx.createOscillator();
                const g = ctx.createGain();
                o.type = 'sine'; o.frequency.value = 1000; g.gain.value=0.05;
                o.connect(g); g.connect(ctx.destination); o.start(); setTimeout(()=>{o.stop();},80);
            }catch(e){ console.log('beep no soportado'); }
        }

        // Eventos entrada codigo
        document.addEventListener('DOMContentLoaded', ()=>{
            const inputCodigo = document.getElementById('inputCodigo');
            inputCodigo.addEventListener('keydown', async (e)=>{
                if (e.key === 'Enter') {
                    const codigo = inputCodigo.value.trim();
                    if (!codigo) return;
                    const res = await fetchProductoPorCodigo(codigo);
                    if (!res.ok) { alert('Producto no encontrado'); return; }
                    const prod = res.data;
                    if (prod.esPesable) {
                        // abrir modal pesable y mostrar peso de balanza si existe
                        const modal = new bootstrap.Modal(document.getElementById('modalPesable'));
                        document.getElementById('txtPesoPesable').value = '';
                        // si se dispone endpoint /peso usarlo para llenar peso automáticamente
                        leerPesoUnaVez().then(p=>{ if(p) document.getElementById('txtPesoPesable').value = p; });
                        document.getElementById('btnAgregarPesable').onclick = ()=>{ agregarProducto(prod,1,document.getElementById('txtPesoPesable').value); modal.hide(); };
                        modal.show();
                    } else {
                        agregarProducto(prod,1,null);
                    }
                    inputCodigo.value = '';
                }
            });

            // Modal digitar: teclas
            document.querySelectorAll('.num-key').forEach(b=>{
                b.addEventListener('click',(ev)=>{
                    const v = ev.target.innerText;
                    document.getElementById('txtCodigoManual').value += v;
                });
            });
            document.getElementById('key-back').addEventListener('click', ()=>{
                const t = document.getElementById('txtCodigoManual'); t.value = t.value.slice(0,-1);
            });
            document.getElementById('key-ok').addEventListener('click', async ()=>{
                const codigo = document.getElementById('txtCodigoManual').value.trim();
                if (!codigo) return;
                const res = await fetchProductoPorCodigo(codigo);
                if (!res.ok) { alert('No encontrado'); return; }
                const prod = res.data;
                if (prod.esPesable) {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalPesable')).show();
                } else {
                    agregarProducto(prod,1,null);
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDigitarCodigo')).hide();
                }
                document.getElementById('txtCodigoManual').value = '';
            });

            // Fullscreen toggle
            document.getElementById('btn-toggle-fullscreen').addEventListener('click', ()=>{
                if (!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen();
            });

            // Conexión a balanza: polling cada 800ms (ajustar según tu endpoint)
            setInterval(async ()=>{
                try{
                    const resp = await fetch('/peso'); // endpoint local que devolvía el usuario
                    if (!resp.ok) throw 'no ok';
                    const data = await resp.json();
                    const peso = data.peso || data; // según implementación
                    document.getElementById('estadoBalanza').innerText = peso + ' kg';
                    document.getElementById('barraBalanza').style.width = '100%';
                }catch(e){
                    document.getElementById('estadoBalanza').innerText = 'Desconectada';
                    document.getElementById('barraBalanza').style.width = '10%';
                }
            }, 1200);

        });

        // Leer peso una sola vez (para modal)
        async function leerPesoUnaVez(){
            try{
                const r = await fetch('/peso'); const j = await r.json(); return j.peso || j;
            }catch(e){ return null; }
        }

    </script>
}
