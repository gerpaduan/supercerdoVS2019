@section Scripts {
    <script src="@Url.Content("~/Scripts/app/pos-state.js?v=1")"></script>
    <script src="@Url.Content("~/Scripts/app/pos-product.js?v=1")"></script>
    <script src="@Url.Content("~/Scripts/app/pos-cart.js?v=1")"></script>
    <script src="@Url.Content("~/Scripts/app/pos-keyboard.js?v=1")"></script>
    <script src="@Url.Content("~/Scripts/app/pos-help.js?v=1")"></script>
    <script src="@Url.Content("~/Scripts/app/pos-comment.js?v=1")"></script>
    <script>


    $(function () {

         // -----------------------
    // Helpers
    // -----------------------
    function pad(n) { return (n < 10 ? "0" : "") + n; }

    // dd/MM/yyyy HH:mm
    function nowAR() {
        var d = new Date();
        return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear()
            + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
    }

    function mostrarError(msg) {
        if (window.Swal) {
            Swal.fire({ icon: 'error', title: 'No se pudo abrir la caja', text: msg || 'Error' });
        } else {
            alert(msg || 'No se pudo abrir la caja');
        }
    }

    // -----------------------
    // Acción Abrir Caja (llama al controller)
    // -----------------------
    window.abrirCaja = function () {
        var cajaInicio = $("#montoInicial").val();
        var fechaHora = $("#fechaHoraApertura").val();

        $.ajax({
            url: '@Url.Action("AbrirCaja", "Cajas")',
            type: 'POST',
            dataType: 'json',
            data: { cajaInicio: cajaInicio, fechaHora: fechaHora },
            success: function (r) {
                if (r && r.ok) {
                    // ✅ Ya se abrió: recargo el POS (ahora el controller debería dejarte entrar)
                    $("#modalAbrirCaja").modal('hide');
                    location.reload();
                    return;
                }

                // ❌ No abrió: muestro error y me quedo en el modal
                mostrarError((r && r.mensaje) ? r.mensaje : "Error al abrir caja.");
            },
            error: function () {
                mostrarError("No se pudo contactar al servidor.");
            }
        });
    };

    // -----------------------
    // Init
    // -----------------------
    $(function () {

        // Si el controller te setea ViewBag.CajaAbierta (como ya haces):
        var cajaAbierta = @((ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta) ? "true" : "false");

        if (!cajaAbierta) {
            // seteo fecha/hora y abro modal
            $("#fechaHoraApertura").val(nowAR());

            $("#modalAbrirCaja").modal('show');

            $("#modalAbrirCaja").on("shown.bs.modal", function () {
                $("#montoInicial").trigger("focus");
            });

            // Cancelar => volver al Index (layout base)
            $("#btnCancelarAbrirCaja").off("click").on("click", function () {
                window.location.href = '@Url.Action("Index", "Home")';
            });

            // Enter en monto => abrir caja
            $("#montoInicial").off("keydown").on("keydown", function(e){
                if (e.key === "Enter") {
                    e.preventDefault();
                    window.abrirCaja();
                }
                if (e.key === "Escape") {
                    e.preventDefault();
                    $("#btnCancelarAbrirCaja").click();
                }
            });
        }

    });


        // ✅ Guard: si NO está el POS renderizado, NO ejecuto el script del POS
        if (!document.getElementById("pos-app") || !document.getElementById("inputCodigo")) {
            console.warn("POS script: no está el HTML del POS (caja cerrada o vista distinta).");
            return;
        }

    document.addEventListener("click", habilitarAudio, { once: true });

    function habilitarAudio() {
        const audio = document.getElementById("beep");
        audio.volume = 0;
        audio.play().finally(() => {
            audio.pause();
            audio.currentTime = 0;
            audio.volume = 1;
        });
    }

    // VARIABLES
    let stream = null;
    let track = null;
    let detector = null;
    let scanning = false;
    let esEAN = false;
    let ultimoCodigo = null;
    let ultimoTiempo = 0;
    const TIEMPO_RELECTURA = 2000;
    const video = document.getElementById("videoScanner");

    const scanner = new BarcodeScanner({
            videoSelector: "#videoScanner",
            containerSelector: "#scannerContainer",
            onCodeDetected: function (codigo) {
                document.querySelector("#inputCodigo").value = codigo;
                document.querySelector("#inputCodigo").focus();
                manejarEnter();
                // si querés cerrar al detectar:
                // scanner.cerrar();
            }
        });
        document.getElementById("btnScanner")?.addEventListener("click", () => scanner.iniciar());
        document.getElementById("btnCerrarScanner")?.addEventListener("click", () => scanner.cerrar());

        document.getElementById("btnFlash")?.addEventListener("click", async () => {
            const estado = await scanner.toggleFlash();

            // feedback visual opcional
            const btn = document.getElementById("btnFlash");
            if (estado) {
                btn.classList.remove("btn-secondary");
                btn.classList.add("btn-warning");
                btn.textContent = "🔦 Flash ON";
            } else {
                btn.classList.remove("btn-warning");
                btn.classList.add("btn-secondary");
                btn.textContent = "🔦 Flash";
            }
        });


    // BEEP
    function beep() {
        const audio = document.getElementById("beep");
        if (!audio) return;
        audio.currentTime = 0;
        audio.play();
    }

    // URLs
    window.api = window.api || {};
    window.api.producto = window.api.producto || {};
    window.api.producto.listar = '@Url.Action("ListarParaPOS", "Productos")';

    // ===== ESTADO POS EN MEMORIA =====
    const POSState = window.POSState;
    const carrito = POSState.getLineas();
    POSState.setFechaVenta(new Date());
    POSState.setObservaciones(@Html.Raw(Json.Encode(Model != null ? Model.Observaciones ?? "" : "")));

    (function () {
        const dias = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
        const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

        function actualizarFechaHora() {
            if (!(carrito.length === 0 || carrito.length === 1)) return;

            const ahora = new Date();
            const fechaSql = ahora.toISOString().slice(0, 19);
            $('#fechaVenta').val(fechaSql);

            const diaSemana = dias[ahora.getDay()];
            const dia = ahora.getDate();
            const mes = meses[ahora.getMonth()];
            const anio = ahora.getFullYear();

            const hora = String(ahora.getHours()).padStart(2, '0');
            const minutos = String(ahora.getMinutes()).padStart(2, '0');

            const formato = `${diaSemana} ${dia} de ${mes}, ${anio} · ${hora}:${minutos}`;

            const span = document.getElementById('fechaHoraPOS');
            if (span) span.innerText = formato;
        }

        actualizarFechaHora();
        setInterval(actualizarFechaHora, 60000);
    })();

    if (window.POSGuard) {
        window.POSGuard.bindModal('#modalBuscarPersona', 'persona');
        window.POSGuard.bindModal('#modalFinanzasPOS', 'finanzas');
        window.POSGuard.bindModal('#modalPagoPOS', 'pagoPos');
    }

    // BUSCAR PERSONA
    $(document).on('click', '#btnBuscarPersona', function () {
        const $btn = $(this);
        const $contenedor = $('#contenedorModalPersona');

        if ($contenedor.find('#modalBuscarPersona').length) {
            const abierto = window.POSGuard
                ? window.POSGuard.requestModalOpen('persona', function () {
                    $('#modalBuscarPersona').modal('show');
                    cargarPersonas();
                })
                : true;

            if (!abierto) return;
            return;
        }

        if (window.POSGuard && !window.POSGuard.startModalLoad('persona')) return;

        $btn.prop('disabled', true);

        $.get(window.api.persona.buscar)
            .done(function (html) {
                $contenedor.html(html);
                window.POSGuard?.endModalLoad('persona');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('persona', function () {
                        $('#modalBuscarPersona').modal('show');
                        cargarPersonas();
                    })
                    : true;

                if (!abierto) {
                    $('#modalBuscarPersona').modal('show');
                    cargarPersonas();
                }
            })
            .fail(function () {
                window.POSGuard?.endModalLoad('persona');
                Swal.fire({
                    icon: 'error',
                    title: 'Cliente',
                    text: 'No se pudo cargar el buscador de clientes'
                });
            })
            .always(function () {
                $btn.prop('disabled', false);
            });
    });

    $('#btnConsumidorFinal').on('click', function () {
        $('#idPersona').val('@Entidades.Persona.idConsumidorFinal');
        $('#razonSocial').val('Consumidor Final');
    });

    document.addEventListener("keydown", function (e) {
        if ($(".modal.show").length) return;

        if (e.key === "End") {
            e.preventDefault();
            const btn = document.getElementById("btnFinalizar");
            if (btn && !btn.disabled) btn.click();
        }

        if (e.key === "Home") {
            e.preventDefault();
            const inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch { }
            }
        }

        if (e.key === "F9" || e.key === "F10") e.preventDefault();
        else return;

        if (e.key === "F9") {
            const btn = document.getElementById("btnBuscarPersona");
            if (btn && !btn.disabled) btn.click();
            return;
        }

        if (e.key === "F10") {
            const btn = document.getElementById("btnAgregarManual");
            if (btn && !btn.disabled) abrirBuscadorProductosPOS();
            return;
        }
    });


    function mostrarErrorConexion(msg) {
        Swal.fire({
            icon: 'error',
            title: 'Sin conexión',
            text: msg,
            allowOutsideClick: false
        });
    }

    function scrollPantallaMobile() {
        if (!window.matchMedia('(max-width: 576px)').matches) return;

        const anchor = scanning
            ? document.getElementById('btnAgregarProducto')
            : document.getElementById('pos-bottom-anchor');

        if (!anchor) return;

        anchor.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    let posProduct = null;
    let posCart = null;
    const posHelp = window.POSHelp.create({
        focusCodigo: function () { return posKeyboard.focusCodigo(); },
        clickIfEnabled: function (selector) {
            const button = document.querySelector(selector);
            if (button && !button.disabled) {
                button.click();
            }
        }
    });
    const posComment = window.POSComment.create({
        POSState: POSState,
        focusCodigo: function () { return posKeyboard.focusCodigo(); }
    });
    const posKeyboard = window.POSKeyboard.create({
        handleEnter: function () { return posProduct ? posProduct.handleEnter() : null; },
        calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
        finishTyping: function (value) { return posProduct ? posProduct.finishTyping(value) : null; },
        setEnterDesdeTecladoVirtual: function (value) { return posProduct ? posProduct.setEnterDesdeTecladoVirtual(value) : null; }
    });

    posProduct = window.POSProduct.create({
        calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
        addProduct: function () { return posCart ? posCart.addProduct() : null; },
        getInputActivo: function () { return posKeyboard.getInputActivo(); },
        clearInputActivo: function () { return posKeyboard.clearInputActivo(); },
        showConnectionError: mostrarErrorConexion
    });

    posCart = window.POSCart.create({
        POSState: POSState,
        getProductoSeleccionado: function () { return posProduct.getProductoSeleccionado(); },
        setProductoSeleccionado: function (value) { return posProduct.setProductoSeleccionado(value); },
        getPrecioActual: function () { return posProduct.getPrecioActual(); },
        beep: beep,
        focusCodigo: function () { return posKeyboard.focusCodigo(); },
        showWaiting: function () { return posProduct.showWaiting(); },
        scrollPantallaMobile: scrollPantallaMobile,
        handleEnter: function () { return posProduct.handleEnter(); },
        getTypingTimer: function () { return posProduct.getTypingTimer(); },
        setEnterDesdeTecladoVirtual: function (value) { return posProduct.setEnterDesdeTecladoVirtual(value); }
    });

    posProduct.init();
    posCart.init();
    posKeyboard.init();
    posHelp.init();
    posComment.init();
    // Helper: scroll a una línea (desktop scroll interno / responsive scroll página)
    function scrollTablaAItem(idLinea) {
        const fila = document.querySelector(`#tablaItems tr.fila-item[data-id="${idLinea}"]`);
        if (!fila) return;

        const isDesktop = window.matchMedia('(min-width: 992px)').matches;
        const zonaTabla = document.querySelector('.carrito-col .zona-tabla');

        // foco real para que el usuario “sienta” que quedó ahí
        fila.tabIndex = -1;
        try { fila.focus({ preventScroll: true }); } catch { }

        if (isDesktop && zonaTabla) {
            fila.scrollIntoView({ block: 'nearest' });
        } else {
            fila.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }


    $('#btnFinalizar').on('click', function () {
        if (carrito.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Venta vacía',
                text: 'Debe agregar al menos un producto'
            });
            return;
        }

        const abierto = window.POSGuard
            ? window.POSGuard.requestModalOpen('formaPago', function () {
                $('#modalFormaPago').modal('show');
            })
            : true;

        if (!abierto) return;

        scrollPantallaMobile();
    });

    function esPantallaChica() {
        return window.innerWidth < 768;
    }

    function configurarInputsPOS() {
        if (esPantallaChica()) {
            $('#inputCodigo, #inputCantidad')
                .attr('readonly', true)
                .attr('inputmode', 'none');
        } else {
            $('#inputCodigo, #inputCantidad')
                .removeAttr('readonly')
                .removeAttr('inputmode');
        }
    }

    $(document).ready(configurarInputsPOS);
    $(window).on('resize', configurarInputsPOS);

    // URLs MVC
    window.api = window.api || {};
    window.api.venta = {
        finalizar: '@Url.Action("FinalizarVenta", "Ventas")',
        imprimir: '@Url.Action("ImprimirTicket", "Ventas")',
    };
    window.api.persona = {
        listar: '@Url.Action("Listar", "Personas")',
        buscar: '@Url.Action("Buscar", "Personas")'
    };

    // FULLSCREEN + recordar al recargar
    (function () {
        const FS_KEY = "carnisys-fullscreen";
        const root = document.documentElement;

        function isFullscreen() { return !!document.fullscreenElement; }

        function updateFullscreenUI() {
            const btn = document.getElementById("btn-toggle-fullscreen");
            if (!btn) return;

            const on = isFullscreen();
            btn.classList.toggle("is-fullscreen", on);

            const ico = btn.querySelector("i");
            if (ico) {
                ico.className = on ? "fas fa-compress-arrows-alt" : "fas fa-expand-arrows-alt";
            }

            btn.title = on ? "Salir de pantalla completa" : "Pantalla completa";
        }

        async function enterFullscreen() {
            try {
                if (root.requestFullscreen) await root.requestFullscreen();
                else if (root.webkitRequestFullscreen) root.webkitRequestFullscreen();

                localStorage.setItem(FS_KEY, "1");
                updateFullscreenUI();
                return true;
            } catch (e) {
                updateFullscreenUI();
                return false;
            }
        }

        async function exitFullscreen() {
            try {
                if (document.exitFullscreen) await document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            } catch (e) { }

            localStorage.removeItem(FS_KEY);
            updateFullscreenUI();
        }

        async function toggleFullscreen() {
            if (isFullscreen()) await exitFullscreen();
            else await enterFullscreen();
        }

        function wantFullscreen() { return localStorage.getItem(FS_KEY) === "1"; }

        function restoreFullscreenIfNeeded() {
            if (!wantFullscreen() || isFullscreen()) return;

            enterFullscreen().then(ok => {
                if (ok) return;

                const retryOnce = async () => { await enterFullscreen(); };
                document.addEventListener("click", retryOnce, { capture: true, once: true });
                document.addEventListener("keydown", retryOnce, { capture: true, once: true });
            });
        }

        document.addEventListener("fullscreenchange", function () {
            if (isFullscreen()) localStorage.setItem(FS_KEY, "1");
            else localStorage.removeItem(FS_KEY);

            updateFullscreenUI();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("btn-toggle-fullscreen");
            if (btn) btn.addEventListener("click", toggleFullscreen);

            updateFullscreenUI();
            restoreFullscreenIfNeeded();
        });
        })();

        // ================================
        // MODO COMPACTO AUTOMÁTICO (por alto)
        // - ayuda en 1366x768 / zoom 125%
        // ================================
        (function () {
            function aplicarCompacto() {
                const h = window.innerHeight || document.documentElement.clientHeight;

                // Ajustá umbrales si querés
                document.documentElement.classList.toggle("pos-compact", h < 820);
                document.documentElement.classList.toggle("pos-tiny", h < 740);
            }

            window.addEventListener("resize", aplicarCompacto);
            window.addEventListener("orientationchange", aplicarCompacto);
            document.addEventListener("DOMContentLoaded", aplicarCompacto);
            aplicarCompacto();
        })();


    });
    </script>

    <script>
    // INICIO FINANZAS POS
    $(function () {
        if (!document.getElementById("pos-app")) return;

        function focoCodigoPOS() {
            var inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch (e) { }
            }
        }

        function renderConScripts(html, selectorContenedor) {
            var $contenedor = $(selectorContenedor);
            var $tmp = $("<div>").html(html);
            var scripts = [];

            $tmp.find("script").each(function () {
                scripts.push({
                    src: this.getAttribute("src"),
                    code: this.text || this.textContent || this.innerHTML || ""
                });
                $(this).remove();
            });

            $contenedor.html($tmp.html());

            function normalizarSrc(src) {
                try {
                    return new URL(src, document.baseURI).href;
                } catch (e) {
                    return src;
                }
            }

            function yaExisteScript(srcNormalizado) {
                return Array.from(document.scripts).some(function (s) {
                    return s.src && normalizarSrc(s.src) === srcNormalizado;
                });
            }

            function ejecutarScript(index) {
                if (index >= scripts.length) return;

                var item = scripts[index];

                if (item.src) {
                    var srcNormalizado = normalizarSrc(item.src);

                    if (yaExisteScript(srcNormalizado)) {
                        ejecutarScript(index + 1);
                        return;
                    }

                    var nuevo = document.createElement("script");
                    nuevo.src = srcNormalizado;
                    nuevo.async = false;
                    nuevo.setAttribute("data-pos-loaded", "true");

                    nuevo.onload = function () {
                        ejecutarScript(index + 1);
                    };

                    nuevo.onerror = function () {
                        console.error("No se pudo cargar el script:", srcNormalizado);
                        ejecutarScript(index + 1);
                    };

                    document.body.appendChild(nuevo);
                    return;
                }

                $.globalEval(item.code);
                ejecutarScript(index + 1);
            }

            ejecutarScript(0);
        }

        function enfocarBuscadorFinanzasPOS() {
            function intentar() {
                var input = document.getElementById("txtBuscar");
                if (!input) return;

                input.focus();
                try { input.select(); } catch (e) { }

                var evt = $.Event("pos:finanzas-buscador-activo");
                $(document).trigger(evt);
            }

            setTimeout(intentar, 0);
            setTimeout(intentar, 120);
            setTimeout(intentar, 260);
        }

        function mostrarErrorFinanzas(msg) {
            var html = '<div class="alert alert-danger m-3 mb-0">' + msg + '</div>';
            $("#contenedorFinanzasPOS").html(html);
        }

        function mostrarErrorPago(msg) {
            var html = '<div class="alert alert-danger m-3 mb-0">' + msg + '</div>';
            $("#contenedorPagoPOS").html(html);
        }

        window.POSFinanzas = {
            cargar: function (url, titulo) {
                if (window.POSGuard && !window.POSGuard.startAction("finanzas:cargar")) {
                    return;
                }

                $("#modalFinanzasPOSTitle").text(titulo || "Finanzas");
                $("#contenedorFinanzasPOS").html('<div class="p-4 text-center text-muted">Cargando...</div>');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('finanzas', function () {
                        $("#modalFinanzasPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSGuard?.endAction("finanzas:cargar");
                    return;
                }

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        renderConScripts(html, "#contenedorFinanzasPOS");
                        enfocarBuscadorFinanzasPOS();
                    },
                    error: function () {
                        mostrarErrorFinanzas("No se pudo cargar el contenido de finanzas.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("finanzas:cargar");
                    }
                });
            },

            cargarPago: function (url, titulo) {
                if (window.POSGuard && !window.POSGuard.startAction("pago:cargar")) {
                    return;
                }

                $("#modalPagoPOSTitle").text(titulo || "Pago / Cobro");
                $("#contenedorPagoPOS").html('<div class="p-4 text-center text-muted">Cargando...</div>');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('pagoPos', function () {
                        $("#modalPagoPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSGuard?.endAction("pago:cargar");
                    return;
                }

                setTimeout(function () {
                    $("body").addClass("modal-open");
                }, 0);

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        renderConScripts(html, "#contenedorPagoPOS");
                    },
                    error: function () {
                        mostrarErrorPago("No se pudo cargar el pago.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("pago:cargar");
                    }
                });
            },

            abrirCtasCtes: function () {
                var url = '@Url.Action("CtasCtes", "Finanzas", new { desdePos = true })';
                this.cargar(url, "Cuentas corrientes");
            },

            abrirCtaCtePersona: function (idPersona, fechaDesde) {
                var url = '@Url.Action("CtaCtePersona", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (fechaDesde) {
                    url += '&fechaDesde=' + encodeURIComponent(fechaDesde);
                }

                this.cargar(url, "Cuenta corriente");
            },

            abrirPago: function (idPersona, returnUrl, idPago) {
                var url = '@Url.Action("AddOrEditPago", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (returnUrl) {
                    url += '&returnUrl=' + encodeURIComponent(returnUrl);
                }

                if (idPago) {
                    url += '&idPago=' + encodeURIComponent(idPago);
                }

                this.cargarPago(url, "Pago / Cobro");
            }
        };

        window.POSFinanzasState = window.POSFinanzasState || {
            redirectDespuesDePago: null,
            tituloDespuesDePago: "Cuenta corriente"
        };

        window.posHotkeysHooks = window.posHotkeysHooks || {};
        window.posHotkeysHooks.F2 = function () {
            window.POSFinanzas.abrirCtasCtes();
        };

        $(document).on("click", "#modalFinanzasPOS a[data-pos-ajax='true']", function (e) {
            e.preventDefault();

            var url = $(this).attr("href");
            var titulo = $(this).data("pos-title") || "Finanzas";

            if ((url && url.indexOf("/Finanzas/AddOrEditPago") >= 0) || $(this).data("pos-modal") === "pago") {
                window.POSFinanzas.cargarPago(url, titulo || "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, titulo);
        });

        $(document).on("submit", "#modalFinanzasPOS form[data-pos-ajax='true'][method='get'], #modalFinanzasPOS form[data-pos-ajax='true']:not([method])", function (e) {
            e.preventDefault();

            var $form = $(this);
            var url = $form.attr("action");
            var query = $form.serialize();

            if (url.indexOf("?") >= 0) {
                url += "&" + query;
            } else {
                url += "?" + query;
            }

            var titulo = $form.data("pos-title") || "Finanzas";
            window.POSFinanzas.cargar(url, titulo);
        });

        $("#modalPagoPOS").on("shown.bs.modal", function () {
            setTimeout(function () {
                $("body").addClass("modal-open");
            }, 0);
        });

        $("#modalPagoPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorPagoPOS").html("");

            setTimeout(function () {
                if (window.POSFinanzasState && window.POSFinanzasState.redirectDespuesDePago) {
                    var urlRecarga = window.POSFinanzasState.redirectDespuesDePago;
                    var tituloRecarga = window.POSFinanzasState.tituloDespuesDePago || "Cuenta corriente";

                    window.POSFinanzasState.redirectDespuesDePago = null;
                    window.POSFinanzasState.tituloDespuesDePago = "Cuenta corriente";

                    if ($("#modalFinanzasPOS").hasClass("show")) {
                        window.POSFinanzas.cargar(urlRecarga, tituloRecarga);
                        $("body").addClass("modal-open");
                        return;
                    }
                }

                if ($("#modalFinanzasPOS").hasClass("show")) {
                    $("body").addClass("modal-open");
                    return;
                }

                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorFinanzasPOS").html("");

            setTimeout(function () {
                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("shown.bs.modal", function () {
            function enfocarBuscadorCtas() {
                var input = document.getElementById("txtBuscar");
                if (!input) return;
                input.focus();
                try { input.select(); } catch { }
            }

            setTimeout(enfocarBuscadorCtas, 0);
            setTimeout(enfocarBuscadorCtas, 140);
            setTimeout(enfocarBuscadorCtas, 300);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const $modalFinanzas = $('#modalFinanzasPOS');
                const $modalActivo = $('.modal.show').last();

                // Verificamos si el modal de Finanzas POS está abierto
                // y además es el modal activo
                if ($modalFinanzas.hasClass('show') && $modalActivo.is($modalFinanzas)) {
                    $modalFinanzas.modal('hide');
                }
            }
        });

    });
    // FIN FINANZAS POS
    </script>
}

<style>
    /* =========================================================
      0) Base: wrapper de la vista
      ========================================================= */
    .pos-page {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* =========================================================
      1) Variables (claro/oscuro)
      ========================================================= */
    :root {
        --pos-bg: #ffffff;
        --pos-text: rgba(0,0,0,.88);
        --pos-muted: rgba(0,0,0,.60);
        --pos-border: rgba(0,0,0,.12);
        --posbar-bg: #ffffff;
        --posbar-border: rgba(0,0,0,.12);
        --posbar-text: rgba(0,0,0,.88);
        --posbar-muted: rgba(0,0,0,.60);
    }

    html.dark-mode {
        --pos-bg: #0f172a;
        --pos-text: rgba(255,255,255,.92);
        --pos-muted: rgba(255,255,255,.70);
        --pos-border: rgba(255,255,255,.12);
        --posbar-bg: #0f172a;
        --posbar-border: rgba(255,255,255,.12);
        --posbar-text: rgba(255,255,255,.92);
        --posbar-muted: rgba(255,255,255,.70);
    }

    /* =========================================================
      2) TOP POS
      ========================================================= */
    .pos-topbar {
        flex: 0 0 auto;
        border: 1px solid var(--posbar-border);
        border-radius: 10px;
        background: var(--posbar-bg);
        padding: .40rem .50rem;
        margin-bottom: .45rem !important;
    }

        .pos-topbar > [class*="col-"] {
            padding-top: .10rem;
            padding-bottom: .10rem;
        }

    .pos-empresa {
        font-weight: 700;
        color: var(--posbar-text);
    }

    .pos-fecha {
        color: var(--posbar-muted);
        font-size: .95rem;
        line-height: 1.15;
    }

    .pos-btn-fullscreen {
        min-width: 44px;
        padding-left: .7rem;
        padding-right: .7rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @@media (min-width: 992px) {
        .pos-meta {
            min-width: 0;
        }

        .pos-btn-fullscreen {
            height: 100%;
            min-height: 44px;
        }
    }

    @@media (max-width: 991.98px) {
        .pos-meta {
            text-align: left !important;
        }
    }

    /* =========================================================
      3) POS APP: ocupa TODO el alto restante (desktop)
      - mata cualquier height:85vh viejo
      ========================================================= */
    #pos-app {
        flex: 1 1 auto;
