                    @{ for (int r = 1; r <= 9; r++)
                        { <text>
                                <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">@r</button></div>
                        </text>;
                    } }
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3" id="key-back">←</button></div>
                    <div class="col-4"><button class="btn btn-outline-dark w-100 py-3 num-key">0</button></div>
