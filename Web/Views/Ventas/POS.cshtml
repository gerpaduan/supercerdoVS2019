                        else
                        {
                            <span class="pos-time-chip">
                                <i class="far fa-clock"></i>
                                <span id="fechaHoraPOS" class="font-weight-bold"></span>
                            </span>
                        }
                    </div>

                    <div class="pos-meta-hidden">
                        <input type="hidden" id="fechaVenta" name="fechaVenta" value="@Model.FechaVenta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                        <input type="hidden" id="idVentaEditar" value="@idVentaEditar" />
                        <input type="hidden" id="idSucursalPOS" value="@idSucursalPOS" />
