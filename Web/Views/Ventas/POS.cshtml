    // agrega un item al carrito), en vez de arrancar arriba del todo con el
    // encabezado. setTimeout para que el layout ya este armado.
    $(document).ready(function () {
        setTimeout(scrollPantallaMobile, 50);
    });

    function reubicarFormaPagoPOS() {
        var $banner = $('#posFormaPagoActual');
        var $mobileAnchor = $('#posFormaPagoMobileAnchor');
        var $desktopAnchor = $('#posFormaPagoDesktopAnchor');
        if (!$banner.length || !$mobileAnchor.length || !$desktopAnchor.length) return;

        if (window.innerWidth < 992) {
            if ($banner.prev()[0] !== $mobileAnchor[0]) {
                $banner.insertAfter($mobileAnchor);
            }
        } else {
            if ($banner.prev()[0] !== $desktopAnchor[0]) {
