    function scrollTablaAItem(idLinea) {
        const fila = document.querySelector(`#tablaItems tr.fila-item[data-id="${idLinea}"]`);
        if (!fila) return;

        const isDesktop = window.matchMedia('(min-width: 992px)').matches;
        const zonaTabla = document.querySelector('.carrito-col .zona-tabla');


        fila.tabIndex = -1;
        try { fila.focus({ preventScroll: true }); } catch { }

        if (isDesktop && zonaTabla) {
            fila.scrollIntoView({ block: 'nearest' });
        } else {
            fila.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }


    $('#btnFinalizar').on('click', function () {
        // El cajero puede haber tipeado un codigo y no haberlo agregado
        // (sin querer, sin presionar Enter): si se finaliza asi, ese
        // producto queda sin registrar en la venta. Se bloquea mientras
        // el input de codigo no este vacio.
        var codigoPendiente = ($('#inputCodigo').val() || '').trim();
        if (codigoPendiente !== '') {
            Swal.fire({
                icon: 'warning',
                title: 'Código sin registrar',
                text: 'Hay un código cargado que todavía no se agregó a la venta. Agrégelo o bórrelo antes de finalizar.',
                // SweetAlert2 devuelve el foco solo al elemento que lo tenia
                // antes de abrirse (returnFocus), pero eso corre despues de
                // este .then() y nos lo pisa: se desactiva para que el foco
                // final sea siempre el de #inputCodigo, sin importar donde
                // estaba el foco al apretar "Finalizar".
                returnFocus: false
            }).then(function () {
                $('#inputCodigo').trigger('focus');
            });
            return;
        }

        if (soloFormaPago) {
            window.preCargarFormaPagoActual?.();
        }

        const lineasActuales = window.POSState?.getLineas?.() || [];
        const tieneLineasActivas = lineasActuales.some(function (linea) {
            return linea && !linea.anulado;
        });

        if (lineasActuales.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Venta vacía',
                text: 'Debe agregar al menos un producto'
            });
            return;
        }

        if (!tieneLineasActivas && !esEdicionVenta) {
            // Venta nueva (nunca guardada): no hay nada que "editar a cero",
            // se cancela/descarta el carrito en curso -- comportamiento
            // preexistente, sin cambios.
            guardarVentaAnuladaDirectamente(true);
            return;
        }

        // Si es la edicion de una venta ya guardada y se borraron todos los
        // productos, NO se cancela la venta ni se le cambia la forma de pago
        // a la fuerza: las lineas ya quedan con su opuesto agregado (ver
        // CompletarAnulacionesVenta en el controller -- ej. "Carre 5kg"
        // anulado genera "Carre -5kg"), asi que el total de la venta ya da
        // $0 solo. Se guarda como una edicion normal, pasando por el mismo
        // modal de forma de pago de siempre (respeta/permite elegir la forma
        // de pago actual, incluida CtaCte).

        const abierto = window.POSGuard
            ? window.POSGuard.requestModalOpen('formaPago', function () {
                window.abrirModalFormaPagoFinalizacion?.();
            })
            : true;

        if (!abierto) return;

        scrollPantallaMobile();
    });

    function esPantallaChica() {
