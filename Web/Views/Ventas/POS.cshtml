                            <i class="fas fa-trash"></i> Eliminar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>



    <!-- MODAL PESABLE -->
    <div class="modal fade" id="modalPesable" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Producto Pesable</h5>
                    <button type="button" class="btn-close" data-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div>Ingrese peso o use la balanza</div>
                    <input id="txtPesoPesable" class="form-control form-control-lg text-center my-2" />
