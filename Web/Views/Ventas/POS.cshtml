                    <button class="btn btn-primary" id="btnAgregarPesable">Agregar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        let typingTimer = null;
        let productoSeleccionado = null;
        let precioActual = 0;
        // ===== ESTADO POS EN MEMORIA =====
        let carrito = [];
        let indexLinea = 1;
        let ingresoCantidadX = false;
        let enterDesdeTecladoVirtual = false;

        // ================================
        // BÚSQUEDA EN VIVO
        // ================================
        $("#inputCodigo").on("keyup", function (e) {

            let cod = this.value.trim().toUpperCase();

            // ⌨️ ENTER → cancelar debounce y pasar a cantidad
            if (e.key === "Enter") {
                clearTimeout(typingTimer);
                terminarEscritura(cod, function () {
                    // 👇 se ejecuta CUANDO el producto YA está cargado
                    pasarAFocoCantidad();
                });
                return;
            }

            // ⛔ Si tiene X, no buscar (se procesa con Enter)
            if (cod.includes("X")) {
                mostrarSinCoincidencia();
                clearTimeout(typingTimer);
                return;
            }

            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                terminarEscritura(cod);
            }, 250);
        });


        function terminarEscritura(codigo, callback = null) {

            if (codigo === "") {
                mostrarEsperando();
                return;
            }

            $.ajax({
                url: '@Url.Action("BuscarProducto", "Ventas")',
                //url: "/Ventas/BuscarProducto",
                method: "GET",
                data: { codigo: codigo },

                success: function (data) {
                    if (!data || data.error) {
                        mostrarSinCoincidencia();
                        return;
                    }

                    mostrarProducto(data);
                    productoSeleccionado = data;

                    // 🔥 ACÁ está la magia
                    if (callback) callback();
                },

                error: function () {
                    mostrarSinCoincidencia();
                }
            });
        }

        // --------------------------------------------------------------------
        //  ESTADOS DEL PANEL
        // --------------------------------------------------------------------

        // PRODUCTO ENCONTRADO
        function mostrarProducto(p) {

            $("#prodNombre")
                .text(p.nombre)
                .removeClass("text-muted")
                .addClass("fw-bold");

            $("#prodPrecio")
                .text("$ " + p.precioKg.toLocaleString("es-AR"))
                .removeClass("text-muted")
                .addClass("fw-bold");

            precioActual = p.precioKg;

            $("#inputCantidad")
                .prop("disabled", false)
                //.val(p.pesable ? obtenerPesoBalanza() : "")
                //.focus();

            $("#prodSubtotal").text("$ 0,00");
            calcularSubtotal();

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // NO HAY COINCIDENCIA
        function mostrarSinCoincidencia() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Sin coincidencia")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio")
                .text("")
                .addClass("text-muted");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // ESTADO INICIAL
        function mostrarEsperando() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Esperando código…")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio").text("");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // --------------------------------------------------------------------
        // CALCULAR SUBTOTAL EN VIVO
        // --------------------------------------------------------------------
        $("#inputCantidad").on("input", calcularSubtotal);

        function calcularSubtotal() {

            let cant = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cant) || cant <= 0 || precioActual <= 0) {
                $("#prodSubtotal").text("$ 0,00");
                $("#btnAgregarProducto").prop("disabled", true);
                return;
            }

            let subtotal = cant * precioActual;

            $("#prodSubtotal").text(
                "$ " + subtotal.toLocaleString("es-AR", {
                    minimumFractionDigits: 2
                })
            );

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // --------------------------------------------------------------------
        // CALCULAR TOTAL EN VIVO
        // --------------------------------------------------------------------
        function recalcularTotal() {
            let total = 0;

            carrito.forEach(l => {
                // l.subtotal viene como "$ 123.45"
                const valor = parseFloat(
                    l.subtotal.replace("$", "").replace(",", ".")
                );

                if (!isNaN(valor)) {
                    total += valor;
                }
            });

            $("#lblSubtotal").text(
                `$ ${total.toFixed(2).replace(".", ",")}`
            );
        }


        // ====================================================
        // FOCO EN CANTIDAD TODO: VALIDAR SI EL PRODUCTO EXISTE
        // ====================================================
        $("#inputCodigo").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                clearTimeout(typingTimer); // 🔥 CLAVE (cancelar debounce)
                enterDesdeTecladoVirtual = false;
                manejarEnter();
            }
        });


        // ====================================================
        // BUSCAR PRODUCTO (ya lo usás)
        // ====================================================
        function seleccionarProducto(data) {
            productoSeleccionado = data;
        }

        // ====================================================
        // AGREGAR CUANDO PRESIONA ENTER EN CANTIDAD
        // ====================================================
        $("#inputCantidad").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                agregarProducto();
            }
        });

        $("#btnAgregarProducto").on("click", function () {
            agregarProducto();
        });

        // ====================================================
        // FUNCIÓN PRINCIPAL PARA AGREGAR
        // ====================================================
        function agregarProducto() {

            if (!productoSeleccionado) {
                alert("Selecciona un producto primero");
                volverACodigo();
                return;
            }

            let cantidad = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cantidad) || cantidad <= 0) {
                alert("Cantidad inválida");
                return;
            }
            // ===== SIMULACIÓN BACKEND =====

            const subtotal = cantidad * productoSeleccionado.precioKg;

            const linea = {
                index: indexLinea++,
                producto: productoSeleccionado.nombre,
                codigo: productoSeleccionado.codigo,
                cant: cantidad.toFixed(3),
                precio: `$ ${productoSeleccionado.precioKg.toFixed(2)}`,
                subtotal: `$ ${(subtotal).toFixed(2)}`
            };

            carrito.push(linea);

            // simula respuesta del backend
            const r = {
                ok: true,
                lineas: carrito
            };

            // mismo flujo que AJAX success
            renderTablaProductos(r.lineas);

            // recalcular total
            recalcularTotal();

            // limpiar campos
            $("#inputCodigo").val("").focus();
            $("#inputCantidad").val("");
            $("#prodSubtotal").text("$ 0,00");

            productoSeleccionado = null;
            mostrarEsperando();
                      
        }

        // ====================================================
        // RENDER DE LA TABLA (mantiene tu diseño)
        // ====================================================
        function renderTablaProductos(lineas) {

            let tbody = $("#tablaItems");
            tbody.empty();

            if (!lineas || lineas.length === 0) {
                tbody.append(`
                                <tr id="filaVacia">
                                    <td class="text-muted text-center py-3">
                                        No hay productos agregados
                                    </td>
                                </tr>
                            `);
                return;
            }

            lineas.forEach(l => {
                tbody.append(`
                                <tr data-id="${l.index}" class="fila-item">
                                    <td>
                                        <div class="fw-bold">
                                            #${l.index} <strong>${l.producto}</strong> (cod: ${l.codigo})
                                        </div>

                                        <div class="d-flex justify-content-between item-detalle">
                                            <span >&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${l.cant} x ${l.precio}</span>
                                            <span class="fw-bold">${l.subtotal}</span>
                                        </div>
                                    </td>
                                </tr>
                            `);
            });
        }

        // Fullscreen toggle
        document.getElementById('btn-toggle-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
        });

        ////TECLADO
        let inputActivo = null;

        document.addEventListener("focusin", e => {
            if (e.target.tagName === "INPUT") {
                inputActivo = e.target;
            }
        });

        // Manejo de teclas del teclado virtual
        document.querySelectorAll(".btn-key").forEach(btn => {
            btn.addEventListener("click", () => {
                const tecla = btn.innerText.trim();
                if (!inputActivo) return;

                switch (tecla) {
                    case "←":
                        borrarCaracter();
                        break;

                    case "Enter":
                        enterDesdeTecladoVirtual = true;
                        manejarEnter();
                        break;

                    case "×":
                        escribirX();
                        break;

                    default:
                        escribirCaracter(tecla);
                        break;
                }
            });
        });

        function volverACodigo() {
            $("#inputCodigo").focus().select();
        }

        function pasarAFocoCantidad() {
            $("#inputCantidad").focus().select();
        }

        function escribirCaracter(valor) {
            if (!inputActivo) return;

            if (inputActivo.id === "inputCantidad") {

                // solo números o punto
                if (!/^[0-9.]$/.test(valor)) return;

                // evitar doble punto
                if (valor === "." && inputActivo.value.includes(".")) return;

                // si empieza con punto, anteponer 0
                if (valor === "." && inputActivo.value === "") {
                    inputActivo.value = "0";
                }
            }

            inputActivo.value += valor;

            //si cantidad tiene el foco
            if (inputActivo.id === "inputCantidad")
                calcularSubtotal();
            else
                terminarEscritura(inputActivo.value);
        }

        function escribirX() {
            if (inputActivo.id !== "inputCodigo") return;

            // Solo una X
            if (inputActivo.value.includes("X")) return;

            inputActivo.value += "X";
        }

        function borrarCaracter() {
            if (!inputActivo) return;

            inputActivo.value = inputActivo.value.slice(0, -1);
            terminarEscritura(inputActivo.value);
        }

        
        function manejarEnter() {

            if (!inputActivo) return;

            if (inputActivo.id === "inputCantidad") {
                agregarProducto();
                enterDesdeTecladoVirtual = false;
                return;
            }

            if (enterDesdeTecladoVirtual || inputActivo.id === "inputCodigo") {
                procesarCodigoConCantidad();

                if (ingresoCantidadX) {
                    ingresoCantidadX = false;
                    enterDesdeTecladoVirtual = false;
                    return;
                }

                pasarAFocoCantidad();
                return;
            }

        }


        function procesarCodigoConCantidad() {

            const codigoInput = document.getElementById("inputCodigo");
            const valor = codigoInput.value.toUpperCase();

            if (!valor.includes("X")) return;

            const partes = valor.split("X");
            if (partes.length !== 2) return;

            const cantidad = partes[0];
            const codigo = partes[1];

            if (!cantidad || !codigo) return;

            $("#inputCantidad").val(cantidad);
            codigoInput.value = codigo;

            terminarEscritura(codigo, function () {
                // 👇 se ejecuta CUANDO el producto YA está cargado
                agregarProducto();
                mostrarEsperando();
            });

            ingresoCantidadX = true;
        }

    </script>
}

<style>
    .fila-item {
        cursor: pointer;
    }

        .fila-item:hover {
            background: #f2f2f2;
        }

    .tabla-productos td {
        border: none;
        padding-bottom: 1rem;
        padding-top: 0.5rem;
    }

    .item-detalle {
        font-size: 0.95rem;
        color: #444;
    }


    .keyboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(4, 60px);
        gap: 8px;
    }

    /* Botones normales */
    .btn-key {
        height: 100%;
        font-size: 1.2rem;
        font-weight: 600;
    }

    /* ENTER ocupa 2 filas */
    .btn-enter {
        grid-row: span 2;
        font-size: 1.1rem;
        font-weight: bold;
    }

    /* El 0 ocupa 2 columnas */
    .key-zero {
