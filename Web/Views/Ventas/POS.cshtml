    window.POSModalLoading = window.POSModalLoading || (function ($) {
        function getOverlay() {
            return $('#posModalLoading');
        }

        function show(message) {
            var $overlay = getOverlay();
            if (!$overlay.length) return;

            $overlay.find('[data-loading-text]').text(message || 'Cargando solicitud...');
            $overlay.stop(true, true).fadeIn(120).attr('aria-hidden', 'false');
        }

        function hide() {
            var $overlay = getOverlay();
            if (!$overlay.length) return;

            $overlay.stop(true, true).fadeOut(120).attr('aria-hidden', 'true');
        }

        function html(message) {
            var texto = message || 'Cargando...';
            return '<div class="p-4 text-center text-muted">'
                + '<div class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></div>'
                + texto
                + '</div>';
        }

        return {
            show: show,
