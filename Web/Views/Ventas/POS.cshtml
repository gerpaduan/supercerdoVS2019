@Html.Partial("~/Views/Ventas/_FormaPagoModal.cshtml")

<!-- INICIO AYUDA POS -->
<style>
    .pos-help-modal .modal-dialog {
        max-width: 820px;
    }

    .pos-help-modal .modal-header {
        background: #f8f9fa;
    }

    .pos-help-title {
        font-weight: 700;
        margin: 0;
    }

    .pos-help-subtitle {
        font-size: .92rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .pos-help-grid .col-12 {
        margin-bottom: .75rem;
    }

    .pos-help-action {
        text-align: left;
        min-height: 62px;
        border-radius: 10px;
    }

        .pos-help-action .pos-help-action-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: .75rem;
            width: 100%;
        }

        .pos-help-action .pos-help-label {
            font-weight: 600;
            line-height: 1.2;
        }

        .pos-help-action .pos-help-key {
            white-space: nowrap;
            font-size: .82rem;
            padding: .4rem .55rem;
            border-radius: .5rem;
        }

    .pos-help-note {
        font-size: .9rem;
    }

    @@media (max-width: 576px) {
        .pos-help-action {
            min-height: 58px;
            padding-top: .75rem;
            padding-bottom: .75rem;
        }

            .pos-help-action .pos-help-label {
                font-size: .95rem;
            }
    }
</style>

<div class="modal fade pos-help-modal" id="modalAyudaPOS" tabindex="-1" role="dialog" aria-labelledby="modalAyudaPOSTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title pos-help-title" id="modalAyudaPOSTitle">
                    <i class="fas fa-keyboard mr-2"></i>Ayuda y atajos del POS
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="modal-body">
                @*<div class="alert alert-light pos-help-note mb-3">
                        En <strong>PC</strong> podés usar los atajos del teclado. En <strong>celular</strong>, tocá una acción para ejecutar lo mismo.
                    </div>

                    <div class="pos-help-subtitle">
                        F1 abre o cierra esta ayuda.
                    </div>*@

                <div class="row pos-help-grid">
                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-primary btn-block pos-help-action" data-accion="Home">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Foco en código</span>
                                <span class="badge badge-primary pos-help-key">Inicio</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-success btn-block pos-help-action" data-accion="End">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Finalizar venta</span>
                                <span class="badge badge-success pos-help-key">Fin</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="F2">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Cuentas corrientes</span>
                                <span class="badge badge-secondary pos-help-key">F2</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="F3">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Cálculo de billetes</span>
                                <span class="badge badge-secondary pos-help-key">F3</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="F5">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Nueva compra</span>
                                <span class="badge badge-secondary pos-help-key">F5</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="F6">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Mis egresos caja</span>
                                <span class="badge badge-secondary pos-help-key">F6</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="F7">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Egresos caja</span>
                                <span class="badge badge-secondary pos-help-key">F7</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-secondary btn-block pos-help-action" data-accion="AvPag">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Expendios</span>
                                <span class="badge badge-secondary pos-help-key">AvPág/PgDn</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-primary btn-block pos-help-action" data-accion="F9">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Buscar cliente</span>
                                <span class="badge badge-primary pos-help-key">F9</span>
                            </span>
                        </button>
                    </div>

                    <div class="col-12 col-md-6">
                        <button type="button" class="btn btn-outline-primary btn-block pos-help-action" data-accion="F10">
                            <span class="pos-help-action-inner">
                                <span class="pos-help-label">Buscar producto</span>
                                <span class="badge badge-primary pos-help-key">F10</span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <small class="text-muted">Esc cierra la ayuda.</small>
                <button type="button" class="btn btn-primary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<!-- FIN AYUDA POS -->


@section Scripts {
    <script>


    $(function () {

         // -----------------------
    // Helpers
    // -----------------------
    function pad(n) { return (n < 10 ? "0" : "") + n; }

    // dd/MM/yyyy HH:mm
    function nowAR() {
        var d = new Date();
        return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear()
            + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
    }

    function mostrarError(msg) {
        if (window.Swal) {
            Swal.fire({ icon: 'error', title: 'No se pudo abrir la caja', text: msg || 'Error' });
        } else {
            alert(msg || 'No se pudo abrir la caja');
        }
    }

    // -----------------------
    // Acción Abrir Caja (llama al controller)
    // -----------------------
    window.abrirCaja = function () {
        var cajaInicio = $("#montoInicial").val();
        var fechaHora = $("#fechaHoraApertura").val();

        $.ajax({
            url: '@Url.Action("AbrirCaja", "Cajas")',
            type: 'POST',
            dataType: 'json',
            data: { cajaInicio: cajaInicio, fechaHora: fechaHora },
            success: function (r) {
                if (r && r.ok) {
                    // ✅ Ya se abrió: recargo el POS (ahora el controller debería dejarte entrar)
                    $("#modalAbrirCaja").modal('hide');
                    location.reload();
                    return;
                }

                // ❌ No abrió: muestro error y me quedo en el modal
                mostrarError((r && r.mensaje) ? r.mensaje : "Error al abrir caja.");
            },
            error: function () {
                mostrarError("No se pudo contactar al servidor.");
            }
        });
    };

    // -----------------------
    // Init
    // -----------------------
    $(function () {

        // Si el controller te setea ViewBag.CajaAbierta (como ya haces):
        var cajaAbierta = @((ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta) ? "true" : "false");

        if (!cajaAbierta) {
            // seteo fecha/hora y abro modal
            $("#fechaHoraApertura").val(nowAR());

            $("#modalAbrirCaja").modal('show');

            $("#modalAbrirCaja").on("shown.bs.modal", function () {
                $("#montoInicial").trigger("focus");
            });

            // Cancelar => volver al Index (layout base)
            $("#btnCancelarAbrirCaja").off("click").on("click", function () {
                window.location.href = '@Url.Action("Index", "Home")';
            });

            // Enter en monto => abrir caja
            $("#montoInicial").off("keydown").on("keydown", function(e){
                if (e.key === "Enter") {
                    e.preventDefault();
                    window.abrirCaja();
                }
                if (e.key === "Escape") {
                    e.preventDefault();
                    $("#btnCancelarAbrirCaja").click();
                }
            });
        }

    });


        // ✅ Guard: si NO está el POS renderizado, NO ejecuto el script del POS
        if (!document.getElementById("pos-app") || !document.getElementById("inputCodigo")) {
            console.warn("POS script: no está el HTML del POS (caja cerrada o vista distinta).");
            return;
        }

    document.addEventListener("click", habilitarAudio, { once: true });

    function habilitarAudio() {
        const audio = document.getElementById("beep");
        audio.volume = 0;
        audio.play().finally(() => {
            audio.pause();
            audio.currentTime = 0;
            audio.volume = 1;
        });
    }

    // VARIABLES
    let stream = null;
    let track = null;
    let detector = null;
    let scanning = false;
    let esEAN = false;
    let ultimoCodigo = null;
    let ultimoTiempo = 0;
    const TIEMPO_RELECTURA = 2000;
    const video = document.getElementById("videoScanner");

    const scanner = new BarcodeScanner({
            videoSelector: "#videoScanner",
            containerSelector: "#scannerContainer",
            onCodeDetected: function (codigo) {
                document.querySelector("#inputCodigo").value = codigo;
                document.querySelector("#inputCodigo").focus();
                manejarEnter();
                // si querés cerrar al detectar:
                // scanner.cerrar();
            }
        });
        document.getElementById("btnScanner")?.addEventListener("click", () => scanner.iniciar());
        document.getElementById("btnCerrarScanner")?.addEventListener("click", () => scanner.cerrar());

        document.getElementById("btnFlash")?.addEventListener("click", async () => {
            const estado = await scanner.toggleFlash();

            // feedback visual opcional
            const btn = document.getElementById("btnFlash");
            if (estado) {
                btn.classList.remove("btn-secondary");
                btn.classList.add("btn-warning");
                btn.textContent = "🔦 Flash ON";
            } else {
                btn.classList.remove("btn-warning");
                btn.classList.add("btn-secondary");
                btn.textContent = "🔦 Flash";
            }
        });


    // BEEP
    function beep() {
        const audio = document.getElementById("beep");
        if (!audio) return;
        audio.currentTime = 0;
        audio.play();
    }

    // URLs
    window.api = window.api || {};
    window.api.producto = window.api.producto || {};
    window.api.producto.listar = '@Url.Action("ListarParaPOS", "Productos")';

    function abrirBuscadorProductosPOS() {
        if (typeof window.abrirBuscarProductoModal !== "function") {
            alert("No se pudo abrir el buscador de productos. Verificá que el script global del modal esté cargado.");
            return;
        }

        // Evita que quede “activo” el input del POS mientras el modal está abierto
        inputActivo = null;

        window.abrirBuscarProductoModal({
            modalSelector: "#modalBuscarProducto",
            mostrarPrecio: true, // en POS normalmente sí
            onSelect: function (producto) {
                const codigo = String((producto && producto.codigo) || "").trim();
                if (!codigo) {
                    volverACodigo();
                    return;
                }

                // Cargar código en POS
                $("#inputCodigo").val(codigo);
                clearTimeout(typingTimer);

                // Buscar el producto en el backend y seguir flujo normal POS
                terminarEscritura(codigo, function (ok) {
                    // Si terminarEscritura devolvió error lógico
                    if (ok === false) {
                        volverACodigo();
                        return;
                    }

                    // Validación de que realmente quedó seleccionado el mismo código
                    const codigoActual = normalizarEntrada($("#inputCodigo").val());
                    const codigoProducto = normalizarEntrada(productoSeleccionado?.codigo);

                    if (!codigoProducto || codigoProducto !== codigoActual) {
                        mostrarSinCoincidencia();
                        productoSeleccionado = null;
                        volverACodigo();
                        return;
                    }

                    // Si tu lógica EAN autoagrega, no forzamos foco en cantidad
                    if (typeof esEANValido === "function" && esEANValido(codigoActual)) {
                        return;
                    }

                    pasarAFocoCantidad();
                });
            }
        });
    }

    $('#btnAgregarManual').off('click').on('click', function (e) {
        e.preventDefault();
        abrirBuscadorProductosPOS();
    });

    let typingTimer = null;
    let productoSeleccionado = null;
    let precioActual = 0;

    let buscandoProducto = false;
    let ultimoCodigoPedido = null;
    let reqProducto = null;

    const norm = (x) => String(x ?? "").trim();

    // ===== ESTADO POS EN MEMORIA =====
    let carrito = [];
    window.lineasVenta = carrito;
    window.fechaVenta = new Date();
    let indexLinea = 1;
    let ingresoCantidadX = false;
    let enterDesdeTecladoVirtual = false;
    let lineaSeleccionada = null;

    (function () {
        const dias = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
        const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

        function actualizarFechaHora() {
            if (!(carrito.length === 0 || carrito.length === 1)) return;

            const ahora = new Date();
            const fechaSql = ahora.toISOString().slice(0, 19);
            $('#fechaVenta').val(fechaSql);

            const diaSemana = dias[ahora.getDay()];
            const dia = ahora.getDate();
            const mes = meses[ahora.getMonth()];
            const anio = ahora.getFullYear();

            const hora = String(ahora.getHours()).padStart(2, '0');
            const minutos = String(ahora.getMinutes()).padStart(2, '0');

            const formato = `${diaSemana} ${dia} de ${mes}, ${anio} · ${hora}:${minutos}`;

            const span = document.getElementById('fechaHoraPOS');
            if (span) span.innerText = formato;
        }

        actualizarFechaHora();
        setInterval(actualizarFechaHora, 60000);
    })();

    // BUSCAR PERSONA
    $(document).on('click', '#btnBuscarPersona', function () {
        $('#contenedorModalPersona').load(window.api.persona.buscar, function () {
            $('#modalBuscarPersona').modal('show');
            cargarPersonas();
        });
    });

    $('#btnConsumidorFinal').on('click', function () {
        $('#idPersona').val('@Entidades.Persona.idConsumidorFinal');
        $('#razonSocial').val('Consumidor Final');
    });

    // BÚSQUEDA EN VIVO
    $("#inputCodigo").on("keyup", function (e) {
        let cod = this.value.trim().toUpperCase();

        if (e.key === "Enter") {
            clearTimeout(typingTimer);
            return;
        }

        if (cod.includes("X")) {
            mostrarSinCoincidencia();
            clearTimeout(typingTimer);
            return;
        }

        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => {
            terminarEscritura(cod);
        }, 250);
    });

    document.addEventListener("keydown", function (e) {
        if ($(".modal.show").length) return;

        if (e.key === "End") {
            e.preventDefault();
            const btn = document.getElementById("btnFinalizar");
            if (btn && !btn.disabled) btn.click();
        }

        if (e.key === "Home") {
            e.preventDefault();
            const inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch { }
            }
        }

        if (e.key === "F9" || e.key === "F10") e.preventDefault();
        else return;

        if (e.key === "F9") {
            const btn = document.getElementById("btnBuscarPersona");
            if (btn && !btn.disabled) btn.click();
            return;
        }

        if (e.key === "F10") {
            const btn = document.getElementById("btnAgregarManual");
            if (btn && !btn.disabled) abrirBuscadorProductosPOS();
            return;
        }
    });

        // ===============================
        // Helpers robustos (X / x / × + float)
        // ===============================
        function normalizarEntrada(raw) {
            return String(raw ?? "")
                .trim()
                .toUpperCase()
                .replace(/×/g, "X"); // por si viene el símbolo de multiplicación
        }

        function parseFloatAR(s) {
            const n = parseFloat(String(s ?? "").trim().replace(",", "."));
            return Number.isFinite(n) ? n : NaN;
        }

        // Devuelve { cant, codigo } o null
        function parseCantidadXCodigo(entrada) {
            const s = normalizarEntrada(entrada);

            // cantidad puede ser float: 1,25 o 1.25
            // codigo: lo que venga después de la X (no vacío)
            const m = s.match(/^([0-9]+(?:[.,][0-9]+)?)X(.+)$/);
            if (!m) return null;

            const cant = parseFloatAR(m[1]);
            const codigo = String(m[2] ?? "").trim();

            if (!codigo) return null;
            if (!Number.isFinite(cant) || cant <= 0) return null;

            return { cant, codigo};
        }

        // ===============================
        // terminarEscritura (AHORA con flag ingresoCantidadXParam)
        // ===============================
        function terminarEscritura(codigo, callback = null, ingresoCantidadXParam = false) {

            const codigoTrim = normalizarEntrada(codigo);

            // Sin código → estado inicial
            if (!codigoTrim) {
                mostrarEsperando();
                return;
            }

            // Si existe un request anterior y lo estás usando, abortalo (opcional, no rompe si no existía)
            if (typeof reqProducto !== "undefined" && reqProducto && reqProducto.readyState !== 4) {
                reqProducto.abort();
            }

            // Si usás estas banderas en tu script, las mantenemos (no rompe si no existen)
            if (typeof buscandoProducto !== "undefined") buscandoProducto = true;
            if (typeof ultimoCodigoPedido !== "undefined") ultimoCodigoPedido = codigoTrim;

            reqProducto = $.ajax({
                url: window.buscarProductoUrl,
                type: "GET",
                dataType: "json",
                data: {
                    codigo: codigoTrim,
                    ingresoCantidadX: ingresoCantidadXParam
                },
                timeout: 3000,

                success: function (data) {

                    if (typeof buscandoProducto !== "undefined") buscandoProducto = false;

                    // Si tenés control anti-respuesta vieja, respetalo (no rompe si no existe)
                    if (typeof ultimoCodigoPedido !== "undefined") {
                        const codigoActual = normalizarEntrada($("#inputCodigo").val());
                        if (codigoActual !== ultimoCodigoPedido) return;
                    }

                    if (data && data.success === false) {
                        productoSeleccionado = null;
                        mostrarSinCoincidencia(data.message);

                        if (typeof callback === "function") callback(false, data);
                        return;
                    }


                    productoSeleccionado = data;
                    mostrarProducto(data);

                    //validar si es EAN agregar
                    if (typeof esEANValido === "function" && esEANValido(codigoTrim)) {
                        $("#inputCantidad").val("1");
                        document.querySelector("#inputCantidad").focus();
                        manejarEnter();
                    }

                    if (typeof callback === "function") callback();
                },

                error: function (xhr, status) {

                    if (status === "abort") return;
                    if (typeof buscandoProducto !== "undefined") buscandoProducto = false;

                    if (status === "timeout") {
                        mostrarErrorConexion("La conexión es lenta. Reintente.");
                        return;
                    }

                    if (!navigator.onLine) {
                        mostrarErrorConexion("Sin conexión a Internet");
                        return;
                    }

                    mostrarErrorConexion("No se pudo contactar al servidor");
                }
            });
        }

        window.terminarEscritura = terminarEscritura;

        // ===============================
        // procesarCodigoConCantidad (DEVUELVE true si disparó auto-agregado)
        // ===============================
        function procesarCodigoConCantidad() {

            const input = document.getElementById("inputCodigo");
            if (!input) return false;

            const entrada = normalizarEntrada(input.value);

            // 1) Formato: cantidadXcodigo  (2X123, 1.25X779, 1,25X779)
            const parsed = parseCantidadXCodigo(entrada);
            if (parsed) {

                $("#inputCantidad").val(String(parsed.cant));
                $("#inputCodigo").val(parsed.codigo);

                // auto agrega al terminar de buscar
                terminarEscritura(parsed.codigo, function () {
                    agregarProducto();
                    mostrarEsperando();
                }, true);

                return true;
            }

            // 2) Si es EAN válido (escaneo / ingreso directo): auto agrega con cantidad 1
            //    OJO: esto mantiene tu comportamiento anterior (scanner => agrega 1)
            if (typeof esEANValido === "function" && esEANValido(entrada)) {

                $("#inputCantidad").val("1");
                $("#inputCodigo").val(entrada);

                terminarEscritura(entrada, function () {
                    agregarProducto();
                    mostrarEsperando();
                }, true);

                return true;
            }

            return false; // no era auto-agregado
        }

        // ===============================
        // manejarEnter (usa procesarCodigoConCantidad robusto)
        // ===============================
        function manejarEnter() {

            if (!inputActivo) return;

            // ENTER en cantidad => agregar
            if (inputActivo.id === "inputCantidad") {
                agregarProducto();
                enterDesdeTecladoVirtual = false;
                return;
            }

            // ENTER en código
            if (enterDesdeTecladoVirtual || inputActivo.id === "inputCodigo") {

                // 1) Intentar auto-agregado por cantidadXcodigo o EAN
                const auto = procesarCodigoConCantidad();
                enterDesdeTecladoVirtual = false;

                if (auto) return;

                // 2) Búsqueda normal (sin auto-agregado)
                const codigoInput = normalizarEntrada($("#inputCodigo").val());

                // si aún contiene X, es que escribieron mal (ej: "2X" o "X123")
                if (codigoInput.includes("X")) {
                    mostrarSinCoincidencia("Formato inválido (use 2X123)");
                    return;
                }

                if (typeof buscandoProducto !== "undefined" && buscandoProducto) return;

                terminarEscritura(codigoInput, function () {

                    const codigoActual = normalizarEntrada($("#inputCodigo").val());
                    const codigoProducto = normalizarEntrada(productoSeleccionado?.codigo);

                    if (!codigoProducto || codigoProducto !== codigoActual) {
                        mostrarSinCoincidencia();
                        productoSeleccionado = null;
                        return;
                    }

                    pasarAFocoCantidad();
                });

                return;
            }
        }


    function mostrarErrorConexion(msg) {
        Swal.fire({
            icon: 'error',
            title: 'Sin conexión',
            text: msg,
            allowOutsideClick: false
        });
    }

    function mostrarProducto(p) {
        $("#prodNombre").text(p.nombre).removeClass("text-muted").addClass("fw-bold");
        $("#prodPrecio").text("$ " + p.precioKg.toLocaleString("es-AR")).removeClass("text-muted").addClass("fw-bold");

        precioActual = p.precioKg;

        $("#inputCantidad").prop("disabled", false);
        $("#prodSubtotal").text("$ 0,00");
        calcularSubtotal();
        $("#btnAgregarProducto").prop("disabled", false);
    }

    function mostrarSinCoincidencia(msg = "Sin coincidencia") {
        productoSeleccionado = null;
        precioActual = 0;

        $("#prodNombre").text(msg).removeClass("fw-bold").addClass("text-muted");
        $("#prodPrecio").text("").addClass("text-muted");
        $("#prodSubtotal").text("$ 0,00");

        $("#inputCantidad").prop("disabled", true).val("");
        $("#btnAgregarProducto").prop("disabled", true);

        $("#inputCodigo").focus();
    }

    function mostrarEsperando() {
        productoSeleccionado = null;
        precioActual = 0;

        $("#prodNombre").text("Info producto...").removeClass("fw-bold").addClass("text-muted");
        $("#prodPrecio").text("");
        $("#prodSubtotal").text("$ 0,00");
        $("#inputCantidad").prop("disabled", true).val("");
        $("#btnAgregarProducto").prop("disabled", true);
    }

    function mostrarBuscando(msg = "Buscando...") {
        productoSeleccionado = null;
        precioActual = 0;

        $("#prodNombre").text(msg).removeClass("fw-bold").addClass("text-muted");
        $("#prodPrecio").text("").addClass("text-muted");
        $("#prodSubtotal").text("$ 0,00");
        $("#inputCantidad").prop("disabled", true).val("");
        $("#btnAgregarProducto").prop("disabled", true);
    }

    $("#inputCantidad").on("input", calcularSubtotal);

    function calcularSubtotal() {
        let cant = parseFloat($("#inputCantidad").val().replace(",", "."));

        if (isNaN(cant) || cant <= 0 || precioActual <= 0) {
            $("#prodSubtotal").text("$ 0,00");
            $("#btnAgregarProducto").prop("disabled", true);
            return;
        }

        let subtotal = cant * precioActual;

        $("#prodSubtotal").text(
            "$ " + subtotal.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        );

        $("#btnAgregarProducto").prop("disabled", false);
    }

    function recalcularTotal() {
        let total = 0;

        carrito.forEach(l => {
            if (!l.anulado) {
                const valor = parseFloat(l.subtotal.replace("$", "").replace(",", "."));
                if (!isNaN(valor)) total += valor;
            }
        });

        $("#lblSubtotal").text(`$ ${total.toFixed(2).replace(".", ",")}`);
    }

    // ENTER en código
    $("#inputCodigo").on("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            clearTimeout(typingTimer);
            enterDesdeTecladoVirtual = false;
            manejarEnter();
        }
    });

    // ENTER en cantidad
    $("#inputCantidad").on("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            agregarProducto();
        }
    });

    $("#btnAgregarProducto").on("click", function () {
        agregarProducto();
    });

    // ====================================================
    // ✅ AGREGAR PRODUCTO (con scroll correcto)
    // ====================================================
    function agregarProducto() {
        if (!productoSeleccionado) {
            //alert("Selecciona un producto primero");
            volverACodigo();
            return;
        }

        let cantidad = parseFloat($("#inputCantidad").val().replace(",", "."));
        if (isNaN(cantidad) || cantidad <= 0) {
            alert("Cantidad inválida");
            return;
        }

        const subtotal = cantidad * productoSeleccionado.precioKg;

        if (!Number.isFinite(subtotal) || subtotal <= 0) {
            alert("No se puede agregar: el producto no tiene precio cargado (debe ser mayor a 0).");
            volverACodigo(); // opcional: vuelve al input código
            return;
        }

        const linea = {
            index: indexLinea++,
            producto: productoSeleccionado.nombre,
            codigo: productoSeleccionado.codigo,
            cant: cantidad.toFixed(3),
            precio: `$ ${productoSeleccionado.precioKg.toFixed(2)}`,
            precioOriginal: `$ ${productoSeleccionado.precioOriginal.toFixed(2)}`,
            subtotal: `$ ${(subtotal).toFixed(2)}`,
            bonificacion: 0,
            anulado: false,
            balanza: productoSeleccionado.balanza
        };

        carrito.push(linea);

        renderTablaProductos(carrito);
        recalcularTotal();
        beep();
        navigator.vibrate?.(80);

        // ✅ Scroll/foco al último agregado (cuando el DOM ya pintó)
        requestAnimationFrame(() => {
            scrollTablaAlFinal();
            // mantiene tu experiencia mobile (si aplica)
            setTimeout(scrollPantallaMobile, 50);
        });


        // limpiar campos
        $("#inputCodigo").val("").focus();
        $("#inputCantidad").val("");
        $("#prodSubtotal").text("$ 0,00");

        actualizarEstadoVentaEnCurso();
        productoSeleccionado = null;
        mostrarEsperando();
    }

    function renderTablaProductos(lineas) {
        let tbody = $("#tablaItems");
        tbody.empty();

        if (!lineas || lineas.length === 0) {
            tbody.append(`
                <tr id="filaVacia">
                    <td class="text-muted text-center py-3">
                        No hay productos agregados
                    </td>
                </tr>
            `);
            return;
        }

        lineas.forEach(l => {
            const claseAnulada = l.anulado ? 'fila-anulada' : '';
            const bonificacion = l.bonificacion == 0 ? '' : (l.bonificacion > 0 ?
                ' | Bonif:' + l.bonificacion + '%' :
                ' | Recargo:' + (l.bonificacion * -1) + '%');

            tbody.append(`
                <tr data-id="${l.index}" class="fila-item ${claseAnulada}">
                    <td>
                        <div class="fw-bold">
                            #${l.index} <strong>${l.producto}</strong> (cod: ${l.codigo})
                        </div>

                        <div class="d-flex justify-content-between item-detalle">
                            <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${l.cant} x ${l.precio} ${bonificacion}</span>
                            <span class="fw-bold">${l.subtotal}</span>
                        </div>
                    </td>
                </tr>
            `);
        });

        // ✅ marca visual del último item
        tbody.find("tr.fila-item").removeClass("fila-ultimo");
        tbody.find("tr.fila-item:last").addClass("fila-ultimo");
    }

        function scrollTablaAlFinal() {
            const isDesktop = window.matchMedia('(min-width: 992px)').matches;

            const zonaTabla = document.querySelector('.carrito-col .zona-tabla');
            const tbody = document.getElementById('tablaItems');
            if (!tbody) return;

            const ultimaFila = tbody.querySelector('tr.fila-item:last-child');
            if (!ultimaFila) return;

            // ✅ Marca visual + foco real (sin “saltar” el scroll)
            tbody.querySelectorAll('tr.fila-item').forEach(tr => tr.classList.remove('fila-ultimo', 'pos-last-added'));
            ultimaFila.classList.add('fila-ultimo', 'pos-last-added');

            // hacerlo focusable y darle foco (foco real en el último agregado)
            ultimaFila.tabIndex = -1;
            try { ultimaFila.focus({ preventScroll: true }); }
            catch { try { ultimaFila.focus(); } catch { } }

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const behavior = reduceMotion ? 'auto' : 'smooth';

            if (isDesktop && zonaTabla) {
                // ✅ Desktop: scroll interno SOLO en zona-tabla (Total no se pierde)
                zonaTabla.scrollTo({ top: zonaTabla.scrollHeight, behavior });
            } else {
                // ✅ Responsive: se scrollea la página al último item
                ultimaFila.scrollIntoView({ behavior, block: 'start' });
            }

            // quitar resaltado al rato (opcional)
            setTimeout(() => ultimaFila.classList.remove('pos-last-added'), 900);

            volverACodigo();
        }


