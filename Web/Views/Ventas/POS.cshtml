                }

                if ($("#modalFinanzasPOS").hasClass("show")) {
                    $("body").addClass("modal-open");
                    return;
                }

                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorFinanzasPOS").html("");

            setTimeout(function () {
                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("shown.bs.modal", function () {
            function enfocarBuscadorCtas() {
                var input = document.getElementById("txtBuscar");
                if (!input) return;
                input.focus();
                try { input.select(); } catch { }
            }

            setTimeout(enfocarBuscadorCtas, 0);
            setTimeout(enfocarBuscadorCtas, 140);
            setTimeout(enfocarBuscadorCtas, 300);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const $modalFinanzas = $('#modalFinanzasPOS');
                const $modalActivo = $('.modal.show').last();



                if ($modalFinanzas.hasClass('show') && $modalActivo.is($modalFinanzas)) {
                    $modalFinanzas.modal('hide');
                }
            }
        });

    });
    // FIN FINANZAS POS
    </script>
}

