@model Entidades.Venta

@{ ViewBag.Title = "CarniSys web | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";

    bool cajaAbierta = ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta;
}


<style>
    /* =============================
    FIX REAL PARA SB ADMIN 2 POS
    ============================= */


    #pos-app {
        height: 85vh;
        display: flex;
        flex-direction: column;
    }


        /* Card del POS */
        #pos-app > .card {
            /*flex: 1;
             overflow: auto;*/
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        #pos-app .card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* La fila principal */
        #pos-app .row.flex-grow-1 {
            flex: 1;
            min-height: 0;
        }

        /* Columna izquierda */
        #pos-app .carrito-col {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        /* SCROLL REAL */
        #pos-app .zona-tabla {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

    /* Total y botones no crecen */
    .zona-total,
    .zona-botones {
        flex-shrink: 0;
    }

    @@media (max-width: 992px) {
        /* La app deja de forzar altura */
        #pos-app {
            height: auto !important;
            min-height: auto !important;
        }

        #content {
            height: auto !important;
            min-height: auto !important;
        }
        /* La columna carrito deja de ser flex rígido */
        .carrito-col {
            display: block !important;
            height: auto !important;
            min-height: auto !important;
        }
        /* 🚫 SIN SCROLL interno */
        .zona-tabla {
            flex: none !important;
            overflow: visible !important;
            max-height: none !important;
            height: auto !important;
        }
        /* Total y botones pasan a flujo normal */
        .zona-total,
        .zona-botones {
            position: static !important;
        }
    }
</style>
