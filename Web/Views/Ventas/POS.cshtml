            $('#inputCodigo, #inputCantidad')
                .attr('readonly', true)
                .attr('inputmode', 'none');
        } else {
            $('#inputCodigo, #inputCantidad')
                .removeAttr('readonly')
                .removeAttr('inputmode');
        }
    }

    $(document).ready(configurarInputsPOS);
    $(window).on('resize', configurarInputsPOS);

    // URLs MVC
    window.api = window.api || {};
    window.api.venta = {
        finalizar: '@Url.Action("FinalizarVenta", "Ventas")',
        imprimir: '@Url.Action("ImprimirTicket", "Ventas")',
    };
    window.api.persona = {
        listar: '@Url.Action("Listar", "Personas")',
        buscar: '@Url.Action("Buscar", "Personas")'
    };

    // FULLSCREEN + recordar al recargar
    (function () {
        const FS_KEY = "carnisys-fullscreen";
        const root = document.documentElement;

        function isFullscreen() { return !!document.fullscreenElement; }

        function updateFullscreenUI() {
            const btn = document.getElementById("btn-toggle-fullscreen");
            if (!btn) return;

            const on = isFullscreen();
            btn.classList.toggle("is-fullscreen", on);

            const ico = btn.querySelector("i");
            if (ico) {
                ico.className = on ? "fas fa-compress-arrows-alt" : "fas fa-expand-arrows-alt";
            }

            btn.title = on ? "Salir de pantalla completa" : "Pantalla completa";
        }

        async function enterFullscreen() {
            try {
                if (root.requestFullscreen) await root.requestFullscreen();
                else if (root.webkitRequestFullscreen) root.webkitRequestFullscreen();

                localStorage.setItem(FS_KEY, "1");
                updateFullscreenUI();
                return true;
            } catch (e) {
                updateFullscreenUI();
                return false;
            }
        }

        async function exitFullscreen() {
            try {
                if (document.exitFullscreen) await document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            } catch (e) { }

            localStorage.removeItem(FS_KEY);
            updateFullscreenUI();
        }

        async function toggleFullscreen() {
            if (isFullscreen()) await exitFullscreen();
            else await enterFullscreen();
        }

        function wantFullscreen() { return localStorage.getItem(FS_KEY) === "1"; }

        function restoreFullscreenIfNeeded() {
            if (!wantFullscreen() || isFullscreen()) return;

            enterFullscreen().then(ok => {
                if (ok) return;

                const retryOnce = async () => { await enterFullscreen(); };
                document.addEventListener("click", retryOnce, { capture: true, once: true });
                document.addEventListener("keydown", retryOnce, { capture: true, once: true });
            });
        }

        document.addEventListener("fullscreenchange", function () {
            if (isFullscreen()) localStorage.setItem(FS_KEY, "1");
            else localStorage.removeItem(FS_KEY);

            updateFullscreenUI();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("btn-toggle-fullscreen");
            if (btn) btn.addEventListener("click", toggleFullscreen);

            updateFullscreenUI();
            restoreFullscreenIfNeeded();
        });
        })();

        // ================================
        // MODO COMPACTO AUTOMÁTICO (por alto)
        // - ayuda en 1366x768 / zoom 125%
        // ================================
        (function () {
            function aplicarCompacto() {
                const h = window.innerHeight || document.documentElement.clientHeight;

                // Ajustá umbrales si querés
                document.documentElement.classList.toggle("pos-compact", h < 820);
                document.documentElement.classList.toggle("pos-tiny", h < 740);
            }

            window.addEventListener("resize", aplicarCompacto);
            window.addEventListener("orientationchange", aplicarCompacto);
            document.addEventListener("DOMContentLoaded", aplicarCompacto);
            aplicarCompacto();
        })();


    });
    </script>

    <script>
        // INICIO AYUDA POS
        $(function () {
            if (!document.getElementById("pos-app")) return;

            window.posHotkeysHooks = window.posHotkeysHooks || {};

            function limpiarEstadoModalBootstrap() {
                $(".modal-backdrop").remove();
                $("body").removeClass("modal-open");
                $("body").css("padding-right", "");
            }

            function hayOtroModalAbierto() {
                return $(".modal.show").not("#modalAyudaPOS").length > 0;
            }

            function ayudaAbierta() {
                return $("#modalAyudaPOS").hasClass("show");
            }

            function focoCodigo() {
                var inp = document.getElementById("inputCodigo");
                if (inp) {
                    inp.focus();
                    try { inp.select(); } catch (e) { }
                }
            }

            function abrirAyudaPOS() {
                if (hayOtroModalAbierto()) return;
                $("#modalAyudaPOS").modal("show");
            }

            function cerrarAyudaPOS(callback) {
                var $modal = $("#modalAyudaPOS");

                if (!$modal.length) {
                    if (typeof callback === "function") callback();
                    return;
                }

                if (!$modal.hasClass("show")) {
                    limpiarEstadoModalBootstrap();
                    if (typeof callback === "function") {
                        setTimeout(function () {
                            callback();
                        }, 0);
                    }
                    return;
                }

                $modal
                    .off("hidden.bs.modal.posAyudaAccion")
                    .one("hidden.bs.modal.posAyudaAccion", function () {
                        limpiarEstadoModalBootstrap();

                        if (typeof callback === "function") {
                            setTimeout(function () {
                                callback();
                            }, 80);
                        }
                    });

                $modal.modal("hide");
            }

            function ejecutarHook(clave) {
                if (window.posHotkeysHooks && typeof window.posHotkeysHooks[clave] === "function") {
                    window.posHotkeysHooks[clave]();
                    return true;
                }

                $(document).trigger("pos:atajo:" + clave, [{ clave: clave }]);
                return false;
            }

            function ejecutarAccionAyuda(clave, cerrarModalPrimero) {
                var run = function () {
                    switch (clave) {
                        case "Home":
                            focoCodigo();
                            break;

                        case "End":
                            var btnFinalizar = document.getElementById("btnFinalizar");
                            if (btnFinalizar && !btnFinalizar.disabled) btnFinalizar.click();
                            break;

                        case "F9":
                            var btnBuscarPersona = document.getElementById("btnBuscarPersona");
                            if (btnBuscarPersona && !btnBuscarPersona.disabled) btnBuscarPersona.click();
                            break;

                        case "F10":
                            if (typeof abrirBuscadorProductosPOS === "function") {
                                abrirBuscadorProductosPOS();
                            }
                            break;

                        case "F2":
                            ejecutarHook("F2");
                            break;

                        case "F3":
                            ejecutarHook("F3");
                            break;

                        case "F5":
                            ejecutarHook("F5");
                            break;

                        case "F6":
                            ejecutarHook("F6");
                            break;

                        case "F7":
                            ejecutarHook("F7");
                            break;
                    }
                };

                if (cerrarModalPrimero && ayudaAbierta()) {
                    cerrarAyudaPOS(run);
                } else {
                    run();
                }
            }

            $(document)
                .off("click.posAyudaBtn", "#btnAyuda")
                .on("click.posAyudaBtn", "#btnAyuda", function (e) {
                    e.preventDefault();
                    abrirAyudaPOS();
                });

            $(document)
                .off("click.posAyudaAction", ".pos-help-action")
                .on("click.posAyudaAction", ".pos-help-action", function () {
                    var accion = $(this).data("accion");
                    ejecutarAccionAyuda(accion, true);
                });

            $("#modalAyudaPOS")
                .off("hidden.bs.modal.posAyuda")
                .on("hidden.bs.modal.posAyuda", function () {
                    setTimeout(function () {
                        limpiarEstadoModalBootstrap();

                        if (!$(".modal.show").length) {
                            focoCodigo();
                        }
                    }, 0);
                });

            document.addEventListener("keydown", function (e) {
                var key = e.key;
                var helpOpen = ayudaAbierta();
                var otherModalOpen = hayOtroModalAbierto();

                if (key === "F1") {
                    e.preventDefault();

                    if (helpOpen) {
                        cerrarAyudaPOS();
                    } else if (!otherModalOpen) {
                        abrirAyudaPOS();
                    }
                    return;
                }

                if (otherModalOpen && !helpOpen) {
                    return;
                }

                if (key === "F2" || key === "F3" || key === "F5" || key === "F6" || key === "F7") {
                    e.preventDefault();
                    ejecutarAccionAyuda(key, false);
                    return;
                }

                if (helpOpen) {
                    if (key === "Escape") {
                        e.preventDefault();
                        cerrarAyudaPOS();
                        return;
                    }

                    if (key === "Home" || key === "End" || key === "F9" || key === "F10") {
                        e.preventDefault();
                        ejecutarAccionAyuda(key, true);
                    }
                }
            }, true);

            /*
                HOOKS PARA CONECTAR DESPUÉS

                window.posHotkeysHooks.F2 = function () {
                    // Cuentas corrientes
                };

                window.posHotkeysHooks.F3 = function () {
                    // Cálculo de billetes
                };

                window.posHotkeysHooks.F5 = function () {
                    // Nueva compra
                };

                window.posHotkeysHooks.F6 = function () {
                    // Mis egresos caja
                };

                window.posHotkeysHooks.F7 = function () {
                    // Egresos caja
                };
            */
        });
        // FIN AYUDA POS
    </script>

    <script>
    // INICIO FINANZAS POS
    $(function () {
        if (!document.getElementById("pos-app")) return;

        function focoCodigoPOS() {
            var inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch (e) { }
            }
        }

        function renderConScripts(html) {
            var $contenedor = $("#contenedorFinanzasPOS");
            $contenedor.html(html);

            $contenedor.find("script").each(function () {
                var script = this;
                var src = script.getAttribute("src");

                if (src) {
                    if (document.querySelector('script[data-pos-loaded="' + src + '"]')) {
                        script.parentNode.removeChild(script);
                        return;
                    }

                    var nuevo = document.createElement("script");
                    nuevo.src = src;
                    nuevo.async = false;
                    nuevo.setAttribute("data-pos-loaded", src);
                    document.body.appendChild(nuevo);
                    script.parentNode.removeChild(script);
                    return;
                }

                $.globalEval(script.text || script.textContent || script.innerHTML || "");
                script.parentNode.removeChild(script);
            });
        }

        function mostrarErrorFinanzas(msg) {
            var html = '<div class="alert alert-danger m-3 mb-0">' + msg + '</div>';
            $("#contenedorFinanzasPOS").html(html);
        }

        window.POSFinanzas = {
            cargar: function (url, titulo) {
                $("#modalFinanzasPOSTitle").text(titulo || "Finanzas");
                $("#contenedorFinanzasPOS").html('<div class="p-4 text-center text-muted">Cargando...</div>');
                $("#modalFinanzasPOS").modal("show");

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        renderConScripts(html);
                    },
                    error: function () {
                        mostrarErrorFinanzas("No se pudo cargar el contenido de finanzas.");
                    }
                });
            },

            abrirCtasCtes: function () {
                var url = '@Url.Action("CtasCtes", "Finanzas", new { desdePos = true })';
                this.cargar(url, "Cuentas corrientes");
            },

            abrirCtaCtePersona: function (idPersona, fechaDesde) {
                var url = '@Url.Action("CtaCtePersona", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (fechaDesde) {
                    url += '&fechaDesde=' + encodeURIComponent(fechaDesde);
                }

                this.cargar(url, "Cuenta corriente");
            },

            abrirPago: function (idPersona, returnUrl, idPago) {
                var url = '@Url.Action("AddOrEditPago", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (returnUrl) {
                    url += '&returnUrl=' + encodeURIComponent(returnUrl);
                }

                if (idPago) {
                    url += '&idPago=' + encodeURIComponent(idPago);
                }

                this.cargar(url, "Pago / Cobro");
            }
        };

        window.posHotkeysHooks = window.posHotkeysHooks || {};
        window.posHotkeysHooks.F2 = function () {
            window.POSFinanzas.abrirCtasCtes();
        };

        $(document).on("click", "#modalFinanzasPOS a[data-pos-ajax='true']", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");
            var titulo = $(this).data("pos-title") || "Finanzas";
            window.POSFinanzas.cargar(url, titulo);
        });

        $(document).on("submit", "#modalFinanzasPOS form[data-pos-ajax='true'][method='get'], #modalFinanzasPOS form[data-pos-ajax='true']:not([method])", function (e) {
            e.preventDefault();

            var $form = $(this);
            var url = $form.attr("action");
            var query = $form.serialize();

            if (url.indexOf("?") >= 0) {
                url += "&" + query;
            } else {
                url += "?" + query;
            }

            var titulo = $form.data("pos-title") || "Finanzas";
            window.POSFinanzas.cargar(url, titulo);
        });

        $("#modalFinanzasPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorFinanzasPOS").html("");

            setTimeout(function () {
                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });
    });
    // FIN FINANZAS POS
    </script>
}

