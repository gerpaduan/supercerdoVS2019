                    ? window.POSGuard.requestModalOpen('finanzas', function () {
                        $("#modalFinanzasPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSGuard?.endAction("finanzas:cargar");
                    return;
                }

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        renderConScripts(html, "#contenedorFinanzasPOS");
                        enfocarBuscadorFinanzasPOS();
                    },
                    error: function () {
                        mostrarErrorFinanzas("No se pudo cargar el contenido de finanzas.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("finanzas:cargar");
                    }
                });
            },

            cargarPago: function (url, titulo) {
                if (window.POSGuard && !window.POSGuard.startAction("pago:cargar")) {
                    return;
                }

                $("#modalPagoPOSTitle").text(titulo || "Pago / Cobro");
                $("#contenedorPagoPOS").html('<div class="p-4 text-center text-muted">Cargando...</div>');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('pagoPos', function () {
                        $("#modalPagoPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSGuard?.endAction("pago:cargar");
                    return;
                }

                setTimeout(function () {
                    $("body").addClass("modal-open");
                }, 0);

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        renderConScripts(html, "#contenedorPagoPOS");
                    },
                    error: function () {
                        mostrarErrorPago("No se pudo cargar el pago.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("pago:cargar");
                    }
                });
            },

            abrirCtasCtes: function () {
                var url = '@Url.Action("CtasCtes", "Finanzas", new { desdePos = true })';
                this.cargar(url, "Cuentas corrientes");
            },

            abrirCtaCtePersona: function (idPersona, fechaDesde) {
                var url = '@Url.Action("CtaCtePersona", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (fechaDesde) {
                    url += '&fechaDesde=' + encodeURIComponent(fechaDesde);
                }

                this.cargar(url, "Cuenta corriente");
            },

            abrirPago: function (idPersona, returnUrl, idPago) {
                var url = '@Url.Action("AddOrEditPago", "Finanzas")'
                    + '?idPersona=' + encodeURIComponent(idPersona)
                    + '&desdePos=true';

                if (returnUrl) {
                    url += '&returnUrl=' + encodeURIComponent(returnUrl);
                }

                if (idPago) {
                    url += '&idPago=' + encodeURIComponent(idPago);
                }

                this.cargarPago(url, "Pago / Cobro");
            }
        };

        window.POSEgresos = {
            cargarEnModal: function (url, titulo, compacto) {
                if (window.EgresosCaja &&
                    typeof window.EgresosCaja.formDirty === "function" &&
                    window.EgresosCaja.formDirty()) {
                    window.EgresosCaja.confirmarSalidaCambios(function () {
                        window.EgresosCaja.permitirSalida();
                        window.POSEgresos.cargarEnModal(url, titulo, compacto);
                    });
                    return;
                }

                if (window.POSGuard && !window.POSGuard.startAction("egresos:cargar")) {
                    return;
                }

                $("#modalFinanzasPOS").toggleClass("modal-egreso-pos-compacto", compacto === true);
                $("#modalFinanzasPOSTitle").text(titulo || "Egresos de Caja");
                $("#contenedorFinanzasPOS").html('<div class="p-4 text-center text-muted">Cargando...</div>');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('finanzas', function () {
                        $("#modalFinanzasPOS").modal("show");
                    })
                    : true;

                if (!abierto) {
                    window.POSGuard?.endAction("egresos:cargar");
                    return;
                }

                $.ajax({
                    url: url,
                    type: "GET",
                    cache: false,
                    success: function (html) {
                        if (window.EgresosCaja && typeof window.EgresosCaja.renderConScripts === "function") {
                            window.EgresosCaja.renderConScripts(html, "#contenedorFinanzasPOS");
                        } else {
                            $("#contenedorFinanzasPOS").html(html);
                        }
                    },
                    error: function () {
                        mostrarErrorFinanzas("No se pudo cargar egresos de caja.");
                    },
                    complete: function () {
                        window.POSGuard?.endAction("egresos:cargar");
                    }
                });
            },

            abrirMis: function (filtroActividad) {
                var url = window.EgresosCajaUrls.mis;
                if (filtroActividad) {
                    url += (url.indexOf("?") >= 0 ? "&" : "?") + "filtroActividad=" + encodeURIComponent(filtroActividad);
                }

                this.cargarEnModal(url, "Mis actividades", false);
            },

            abrirNuevo: function () {
                this.cargarEnModal(window.EgresosCajaUrls.nuevo, "Nuevo Egreso de Caja", true);
            }
        };

        window.POSCompras = {
            abrirNueva: function () {
                var url = '@Url.Action("NuevaCompra", "Compras", new { origen = "pos" })';
                window.POSFinanzas.cargar(url, "Nueva compra");
            }
        };

        window.POSVentas = {
            abrirMis: function () {
                window.POSFinanzas.cargar(window.VentasUrls.mis, "Mis ventas");
            },
            abrirDetalle: function (idVenta, returnUrlDetalle) {
                var url = window.VentasUrls.detalle
                    + '?id=' + encodeURIComponent(idVenta)
                    + '&modal=true&desdePos=true';
                if (returnUrlDetalle) {
                    url += '&returnUrl=' + encodeURIComponent(returnUrlDetalle);
                }
                window.POSFinanzas.cargar(url, "Detalle de venta");
            }
        };

        window.POSFinanzasState = window.POSFinanzasState || {
            redirectDespuesDePago: null,
            tituloDespuesDePago: "Cuenta corriente"
        };

        window.posHotkeysHooks = window.posHotkeysHooks || {};
        window.posHotkeysHooks.F2 = function () {
            window.POSFinanzas.abrirCtasCtes();
        };

        window.posHotkeysHooks.F3 = function () {
            window.CalculadoraBilletes?.open?.({
                tituloPantalla: 'Ingreso de billetes',
                titulo: 'Detalle de billetes'
            });
        };

        window.posHotkeysHooks.F5 = function () {
            window.POSCompras.abrirNueva();
        };

        window.posHotkeysHooks.F6 = function () {
            window.POSEgresos.abrirMis();
        };

        window.posHotkeysHooks.F7 = function () {
            window.POSEgresos.abrirNuevo();
        };

        window.posHotkeysHooks.AvPag = function () {
            window.POSExpendiosCurrent?.open?.();
        };

        $(document).on("click", "#modalFinanzasPOS a[data-pos-ajax='true']", function (e) {
            e.preventDefault();

            var url = $(this).attr("href");
            var titulo = $(this).data("pos-title") || "Finanzas";

            if ((url && url.indexOf("/Finanzas/AddOrEditPago") >= 0) || $(this).data("pos-modal") === "pago") {
                window.POSFinanzas.cargarPago(url, titulo || "Pago / Cobro");
                return;
            }

            window.POSFinanzas.cargar(url, titulo);
        });

        $(document).on("submit", "#modalFinanzasPOS form[data-pos-ajax='true'][method='get'], #modalFinanzasPOS form[data-pos-ajax='true']:not([method])", function (e) {
            e.preventDefault();

            var $form = $(this);
            var url = $form.attr("action");
            var query = $form.serialize();

            if (url.indexOf("?") >= 0) {
                url += "&" + query;
            } else {
                url += "?" + query;
            }

            var titulo = $form.data("pos-title") || "Finanzas";
            window.POSFinanzas.cargar(url, titulo);
        });

        $("#modalPagoPOS").on("shown.bs.modal", function () {
            setTimeout(function () {
                $("body").addClass("modal-open");
            }, 0);
        });

        $("#modalPagoPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorPagoPOS").html("");

            setTimeout(function () {
                if (window.POSFinanzasState && window.POSFinanzasState.redirectDespuesDePago) {
                    var urlRecarga = window.POSFinanzasState.redirectDespuesDePago;
                    var tituloRecarga = window.POSFinanzasState.tituloDespuesDePago || "Cuenta corriente";

                    window.POSFinanzasState.redirectDespuesDePago = null;
                    window.POSFinanzasState.tituloDespuesDePago = "Cuenta corriente";

                    if ($("#modalFinanzasPOS").hasClass("show")) {
                        window.POSFinanzas.cargar(urlRecarga, tituloRecarga);
                        $("body").addClass("modal-open");
                        return;
                    }
                }

                if ($("#modalFinanzasPOS").hasClass("show")) {
                    $("body").addClass("modal-open");
                    return;
                }

                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("hidden.bs.modal", function (e) {
            if (e.target !== this) return;

            $("#contenedorFinanzasPOS").html("");

            setTimeout(function () {
                if (!$(".modal.show").length) {
                    focoCodigoPOS();
                }
            }, 0);
        });

        $("#modalFinanzasPOS").on("shown.bs.modal", function () {
            function enfocarBuscadorCtas() {
                var input = document.getElementById("txtBuscar");
                if (!input) return;
                input.focus();
                try { input.select(); } catch { }
            }

            setTimeout(enfocarBuscadorCtas, 0);
            setTimeout(enfocarBuscadorCtas, 140);
            setTimeout(enfocarBuscadorCtas, 300);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const $modalFinanzas = $('#modalFinanzasPOS');
                const $modalActivo = $('.modal.show').last();

                // Verificamos si el modal de Finanzas POS est� abierto
                // y adem�s es el modal activo
                if ($modalFinanzas.hasClass('show') && $modalActivo.is($modalFinanzas)) {
                    $modalFinanzas.modal('hide');
                }
            }
        });

    });
    // FIN FINANZAS POS
    </script>
}

