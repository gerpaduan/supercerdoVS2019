        if (esEdicionVenta) {
            Swal.fire({
                icon: "warning",
                title: "¿Salir de la edición?",
                text: "Se descartarán los cambios no guardados.",
                showCancelButton: true,
                confirmButtonText: "Sí",
                cancelButtonText: "No"
            }).then(function (result) {
                if (!result.isConfirmed) return;
                window.desactivarAvisoSalidaPOS?.();
                window.location.href = '@Url.Action("DetalleVenta", "Ventas")?id=' + encodeURIComponent($("#idVentaEditar").val());
            });
            return;
        }

        Swal.fire({
            icon: "warning",
            title: "¿Realmente desea cancelar la venta?",
            showCancelButton: true,
            confirmButtonText: "Sí",
            cancelButtonText: "No"
        }).then(function (result) {
            if (!result.isConfirmed) return;
            guardarVentaAnuladaDirectamente(true);
        });
