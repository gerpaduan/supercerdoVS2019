@model Entidades.Venta

@{
    ViewBag.Title = "CarniSys | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";

    bool cajaAbierta = ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta;
    bool showAbrirCajaModal = ViewBag.ShowAbrirCajaModal != null && (bool)ViewBag.ShowAbrirCajaModal;
    int idConsumidorFinal = ViewBag.IdConsumidorFinal != null ? (int)ViewBag.IdConsumidorFinal : 0;
    int idSucursalPOS = ViewBag.IdSucursalPOS != null ? (int)ViewBag.IdSucursalPOS : 0;
    int idUsuarioPOS = Session["Usuario"] != null ? ((Entidades.Usuario)Session["Usuario"]).Id : 0;
    bool esEdicionVenta = ViewBag.EsEdicionVenta != null && (bool)ViewBag.EsEdicionVenta;
    bool puedeEditarFechaVenta = ViewBag.PuedeEditarFechaVenta != null && (bool)ViewBag.PuedeEditarFechaVenta;
    int idVentaEditar = ViewBag.IdVentaEditar != null ? (int)ViewBag.IdVentaEditar : 0;
    bool soloFormaPago = ViewBag.SoloFormaPago != null && (bool)ViewBag.SoloFormaPago;
    string posModoInstancia = ViewBag.PosModoInstancia as string ?? "original";
    string posInstanceId = ViewBag.PosInstanceId as string ?? Guid.NewGuid().ToString("N");
    string returnUrlPOS = ViewBag.ReturnUrlPOS as string ?? "";
    int abrirDetalleVentaId = ViewBag.AbrirDetalleVentaId != null ? (int)ViewBag.AbrirDetalleVentaId : 0;
    string returnUrlDetalle = ViewBag.ReturnUrlDetalle as string ?? "";
    string sucursalNombrePOS = Session["Usuario"] != null && ((Entidades.Usuario)Session["Usuario"]).Sucursal != null
        ? ((Entidades.Usuario)Session["Usuario"]).Sucursal.SucursalNombre
        : "";
    var lineasActivas = (Model != null && Model.LineasVenta != null)
        ? Model.LineasVenta.Where(l => !Entidades.LineaVenta.esAnulado(l.Estado)).ToList()
        : new List<Entidades.LineaVenta>();
    var lineasAnuladasPorLinea = (Model != null && Model.LineasVenta != null)
        ? Model.LineasVenta
            .Where(l => Entidades.LineaVenta.esAnulado(l.Estado) && l.IndexAnulado > 0)
            .GroupBy(l => l.IndexAnulado)
            .ToDictionary(g => g.Key, g => g.First())
        : new Dictionary<int, Entidades.LineaVenta>();
    var lineasEdicionPos = new List<object>();
    var listaExpendiosEdicionPos = new List<int>();
    if (esEdicionVenta)
    {
        var indexLinea = 1;
        foreach (var linea in lineasActivas)
        {
            if (linea.IdExpendio > 0 && !listaExpendiosEdicionPos.Contains(linea.IdExpendio))
            {
                listaExpendiosEdicionPos.Add(linea.IdExpendio);
            }

            lineasEdicionPos.Add(new
            {
                index = indexLinea++,
                producto = linea.Corte.CorteDesc,
                codigo = linea.Corte.codigo,
                cant = Math.Abs(linea.CantKg).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture),
                precio = "$ " + linea.PrecioKg.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                precioOriginal = "$ " + linea.PrecioKg.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                subtotal = "$ " + (Math.Abs(linea.CantKg) * linea.PrecioKg).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                bonificacion = linea.Bonificacion,
                anulado = lineasAnuladasPorLinea.ContainsKey(linea.IdLineaVenta),
                indexAnulado = -1,
                balanza = linea.PesoBalanza,
                pesable = linea.Corte.Pesable,
                idExpendio = linea.IdExpendio,
                esHistorica = true
            });
        }
    }
}

@if (cajaAbierta && Model != null)
{
    <!-- =========================================================
         WRAPPER POS: ocupa todo el alto del pos-container
         ========================================================= -->
    <div class="pos-page">

        <!-- TOP POS (responsive: en mobile resumen arriba, cliente abajo) -->
        <div class="pos-topbar row no-gutters align-items-stretch mb-2">

            <!-- IZQUIERDA (desktop) / ABAJO (mobile): cliente -->
            <div class="col-12 col-lg-6 order-2 order-lg-1 d-flex align-items-center">
                <div class="pos-cliente w-100">
                    @Html.HiddenFor(m => m.IdPersona, new { id = "idPersona" })
                    <input type="hidden" id="clienteIdentificacionValor" value="@(Model.Persona?.Identificacion ?? "")" />

                    <div class="input-group input-group-sm">
                        <input type="text"
                               id="razonSocial"
                               class="form-control"
                               value="@(Model.Persona?.RazonSocial ?? "Error al cargar cliente")"
                               readonly />

                        <div class="input-group-append">
                            <button type="button"
                                    class="btn btn-primary"
                                    id="btnBuscarPersona"
                                    title="Buscar cliente (F9)">
                                <i class="fas fa-search"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-secondary"
                                    id="btnConsumidorFinal"
                                    title="Consumidor Final">
                                CF
                            </button>
                        </div>
                    </div>
                    <div id="clienteIdentificacionWrap"
                         class="pos-cliente-identificacion @((Model.Persona == null || string.IsNullOrWhiteSpace(Model.Persona.Identificacion) || string.Equals(Model.Persona.Identificacion, Model.Persona.RazonSocial, StringComparison.OrdinalIgnoreCase)) ? "d-none" : "")"
                         title="@(Model.Persona?.Identificacion ?? "")">
                        <span class="pos-cliente-identificacion-label">Ident.:</span>
                        <span id="clienteIdentificacionTexto">@(Model.Persona?.Identificacion ?? "")</span>
                    </div>
                </div>
            </div>

            <!-- DERECHA (desktop) / ARRIBA (mobile): resumen + fecha + salida -->
            <div class="col-12 col-lg-6 order-1 order-lg-2">
                <div class="pos-topbar-summary d-flex align-items-stretch justify-content-between">
                    <div class="pos-meta flex-grow-1 pr-2">
                        <div class="pos-meta-main">
                            <div class="pos-meta-main-secondary">
                                <div class="pos-brand-subline">
                                    <span class="pos-brand-subline-label">Sucursal</span>
                                    <span class="pos-brand-subline-value text-truncate">
                                        @(Session["Usuario"] != null
                                            ? ((Entidades.Usuario)Session["Usuario"]).Sucursal.SucursalNombre
                                            : "")
                                    </span>
                                </div>

                                @if (!puedeEditarFechaVenta)
                                {
                                    <div class="pos-fecha pos-meta-time pos-meta-time-inline">
                                        <span class="pos-time-chip">
                                            <i class="far fa-clock"></i>
                                            <span id="fechaHoraPOS" class="font-weight-bold"></span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (puedeEditarFechaVenta)
                        {
                            <div class="pos-fecha pos-meta-time">
                                <label for="fechaVentaEditable" class="small d-block mb-1">Fecha y hora</label>
                                <input type="datetime-local"
                                       id="fechaVentaEditable"
                                       class="form-control form-control-sm"
                                       value="@Model.FechaVenta.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                        }

                        <div class="pos-meta-hidden">
                            <input type="hidden" id="fechaVenta" name="fechaVenta" value="@Model.FechaVenta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                            <input type="hidden" id="idVentaEditar" value="@idVentaEditar" />
                            <input type="hidden" id="idSucursalPOS" value="@idSucursalPOS" />
                            <input type="hidden" id="returnUrlPOS" value="@returnUrlPOS" />
                        </div>
                    </div>

                    <div class="pos-top-actions">
                        <span id="posInstanceBadge" class="badge badge-pill mr-2 @(posModoInstancia == "duplicado" ? "badge-warning" : "badge-info d-none")">
                            @(posModoInstancia == "duplicado" ? "POS Duplicado" : "POS Original")
                        </span>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm pos-btn-layout mr-2"
                                id="btnDuplicarPOS"
                                title="Abrir POS duplicado">
                            <i class="fas fa-clone"></i>
                            <span>Duplicar POS</span>
                        </button>
                        <a class="btn btn-light btn-sm pos-btn-layout"
                           id="btnSalirPOS"
                           href="@Url.Action("Index", "Home")"
                           title="Volver al sistema">
                            <i class="fas fa-arrow-left"></i>
                            <span>Salir</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Vista: Punto de Venta (SB Admin 2) -->
        <div class="container-fluid p-1" id="pos-app">

            <div class="card shadow-lg border-0 pos-panel">

                <div class="card-body p-2 d-flex flex-column">

                    <div class="row flex-grow-1 h-100">

                        <!-- ===================== -->
                        <!-- COLUMNA IZQUIERDA - CARRITO -->
                        <div class="col-12 col-md-6 carrito-col pos-ventas-cart-col">
                            <div id="posFormaPagoMobileAnchor"></div>

                            <div class="zona-tabla">
                                <table class="table table-sm tabla-productos mb-0">
                                    <tbody id="tablaItems">
                                        <tr id="filaVacia">
                                            <td class="text-muted text-center py-3">
                                                No hay productos agregados
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="zona-total">
                                @if (esEdicionVenta)
                                {
                                    <div class="pos-restore-banner">
                                        <i class="fas fa-pen mr-1"></i>
                                        @(soloFormaPago ? "Cambiando forma de pago" : "Modificando venta") <strong>#@idVentaEditar</strong>
                                    </div>
                                    if (ViewBag.VentaFacturadaNoEditableImporte != null && (bool)ViewBag.VentaFacturadaNoEditableImporte)
                                    {
                                        <div class="pos-restore-banner pos-restore-banner-warning">
                                            <i class="fas fa-file-invoice-dollar mr-1"></i>
                                            La venta ya está facturada. Puede guardar cambios, pero cualquier modificación puede afectar la consistencia de los datos facturados.
                                        </div>
                                    }
                                    <div id="posAvisoPreciosHistoricos" class="pos-restore-banner pos-restore-banner-info">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        Los productos ya cargados mantienen su precio original. Los nuevos productos se calcularán según la forma de pago seleccionada.
                                    </div>
                                }
                                <div id="posFormaPagoDesktopAnchor"></div>
                                <div id="posFormaPagoActual" class="pos-forma-pago-banner d-none">
                                    <div class="pos-forma-pago-copy">
                                        <span class="pos-forma-pago-label">Forma de pago:</span>
                                        <strong id="posFormaPagoNombre">-</strong>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnCambiarFormaPago">
                                        Cambiar forma de pago
                                    </button>
                                </div>
                                <div id="posVentaRestaurada" class="pos-restore-banner d-none">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>
                                    Venta restaurada. Debe presionar <strong>Cancelar Venta</strong> para salir.
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <h2 class="m-0 pos-total-label">Total</h2>
                                    <h2 id="lblSubtotal" class="m-0 pos-total-value">$ 0,00</h2>
                                </div>
                                <div class="d-flex justify-content-between align-items-start pos-sale-summary-row">
                                    <div id="posVentaItemsResumen" class="pos-sale-items text-muted"></div>
                                    <div id="posVentaResumen" class="pos-sale-summary text-muted">
                                        Sin productos
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- ===================== -->
                        <!-- COLUMNA DERECHA -->
                        <div class="col-12 col-md-6 d-flex flex-column pos-workbench pos-ventas-workbench-col">
                            <div class="pos-workbench-scroll">
                            <!-- ?? BLOQUE SCANNER -->
                            <div class="row" id="scannerContainer" style="display:none;">
                                <div class="col-12">
                                    <div class="card shadow">
                                        <div class="card-body text-center">

                                            <div class="scanner-wrapper">
                                                <video id="videoScanner" autoplay muted playsinline></video>
                                                <div class="scanner-line"></div>
                                            </div>

                                            <div class="d-flex justify-content-between mt-2">
                                                <button type="button" class="btn btn-secondary btn-sm" id="btnFlash">
                                                    Flash
                                                </button>

                                                <button type="button" class="btn btn-danger btn-sm" id="btnCerrarScanner">
                                                    Cerrar cámara
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <audio id="beep" src="@Url.Content("~/Content/sounds/focus-beep.wav")" preload="auto"></audio>


                            <!-- BUSCADOR -->
                            <div class="row g-2 mb-3 pos-search-row">
                                <div class="col-12">
                                    <div class="input-group input-group-lg pos-search-group">
                                        <span class="input-group-text scanner-btn" id="btnScanner">
                                            <i class="fas fa-barcode"></i>
                                        </span>
                                        <input type="text"
                                               id="inputCodigo"
                                               class="form-control"
                                               placeholder="Ingrese código o escanee..."
                                               autocomplete="off"
                                               autofocus />

                                        <button class="btn btn-outline-secondary"
                                                id="btnAgregarManual"
                                                data-toggle="modal"
                                                data-target="#modalDigitarCodigo">
                                            Buscar
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- INFO PRODUCTO -->
                            <div id="producto-info" class="p-3 rounded bg-light border mb-3">
                                <div class="row">

                                    <!-- COLUMNA IZQUIERDA -->
                                    <div class="col-6 producto-resumen">

                                        <h4 id="prodNombre" class="fw-bold text-muted">
                                            Info producto...
                                        </h4>

                                        <div class="mb-3 pos-product-metric">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-precio">Precio</label>
                                                <div id="prodPrecio" class="fw-bold text-muted fs-5"></div>
                                            </div>
                                        </div>

                                        <div class="mb-3 pos-product-metric pos-product-metric-cantidad">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-cantidad">Cantidad&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                                <input id="inputCantidad"
                                                       class="form-control"
                                                       autocomplete="off"
                                                       inputmode="decimal">
                                            </div>
                                        </div>

                                        <div class="mb-3 pos-product-metric">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-subtotal">Subtotal</label>
                                                <h4 id="prodSubtotal" class="fw-bold text-muted m-0">
                                                    $ 0,00
                                                </h4>
                                            </div>
                                        </div>
                                        <button id="btnAgregarProducto"
                                                class="btn btn-success btn-lg w-100 btn-agregar-pos d-none d-md-flex"
                                                disabled>
                                            <i class="fas fa-cart-plus"></i>
                                            <span>
                                                <strong>Agregar</strong>
                                                <small>a la venta</small>
                                            </span>
                                        </button>


                                    </div>

                                    <!-- COLUMNA DERECHA - TECLADO -->
                                    <div class="col-6">
                                        <div class="keyboard-grid">
                                            <button class="btn btn-secondary btn-key" data-key="*">*</button>
                                            <button class="btn btn-light btn-key">7</button>
                                            <button class="btn btn-light btn-key">8</button>
                                            <button class="btn btn-light btn-key">9</button>
                                            <button class="btn btn-warning btn-key" data-key="BACKSPACE" title="Borrar">
                                                <i class="fas fa-backspace"></i>
                                            </button>

                                            <button class="btn btn-secondary btn-key" data-key="G">G</button>
                                            <button class="btn btn-light btn-key">4</button>
                                            <button class="btn btn-light btn-key">5</button>
                                            <button class="btn btn-light btn-key">6</button>
                                            <button class="btn btn-secondary btn-key" data-key="X" title="Multiplicación">X</button>

                                            <button class="btn btn-secondary btn-key">G1</button>
                                            <button class="btn btn-light btn-key">1</button>
                                            <button class="btn btn-light btn-key">2</button>
                                            <button class="btn btn-light btn-key">3</button>

                                            <button class="btn btn-info btn-enter btn-key">Enter</button>

                                            <button class="btn btn-secondary btn-key"></button>
                                            <button class="btn btn-light btn-key key-zero">0</button>
                                            <button class="btn btn-light btn-key">.</button>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            </div>

                            <!-- BOTONES FINALES -->
                            <div class="mb-3">
                                <button class="btn btn-success btn-lg w-100" id="btnFinalizar">
                                    <i class="fas fa-cash-register"></i>
                                    <span>
                                        <strong>@(esEdicionVenta ? "Guardar" : "Finalizar")</strong>
                                        <small>@(esEdicionVenta ? "cambios" : "y cobrar")</small>
                                    </span>
                                </button>
                            </div>
                            <div id="pos-bottom-anchor"></div>

                            <!-- ESTADO BALANZA -->
                            <div class="mt-auto pos-footer-panel">

                                <div class="zona-botones">
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <button class="btn btn-outline-secondary w-100" id="btnCancelarItem" disabled>@(esEdicionVenta ? "Salir edición" : "Cancelar Venta")</button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-secondary w-100" id="btnLimpiar">
                                                Comentario
                                                <span id="badgeComentarioVenta" class="badge badge-info pos-comment-badge d-none">1</span>
                                            </button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-primary w-100" id="btnAyuda">Ayuda (F1)</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="pos-balanza-card">
                                    <small class="text-muted pos-balanza-caption">
                                        Conexión balanza: <span id="estadoBalanza">Desconocida</span>
                                    </small>
                                    <div id="msgBalanzaPOS" class="small text-muted mt-1 pos-balanza-lectura"></div>
                                    <div class="progress mt-1" style="height:8px;">
                                        <div id="barraBalanza" class="progress-bar" role="progressbar" style="width:0%"></div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL LINEA VENTA -->
    <div class="modal fade" id="modalLineaVenta" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">

                <!-- HEADER -->
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-receipt mr-2"></i> Línea de venta
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">&times;</button>
                </div>

                <!-- BODY -->
                <div class="modal-body">

                    <!-- INFO PRODUCTO -->
                    <input id="modalProducto" class="form-control mb-2" readonly>

                    <!-- FILA DATOS -->
                    <!-- FILA DATOS -->
                    <div class="row mb-2" id="bloqueDatosLineaBonificacion">

                        <!-- ? Cantidad: en mobile ocupa toda la fila -->
                        <div class="col-12 col-md-5">
                            <label class="small">Cant.</label>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <button id="btnCantMenos" type="button"
                                            class="btn btn-outline-secondary d-none" tabindex="-1">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>

                                <input id="modalCantidad"
                                       class="form-control text-right"
                                       readonly
                                       inputmode="decimal"
                                       autocomplete="off">

                                <div class="input-group-append">
                                    <button id="btnCantMas" type="button"
                                            class="btn btn-outline-secondary d-none" tabindex="-1">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>


                        <div class="w-100 d-block d-md-none"></div>

                        <!-- ? Precio y Total: abajo en mobile -->
                        <div class="col-6 col-md-3">
                            <label class="small">Precio lista</label>
                            <input id="modalPrecio" class="form-control text-right" readonly>
                        </div>

                        <div class="col-6 col-md-4">
                            <label id="lblTotalModalLineaVenta" class="small">Total</label>
                            <input id="modalSubtotal" class="form-control text-right font-weight-bold" readonly>
                        </div>

                    </div>

                    <hr>

                    <!-- BLOQUE BONIFICAR -->
                    <div id="bloqueBonificar" style="display:none">

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkPorcentaje">
                            <label class="form-check-label" for="chkPorcentaje">Bonificar por porcentaje</label>
                        </div>

                        <div class="form-check mb-2 d-none" id="bloqueAplicarBonificacionTodos">
                            <input class="form-check-input" type="checkbox" id="chkBonificarTodos">
                            <label class="form-check-label" for="chkBonificarTodos">Aplicar a todos los productos</label>
                        </div>

                        <div class="small text-muted mb-2 d-none" id="msgRecargoBonificacion">
                            Si ingresa un porcentaje negativo, se aplicará como recargo.
                        </div>

                        <div class="alert alert-info py-2 px-3 small d-none" id="msgBonificarTodos">
                            Esta bonificación se aplicará a todos los productos del carrito.
                        </div>

                        <div class="row">
                            <div class="col-6" id="bloquePrecioBonificado">
                                <label class="small">Precio bonificado</label>
                                <input id="txtPrecioKg"
                                       class="form-control text-right"
                                       inputmode="decimal"
                                       autocomplete="off">
                            </div>

                            <div class="col-6">
                                <label id="lblTipoPorcentaje" class="small">% bonificación</label>
                                <input id="txtPorcentaje"
                                       class="form-control text-right"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       readonly>
                            </div>
                        </div>


                        <button id="btnAplicarBonificacion" class="btn btn-primary btn-block mt-3">
                            Aplicar bonificación
                        </button>

                        <!-- espacio -->
                        <div class="mt-2"></div>
                    </div>


                    <div id="bloqueCantidad" style="display:none">
                        <button id="btnAplicarCantidad" class="btn btn-primary btn-block mt-3">
                            Aplicar cantidad
                        </button>

                        <!-- espacio -->
                        <div class="mt-2"></div>
                    </div>



                    <div class="d-flex flex-column" style="gap:.5rem;">


                        <button id="btnMostrarBonificar" class="btn btn-success">
                            <i class="fas fa-percentage"></i> Bonificar
                        </button>

                        <button id="btnMostrarCantidad" class="btn btn-info">
                            <i class="fas fa-sort-numeric-up"></i> Cantidad
                        </button>

                        <button id="btnEliminarItem" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>



    <!-- MODAL PESABLE -->
    <div class="modal fade" id="modalPesable" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Producto Pesable</h5>
