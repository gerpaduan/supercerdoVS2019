@model Entidades.Venta

@{
    ViewBag.Title = "CarniSys web | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";

    bool cajaAbierta = ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta;
    bool showAbrirCajaModal = ViewBag.ShowAbrirCajaModal != null && (bool)ViewBag.ShowAbrirCajaModal;
}

@if (cajaAbierta && Model != null)
{
    <!-- =========================================================
         WRAPPER POS: ocupa todo el alto del pos-container
         ========================================================= -->
    <div class="pos-page">

        <!-- TOP POS (responsive: en mobile arriba comercio/fecha, abajo cliente) -->
        <div class="pos-topbar row no-gutters align-items-stretch mb-2">

            <!-- DERECHA (en desktop) / ARRIBA (en mobile): comercio + fecha + fullscreen -->
            <div class="col-12 col-lg-6 order-1 order-lg-2 d-flex align-items-stretch justify-content-between">

                <div class="pos-meta flex-grow-1 text-left text-lg-right pr-2">
                    <div class="pos-empresa text-truncate">
                        @(Session["Usuario"] != null
                            ? ((Entidades.Usuario)Session["Usuario"]).Empresa.NombreFantasia + " | SUC: " + ((Entidades.Usuario)Session["Usuario"]).Sucursal.SucursalNombre
                            : "")
                    </div>

                    <div class="pos-fecha">
                        <span id="fechaHoraPOS" class="font-weight-bold"></span>
                        <input type="hidden" id="fechaVenta" name="fechaVenta" value="@Model.FechaVenta" />
                    </div>
                </div>

                <button class="btn btn-light btn-sm pos-btn-fullscreen"
                        id="btn-toggle-fullscreen"
                        type="button"
                        title="Pantalla completa">
                    <i class="fas fa-expand-arrows-alt"></i>
                </button>
            </div>

            <!-- IZQUIERDA (en desktop) / ABAJO (en mobile): cliente + buscar + CF -->
            <div class="col-12 col-lg-6 order-2 order-lg-1 d-flex align-items-center">
                <div class="pos-cliente w-100">
                    @Html.HiddenFor(m => m.IdPersona, new { id = "idPersona" })

                    <div class="input-group input-group-sm">
                        <input type="text"
                               id="razonSocial"
                               class="form-control"
                               value="@(Model.Persona?.RazonSocial ?? "Error al cargar cliente")"
                               readonly />

                        <div class="input-group-append">
                            <button type="button"
                                    class="btn btn-primary"
                                    id="btnBuscarPersona"
                                    title="Buscar cliente (F9)">
                                <i class="fas fa-search"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-secondary"
                                    id="btnConsumidorFinal"
                                    title="Consumidor Final">
                                CF
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Vista: Punto de Venta (SB Admin 2) -->
        <div class="container-fluid p-1" id="pos-app">

            <div class="card shadow-lg border-0 pos-panel">

                <div class="card-body p-2 d-flex flex-column">

                    <div class="row flex-grow-1 h-100">

                        <!-- ===================== -->
                        <!-- COLUMNA IZQUIERDA - CARRITO -->
                        <div class="col-12 col-md-6 carrito-col">

                            <div class="zona-tabla">
                                <table class="table table-sm tabla-productos mb-0">
                                    <tbody id="tablaItems">
                                        <tr id="filaVacia">
                                            <td class="text-muted text-center py-3">
                                                No hay productos agregados
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="zona-total">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3 class="m-0 pos-total-label">Total</h3>
                                    <h1 id="lblSubtotal" class="m-0 pos-total-value">$ 0,00</h1>
                                </div>
                            </div>

                        </div>

                        <!-- ===================== -->
                        <!-- COLUMNA DERECHA -->
                        <div class="col-12 col-md-6 d-flex flex-column">
                            <!-- 🔍 BLOQUE SCANNER -->
                            <div class="row" id="scannerContainer" style="display:none;">
                                <div class="col-12">
                                    <div class="card shadow">
                                        <div class="card-body text-center">

                                            <div class="scanner-wrapper">
                                                <video id="videoScanner" autoplay muted playsinline></video>
                                                <div class="scanner-line"></div>
                                            </div>

                                            <div class="d-flex justify-content-between mt-2">
                                                <button type="button" class="btn btn-secondary btn-sm" id="btnFlash">
                                                    🔦 Flash
                                                </button>

                                                <button type="button" class="btn btn-danger btn-sm" id="btnCerrarScanner">
                                                    Cerrar cámara
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <audio id="beep" src="/Content/sounds/focus-beep.wav" preload="auto"></audio>


                            <!-- BUSCADOR -->
                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text scanner-btn" id="btnScanner">
                                            <i class="fas fa-barcode"></i>
                                        </span>
                                        <input type="text"
                                               id="inputCodigo"
                                               class="form-control"
                                               placeholder="Ingrese el código..."
                                               autocomplete="off"
                                               autofocus />

                                        <button class="btn btn-outline-secondary"
                                                id="btnAgregarManual"
                                                data-toggle="modal"
                                                data-target="#modalDigitarCodigo">
                                            Buscar
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- INFO PRODUCTO -->
                            <div id="producto-info" class="p-3 rounded bg-light border mb-3">
                                <div class="row">

                                    <!-- COLUMNA IZQUIERDA -->
                                    <div class="col-6 producto-resumen">

                                        <h4 id="prodNombre" class="fw-bold text-muted">
                                            Info producto...
                                        </h4>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-precio">Precio</label>
                                                <div id="prodPrecio" class="fw-bold text-muted fs-5"></div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-cantidad">Cantidad&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                                <input id="inputCantidad"
                                                       class="form-control"
                                                       autocomplete="off"
                                                       inputmode="decimal">
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="lbl-subtotal">Subtotal</label>
                                                <h4 id="prodSubtotal" class="fw-bold text-muted m-0">
                                                    $ 0,00
                                                </h4>
                                            </div>
                                        </div>
                                        <button id="btnAgregarProducto"
                                                class="btn btn-outline-success btn-lg w-100 btn-agregar-pos d-none d-md-block"
                                                disabled>
                                            ➕ Agregar a la venta
                                        </button>


                                    </div>

                                    <!-- COLUMNA DERECHA - TECLADO -->
                                    <div class="col-6">
                                        <div class="keyboard-grid">
                                            <button class="btn btn-secondary btn-key">*</button>
                                            <button class="btn btn-light btn-key">7</button>
                                            <button class="btn btn-light btn-key">8</button>
                                            <button class="btn btn-light btn-key">9</button>
                                            <button class="btn btn-warning btn-key">←</button>

                                            <button class="btn btn-secondary btn-key">G</button>
                                            <button class="btn btn-light btn-key">4</button>
                                            <button class="btn btn-light btn-key">5</button>
                                            <button class="btn btn-light btn-key">6</button>
                                            <button class="btn btn-secondary btn-key">×</button>

                                            <button class="btn btn-secondary btn-key">G1</button>
                                            <button class="btn btn-light btn-key">1</button>
                                            <button class="btn btn-light btn-key">2</button>
                                            <button class="btn btn-light btn-key">3</button>

                                            <button class="btn btn-info btn-enter btn-key">Enter</button>

                                            <button class="btn btn-secondary btn-key"></button>
                                            <button class="btn btn-light btn-key key-zero">0</button>
                                            <button class="btn btn-light btn-key">.</button>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- BOTONES FINALES -->
                            <div class="mb-3">
                                <button class="btn btn-success btn-lg w-100" id="btnFinalizar">
                                    <i class="fas fa-credit-card mr-2"></i>
                                    Finalizar y Pagar
                                </button>
                            </div>
                            <div id="pos-bottom-anchor"></div>

                            <!-- ESTADO BALANZA -->
                            <div class="mt-auto">

                                <div class="zona-botones">
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <button class="btn btn-outline-danger w-100" id="btnCancelarItem">Cancelar Venta</button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-secondary w-100" id="btnLimpiar">Comentario</button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-primary w-100" id="btnAyuda">Ayuda (F1)</button>
                                        </div>
                                    </div>
                                </div>

                                <small class="text-muted">
                                    Conexión balanza: <span id="estadoBalanza">Desconocida</span>
                                </small>
                                <div class="progress mt-1" style="height:8px;">
                                    <div id="barraBalanza" class="progress-bar" role="progressbar" style="width:0%"></div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL LINEA VENTA -->
    <div class="modal fade" id="modalLineaVenta" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">

                <!-- HEADER -->
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-receipt mr-2"></i> Línea de venta
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">×</button>
                </div>

                <!-- BODY -->
                <div class="modal-body">

                    <!-- INFO PRODUCTO -->
                    <input id="modalProducto" class="form-control mb-2" readonly>

                    <!-- FILA DATOS -->
                    <!-- FILA DATOS -->
                    <div class="row mb-2">

                        <!-- ✅ Cantidad: en mobile ocupa toda la fila -->
                        <div class="col-12 col-md-5">
                            <label class="small">Cant.</label>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <button id="btnCantMenos" type="button"
                                            class="btn btn-outline-secondary d-none" tabindex="-1">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>

                                <input id="modalCantidad"
                                       class="form-control text-right"
                                       readonly
                                       inputmode="decimal"
                                       autocomplete="off">

                                <div class="input-group-append">
                                    <button id="btnCantMas" type="button"
                                            class="btn btn-outline-secondary d-none" tabindex="-1">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- ✅ salto de línea SOLO en pantallas chicas -->
                        <div class="w-100 d-block d-md-none"></div>

                        <!-- ✅ Precio y Total: abajo en mobile -->
                        <div class="col-6 col-md-3">
                            <label class="small">Precio lista</label>
                            <input id="modalPrecio" class="form-control text-right" readonly>
                        </div>

                        <div class="col-6 col-md-4">
                            <label id="lblTotalModalLineaVenta" class="small">Total</label>
                            <input id="modalSubtotal" class="form-control text-right font-weight-bold" readonly>
                        </div>

                    </div>

                    <hr>

                    <!-- BLOQUE BONIFICAR -->
                    <div id="bloqueBonificar" style="display:none">

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkPorcentaje">
                            <label class="form-check-label" for="chkPorcentaje">Bonificar por porcentaje</label>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <label class="small">Precio bonificado</label>
                                <input id="txtPrecioKg"
                                       class="form-control text-right"
                                       inputmode="decimal"
                                       autocomplete="off">
                            </div>

                            <div class="col-6">
                                <label id="lblTipoPorcentaje" class="small">% bonificación</label>
                                <input id="txtPorcentaje"
                                       class="form-control text-right"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       readonly>
                            </div>
                        </div>

                        <!-- Aplicar bonificación (cuando se muestra bonificar) -->
                        <button id="btnAplicarBonificacion" class="btn btn-primary btn-block mt-3">
                            Aplicar bonificación
                        </button>

                        <!-- espacio -->
                        <div class="mt-2"></div>
                    </div>

                    <!-- BLOQUE CANTIDAD (solo para el botón Aplicar cantidad) -->
                    <div id="bloqueCantidad" style="display:none">
                        <button id="btnAplicarCantidad" class="btn btn-primary btn-block mt-3">
                            Aplicar cantidad
                        </button>

                        <!-- espacio -->
                        <div class="mt-2"></div>
                    </div>

                    <!-- BOTONES PRINCIPALES / DE ACCIÓN -->
                    <!-- Siempre visibles en columna, y el JS los oculta/activa según modo -->
                    <div class="d-flex flex-column" style="gap:.5rem;">

                        <!-- (Opcional) si querés seguir mostrando el botón "Bonificar" como antes -->
                        <button id="btnMostrarBonificar" class="btn btn-success">
                            <i class="fas fa-percentage"></i> Bonificar
                        </button>

                        <button id="btnMostrarCantidad" class="btn btn-info">
                            <i class="fas fa-sort-numeric-up"></i> Cantidad
                        </button>

                        <button id="btnEliminarItem" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>



    <!-- MODAL PESABLE -->
    <div class="modal fade" id="modalPesable" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Producto Pesable</h5>
                    <button type="button" class="btn-close" data-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div>Ingrese peso o use la balanza</div>
                    <input id="txtPesoPesable" class="form-control form-control-lg text-center my-2" />
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button class="btn btn-primary" id="btnAgregarPesable">Agregar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

else
{
    @* Caja cerrada: no muestro mensaje, solo dejo el modal *@
    @Html.Partial("~/Views/Cajas/_AbrirCajaModal.cshtml")

}
<!-- Contenedor dinámico del modal -->
<div id="contenedorModalPersona"></div>

<div class="modal fade" id="modalFacturaElectronica" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="contenedorFacturaElectronica">
            <!-- se inyecta por ajax -->
        </div>
    </div>
</div>

<div class="modal fade" id="modalFinanzasPOS" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalFinanzasPOSTitle">
                    <i class="fas fa-file-invoice-dollar mr-2"></i>Finanzas
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-0" id="contenedorFinanzasPOS">
                <div class="p-4 text-center text-muted">
                    Cargando...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CORTES (Corte Maestro) - reutiliza partial -->
