                                        ? ((Entidades.Usuario)Session["Usuario"]).Empresa.NombreFantasia
                                        : "")
                                </div>
                            </div>
                        </div>
                        <div class="pos-sucursal-chip text-truncate">
                            <span class="pos-sucursal-chip-label">Sucursal</span>
