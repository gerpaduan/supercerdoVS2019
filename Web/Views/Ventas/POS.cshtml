@model Entidades.Venta

@{ ViewBag.Title = "CarniSys web | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";

    bool cajaAbierta = ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta;
}


<style>
    /* =============================
    FIX REAL PARA SB ADMIN 2 POS
    ============================= */


    #pos-app {
        height: 85vh;
        display: flex;
        flex-direction: column;
    }


        /* Card del POS */
        #pos-app > .card {
            /*flex: 1;
             overflow: auto;*/
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        #pos-app .card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* La fila principal */
        #pos-app .row.flex-grow-1 {
            flex: 1;
            min-height: 0;
        }

        /* Columna izquierda */
        #pos-app .carrito-col {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        /* SCROLL REAL */
        #pos-app .zona-tabla {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

    /* Total y botones no crecen */
    .zona-total,
    .zona-botones {
        flex-shrink: 0;
    }

    @@media (max-width: 992px) {
        /* La app deja de forzar altura */
        #pos-app {
            height: auto !important;
            min-height: auto !important;
        }

        #content {
            height: auto !important;
            min-height: auto !important;
        }
        /* La columna carrito deja de ser flex rígido */
        .carrito-col {
            display: block !important;
            height: auto !important;
            min-height: auto !important;
        }
        /* 🚫 SIN SCROLL interno */
        .zona-tabla {
            flex: none !important;
            overflow: visible !important;
            max-height: none !important;
            height: auto !important;
        }
        /* Total y botones pasan a flujo normal */
        .zona-total,
        .zona-botones {
            position: static !important;
        }
    }

    /* Desktop: asegurar que NO haya scroll de la página y SOLO .zona-tabla haga scroll */
    @@media (min-width: 992px) {
        html, body {
            height: 100%;
            overflow: hidden !important; /* prohibir scroll del viewport en desktop */
        }
        /* Forzar que el contenedor POS se ajuste dentro del viewport */
        #pos-app {
            max-height: 100vh;
            box-sizing: border-box;
            overflow: hidden;
        }
            /* Card / body no deben provocar scroll */
            #pos-app > .card,
            #pos-app .card-body,
            #pos-app .row.flex-grow-1 {
                height: 100%;
                min-height: 0;
                overflow: hidden;
                box-sizing: border-box;
            }
            /* Columna izquierda: zona-tabla es la única con scroll interno */
            #pos-app .carrito-col {
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden;
            }

                #pos-app .carrito-col .zona-tabla {
                    flex: 1 1 auto;
                    min-height: 0;
                    overflow-y: auto;
                }
            /* Columna derecha: no debe crear scroll del viewport */
            #pos-app .col-lg-6.d-flex.flex-column {
                display: flex !important;
                flex-direction: column !important;
                min-height: 0;
                overflow: visible;
                box-sizing: border-box;
            }
                /* Asegurar que elementos fijos (botones) no crezcan */
                #pos-app .col-lg-6.d-flex.flex-column > .mb-3,
                #pos-app .zona-botones {
                    flex: 0 0 auto;
                }
        /* Limitar teclado virtual para que no empuje layout */
        .keyboard-grid {
            max-height: 40vh;
            overflow-y: auto;
        }
    }

    /* Desktop: permitir que el teclado virtual "se encoja" y no genere scroll del viewport */
    @@media (min-width: 992px) {
        /* Teclado virtual: compacto pero legible */
        .keyboard-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-auto-rows: minmax(48px, 1fr); /* filas mínimas más grandes para legibilidad */
            gap: 8px;
            align-content: stretch;
            box-sizing: border-box;
            max-height: 40vh;
            overflow-y: auto; /* scroll interno solo si es estrictamente necesario */
        }
            /* Botones: se encogen pero conservan lectura */
            .keyboard-grid .btn-key,
            .keyboard-grid .btn-enter {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 0;
                height: 100%;
                padding: 8px 6px;
                font-size: clamp(1rem, 1.0vw, 1.18rem); /* nunca menor a 1rem, escala con viewport */
                line-height: 1;
                white-space: nowrap;
                box-sizing: border-box;
            }
            /* ENTER y 0 mantienen su posición en la grid */
            .keyboard-grid .btn-enter {
                grid-row: span 2;
            }

            .keyboard-grid .key-zero {
                grid-column: span 2;
            }
        /* Ajuste para pantallas muy grandes */
        @@media (min-width: 1400px) {
            .keyboard-grid {
                max-height: 45vh;
            }

                .keyboard-grid .btn-key,
                .keyboard-grid .btn-enter {
                    font-size: clamp(1.05rem, 0.9vw, 1.3rem);
                    padding: 10px 8px;
                }
        }
    }
</style>
