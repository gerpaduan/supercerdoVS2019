        // ===============================
        // HELPERS NUMÉRICOS (AR)
        // ===============================
        function toFloatAR(v) {
            // Acepta: "12,34" | "12.34" | "$ 12,34" | "$ 12.34"
            // Si vienen ambos separadores, asume "." miles y "," decimales.
            let s = String(v ?? "").trim();

            // dejar solo números, coma, punto y signo
            s = s.replace(/[^0-9,.\-]/g, "");

            const hasComma = s.includes(",");
            const hasDot = s.includes(".");

            if (hasComma && hasDot) {
                // 1.234,56 => 1234.56
                s = s.replace(/\./g, "").replace(",", ".");
            } else if (hasComma) {
                // 1234,56 => 1234.56
                s = s.replace(",", ".");
            }
            const n = parseFloat(s);
            return isNaN(n) ? 0.0 : n;
        }

        // ===============================
        // TOTAL VENTA (GLOBAL)
        // ===============================
        window.obtenerTotalVenta = function obtenerTotalVenta() {
            const lineas = (window.lineasVenta && Array.isArray(window.lineasVenta) && window.lineasVenta.length)
                ? window.lineasVenta
                : (typeof carrito !== "undefined" ? carrito : []);

            let total = 0.0;

            for (const l of lineas) {
                if (!l || l.anulado) continue;

                // si viene subtotal formateado lo usamos
                let sub = toFloatAR(l.subtotal);

                // fallback: si no hay subtotal, calculamos cant * precio
                if (!sub) {
                    const cant = toFloatAR(l.cant);
                    const precio = toFloatAR(l.precio);
                    sub = cant * precio;
                }

                total += sub;
            }
            return total;
        };



