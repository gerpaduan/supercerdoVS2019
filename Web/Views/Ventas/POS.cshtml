    /* =========================================================
     TECLADO: forma y spans SIEMPRE (todas las resoluciones)
     ========================================================= */
    .keyboard-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
        /* altura de tecla por defecto (tablet/desktop) */
        --key-h: 56px;
        grid-auto-rows: var(--key-h);
        overflow: visible !important;
        max-height: none !important;
    }

    /* Spans SIEMPRE (no dentro de media) */
    .key-zero {
        grid-column: span 2;
    }

    .btn-enter {
        grid-row: span 2;
        font-weight: 800;
    }

    /* Teclas */
    .btn-key {
        height: 100%;
        min-height: var(--key-h);
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        padding: .35rem .2rem;
        font-size: clamp(.95rem, 1.0vw, 1.2rem);
    }

    /* =========================================================
     BLOQUE INFO PRODUCTO: estirar alto y alinear columnas
     ========================================================= */
    #producto-info {

        min-height: clamp(230px, 33vh, 400px);
    }

    /* En desktop, que ambas columnas se estiren igual */
    @@media (min-width: 992px) {
        #producto-info {
            min-height: clamp(168px, 23vh, 290px);
        }

        #producto-info .row {
            align-items: stretch;
        }

        #producto-info .col-6:last-child {
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        /* Pantalla completa / viewport muy alto: agrandar TODO el contenido de #producto-info en
           proporcion (no solo dejar aire alrededor). El truco es que estos clamps son en vh
           (alto de viewport) igual que --key-h de abajo -- al crecer las fuentes/alto de los
           campos de la columna izquierda, su contenido natural se vuelve mas alto, y como
           #producto-info no tiene flex-grow propio (ver incidencias-frecuentes.md, 2026-08-11),
           su alto real pasa a ser el de este contenido -- eso es lo que despues estira el teclado
           via align-items:stretch, manteniendo el alineado con "Agregar" en cualquier tamano.
           !important en varias: hay reglas sin media query mas abajo en el archivo (#prodNombre,
           #prodSubtotal, .pos-product-metric, #inputCantidad) que, por orden de aparicion, pisan
           a esta con la misma especificidad -- mismo patron ya documentado con .pos-footer-panel. */
        #prodNombre {
            font-size: clamp(1.1rem, 2.4vh, 2rem) !important;
        }

        .lbl-precio,
        .lbl-cantidad,
        .lbl-subtotal {
            font-size: clamp(.85rem, 1.6vh, 1.25rem);
        }

        #prodPrecio {
            font-size: clamp(1.1rem, 2.2vh, 1.9rem);
        }

        #prodSubtotal {
            font-size: clamp(1.15rem, 2.3vh, 2rem) !important;
        }

        .pos-product-metric {
            padding: clamp(.4rem, 1.1vh, .9rem) clamp(.5rem, 1.3vh, 1rem) !important;
        }

        #inputCantidad {
            font-size: clamp(1.3rem, 2.6vh, 2.2rem) !important;
            min-height: clamp(48px, 7vh, 76px) !important;
        }

        .btn-agregar-pos {
            min-height: clamp(52px, 7.5vh, 84px);
        }

        .btn-agregar-pos i {
            font-size: clamp(1.1rem, 2.2vh, 1.7rem);
        }

        .btn-agregar-pos small {
            font-size: clamp(.7rem, 1.3vh, .95rem);
        }

        .keyboard-grid {
            /* minmax(min, 1fr): las filas se estiran para llenar exactamente el alto de
               #producto-info .row (align-items:stretch, ya existente) -- que ahora crece junto
               con el contenido de la columna izquierda (arriba). Por eso el teclado termina
               alineado con "Agregar" en cualquier tamano de pantalla.
               --key-h se deja BAJO a proposito (piso, via .btn-key min-height mas abajo): si se
               sube demasiado, ese min-height por boton compite con el 1fr y fuerza el grid a ser
               MAS ALTO de lo que el stretch calculo, desalineando el teclado de "Agregar" de
               nuevo. El crecimiento visual de las teclas ya lo da el font-size (mas abajo), no
               hace falta que el piso de altura tambien crezca. */
            --key-h: clamp(42px, 5.2vh, 64px);
            grid-auto-rows: minmax(42px, 1fr);
            gap: 6px;
        }

        .btn-key {
            padding: .28rem .16rem;
            font-size: clamp(.9rem, 2.4vh, 1.7rem);
        }

        .zona-botones {
            padding: .34rem .38rem;
        }

        .pos-balanza-caption {
            font-size: .78rem;
            line-height: 1.15;
        }

        #msgBalanzaPOS {
            min-height: .85rem;
            font-size: .84rem;
            margin-top: .08rem !important;
        }
    }

