@section Scripts {
    <script>

        let typingTimer = null;
        let productoSeleccionado = null;
        let precioActual = 0;
        // ===== ESTADO POS EN MEMORIA =====
        let carrito = [];
        // Alias global
        window.lineasVenta = carrito;
        window.fechaVenta = new Date();
        let indexLinea = 1;
        let ingresoCantidadX = false;
        let enterDesdeTecladoVirtual = false;

        (function () {

            const dias = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
            const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            function actualizarFechaHora() {

                //Actualiza Hora al registrar el primer producto o si no tiene
                if (!(carrito.length === 0 || carrito.length === 1))
                    return;

                const ahora = new Date();

                const fechaSql = ahora.toISOString().slice(0, 19);
                // → "2025-12-24T11:42:30"

                $('#fechaVenta').val(fechaSql);

                //window.fechaVenta = '2025-12-12';
                //$('#fechaVenta').val(ahora);

                const diaSemana = dias[ahora.getDay()];
                const dia = ahora.getDate();
                const mes = meses[ahora.getMonth()];
                const anio = ahora.getFullYear();

                const hora = String(ahora.getHours()).padStart(2, '0');
                const minutos = String(ahora.getMinutes()).padStart(2, '0');

                const formato = `${diaSemana} ${dia} de ${mes}, ${anio} · ${hora}:${minutos}`;

                const span = document.getElementById('fechaHoraPOS');
                if (span) {
                    span.innerText = formato;
                }
            }

            actualizarFechaHora();
            setInterval(actualizarFechaHora, 60000); // refresca cada minuto

        })();

            //ABRIR CAJA

        function obtenerFechaHoraActual() {
            const ahora = new Date();

            const pad = n => n.toString().padStart(2, '0');

            const fecha =
                pad(ahora.getDate()) + '/' +
                pad(ahora.getMonth() + 1) + '/' +
                ahora.getFullYear() + ' ' +
                pad(ahora.getHours()) + ':' +
                pad(ahora.getMinutes());

            return fecha;
        }

            $(document).ready(function () {

            const cajaAbierta = '@ViewBag.CajaAbierta'.toLowerCase() === 'true';

                if (!cajaAbierta) {
                    $('#fechaHoraApertura').val(obtenerFechaHoraActual());
                    $('#modalAbrirCaja').modal('show');
                }
            });

        function abrirCaja() {

            //let cajaInicio = parseFloat($("#montoInicial").val().replace(",", "."));

            //if (isNaN(cajaInicio) || cajaInicio <= 0) {
            //    Swal.fire({
            //        icon: 'warning',
            //        title: 'Caja inicial',
            //        text: 'Ingrese un importe válido mayor a cero',
            //        confirmButtonColor: '#4e73df'
            //    });
            //    return;
            //}
            const input = document.getElementById("montoInicial");

            if (!input) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se encontró el campo Monto Inicial'
                });
                return;
            }

            let cajaInicio = parseFloat(input.value.replace(",", "."));

            if (isNaN(cajaInicio) || cajaInicio <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Caja inicial',
                    text: 'Ingrese un importe válido mayor a cero',
                    confirmButtonColor: '#4e73df'
                });
                return;
            }

            $.ajax({
                url: '@Url.Action("AbrirCaja", "Cajas")',
                type: 'POST',
                data: {
                    cajaInicio: $("#montoInicial").val(),
                    fechaHora: $("#fechaHoraApertura").val()
                },
                success: function (response) {

                    if (response.ok) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Caja abierta',
                            text: 'La caja se abrió correctamente',
                            timer: 1200,
                            showConfirmButton: false
                        }).then(() => {
                            $('#modalAbrirCaja').modal('hide');
                            location.reload();
                        });

                    } else {

                        Swal.fire({
                            icon: 'warning',
                            title: 'No se pudo abrir la caja',
                            text: response.mensaje,
                            confirmButtonColor: '#4e73df'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Ocurrió un error al intentar abrir la caja',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }


            //FIN ABRIR CAJA


        // ================================
        // BUSCAR PERSONA (POS)
        // ================================
        $(document).on('click', '#btnBuscarPersona', function () {

            $('#contenedorModalPersona').load(window.api.persona.buscar, function () {

                $('#modalBuscarPersona').modal('show');
                cargarPersonas(); // carga inicial
            });

        });



        $('#btnConsumidorFinal').on('click', function () {

            $('#idPersona').val('@Entidades.Parametros.idConsumidorFinal');
            $('#razonSocial').val('Consumidor Final');

        });

        // ================================
        // BÚSQUEDA EN VIVO
        // ================================
        $("#inputCodigo").on("keyup", function (e) {

            let cod = this.value.trim().toUpperCase();

            // ⌨️ ENTER → cancelar debounce y pasar a cantidad
            if (e.key === "Enter") {
                clearTimeout(typingTimer);
                terminarEscritura(cod, function () {
                    // 👇 se ejecuta CUANDO el producto YA está cargado
                    pasarAFocoCantidad();
                });
                return;
            }

            // ⛔ Si tiene X, no buscar (se procesa con Enter)
            if (cod.includes("X")) {
                mostrarSinCoincidencia();
                clearTimeout(typingTimer);
                return;
            }

            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                terminarEscritura(cod);
            }, 250);
        });


        function terminarEscritura(codigo, callback = null) {

            if (codigo === "") {
                mostrarEsperando();
                return;
            }

            $.ajax({
                url: '@Url.Action("BuscarProducto", "Ventas")',
                method: "GET",
                data: { codigo: codigo },
                timeout: 8000, // ⏱ 8 segundos

                success: function (data) {
                    if (!data || data.error) {
                        mostrarSinCoincidencia();
                        return;
                    }

                    mostrarProducto(data);
                    productoSeleccionado = data;
                    if (callback) callback();
                },

                error: function (xhr, status) {

                    if (status === "timeout") {
                        mostrarErrorConexion("Tiempo de espera agotado");
                    } else if (!navigator.onLine) {
                        mostrarErrorConexion("Sin conexión a Internet");
                    }
                    //else {
                    //    mostrarErrorConexion("Error de conexión con el servidor");
                    //}
                }
            });

            @*$.ajax({
                url: '@Url.Action("BuscarProducto", "Ventas")',
                //url: "/Ventas/BuscarProducto",
                method: "GET",
                data: { codigo: codigo },

                success: function (data) {
                    if (!data || data.error) {
                        mostrarSinCoincidencia();
                        return;
                    }

                    mostrarProducto(data);
                    productoSeleccionado = data;

                    // 🔥 ACÁ está la magia
                    if (callback) callback();
                },

                error: function () {
                    mostrarSinCoincidencia();
                }
            });*@
        }

        function mostrarErrorConexion(msg) {
            Swal.fire({
                icon: 'error',
                title: 'Sin conexión',
                text: msg,
                allowOutsideClick: false
            });
        }

        // --------------------------------------------------------------------
        //  ESTADOS DEL PANEL
        // --------------------------------------------------------------------

        // PRODUCTO ENCONTRADO
        function mostrarProducto(p) {

            $("#prodNombre")
                .text(p.nombre)
                .removeClass("text-muted")
                .addClass("fw-bold");

            $("#prodPrecio")
                .text("$ " + p.precioKg.toLocaleString("es-AR"))
                .removeClass("text-muted")
                .addClass("fw-bold");

            precioActual = p.precioKg;

            $("#inputCantidad")
                .prop("disabled", false)
                //.val(p.pesable ? obtenerPesoBalanza() : "")
                //.focus();

            $("#prodSubtotal").text("$ 0,00");
            calcularSubtotal();

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // NO HAY COINCIDENCIA
        function mostrarSinCoincidencia() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Sin coincidencia")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio")
                .text("")
                .addClass("text-muted");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // ESTADO INICIAL
        function mostrarEsperando() {

            productoSeleccionado = null;
            precioActual = 0;

            $("#prodNombre")
                .text("Info producto...")
                .removeClass("fw-bold")
                .addClass("text-muted");

            $("#prodPrecio").text("");

            $("#prodSubtotal").text("$ 0,00");

            $("#inputCantidad")
                .prop("disabled", true)
                .val("");

            $("#btnAgregarProducto").prop("disabled", true);
        }


        // --------------------------------------------------------------------
        // CALCULAR SUBTOTAL EN VIVO
        // --------------------------------------------------------------------
        $("#inputCantidad").on("input", calcularSubtotal);

        function calcularSubtotal() {

            let cant = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cant) || cant <= 0 || precioActual <= 0) {
                $("#prodSubtotal").text("$ 0,00");
                $("#btnAgregarProducto").prop("disabled", true);
                return;
            }

            let subtotal = cant * precioActual;

            $("#prodSubtotal").text(
                "$ " + subtotal.toLocaleString("es-AR", {
                    minimumFractionDigits: 2
                })
            );

            $("#btnAgregarProducto").prop("disabled", false);
        }


        // --------------------------------------------------------------------
        // CALCULAR TOTAL EN VIVO
        // --------------------------------------------------------------------
        function recalcularTotal() {
            let total = 0;

            carrito.forEach(l => {
                // l.subtotal viene como "$ 123.45"
                const valor = parseFloat(
                    l.subtotal.replace("$", "").replace(",", ".")
                );

                if (!isNaN(valor)) {
                    total += valor;
                }
            });

            $("#lblSubtotal").text(
                `$ ${total.toFixed(2).replace(".", ",")}`
            );
        }

        function obtenerTotalVenta() {

            let texto = $('#lblSubtotal').text() || '0';

            // Limpia símbolos y convierte a número
            texto = texto
                .replace('$', '')
                .replace(/\./g, '')
                .replace(',', '.')
                .trim();

            let total = parseFloat(texto);

            return isNaN(total) ? 0 : total;
        }

        // ====================================================
        // FOCO EN CANTIDAD TODO: VALIDAR SI EL PRODUCTO EXISTE
        // ====================================================
        $("#inputCodigo").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                clearTimeout(typingTimer); // 🔥 CLAVE (cancelar debounce)
                enterDesdeTecladoVirtual = false;
                manejarEnter();
            }
        });


        // ====================================================
        // BUSCAR PRODUCTO (ya lo usás)
        // ====================================================
        function seleccionarProducto(data) {
            productoSeleccionado = data;
        }

        // ====================================================
        // AGREGAR CUANDO PRESIONA ENTER EN CANTIDAD
        // ====================================================
        $("#inputCantidad").on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                agregarProducto();
            }
        });

        $("#btnAgregarProducto").on("click", function () {
            agregarProducto();
        });

        // ====================================================
        // FUNCIÓN PRINCIPAL PARA AGREGAR
        // ====================================================
        function agregarProducto() {

            if (!productoSeleccionado) {
                alert("Selecciona un producto primero");
                volverACodigo();
                return;
            }

            let cantidad = parseFloat($("#inputCantidad").val().replace(",", "."));

            if (isNaN(cantidad) || cantidad <= 0) {
                alert("Cantidad inválida");
                return;
            }
            // ===== SIMULACIÓN BACKEND =====

            const subtotal = cantidad * productoSeleccionado.precioKg;

            const linea = {
                index: indexLinea++,
                producto: productoSeleccionado.nombre,
                codigo: productoSeleccionado.codigo,
                cant: cantidad.toFixed(3),
                precio: `$ ${productoSeleccionado.precioKg.toFixed(2)}`,
                subtotal: `$ ${(subtotal).toFixed(2)}`
            };

            carrito.push(linea);

            // simula respuesta del backend
            const r = {
                ok: true,
                lineas: carrito
            };

            // mismo flujo que AJAX success
            renderTablaProductos(r.lineas);

            scrollTablaAlFinal();

            // recalcular total
            recalcularTotal();

            // limpiar campos
            $("#inputCodigo").val("").focus();
            $("#inputCantidad").val("");
            $("#prodSubtotal").text("$ 0,00");

            productoSeleccionado = null;
            mostrarEsperando();

        }

        // ====================================================
        // RENDER DE LA TABLA (mantiene tu diseño)
        // ====================================================
        function renderTablaProductos(lineas) {

            let tbody = $("#tablaItems");
            tbody.empty();

            if (!lineas || lineas.length === 0) {
                tbody.append(`
                                <tr id="filaVacia">
                                    <td class="text-muted text-center py-3">
                                        No hay productos agregados
                                    </td>
                                </tr>
                            `);
                return;
            }

            lineas.forEach(l => {
                tbody.append(`
                                <tr data-id="${l.index}" class="fila-item">
                                    <td>
                                        <div class="fw-bold">
                                            #${l.index} <strong>${l.producto}</strong> (cod: ${l.codigo})
                                        </div>

                                        <div class="d-flex justify-content-between item-detalle">
                                            <span >&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${l.cant} x ${l.precio}</span>
                                            <span class="fw-bold">${l.subtotal}</span>
                                        </div>
                                    </td>
                                </tr>
                            `);
            });
        }

        // Fullscreen toggle
        document.getElementById('btn-toggle-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
        });

        function scrollTablaAlFinal() {
            const zonaTabla = document.querySelector('.zona-tabla');
            if (!zonaTabla) return;

            zonaTabla.scrollTo({
                top: zonaTabla.scrollHeight,
                behavior: 'smooth' // podés usar 'auto' si no querés animación
            });
        }

        ////TECLADO
        let inputActivo = null;

        document.addEventListener("focusin", e => {
            if (e.target.tagName === "INPUT") {
                inputActivo = e.target;
            }
        });

        // Manejo de teclas del teclado virtual
        document.querySelectorAll(".btn-key").forEach(btn => {
            btn.addEventListener("click", () => {
                const tecla = btn.innerText.trim();
                if (!inputActivo) return;

                switch (tecla) {
                    case "←":
                        borrarCaracter();
                        break;

                    case "Enter":
                        enterDesdeTecladoVirtual = true;
                        manejarEnter();
                        break;

                    case "×":
                        escribirX();
                        break;

                    default:
                        escribirCaracter(tecla);
                        break;
                }
            });
        });

        function volverACodigo() {
            $("#inputCodigo").focus().select();
        }

        function pasarAFocoCantidad() {
            $("#inputCantidad").focus().select();
        }

        function escribirCaracter(valor) {
            if (!inputActivo) return;

            if (inputActivo.id === "inputCantidad") {

                // solo números o punto
                if (!/^[0-9.]$/.test(valor)) return;

                // evitar doble punto
                if (valor === "." && inputActivo.value.includes(".")) return;

                // si empieza con punto, anteponer 0
                if (valor === "." && inputActivo.value === "") {
                    inputActivo.value = "0";
                }
            }

            inputActivo.value += valor;

            //si cantidad tiene el foco
            if (inputActivo.id === "inputCantidad")
                calcularSubtotal();
            else
                terminarEscritura(inputActivo.value);
        }

        function escribirX() {
            if (inputActivo.id !== "inputCodigo") return;

            // Solo una X
            if (inputActivo.value.includes("X")) return;

            inputActivo.value += "X";
        }

        function borrarCaracter() {
            if (!inputActivo) return;

            inputActivo.value = inputActivo.value.slice(0, -1);
            terminarEscritura(inputActivo.value);
        }


        function manejarEnter() {

            if (!inputActivo) return;

            if (inputActivo.id === "inputCantidad") {
                agregarProducto();
                enterDesdeTecladoVirtual = false;
                return;
            }

            if (enterDesdeTecladoVirtual || inputActivo.id === "inputCodigo") {
                procesarCodigoConCantidad();

                if (ingresoCantidadX) {
                    ingresoCantidadX = false;
                    enterDesdeTecladoVirtual = false;
                    return;
                }

                pasarAFocoCantidad();
                return;
            }

        }


        function procesarCodigoConCantidad() {

            const codigoInput = document.getElementById("inputCodigo");
            const valor = codigoInput.value.toUpperCase();

            if (!valor.includes("X")) return;

            const partes = valor.split("X");
            if (partes.length !== 2) return;

            const cantidad = partes[0];
            const codigo = partes[1];

            if (!cantidad || !codigo) return;

            $("#inputCantidad").val(cantidad);
            codigoInput.value = codigo;

            terminarEscritura(codigo, function () {
                // 👇 se ejecuta CUANDO el producto YA está cargado
                agregarProducto();
                mostrarEsperando();
            });

            ingresoCantidadX = true;
        }


        $('#btnFinalizar').on('click', function () {
            if (carrito.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Venta vacía',
                    text: 'Debe agregar al menos un producto'
                });

                return;
            }

            $('#modalFormaPago').modal('show');
        });



        function esPantallaChica() {
            return window.innerWidth < 768; // Bootstrap md breakpoint
        }

        function configurarInputsPOS() {
            if (esPantallaChica()) {
                // Bloquea teclado nativo
                $('#inputCodigo, #inputCantidad')
                    .attr('readonly', true)
                    .attr('inputmode', 'none');
            } else {
                // Permite teclado normal
                $('#inputCodigo, #inputCantidad')
                    .removeAttr('readonly')
                    .removeAttr('inputmode');
            }
        }

        // Ejecutar al cargar la página
        $(document).ready(configurarInputsPOS);

        // Reconfigurar al cambiar tamaño de pantalla
        $(window).on('resize', configurarInputsPOS);


        // URLs generadas por MVC (seguras para cualquier entorno)
        window.api = window.api || {};

        window.api.venta = {
            finalizar: '@Url.Action("FinalizarVenta", "Ventas")'
        };

        window.api.persona = {
            listar: '@Url.Action("Listar", "Personas")',
            buscar: '@Url.Action("Buscar", "Personas")'
        };

    </script>
}

