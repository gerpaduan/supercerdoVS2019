    $(function () {

         // -----------------------
    // Helpers
    // -----------------------
    function pad(n) { return (n < 10 ? "0" : "") + n; }

    // dd/MM/yyyy HH:mm
    function nowAR() {
        var d = new Date();
        return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear()
            + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
    }

    function mostrarError(msg) {
        if (window.Swal) {
            Swal.fire({ icon: 'error', title: 'No se pudo abrir la caja', text: msg || 'Error' });
        } else {
            alert(msg || 'No se pudo abrir la caja');
        }
    }

    // -----------------------
    // Acci�n Abrir Caja (llama al controller)
    // -----------------------
    window.abrirCaja = function () {
        var cajaInicio = $("#montoInicial").val();
        var fechaHora = $("#fechaHoraApertura").val();

        $.ajax({
            url: '@Url.Action("AbrirCaja", "Cajas")',
            type: 'POST',
            dataType: 'json',
            data: { cajaInicio: cajaInicio, fechaHora: fechaHora },
            success: function (r) {
                if (r && r.ok) {
                    // ? Ya se abri�: recargo el POS (ahora el controller deber�a dejarte entrar)
                    try {
                        sessionStorage.setItem("pos-mostrar-recordatorio-sucursal", "1");
                    } catch (e) { }
                    $("#modalAbrirCaja").modal('hide');
                    location.reload();
                    return;
                }

                // ? No abri�: muestro error y me quedo en el modal
                mostrarError((r && r.mensaje) ? r.mensaje : "Error al abrir caja.");
            },
            error: function () {
                mostrarError("No se pudo contactar al servidor.");
            }
        });
    };

    // -----------------------
    // Init
    // -----------------------
    $(function () {

        // Si el controller te setea ViewBag.CajaAbierta (como ya haces):
        var cajaAbierta = @((ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta) ? "true" : "false");

        if (!cajaAbierta) {
            // seteo fecha/hora y abro modal
            $("#fechaHoraApertura").val(nowAR());

            $("#modalAbrirCaja").modal('show');

            $("#modalAbrirCaja").on("shown.bs.modal", function () {
                $("#montoInicial").trigger("focus");
            });

            // Cancelar => volver al Index (layout base)
            $("#btnCancelarAbrirCaja").off("click").on("click", function () {
                window.location.href = '@Url.Action("Index", "Home")';
            });

            // Enter en monto => abrir caja
            $("#montoInicial").off("keydown").on("keydown", function(e){
                if (e.key === "Enter") {
                    e.preventDefault();
                    window.abrirCaja();
                }
                if (e.key === "Escape") {
                    e.preventDefault();
                    $("#btnCancelarAbrirCaja").click();
                }
            });
        }

    });


        // ? Guard: si NO est� el POS renderizado, NO ejecuto el script del POS
        if (!document.getElementById("pos-app") || !document.getElementById("inputCodigo")) {
            console.warn("POS script: no est� el HTML del POS (caja cerrada o vista distinta).");
            return;
        }

    document.addEventListener("click", habilitarAudio, { once: true });

    function habilitarAudio() {
        const audio = document.getElementById("beep");
        audio.volume = 0;
        audio.play().finally(() => {
            audio.pause();
            audio.currentTime = 0;
            audio.volume = 1;
        });
    }

    // VARIABLES
    let stream = null;
    let track = null;
    let detector = null;
    let scanning = false;
    let esEAN = false;
    let ultimoCodigo = null;
    let ultimoTiempo = 0;
    const TIEMPO_RELECTURA = 2000;
    const video = document.getElementById("videoScanner");

    const scanner = new BarcodeScanner({
            videoSelector: "#videoScanner",
            containerSelector: "#scannerContainer",
            onCodeDetected: function (codigo) {
                document.querySelector("#inputCodigo").value = codigo;
                document.querySelector("#inputCodigo").focus();
                manejarEnter();
                // si quer�s cerrar al detectar:
                // scanner.cerrar();
            }
        });
        document.getElementById("btnScanner")?.addEventListener("click", () => scanner.iniciar());
        document.getElementById("btnCerrarScanner")?.addEventListener("click", () => scanner.cerrar());

        document.getElementById("btnFlash")?.addEventListener("click", async () => {
            const estado = await scanner.toggleFlash();

            // feedback visual opcional
            const btn = document.getElementById("btnFlash");
            if (estado) {
                btn.classList.remove("btn-secondary");
                btn.classList.add("btn-warning");
                btn.textContent = "?? Flash ON";
            } else {
                btn.classList.remove("btn-warning");
                btn.classList.add("btn-secondary");
                btn.textContent = "?? Flash";
            }
        });


    // BEEP
    function beep() {
        const audio = document.getElementById("beep");
        if (!audio) return;
        audio.currentTime = 0;
        audio.play();
    }

    // URLs
    window.api = window.api || {};
    window.api.producto = window.api.producto || {};
    window.api.producto.listar = '@Url.Action("ListarParaPOS", "Productos")';

    // ===== ESTADO POS EN MEMORIA =====
    const POSState = window.POSState;
    const carrito = POSState.getLineas();
    const esEdicionVenta = @(esEdicionVenta ? "true" : "false");
    const soloFormaPago = @(soloFormaPago ? "true" : "false");
    const puedeEditarFechaVenta = @(puedeEditarFechaVenta ? "true" : "false");
    const lineasEdicionPos = @Html.Raw(Json.Encode(lineasEdicionPos));
    const listaExpendiosEdicionPos = @Html.Raw(Json.Encode(listaExpendiosEdicionPos));
    POSState.setFechaVenta(new Date());
    POSState.setObservaciones(@Html.Raw(Json.Encode(Model != null ? Model.Observaciones ?? "" : "")));
    window.POSFinalizandoVenta = false;
    window.POSVentaFinalizada = false;
    window.POSSoloFormaPagoGuardado = false;
    window.POSModo = window.POSModo || {};
    window.POSModo.soloFormaPago = soloFormaPago;
    window.POSModo.returnUrl = @Html.Raw(Json.Encode(returnUrlPOS));
    window.POSModo.abrirDetalleVentaId = @abrirDetalleVentaId;
    window.POSModo.returnUrlDetalle = @Html.Raw(Json.Encode(returnUrlDetalle));
    window.POSFormaPagoActual = {
        formaPago: @Html.Raw(Json.Encode(Model != null ? Model.FormaPago ?? "" : "")),
        pagoMixtoEfectivo: @Html.Raw(Json.Encode(Model != null ? Model.PagoMixtoEfectivo : 0f)),
        total: @Html.Raw(Json.Encode(Model != null ? Model.TotalImporte : 0f))
    };
    const sucursalNombrePOS = @Html.Raw(Json.Encode(sucursalNombrePOS));
    const POS_INACTIVIDAD_RECORDATORIO_MS = 3 * 60 * 60 * 1000;
    const POS_RECORDATORIO_SUCURSAL_KEY = "pos-mostrar-recordatorio-sucursal";
    let posInactividadTimer = null;
    let posRecordatorioSucursalAbierto = false;
    let posAbrioSucursalDesdeRecordatorio = false;

    function htmlRecordatorioSucursalPOS() {
        const sucursalSegura = $('<div>').text(sucursalNombrePOS || '').html();
        return ''
            + '<div class="mb-2">Usted esta operando en la sucursal:</div>'
            + '<div style="font-size:1.75rem; font-weight:700; line-height:1.2;">' + sucursalSegura + '</div>'
            + '<div class="mt-3">'
            + '  <button type="button" id="btnCambiarSucursalDesdeRecordatorio" class="btn btn-outline-secondary btn-sm">Cambiar sucursal</button>'
            + '</div>';
    }

    function abrirModalCambioSucursalDesdeRecordatorio() {
        posAbrioSucursalDesdeRecordatorio = true;
        if (window.Swal) {
            Swal.close();
        }

        setTimeout(function () {
            $("#modalSucursales").modal("show");
        }, 150);
    }

    function mostrarRecordatorioSucursalPOS(reiniciarDespues) {
        if (!sucursalNombrePOS || !window.Swal || posRecordatorioSucursalAbierto) {
            return;
        }

        posRecordatorioSucursalAbierto = true;
        posAbrioSucursalDesdeRecordatorio = false;
        Swal.fire({
            icon: 'info',
            html: htmlRecordatorioSucursalPOS(),
            confirmButtonText: 'Continuar',
            confirmButtonColor: '#4e73df',
            allowOutsideClick: false,
            didOpen: function () {
                const btnCambiarSucursal = document.getElementById('btnCambiarSucursalDesdeRecordatorio');
                if (btnCambiarSucursal) {
                    btnCambiarSucursal.addEventListener('click', abrirModalCambioSucursalDesdeRecordatorio);
                }
            }
        }).then(function () {
            posRecordatorioSucursalAbierto = false;
            if (!posAbrioSucursalDesdeRecordatorio && reiniciarDespues !== false) {
                reiniciarTemporizadorInactividadPOS();
            }
        });
    }

    function reiniciarTemporizadorInactividadPOS() {
        if (posInactividadTimer) {
            clearTimeout(posInactividadTimer);
        }

        posInactividadTimer = setTimeout(function () {
            mostrarRecordatorioSucursalPOS();
        }, POS_INACTIVIDAD_RECORDATORIO_MS);
    }

    function registrarActividadPOS() {
        if (posRecordatorioSucursalAbierto) {
            return;
        }

        reiniciarTemporizadorInactividadPOS();
    }

    if (sucursalNombrePOS) {
        let mostrarAlAbrirCaja = false;
        try {
            mostrarAlAbrirCaja = sessionStorage.getItem(POS_RECORDATORIO_SUCURSAL_KEY) === "1";
            sessionStorage.removeItem(POS_RECORDATORIO_SUCURSAL_KEY);
        } catch (e) { }

        if (mostrarAlAbrirCaja) {
            setTimeout(function () {
                if (window.Swal) {
                    mostrarRecordatorioSucursalPOS(true);
                }
            }, 250);
        }

        ['click', 'keydown', 'mousemove', 'scroll', 'touchstart'].forEach(function (eventName) {
            window.addEventListener(eventName, registrarActividadPOS, { passive: true });
        });

        reiniciarTemporizadorInactividadPOS();
    }

    $(document).on("sucursal:cambiada", function () {
        window.desactivarAvisoSalidaPOS?.();
        window.POSDraft?.clear?.();
        window.location.href = '@Url.Action("POS", "Ventas")';
    });

    function getFechaVentaPOS() {
        return $("#fechaVentaEditable").length ? $("#fechaVentaEditable").val() : $("#fechaVenta").val();
    }

    function setFechaVentaPOS(value) {
        if (!value) return;
        $("#fechaVenta").val(value);
        if ($("#fechaVentaEditable").length) {
            $("#fechaVentaEditable").val(String(value).slice(0, 16));
        }
    }

    if ($("#fechaVentaEditable").length) {
        $("#fechaVentaEditable").on("change input", function () {
            const value = $(this).val();
            if (value) {
                $("#fechaVenta").val(value);
            }
        });
    }

    window.POSDraft = window.POSDraft || (function () {
        const keyBase = "carnisys-pos-venta-en-curso";
        const idSucursalActual = parseInt($("#idSucursalPOS").val(), 10) || 0;
        const idUsuarioActual = @idUsuarioPOS;
        const key = keyBase + "-" + idUsuarioActual + "-" + idSucursalActual;
        const legacyKey = keyBase;

        function getLineasActivas() {
            return POSState.getLineas().filter(function (linea) {
                return linea && !linea.anulado;
            });
        }

        function getLineasCargadas() {
            return POSState.getLineas().filter(function (linea) {
                return !!linea;
            });
        }

        function save() {
            if (esEdicionVenta) {
                clear();
                return;
            }

            if (window.POSFinalizandoVenta || window.POSVentaFinalizada) {
                localStorage.removeItem(key);
                localStorage.removeItem(legacyKey);
                return;
            }

            const lineas = POSState.getLineas();

            if (!lineas.some(function (linea) { return !!linea; })) {
                if (window.POSCancelacionEnCurso) return;
                localStorage.removeItem(key);
                localStorage.removeItem(legacyKey);
                return;
            }

            localStorage.setItem(key, JSON.stringify({
                lineas: lineas,
                listaExpendios: POSState.getListaExpendios ? POSState.getListaExpendios() : [],
                idUsuarioPOS: idUsuarioActual,
                idSucursalPOS: idSucursalActual,
                idPersona: $("#idPersona").val(),
                razonSocial: $("#razonSocial").val(),
                observaciones: POSState.getObservaciones(),
                fechaVenta: getFechaVentaPOS()
            }));

            localStorage.removeItem(legacyKey);
        }

        function tryParseDraft(storageKey) {
            try {
                return JSON.parse(localStorage.getItem(storageKey) || "null");
            } catch (e) {
                localStorage.removeItem(storageKey);
                return null;
            }
        }

        function esDraftCompatible(draft) {
            if (!draft || !Array.isArray(draft.lineas)) return false;

            const lineasCargadas = draft.lineas.filter(function (linea) {
                return !!linea;
            });

            if (!lineasCargadas.length) return false;

            const draftSucursal = parseInt(draft.idSucursalPOS, 10);
            if (Number.isFinite(draftSucursal) && draftSucursal > 0 && draftSucursal !== idSucursalActual) {
                return false;
            }

            const draftUsuario = parseInt(draft.idUsuarioPOS, 10);
            if (Number.isFinite(draftUsuario) && draftUsuario > 0 && draftUsuario !== idUsuarioActual) {
                return false;
            }

            return true;
        }

        function restore() {
            let draft = tryParseDraft(key);

            if (!esDraftCompatible(draft)) {
                if (draft != null) {
                    localStorage.removeItem(key);
                }
                draft = null;
            }

            if (draft == null) {
                const legacyDraft = tryParseDraft(legacyKey);
                if (esDraftCompatible(legacyDraft)) {
                    draft = legacyDraft;
                    localStorage.setItem(key, JSON.stringify({
                        lineas: legacyDraft.lineas,
                        listaExpendios: legacyDraft.listaExpendios || [],
                        idUsuarioPOS: idUsuarioActual,
                        idSucursalPOS: idSucursalActual,
                        idPersona: legacyDraft.idPersona,
                        razonSocial: legacyDraft.razonSocial,
                        observaciones: legacyDraft.observaciones,
                        fechaVenta: legacyDraft.fechaVenta
                    }));
                }

                localStorage.removeItem(legacyKey);
            }

            if (!draft) {
                return false;
            }

            POSState.setLineas(draft.lineas);
            POSState.setListaExpendios?.(draft.listaExpendios || []);

            if (draft.idPersona) $("#idPersona").val(draft.idPersona);
            if (draft.razonSocial) $("#razonSocial").val(draft.razonSocial);
            if (draft.observaciones != null) POSState.setObservaciones(draft.observaciones);
            if (draft.fechaVenta) setFechaVentaPOS(draft.fechaVenta);

            return true;
        }

        function clear() {
            localStorage.removeItem(key);
            localStorage.removeItem(legacyKey);
        }

        return {
            save: save,
            restore: restore,
            clear: clear,
            getLineasActivas: getLineasActivas,
            getLineasCargadas: getLineasCargadas
        };
    })();

    const ventaRestauradaPOS = esEdicionVenta ? false : window.POSDraft.restore();

    (function () {
        const dias = ['Dom', 'Lun', 'Mar', 'Mi�', 'Jue', 'Vie', 'S�b'];
        const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

        function actualizarFechaHora() {
            if (esEdicionVenta) return;
            if (!(carrito.length === 0 || carrito.length === 1)) return;

            const ahora = new Date();
            const fechaSql = ahora.toISOString().slice(0, 19);
            setFechaVentaPOS(fechaSql);

            const diaSemana = dias[ahora.getDay()];
            const dia = ahora.getDate();
            const mes = meses[ahora.getMonth()];
            const anio = ahora.getFullYear();

            const hora = String(ahora.getHours()).padStart(2, '0');
            const minutos = String(ahora.getMinutes()).padStart(2, '0');

            const formato = `${diaSemana} ${dia} de ${mes}, ${anio}. ${hora}:${minutos}`;

            const span = document.getElementById('fechaHoraPOS');
            if (span) span.innerText = formato;
        }

        actualizarFechaHora();
        setInterval(actualizarFechaHora, 60000);
    })();

    if (window.POSGuard) {
        window.POSGuard.bindModal('#modalBuscarPersona', 'persona');
        window.POSGuard.bindModal('#modalFinanzasPOS', 'finanzas');
        window.POSGuard.bindModal('#modalPagoPOS', 'pagoPos');
        window.POSGuard.bindModal('#modalExpendiosPOS', 'expendios');
    }

    // BUSCAR PERSONA
    $(document).on('click', '#btnBuscarPersona', function () {
        const $btn = $(this);
        const $contenedor = $('#contenedorModalPersona');

        if ($contenedor.find('#modalBuscarPersona').length) {
            const abierto = window.POSGuard
                ? window.POSGuard.requestModalOpen('persona', function () {
                    $('#modalBuscarPersona').modal('show');
                    cargarPersonas();
                })
                : true;

            if (!abierto) return;
            return;
        }

        if (window.POSGuard && !window.POSGuard.startModalLoad('persona')) return;

        $btn.prop('disabled', true);

        $.get(window.api.persona.buscar)
            .done(function (html) {
                $contenedor.html(html);
                window.POSGuard?.endModalLoad('persona');

                const abierto = window.POSGuard
                    ? window.POSGuard.requestModalOpen('persona', function () {
                        $('#modalBuscarPersona').modal('show');
                        cargarPersonas();
                    })
                    : true;

                if (!abierto) {
                    $('#modalBuscarPersona').modal('show');
                    cargarPersonas();
                }
            })
            .fail(function () {
                window.POSGuard?.endModalLoad('persona');
                Swal.fire({
                    icon: 'error',
                    title: 'Cliente',
                    text: 'No se pudo cargar el buscador de clientes'
                });
            })
            .always(function () {
                $btn.prop('disabled', false);
            });
    });

    $('#btnConsumidorFinal').on('click', function () {
        $('#idPersona').val(@idConsumidorFinal);
        $('#razonSocial').val('Consumidor Final');
    });

    document.addEventListener("keydown", function (e) {
        if ($(".modal.show").length) return;

        if (e.key === "End") {
            e.preventDefault();
            const btn = document.getElementById("btnFinalizar");
            if (btn && !btn.disabled) btn.click();
        }

        if (e.key === "Home") {
            e.preventDefault();
            const inp = document.getElementById("inputCodigo");
            if (inp) {
                inp.focus();
                try { inp.select(); } catch { }
            }
        }

        if (e.key === "F9" || e.key === "F10") e.preventDefault();
        else return;

        if (e.key === "F9") {
            const btn = document.getElementById("btnBuscarPersona");
            if (btn && !btn.disabled) btn.click();
            return;
        }

        if (e.key === "F10") {
            const btn = document.getElementById("btnAgregarManual");
            if (btn && !btn.disabled) abrirBuscadorProductosPOS();
            return;
        }
    });


    function mostrarErrorConexion(msg) {
        Swal.fire({
            icon: 'error',
            title: 'Sin conexi�n',
            text: msg,
            allowOutsideClick: false
        });
    }

    function scrollPantallaMobile() {
        if (!window.matchMedia('(max-width: 576px)').matches) return;

        const anchor = scanning
