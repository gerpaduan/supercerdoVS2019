            icon: "warning",
            title: "No puede salir con una venta en curso",
            text: 'Debe presionar "Cancelar Venta".'
        });
    }

    function bloquearSalidaSiVentaEnCurso(e) {
        if (!hayVentaActivaPOS()) return false;

        if (e) {
            e.preventDefault();
            if (typeof e.stopImmediatePropagation === "function") {
                e.stopImmediatePropagation();
            } else if (typeof e.stopPropagation === "function") {
                e.stopPropagation();
            }
        }

        window.POSDraft?.save?.();
        mostrarBloqueoSalidaPOS();
        return true;
    }

    function hayModalAbiertoEnPOS() {
        return $(".modal.show:visible").length > 0;
    }

    document.addEventListener("keydown", function (e) {
        const key = (e.key || "").toLowerCase();
        const intentaRecargar = e.key === "F5" || ((e.ctrlKey || e.metaKey) && key === "r");

        if (e.key === "F5" && hayModalAbiertoEnPOS()) {
            e.preventDefault();
            if (typeof e.stopImmediatePropagation === "function") {
                e.stopImmediatePropagation();
            } else if (typeof e.stopPropagation === "function") {
                e.stopPropagation();
            }
            return;
        }

        if (intentaRecargar) {
            bloquearSalidaSiVentaEnCurso(e);
        }
    }, true);

    $(document).on("click.posSalidaVenta", "a[href]", function (e) {
        const href = ($(this).attr("href") || "").trim();

        if (!href || href === "#" || href.indexOf("javascript:") === 0) return;
        if ($(this).data("pos-ajax") === true || $(this).attr("data-pos-ajax") === "true") return;
        if ($(this).attr("data-pos-descarga") === "true") return;
        if ($(this).attr("data-toggle") === "modal" || $(this).attr("data-dismiss") === "modal") return;

        bloquearSalidaSiVentaEnCurso(e);
    });

    function guardarVentaAnuladaDirectamente(omitirPostVenta) {
        if (cancelandoVentaPOS) return;

        const lineas = window.POSState?.getLineas?.() || [];
        const lineasActivas = lineas.filter(function (linea) {
            return linea && !linea.anulado;
        });

        if (!lineas.length) {
            Swal.fire({
                icon: "info",
                title: "Venta vacía",
                text: "No hay una venta en curso para cancelar."
            });
            return;
        }

        cancelandoVentaPOS = true;
        window.POSCancelacionEnCurso = true;
        indicesCancelacionPOS = lineasActivas.map(function (linea) {
            return linea.index;
        });
        $("#btnCancelarItem").prop("disabled", true);

        lineasActivas.forEach(function (linea) {
            window.POSState.anularLinea(linea.index);
        });

        posCart.renderTable(window.POSState.getLineas());
        posCart.recalculateTotal();
        posCart.updateSaleState();

        finalizarVenta({
            formaPago: "Efectivo",
            esPagoMixto: false,
            efectivo: 0,
            idPersona: $("#idPersona").val(),
            omitirPostVenta: omitirPostVenta === true
        });
    }

    $("#btnCancelarItem").off("click.posCancelarVenta").on("click.posCancelarVenta", function () {
        if (soloFormaPago) {
            volverDesdeSoloFormaPago();
            return;
