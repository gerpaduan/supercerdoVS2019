@section Scripts {
    <script>

        document.addEventListener("click", habilitarAudio, { once: true });

        function habilitarAudio() {
            const audio = document.getElementById("beep");
            audio.volume = 0;
            audio.play().finally(() => {
                audio.pause();
                audio.currentTime = 0;
                audio.volume = 1;
            });
        }

        // VARIABLES
        let stream = null;
        let track = null;
        let detector = null;
        let scanning = false;
        let esEAN = false;
        let ultimoCodigo = null;
        let ultimoTiempo = 0;
        const TIEMPO_RELECTURA = 2000;
        const video = document.getElementById("videoScanner");

        // ANTI FREEZE
        let ultimoFrame = Date.now();
        function checkCongelamiento() {
            if (!scanning) return;

            const ahora = Date.now();
            if (ahora - ultimoFrame > 2000) {
                console.warn("⚠ Cámara parece congelada. Reiniciando...");
                cerrarScanner();
                setTimeout(iniciarScanner, 500);
                return;
            }

            requestAnimationFrame(checkCongelamiento);
        }

        // BOTONES
        $("#btnScanner").on("click", async function () {
            $("#scannerContainer").slideDown();
            await iniciarScanner();
        });

        $("#btnCerrarScanner").on("click", function () {
            cerrarScanner();
        });

        // INICIAR SCANNER
        async function iniciarScanner() {
            if (scanning) return;
            scanning = true;

            if (!("BarcodeDetector" in window)) {
                alert("Este navegador no soporta BarcodeDetector");
                scanning = false;
                return;
            }

            detector = new BarcodeDetector({
                formats: ["ean_13", "ean_8", "code_128", "upc_a"]
            });

            stream = await navigator.mediaDevices.getUserMedia({
                video: {
                    facingMode: { ideal: "environment" },
                    width: { ideal: 640 },
                    height: { ideal: 480 },
                    advanced: [{ focusMode: "continuous" }] // 🟢 mejora autofoco
                }
            });

            track = stream.getVideoTracks()[0];
            video.srcObject = stream;
            await video.play();

            ultimoFrame = Date.now();
            leerContinuamente();
            requestAnimationFrame(checkCongelamiento);

            scrollPantallaMobile();
        }

        // LOOP LIMITADO (NO 60fps)
        async function leerContinuamente() {
            if (!scanning) return;

            try {
                const codigos = await detector.detect(video);
                ultimoFrame = Date.now();

                if (codigos.length > 0) {
                    const codigo = codigos[0].rawValue;

                    if (!esEANValido(codigo)) {
                        return setTimeout(leerContinuamente, 200);
                    }

                    const ahora = Date.now();
                    const mismo = codigo === ultimoCodigo;
                    const tiempoOK = (ahora - ultimoTiempo) > TIEMPO_RELECTURA;

                    if (!mismo || tiempoOK) {
                        ultimoCodigo = codigo;
                        ultimoTiempo = ahora;
                        cargarCodigo(codigo);
                    }
                }

            } catch (e) {
                console.error("Error en detector:", e);
            }

            setTimeout(leerContinuamente, 200); // 🔹 ritmo estable
        }

        // CERRAR SCANNER
        function cerrarScanner() {
            scanning = false;

            if (stream) {
                stream.getTracks().forEach(t => t.stop());
            }

            video.srcObject = null;
            stream = null;
            track = null;
            detector = null; // 🟢 importante

            $("#scannerContainer").slideUp();

            scrollPantallaMobile();
        }

        // CARGAR CÓDIGO DETECTADO
        function cargarCodigo(codigo) {
            const input = $("#inputCodigo");
            input.val(codigo).focus();
            manejarEnter();
        }

        // FLASH
        $("#btnFlash").on("click", async function () {
            if (!track) return alert("Flash no disponible");

            const cap = track.getCapabilities();
            if (!cap.torch) return alert("Este dispositivo no soporta flash");

            const settings = track.getSettings();
            await track.applyConstraints({
                advanced: [{ torch: !settings.torch }]
            });
        });

        // BEEP
        function beep() {
            const audio = document.getElementById("beep");
            if (!audio) return;
            audio.currentTime = 0;
            audio.play();
        }


        //FIN LECTOR CODIGO

        window.api = window.api || {};
        window.api.producto = window.api.producto || {};
        window.api.producto.listar = '@Url.Action("ListarParaPOS", "Productos")';

