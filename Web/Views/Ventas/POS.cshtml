        function terminarEscritura(codigo, callback = null) {

            // 🔹 Sin código → estado inicial
            if (!codigo || String(codigo).trim() === '') {
                mostrarEsperando();
                return;
            }

            $.ajax({
                url: window.buscarProductoUrl, // 👈 mejor práctica (desde Razor)
                type: "GET",
                dataType: "json",
                data: {
                    codigo: String(codigo).trim(),
                    ingresoCantidadX: ingresoCantidadX
                },
                timeout: 3000, // ⏱ máximo de espera

                success: function (data) {

                    if (data.success === false) {
                        mostrarSinCoincidencia(data.message);
                        return;
                    }

                    // 🟢 Producto encontrado
                    productoSeleccionado = data;
                    mostrarProducto(data);

                    if (typeof callback === "function") {
                        callback();
                    }
                },

                error: function (xhr, status) {

                    // ⏱ Timeout
                    if (status === "timeout") {
                        mostrarErrorConexion("La conexión es lenta. Reintente.");
                        return;
                    }

                    // 🌐 Sin internet
                    if (!navigator.onLine) {
                        mostrarErrorConexion("Sin conexión a Internet");
                        return;
                    }

                    // 🔴 Error servidor / red
                    mostrarErrorConexion("No se pudo contactar al servidor");
                }
            });
        }


