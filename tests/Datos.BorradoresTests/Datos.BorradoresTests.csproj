<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Datos usa System.Data.SqlClient (obsoleto en net10.0, deuda conocida, ver Datos.csproj):
         no ensuciar la salida de los tests con esas advertencias. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Datos\Datos.csproj" />
    <ProjectReference Include="..\..\DatosPostgres\DatosPostgres.csproj" />
    <ProjectReference Include="..\..\Contratos\Contratos.csproj" />
    <ProjectReference Include="..\..\Entidades\Entidades.csproj" />
    <ProjectReference Include="..\..\Utilidades.Core\Utilidades.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config de Utilidades.Core.Conexion (lee ConfigurationManager en un static): el testhost la carga
         como testhost.dll.config. Apunta a una base SCRATCH local (no a SuperCerdo). -->
    <None Update="App.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
