<?xml version="1.0" encoding="utf-8"?>
<!--
  Config SOLO para las pruebas de Datos.BorradoresTests. Utilidades.Core.Conexion lee estas claves en
  campos static, asi que tienen que existir aunque la prueba no las use todas.
  La cadena "ConexionPrincipal" apunta a una base SCRATCH del SQL Server Express local (autenticacion
  de Windows: sin credenciales en el repo). Crearla con tests/Datos.BorradoresTests/README.md.
  La pata Postgres NO usa este archivo: lee la variable de entorno CARNISYS_TEST_PG.
-->
<configuration>
  <appSettings>
    <add key="connString" value="ConexionPrincipal" />
    <add key="idSucursal" value="1" />
    <add key="cuit" value="0" />
    <add key="timeOut" value="30" />
  </appSettings>
  <connectionStrings>
    <add name="ConexionPrincipal"
         connectionString="Server=.\SQLEXPRESS;Database=CarniSys_BorradoresTest;Integrated Security=SSPI;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
