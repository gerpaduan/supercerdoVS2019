<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla de WebCore/App.config (gitignorado, ver docs/DECISIONS.md). Para un checkout
     nuevo: copiar este archivo a App.config en la misma carpeta y completar los valores reales
     de este ambiente (connectionString local, SmtpUser/SmtpPass reales si se va a probar envio
     de email). Nunca commitear App.config con valores reales. -->
<configuration>
  <appSettings>
    <add key="connString" value="ConexionPrincipal" />
    <add key="idSucursal" value="1" />
    <add key="cuit" value="20306210786" />
    <add key="timeOut" value="30" />
    <!-- Postmark (mail multi-tenant, 2026-09-15, ver docs/DECISIONS.md): reemplaza el relay Gmail
         de antes -- proveedor transaccional con dominio propio autenticado (SPF/DKIM). SmtpUser y
         SmtpPass van con el MISMO valor: el "Server API Token" de Postmark (no son un usuario y una
         contraseña distintos). SmtpFromEmail debe ser una direccion del dominio verificado en
         Postmark (Sender Signature / Domain), no cualquier casilla. Si en este ambiente todavia se
         usa Gmail sin migrar, dejar SmtpHost=smtp.gmail.com / SmtpPort=587 como antes. -->
    <add key="SmtpHost" value="smtp.postmarkapp.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpUser" value="server-api-token-de-postmark" />
    <add key="SmtpPass" value="server-api-token-de-postmark" />
    <add key="SmtpFromEmail" value="notificaciones@mail.carnisys.com" />
    <!-- Fallback para mails que no pasan fromNameOverride (ej. reset de contraseña) -- se mantiene
         "CarniSys" a proposito, ese mail lo firma la plataforma, no una empresa puntual. Los mails
         de comprobantes SI llevan nombre por empresa via SmtpMailHelper.BuildTenantFromName. -->
    <add key="SmtpFromName" value="CarniSys" />
    <!-- Postgres es la base oficial y unica de la plataforma (2026-09-05, ver docs/DECISIONS.md).
         SQL Server queda solo como legado -- el switch (WebCore/Infrastructure/NegocioFactory.cs)
         se mantiene por compatibilidad, pero el default real es "Postgres". -->
    <add key="DataEngine" value="Postgres" />
    <!-- Sidebar de _Layout.cshtml: modulos todavia no migrados a WebCore linkean con URL
         absoluta al Web clasico. Sin barra final. -->
    <add key="WebClasicoBaseUrl" value="https://localhost:44371" />
  </appSettings>
  <connectionStrings>
    <add name="ConexionPrincipal"
         connectionString="Data Source=.\sqlexpress;Initial Catalog=carnisys;User ID=sa;Password=sistema;"
         providerName="System.Data.SqlClient" />
    <add name="ConexionPostgresPiloto"
         connectionString="Host=localhost;Port=5432;Database=carnisys;Username=usuario-postgres;Password=clave-postgres;Maximum Pool Size=30;Keepalive=30;Tcp Keepalive=true;"
         providerName="Npgsql" />
  </connectionStrings>
</configuration>
