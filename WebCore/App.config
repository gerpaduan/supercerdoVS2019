<?xml version="1.0" encoding="utf-8"?>
<!-- Config minima del spike de migracion (ver docs/DECISIONS.md) para que Utilidades.Core.Conexion
     (via ConfigurationManager) resuelva la misma base local de dev que usa Web/Config/connectionStrings.config.
     TODO(claude): reemplazar por IConfiguration idiomatico de ASP.NET Core cuando se diseñe
     la extraccion real de Utilidades (no en este spike). -->
<configuration>
  <appSettings>
    <add key="connString" value="ConexionPrincipal" />
    <add key="idSucursal" value="1" />
    <add key="cuit" value="20306210786" />
    <add key="timeOut" value="30" />
  </appSettings>
  <connectionStrings>
    <add name="ConexionPrincipal"
         connectionString="Data Source=.\sqlexpress;Initial Catalog=carnisys;User ID=sa;Password=sistema;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
