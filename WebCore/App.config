<?xml version="1.0" encoding="utf-8"?>
<!-- Config minima del spike de migracion (ver docs/DECISIONS.md) para que Utilidades.Core.Conexion
     (via ConfigurationManager) resuelva la misma base local de dev que usa Web/Config/connectionStrings.config.
     TODO(claude): reemplazar por IConfiguration idiomatico de ASP.NET Core cuando se diseñe
     la extraccion real de Utilidades (no en este spike). -->
<configuration>
  <appSettings>
    <add key="connString" value="ConexionPrincipal" />
    <add key="idSucursal" value="1" />
    <add key="cuit" value="20306210786" />
    <add key="timeOut" value="30" />
    <!-- SMTP para envio real de email (Utilidades.Core/SmtpMailHelper.cs), ver
         docs/10-migracion-aspnet-core/README.md. Mismos placeholders que
         Web/Config/appSettings.secrets.config (dev local, sin credenciales reales todavia),
         reemplazar por valores reales ahi y aca cuando se pruebe el envio en vivo. -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpUser" value="usuario@dominio.com" />
    <add key="SmtpPass" value="clave-o-app-password" />
    <add key="SmtpFromEmail" value="usuario@dominio.com" />
    <add key="SmtpFromName" value="CarniSys" />
  </appSettings>
  <connectionStrings>
    <add name="ConexionPrincipal"
         connectionString="Data Source=.\sqlexpress;Initial Catalog=carnisys;User ID=sa;Password=sistema;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
