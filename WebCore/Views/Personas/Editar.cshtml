@model WebCore.Models.PersonaEditVm
@using System.Linq

@{
    ViewData["Title"] = Model.EsEdicion ? "Editar persona" : "Nueva persona";

    bool protegerCampos = Model.EsEdicion && !Model.PuedeEditarCamposProtegidos;
    bool soloLecturaInicial = Model.EsEdicion;
    string textoTitulo = Model.EsEdicion ? "Editar persona" : "Nueva persona";
    string infoMessage = TempData["PersonasInfoMessage"] as string ?? "";
    var mensajesValidacion = ViewData.ModelState.Values
        .SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();
}

<div class="container-fluid persona-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 persona-page-header">
        <div>
            <h1 class="h3 mb-1 text-gray-800">@textoTitulo</h1>
        </div>
        <a class="btn btn-outline-secondary mt-2 mt-md-0" href="@Url.Action("Index", "Personas")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (mensajesValidacion.Any())
            {
                <div class="alert alert-danger">
                    <ul class="mb-0 pl-3">
                        @foreach (var mensaje in mensajesValidacion)
                        {
                            <li>@mensaje</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(infoMessage))
            {
                <div class="alert alert-info">
                    @infoMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MensajeRestriccion))
            {
                <div class="alert @(Model.EsAdministrador ? "alert-info" : "alert-warning")">
                    @Model.MensajeRestriccion
                </div>
            }

            <form asp-controller="Personas" asp-action="Guardar" method="post" novalidate="novalidate" id="formPersona">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdPersona)
                @Html.HiddenFor(m => m.BonificacionTexto)

                <div class="row">
                    <div class="col-12 col-md-2">
                        <div class="form-group">
                            <label>ID</label>
                            <input type="text" class="form-control" value="@(Model.IdPersona > 0 ? Model.IdPersona.ToString() : "Nuevo")" readonly />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group">
                            <label for="Cuit">CUIT</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Cuit, protegerCampos
                                    ? (object)new { @class = "form-control js-persona-control js-campo-protegido", autocomplete = "off", @readonly = "readonly", maxlength = "20", placeholder = "00-00000000-0" }
                                    : new { @class = "form-control js-persona-control", autocomplete = "off", maxlength = "20", placeholder = "00-00000000-0" })
                                <div class="input-group-append">
                                    <button type="button"
                                            class="btn btn-outline-primary js-persona-control"
                                            id="btnBuscarAfipPersona"
                                            formnovalidate="formnovalidate"
                                            title="Buscar en AFIP">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.Cuit, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-group">
                            <label for="Identificacion">Identificacion</label>
                            @Html.TextBoxFor(m => m.Identificacion, protegerCampos
                                ? (object)new { @class = "form-control js-persona-control js-campo-protegido", autocomplete = "off", @readonly = "readonly", maxlength = "150" }
                                : new { @class = "form-control text-uppercase js-persona-control", autocomplete = "off", maxlength = "150" })
                            @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-group">
                            <label for="RazonSocial">Razon social / nombre</label>
                            @Html.TextBoxFor(m => m.RazonSocial, protegerCampos
                                ? (object)new { @class = "form-control js-persona-control js-campo-protegido", autocomplete = "off", @readonly = "readonly", maxlength = "200" }
                                : new { @class = "form-control text-uppercase js-persona-control", autocomplete = "off", maxlength = "200" })
                            @Html.ValidationMessageFor(m => m.RazonSocial, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4">
                        <div class="form-group">
                            <label for="IdIva">Condicion frente al IVA</label>
                            @Html.DropDownListFor(m => m.IdIva, Model.Ivas, "Seleccionar IVA", protegerCampos
                                ? (object)new { @class = "form-control js-persona-control js-campo-protegido", id = "IdIva", disabled = "disabled" }
                                : new { @class = "form-control js-persona-control", id = "IdIva" })
                            @Html.ValidationMessageFor(m => m.IdIva, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group">
                            <label for="Telefono">Telefono</label>
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control js-persona-control", autocomplete = "off", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group">
                            <label for="Email">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control js-persona-control", autocomplete = "off", maxlength = "200", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-5">
                        <div class="form-group">
                            <label for="Domicilio">Domicilio</label>
                            @Html.TextBoxFor(m => m.Domicilio, new { @class = "form-control text-uppercase js-persona-control", autocomplete = "off", maxlength = "200" })
                            @Html.ValidationMessageFor(m => m.Domicilio, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group">
                            <label for="Ciudad">Ciudad</label>
                            @Html.TextBoxFor(m => m.Ciudad, new { @class = "form-control text-uppercase js-persona-control", autocomplete = "off", maxlength = "150" })
                            @Html.ValidationMessageFor(m => m.Ciudad, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    @if (Model.PuedeGestionarCuentaCorriente)
                    {
                        <div class="col-12 col-md-3">
                            <div class="form-group pt-md-4 mt-md-2">
                                <div class="custom-control custom-switch">
                                    @Html.CheckBoxFor(m => m.CtaCte, new { @class = "custom-control-input js-persona-control", id = "CtaCte" })
                                    <label class="custom-control-label" for="CtaCte">Cuenta corriente</label>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-12 col-md-9">
                        <div class="form-group">
                            <label for="OtrosDatos">Otros datos</label>
                            @Html.TextAreaFor(m => m.OtrosDatos, new { @class = "form-control js-persona-control", rows = "4", maxlength = "4000" })
                            @Html.ValidationMessageFor(m => m.OtrosDatos, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (Model.EsEdicion)
                    {
                        <button type="button"
                                class="btn btn-primary mr-2 mb-2"
                                id="btnHabilitarEdicionPersona">
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>
                    }

                    <button type="submit" class="btn btn-success mr-2 mb-2 @(Model.EsEdicion ? "d-none" : "")" id="btnGuardarPersona">
                        <i class="fas fa-save mr-1"></i> Guardar persona
                    </button>

                    <a class="btn btn-outline-secondary mb-2" href="@Url.Action("Index", "Personas")">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .persona-page {
        font-size: .9rem;
    }

    .persona-page .card {
        border-radius: .75rem;
    }

    .persona-page .card-body {
        padding: .9rem 1rem;
    }

    .persona-page .form-group label,
    .persona-page .custom-control-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .22rem;
    }

    .persona-page .small,
    .persona-page .text-danger.small {
        font-size: .78rem;
    }

    .persona-page .form-control,
    .persona-page .btn:not(.btn-sm),
    .persona-page .input-group-text {
        font-size: .86rem;
        min-height: 2.45rem;
        border-radius: .55rem;
        padding: .3rem .62rem;
    }

    .persona-page textarea.form-control {
        min-height: 5rem;
        resize: vertical;
    }

    .persona-page .form-group {
        margin-bottom: .65rem;
    }

    .persona-page .alert {
        padding: .7rem .85rem;
        margin-bottom: .75rem;
        border-radius: .65rem;
    }

    .persona-page .alert ul {
        margin-bottom: 0;
    }

    .persona-page .input-group-append .btn {
        min-width: 2.7rem;
        padding-left: .45rem;
        padding-right: .45rem;
    }

    .persona-page .custom-switch {
        padding-top: 1.65rem;
    }

    .persona-page .custom-switch .custom-control-label {
        font-size: .82rem;
    }

    .persona-page .mt-3.d-flex {
        margin-top: .85rem !important;
        padding-top: .85rem;
        border-top: 1px solid rgba(0, 0, 0, .08);
    }

    @@media (min-width: 992px) {
        .persona-page .card-body {
            padding: .8rem .95rem;
        }

        .persona-page .form-control,
        .persona-page .btn:not(.btn-sm),
        .persona-page .input-group-text {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
        }

        .persona-page .form-group {
            margin-bottom: .5rem;
        }
    }

    @@media (max-width: 767.98px) {
        .persona-page .card-body {
            padding: .8rem;
        }

        .persona-page .custom-switch {
            padding-top: .15rem;
        }

        .persona-page .mt-3.d-flex .btn {
            width: 100%;
            margin-right: 0 !important;
        }
    }

    html.dark-mode .persona-page .card,
    html.dark-mode .persona-page .card-body {
        background: #132032;
        border-color: #2a3b52;
    }

    html.dark-mode .persona-page h1,
    html.dark-mode .persona-page .form-group label,
    html.dark-mode .persona-page .custom-control-label {
        color: #e5edf7 !important;
    }

    html.dark-mode .persona-page .alert-info {
        background: #162538;
        border-color: #2f4d69;
        color: #dbe7f5;
    }

    html.dark-mode .persona-page .alert-warning {
        background: #3a2b12;
        border-color: #70511f;
        color: #f7dfaa;
    }

    html.dark-mode .persona-page .alert-danger {
        background: #3a1f24;
        border-color: #70414a;
        color: #ffd9de;
    }

    html.dark-mode .persona-page .text-gray-800 {
        color: #ecf2ff !important;
    }

    html.dark-mode .persona-page .mt-3.d-flex {
        border-top-color: #2a3b52;
    }
</style>

<script>
    (function () {
        function showNavigationLoading(message) {
            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
            }
        }

        function inicializarPersona() {
            var soloLecturaInicial = @(soloLecturaInicial ? "true" : "false");
            var puedeEditarCamposProtegidos = @(Model.PuedeEditarCamposProtegidos ? "true" : "false");
            var $form = $("#formPersona");
            var $save = $("#btnGuardarPersona");
            var $modify = $("#btnHabilitarEdicionPersona");
            var $afip = $("#btnBuscarAfipPersona");
            var urlBuscarAfip = '@Url.Action("BuscarPadronAfipAjax", "Personas")';
            var bloquearSiguienteSubmitAfip = false;

            function esTexto($el) {
                return $el.is("input[type='text'], input[type='email'], input[type='tel'], input:not([type]), textarea");
            }

            function setSoloLectura(activo) {
                $form.find(".js-persona-control").each(function () {
                    var $el = $(this);
                    var esProtegido = $el.hasClass("js-campo-protegido") && !puedeEditarCamposProtegidos;

                    if (activo || esProtegido) {
                        if (esTexto($el)) {
                            $el.prop("readonly", true);
                        } else {
                            $el.prop("disabled", true);
                        }
                    } else {
                        if (esTexto($el)) {
                            $el.prop("readonly", false);
                        } else {
                            $el.prop("disabled", false);
                        }
                    }
                });

                $save.toggleClass("d-none", activo);
                $save.prop("disabled", activo);

                if ($modify.length) {
                    $modify.toggleClass("d-none", !activo);
                }

                if (!activo) {
                    $("#Cuit").trigger("focus").trigger("select");
                }
            }

            function limpiarCuit(valor) {
                return (valor || "").replace(/\D/g, "");
            }

            function ivaSeleccionadoValido() {
                var $iva = $("#IdIva");
                if (!$iva.length || $iva.prop("disabled")) {
                    return true;
                }

                var valor = $.trim($iva.val() || "");
                return valor !== "" && Number(valor) > 0;
            }

            function mostrarMensaje(tipo, titulo, texto) {
                if (window.Swal && typeof window.Swal.fire === "function") {
                    Swal.fire({ icon: tipo, title: titulo, text: texto });
                } else {
                    alert(titulo + "\n\n" + texto);
                }
            }

            function completarDesdeAfip(resp) {
                if (resp.identificacion) {
                    $("#Identificacion").val(resp.identificacion);
                }

                if (resp.razonSocial) {
                    $("#RazonSocial").val(resp.razonSocial);
                }

                if (resp.domicilio) {
                    $("#Domicilio").val(resp.domicilio);
                }

                if (resp.ciudad) {
                    $("#Ciudad").val(resp.ciudad);
                }

                if (resp.idIva && Number(resp.idIva) > 0) {
                    $("#IdIva").val(String(resp.idIva));
                }
            }

            function consultarAfip() {
                var cuit = limpiarCuit($("#Cuit").val());
                if (cuit.length !== 11) {
                    mostrarMensaje("warning", "AFIP/ARCA", "Ingrese un CUIT valido de 11 digitos.");
                    return;
                }

                $("#Cuit").val(cuit);
                $afip.prop("disabled", true);

                $.getJSON(urlBuscarAfip, { cuit: cuit })
                    .done(function (resp) {
                        if (!resp || !resp.ok) {
                            mostrarMensaje((resp && resp.tipo) || "error", "AFIP/ARCA", (resp && resp.msg) || "No se pudo consultar AFIP/ARCA.");
                            return;
                        }

                        completarDesdeAfip(resp);
                        mostrarMensaje("success", "AFIP/ARCA", resp.msg || "Datos recuperados correctamente.");
                    })
                    .fail(function (xhr) {
                        var msg = "No se pudo conectar con AFIP/ARCA.";

                        if (xhr && xhr.responseJSON && xhr.responseJSON.msg) {
                            msg = xhr.responseJSON.msg;
                        } else if (xhr && xhr.responseText) {
                            msg = "La consulta AFIP/ARCA fallo y el servidor no devolvio un mensaje claro.";
                        }

                        mostrarMensaje("error", "AFIP/ARCA", msg);
                    })
                    .always(function () {
                        $afip.prop("disabled", false);
                    });
            }

            function ejecutarBusquedaAfip() {
                bloquearSiguienteSubmitAfip = true;
                consultarAfip();

                window.setTimeout(function () {
                    bloquearSiguienteSubmitAfip = false;
                }, 0);
            }

            if ($modify.length) {
                $modify.on("click", function () {
                    setSoloLectura(false);
                });
            }

            if ($afip.length) {
                $afip.on("click", function (evt) {
                    if ($(this).prop("disabled")) return;
                    evt.preventDefault();
                    evt.stopPropagation();
                    ejecutarBusquedaAfip();
                    return false;
                });
            }

            $("#Cuit").on("keydown", function (evt) {
                if (evt.key !== "Enter") return;

                evt.preventDefault();
                evt.stopPropagation();

                if ($(this).prop("readonly")) return false;

                ejecutarBusquedaAfip();
                return false;
            });

            $form.on("submit", function (evt) {
                var activo = document.activeElement;
                var idActivo = activo ? activo.id : "";
                var submitter = evt.originalEvent && evt.originalEvent.submitter
                    ? evt.originalEvent.submitter.id
                    : "";

                if (bloquearSiguienteSubmitAfip || idActivo === "Cuit" || idActivo === "btnBuscarAfipPersona" || submitter === "btnBuscarAfipPersona") {
                    evt.preventDefault();
                    return false;
                }

                if (!ivaSeleccionadoValido()) {
                    evt.preventDefault();
                    mostrarMensaje("warning", "Falta información", "Seleccione una condición frente al IVA antes de guardar.");
                    $("#IdIva").trigger("focus");
                    return false;
                }

                showNavigationLoading("Cargando solicitud...");
            });

            setSoloLectura(soloLecturaInicial);

            if (!soloLecturaInicial) {
                $("#Cuit").trigger("focus").trigger("select");
            }

            if (window.EditPageGuard && typeof window.EditPageGuard.init === "function") {
                window.EditPageGuard.init({
                    formSelector: "#formPersona",
                    modifyButtonSelector: "#btnHabilitarEdicionPersona",
                    saveButtonSelector: "#btnGuardarPersona"
                });
            }

            document.addEventListener("click", function (event) {
                var link = event.target.closest ? event.target.closest(".persona-page a[href]") : null;
                if (!link) return;
                if (link.target === "_blank" || link.hasAttribute("download")) return;

                var href = link.getAttribute("href") || "";
                if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

                event.preventDefault();
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    window.location.href = link.href;
                }, 0);
            });
        }

        function esperarJQuery() {
            if (!window.jQuery) {
                window.setTimeout(esperarJQuery, 50);
                return;
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", inicializarPersona, { once: true });
                return;
            }

            inicializarPersona();
        }

        esperarJQuery();
    })();
</script>
