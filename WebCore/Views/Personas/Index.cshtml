@model WebCore.Models.PersonaIndexVm

@{
    ViewData["Title"] = "Personas";
    // Despues de ver la cuenta corriente, "volver" regresa a este listado con el mismo filtro.
    string urlActualPersonas = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}

<div class="container-fluid personas-index-page">
    <style>
        /* Diseno compacto (mismo patron que el resto de los listados de WebCore): todo scopeado a esta pagina. */
        .personas-index-page {
            font-size: .9rem;
        }

        .personas-index-page .personas-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            margin: 0 -.25rem .6rem;
        }

        .personas-index-page .personas-toolbar > * {
            margin: .15rem .25rem;
        }

        .personas-index-page .personas-toolbar .personas-toolbar-buscar {
            flex: 1 1 18rem;
            min-width: 12rem;
        }

        .personas-index-page .personas-toolbar .personas-toolbar-iva {
            flex: 0 0 11rem;
        }

        .personas-index-page .personas-toolbar .form-control,
        .personas-index-page .personas-toolbar .btn {
            font-size: .84rem;
            min-height: 2.15rem;
            border-radius: .55rem;
            padding: .28rem .6rem;
        }

        .personas-index-page .card-body {
            padding: 0;
        }

        .personas-index-page .table {
            font-size: .81rem;
        }

        .personas-index-page .table th,
        .personas-index-page .table td {
            padding: .3rem .5rem;
            vertical-align: middle;
            line-height: 1.15;
        }

        .personas-index-page .table thead th {
            font-size: .69rem !important;
            font-weight: 700;
            letter-spacing: .02em;
            text-transform: uppercase;
        }

        .personas-index-page .table .btn-sm {
            font-size: .76rem;
            padding: .15rem .45rem;
            line-height: 1.2;
        }

        .personas-index-page .persona-id-cell {
            font-size: .74rem;
        }

        .personas-index-page .badge {
            font-size: .68rem;
        }

        .persona-global {
            opacity: 1;
        }

        .persona-global td {
            background-color: var(--ui-surface-alt);
            color: var(--ui-text-soft);
        }

        /* Celular: las personas globales (gris) pintan la tarjeta entera y la barra azul va en la tarjeta, no en la 1.a celda
           (tabla-cards.css deja las celdas transparentes). */
        @@media (max-width: 767.98px) {
            body.app-shell .persona-global {
                background: var(--ui-surface-alt);
                color: var(--ui-text-soft);
                box-shadow: inset 3px 0 0 rgba(115, 168, 255, 0.38);
            }

            body.app-shell .persona-global td,
            body.app-shell .persona-global td:first-child {
                background: transparent;
                box-shadow: none;
            }

            .personas-index-page .personas-toolbar .personas-toolbar-iva {
                flex: 1 1 100%;
            }
        }
    </style>

    @* Una sola fila: busqueda en vivo, condicion de IVA, Limpiar y Nueva persona. Enter tambien envia el formulario (GET). *@
    <form method="get" action="@Url.Action("Index", "Personas")" id="formFiltrosPersonas" class="personas-toolbar">
        <input type="text"
               class="form-control personas-toolbar-buscar"
               id="txtFiltroPersonas"
               name="filtro"
               value="@Model.Filtro"
               autocomplete="off"
               aria-label="Buscar persona"
               placeholder="Buscar por razón social, CUIT o identificación" />
        <select class="form-control personas-toolbar-iva" id="selFiltroIva" name="iva" aria-label="Condición IVA">
            <option value="">Todas las condiciones IVA</option>
            @foreach (var opcion in Model.Ivas)
            {
                <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option>
            }
        </select>
        <a href="@Url.Action("Index", "Personas")" class="btn btn-outline-secondary">Limpiar</a>
        <a class="btn btn-success" href="@Url.Action("Nuevo", "Personas")">
            <i class="fas fa-plus mr-1"></i> Nueva persona
        </a>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            @* En celular (<768px) cada persona se muestra como tarjeta (CSS compartido wwwroot/Content/css/tabla-cards.css): la razon
               social encabeza la tarjeta y los datos vacios no se muestran. Las filas tambien se arman en renderTabla (JS, mas abajo):
               si se cambia el orden de las columnas hay que cambiarlo en los dos lugares. *@
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 tabla-cards">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:64px;">ID</th>
                            <th>Identificación</th>
                            <th>Razón social</th>
                            <th>IVA</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                            <th>Domicilio</th>
                            <th>Ciudad</th>
                            <th>Otros datos</th>
                            <th style="width:@(Model.MostrarCtaCte ? "128px" : "100px");">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyPersonas">
                        @if (Model == null || Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">No se encontraron personas.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="@(item.IdEmpresa == 0 ? "persona-global" : "")">
                                    <td class="persona-id-cell" data-label="ID">@item.IdPersona</td>
                                    <td class="@(!string.IsNullOrWhiteSpace(item.Identificacion) ? "" : "cc-vacio")" data-label="Identificación">@(!string.IsNullOrWhiteSpace(item.Identificacion) ? item.Identificacion : "-")</td>
                                    <td class="font-weight-bold cc-titulo">@(!string.IsNullOrWhiteSpace(item.RazonSocial) ? item.RazonSocial : "-")@if (item.CtaCteReservada) { <span class="badge badge-secondary align-middle ml-1 etiqueta-cuenta-reservada" title="Cuenta corriente reservada"><i class="fas fa-lock mr-1"></i>Reservada</span> }</td>
                                    <td class="@(!string.IsNullOrWhiteSpace(item.Iva) ? "" : "cc-vacio")" data-label="IVA">@(!string.IsNullOrWhiteSpace(item.Iva) ? item.Iva : "-")</td>
                                    <td class="@(!string.IsNullOrWhiteSpace(item.Cuit) ? "" : "cc-vacio")" data-label="CUIT">@(!string.IsNullOrWhiteSpace(item.Cuit) ? item.Cuit : "-")</td>
                                    <td class="@(!string.IsNullOrWhiteSpace(item.Telefono) ? "" : "cc-vacio")" data-label="Teléfono">@(!string.IsNullOrWhiteSpace(item.Telefono) ? item.Telefono : "-")</td>
                                    <td class="cc-ancho @(!string.IsNullOrWhiteSpace(item.Domicilio) ? "" : "cc-vacio")" data-label="Domicilio">@(!string.IsNullOrWhiteSpace(item.Domicilio) ? item.Domicilio : "-")</td>
                                    <td class="@(!string.IsNullOrWhiteSpace(item.Ciudad) ? "" : "cc-vacio")" data-label="Ciudad">@(!string.IsNullOrWhiteSpace(item.Ciudad) ? item.Ciudad : "-")</td>
                                    <td class="cc-ancho @(!string.IsNullOrWhiteSpace(item.OtrosDatos) ? "" : "cc-vacio")" data-label="Otros datos">@(!string.IsNullOrWhiteSpace(item.OtrosDatos) ? item.OtrosDatos : "-")</td>
                                    <td class="text-nowrap cc-acciones">
                                        @if (item.PuedeModificar)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar", "Personas", new { id = item.IdPersona })">
                                                Ver persona
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="disabled" title="Las personas globales no se pueden abrir desde una empresa.">
                                                Ver persona
                                            </button>
                                        }
                                        @if (Model.MostrarCtaCte)
                                        {
                                            <a class="btn btn-sm btn-outline-info ml-1" title="Cuenta corriente" aria-label="Cuenta corriente de @item.RazonSocial"
                                               href="@Url.Action("CtaCtePersona", "Finanzas", new { idPersona = item.IdPersona, returnUrl = urlActualPersonas })">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        function showNavigationLoading(message) {
            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
            }
        }

        function navegarConLoader(url) {
            if (!url) return;
            showNavigationLoading("Cargando solicitud...");
            window.setTimeout(function () {
                window.location.href = url;
            }, 0);
        }

        var successAlert = document.getElementById("personasSuccessAlert");
        if (successAlert) {
            window.setTimeout(function () {
                $(successAlert).alert("close");
            }, 2500);
        }

        var formFiltros = document.getElementById("formFiltrosPersonas");
        if (formFiltros) {
            formFiltros.addEventListener("submit", function () {
                showNavigationLoading("Cargando solicitud...");
            });
        }

        document.addEventListener("click", function (event) {
            var link = event.target.closest ? event.target.closest(".personas-index-page a[href]") : null;
            if (!link) return;
            if (link.target === "_blank" || link.hasAttribute("download")) return;

            var href = link.getAttribute("href") || "";
            if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

            event.preventDefault();
            navegarConLoader(link.href);
        });

        var $input = $("#txtFiltroPersonas");
        var $iva = $("#selFiltroIva");
        var $tbody = $("#tbodyPersonas");
        var debounceHandle = 0;
        var ultimoFiltro = $input.val() || "";
        var baseEditarUrl = "@Url.Action("Editar", "Personas")";
        var baseCtaCteUrl = "@Url.Action("CtaCtePersona", "Finanzas")";
        var mostrarCtaCte = @(Model.MostrarCtaCte ? "true" : "false");

        function escapeHtml(texto) {
            return $("<div>").text(texto == null ? "" : texto).html();
        }

        // etiqueta = rotulo de la tarjeta de celular (data-label); clases = clases extra de la celda (cc-*, ver tabla-cards.css).
        // Una celda sin dato lleva cc-vacio: en la tarjeta no se muestra.
        function valorCelda(texto, destacado, htmlExtra, etiqueta, clases) {
            var limpio = $.trim(texto || "");
            var contenido = (limpio ? escapeHtml(limpio) : "-") + (htmlExtra || "");
            var clase = $.trim((destacado ? "font-weight-bold " : "") + (clases || "") + (limpio ? "" : " cc-vacio"));
            return "<td" + (clase ? ' class="' + clase + '"' : "") +
                (etiqueta ? ' data-label="' + etiqueta + '"' : "") + ">" + contenido + "</td>";
        }

        // Acciones de una fila: "Ver persona" (deshabilitado en las globales) e icono de cuenta corriente si corresponde.
        function celdaAcciones(item) {
            var html = '<td class="text-nowrap cc-acciones">';
            if (item.puedeModificar) {
                html += '<a class="btn btn-sm btn-outline-primary" href="' + baseEditarUrl + '?id=' + encodeURIComponent(item.idPersona) + '">Ver persona</a>';
            } else {
                html += '<button type="button" class="btn btn-sm btn-outline-secondary" disabled="disabled" title="Las personas globales no se pueden abrir desde una empresa.">Ver persona</button>';
            }
            if (mostrarCtaCte) {
                var volver = window.location.pathname + window.location.search;
                html += '<a class="btn btn-sm btn-outline-info ml-1" title="Cuenta corriente" aria-label="Cuenta corriente de ' + escapeHtml(item.razonSocial) + '" href="' +
                    baseCtaCteUrl + '?idPersona=' + encodeURIComponent(item.idPersona) + '&returnUrl=' + encodeURIComponent(volver) +
                    '"><i class="fas fa-file-invoice-dollar"></i></a>';
            }
            return html + "</td>";
        }

        function renderTabla(items) {
            if (!items || !items.length) {
                $tbody.html('<tr><td colspan="10" class="text-center text-muted py-4">No se encontraron personas.</td></tr>');
                return;
            }

            var html = "";
            items.forEach(function (item) {
                var esGlobal = Number(item.idEmpresa || 0) === 0;
                html += '<tr' + (esGlobal ? ' class="persona-global"' : '') + ">";
                html += '<td class="persona-id-cell" data-label="ID">' + escapeHtml(item.idPersona) + "</td>";
                html += valorCelda(item.identificacion, false, "", "Identificación");
                html += valorCelda(item.razonSocial, true, item.ctaCteReservada ? '<span class="badge badge-secondary align-middle ml-1 etiqueta-cuenta-reservada" title="Cuenta corriente reservada"><i class="fas fa-lock mr-1"></i>Reservada</span>' : "", "", "cc-titulo");
                html += valorCelda(item.iva, false, "", "IVA");
                html += valorCelda(item.cuit, false, "", "CUIT");
                html += valorCelda(item.telefono, false, "", "Teléfono");
                html += valorCelda(item.domicilio, false, "", "Domicilio", "cc-ancho");
                html += valorCelda(item.ciudad, false, "", "Ciudad");
                html += valorCelda(item.otrosDatos, false, "", "Otros datos", "cc-ancho");
                html += celdaAcciones(item);
                html += "</tr>";
            });

            $tbody.html(html);
        }

        // Busqueda en vivo: el texto y la condicion de IVA se mandan juntos y se descarta la respuesta si ya cambiaron.
        function cargarPersonasEnVivo() {
            var filtro = $input.val() || "";
            var iva = $iva.val() || "";
            ultimoFiltro = filtro + "|" + iva;

            $.get("@Url.Action("Listar", "Personas")", { filtro: filtro, iva: iva }, function (data) {
                if (ultimoFiltro !== (($input.val() || "") + "|" + ($iva.val() || ""))) return;
                renderTabla(data);
            });
        }

        $input.on("input", function () {
            window.clearTimeout(debounceHandle);
            debounceHandle = window.setTimeout(cargarPersonasEnVivo, 250);
        });

        $iva.on("change", cargarPersonasEnVivo);
    })();
</script>
}
