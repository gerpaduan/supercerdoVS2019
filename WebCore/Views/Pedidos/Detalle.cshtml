@model Entidades.Pedido
@using System.Globalization
@using System.Linq

@*
    Detalle de un pedido guardado: cabecera, una fila por producto con la cantidad de cada sucursal (el "en cruz" de PedidoPivot), el total
    estimado y el historial (alta y modificaciones, con quien autorizo si hizo falta). Acciones: ticket, PDF, mail, Excel y Modificar.
    Los importes son una ESTIMACION con el precio de la ultima compra; las lineas sin precio no suman. Docs: docs/DECISIONS.md (2026-10-19).
*@

@{
    ViewBag.Title = "Pedido N° " + Model.Id;
    var pivot = ViewBag.Pivot as WebCore.Services.PedidoPivotVm ?? new WebCore.Services.PedidoPivotVm();
    bool puedeModificar = ViewBag.PuedeModificar is bool pm && pm;
    var cultura = new CultureInfo("es-AR");
    string Cant(decimal v) => v.ToString("0.###", cultura);
    string Dinero(decimal v) => "$ " + v.ToString("N2", cultura);
}

<div class="container-fluid pedido-detalle-page"
     data-id="@Model.Id"
     data-ticket-url="@Url.Action("Ticket", "Pedidos", new { id = Model.Id })"
     data-ticket-payload-url="@Url.Action("TicketPayload", "Pedidos", new { id = Model.Id })"
     data-pdf-url="@Url.Action("Pdf", "Pedidos", new { id = Model.Id })"
     data-excel-url="@Url.Action("Excel", "Pedidos", new { id = Model.Id })"
     data-email-datos-url="@Url.Action("DatosEmail", "Pedidos", new { id = Model.Id })"
     data-email-enviar-url="@Url.Action("EnviarEmail", "Pedidos")">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-start justify-content-between" style="gap:.75rem">
                <div>
                    <h5 class="mb-1">Pedido N° @Model.Id</h5>
                    <div class="small text-muted">
                        @Model.Fecha.ToString("dd/MM/yyyy HH:mm", cultura) · hecho por <strong>@Model.Usuario</strong>
                        @if (Model.Modificado.HasValue)
                        {
                            <span> · modificado el @Model.Modificado.Value.ToString("dd/MM/yyyy HH:mm", cultura)</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Nota))
                    {
                        <div class="mt-2"><span class="text-muted">Nota:</span> @Model.Nota</div>
                    }
                </div>
                <div class="text-right">
                    <div class="small text-muted">@Negocio.PedidoTextos.EtiquetaTotal(Model.LineasSinPrecio)</div>
                    <div class="h5 mb-0">@Dinero(Model.TotalEstimado)</div>
                    @if (Model.LineasSinPrecio > 0)
                    {
                        <div class="small text-warning" title="Las líneas sin precio de la última compra no suman al total">@(Negocio.Pedido.Contar(Model.LineasSinPrecio, "línea", "líneas")) sin precio de compra</div>
                    }
                </div>
            </div>

            <div class="mt-3 pedido-acciones-barra">
                <a href="@Url.Action("Index", "Pedidos")" class="btn btn-outline-secondary"><i class="fas fa-arrow-left mr-1"></i>Pedidos</a>
                <button type="button" class="btn btn-outline-primary" id="btnPedidoTicket"><i class="fas fa-print mr-1"></i>Ticket</button>
                <button type="button" class="btn btn-outline-primary" id="btnPedidoPdf"><i class="far fa-file-pdf mr-1"></i>PDF</button>
                <button type="button" class="btn btn-outline-primary" id="btnPedidoEmail"><i class="far fa-envelope mr-1"></i>Enviar por email</button>
                <button type="button" class="btn btn-outline-primary" id="btnPedidoExcel"><i class="far fa-file-excel mr-1"></i>Excel</button>
                @if (puedeModificar)
                {
                    <a href="@Url.Action("Editar", "Pedidos", new { id = Model.Id })" class="btn btn-primary"><i class="fas fa-edit mr-1"></i>Modificar</a>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0 pedido-tabla">
                    <thead class="thead-light">
                        <tr>
                            <th>Cód.</th>
                            <th>Producto</th>
                            @foreach (var s in pivot.Sucursales)
                            {
                                <th class="text-right">@s.Nombre</th>
                            }
                            <th class="text-right">Total</th>
                            <th class="text-right">$ últ. compra</th>
                            <th class="text-right">Importe est.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in pivot.Filas)
                        {
                            <tr>
                                <td class="text-muted">@f.Codigo</td>
                                <td>@f.Producto</td>
                                @for (int i = 0; i < pivot.Sucursales.Count; i++)
                                {
                                    <td class="text-right text-nowrap">@(f.Cantidades[i].HasValue ? Cant(f.Cantidades[i].Value) : "")</td>
                                }
                                <td class="text-right text-nowrap font-weight-bold">
                                    @Cant(f.Total)
                                    @if (f.Pesable && f.Promedio.HasValue && f.Promedio.Value > 0m)
                                    {
                                        <span class="pedido-un">≈ @((f.Total / f.Promedio.Value).ToString("N1", cultura)) un.</span>
                                    }
                                </td>
                                <td class="text-right text-nowrap">
                                    @if (f.Precio.HasValue)
                                    {
                                        @Dinero(f.Precio.Value)
                                        // De quien y de cuando es el precio (se guarda al armar el pedido); en naranja si es viejo respecto de la fecha del pedido.
                                        string origen = Negocio.PedidoTextos.DescribirOrigenPrecio(f.Proveedor, f.FechaPrecio);
                                        if (origen.Length > 0 || f.PrecioViejo)
                                        {
                                            <span class="pedido-un @(f.PrecioViejo ? "text-warning" : "")" title="@(f.PrecioViejo ? "Precio de hace " + f.DiasDelPrecio + " días respecto del pedido: puede estar desactualizado" : "Compra que dio este precio")">@(f.PrecioViejo ? "⚠ " : "")@origen</span>
                                        }
                                    }
                                    else { <span class="text-muted">sin precio</span> }
                                </td>
                                <td class="text-right text-nowrap">
                                    @if (f.Importe.HasValue)
                                    {
                                        @Dinero(f.Importe.Value)
                                        if (f.AlgunaSinPrecio) { <span class="pedido-un text-warning" title="Alguna sucursal de este producto no tenía precio y no suma">parcial</span> }
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="@(2 + pivot.Sucursales.Count + 2)" class="text-right">@Negocio.PedidoTextos.EtiquetaTotal(pivot.LineasSinPrecio)</th>
                            <th class="text-right text-nowrap">@Dinero(pivot.TotalEstimado)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @* De donde sale el importe: el mismo texto que el ticket, el PDF, el Excel y el mail (Negocio.PedidoTextos). *@
            <div class="pedido-aclaracion px-3 py-2 small text-muted">
                @Negocio.PedidoTextos.Aclaracion(pivot.LineasSinPrecio)
                @if (pivot.HayPreciosViejos) { <span> @Negocio.PedidoTextos.AvisoPrecioViejo(pivot.DiasPrecioViejo)</span> }
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-2"><strong>Historial</strong></div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-sm mb-0 pedido-historial">
                <tbody>
                    @foreach (var e in Model.Eventos.OrderByDescending(x => x.Fecha).ThenByDescending(x => x.Id))
                    {
                        <tr>
                            <td class="text-nowrap align-top">@e.Fecha.ToString("dd/MM/yyyy HH:mm", cultura)</td>
                            <td class="align-top"><span class="badge @(e.Tipo == Entidades.PedidoEvento.TipoAlta ? "badge-success" : "badge-info")">@(e.Tipo == Entidades.PedidoEvento.TipoAlta ? "Alta" : "Modificación")</span></td>
                            <td class="align-top">
                                @e.Usuario
                                @if (!string.IsNullOrWhiteSpace(e.Autorizador))
                                {
                                    <div class="small text-muted">autorizó @e.Autorizador</div>
                                }
                            </td>
                            <td class="align-top pedido-detalle-texto">@e.Detalle</td>
                        </tr>
                    }
                    @if (!Model.Eventos.Any())
                    {
                        <tr><td class="text-muted p-3">Sin historial.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .pedido-detalle-page { font-size: .9rem; }
    .pedido-detalle-page .card-body { padding: .82rem 1rem; }
    .pedido-detalle-page .btn { font-size: .84rem; padding: .3rem .7rem; }
    .pedido-acciones-barra { display: flex; flex-wrap: wrap; gap: .5rem; }
    .pedido-tabla { font-size: .84rem; }
    .pedido-tabla th, .pedido-tabla td { padding: .42rem .58rem; line-height: 1.15; vertical-align: middle; }
    .pedido-tabla thead th { font-size: .72rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }
    .pedido-un { display: block; font-size: .72rem; font-weight: 400; color: #858796; }
    .pedido-historial td { font-size: .82rem; }
    .pedido-detalle-texto { white-space: pre-wrap; }
</style>

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/pedido-acciones.js")" asp-append-version="true"></script>
    <script>
        (function () {
            var $pagina = $(".pedido-detalle-page");
            var id = parseInt($pagina.attr("data-id"), 10);
            var acciones = {
                ticketUrl: $pagina.attr("data-ticket-url"),
                ticketPayloadUrl: $pagina.attr("data-ticket-payload-url"),
                pdfUrl: $pagina.attr("data-pdf-url"),
                excelUrl: $pagina.attr("data-excel-url"),
                emailDatosUrl: $pagina.attr("data-email-datos-url"),
                emailEnviarUrl: $pagina.attr("data-email-enviar-url")
            };

            $("#btnPedidoTicket").on("click", function () { PedidoAcciones.ticket(acciones); });
            $("#btnPedidoPdf").on("click", function () { PedidoAcciones.pdf(acciones); });
            $("#btnPedidoExcel").on("click", function () { PedidoAcciones.excel(acciones); });
            $("#btnPedidoEmail").on("click", function () { PedidoAcciones.email(id, acciones); });
        })();
    </script>
}
