@model WebCore.Models.AuditoriaLoginIndexVm
@{
    ViewData["Title"] = "Auditoría de accesos";
}

<div class="container-fluid auditoria-login-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Auditoría de accesos</h1>
            <p class="text-muted mb-0">Quién inició sesión, cuándo y desde dónde.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" action="/AuditoriaLogin" id="formFiltroAuditoria">
                <div class="form-row align-items-end">
                    <div class="col-12 col-md-4">
                        <div class="form-group mb-2">
                            <label for="fechaDesde">Desde</label>
                            <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@Model.FechaDesde" />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group mb-2">
                            <label for="fechaHasta">Hasta</label>
                            <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@Model.FechaHasta" />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-group mb-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search mr-1"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Fecha / hora</th>
                            <th>Sucursal</th>
                            <th class="text-center">Resultado</th>
                            <th>Motivo</th>
                            <th>IP</th>
                            <th style="width: 130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No hay accesos registrados en el rango seleccionado.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.UsuarioNombre</td>
                                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(item.SucursalNombre) ? item.SucursalNombre : "-")</td>
                                    <td class="text-center">
                                        @if (item.Permitido)
                                        {
                                            <span class="badge badge-success">Permitido</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Bloqueado</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@item.Motivo</td>
                                    <td class="text-muted small">@(!string.IsNullOrWhiteSpace(item.Ip) ? item.Ip : "-")</td>
                                    <td>
                                        @if (item.TieneCoordenadas)
                                        {
                                            var url = "https://maps.google.com/?q=" + item.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + "," + item.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                            <a class="btn btn-sm btn-outline-secondary" href="@url" target="_blank" rel="noopener">
                                                <i class="fas fa-map-marker-alt mr-1"></i> Ver en Maps
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .auditoria-login-page {
        font-size: .9rem;
    }

    .auditoria-login-page .h3 {
        font-size: 1.28rem;
        line-height: 1.15;
    }

    .auditoria-login-page .form-control,
    .auditoria-login-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .auditoria-login-page .table {
        font-size: .84rem;
    }

    .auditoria-login-page .table th,
    .auditoria-login-page .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .auditoria-login-page .table thead th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    @@media (min-width: 1200px) {
        .auditoria-login-page .form-control,
        .auditoria-login-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }

        .auditoria-login-page .table {
            font-size: .81rem;
        }

        .auditoria-login-page .table thead th {
            font-size: .69rem !important;
        }
    }
</style>
