@model WebCore.Models.LiquidacionPreviewVm
@{
    ViewBag.Title = "Confirmar liquidación";
}

<div class="container-fluid liquidaciones-preview-page">
    <h4 class="mb-3">Confirmar liquidación — @Model.EmpleadoNombre</h4>
    <p class="text-muted">Período: @Model.Desde.ToString("dd/MM/yyyy HH:mm") al @Model.Hasta.ToString("dd/MM/yyyy HH:mm")</p>

    @if (Model.Detalle.Any(d => d.SinTarifaConfigurada))
    {
        <div class="alert alert-warning">
            Hay líneas sin tarifa configurada para el empleado (resaltadas abajo en amarillo). Completá el valor unitario a mano antes de confirmar.
        </div>
    }

    <form asp-controller="Liquidaciones" asp-action="Confirmar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idEmpleado" value="@Model.IdEmpleado" />
        <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-ddTHH:mm:ss")" />
        <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-ddTHH:mm:ss")" />

        <div class="card shadow-sm mb-3">
            <div class="card-header">Detalle</div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead class="thead-light">
                        <tr><th>Concepto</th><th style="width:120px;">Cantidad</th><th style="width:150px;">Valor unitario</th><th style="width:60px;">Origen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalle)
                        {
                            <tr class="@(d.SinTarifaConfigurada ? "table-warning" : "")">
                                <td>
                                    @d.Concepto
                                    <input type="hidden" name="concepto" value="@d.Concepto" />
                                    <input type="hidden" name="origen" value="@d.Origen" />
                                </td>
                                <td><input type="number" step="0.01" name="cantidad" value="@d.Cantidad" class="form-control form-control-sm" /></td>
                                <td><input type="number" step="0.01" name="valorUnitario" value="@d.ValorUnitario" class="form-control form-control-sm" /></td>
                                <td class="text-center small text-muted">@d.Origen</td>
                            </tr>
                        }
                        @for (int i = 0; i < WebCore.Models.LiquidacionPreviewVm.CantidadLineasManuales; i++)
                        {
                            <tr>
                                <td><input type="text" name="concepto" class="form-control form-control-sm" placeholder="Ej: Premio, Bono, Aguinaldo" />
                                    <input type="hidden" name="origen" value="Manual" /></td>
                                <td><input type="number" step="0.01" name="cantidad" value="1" class="form-control form-control-sm" /></td>
                                <td><input type="number" step="0.01" name="valorUnitario" class="form-control form-control-sm" placeholder="0.00" /></td>
                                <td class="text-center small text-muted">Manual</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold">
                            <td colspan="2" class="text-right">Total (se recalcula al confirmar)</td>
                            <td colspan="2">$@Model.Total.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Texto para la cuenta corriente</div>
            <div class="card-body">
                <textarea name="detalleCtaCte" class="form-control" rows="2">@Model.DetalleCtaCte</textarea>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Confirmar liquidación</button>
        <a href="@Url.Action("Nueva", "Liquidaciones", new { idEmpleado = Model.IdEmpleado })" class="btn btn-outline-secondary">Volver</a>
    </form>
</div>

<style>
    .liquidaciones-preview-page {
        font-size: .9rem;
    }

    .liquidaciones-preview-page .card-body {
        padding: .82rem 1rem;
    }

    .liquidaciones-preview-page .form-control,
    .liquidaciones-preview-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .liquidaciones-preview-page .form-control-sm {
        font-size: .8rem !important;
        min-height: 1.9rem !important;
        padding: .22rem .45rem !important;
    }

    .liquidaciones-preview-page .table {
        font-size: .84rem;
    }

    .liquidaciones-preview-page .table th,
    .liquidaciones-preview-page .table td {
        padding: .42rem .58rem;
        vertical-align: middle;
    }

    .liquidaciones-preview-page .table thead th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }
</style>
