@model WebCore.Models.LiquidacionPreviewVm
@{
    ViewBag.Title = "Confirmar liquidación";
}

<div class="container-fluid liquidaciones-preview-page">
    <h4 class="mb-3">
        Confirmar liquidación — @Model.EmpleadoNombre
        <button type="button" class="btn btn-sm btn-link p-0 ml-1" data-bs-toggle="modal" data-bs-target="#modalInfoLiquidacionPreview" title="Cómo usar esta pantalla">
            <i class="fas fa-info-circle"></i>
        </button>
    </h4>
    <p class="text-muted">Período: @Model.Desde.ToString("dd/MM/yyyy HH:mm") al @Model.Hasta.ToString("dd/MM/yyyy HH:mm")</p>
    <p>
        <a href="@Url.Action("Index", "Jornadas", new { idEmpleado = Model.IdEmpleado, desde = Model.Desde.ToString("yyyy-MM-dd"), hasta = Model.Hasta.ToString("yyyy-MM-dd") })">
            <i class="fas fa-external-link-alt mr-1"></i>¿Falta o está mal una marcación? Corregila en Jornadas
        </a>
    </p>

    @if (Model.Detalle.Any(d => d.SinTarifaConfigurada))
    {
        <div class="alert alert-warning">
            Hay líneas sin tarifa configurada para el empleado (resaltadas abajo en amarillo). Completá el valor unitario a mano antes de confirmar.
        </div>
    }

    <form asp-controller="Liquidaciones" asp-action="Confirmar" method="post" id="formConfirmarLiquidacion">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idEmpleado" value="@Model.IdEmpleado" />
        <input type="hidden" name="desde" value="@Model.Desde.ToString("yyyy-MM-ddTHH:mm:ss")" />
        <input type="hidden" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-ddTHH:mm:ss")" />

        <div class="card shadow-sm mb-3">
            <div class="card-header">Detalle</div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead class="thead-light">
                        <tr><th>Concepto</th><th style="width:120px;">Cantidad</th><th style="width:150px;">Valor unitario</th><th style="width:60px;">Origen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalle)
                        {
                            <tr class="@(d.SinTarifaConfigurada ? "table-warning" : "")">
                                <td>
                                    @d.Concepto
                                    <input type="hidden" name="concepto" value="@d.Concepto" />
                                    <input type="hidden" name="origen" value="@d.Origen" />
                                </td>
                                <td><input type="number" step="0.01" name="cantidad" value="@d.Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm js-linea-cantidad" /></td>
                                <td><input type="number" step="0.01" name="valorUnitario" value="@d.ValorUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm js-linea-valor" /></td>
                                <td class="text-center small text-muted">@d.Origen</td>
                            </tr>
                        }
                        @for (int i = 0; i < WebCore.Models.LiquidacionPreviewVm.CantidadLineasManuales; i++)
                        {
                            <tr>
                                <td><input type="text" name="concepto" class="form-control form-control-sm" placeholder="Ej: Premio, Bono, Aguinaldo" />
                                    <input type="hidden" name="origen" value="Manual" /></td>
                                <td><input type="number" step="0.01" name="cantidad" value="1" class="form-control form-control-sm js-linea-cantidad" /></td>
                                <td><input type="number" step="0.01" name="valorUnitario" class="form-control form-control-sm js-linea-valor" placeholder="0.00" /></td>
                                <td class="text-center small text-muted">Manual</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold">
                            <td colspan="2" class="text-right">Total estimado (se recalcula también al confirmar)</td>
                            <td colspan="2">$<span id="totalEstimado">@Model.Total.ToString("N2")</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Texto para la cuenta corriente</div>
            <div class="card-body">
                <textarea name="detalleCtaCte" class="form-control" rows="2">@Model.DetalleCtaCte</textarea>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Confirmar liquidación</button>
        <small class="text-muted ml-2">Atajo: Alt + Enter</small>
        <a href="@Url.Action("Nueva", "Liquidaciones", new { idEmpleado = Model.IdEmpleado })" class="btn btn-outline-secondary">Volver</a>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('formConfirmarLiquidacion');

            // Enter dentro de un campo del formulario ya no confirma la liquidacion -- una
            // liquidacion es plata acreditada en la cta cte, no queremos que se confirme por un
            // Enter accidental mientras se edita cantidad/valor. Alt+Enter (o el boton) si confirma.
            form.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter' && !ev.altKey) {
                    ev.preventDefault();
                } else if (ev.key === 'Enter' && ev.altKey) {
                    ev.preventDefault();
                    form.requestSubmit();
                }
            });

            // Recalculo en vivo del total mostrado -- solo una vista previa en el navegador; el
            // servidor sigue siendo la unica fuente de verdad del total real al confirmar
            // (Negocio.LiquidacionSueldo.Confirmar recalcula Subtotal/TotalLiquidado siempre).
            var totalEl = document.getElementById('totalEstimado');
            function recalcularTotal() {
                var cantidades = form.querySelectorAll('.js-linea-cantidad');
                var valores = form.querySelectorAll('.js-linea-valor');
                var total = 0;
                for (var i = 0; i < cantidades.length; i++) {
                    var cant = parseFloat(cantidades[i].value.replace(',', '.'));
                    var val = parseFloat(valores[i].value.replace(',', '.'));
                    if (!isNaN(cant) && !isNaN(val)) total += cant * val;
                }
                totalEl.textContent = total.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            form.querySelectorAll('.js-linea-cantidad, .js-linea-valor').forEach(function (input) {
                input.addEventListener('input', recalcularTotal);
            });
        })();
    </script>
}

<div class="modal fade" id="modalInfoLiquidacionPreview" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable liquidaciones-preview-page">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cómo usar "Confirmar liquidación"</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Este es el detalle calculado a partir de las marcaciones del empleado en el período. Podés ajustar cantidad o valor unitario a mano antes de confirmar, y agregar líneas manuales (premio, bono, aguinaldo, etc.).</p>
                <p>Las líneas resaltadas en amarillo no tienen una tarifa configurada para ese turno/día — hay que completar el valor a mano o cargarle una tarifa al empleado antes de confirmar.</p>
                <p>Si falta una marcación o está mal cargada, no la corrijas acá: usá el link "Corregila en Jornadas" de arriba, arreglala ahí (te lleva directo a este empleado y período) y volvé a generar la liquidación.</p>
                <p>Al confirmar, el total se acredita en la cuenta corriente del empleado y ya no se puede modificar la liquidación (solo eliminarla y rehacerla).</p>
            </div>
        </div>
    </div>
</div>

<style>
    .liquidaciones-preview-page {
        font-size: .9rem;
    }

    .liquidaciones-preview-page .card-body {
        padding: .82rem 1rem;
    }

    .liquidaciones-preview-page .form-control,
    .liquidaciones-preview-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .liquidaciones-preview-page .form-control-sm {
        font-size: .8rem !important;
        min-height: 1.9rem !important;
        padding: .22rem .45rem !important;
    }

    .liquidaciones-preview-page .table {
        font-size: .84rem;
    }

    .liquidaciones-preview-page .table th,
    .liquidaciones-preview-page .table td {
        padding: .42rem .58rem;
        vertical-align: middle;
    }

    .liquidaciones-preview-page .table thead th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }
</style>
