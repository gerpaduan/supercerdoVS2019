@model WebCore.Models.LiquidacionNuevaVm
@{
    ViewBag.Title = "Nueva liquidación";
}

<div class="container-fluid liquidaciones-nueva-page">
    <h4 class="mb-3">
        Nueva liquidación
        <button type="button" class="btn btn-sm btn-link p-0 ml-1" data-bs-toggle="modal" data-bs-target="#modalInfoLiquidacionNueva" title="Cómo usar esta pantalla">
            <i class="fas fa-info-circle"></i>
        </button>
    </h4>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-controller="Liquidaciones" asp-action="Calcular" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row align-items-end">
                    <div class="form-group col-md-5">
                        <label>Empleado</label>
                        <select name="idEmpleado" class="form-control" required>
                            <option value="">-- Elegir --</option>
                            @foreach (var e in Model.Empleados)
                            {
                                <option value="@e.Id" selected="@(Model.IdEmpleado == e.Id)">@WebCore.Helpers.EmpleadoDisplay.NombreConIdentificacion(e.RazonSocial, e.Identificacion)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-3">
                        <label>Desde (fecha y hora)</label>
                        <input type="datetime-local" name="desde" value="@Model.Desde.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Hasta (fecha y hora)</label>
                        <input type="datetime-local" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
                    </div>
                    <div class="form-group col-md-1">
                        <button type="submit" class="btn btn-primary btn-block">Calcular</button>
                    </div>
                </div>
                <small class="form-text text-muted">
                    Por defecto la hora es 00:00 — alcanza con elegir las fechas para la mayoría de los casos.
                    La hora sirve para cuando hace falta cortar un período a mitad de jornada.
                </small>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalInfoLiquidacionNueva" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable liquidaciones-nueva-page">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cómo usar "Nueva liquidación" (admin)</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Elegí el empleado y el período a liquidar. No puede superponerse con un período ya confirmado para ese mismo empleado.</p>
                <p>Al calcular, el sistema arma el detalle a partir de sus marcaciones de asistencia (si su forma de pago las requiere) o de su sueldo fijo por período — la pantalla siguiente permite revisar y ajustar ese detalle antes de confirmar.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .liquidaciones-nueva-page {
        font-size: .9rem;
    }

    .liquidaciones-nueva-page .card-body {
        padding: .82rem 1rem;
    }

    .liquidaciones-nueva-page .form-control,
    .liquidaciones-nueva-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .liquidaciones-nueva-page label {
        font-size: .8rem;
    }

    .liquidaciones-nueva-page .small,
    .liquidaciones-nueva-page .text-muted,
    .liquidaciones-nueva-page .form-text {
        font-size: .8rem !important;
    }
</style>
