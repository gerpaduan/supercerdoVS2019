@model WebCore.Models.UsuarioIndexVm

@{
    ViewBag.Title = "Usuarios";
}

<div class="container-fluid usuarios-index-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        @if (Model.PuedeAdministrar)
        {
            <a class="btn btn-primary mt-2 mt-md-0" href="@Url.Action("Editar", "Usuarios")">
                <i class="fas fa-plus mr-1"></i> Crear usuario nuevo
            </a>
        }
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="row align-items-end">
                <div class="col-12 col-lg-4 mb-2 mb-lg-0">
                    <label for="filtroUsuarios" class="font-weight-bold mb-1">Buscar usuario</label>
                    <div class="input-group">
                        <input type="text" id="filtroUsuarios" class="form-control" placeholder="Buscar por id, nombre, usuario o email" autocomplete="off" />
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-4 col-lg-2">
                    <label for="filtroAdmin" class="font-weight-bold mb-1">Administrador</label>
                    <select id="filtroAdmin" class="form-control custom-select">
                        <option value="">Todos</option>
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="col-4 col-lg-2">
                    <label for="filtroActivo" class="font-weight-bold mb-1">Activo</label>
                    @* Por defecto solo se muestran los activos (pedido del usuario, 2026-10-22). *@
                    <select id="filtroActivo" class="form-control custom-select">
                        <option value="">Todos</option>
                        <option value="1" selected>Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="col-4 col-lg-2">
                    <label for="filtroBloqueado" class="font-weight-bold mb-1">Bloqueado</label>
                    <select id="filtroBloqueado" class="form-control custom-select">
                        <option value="">Todos</option>
                        <option value="total">Sí</option>
                        <option value="parcial">Parcial</option>
                        <option value="no">No</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 mt-2 mt-lg-0 text-lg-right">
                    <button type="button" id="limpiarFiltros" class="btn btn-sm btn-outline-secondary">Limpiar filtros</button>
                </div>
            </div>
            <div class="mt-2">
                <span id="contadorUsuarios" class="text-muted small"></span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0" id="tablaUsuarios">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:70px;">ID</th>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th style="width:90px;">Admin</th>
                            <th style="width:90px;">Activo</th>
                            <th style="width:100px;">Bloqueado</th>
                            <th>Email</th>
                            <th style="width:130px;">ID Sucursal User</th>
                            <th style="width:110px;">ID Empresa</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">No hay usuarios para mostrar.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="js-usuario-row"
                                    data-admin="@(item.Admin ? "1" : "0")"
                                    data-activo="@(item.Activo ? "1" : "0")"
                                    data-bloqueado="@(item.Bloqueado ? "total" : item.BloqueadoNoSeguro ? "parcial" : "no")"
                                    data-search="@((item.Id + " " + (item.Nombre ?? "") + " " + (item.Usuario ?? "") + " " + (item.Email ?? "") + " " + item.IdEmpresa + " " + item.IdSucursalUser).ToLowerInvariant())">
                                    <td>@item.Id</td>
                                    <td>@item.Nombre</td>
                                    <td>@item.Usuario</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Admin ? "badge-success" : "badge-secondary")">@(item.Admin ? "Sí" : "No")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.Activo ? "badge-primary" : "badge-dark")">@(item.Activo ? "Sí" : "No")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Bloqueado)
                                        {
                                            <span class="badge badge-danger">Sí</span>
                                        }
                                        else if (item.BloqueadoNoSeguro)
                                        {
                                            <span class="badge badge-warning" title="Bloqueado solo para ingresos desde dispositivos no autorizados">Parcial</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">No</span>
                                        }
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        @item.IdSucursalUser
                                        @if (!string.IsNullOrWhiteSpace(item.SucursalNombre))
                                        {
                                            <div class="small text-muted">@item.SucursalNombre</div>
                                        }
                                    </td>
                                    <td>@item.IdEmpresa</td>
                                    <td>
                                        @if (Model.PuedeAdministrar)
                                        {
                                            <a class="btn btn-sm btn-outline-primary mr-1 mb-1" href="@Url.Action("Editar", "Usuarios", new { id = item.Id })">
                                                Modificar
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary mb-1" href="@Url.Action("Permisos", "Usuarios", new { id = item.Id })">
                                                Ver permisos
                                            </a>
                                            if (item.Bloqueado || item.BloqueadoNoSeguro)
                                            {
                                                <form asp-controller="Usuarios" asp-action="DesbloquearUsuario" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger mb-1" onclick="return confirm('¿Desbloquear esta cuenta?');">
                                                        Desbloquear
                                                    </button>
                                                </form>
                                            }
                                            if (item.TienePin)
                                            {
                                                <form asp-controller="Usuarios" asp-action="QuitarPin" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning mb-1" title="Elimina la clave rápida (PIN) de este usuario" onclick="return confirm('¿Quitar la clave rápida de este usuario? Seguirá ingresando con su contraseña.');">
                                                        Quitar PIN
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .usuarios-index-page .card-body {
        padding: .82rem 1rem;
    }

    .usuarios-index-page .font-weight-bold.mb-1 {
        font-size: .76rem;
        font-weight: 600 !important;
        color: #495057;
        margin-bottom: .18rem !important;
    }

    .usuarios-index-page .form-control,
    .usuarios-index-page .input-group-text {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .usuarios-index-page #contadorUsuarios {
        font-size: .8rem;
    }

    .usuarios-index-page #tablaUsuarios {
        font-size: .84rem;
    }

    .usuarios-index-page #tablaUsuarios th,
    .usuarios-index-page #tablaUsuarios td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .usuarios-index-page #tablaUsuarios thead th,
    .usuarios-index-page #tablaUsuarios > thead > tr > th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .usuarios-index-page #tablaUsuarios .btn {
        font-size: .78rem;
        padding: .23rem .5rem;
    }

    .usuarios-index-page #tablaUsuarios .badge {
        font-size: .7rem;
    }

    @@media (min-width: 1200px) {
        .usuarios-index-page .mb-3 {
            margin-bottom: .85rem !important;
        }

        .usuarios-index-page .card-body {
            padding: .7rem .85rem;
        }

        .usuarios-index-page .form-control,
        .usuarios-index-page .input-group-text {
            font-size: .84rem !important;
            min-height: 2.15rem !important;
            padding: .28rem .56rem !important;
        }

        .usuarios-index-page #tablaUsuarios {
            font-size: .8rem;
        }

        .usuarios-index-page #tablaUsuarios thead th,
        .usuarios-index-page #tablaUsuarios > thead > tr > th {
            font-size: .69rem !important;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var $filtro = $('#filtroUsuarios');
            var $rows = $('#tablaUsuarios tbody .js-usuario-row');
            var $contador = $('#contadorUsuarios');
            var $admin = $('#filtroAdmin');
            var $activo = $('#filtroActivo');
            var $bloqueado = $('#filtroBloqueado');

            // Una fila se ve si cumple el texto Y cada select (valor vacio = sin filtro).
            // Bloqueado distingue "total" de "parcial" (bloqueo solo en dispositivos no autorizados),
            // igual que la columna Bloqueado de la tabla.
            function aplicarFiltro() {
                var texto = ($filtro.val() || '').toLowerCase().trim();
                var admin = String($admin.val() || '');
                var activo = String($activo.val() || '');
                var bloqueado = String($bloqueado.val() || '');
                var visibles = 0;

                $rows.each(function () {
                    var $row = $(this);
                    var search = String($row.data('search') || '');
                    var visible = (!texto || search.indexOf(texto) >= 0)
                        && (!admin || String($row.attr('data-admin')) === admin)
                        && (!activo || String($row.attr('data-activo')) === activo)
                        && (!bloqueado || String($row.attr('data-bloqueado')) === bloqueado);
                    $row.toggleClass('d-none', !visible);
                    if (visible) visibles++;
                });

                $contador.text(visibles + ' de ' + $rows.length + ' usuario(s)');
            }

            // "Limpiar filtros" vuelve al estado inicial de la pantalla (solo activos).
            function limpiarFiltros() {
                $filtro.val('');
                $admin.val('');
                $activo.val('1');
                $bloqueado.val('');
                aplicarFiltro();
            }

            $filtro.on('input', aplicarFiltro);
            $admin.add($activo).add($bloqueado).on('change', aplicarFiltro);
            $('#limpiarFiltros').on('click', limpiarFiltros);
            aplicarFiltro();
        })();
    </script>
}
