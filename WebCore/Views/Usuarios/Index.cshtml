@model WebCore.Models.UsuarioIndexVm

@*
    Listado de usuarios (rediseno 2026-11-10, ver docs/DECISIONS.md "Rediseno de Usuarios"): una columna "Usuario" con nombre, usuario y
    email; tipo y estado como etiquetas; filtros como botones con su cantidad; la fila abre la ficha y las acciones secundarias van
    en el menu de la derecha. Manual: docs/11-manual-de-uso/pantallas/Usuarios.Index.md.
*@

@functions {
    private static string Tipo(WebCore.Models.UsuarioResumenVm u) => u.Admin ? "admin" : u.EsProduccion ? "prod" : "empleado";
}

@{
    ViewBag.Title = "Usuarios";
    var items = Model.Items ?? new List<WebCore.Models.UsuarioResumenVm>();
    int cActivos = items.Count(u => u.Activo);
    int cAdmin = items.Count(u => u.Admin);
    int cProd = items.Count(u => u.EsProduccion);
    int cBloq = items.Count(u => u.Bloqueado || u.BloqueadoNoSeguro);
    int cInact = items.Count(u => !u.Activo);
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/usuarios.css")" asp-append-version="true" />

<div class="container-fluid usr-page" id="usrListado">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <div class="usr-crumb">Configuración</div>
            <h1 class="h5 mb-0 font-weight-bold">Usuarios</h1>
        </div>
        @if (Model.PuedeAdministrar)
        {
            <a class="usr-btn usr-btn-primary mt-2 mt-md-0" href="@Url.Action("Asistente", "Usuarios")"><i class="fas fa-plus"></i> Nuevo usuario</a>
        }
    </div>

    <div class="usr-card">
        <div class="usr-tools">
            <input type="search" class="usr-input" id="usrBuscar" placeholder="Buscar por nombre, usuario o email…" autocomplete="off" aria-label="Buscar usuario" />
            @* Por defecto solo se muestran los activos (pedido del usuario, 2026-10-22). *@
            <div class="usr-filtros" id="usrFiltros" role="group" aria-label="Filtrar usuarios">
                <button type="button" data-f="todos">Todos<b>@items.Count</b></button>
                <button type="button" data-f="activo" class="on">Activos<b>@cActivos</b></button>
                <button type="button" data-f="admin">Administradores<b>@cAdmin</b></button>
                <button type="button" data-f="prod">Producción<b>@cProd</b></button>
                <button type="button" data-f="bloq">Bloqueados<b>@cBloq</b></button>
                <button type="button" data-f="inact">Inactivos<b>@cInact</b></button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="usr-lst" id="usrTabla">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th class="h-sm">Sucursal</th>
                        <th class="h-sm">Ingreso</th>
                        <th style="width:1%"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in items)
                    {
                        string urlFicha = Url.Action("Asistente", "Usuarios", new { id = u.Id }) ?? "#";
                        string buscar = ((u.Nombre ?? "") + " " + (u.Usuario ?? "") + " " + (u.Email ?? "")).ToLowerInvariant();
                        <tr class="usr-fila-lst" data-tipo="@Tipo(u)" data-activo="@(u.Activo ? "1" : "0")"
                            data-bloq="@(u.Bloqueado || u.BloqueadoNoSeguro ? "1" : "0")" data-buscar="@buscar"
                            data-url="@(Model.PuedeAdministrar ? urlFicha : "")">
                            <td>
                                <div class="usr-celda">
                                    <span class="usr-avatar" style="background:@WebCore.Helpers.UsuarioPresentacion.ColorAvatar(u.Id)" aria-hidden="true">@WebCore.Helpers.UsuarioPresentacion.Iniciales(u.Nombre)</span>
                                    <div>
                                        <div class="n">@u.Nombre</div>
                                        <div class="s">@u.Usuario@(string.IsNullOrWhiteSpace(u.Email) ? "" : " · " + u.Email)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (u.Admin) { <span class="usr-chip ok">Administrador</span> }
                                else if (u.EsProduccion) { <span class="usr-chip warn">Producción</span> }
                                else { <span class="usr-chip pri">Empleado</span> }
                            </td>
                            <td>
                                @if (u.Activo) { <span class="usr-chip ok"><span class="usr-dot"></span> Activo</span> }
                                else { <span class="usr-chip"><span class="usr-dot"></span> Inactivo</span> }
                                @if (u.Bloqueado) { <span class="usr-chip bad" title="Cuenta bloqueada por intentos fallidos">Bloqueado</span> }
                                else if (u.BloqueadoNoSeguro) { <span class="usr-chip warn" title="Bloqueado solo para ingresos desde dispositivos no autorizados">Bloqueo parcial</span> }
                            </td>
                            <td class="h-sm">@(string.IsNullOrWhiteSpace(u.SucursalNombre) ? "—" : u.SucursalNombre)</td>
                            <td class="h-sm">
                                <div class="usr-iconos">
                                    @if (u.EntraAlPos) { <span class="usr-chip" title="Puede entrar al punto de venta">POS</span> }
                                    @if (u.TienePin) { <span class="usr-chip" title="Tiene clave rápida (PIN)">PIN</span> }
                                    @if (u.RequiereDispositivoSeguro) { <span class="usr-chip" title="Solo puede ingresar desde un dispositivo autorizado">Disp. seguro</span> }
                                </div>
                            </td>
                            <td>
                                @if (Model.PuedeAdministrar)
                                {
                                    <div class="usr-kebab">
                                        <button type="button" class="usr-btn usr-btn-sm usr-menu-btn" aria-label="Acciones de @u.Nombre" aria-haspopup="true" aria-expanded="false">⋯</button>
                                        <div class="usr-menu" role="menu">
                                            <a href="@urlFicha" role="menuitem">Modificar</a>
                                            <a href="@(urlFicha)#permisos" role="menuitem">Permisos</a>
                                            @if (u.Bloqueado || u.BloqueadoNoSeguro)
                                            {
                                                <form asp-controller="Usuarios" asp-action="DesbloquearUsuario" method="post">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" role="menuitem" onclick="return confirm('¿Desbloquear esta cuenta?');">Desbloquear</button>
                                                </form>
                                            }
                                            @if (u.TienePin)
                                            {
                                                <form asp-controller="Usuarios" asp-action="QuitarPin" method="post">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" role="menuitem" class="bad" onclick="return confirm('¿Quitar la clave rápida de este usuario? Seguirá ingresando con su contraseña.');">Quitar PIN</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="usr-vacio" id="usrVacio" hidden>No hay usuarios que coincidan con la búsqueda y el filtro.</div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var filas = Array.prototype.slice.call(document.querySelectorAll('#usrTabla tbody .usr-fila-lst'));
            var buscar = document.getElementById('usrBuscar');
            var vacio = document.getElementById('usrVacio');
            var filtro = 'activo'; // por defecto solo activos

            function pasa(fila) {
                switch (filtro) {
                    case 'activo': return fila.getAttribute('data-activo') === '1';
                    case 'admin': return fila.getAttribute('data-tipo') === 'admin';
                    case 'prod': return fila.getAttribute('data-tipo') === 'prod';
                    case 'bloq': return fila.getAttribute('data-bloq') === '1';
                    case 'inact': return fila.getAttribute('data-activo') === '0';
                    default: return true;
                }
            }

            function aplicar() {
                var texto = (buscar.value || '').toLowerCase().trim();
                var visibles = 0;
                filas.forEach(function (fila) {
                    var visible = pasa(fila) && (!texto || (fila.getAttribute('data-buscar') || '').indexOf(texto) >= 0);
                    fila.hidden = !visible;
                    if (visible) visibles++;
                });
                vacio.hidden = visibles > 0;
            }

            buscar.addEventListener('input', aplicar);
            document.getElementById('usrFiltros').addEventListener('click', function (e) {
                var boton = e.target.closest('button[data-f]');
                if (!boton) return;
                filtro = boton.getAttribute('data-f');
                document.querySelectorAll('#usrFiltros button').forEach(function (b) { b.classList.toggle('on', b === boton); });
                aplicar();
            });

            // La fila abre la ficha; el menu de la derecha (y sus botones) no.
            function cerrarMenus() {
                document.querySelectorAll('.usr-menu.on').forEach(function (m) {
                    m.classList.remove('on');
                    var b = m.parentElement.querySelector('.usr-menu-btn');
                    if (b) b.setAttribute('aria-expanded', 'false');
                });
            }
            document.addEventListener('click', function (e) {
                var boton = e.target.closest('.usr-menu-btn');
                if (boton) {
                    var menu = boton.nextElementSibling;
                    var abierto = menu.classList.contains('on');
                    cerrarMenus();
                    if (!abierto) { menu.classList.add('on'); boton.setAttribute('aria-expanded', 'true'); }
                    return;
                }
                if (e.target.closest('.usr-menu')) return;
                cerrarMenus();
                var fila = e.target.closest('.usr-fila-lst');
                if (fila && fila.getAttribute('data-url')) window.location.href = fila.getAttribute('data-url');
            });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') cerrarMenus(); });

            aplicar();
        })();
    </script>
}
