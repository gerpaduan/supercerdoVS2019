@model WebCore.Models.CompraLineasIndexVm
@using Entidades
@using System.Collections.Generic
@using System.Linq

@{
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
}

<div class="container-fluid px-2 px-md-3" data-lineas-agrupadas-page="compras">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h4 class="mb-2 mb-md-0">Lineas de compra</h4>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Compras", new { idSucursal = Model.IdSucursal, tipoCompra = Model.TipoCompra, texto = Model.Texto, fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss") })">
            <i class="fas fa-arrow-left mr-1"></i> Volver al indice
        </a>
    </div>

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Lineas", "Compras")" class="js-form-filtros-lineas">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Se modificaron filtros principales. Presioná <strong>Buscar</strong> para recargar los datos.
                </div>

                <div class="elaborados-filtros-grid lineas-filtros-grid cols-4">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="idSucursalComprasLineas" class="form-control">
                            <option value="-1" selected="@(Model.IdSucursal == -1 ? "selected" : null)">Todas</option>
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" selected="@(sucursal.IdSucursal == Model.IdSucursal ? "selected" : null)">@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha desde</label>
                        <input name="fechaDesde" id="fechaDesdeComprasLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha hasta</label>
                        <input name="fechaHasta" id="fechaHastaComprasLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Producto</label>
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="producto" value="@Model.Producto" placeholder="Codigo o descripcion" autocomplete="off" />
                    </div>
                    <div class="form-group mb-0 lineas-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block" id="btnBuscarComprasLineas">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                        </button>
                    </div>
                </div>

                <div class="mt-2">
                    <div id="estadoBusquedaComprasLineas" class="text-muted small">Resultados actualizados.</div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-4 mb-3">
                        <label class="elaborados-filtro-label">Proveedor</label>
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="proveedor" value="@Model.Texto" placeholder="Proveedor" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4 mb-3">
                        <label class="elaborados-filtro-label">Tipo de compra</label>
                        <select class="form-control js-filtro-vivo" data-live-filter="tipoCompra">
                            <option value="">Todos</option>
                            @if (Model.PermiteMediaRes)
                            {
                                <option value="media res" selected="@(Model.TipoCompra == "Media Res" ? "selected" : null)">Media Res</option>
                            }
                            <option value="cortes" selected="@(Model.TipoCompra == "Cortes" ? "selected" : null)">Cortes</option>
                        </select>
                    </div>
                </div>

                <div class="custom-control custom-switch mt-1">
                    <input type="checkbox" class="custom-control-input js-toggle-detalles-general" id="expandirDetallesCompras" />
                    <label class="custom-control-label" for="expandirDetallesCompras">Ver detalles</label>
                </div>
            </form>
        </div>
    </div>

    <div class="lineas-resumen-grid cols-4 mb-3">
        <div class="card border-left-primary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalKg">0,000</div></div></div>
        <div class="card border-left-success shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total pesos</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalImporte">$ 0,00</div></div></div>
        <div class="card border-left-info shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-info text-uppercase mb-1">Cantidad de lineas</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalLineas">0</div></div></div>
        <div class="card border-left-secondary shadow-sm lineas-resumen-card"><div class="card-body py-3"><div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Cantidad de registros</div><div class="h5 mb-0 font-weight-bold text-gray-800" id="totalRegistros">0</div></div></div>
    </div>

    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-server @(Model.Compras != null && Model.Compras.Count > 0 ? "d-none" : "")">No se encontraron compras con lineas para los filtros seleccionados.</div>
    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-client d-none">No hay resultados con el filtro en vivo.</div>

    @if (Model.Compras != null)
    {
        foreach (var compra in Model.Compras)
        {
            var proveedor = compra.Campos.FirstOrDefault(x => x.Etiqueta == "Proveedor");
            var tipoCompra = compra.Campos.FirstOrDefault(x => x.Etiqueta == "Tipo de compra");
            <div class="card shadow-sm mb-3 linea-registro-card js-registro-card"
                 data-proveedor="@(proveedor != null ? proveedor.Valor : "")"
                 data-tipoCompra="@(tipoCompra != null ? tipoCompra.Valor : "")">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <div class="linea-resumen-principal">@compra.ResumenCompacto</div>
                            <div class="linea-resumen-secundario">@compra.ResumenSecundario</div>
                        </div>
                        <div class="linea-resumen-tools mt-2 mt-md-0">
                            <span class="badge badge-success badge-pill px-3 py-2">@compra.TotalTexto</span>
                            <a class="btn btn-sm btn-outline-primary" href="@compra.EditUrl">Ver registro</a>
                        </div>
                    </div>
                    <div class="row mt-3 linea-registro-extra d-none">
                        @foreach (var campo in compra.Campos)
                        {
                            <div class="col-12 col-md-4 mb-2">
                                <div class="small text-muted text-uppercase">@campo.Etiqueta</div>
                                <div>@campo.Valor</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-responsive js-sync-scroll-body">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Código producto</th>
                                <th>Producto</th>
                                <th class="text-right">Cantidad / kg</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Total línea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in compra.Lineas)
                            {
                                <tr class="js-linea-row" data-codigo="@linea.Codigo" data-producto="@linea.Producto" data-kg="@linea.CantidadKg" data-total="@linea.Total" data-unidades="0">
                                    <td>@linea.Codigo</td>
                                    <td>@linea.Producto</td>
                                    <td class="text-right">@linea.CantidadKgTexto</td>
                                    <td class="text-right">@linea.PrecioTexto</td>
                                    <td class="text-right">@linea.TotalTexto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<style>
    .container-fluid[data-lineas-agrupadas-page="compras"] {
        font-size: .9rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .card-body {
        padding: .82rem 1rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .card-body {
        padding: .72rem .85rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtro-label {
        font-size: .76rem;
        font-weight: 600;
        margin-bottom: .18rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .form-control,
    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .btn {
        min-height: 2.35rem;
        font-size: .87rem;
        padding: .32rem .62rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .alert,
    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .small,
    .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .text-muted,
    .container-fluid[data-lineas-agrupadas-page="compras"] .custom-control-label {
        font-size: .8rem !important;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-grid {
        gap: .65rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-card .card-body {
        padding: .58rem .76rem !important;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-card .text-xs {
        font-size: .67rem;
        line-height: 1.05;
        margin-bottom: .12rem !important;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-card .h5 {
        font-size: .96rem;
        line-height: 1.05;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-registro-card .card-header {
        padding: .68rem .82rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-resumen-principal {
        font-size: .86rem;
        line-height: 1.15;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-resumen-secundario,
    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-registro-extra .small,
    .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-empty-state {
        font-size: .78rem !important;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-resumen-tools .badge,
    .container-fluid[data-lineas-agrupadas-page="compras"] .linea-resumen-tools .btn {
        font-size: .78rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .table {
        font-size: .84rem;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .table th,
    .container-fluid[data-lineas-agrupadas-page="compras"] .table td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .table thead th,
    .container-fluid[data-lineas-agrupadas-page="compras"] .table > thead > tr > th {
        font-size: .73rem;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        padding-top: .38rem;
        padding-bottom: .38rem;
        line-height: 1.1;
    }

    .container-fluid[data-lineas-agrupadas-page="compras"] .table thead.thead-light th,
    .container-fluid[data-lineas-agrupadas-page="compras"] .table .thead-light th {
        font-size: .73rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        padding-top: .38rem;
        padding-bottom: .38rem;
        line-height: 1.1;
    }

    @@media (min-width: 1200px) {
        .container-fluid[data-lineas-agrupadas-page="compras"] .mb-3 {
            margin-bottom: .85rem !important;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .card-body {
            padding: .7rem .85rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .card-body {
            padding: .65rem .8rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .form-control,
        .container-fluid[data-lineas-agrupadas-page="compras"] .elaborados-filtros-card .btn {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-card .card-body {
            padding: .5rem .7rem !important;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .lineas-resumen-card .h5 {
            font-size: .86rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .linea-registro-card .card-header {
            padding: .6rem .78rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .linea-resumen-principal {
            font-size: .81rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .table {
            font-size: .8rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .table thead th,
        .container-fluid[data-lineas-agrupadas-page="compras"] .table > thead > tr > th {
            font-size: .68rem;
        }

        .container-fluid[data-lineas-agrupadas-page="compras"] .table thead.thead-light th,
        .container-fluid[data-lineas-agrupadas-page="compras"] .table .thead-light th {
            font-size: .68rem !important;
            padding-top: .34rem;
            padding-bottom: .34rem;
        }
    }
</style>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")
@Html.Partial("~/Views/Shared/_LineasAgrupadasStyles.cshtml")

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('.js-form-filtros-lineas');
            if (!form) return;

            var inputSucursal = document.getElementById('idSucursalComprasLineas');
            var inputFechaDesde = document.getElementById('fechaDesdeComprasLineas');
            var inputFechaHasta = document.getElementById('fechaHastaComprasLineas');
            var alerta = document.getElementById('alertaFiltrosPendientes');
            var estado = document.getElementById('estadoBusquedaComprasLineas');
            var btnBuscar = document.getElementById('btnBuscarComprasLineas');
            var btnTexto = btnBuscar ? btnBuscar.querySelector('.btn-buscar-texto') : null;
            var nativeFormSubmit = window.HTMLFormElement && window.HTMLFormElement.prototype
                ? window.HTMLFormElement.prototype.submit
                : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
            };

            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === 'function') {
                    window.ModalRequestLoading.trackNavigation(message || 'Cargando solicitud...');
                }
            }

            function submitConLoader() {
                showNavigationLoading('Cargando solicitud...');
                window.setTimeout(function () {
                    if (nativeFormSubmit) {
                        nativeFormSubmit.call(form);
                    } else {
                        form.submit();
                    }
                }, 40);
            }

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            function actualizarAviso() {
                if (!alerta) return;
                alerta.classList.toggle('d-none', !hayFechasPendientes());
            }

            function setBuscando(mensaje) {
                if (btnBuscar) btnBuscar.disabled = true;
                if (btnTexto) btnTexto.textContent = ' Cargando...';
                if (estado) estado.textContent = mensaje || 'Actualizando búsqueda...';
            }

            function enviarEnVivo() {
                setBuscando('Actualizando búsqueda en vivo...');

                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                }

                submitConLoader();
            }

            if (inputFechaDesde) inputFechaDesde.addEventListener('change', actualizarAviso);
            if (inputFechaHasta) inputFechaHasta.addEventListener('change', actualizarAviso);
            if (inputSucursal) inputSucursal.addEventListener('change', enviarEnVivo);

            form.addEventListener('submit', function (event) {
                if (form.dataset.loadingSubmitPending === 'true') {
                    form.dataset.loadingSubmitPending = '';
                    return;
                }

                event.preventDefault();
                fechasAplicadas = {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
                };
                actualizarAviso();
                setBuscando('Actualizando búsqueda...');
                form.dataset.loadingSubmitPending = 'true';
                submitConLoader();
            });
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/lineas-agrupadas.js?v=1")"></script>
}
