            <script src="@Url.Content("~/Scripts/app/borrador-generico.js")" asp-append-version="true"></script>
            <script src="@Url.Content("~/Scripts/app/orden-tabla.js")" asp-append-version="true"></script>
            <script src="@Url.Content("~/Scripts/app/compras.js")" asp-append-version="true"></script>
            <script src="@Url.Content("~/Scripts/app/busqueda-feedback.js")" asp-append-version="true"></script>
            <script src="@Url.Content("~/Content/vendor/html2canvas/html2canvas.min.js")"></script>
            <script src="@Url.Content("~/Scripts/app/captura-respaldo.js")" asp-append-version="true"></script>
            <script>
                (function () {
                    @if (!borradorGenericoHabilitado)
                    {
                        @:window.CapturaRespaldo && window.CapturaRespaldo.iniciarUI();
                    }

                    if (!window.ComprasUI || typeof window.ComprasUI.init !== "function") {
                        return;
                    }

                    window.ComprasUI.init({
                        formSelector: "#formCompra",
                        desdePos: false,
                        widgetFijo: false,
                        permiteMediaRes: @(permiteMediaRes ? "true" : "false"),
                        esEdicion: @(Model.EsEdicion ? "true" : "false"),
                        draftKey: "@Model.DraftKey",
                        modalProductoSelector: "#modalBuscarProductoCompra",
                        initialLines: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lineas)),
                        borradorGenerico: {
                            habilitado: @(borradorGenericoHabilitado ? "true" : "false"),
                            modulo: "COMPRA",
                            idSucursal: @Model.IdSucursal,
                            idRegistro: @Model.IdCompra,
                            idOperador: @Sesion.UsuarioActual.Id,
                            nombreOperador: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Sesion.UsuarioActual.Nombre)),
                            latidoSegundos: @WebCore.Helpers.BorradorGenericoSettings.LatidoSegundos,
                            urls: {
                                guardar: "@Url.Action("GuardarBorrador", "BorradoresGenerico")",
                                evento: "@Url.Action("EventoBorrador", "BorradoresGenerico")",
                                listar: "@Url.Action("ListarBorradores", "BorradoresGenerico")",
                                recuperar: "@Url.Action("RecuperarBorrador", "BorradoresGenerico")",
                                descartar: "@Url.Action("DescartarBorrador", "BorradoresGenerico")",
                            marcarFinalizado: "@Url.Action("MarcarFinalizado", "BorradoresGenerico")"
                            }
                        },
                        urls: {
                            guardar: "@Url.Action("Guardar", "Compras")",
                            personaBuscarModal: "@Url.Action("Buscar", "Personas")",
                            personaListar: "@Url.Action("Listar", "Personas")",
                            personaCrear: "@Url.Action("PersonaModal", "Personas")",
                            personaGuardarCrear: "@Url.Action("GuardarPersonaModal", "Personas")",
                            buscarCortePorCodigo: "@Url.Action("BuscarCortePorCodigo", "Compras")",
                            altaProducto: "@Url.Action("AddOrEdit", "Productos")",
                            editarLayout: "@Url.Action("Editar", "Compras")",
                            nuevaLayout: "@Url.Action("NuevaCompra", "Compras", new { origen = "layout" })"
                        }
                    });

                    window.EditReadOnly && window.EditReadOnly.init({
                        formSelector: "#formCompra",
                        soloLecturaInicial: @(Model.EsEdicion ? "true" : "false"),
                        modifyButtonSelector: "#btnHabilitarEdicionCompra",
                        saveButtonSelector: "#btnGuardarCompra",
                        onStateChanged: function (readOnly, $form) {
                            if (window.ComprasUI && typeof window.ComprasUI.syncPrimaryAction === "function") {
                                window.ComprasUI.syncPrimaryAction($form);
                            }
                        }
                    });

                    if (window.EditPageGuard && typeof window.EditPageGuard.init === "function") {
                        window.EditPageGuard.init({
                            formSelector: "#formCompra",
                            modifyButtonSelector: "#btnHabilitarEdicionCompra",
                            saveButtonSelector: "#btnGuardarCompra"
                        });
                    }
                })();
            </script>
        }
    }
