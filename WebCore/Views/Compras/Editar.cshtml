@model WebCore.Models.CompraEditVm
@using System
@using System.Collections.Generic
@using Entidades
@inject WebCore.Services.IUsuarioSesionService Sesion

@{
    // Bug real (cuarta ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md "Batch 3: modal Nueva
    // Compra embebido en POS"): faltaba el equivalente a Web/Views/Compras/Editar.cshtml:8. Sin
    // esto, cuando la vista se carga embebida dentro del modal de POS (DesdePos=true, via AJAX +
    // renderConScripts en Ventas/POS.cshtml), se devolvia la pagina COMPLETA (con _Layout.cshtml:
    // nav, sidebar, sus propios <script src="jquery">/<script src="bootstrap.bundle">) anidada
    // dentro del modal-body chico de POS.
    // "embebido" = dentro de un modal (POS venta o Cta. Cte. de proveedor, origen=modal): sin _Layout
    // y con los scripts inline. Solo DesdePos aplica las reglas de caja (ver ComprasController.Guardar).
    bool embebido = Model.DesdePos || Model.EnModal;
    Layout = embebido ? null : "_Layout";
    ViewBag.Title = Model.EsEdicion ? "Modificar Compra" : "Nueva Compra";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    var modalProductoData = new ViewDataDictionary(ViewData);
    modalProductoData["ModalId"] = "modalBuscarProductoCompra";
    modalProductoData["ApiUrl"] = Url.Action("BuscarCorte", "Compras");
    modalProductoData["Titulo"] = "Buscar Producto de Compra";
    modalProductoData["MostrarPrecio"] = "true";
    string tipoCortes = Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.Cortes);
    string tipoMediaRes = Entidades.Compra.tipoCompraToString(Entidades.Compra.tipoCompraEnum.MediaRes);
    // 2026-09-15 (ver docs/DECISIONS.md "Compras: Tipo Compra y Media Res por rubro real de
    // empresa"): antes ambas variables salian del mismo hardcode de CUIT -- ahora son dos flags
    // de negocio independientes. permiteMediaRes (EsCarniceria||EmpresaPropia, ya resuelto server-
    // side en ComprasController.PermiteMediaRes) gobierna el input/panel/columnas de Media Res.
    // mostrarSelectorTipo (EmpresaPropia) gobierna el selector "Tipo Compra" en si -- si la empresa
    // no es propia, el selector se oculta y el tipo queda siempre fijo en "Cortes"/"Producto".
    bool permiteMediaRes = Model.PermiteMediaRes;
    bool mostrarSelectorTipo = Model.EmpresaPropia;
    string tipoCompraInicial = !mostrarSelectorTipo && !Model.EsEdicion ? tipoCortes : (string.IsNullOrWhiteSpace(Model.TipoCompra) ? tipoCortes : Model.TipoCompra);
    bool mostrarMediaInicial = string.Equals(tipoCompraInicial, tipoMediaRes, StringComparison.OrdinalIgnoreCase);
    // Importes y cantidades se MUESTRAN en formato argentino (1.234,50). Es solo para pantalla: los campos que se
    // editan y lo que se envia al guardar siguen igual (ver compras.js formatNumberAr).
    var culturaAr = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    // Borrador en servidor (ver docs/DECISIONS.md "Borradores de Compras/Stock/Movimientos/
    // Embutidos"): cuando esta habilitado (Postgres) reemplaza al borrador local (localStorage) y al
    // respaldo por captura de pantalla de esta pantalla -- ver §3 de esa entrada. El "operador" del
    // borrador es el usuario de la sesion actual: es solo metadata de quien lo armo, no necesita
    // coincidir con el CreadoPor final si despues se autoriza como cuenta de produccion.
    bool borradorGenericoHabilitado = WebCore.Helpers.BorradorGenericoSettings.Habilitado;
    var modalBorradoresData = new ViewDataDictionary(ViewData);
    modalBorradoresData["TituloBorradoresGenerico"] = "Compras sin guardar";
}

<div class="container-fluid px-2 px-md-3 compra-page @(embebido ? "compra-page-pos" : "")" data-compra-page="1">
    @if (ViewBag.RecuperandoEliminado is string textoRecuperando)
    {
        <div class="alert alert-info py-2 small" role="alert" id="avisoRecuperandoEliminado">
            <i class="fas fa-undo mr-1"></i> @textoRecuperando
        </div>
    }
    <div id="compraDraftBanner" class="alert alert-warning d-none" role="alert">
        Se encontró un borrador local de esta compra.
        <button type="button" class="btn btn-sm btn-warning ml-2" data-action="restore-draft">Recuperar</button>
        <button type="button" class="btn btn-sm btn-outline-dark ml-2" data-action="clear-draft">Limpiar borrador</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form id="formCompra" method="post" action="@Url.Action("Guardar", "Compras")" novalidate>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.SubmissionToken)
                @Html.HiddenFor(m => m.IdCompra)
                @Html.HiddenFor(m => m.Origen)
                @Html.HiddenFor(m => m.DraftKey)
                @Html.HiddenFor(m => m.EmpresaCuit)
                @Html.HiddenFor(m => m.CantMedias, new { id = "CantMedias" })
                @Html.HiddenFor(m => m.KgsMedias, new { id = "KgsMedias" })
                <input type="hidden" id="idPersona" name="IdProveedor" value="@Model.IdProveedor" />
                <div id="lineasHiddenContainer"></div>

                <div class="compra-section-label">
                    <span>Datos principales</span>
                    <small class="text-muted">Complete primero sucursal, fecha y proveedor. Luego cargue las líneas.</small>
                </div>

                <div class="compra-cabecera @(mostrarSelectorTipo ? "" : "compra-cabecera-sin-tipo")">
                <div class="row compra-datos-principales-row">
                    @if (mostrarSelectorTipo)
                    {
                        <div class="col-12 col-lg-3 compra-col-tipo">
                            <div class="form-group">
                                <label for="TipoCompra">Tipo compra</label>
                                <select id="TipoCompra" name="TipoCompra" class="form-control">
                                    <option value="@tipoCortes" selected="@(string.Equals(tipoCompraInicial, tipoCortes, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Producto</option>
                                    <option value="@tipoMediaRes" selected="@(string.Equals(tipoCompraInicial, tipoMediaRes, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Media</option>
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="TipoCompra" name="TipoCompra" value="@tipoCompraInicial" />
                    }

                    <div class="col-12 col-lg-@(mostrarSelectorTipo ? "3" : "4") compra-col-sucursal">
                        <div class="form-group">
                            <label for="IdSucursal">Sucursal</label>
                            @if (Model.SucursalEditable)
                            {
                                <select id="IdSucursal" name="IdSucursal" class="form-control">
                                    <option value="0">Seleccione...</option>
                                    @foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.IdSucursal" selected="@(sucursal.IdSucursal == Model.IdSucursal ? "selected" : null)">
                                            @sucursal.SucursalNombre
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" id="IdSucursal" name="IdSucursal" value="@Model.IdSucursal" />
                                <input type="text" class="form-control" value="@Model.SucursalNombre" readonly />
                            }
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 compra-col-fecha">
                        <div class="form-group">
                            <label for="FechaCompra">Fecha</label>
                            <input type="datetime-local"
                                   id="FechaCompra"
                                   name="FechaCompra"
                                   class="form-control"
                                   value="@Model.FechaCompra.ToString("yyyy-MM-ddTHH:mm")" />
                            @Html.Partial("_AdvertenciaPermisoFecha")
                        </div>
                    </div>

                </div>

                <div class="row compra-datos-secundarios-row">
                    <div class="col-12 col-lg-5 compra-col-proveedor">
                        <div class="form-group">
                            <label for="razonSocial">Proveedor <small class="text-muted font-weight-normal compra-proveedor-cuit" id="lblProveedorCuit">@(!string.IsNullOrWhiteSpace(Model.ProveedorCuit) ? ("CUIT: " + Model.ProveedorCuit) : "Sin proveedor seleccionado")</small></label>
                            <div class="input-group">
                                <input type="text" id="razonSocial" class="form-control" value="@Model.ProveedorNombre" placeholder="Seleccione un proveedor" readonly />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-primary" id="btnBuscarProveedor" title="Buscar proveedor (F9)">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="btnLimpiarProveedor">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3 compra-col-remito">
                        <div class="form-group">
                            <label for="NroRemito">Nro.Remito/Factura</label>
                            @Html.TextBoxFor(m => m.NroRemito, new { @class = "form-control", id = "NroRemito", maxlength = 100 })
                        </div>
                    </div>
                    <div class="col-12 col-lg-2 compra-cta-col">
                        <div class="compra-cta-card">
                            <div class="compra-cta-head">
                                <span class="compra-cta-title">Cuenta corriente</span>
                                <div class="custom-control custom-switch compra-cta-switch">
                                    <input type="checkbox" class="custom-control-input" id="EnCtaCte" name="EnCtaCte" value="true" checked="@(Model.EnCtaCte ? "checked" : null)" />
                                    <input type="hidden" name="EnCtaCte" value="false" />
                                    <label class="custom-control-label" for="EnCtaCte"><span class="sr-only">Cuenta corriente</span></label>
                                </div>
                            </div>
                            <small class="text-muted d-block compra-cta-help">Use esta opción si la compra queda pendiente de pago.</small>
                        </div>
                    </div>
                </div>
                </div>

                <hr class="compra-hr-cabecera" />

                <div id="panelLineaCorte" class="compra-linea-panel" style="@(mostrarMediaInicial ? "display:none;" : null)">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 compra-linea-header">
                        <div class="d-flex flex-wrap align-items-center compra-linea-titulo">
                            <h6 class="font-weight-bold text-uppercase text-muted mb-0 mr-3">Agregar producto</h6>
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="chkCargaContinuaProducto" />
                                <label class="custom-control-label" for="chkCargaContinuaProducto" title="Cargar varias veces este producto: tras agregar queda el mismo producto y precio, solo se pide la cantidad">Cargar varias veces</label>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnActivarCapturaRespaldo" title="Guarda una captura de la pantalla completa cada vez que agregás o quitás un producto, como respaldo local por si se corta la luz o se cierra el sistema">
                                <i class="fas fa-shield-alt mr-1"></i> Activar respaldo automático
                            </button>
                            <span class="small text-muted d-none" id="lblCapturaRespaldoActiva" title="Se guarda una captura de la pantalla completa en tu carpeta elegida cada vez que agregás o quitás un producto">
                                <i class="fas fa-shield-alt mr-1 text-success"></i> Respaldo automático activado
                            </span>
                        </div>
                    </div>
                    <div id="panelCargaContinuaProducto" class="alert alert-info py-2 px-3 mb-3 compra-continua-alert" style="display:none;">
                        <div><strong>Producto en carga:</strong> <span id="lblProductoContinuo">-</span></div>
                        <div><strong>Precio compra:</strong> <span id="lblPrecioContinuo">-</span></div>
                    </div>
                    @* Lector de codigo de barra por camara: mismo mecanismo que Movimientos/Stock
                       (BarcodeCodeInput, ver compras.js initScanner), pero con ids propios (compra*)
                       porque esta pantalla puede estar embebida en el POS, que ya tiene #videoScanner,
                       #scannerContainer, #btnScanner y #beep. *@
                    <div class="row">
                        <div class="col-12 scanner-shared-card" id="compraScannerContainer" style="display:none;">
                            <div class="card shadow-sm mb-3">
                                <div class="card-body p-2">
                                    <div class="scanner-wrapper">
                                        <video id="compraVideoScanner" autoplay muted playsinline style="width:100%;height:auto;"></video>
                                        <div class="scanner-line"></div>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between mt-2">
                                        <button type="button" class="btn btn-secondary btn-sm" id="btnCompraFlash">Flash</button>
                                        <button type="button" class="btn btn-warning btn-sm" id="btnCompraLimpiarScanner">Limpiar</button>
                                        <button type="button" class="btn btn-danger btn-sm" id="btnCompraCerrarScanner">Cerrar cámara</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <audio id="compraBeep" src="@Url.Content("~/Content/sounds/focus-beep.wav")" preload="auto"></audio>
                    </div>
                    <div class="row compra-carga-row">
                        <div class="col-12 col-md-3 compra-col-codigo">
                            <div class="form-group">
                                <label for="txtCodigoProducto">Código</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <button type="button" class="btn btn-outline-secondary" id="btnCompraScanner" title="Escanear código de barra">
                                            <i class="fas fa-barcode"></i>
                                        </button>
                                    </div>
                                    <input type="number" id="txtCodigoProducto" class="form-control" min="0" step="1" autocomplete="off" />
                                </div>
                                <small id="compraScannerMsg" class="text-danger d-none"></small>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 compra-col-producto">
                            <div class="form-group">
                                <label for="txtProductoNombre">Producto</label>
                                <div class="input-group">
                                    <input type="hidden" id="txtProductoId" />
                                    <input type="hidden" id="txtPrecioActualProducto" />
                                    <input type="text" id="txtProductoNombre" class="form-control app-product-highlight" readonly />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-primary" id="btnBuscarProducto" title="Buscar producto (F10)">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* Celular: Cantidad, Precio y Subtotal en una sola fila (col-4) para bajar la altura (2026-10-27). *@
                        <div class="col-4 col-md-2 compra-col-cantidad">
                            <div class="form-group">
                                <label for="txtCantKgs">Cantidad</label>
                                <input type="number" id="txtCantKgs" class="form-control" min="0" step="0.01" />
                            </div>
                        </div>
                        <div class="col-4 col-md-2 compra-col-precio">
                            <div class="form-group">
                                <label for="txtPrecioKg">Precio</label>
                                @* Monto con MoneyInputMask (compras.js): "." o "," = coma decimal y puntos de miles automaticos. *@
                                <input type="text" id="txtPrecioKg" class="form-control" inputmode="decimal" autocomplete="off" />
                            </div>
                        </div>
                        @* Campos de los ajustes (Desc./Recargo e IVA): aparecen en la fila de carga, despues de Precio, cuando se
                           enciende su interruptor (compras.js los muestra/oculta con .toggle() por id). Orden = orden del calculo
                           (precio -> descuento/recargo -> IVA -> subtotal) y del Enter (focusNextAfterPrice). En celular
                           (order-last) van al final de la fila y solo se ven con los "Ajustes" desplegados (ver compras-editar.css). *@
                        <div id="panelDescRecargo" class="col-6 col-md-2 order-last order-lg-0 compra-col-desc" style="display:none;">
                            <div class="form-group">
                                <label for="txtDescRecargo">Desc./Rec. %</label>
                                <input type="number" id="txtDescRecargo" class="form-control" step="0.01" value="0" title="Negativo descuenta, positivo recarga." />
                                <small class="form-text text-muted">Negativo descuenta, positivo recarga.</small>
                            </div>
                        </div>
                        <div id="panelIva" class="col-6 col-md-2 order-last order-lg-0 compra-col-iva" style="display:none;">
                            <div class="form-group">
                                <label for="txtIvaCompra">IVA %</label>
                                <input type="number" id="txtIvaCompra" class="form-control" min="0" step="0.01" value="0" />
                            </div>
                        </div>
                        <div class="col-4 col-md-2 compra-col-subtotal">
                            <div class="form-group">
                                <label for="txtSubtotalLinea">Subtotal</label>
                                <input type="text" id="txtSubtotalLinea" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    @* Celular (<768px): las 3 cajas de ajustes quedan plegadas detras del boton "Ajustes" (con un resumen de los
                       ajustes encendidos) y el boton Agregar queda a su lado; .compra-ajustes-abierto las muestra.
                       compras-editar.css ordena las columnas y compras.js (click de #btnToggleAjustesCompra) maneja el boton.
                       En desktop el boton no se ve y las cajas estan siempre visibles. *@
                    <div class="row compra-ajustes-grid mb-3" id="compraAjustesGrid">
                        <div class="col d-md-none compra-ajustes-toggle-col">
                            <button type="button" class="btn btn-outline-secondary compra-ajustes-toggle" id="btnToggleAjustesCompra"
                                    aria-expanded="false" aria-controls="compraAjustesGrid" title="Descuento/recargo, IVA y margen">
                                <span class="compra-ajustes-toggle-texto"><i class="fas fa-sliders-h mr-1"></i> Ajustes</span>
                                <span class="compra-ajustes-resumen" id="lblResumenAjustesCompra"></span>
                                <i class="fas fa-chevron-down compra-ajustes-chevron"></i>
                            </button>
                        </div>
                        <div class="col-12 col-lg-3 compra-ajuste-col">
                            <div class="border rounded p-3 bg-light h-100 compra-ajuste-card">
                                <div class="custom-control custom-switch mb-2">
                                    <input type="checkbox" class="custom-control-input" id="chkAplicarDescRecargo" />
                                    <label class="custom-control-label" for="chkAplicarDescRecargo">Desc./Recargo</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-3 compra-ajuste-col">
                            <div class="border rounded p-3 bg-light h-100 compra-ajuste-card">
                                <div class="custom-control custom-switch mb-2">
                                    <input type="checkbox" class="custom-control-input" id="chkAplicarIva" />
                                    <label class="custom-control-label" for="chkAplicarIva">IVA</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4 compra-ajuste-col">
                            <div class="border rounded p-3 h-100 compra-ajuste-card">
                                <div class="custom-control custom-switch mb-2">
                                    <input type="checkbox" class="custom-control-input" id="chkAplicarPrecioVentaMargen" />
                                    <label class="custom-control-label" for="chkAplicarPrecioVentaMargen">Margen / precio de venta</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2 d-flex align-items-end justify-content-lg-end compra-agregar-col">
                            <button type="button" class="btn btn-primary mt-2 mt-lg-0" id="btnAgregarLineaCorte">
                                <i class="fas fa-plus"></i> Agregar producto
                            </button>
                        </div>
                    </div>

                    @* Margen / precio de venta: franja propia debajo de la fila de carga (no cambia el costo ni el subtotal: es el precio de
                       venta del producto, se decide despues de cargar el costo). Era parte de la ficha del interruptor; mismos ids. En
                       celular se ve solo con los "Ajustes" desplegados (compras-editar.css). *@
                    <div id="panelPrecioVentaMargen" style="display:none;">
                        <div class="alert alert-light border py-2 px-3 mb-2">
                            Precio actual:
                            <strong id="lblPrecioActualProducto">-</strong>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="optMargen" name="modoPrecioVenta" class="custom-control-input" checked />
                            <label class="custom-control-label" for="optMargen">Margen %</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="optPrecioVenta" name="modoPrecioVenta" class="custom-control-input" />
                            <label class="custom-control-label" for="optPrecioVenta">Nuevo precio venta</label>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12 col-md-4">
                                <div class="form-group mb-md-0">
                                    <label for="txtMargen">Margen</label>
                                    <input type="number" id="txtMargen" class="form-control" step="0.01" />
                                </div>
                            </div>
                            <div class="col-12 col-md-5">
                                <div class="form-group mb-0">
                                    <label for="txtPrecioVenta">Precio venta</label>
                                    <input type="number" id="txtPrecioVenta" class="form-control" min="0" step="0.01" />
                                    <small id="lblAdvertenciaPrecioVenta" class="form-text text-danger" style="display:none;">El nuevo precio de venta es menor al precio actual del producto.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div id="panelLineaMediaRes" class="compra-linea-panel" style="@(mostrarMediaInicial ? null : "display:none;")">
                    <div class="d-flex flex-wrap align-items-center mb-3 compra-linea-header">
                        <h6 class="font-weight-bold text-uppercase text-muted mb-0 mr-3">Agregar media</h6>
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="chkCargaContinuaMedia" />
                            <label class="custom-control-label" for="chkCargaContinuaMedia">Cargar varias medias con el mismo precio</label>
                        </div>
                    </div>
                    <div id="panelCargaContinuaMedia" class="alert alert-info py-2 px-3 mb-3 compra-continua-alert" style="display:none;">
                        <div><strong>Precio media en carga:</strong> <span id="lblPrecioMediaContinuo">-</span></div>
                    </div>
                    <div class="row compra-media-row">
                        <input type="hidden" id="txtNroTropa" />
                        <div class="col-6 col-md-4 compra-col-media-kgs">
                            <div class="form-group">
                                <label for="txtKgMedia">Kg media</label>
                                <input type="number" id="txtKgMedia" class="form-control" min="0" step="0.01" />
                            </div>
                        </div>
                        <div class="col-6 col-md-4 compra-col-media-precio">
                            <div class="form-group">
                                <label for="txtPrecioMedia">Precio media</label>
                                <input type="number" id="txtPrecioMedia" class="form-control" min="0" step="0.01" />
                            </div>
                        </div>
                        <div class="col-12 col-md-2 compra-col-media-add">
                            <div class="form-group mb-0 compra-add-action-group">
                                <label class="d-none d-md-block">&nbsp;</label>
                                <button type="button"
                                        class="btn btn-primary compra-icon-btn"
                                        id="btnAgregarLineaMediaRes"
                                        title="Agregar media"
                                        aria-label="Agregar media">
                                    <i class="fas fa-plus-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row compra-workspace-row">
                    <div class="col-12 col-lg-9">
                @* Solo celular (<768px): en la lista no hay encabezado "#" para tocar, el orden se elige aca. Usa el mismo
                   estado que el encabezado (compras.js, state.sortKey / state.sortDirection; arranca en "ultimos primero"). *@
                <div class="d-flex d-md-none align-items-center mb-2 compra-lineas-toolbar">
                    <span class="font-weight-bold">Productos</span>
                    <select id="ordenLineasCompra" class="form-control form-control-sm compra-orden-celular"
                            data-edit-readonly-ignore="true" aria-label="Ordenar las líneas">
                        <option value="desc">Últimos primero</option>
                        <option value="asc">Primeros primero</option>
                    </select>
                </div>
                @* En celular las lineas son una lista compacta (tabla-cards-lista-edicion, wwwroot/Content/css/tabla-cards.css):
                   las clases de cada celda las pone renderLineas() en compras.js, que reemplaza las filas de Razor al iniciar.
                   En desktop: un renglon por item, P. venta y Margen despues del Total con marca propia, numeros en formato
                   argentino (compras-editar.css, "Compras/Editar: 13 items" en docs/DECISIONS.md). *@
                <div class="table-responsive mb-3 compra-tabla-wrap">
                    <table class="table table-hover table-sm tabla-cards tabla-cards-lista tabla-cards-lista-edicion tabla-items" id="tablaLineasCompra">
                        <thead class="thead-light">
                            <tr>
                                @* Encabezados con data-sort-key ordenan la tabla (orden-tabla.js). El codigo va dentro de la celda Detalle, por eso
                                   Detalle y Codigo son dos enlaces en el mismo encabezado (mismo patron que Stock/Editar). *@
                                <th style="width: 2.8rem;" data-sort-key="orden">#</th>
                                <th>
                                    <a href="#" class="js-orden-link" data-sort-key="detalle">Detalle</a>
                                    <span aria-hidden="true">·</span>
                                    <a href="#" class="js-orden-link" data-sort-key="codigo">Código</a>
                                </th>
                                <th class="text-right" data-sort-key="cantidad">Cantidad</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Total</th>
                                @* P. venta y Margen NO forman parte de la compra: actualizan el precio de venta del producto. Por eso van despues
                                   del Total y con una marca sutil (fondo tenue + linea punteada, ver compras-editar.css). *@
                                <th class="text-right compra-col-venta compra-col-venta-inicio" title="No forma parte de la compra: actualiza el precio de venta del producto"><i class="fas fa-tag mr-1" aria-hidden="true"></i>P. venta</th>
                                <th class="text-right compra-col-venta" title="No forma parte de la compra: margen del nuevo precio de venta">Margen</th>
                                <th style="width: 2.2rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Lineas != null && Model.Lineas.Count > 0)
                            {
                                for (var i = 0; i < Model.Lineas.Count; i++)
                                {
                                    var linea = Model.Lineas[i];
                                    var numeroLinea = i + 1;
                                    if (linea.EsMediaRes)
                                    {
                                        <tr>
                                            <td class="text-center font-weight-bold">@numeroLinea</td>
                                            <td class="compra-detalle-cell"><strong>Tropa:</strong> @(string.IsNullOrWhiteSpace(linea.NroTropa) ? "-" : linea.NroTropa)</td>
                                            <td class="text-right">@linea.KgMedia.ToString("N2", culturaAr)</td>
                                            <td class="text-right">@linea.PrecioMedia.ToString("N2", culturaAr)</td>
                                            <td class="text-right compra-col-total">@linea.TotalLinea.ToString("N2", culturaAr)</td>
                                            <td class="text-right compra-col-venta compra-col-venta-inicio">-</td>
                                            <td class="text-right compra-col-venta">-</td>
                                            <td></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td class="text-center font-weight-bold">@numeroLinea</td>
                                            <td class="compra-detalle-cell">
                                                <strong>@linea.CorteNombre</strong>
                                                <small class="text-muted">Cód. @(linea.Codigo.HasValue ? linea.Codigo.Value.ToString() : "")@(linea.Balanza ? " | Balanza" : "")</small>
                                            </td>
                                            <td class="text-right">@linea.CantKgs.ToString("N2", culturaAr)</td>
                                            <td class="text-right">@linea.PrecioKg.ToString("N2", culturaAr)</td>
                                            <td class="text-right compra-col-total">@linea.TotalLinea.ToString("N2", culturaAr)</td>
                                            <td class="text-right compra-col-venta compra-col-venta-inicio">@(linea.PrecioVenta > 0 ? linea.PrecioVenta.ToString("N2", culturaAr) : "-")</td>
                                            <td class="text-right compra-col-venta">@(linea.Margen != 0 ? linea.Margen.ToString("N2", culturaAr) : "-")</td>
                                            <td></td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr class="js-empty-row">
                                    <td colspan="8" class="text-center text-muted">Todavía no hay líneas cargadas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                    </div>

                    <div class="col-12 col-lg-3">
                        <div class="compra-sidebar-stack">
                        @if (permiteMediaRes)
                        {
                            <div class="border rounded p-3 bg-white compra-medias-box">
                                <div class="form-group mb-0">
                                    <label for="CantMediasMediaRes">Cantidad medias reses</label>
                                    <input type="number" class="form-control js-cant-medias-visible" id="CantMediasMediaRes" value="@(Model.CantMedias.HasValue ? Model.CantMedias.Value.ToString() : "")" min="0" step="1" />
                                </div>
                            </div>
                        }
                        <div class="border rounded p-3 bg-light compra-totales-box">
                            <div class="d-flex justify-content-between">
                                <span>Items</span>
                                <strong id="totalItems">@Model.CantItems</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total cantidad</span>
                                <strong id="totalKg">@Model.TotalKg.ToString("N2", culturaAr)</strong>
                            </div>
                            <div class="d-flex justify-content-between compra-total-principal">
                                <span>Total compra</span>
                                <strong id="totalImporte">@Model.TotalImporte.ToString("N2", culturaAr)</strong>
                            </div>
                        </div>
                        <div class="border rounded p-3 bg-white compra-observaciones-box">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                                <label for="Observaciones" class="mb-0 font-weight-bold">Observaciones</label>
                                <small class="text-muted">Opcional</small>
                            </div>
                            @Html.TextAreaFor(m => m.Observaciones, 2, 1, new { @class = "form-control", id = "Observaciones", placeholder = "Dato adicional si hace falta." })
                        </div>
                        @if (Model.EsEdicion)
                        {
                            <div class="small text-muted compra-meta-box">
                                <span class="d-block">Creado: @Model.Creado por @Model.CreadoPor</span>
                                <span class="d-block">Actualizado: @Model.Actualizado por @Model.ActualizadoPor</span>
                            </div>
                        }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between flex-wrap mt-4 compra-actions-bar">
                    <div class="mb-2 d-flex align-items-center flex-wrap">
                        @if (borradorGenericoHabilitado)
                        {
                            <button type="button" class="btn btn-outline-secondary" id="btnVerBorradoresCompras">
                                <i class="fas fa-clock-rotate-left mr-1"></i> Compras sin guardar
                                <span id="badgeBorradoresGenerico" class="badge badge-warning d-none ml-1">0</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarBorrador">
                                Limpiar borrador
                            </button>
                        }
                        <small class="text-muted ml-0 ml-md-3 mt-2 mt-md-0 compra-shortcuts-help">Atajos: F9 proveedor, F10 producto, Alt+G guardar, Alt+Enter guardar, Alt+C cancelar.</small>
                    </div>
                    <div class="mb-2">
                        @if (Model.EsEdicion)
                        {
                            <button type="button"
                                    class="btn btn-primary mr-2"
                                    id="btnHabilitarEdicionCompra"
                                    data-edit-readonly-ignore="true">
                                <i class="fas fa-edit mr-1"></i> Modificar
                            </button>
                        }
                        @* Eliminar: pantalla completa y modal del POS (compras propias de la caja, ver ComprasController.CrearBotonEliminar);
                           no en el modal de la cuenta corriente. *@
                        @if ((!embebido || Model.DesdePos) && ViewBag.EliminarRegistro is WebCore.Models.EliminarRegistroVm vmEliminarCompra)
                        {
                            <partial name="_EliminarRegistro" model="vmEliminarCompra" />
                        }
                        @if (!embebido)
                        {
                            <a href="@Url.Action("Index", "Compras")" class="btn btn-outline-secondary" id="btnCancelarCompra">
                                Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-success @(Model.EsEdicion ? "d-none" : "")" id="btnGuardarCompra">
                            <i class="fas fa-save"></i> Guardar compra
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@* asp-append-version (antes "?v=1" fijo): sin esto el celular seguia con el CSS viejo en cache (2026-10-27). *@
<link rel="stylesheet" href="@Url.Content("~/Content/css/compras-editar.css")" asp-append-version="true" />
@* En el POS (DesdePos) no hay _Layout, que es quien carga tabla-cards.css: sin esta hoja los textos de apoyo de la lista de lineas
   (".cc-solo-card", pensados para celular) se ven tambien en desktop (2026-10-28). *@
@if (Model.DesdePos)
{
    <link rel="stylesheet" href="@Url.Content("~/Content/css/tabla-cards.css")" asp-append-version="true" />
}

<div id="contenedorModalPersonaCompra"></div>
@if (borradorGenericoHabilitado && !Model.DesdePos)
