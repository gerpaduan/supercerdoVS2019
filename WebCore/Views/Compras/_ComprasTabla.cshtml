@model WebCore.Models.CompraIndexVm
@using System
@using System.Collections.Generic
@using System.Data

@{
    var dt = Model != null ? Model.Compras : null;
    // Dos condiciones distintas (2026-09-15, ver docs/DECISIONS.md): la columna "TipoCompra" exige
    // EmpresaPropia Y EsCarniceria juntas (ComprasController.MostrarTipoCompraEnListado) -- solo
    // tiene sentido listar el tipo de cada compra para la empresa que realmente puede generar
    // ambos. "Medias Reses" sigue el flag mas amplio de siempre (EsCarniceria||EmpresaPropia,
    // ViewBag.PermiteMediaRes) -- antes se renderizaba siempre sin ningun condicional (gap real).
    bool mostrarTipoCompra = ViewBag.MostrarTipoCompraEnListado != null && (bool)ViewBag.MostrarTipoCompraEnListado;
    bool mostrarMediasReses = ViewBag.PermiteMediaRes != null && (bool)ViewBag.PermiteMediaRes;
    // Comprobantes del proveedor (solo Postgres): columna Factura y, con 2 o mas titulares propios, columna Titular.
    // Ver docs/DECISIONS.md (2026-11-09, "Compras: titular propio y comprobantes del proveedor").
    bool mostrarFactura = ViewBag.ComprobantesDisponibles != null && (bool)ViewBag.ComprobantesDisponibles
        && dt != null && dt.Columns.Contains("estadoFactura");
    bool mostrarTitular = mostrarFactura && ViewBag.MostrarTitulares != null && (bool)ViewBag.MostrarTitulares;
    int totalColumnas = 7 + (mostrarTipoCompra ? 1 : 0) + (mostrarMediasReses ? 1 : 0) + (mostrarFactura ? 1 : 0) + (mostrarTitular ? 1 : 0);
}

@* En celular (<768px) cada compra se muestra como tarjeta (CSS compartido wwwroot/Content/css/tabla-cards.css):
   el proveedor encabeza la tarjeta y la fila de detalle desplegable queda pegada debajo (cc-fila-detalle). *@
<div class="table-responsive tabla-full">
    <table class="table table-bordered table-hover mb-0 tabla-cards">
        <thead class="thead-light">
            <tr>
                <th>Fecha</th>
                <th>Nro.Remito/Factura</th>
                <th>Proveedor</th>
                @if (mostrarTipoCompra)
                {
                    <th>TipoCompra</th>
                }
                <th class="text-right">Un./Kg.</th>
                @if (mostrarMediasReses)
                {
                    <th class="text-right">Medias Reses</th>
                }
                <th class="text-right">Total</th>
                @if (mostrarTitular)
                {
                    <th>Titular</th>
                }
                @if (mostrarFactura)
                {
                    <th>Factura</th>
                }
                <th>Sucursal</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (dt == null || dt.Rows.Count == 0)
            {
                <tr>
                    <td colspan="@totalColumnas" class="text-center text-muted py-4">No se encontraron compras para el filtro seleccionado.</td>
                </tr>
            }
            else
            {
                foreach (DataRow row in dt.Rows)
                {
                    int idCompra = Convert.ToInt32(row["idCompra"]);
                    DateTime? fechaCompra = row["fechaCompra"] == DBNull.Value ? (DateTime?)null : Convert.ToDateTime(row["fechaCompra"]);
                    float cantKg = row["cantKg"] == DBNull.Value ? 0f : Convert.ToSingle(row["cantKg"]);
                    float totalS = row["totalS"] == DBNull.Value ? 0f : Convert.ToSingle(row["totalS"]);
                    int cantMedias = row.Table.Columns.Contains("cantMedias") && row["cantMedias"] != DBNull.Value ? Convert.ToInt32(row["cantMedias"]) : 0;
                    string estado = row.Table.Columns.Contains("estado") && row["estado"] != DBNull.Value ? row["estado"].ToString() : "";
                    bool anulado = !string.IsNullOrWhiteSpace(estado) && !estado.Equals("Alta", StringComparison.OrdinalIgnoreCase);
                    string detailId = "detCompra_" + idCompra;

                    // Factura del proveedor: solo las compras de cortes o media res la llevan (las operaciones de stock no).
                    bool admiteComprobantes = mostrarFactura
                        && Negocio.ValidacionComprobanteCompra.TipoCompraAdmiteComprobantes(row["tipoCompra"] == DBNull.Value ? "" : Convert.ToString(row["tipoCompra"]));
                    string estadoFactura = admiteComprobantes && row["estadoFactura"] != DBNull.Value ? Convert.ToString(row["estadoFactura"]) : "";
                    string tipoFactura = admiteComprobantes && row["tipoFactura"] != DBNull.Value ? Convert.ToString(row["tipoFactura"]) : "";
                    string numeroFactura = admiteComprobantes && row["numeroFactura"] != DBNull.Value ? Convert.ToString(row["numeroFactura"]) : "";
                    decimal facturadoNeto = admiteComprobantes && row["facturadoNeto"] != DBNull.Value ? Convert.ToDecimal(row["facturadoNeto"]) : 0m;
                    bool conNotaCredito = admiteComprobantes && row["tieneNC"] != DBNull.Value && Convert.ToBoolean(row["tieneNC"]);
                    bool conNotaDebito = admiteComprobantes && row["tieneND"] != DBNull.Value && Convert.ToBoolean(row["tieneND"]);
                    string titularNombre = mostrarTitular && row["titularNombre"] != DBNull.Value ? Convert.ToString(row["titularNombre"]) : "";

                    <tr class="@(anulado ? "table-danger" : "")">
                        <td data-label="Fecha">@(fechaCompra.HasValue ? fechaCompra.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                        <td data-label="Nro. remito/factura">@row["nroRemito"]</td>
                        <td class="cc-titulo cc-titulo-flex">@row["razonSocial"]<span class="cc-solo-card cc-titulo-extra" title="Número de compra">#@idCompra</span></td>
                        @if (mostrarTipoCompra)
                        {
                            <td data-label="Tipo de compra">@row["tipoCompra"]</td>
                        }
                        <td class="text-right" data-label="Un./Kg.">@cantKg.ToString("N2")</td>
                        @if (mostrarMediasReses)
                        {
                            <td class="text-right" data-label="Medias reses">@cantMedias</td>
                        }
                        <td class="text-right cc-destacado" data-label="Total">@totalS.ToString("N2")</td>
                        @if (mostrarTitular)
                        {
                            <td data-label="Titular">@(admiteComprobantes ? titularNombre : "")</td>
                        }
                        @if (mostrarFactura)
                        {
                            <td data-label="Factura" class="compras-col-factura">
                                @if (admiteComprobantes)
                                {
                                    if (estadoFactura == Entidades.EstadoFacturaCompra.Facturada)
                                    {
                                        <span class="badge badge-success">Facturada</span>
                                        <div class="small text-nowrap">@tipoFactura @numeroFactura</div>
                                        <div class="small text-muted text-nowrap">
                                            Neto $ @facturadoNeto.ToString("N2")
                                            @if (conNotaCredito) { <span class="badge badge-danger" title="Tiene nota de crédito">+NC</span> }
                                            @if (conNotaDebito) { <span class="badge badge-info" title="Tiene nota de débito">+ND</span> }
                                        </div>
                                    }
                                    else if (estadoFactura == Entidades.EstadoFacturaCompra.Pendiente)
                                    {
                                        <span class="badge badge-warning">Pendiente</span>
                                    }
                                    else if (estadoFactura == Entidades.EstadoFacturaCompra.NoLleva)
                                    {
                                        <span class="badge badge-secondary">No lleva</span>
                                    }
                                    else
                                    {
                                        @* Compra anterior al control de facturas: sin dato (no se llena la lista de pendientes con historia). *@
                                        <span class="text-muted small">Sin dato</span>
                                    }
                                }
                            </td>
                        }
                        <td data-label="Sucursal">@row["sucursal"]</td>
                        <td class="text-center text-nowrap cc-acciones">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary btn-detalles-compra"
                                    data-target="#@detailId"
                                    aria-expanded="false"
                                    aria-controls="@detailId"
                                    title="Ver detalle">
                                <i class="fas fa-angle-down"></i><span class="cc-solo-card">Detalle</span>
                            </button>
                            @if (admiteComprobantes && !anulado)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-comprobantes-compra"
                                        data-id="@idCompra" title="Comprobantes del proveedor (factura, notas de crédito y débito)">
                                    <i class="fas fa-file-invoice"></i><span class="cc-solo-card">Comprobantes</span>
                                </button>
                            }
                            <a class="btn btn-sm btn-outline-primary"
                               href="@Url.Action("ModificarCompra", "Compras", new { id = idCompra, origen = "layout" })"
                               title="Ver compra"
                               aria-label="Ver compra">
                                <i class="fas fa-eye"></i><span class="cc-solo-card">Ver compra</span>
                            </a>
                        </td>
                    </tr>
                    <tr class="tr-detalles-compra cc-fila-detalle">
                        <td colspan="@totalColumnas" class="p-0">
                            <div id="@detailId" class="collapse compra-detalle-collapse">
                                <div class="p-3 bg-light border-top compra-detalle-body">
                                    <div class="compra-detalle-lazy"
                                         data-loaded="false"
                                         data-url="@Url.Action("Detalle", "Compras", new { idCompra = idCompra })">
                                        <div class="text-muted">Presioná <strong>Detalles</strong> para cargar la información.</div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
