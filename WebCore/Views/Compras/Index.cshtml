@model WebCore.Models.CompraIndexVm

@{
    ViewBag.Title = "Compras";

    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    int idSucursal = ViewBag.IdSucursal != null ? (int)ViewBag.IdSucursal : -1;
    string tipoCompra = ViewBag.TipoCompra as string ?? "Todos";
    string texto = ViewBag.Texto as string ?? "";
    // Filtro de proveedor (selector multi-seleccion): texto libre (solo sin seleccion) o IDs exactos + nombres para pintar el input.
    string proveedorTexto = ViewBag.Proveedor as string ?? "";
    string idsProveedor = ViewBag.IdsProveedor as string ?? "";
    var proveedoresSeleccionados = ViewBag.ProveedoresSeleccionados as List<WebCore.Services.FiltroPickerItem> ?? new List<WebCore.Services.FiltroPickerItem>();
    DateTime fechaDesde = ViewBag.FechaDesde != null ? (DateTime)ViewBag.FechaDesde : DateTime.Today;
    DateTime fechaHasta = ViewBag.FechaHasta != null ? (DateTime)ViewBag.FechaHasta : DateTime.Today;
    bool permiteMediaRes = ViewBag.PermiteMediaRes != null && (bool)ViewBag.PermiteMediaRes;
    // Pedido 2026-09-15: a diferencia de permiteMediaRes (EsCarniceria||EmpresaPropia), el filtro
    // "Tipo compra" exige las DOS condiciones juntas -- ver ComprasController.MostrarTipoCompraEnListado.
    bool mostrarTipoCompra = ViewBag.MostrarTipoCompraEnListado != null && (bool)ViewBag.MostrarTipoCompraEnListado;
    int totalCantMedias = ViewBag.TotalCantMedias != null ? (int)ViewBag.TotalCantMedias : 0;
    float totalKg = ViewBag.TotalKg != null ? (float)ViewBag.TotalKg : 0f;
    float totalS = ViewBag.TotalS != null ? (float)ViewBag.TotalS : 0f;
    string successMessage = TempData["ComprasSuccessMessage"] as string ?? "";
}

<div class="container-fluid compras-index-page">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div id="comprasSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @* Bloque superior: en escritorio (>= 1200 px) los filtros van en una sola fila y debajo una barra con
       totales, estado, "Vista completa" y botones. Por debajo de 1200 px es un contenedor de bloque que
       conserva el orden de siempre (acciones, filtros, totales, vista completa). *@
    <div class="compras-top">
    <div class="d-flex flex-wrap align-items-center mb-3 compras-acciones-header">
        <a class="btn btn-success mt-2 mt-md-0 compras-btn-accion" href="@Url.Action("NuevaCompra", "Compras", new { origen = "layout" })" id="btnNuevaCompraIndex">
            <i class="fas fa-plus mr-1"></i> Nueva compra
        </a>
        <a class="btn btn-outline-primary mt-2 mt-md-0 ml-md-2 compras-btn-accion" href="@Url.Action("Lineas", "Compras", new { idSucursal = idSucursal, tipoCompra = tipoCompra, texto = texto, proveedor = proveedorTexto, idsProveedor = idsProveedor, fechaDesde = fechaDesde.ToString("yyyy-MM-dd"), fechaHasta = fechaHasta.ToString("yyyy-MM-dd") })" id="btnVerLineasComprasIndex">
            <i class="fas fa-stream mr-1"></i> Ver lineas
        </a>
        @if (ViewBag.PuedeVerEliminados == true)
        {
            <a class="btn btn-outline-danger mt-2 mt-md-0 ml-md-2 compras-btn-accion" href="@Url.Action("Index", "RegistrosEliminados", new { modulo = "COMPRA" })" id="btnVerEliminadosComprasIndex">
                <i class="fas fa-trash-alt mr-1"></i> Ver eliminados
            </a>
        }
    </div>

    <div class="card shadow-sm mb-3 compras-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Compras")">
                <div class="compras-filtros-stack">
                    <div id="alertaFiltrosPendientesCompras" class="alert alert-warning d-none mb-0" role="alert">
                        Cambiaste las fechas. Presioná <strong>Buscar</strong> para actualizar los resultados.
                    </div>

                    <div class="compras-filtros-row compras-filtros-row-fechas">
                        <div class="form-group mb-0 compras-f-desde">
                            <label class="compras-filtro-label">Desde</label>
                            <input type="date" id="fechaDesde" name="fechaDesde" value="@fechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
                            @Html.Partial("_AdvertenciaPermisoFecha")
                        </div>

                        <div class="form-group mb-0 compras-f-hasta">
                            <label class="compras-filtro-label">Hasta</label>
                            <input type="date" name="fechaHasta" value="@fechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>

                        <div class="form-group mb-0 compras-filtro-accion">
                            <label class="compras-filtro-label d-none d-lg-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block" id="btnBuscarCompras">
                                <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                            </button>
                        </div>
                    </div>

                    <div class="compras-filtros-row compras-filtros-row-sucursal">
                        <div class="form-group mb-0 compras-filtro-sucursal">
                            <label class="compras-filtro-label">Sucursal</label>
                            <select name="idSucursal" id="idSucursalCompras" class="form-control">
                                <option value="-1" selected="@(idSucursal == -1 ? "selected" : null)">Todas</option>
                                @foreach (var s in sucursales)
                                {
                                    <option value="@s.IdSucursal" selected="@(s.IdSucursal == idSucursal ? "selected" : null)">@s.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="compras-filtros-row compras-filtros-row-busqueda">
                        <div class="form-group mb-0 compras-f-tipo">
                            <label class="compras-filtro-label">Tipo compra</label>
                            @if (mostrarTipoCompra)
                            {
                                <select name="tipoCompra" id="tipoCompraCompras" class="form-control">
                                    <option value="Todos" selected="@(tipoCompra == "Todos" ? "selected" : null)">Todos</option>
                                    <option value="Media Res" selected="@(tipoCompra == "Media Res" ? "selected" : null)">Media Res</option>
                                    <option value="Cortes" selected="@(tipoCompra == "Cortes" ? "selected" : null)">Cortes</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" name="tipoCompra" value="Todos" />
                                <input type="text" class="form-control" value="Productos" readonly />
                            }
                        </div>

                        <div class="form-group mb-0 compras-f-proveedor">
                            <label class="compras-filtro-label">Proveedor</label>
                            @* Selector multi-seleccion (filtro-picker.js): F9 busca proveedores; con seleccion filtra por ID exacto
                               (el hidden idsProveedor viaja en el form); sin seleccion, coincidencia por razon social como siempre. *@
                            <input type="text" id="proveedorCompras" name="proveedor" value="@proveedorTexto" class="form-control" autocomplete="off" placeholder="Razón social del proveedor"
                                   data-filtro-picker="proveedor" data-filtro-picker-tecla="F9" data-ids-name="idsProveedor"
                                   data-ids="@idsProveedor" data-items="@WebCore.Services.FiltroPickerService.ItemsAJson(proveedoresSeleccionados)" />
                        </div>

                        <div class="form-group mb-0 compras-f-descripcion">
                            <label class="compras-filtro-label">Descripcion</label>
                            <input type="text" name="texto" value="@texto" class="form-control" autocomplete="off" placeholder="Proveedor, documento, observaciones..." />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Estado de la busqueda: vive fuera del form para ocupar un lugar en la barra de escritorio.
       En escritorio tambien avisa "Cambiaste las fechas" (ahi se oculta la alerta amarilla). *@
    <div id="estadoBusquedaCompras" class="compras-estado text-muted small mb-2">Resultados actualizados.</div>

    <div class="row mb-3 compras-totales">
        @if (permiteMediaRes)
        {
            <div class="col-12 col-md-4 mb-2">
                <div class="card border-left-info shadow-sm h-100 index-total-card">
                    <div class="card-body">
                        <div class="index-total-label text-xs font-weight-bold text-info text-uppercase mb-1">Cant. Medias</div>
                        <div class="index-total-value font-weight-bold text-gray-800">@totalCantMedias</div>
                    </div>
                </div>
            </div>
        }
        <div class="col-12 col-md-4 mb-2">
            <div class="card border-left-primary shadow-sm h-100 index-total-card">
                <div class="card-body">
                    <div class="index-total-label text-xs font-weight-bold text-primary text-uppercase mb-1">Total Un./Kg.</div>
                    <div class="index-total-value font-weight-bold text-gray-800">@totalKg.ToString("N3")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="card border-left-success shadow-sm h-100 index-total-card">
                <div class="card-body">
                    <div class="index-total-label text-xs font-weight-bold text-success text-uppercase mb-1">Total</div>
                    <div class="index-total-value font-weight-bold text-gray-800">@totalS.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end align-items-center mb-2 compras-vista-completa">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="switchVistaCompletaCompras">
            <label class="custom-control-label" for="switchVistaCompletaCompras">Vista completa</label>
        </div>
    </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @Html.Partial("~/Views/Compras/_ComprasTabla.cshtml", Model)
        </div>
    </div>
</div>

<style>
    .compras-filtros-card {
        border: 1px solid #e9ecef;
        border-radius: .75rem;
        font-size: .9rem;
    }

    .compras-index-page .card-body {
        padding: .85rem 1rem;
    }

    .compras-filtros-card .card-body {
        padding: .72rem .85rem;
    }

    .compras-filtros-stack {
        display: grid;
        gap: .65rem;
    }

    .compras-filtros-row {
        display: grid;
        gap: .65rem;
    }

    .compras-filtro-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .18rem;
    }

    .compras-filtros-card .form-control,
    .compras-filtros-card .btn {
        font-size: .87rem;
        min-height: 2.65rem;
        border-radius: .55rem;
        padding: .32rem .62rem;
    }

    .compras-acciones-header {
        justify-content: flex-start;
    }

    .compras-btn-accion {
        width: 100%;
        min-height: 2.1rem;
        font-size: .82rem;
        padding: .24rem .58rem;
        border-radius: .5rem;
    }

    .compras-filtros-card .alert,
    .compras-filtros-card .small,
    .compras-filtros-card .text-muted,
    .compras-filtros-card .btn-buscar-texto {
        font-size: .8rem !important;
    }

    .compras-index-page .tabla-full .table {
        font-size: .84rem;
    }

    .compras-index-page .tabla-full .table th,
    .compras-index-page .tabla-full .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .compras-index-page .tabla-full .table thead th,
    .compras-index-page .tabla-full .table > thead > tr > th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    .compras-index-page .tabla-full .btn-sm {
        padding: .18rem .42rem;
        line-height: 1.15;
    }

    @@media (min-width: 1200px) {
        .compras-index-page .mb-3 {
            margin-bottom: .85rem !important;
        }

        .compras-acciones-header {
            justify-content: flex-end;
        }

        .compras-btn-accion {
            width: auto;
        }

        .compras-index-page .compras-filtros-card .card-body {
            padding: .65rem .8rem;
        }

        .compras-filtros-row-fechas {
            grid-template-columns: 1.15fr 1.15fr 140px;
            align-items: end;
        }

        .compras-filtro-sucursal {
            max-width: 420px;
        }

        .compras-filtros-row-busqueda {
            grid-template-columns: .9fr 1.2fr 1.3fr;
        }

        .compras-filtros-card .form-control,
        .compras-filtros-card .btn {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
        }

        .compras-index-page .tabla-full .table {
            font-size: .81rem;
        }

        .compras-index-page .tabla-full .table thead th,
        .compras-index-page .tabla-full .table > thead > tr > th {
            font-size: .69rem !important;
        }

        /* ---- Escritorio compacto (pedido 2026-10-30): filtros en UNA fila y debajo una barra con
           totales, estado, "Vista completa" y botones. Todos los selectores llevan "body.app-shell"
           porque ui-refresh.css fija min-height 2.75rem en .form-control y gaps/paddings con esa
           especificidad: sin el prefijo no pisan. ---- */
        body.app-shell .compras-index-page .compras-top {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .5rem .75rem;
            margin-bottom: .6rem;
        }

        /* Los hijos directos traen margenes de pantalla angosta (mb-2/mb-3): en la barra los maneja el gap. */
        body.app-shell .compras-index-page .compras-top > * {
            margin-bottom: 0 !important;
        }

        body.app-shell .compras-index-page .compras-top > .compras-filtros-card {
            order: 0;
            flex: 0 0 100%;
        }

        body.app-shell .compras-index-page .compras-filtros-card .card-body {
            padding: .5rem .65rem;
        }

        /* Fila unica de filtros. Anchos MINIMOS pedidos: fechas siempre completas (8.6rem), proveedor >= 15
           caracteres (15ch + relleno + botones limpiar/lupa) y descripcion >= 10 (10ch + relleno).
           "ch" se mide con la letra del propio grid (.84rem, igual que los controles). Lo que sobra
           se reparte entre Proveedor y Descripcion. */
        body.app-shell .compras-index-page .compras-filtros-stack {
            display: grid;
            grid-template-columns: 8.6rem 8.6rem 7.5rem 6.5rem minmax(calc(15ch + 5.6rem), 1.2fr) minmax(calc(10ch + 1.2rem), 1fr) 5.5rem;
            gap: .5rem;
            align-items: start;
            font-size: .84rem;
        }

        /* Las tres filas de la version angosta se disuelven: sus campos pasan a ser celdas de la fila unica. */
        body.app-shell .compras-index-page .compras-filtros-row {
            display: contents;
        }

        /* En escritorio el aviso de fechas va en la barra (Buscar ambar + texto de estado), no en una alerta que empuja todo. */
        body.app-shell .compras-index-page #alertaFiltrosPendientesCompras {
            display: none !important;
        }

        body.app-shell .compras-index-page .compras-f-desde { grid-column: 1; grid-row: 1; }
        body.app-shell .compras-index-page .compras-f-hasta { grid-column: 2; grid-row: 1; }
        body.app-shell .compras-index-page .compras-filtro-sucursal { grid-column: 3; grid-row: 1; max-width: none; }
        body.app-shell .compras-index-page .compras-f-tipo { grid-column: 4; grid-row: 1; }
        body.app-shell .compras-index-page .compras-f-proveedor { grid-column: 5; grid-row: 1; min-width: 0; }
        body.app-shell .compras-index-page .compras-f-descripcion { grid-column: 6; grid-row: 1; min-width: 0; }
        body.app-shell .compras-index-page .compras-filtro-accion { grid-column: 7; grid-row: 1; }

        body.app-shell .compras-index-page .compras-filtros-card .compras-filtro-label {
            font-size: .68rem;
            margin-bottom: .12rem;
        }

        /* Misma altura para campos y botones. Buscar conserva su label vacio (&nbsp;) para quedar alineado con el resto. */
        body.app-shell .compras-index-page .compras-filtros-card .form-control,
        body.app-shell .compras-index-page .compras-filtros-card .btn {
            height: 1.95rem;
            min-height: 1.95rem;
            font-size: .84rem;
            padding: .15rem .5rem;
            border-radius: .5rem;
            line-height: 1.2;
        }

        body.app-shell .compras-index-page .compras-filtros-card .filtro-picker-btn {
            padding: 0 .5rem;
        }

        /* Barra inferior: totales | estado (flexible) | vista completa | botones. Si no entra, baja de renglon. */
        body.app-shell .compras-index-page .compras-totales {
            order: 1;
            flex-wrap: nowrap;
            margin: 0 !important;
        }

        body.app-shell .compras-index-page .compras-totales > [class*="col-"] {
            flex: 0 0 auto;
            width: auto;
            max-width: none;
            padding: 0 .4rem 0 0;
        }

        body.app-shell .compras-index-page .compras-totales .index-total-card .card-body {
            display: flex;
            align-items: baseline;
            gap: .45rem;
            padding: .28rem .65rem;
        }

        body.app-shell .compras-index-page .compras-totales .index-total-label {
            margin: 0 !important;
            white-space: nowrap;
        }

        body.app-shell .compras-index-page .compras-totales .index-total-value {
            white-space: nowrap;
        }

        body.app-shell .compras-index-page .compras-estado {
            order: 2;
            flex: 1 1 8rem;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: .78rem !important;
        }

        body.app-shell .compras-index-page .compras-estado.compras-estado-pendiente {
            color: #b45309 !important;
            font-weight: 600;
        }

        html.dark-mode body.app-shell .compras-index-page .compras-estado.compras-estado-pendiente {
            color: #fbbf24 !important;
        }

        body.app-shell .compras-index-page .compras-vista-completa {
            order: 3;
            white-space: nowrap;
            font-size: .84rem;
        }

        body.app-shell .compras-index-page .compras-acciones-header {
            order: 4;
            flex-wrap: nowrap;
        }

        body.app-shell .compras-index-page .compras-btn-accion {
            min-height: 1.95rem;
            white-space: nowrap;
        }
    }

    /* Escritorio angosto (1200-1399 px; con el menu lateral quedan ~940 px utiles): totales + vista completa + botones
       ocupan todo el renglon, asi que el texto de estado inactivo se oculta. El aviso de fechas pendientes
       si se muestra, en su propio renglon debajo de la barra, mientras dure. */
    @@media (min-width: 1200px) and (max-width: 1399.98px) {
        body.app-shell .compras-index-page .compras-estado:not(.compras-estado-pendiente) {
            display: none;
        }

        body.app-shell .compras-index-page .compras-estado.compras-estado-pendiente {
            order: 5;
            flex: 0 0 100%;
        }
    }

    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .compras-filtros-row-fechas,
        .compras-filtros-row-busqueda {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .compras-filtro-accion {
            grid-column: 2;
        }
    }

    @@media (max-width: 767.98px) {
        .compras-filtros-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    @* Selector multi-seleccion de Proveedor: el modal va ANTES del script del componente (lee de el las URLs). *@
    <partial name="~/Views/Shared/_FiltroPickerModal.cshtml" />
    <script src="@Url.Content("~/Scripts/app/filtro-picker.js")" asp-append-version="true"></script>
    <script>
        (function () {
            document.addEventListener("keydown", function (event) {
                if (!event.altKey) return;

                var target = event.target;
                var tagName = target && target.tagName ? target.tagName.toUpperCase() : "";
                var isEditable = target && (target.isContentEditable || tagName === "INPUT" || tagName === "TEXTAREA" || tagName === "SELECT");
                if (isEditable) return;

                var key = (event.key || "").toLowerCase();
                var btnNuevo = document.getElementById("btnNuevaCompraIndex");
                var btnLineas = document.getElementById("btnVerLineasComprasIndex");

                if ((key === "n" || key === "enter") && btnNuevo) {
                    event.preventDefault();
                    navegarConLoader(btnNuevo.href, false);
                } else if (key === "v" && btnLineas) {
                    event.preventDefault();
                    navegarConLoader(btnLineas.href, false);
                }
            });

            var storageKey = "compras_index_filters_v1";
            var form = document.querySelector('.compras-filtros-card form');
            var inputFechaDesde = document.getElementById('fechaDesde');
            var inputFechaHasta = form ? form.querySelector('input[name="fechaHasta"]') : null;
            var inputSucursal = form ? form.querySelector('select[name="idSucursal"]') : null;
            var inputTipoCompra = form ? form.querySelector('[name="tipoCompra"]') : null;
            var inputTexto = form ? form.querySelector('input[name="texto"]') : null;
            // Proveedor: selector multi-seleccion (filtro-picker.js). Con seleccion hay IDs exactos (data-ids) y el
            // input es solo un resumen; sin seleccion, texto libre.
            var inputProveedor = document.getElementById('proveedorCompras');
            var picker = window.FiltroPicker || {
                getIds: function () { return ""; },
                getTexto: function (input) { return input ? input.value : ""; }
            };
            var alertaPendiente = document.getElementById('alertaFiltrosPendientesCompras');
            var nativeFormSubmit = window.HTMLFormElement && window.HTMLFormElement.prototype
                ? window.HTMLFormElement.prototype.submit
                : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ""
            };

            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                    window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
                }
            }

            function navegarConLoader(url, useReplace) {
                if (!url) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    if (useReplace) {
                        window.location.replace(url);
                    } else {
                        window.location.href = url;
                    }
                }, 40);
            }

            function submitConLoader() {
                if (!form) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    if (nativeFormSubmit) {
                        nativeFormSubmit.call(form);
                    } else {
                        form.submit();
                    }
                }, 40);
            }

            function buildState() {
                return {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : "",
                    idSucursal: inputSucursal ? inputSucursal.value : "",
                    tipoCompra: inputTipoCompra ? inputTipoCompra.value : "",
                    texto: inputTexto ? inputTexto.value : "",
                    proveedor: picker.getTexto(inputProveedor),
                    idsProveedor: picker.getIds(inputProveedor)
                };
            }

            function saveState() {
                if (!form || !window.sessionStorage) return;
                window.sessionStorage.setItem(storageKey, JSON.stringify(buildState()));
            }

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            var estadoBusqueda = document.getElementById('estadoBusquedaCompras');
            var btnBuscarCompras = document.getElementById('btnBuscarCompras');
            var textoEstadoOk = estadoBusqueda ? estadoBusqueda.textContent : "";
            var textoEstadoPendiente = "Cambiaste las fechas: tocá Buscar para actualizar.";

            // Fechas cambiadas sin aplicar: en pantalla angosta se muestra la alerta amarilla; en escritorio (la
            // alerta esta oculta por CSS) el aviso es el texto de estado y el boton Buscar en ambar.
            function actualizarAvisoPendiente() {
                var pendiente = hayFechasPendientes();
                if (alertaPendiente) alertaPendiente.classList.toggle('d-none', !pendiente);
                if (btnBuscarCompras) {
                    btnBuscarCompras.classList.toggle('btn-warning', pendiente);
                    btnBuscarCompras.classList.toggle('btn-primary', !pendiente);
                }
                if (estadoBusqueda) {
                    estadoBusqueda.textContent = pendiente ? textoEstadoPendiente : textoEstadoOk;
                    estadoBusqueda.title = pendiente ? textoEstadoPendiente : "";
                    estadoBusqueda.classList.toggle('compras-estado-pendiente', pendiente);
                }
            }

            function setBuscandoCompras(mensaje) {
                var btnBuscar = document.getElementById("btnBuscarCompras");
                var btnTexto = btnBuscar ? btnBuscar.querySelector(".btn-buscar-texto") : null;
                var estado = document.getElementById("estadoBusquedaCompras");

                if (btnBuscar) btnBuscar.disabled = true;
                if (btnTexto) btnTexto.textContent = " Cargando...";
                if (estado) estado.textContent = mensaje || "Actualizando búsqueda...";
            }

            function enviarFiltrosEnVivo() {
                if (!form) return;
                saveState();
                setBuscandoCompras("Actualizando búsqueda en vivo...");

                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                    saveState();
                }

                submitConLoader();
            }

            function restoreStateIfNeeded() {
                if (!form || !window.sessionStorage || window.location.search) return;

                var raw = window.sessionStorage.getItem(storageKey);
                if (!raw) return;

                try {
                    var state = JSON.parse(raw);
                    var params = new URLSearchParams();
                    if (state.fechaDesde) params.set("fechaDesde", state.fechaDesde);
                    if (state.fechaHasta) params.set("fechaHasta", state.fechaHasta);
                    if (state.idSucursal) params.set("idSucursal", state.idSucursal);
                    if (state.tipoCompra) params.set("tipoCompra", state.tipoCompra);
                    if (state.texto) params.set("texto", state.texto);
                    // El servidor resuelve los nombres de los IDs desde la URL (no hace falta guardarlos aca).
                    if (state.idsProveedor) params.set("idsProveedor", state.idsProveedor);
                    else if (state.proveedor) params.set("proveedor", state.proveedor);

                    var query = params.toString();
                    if (query) {
                        navegarConLoader(form.action + "?" + query, true);
                    }
                } catch (e) {
                    window.sessionStorage.removeItem(storageKey);
                }
            }

            restoreStateIfNeeded();
            saveState();
            actualizarAvisoPendiente();

            if (form) {
                form.addEventListener("submit", function (event) {
                    if (form.dataset.loadingSubmitPending === "true") {
                        form.dataset.loadingSubmitPending = "";
                        return;
                    }

                    event.preventDefault();
                    fechasAplicadas = {
                        fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                        fechaHasta: inputFechaHasta ? inputFechaHasta.value : ""
                    };
                    saveState();
                    actualizarAvisoPendiente();
                    setBuscandoCompras();
                    form.dataset.loadingSubmitPending = "true";
                    submitConLoader();
                });
                form.querySelectorAll("input, select").forEach(function (el) {
                    el.addEventListener("change", saveState);
                    el.addEventListener("input", saveState);
                });
            }

            if (inputFechaDesde) inputFechaDesde.addEventListener('change', actualizarAvisoPendiente);
            if (inputFechaHasta) inputFechaHasta.addEventListener('change', actualizarAvisoPendiente);
            if (inputSucursal) inputSucursal.addEventListener('change', enviarFiltrosEnVivo);
            if (inputTipoCompra) inputTipoCompra.addEventListener('change', enviarFiltrosEnVivo);

            document.querySelectorAll("#btnNuevaCompraIndex, #btnVerLineasComprasIndex").forEach(function (link) {
                link.addEventListener("click", function (event) {
                    var href = link.getAttribute("href") || "";
                    if (!href) return;
                    event.preventDefault();
                    navegarConLoader(href, false);
                });
            });

            var successAlert = document.getElementById("comprasSuccessAlert");
            if (successAlert) {
                window.setTimeout(function () {
                    $(successAlert).alert("close");
                }, 2500);
            }

            const switchVista = document.getElementById("switchVistaCompletaCompras");
            if (!switchVista) return;

            function syncIcon(button, expanded) {
                if (!button) return;
                button.setAttribute("aria-expanded", expanded ? "true" : "false");
                const icon = button.querySelector("i");
                if (icon) {
                    icon.classList.toggle("fa-chevron-down", !expanded);
                    icon.classList.toggle("fa-chevron-up", expanded);
                }
            }

            function cargarDetalleCompra(detalle) {
                if (!detalle) return;

                const contenedor = detalle.querySelector(".compra-detalle-lazy");
                if (!contenedor) return;

                if (contenedor.getAttribute("data-loaded") === "true"
                    || contenedor.getAttribute("data-loading") === "true") {
                    return;
                }

                const url = contenedor.getAttribute("data-url");
                if (!url) return;

                contenedor.setAttribute("data-loading", "true");
                contenedor.innerHTML = '<div class="text-muted">Cargando detalle...</div>';

                $.get(url)
                    .done(function (html) {
                        contenedor.innerHTML = html;
                        contenedor.setAttribute("data-loaded", "true");
                    })
                    .fail(function () {
                        contenedor.innerHTML = '<div class="text-danger">No se pudo cargar el detalle de la compra.</div>';
                    })
                    .always(function () {
                        contenedor.removeAttribute("data-loading");
                    });
            }

            document.addEventListener("click", function (e) {
                const btn = e.target.closest(".btn-detalles-compra");
                if (!btn) return;

                e.preventDefault();
                const selector = btn.getAttribute("data-target");
                const detalle = selector ? document.querySelector(selector) : null;
                if (!detalle) return;

                cargarDetalleCompra(detalle);

                const expanded = detalle.classList.contains("show");
                $(detalle).collapse(expanded ? "hide" : "show");
                syncIcon(btn, !expanded);
            });

            document.addEventListener("dblclick", function (e) {
                if (e.target.closest("a, button")) return;
                const row = e.target.closest("tr");
                if (!row) return;
                const btnDetalle = row.querySelector(".btn-detalles-compra");
                if (btnDetalle) btnDetalle.click();
            });

            switchVista.addEventListener("change", function () {
                const expandir = switchVista.checked;
                document.querySelectorAll(".compra-detalle-collapse").forEach(function (detalle) {
                    if (expandir) {
                        cargarDetalleCompra(detalle);
                    }
                    $(detalle).collapse(expandir ? "show" : "hide");
                    const btn = document.querySelector('.btn-detalles-compra[data-target="#' + detalle.id + '"]');
                    syncIcon(btn, expandir);
                });
            });
        })();
    </script>
}
