@model WebCore.Models.SystemAdministrationEmpresaEditVm
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.EsEdicion ? "Modificar empresa" : "Nueva empresa";
}

<div class="card shadow-sm sysadmin-editar-empresa-page">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">@(Model.EsEdicion ? "Modificar empresa" : "Nueva empresa")</h6>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Empresas", "SystemAdministration")">
            <i class="fas fa-arrow-left mr-1"></i>Volver
        </a>
    </div>
    <div class="card-body">
        <form asp-controller="SystemAdministration" asp-action="GuardarEmpresa" method="post" novalidate="novalidate">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdEmpresa)

            <div class="validation-summary-valid text-danger mb-3" data-valmsg-summary="true">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Razon social</label>
                    @Html.TextBoxFor(m => m.RazonSocialAfip, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.RazonSocialAfip, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-3">
                    <label>CUIT</label>
                    @Html.TextBoxFor(m => m.Cuit, new { @class = "form-control", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Cuit, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-3">
                    <label>Condicion IVA</label>
                    @Html.TextBoxFor(m => m.CondicionIVA, new { @class = "form-control", list = "condicionesIvaList", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.CondicionIVA, "", new { @class = "text-danger small" })
                    <datalist id="condicionesIvaList">
                        @foreach (var condicionIva in (System.Collections.Generic.List<WebCore.Models.SystemAdministrationCondicionIvaVm>)ViewBag.CondicionesIva)
                        {
                            <option value="@condicionIva.Descripcion"></option>
                        }
                    </datalist>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Nombre fantasia</label>
                    @Html.TextBoxFor(m => m.NombreFantasia, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Ingresos brutos</label>
                    @Html.TextBoxFor(m => m.Iibb, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Inicio actividad</label>
                    @Html.TextBoxFor(m => m.InicioActividad, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-5">
                    <label>Domicilio</label>
                    @Html.TextBoxFor(m => m.Domicilio, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-3">
                    <label>Ciudad</label>
                    @Html.TextBoxFor(m => m.Ciudad, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-2">
                    <label>Pais</label>
                    @Html.TextBoxFor(m => m.Pais, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-2">
                    <label>Telefono</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
                <div class="form-group col-md-4">
                    <label>Tenant slug</label>
                    @Html.TextBoxFor(m => m.TenantSlug, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Base path</label>
                    @Html.TextBoxFor(m => m.BasePath, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Base de datos</label>
                    @Html.TextBoxFor(m => m.BaseDatosNombre, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Certificado PFX</label>
                    @Html.TextBoxFor(m => m.NombreCertificadoPfx, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Entorno AFIP</label>
                    @Html.TextBoxFor(m => m.EntornoHomoProd, new { @class = "form-control", placeholder = "HOMO o PROD" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Slogan 1</label>
                    @Html.TextBoxFor(m => m.Slogan1, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Slogan 2</label>
                    @Html.TextBoxFor(m => m.Slogan2, new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label>Slogan 3</label>
                    @Html.TextBoxFor(m => m.Slogan3, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <div class="custom-control custom-switch mt-4">
                        @Html.CheckBoxFor(m => m.EsRRII, new { @class = "custom-control-input" })
                        <label class="custom-control-label" for="EsRRII">Empresa RRII</label>
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <div class="custom-control custom-switch mt-4">
                        @Html.CheckBoxFor(m => m.Activa, new { @class = "custom-control-input" })
                        <label class="custom-control-label" for="Activa">Empresa activa</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Observaciones</label>
                @Html.TextAreaFor(m => m.Observaciones, 3, 1, new { @class = "form-control" })
            </div>

            <div class="border rounded p-3 mb-4 @(Model.EsEdicion ? "d-none" : "")">
                <h6 class="font-weight-bold text-primary mb-1">Producto &quot;Codigo Generico&quot;</h6>
                <p class="text-muted small mb-3">Se crea junto con la empresa. Usalo para vender algo sin un codigo especifico cargado en el catalogo.</p>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Codigo</label>
                        @Html.TextBoxFor(m => m.CodigoGenericoCodigo, new { @class = "form-control", type = "number" })
                    </div>
                    <div class="form-group col-md-6">
                        <label>Nombre</label>
                        @Html.TextBoxFor(m => m.CodigoGenericoNombre, new { @class = "form-control" })
                    </div>
                    <div class="form-group col-md-3">
                        <label>IVA</label>
                        @Html.DropDownListFor(m => m.CodigoGenericoIdAlicuotaIva,
                            ((System.Collections.Generic.List<WebCore.Models.SystemAdministrationAlicuotaIvaVm>)ViewBag.AlicuotasIva)
                                .Select(a => new SelectListItem { Value = a.IdAlicuotaIva.ToString(), Text = a.Alicuota.ToString("0.##") + "%" }),
                            new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Guardar empresa</button>
            </div>
        </form>
    </div>
</div>

<style>
    .sysadmin-editar-empresa-page {
        font-size: .9rem;
    }

    .sysadmin-editar-empresa-page .card-body {
        padding: .82rem 1rem;
    }

    .sysadmin-editar-empresa-page .form-control,
    .sysadmin-editar-empresa-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .sysadmin-editar-empresa-page label,
    .sysadmin-editar-empresa-page .col-form-label {
        font-size: .8rem;
    }

    .sysadmin-editar-empresa-page .alert,
    .sysadmin-editar-empresa-page .small,
    .sysadmin-editar-empresa-page .text-muted,
    .sysadmin-editar-empresa-page .form-text {
        font-size: .8rem !important;
    }

    @@media (min-width: 1200px) {
        .sysadmin-editar-empresa-page .form-control,
        .sysadmin-editar-empresa-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }
    }
</style>
