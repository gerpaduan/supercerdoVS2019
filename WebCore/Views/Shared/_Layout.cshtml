@using System.Linq
@inject WebCore.Services.IUsuarioSesionService Sesion
@{
    // Sidebar + identidad visual (2026-09-05, ver docs/DECISIONS.md "UI de WebCore igual al
    // clasico"): porta la estructura real de Web/Views/Shared/_LayoutBase.cshtml (mismos nombres
    // de clase -- .sidebar/.nav-item/.nav-link/.sidebar-brand/.collapse-item -- y el mismo logo
    // SVG de 2 colores) y carga los 2 archivos CSS reales del clasico (custom.css/ui-refresh.css)
    // -- confirmado que son CSS propio y aditivo (variables + selectores con clases estandar de
    // Bootstrap), sin nada de Bootstrap empaquetado adentro, a diferencia de sb-admin-2.min.css
    // (que si trae Bootstrap 4 completo y por eso NUNCA se carga aca -- rompería las 30+ vistas
    // que ya usan Bootstrap 5). La estructura de tamaño/layout del sidebar (6.5rem/14rem, mobile-
    // first) SI hace falta escribirla a mano mas abajo: esa parte vive en sb-admin-2.min.css, no
    // en ui-refresh.css (que solo re-colorea encima de una estructura que asume ya existente).
    //
    // Permisos reales del sidebar (2026-09-06, Batch 4 del plan de login/permisos reales, ver
    // docs/DECISIONS.md): port literal de Web/Views/Shared/_LayoutBase.cshtml:21-56, ahora contra
    // IUsuarioSesionService.UsuarioActual en vez de Session["Usuario"].
    //
    // Modulos NO migrados a WebCore todavia (MercadoPago, integracion de otra sesion en
    // paralelo) linkean con URL absoluta al Web clasico via el appSetting
    // WebClasicoBaseUrl (App.config) -- se navega fluido entre los dos sistemas mientras dura la
    // migracion, sin togs muertos ni 404s. Cuando un modulo de esa lista se porte, su link pasa
    // a @@Url.Action local (mismo criterio que el resto de la lista).
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";

    // Operador de modulo de Compras (2026-09-09, Batch B, ver docs/DECISIONS.md "Batch B:
    // permisos reales + operador de produccion"): asi es como el operador autorizado "pierde el
    // permiso al hacer clic afuera" del modulo -- este layout se renderiza en TODA la app, asi
    // que en cada request que no sea a Compras, si hay un operador de Compras activo en Session
    // se limpia aca mismo. Server side, sin beacon/pagehide. Port de
    // Web/Views/Shared/_LayoutBase.cshtml:19.
    WebCore.Helpers.PermisosHelper.LimpiarOperadorModuloSiSalioDelModulo(Context.Session, controller);

    // Item 7 (2026-09-12, ver docs/DECISIONS.md "gate de caja abierta"): "el permiso para
    // registrar ventas sin apertura de caja termina al salir de la vista del pos venta" -- este
    // layout se renderiza en TODA la app excepto POS (que usa _LayoutPOS.cshtml), asi que
    // cualquier request que llegue aca YA significa "salio de POS". Mismo criterio que la
    // limpieza de operador de modulo, una linea arriba.
    WebCore.Helpers.PermisosHelper.LimpiarBypassCajaSiSalioDePOS(Context.Session, controller, action, Sesion.UsuarioActual?.Id ?? 0);

    string webClasico = (System.Configuration.ConfigurationManager.AppSettings["WebClasicoBaseUrl"] ?? "").TrimEnd('/');
    Func<string, string> legacy = path => webClasico + path;

    bool enStock = controller == "Stock";
    bool enPuntosExpendio = controller == "PuntosExpendio";
    bool enFinanzas = controller == "Finanzas";
    bool enConfiguracion = controller == "Usuarios" || controller == "AuditoriaLogin" || controller == "Parametros"
        || controller == "Empresa" || controller == "Sucursal" || controller == "DispositivosSeguros";
    bool enAdministracionSistema = controller == "SystemAdministration";

    var usuarioActual = Sesion.UsuarioActual;
    bool esAdmin = usuarioActual.Admin;

    // Menu de usuario + sucursal actual (2026-09-07, pedido explicito del usuario -- ver
    // docs/DECISIONS.md). Nombre de la sucursal actual ya viene resuelto fresco de BD en
    // usuarioActual.Sucursal/.SucursalNombre (UsuarioSesionService), igual que el clasico
    // re-resuelve Session["Usuario"].Sucursal en cada request.
    string sucursalActualNombre = usuarioActual.Sucursal != null ? usuarioActual.SucursalNombre : "Sin sucursal";

    bool puedeAdministrarUsuarios = esAdmin;
    if (!puedeAdministrarUsuarios && usuarioActual.Permisos != null)
    {
        puedeAdministrarUsuarios = usuarioActual.Permisos.Any(p =>
            p != null &&
            p.Formulario != null &&
            (
                string.Equals(p.Formulario.FormConsulta ?? "", Entidades.Permisos.Usuario.VerUsuarios, System.StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Formulario.FormEdicion ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Formulario.FormEdicionExtra1 ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Formulario.FormEdicionExtra2 ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase)
            ));
    }

    // Mas estricto que puedeAdministrarUsuarios: ese tambien deja pasar con el permiso de
    // solo-ver-usuarios (VerUsuarios), que NO debe dar acceso a la auditoria de accesos (mismo
    // criterio que Web/Views/Shared/_LayoutBase.cshtml:40-42 y AuditoriaLoginController.PuedeVerAuditoria).
    bool puedeVerAuditoriaLogin = esAdmin;
    if (!puedeVerAuditoriaLogin && usuarioActual.Permisos != null)
    {
        puedeVerAuditoriaLogin = usuarioActual.Permisos.Any(p =>
            p != null &&
            p.Formulario != null &&
            (
                string.Equals(p.Formulario.FormEdicion ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Formulario.FormEdicionExtra1 ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Formulario.FormEdicionExtra2 ?? "", Entidades.Permisos.Usuario.NuevoUsuario, System.StringComparison.OrdinalIgnoreCase)
            ));
    }

    // EsSuperAdmin (columna Usuarios.superadmin) es un concepto separado del sistema de Permisos,
    // independiente de esAdmin -- mismo criterio que SystemAdministrationAccessHelper del clasico.
    bool puedeAdministrarSistema = WebCore.Infrastructure.NegocioFactory.CrearSystemAdministrationRepository().EsSuperAdmin(usuarioActual.Id);

    bool mostrarConfiguracion = esAdmin;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarniSys</title>
    <script type="importmap"></script>

    @* Preload de modo oscuro (port literal de Web/Views/Shared/_LayoutBase.cshtml): evita el
       "flash" de tema claro antes de que el resto del JS aplique la clase guardada. *@
    <script>
        (function () {
            try {
                var mode = localStorage.getItem("carnisys-theme");
                if (mode === "dark") {
                    document.documentElement.classList.add("dark-mode");
                }
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Gap real encontrado el 2026-09-04 portando la UI de POS: 68 vistas ya migradas usan clases
       "fas fa-*"/"far fa-*" pero ningun layout de WebCore cargaba Font Awesome -- los iconos no
       se veian en ninguna pantalla ya portada. Misma version que Web/Content/vendor/fontawesome-
       free (5.15.3) para paridad exacta de glifos, via CDN (mismo patron que SweetAlert2 mas
       abajo, unica libreria de este layout que no esta vendorizada localmente). *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    @* Google Fonts Nunito -- misma tipografia que Web clasico (sb-admin-2), ver
       Web/Views/Shared/_LayoutBase.cshtml (comentado ahi, cargada por CDN igual). *@
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet" />
    @* Gap real encontrado el 2026-09-04 (ver docs/DECISIONS.md): el markup ya portado usa clases
       de Bootstrap 4 (badge-warning, custom-switch, etc.) que no existen en Bootstrap 5 -- shim
       de compatibilidad, no reescritura de las 30+ vistas afectadas. *@
    <link rel="stylesheet" href="~/Content/css/bootstrap4-compat.css" asp-append-version="true" />
    @* Identidad visual real del clasico (2026-09-05) -- CSS propio y aditivo, sin Bootstrap
       empaquetado adentro (confirmado leyendo los 2 archivos completos), seguro de cargar sobre
       Bootstrap 5. custom.css antes que ui-refresh.css: ui-refresh define las variables --ui-*
       que custom.css (dark mode del input "resaltado") ya asume que existen. *@
    <link rel="stylesheet" href="~/Content/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/ui-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebCore.styles.css" asp-append-version="true" />

    <style>
        /* Estructura de tamaño/layout del sidebar (2026-09-05) -- estos numeros SI vienen de
           sb-admin-2.min.css (no de ui-refresh.css, que solo re-colorea): mobile-first, compacto
           (solo iconos, 6.5rem) por defecto, expandido (14rem) desde 768px salvo toggle manual a
           icon-only (".sidebar.toggled", igual nombre de clase que el clasico). Responsive
           corregido el 2026-09-04 (ver docs/DECISIONS.md "Web es la fuente de verdad de diseno,
           incluido responsive"): NO es una app de escritorio, el clasico soporta celular con este
           mismo criterio (confirmado leyendo el CSS completo -- la unica referencia a
           "min-width:992px" en sb-admin-2.min.css esta dentro de un @@media print, nunca aplica
           en pantalla).
           Fuente tipografica Nunito (arriba) -- mismo font-family que sb-admin-2.min.css declara
           para body/headings en el clasico. */
        body {
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Bug real encontrado 2026-09-11 (el hueco gris debajo del footer, confirmado con captura
           real de celular, no era de vh/flexbox): wwwroot/css/site.css trae "body { margin-bottom:
           60px; }" -- sobrante de la plantilla default de ASP.NET Core (pensada para SU propio
           footer con position:absolute/bottom:0), nunca se limpio al reemplazarlo por el sistema
           de footer propio (#wrapper/#content-wrapper flex + footer.sticky-footer). Se pisa el
           margen solo para "body.app-shell" (esta vista) en vez de tocar site.css, para no romper
           otras vistas (Login/Landing) que puedan seguir dependiendo del comportamiento default. */
        body.app-shell {
            margin-bottom: 0;
        }

        #wrapper {
            display: flex;
        }

        /* Bug real encontrado 2026-09-06: al escribir a mano la estructura de tamaño del
           sidebar (sb-admin-2.min.css nunca se carga, ver comentario de arriba) se recreo el
           ancho del sidebar pero no esta regla -- #content-wrapper (hijo flex de #wrapper) sin
           flex-grow ocupa solo el ancho de su contenido en vez de todo el espacio restante.
           Efecto visible: el topbar/contenido quedaba encogido a la izquierda con una franja
           gris a la derecha en CUALQUIER vista (ej. Ventas/Index), y el menu de usuario del
           topbar terminaba a mitad de pantalla en vez de la esquina superior derecha. Mismas 2
           reglas que trae sb-admin-2.css original (#wrapper #content-wrapper / #content). */
        #content-wrapper {
            width: 100%;
            overflow-x: hidden;
            /* Bug real (2026-09-11): el clasico logra el mismo layout sin esto porque su
               ".sidebar" no tiene "align-self: flex-start" -- ahi #content-wrapper estira su
               altura al 100% de #wrapper por el "align-items: stretch" default de flexbox, sin
               ambiguedad. Ac el sidebar SI tiene align-self:flex-start (mejora propia del
               2026-09-08, para poder scrollearlo internamente sin arrastrar toda la pagina) --
               eso lo saca del stretch, y deja el alto automatico de #wrapper (fila flex) en un
               calculo ambiguo entre item con stretch e item sin el. Resultado visible: el
               footer quedaba un poco mas arriba del borde real de la pantalla, no pegado al
               pie. Fijar el minimo en 100vh saca la ambiguedad: #content (flex:1 0 auto) crece
               para llenarlo y el footer queda empujado al fondo real, sin depender de como el
               sidebar participe del stretch.
               Correccion 2026-09-11 (probado en celular real, seguia fallando con min-height:
               100vh solo): "vh" no se ajusta cuando el navegador mobile oculta/muestra su barra
               de direcciones al scrollear -- el alto calculado al cargar queda mas chico que el
               visible real una vez que esa barra se esconde, dejando un hueco debajo del
               footer. "100dvh" (dynamic viewport height) si seguis el alto visible real; se
               declara DESPUES de 100vh a proposito (mejora progresiva -- un navegador que no
               conoce dvh ignora esa linea y se queda con el valor de vh de arriba). */
            min-height: 100vh;
            min-height: 100dvh;
        }

        #content-wrapper #content {
            flex: 1 0 auto;
        }

        /* Nunca se porto esta regla del clasico (Web/Content/css/sb-admin-2.css:11269) -- sin
           flex-shrink:0 el footer (flex item de #content-wrapper.flex-column) podia encogerse
           en vez de mantener su alto natural cuando el contenido+footer llegaban justo al
           limite del contenedor. */
        footer.sticky-footer {
            flex-shrink: 0;
        }

        .sidebar {
            width: 6.5rem;
            /* Bug real (2026-09-08, ver docs/DECISIONS.md): "min-height" es un piso, no un techo --
               si el contenido (items + submenu desplegado) supera el viewport, la caja crecia mas
               alla de 100vh en vez de generar scroll interno, y "overflow-y: auto" de abajo nunca
               se activaba (scrollHeight nunca superaba clientHeight). Al ser position:sticky
               dentro de un #wrapper flex, el sidebar terminaba atado al scroll del body --
               scrollear con el mouse sobre el sidebar movia toda la pagina. "height" fijo acota la
               caja de verdad y deja que el scroll interno haga su trabajo. Nota: el clasico nunca
               tuvo este problema resuelto (su sidebar no es sticky ni tiene overflow propio) --
               esto es una mejora de WebCore, no un port.
               2026-09-11: mismo fix de dvh que #content-wrapper -- si el sidebar se queda en
               puro "100vh" mientras #content-wrapper ya usa dvh, los dos flex items del mismo
               #wrapper terminarian con alturas distintas segun el estado de la barra del
               navegador, un desajuste nuevo. Se corrigen los dos juntos. */
            height: 100vh;
            height: 100dvh;
            position: sticky;
            top: 0;
            align-self: flex-start;
            overflow-y: auto;
            overflow-x: hidden;
            flex-shrink: 0;
            padding: 0;
            list-style: none;
            margin: 0;
            /* Item 3 de la segunda ronda de pedidos (2026-09-10, ver docs/DECISIONS.md): la
               barra de scroll nativa quedaba fea sobre el gradiente del sidebar. Se oculta la
               barra visual (el scroll en si sigue funcionando, scrollear con mouse/touch sigue
               andando igual) y se compensa con foco de teclado -- ver tabindex/aria-label mas
               abajo en el <ul id="accordionSidebar">. Con overflow-y:auto + height:100vh ya
               presentes arriba, un contenedor con foco scrollea con flechas/PageUp/PageDown/
               Home/End de forma nativa del navegador, sin JS adicional. */
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;
        }

        .sidebar::-webkit-scrollbar {
            display: none; /* Chrome/Edge/Safari */
        }

        .sidebar:focus-visible {
            outline: 2px solid rgba(255, 255, 255, .55);
            outline-offset: -2px;
        }

        .sidebar .nav-item {
            position: relative;
        }

        .sidebar .nav-item .nav-link {
            text-align: center;
            padding: .75rem .5rem;
            width: 6.5rem;
            display: block;
        }

        .sidebar .nav-item .nav-link span {
            font-size: .65rem;
            display: block;
            margin-top: .25rem;
        }

        .sidebar .nav-item .nav-link i {
            font-size: 1rem;
        }

        .sidebar .sidebar-brand {
            height: 4.375rem;
            text-decoration: none;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: .05rem;
            text-transform: uppercase;
        }

        .sidebar-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-brand-mark svg {
            width: 2rem;
            height: 2rem;
        }

        .sidebar-brand-text {
            display: none;
        }

        .sidebar hr.sidebar-divider {
            margin: 0 1rem 1rem;
            border-top-width: 1px;
        }

        .sidebar .collapse-inner {
            position: absolute;
            left: calc(6.5rem + .75rem);
            top: 2px;
            z-index: 1;
            min-width: 10rem;
            padding: .5rem 0;
            /* Bug real (2026-09-08, ver docs/DECISIONS.md): nunca se porto un font-size propio
               para el submenu -- heredaba el tamano por defecto de Bootstrap (~1rem) contra los
               .85rem del item de primer nivel (.nav-link span mas abajo), se veia mas grande.
               Paridad con el clasico: Web/Content/css/sb-admin-2.css:10371 define el mismo
               0.85rem en .collapse-inner. */
            font-size: 0.85rem;
            border-radius: .35rem;
            box-shadow: 0 .15rem 1.75rem 0 rgba(58, 59, 69, .15);
        }

        .sidebar .collapse-item {
            display: block;
            padding: .5rem 1rem;
            margin: 0 .5rem;
            white-space: nowrap;
            text-decoration: none;
        }

        .sidebar .nav-link[data-bs-toggle="collapse"] .fa-chevron-down {
            display: none;
        }

        /* Bug real (2026-09-11): abajo de 768px el sidebar es SIEMPRE visible (franja de solo
           iconos, mobile-first por diseño) -- ".toggled" hasta ahora solo tenia efecto visual
           dentro del @@media (min-width:768px) de mas abajo (modo iconos en desktop). El gesto de
           swipe (mas abajo en @@section Scripts) prende/apaga esa misma clase via el boton
           existente (#sidebarToggle) pero sin esta regla no pasaba nada en mobile: la clase
           cambiaba, nada reaccionaba. Reusa el mismo toggle/clase/localStorage en vez de sumar un
           mecanismo aparte -- en mobile ahora significa "ocultar del todo" (no "modo iconos" como
           en desktop), el layout flex de #wrapper ya hace que #content-wrapper ocupe el espacio
           liberado sin ajustes extra. */
        @@media (max-width: 767.98px) {
            .sidebar.toggled {
                width: 0;
                min-width: 0;
                overflow: hidden;
                border: 0;
            }
        }

        /* Desde 768px: sidebar expandido con texto, salvo modo iconos manual (.toggled). */
        @@media (min-width: 768px) {
            .sidebar {
                width: 14rem;
            }

            .sidebar .nav-item .nav-link {
                text-align: left;
                width: 14rem;
                padding: 1rem;
            }

            .sidebar .nav-item .nav-link span {
                font-size: .85rem;
                display: inline;
                margin-top: 0;
                margin-left: .5rem;
            }

            .sidebar .sidebar-brand-text {
                display: inline;
            }

            .sidebar .nav-link[data-bs-toggle="collapse"] .fa-chevron-down {
                display: inline-block;
                float: right;
                transition: transform .2s ease;
                font-size: .7rem;
                margin-top: .3rem;
            }

            .sidebar .nav-link[data-bs-toggle="collapse"][aria-expanded="true"] .fa-chevron-down {
                transform: rotate(180deg);
            }

            .sidebar .collapse,
            .sidebar .collapsing {
                margin: 0 1rem;
            }

            .sidebar .collapse-inner {
                position: static;
                box-shadow: none;
                border-radius: 0;
                padding: .25rem 0;
            }

            .sidebar.toggled {
                width: 6.5rem;
            }

            .sidebar.toggled .nav-item .nav-link {
                text-align: center;
                width: 6.5rem;
                padding: .75rem .5rem;
            }

            .sidebar.toggled .nav-item .nav-link span,
            .sidebar.toggled .sidebar-brand-text,
            .sidebar.toggled .nav-link[data-bs-toggle="collapse"] .fa-chevron-down {
                display: none;
            }

            .sidebar.toggled .collapse-inner {
                position: absolute;
                left: calc(6.5rem + .75rem);
                top: 2px;
                box-shadow: 0 .15rem 1.75rem 0 rgba(58, 59, 69, .15);
                border-radius: .35rem;
                padding: .5rem 0;
            }

            /* Evita el "flash" de sidebar expandido antes de aplicar el estado guardado. */
            html.sidebar-toggled-pref .sidebar:not(.toggled) {
                visibility: hidden;
            }
        }

        #sidebarToggle {
            display: none;
        }

        @@media (min-width: 768px) {
            #sidebarToggle {
                display: inline-block;
            }
        }
    </style>
    <script>
        (function () {
            try {
                if (localStorage.getItem("carnisys-sidebar-collapsed") === "1") {
                    document.documentElement.classList.add("sidebar-toggled-pref");
                }
            } catch (e) { }
        })();
    </script>
</head>
<body id="page-top" class="app-shell">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar" tabindex="0" aria-label="Menú de navegación. Usá las flechas o Av Pág/Re Pág para desplazar.">
            <li class="nav-item">
                <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@Url.Action("Index", "Home")">
                    <div class="sidebar-brand-icon sidebar-brand-mark">
                        <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                            <path d="M50 6 L93 92 H79 L50 34 L21 92 H7 Z" fill="#35479b"></path>
                            <path d="M50 25 L78 81 H67 L50 47 L33 81 H69 L73 89 H17 L21 81 Z" fill="#e19143"></path>
                        </svg>
                    </div>
                    <div class="sidebar-brand-text mx-3">CarniSys</div>
                </a>
            </li>
            <li class="nav-item">
                <hr class="sidebar-divider my-0">
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "Compras" ? "active" : "")" href="@Url.Action("Index", "Compras")">
