    @* Gap real cerrado 2026-09-05 (ver docs/DECISIONS.md), port de Web/Views/Shared/_LayoutBase.cshtml
       (lineas 1144-1180). Todo controller portado hasta ahora ya setea TempData["AlertType"/"Title"/
       "Msg"] tras un guardado/error (fidelidad de logica) pero _Layout.cshtml nunca lo leia -- el
       usuario guardaba algo y no veia ningun feedback visual. Mismo mecanismo exacto: SweetAlert2
       (ya cargado arriba), auto-cierre a los 2s solo para "success", CustomEvent "layoutAlertClosed"
       preservado por si alguna vista lo necesita mas adelante (Productos/AddOrEdit "carga continua"
       en el original). *@
    @if (TempData["AlertMsg"] != null)
    {
        <script>
        (function () {
            var type = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertType"] as string ?? "info"))";
            var title = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertTitle"] as string ?? "Aviso"))";
            var msg = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertMsg"] as string ?? ""))";

            var opts = { icon: type, title: title, text: msg };
            if (type === 'success') {
                opts.timer = 2000;
                opts.timerProgressBar = true;
                opts.showConfirmButton = true;
            }

            function avisarCerrado() {
                document.dispatchEvent(new CustomEvent('layoutAlertClosed'));
            }

            if (window.Swal) {
                Swal.fire(opts).then(avisarCerrado);
            } else {
                alert(title + "\n\n" + msg);
                avisarCerrado();
            }
        })();
        </script>
    }

