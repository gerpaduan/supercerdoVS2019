            <li class="nav-item">
                <a class="nav-link @(controller == "Cajas" && action == "CajasAbiertas" ? "active" : "")" href="@Url.Action("CajasAbiertas", "Cajas")">
                    <i class="fas fa-fw fa-file-invoice-dollar"></i>
