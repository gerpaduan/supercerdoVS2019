    @* Toggle de tema oscuro -- port literal de Web/Views/Shared/_LayoutBase.cshtml (mismas
       claves de localStorage: "carnisys-theme"/"darkMode", mismo id de boton/icono). *@
    <script>
        (function () {
            const STORAGE_KEY = "carnisys-theme";

            function setTheme(mode) {
                const isDark = mode === "dark";
                document.documentElement.classList.toggle("dark-mode", isDark);
                document.body.classList.toggle("dark-mode", isDark);

                var btn = document.getElementById("btnToggleTheme");
                var ico = document.getElementById("icoTheme");
                if (btn && ico) {
                    ico.className = isDark ? "fas fa-sun" : "fas fa-moon";
                    btn.title = isDark ? "Activar modo claro" : "Activar modo oscuro";
                    btn.setAttribute("aria-label", btn.title);
                }

                try {
                    localStorage.setItem(STORAGE_KEY, mode);
                    localStorage.setItem("darkMode", isDark ? "true" : "false");
                } catch (e) { }
            }

            document.addEventListener("DOMContentLoaded", function () {
                var saved = "light";
                try {
                    saved = localStorage.getItem(STORAGE_KEY) || (localStorage.getItem("darkMode") === "true" ? "dark" : "light");
                } catch (e) { }

                setTheme(saved);

                var btn = document.getElementById("btnToggleTheme");
                if (btn) {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        var current = "light";
                        try {
                            current = localStorage.getItem(STORAGE_KEY) || (document.body.classList.contains("dark-mode") ? "dark" : "light");
                        } catch (err) { }
                        setTheme(current === "dark" ? "light" : "dark");
                    });
                }
            });
        })();
    </script>

    @* Toggle a modo iconos del sidebar (2026-09-04, adaptado 2026-09-05 a los nombres de clase
       reales del clasico -- ".sidebar"/".toggled"/"#sidebarToggle") -- vanilla JS, no depende del
       orden de carga de jQuery. 2026-09-11: se suma #sidebarToggleTop (boton hamburguesa en el
       topbar, solo visible en mobile via d-md-none -- #sidebarToggle vive DENTRO del sidebar con
       d-none d-md-inline, invisible en mobile y ademas inalcanzable una vez oculto el sidebar; sin
       este boton en el topbar no habia forma de reabrir el menu en el celular salvo el swipe).
       Ambos botones llaman a la misma funcion, ninguno reimplementa logica propia. *@
    <script>
        (function () {
            var STORAGE_KEY = "carnisys-sidebar-collapsed";
            var sidebar = document.querySelector(".sidebar");
            var toggleBtns = [document.getElementById("sidebarToggle"), document.getElementById("sidebarToggleTop")]
                .filter(function (b) { return !!b; });
            if (!sidebar || toggleBtns.length === 0) return;

            // Titulos accesibles cuando el sidebar queda en modo iconos -- se generan del texto
            // visible de cada link en vez de escribirlos a mano en las 20+ filas del menu.
            sidebar.querySelectorAll(".nav-link").forEach(function (link) {
                if (link.hasAttribute("title")) return;
                var span = link.querySelector("span");
                var texto = (span ? span.textContent : link.textContent || "").trim();
                if (texto) link.setAttribute("title", texto);
            });

            function applyCollapsed(collapsed) {
                sidebar.classList.toggle("toggled", collapsed);
                document.documentElement.classList.remove("sidebar-toggled-pref");
            }

            var collapsedGuardado = false;
            try {
                collapsedGuardado = localStorage.getItem(STORAGE_KEY) === "1";
            } catch (e) { }

            applyCollapsed(collapsedGuardado);

            function toggleSidebar() {
                var collapsed = !sidebar.classList.contains("toggled");
                applyCollapsed(collapsed);
                try {
                    localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
                } catch (e) { }
            }

            toggleBtns.forEach(function (btn) {
                btn.addEventListener("click", toggleSidebar);
            });

            // Expuesto para el gesto de swipe de mas abajo -- evita depender de "clickear" un
            // boton que puede estar oculto (d-none) segun el ancho de pantalla.
            window.__toggleSidebarCarniSys = toggleSidebar;
        })();
    </script>

    @* Gesto de swipe para mostrar/ocultar el menu lateral, solo en mobile -- port de
       Web/Views/Shared/_LayoutBase.cshtml (lineas 888-938), adaptado. Llama directo a la funcion
       de toggle de arriba (window.__toggleSidebarCarniSys) en vez de clickear un boton -- en
       mobile #sidebarToggle esta con d-none, un click sintetico ahi no dispara nada.
       2026-09-11: fix real -- el navegador (Chrome/Safari mobile) interpreta un swipe que arranca
       cerca del borde izquierdo como gesto nativo de "volver atras" (por eso el swipe derecha
       terminaba en Login: volvia al historial). touchmove ya no es passive: en cuanto el gesto se
       confirma horizontal (no un scroll vertical) y cumple nuestras condiciones, se llama
       preventDefault() para que el navegador ceda el gesto -- nunca se llama en gestos
       verticales, asi que el scroll normal de la pagina no se ve afectado. *@
    <script>
        (function () {
            var mqMobile = window.matchMedia("(max-width: 767.98px)");
            var EDGE_ZONE_PX = 24;          // franja desde el borde izquierdo que "abre" el menu
            var SWIPE_THRESHOLD_PX = 45;    // distancia horizontal minima para contar como swipe
            var MAX_VERTICAL_DRIFT_PX = 60; // si el dedo se desvia mucho en vertical, no es swipe (es scroll)
            var COMMIT_PX = 10;             // distancia minima para "decidir" que el gesto es horizontal

            var sidebar = document.querySelector(".sidebar");
            if (!sidebar) return;

            var touchStartX = null;
            var touchStartY = null;
            var startedOnSidebar = false;
            var startedOnEdge = false;
            var comprometido = false; // ya decidimos que es nuestro swipe -- preventDefault en curso

            document.addEventListener("touchstart", function (e) {
                comprometido = false;
                if (!mqMobile.matches) { touchStartX = null; return; }
                if (!e.touches || e.touches.length !== 1) { touchStartX = null; return; }
                var touch = e.touches[0];
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                startedOnSidebar = !!(e.target && e.target.closest && e.target.closest(".sidebar"));
                startedOnEdge = touch.clientX <= EDGE_ZONE_PX;
            }, { passive: true });

            document.addEventListener("touchmove", function (e) {
                if (!mqMobile.matches || touchStartX === null) return;
                if (!e.touches || e.touches.length !== 1) return;

                var oculto = sidebar.classList.contains("toggled");
                var candidato = (startedOnSidebar && !oculto) || (startedOnEdge && oculto);
                if (!candidato) return;

                var touch = e.touches[0];
                var dx = touch.clientX - touchStartX;
                var dy = touch.clientY - touchStartY;

                if (!comprometido) {
                    if (Math.abs(dy) > MAX_VERTICAL_DRIFT_PX) return; // es scroll vertical, no tocar
                    if (Math.abs(dx) < COMMIT_PX) return; // todavia no se sabe la direccion
                    comprometido = true;
                }

                // Nuestro swipe horizontal confirmado: frenamos el gesto nativo de "volver atras"
                // del navegador antes de que se dispare.
                e.preventDefault();
            }, { passive: false });

            document.addEventListener("touchend", function (e) {
                if (!mqMobile.matches || touchStartX === null) return;
                var touch = e.changedTouches && e.changedTouches[0];
                var startX = touchStartX, startY = touchStartY;
                touchStartX = null;
                touchStartY = null;
                if (!touch) return;

                var dx = touch.clientX - startX;
                var dy = touch.clientY - startY;
                if (Math.abs(dy) > MAX_VERTICAL_DRIFT_PX) return;

                var oculto = sidebar.classList.contains("toggled");
                var toggle = window.__toggleSidebarCarniSys;
                if (!toggle) return;

                if (dx <= -SWIPE_THRESHOLD_PX && startedOnSidebar && !oculto) {
                    // swipe hacia la izquierda empezando sobre el menu: ocultarlo
                    toggle();
                } else if (dx >= SWIPE_THRESHOLD_PX && startedOnEdge && oculto) {
                    // swipe hacia la derecha empezando cerca del borde izquierdo: mostrarlo
                    toggle();
                }
            }, { passive: true });
        })();
    </script>

    @* Estilo propio del flyout cuando esta "en portal" (ver script de abajo, se mueve a ser
       hijo directo de <body>). Bug real encontrado al probarlo: todo el estilo de
       ".collapse-inner"/".collapse-item" (colores, hover, modo oscuro, display:block) vive en
       Content/css/ui-refresh.css con selectores "body.app-shell .sidebar .collapse-item" --
       exigen ".sidebar" como ancestro. Al mover el elemento afuera de ".sidebar" pierde ese
       contexto y cae al estilo por defecto del navegador (link azul subrayado, todo en una
       linea). Se repiten aca los mismos valores (no se tocan los originales, que siguen
       rigiendo el modo expandido de escritorio sin cambios) mas el borde/sombra pedidos
       explicitamente para que se note como flotante. *@
    <style>
        .collapse-inner.flyout-portal {
            display: block;
            padding: .5rem 0;
            background: rgba(255, 255, 255, .96);
            border: 2px solid rgba(255, 255, 255, .85);
            border-radius: .35rem;
            box-shadow: 0 .5rem 2rem rgba(0, 0, 0, .35);
        }

        .collapse-inner.flyout-portal .collapse-item {
            display: block;
            padding: .5rem 1rem;
            margin: 0 .5rem;
            white-space: nowrap;
            text-decoration: none;
            border-radius: .65rem;
            color: #34475c;
        }

        .collapse-inner.flyout-portal .collapse-item:hover,
        .collapse-inner.flyout-portal .collapse-item.active {
            background: var(--ui-primary-soft);
            color: var(--ui-primary) !important;
        }

        html.dark-mode .collapse-inner.flyout-portal {
            background: #172235;
            border-color: rgba(255, 255, 255, .25);
            box-shadow: 0 .5rem 2rem rgba(0, 0, 0, .6);
        }

        html.dark-mode .collapse-inner.flyout-portal .collapse-item,
        html.dark-mode .collapse-inner.flyout-portal .collapse-item:visited {
            color: #d8e6f7 !important;
        }

        html.dark-mode .collapse-inner.flyout-portal .collapse-item:hover,
        html.dark-mode .collapse-inner.flyout-portal .collapse-item:focus,
        html.dark-mode .collapse-inner.flyout-portal .collapse-item.active {
            background: rgba(94, 136, 199, .18) !important;
            color: #f8fbff !important;
        }
    </style>

    @* Fix real (2026-09-11): los submenus flotantes (.collapse-inner, position:absolute, se
       "escapan" a la derecha del sidebar angosto en modo iconos) quedaban invisibles -- el
       sidebar tiene overflow-x:hidden (2026-09-08, para ocultar la barra de scroll fea) y por
       como funciona overflow en CSS, con overflow-y:auto en el mismo elemento el navegador
       tambien recorta el eje X aunque se intente poner "visible" (no se puede tener "recorta
       vertical, deja escapar horizontal" en un mismo elemento). Antes pasaba desapercibido
       porque el sidebar de escritorio rara vez queda en modo iconos (.toggled); ahora en mobile
       el sidebar ES modo iconos por defecto, asi que el corte se nota siempre (Stock, Punto de
       Expendio, etc).
       Version 3 (mismo dia): la v1 copiaba la posicion original del CSS (siempre "top:2px",
       pegado arriba, tapado por el topbar) -- la v2 la calculo bien (altura del trigger) y le
       dio z-index alto, pero seguia quedando detras del contenido propio de cada vista
       (Movimientos, Stock, dashboard) porque ".collapse-inner" sigue siendo hijo del sidebar:
       cualquier ancestro con su propio stacking context (varios lo tienen, cada vista trae el
       suyo) puede tapar un z-index alto igual, no importa que tan alto sea el numero si esta
       "encerrado" en un contexto de apilamiento mas atras. Solucion real (v3): mientras esta
       abierto, se MUEVE el elemento a ser hijo directo de <body> (mismo truco que usan los
       modales) -- asi queda completamente afuera de cualquier stacking context de la pagina, y
       vuelve a su lugar original en el DOM al cerrarse (recordamos el padre + hermano siguiente
       para restaurarlo exacto). Tambien se cierra solo con un click/toque afuera (pedido
       explicito) -- antes quedaba abierto hasta navegar a otra vista. En modo expandido de
       escritorio (.collapse-inner: position:static) nada de esto se activa -- ahi el submenu ya
       se ve bien, expandido debajo de su padre en el flujo normal. *@
    <script>
        (function () {
            var sidebar = document.querySelector(".sidebar");
            if (!sidebar) return;
            var mqDesktop = window.matchMedia("(min-width: 768px)");
            var GAP_PX = 12; // separacion visual entre el sidebar/trigger y el flyout (antes ".75rem")
            var Z_INDEX_FLYOUT = 1090; // por encima de topbar, tooltips y popovers de Bootstrap (max 1080)

            function enModoFlyout() {
                return !mqDesktop.matches || sidebar.classList.contains("toggled");
            }

            var abiertos = []; // { collapseEl, inner, padreOriginal, hermanoSiguienteOriginal }

            var MARGIN_VIEWPORT_PX = 8; // aire minimo contra el borde de la pantalla

            function ubicarFlyout(entry) {
                var trigger = sidebar.querySelector('[data-bs-target="#' + entry.collapseEl.id + '"]') ||
                    entry.collapseEl.previousElementSibling;
                if (!trigger) return;

                // Se resetea antes de medir -- si quedo un max-height/overflow de una
                // ubicacion anterior (rotar el telefono, etc.) alteraria la altura natural real.
                entry.inner.style.maxHeight = "";
                entry.inner.style.overflowY = "";

                var rectTrigger = trigger.getBoundingClientRect();
                entry.inner.style.position = "fixed";
                entry.inner.style.left = (rectTrigger.right + GAP_PX) + "px";
                entry.inner.style.margin = "0";
                entry.inner.style.zIndex = String(Z_INDEX_FLYOUT);
                entry.inner.style.top = rectTrigger.top + "px";

                // Pedido explicito: que entren todos los items del submenu visibles en pantalla.
                // Se mide la altura natural (ya con top puesto arriba, sin todavia recortar) y,
                // si no entra debajo del trigger, se sube el flyout -- nunca por encima del
                // borde superior de la pantalla. Si ni asi entra completo (mas alto que el
                // viewport disponible), se le pone scroll interno propio como ultimo recurso,
                // asi ningun item queda inalcanzable.
                var alturaNatural = entry.inner.getBoundingClientRect().height;
                var alturaDisponible = window.innerHeight - (2 * MARGIN_VIEWPORT_PX);

                if (alturaNatural > alturaDisponible) {
                    entry.inner.style.top = MARGIN_VIEWPORT_PX + "px";
                    entry.inner.style.maxHeight = alturaDisponible + "px";
                    entry.inner.style.overflowY = "auto";
                } else if (rectTrigger.top + alturaNatural > window.innerHeight - MARGIN_VIEWPORT_PX) {
                    var topAjustado = window.innerHeight - MARGIN_VIEWPORT_PX - alturaNatural;
                    entry.inner.style.top = Math.max(MARGIN_VIEWPORT_PX, topAjustado) + "px";
                }
            }

            function limpiarEstiloFijo(inner) {
                inner.classList.remove("flyout-portal");
                inner.style.position = "";
                inner.style.top = "";
                inner.style.left = "";
                inner.style.margin = "";
                inner.style.zIndex = "";
                inner.style.maxHeight = "";
                inner.style.overflowY = "";
            }

            function cerrarFlyout(entry) {
                // Devuelve el elemento a su lugar original en el DOM (antes del "portal" a body).
                if (entry.inner.parentNode === document.body) {
                    entry.padreOriginal.insertBefore(entry.inner, entry.hermanoSiguienteOriginal);
                }
                limpiarEstiloFijo(entry.inner);
                abiertos = abiertos.filter(function (e) { return e !== entry; });
            }

            sidebar.querySelectorAll(".nav-item > .collapse").forEach(function (collapseEl) {
                var inner = collapseEl.querySelector(".collapse-inner");
                if (!inner) return;

                collapseEl.addEventListener("show.bs.collapse", function () {
                    if (!enModoFlyout()) return;
                    var entry = {
                        collapseEl: collapseEl,
                        inner: inner,
                        padreOriginal: inner.parentNode,
                        hermanoSiguienteOriginal: inner.nextSibling
                    };
                    document.body.appendChild(inner);
                    inner.classList.add("flyout-portal");
                    ubicarFlyout(entry);
                    abiertos.push(entry);
                });

                collapseEl.addEventListener("hidden.bs.collapse", function () {
                    var entry = abiertos.filter(function (e) { return e.collapseEl === collapseEl; })[0];
                    if (entry) cerrarFlyout(entry);
                });

                // Si cambia el ancho de pantalla mientras esta abierto (rotar el telefono,
                // redimensionar la ventana), evita que quede "pegado" en una posicion vieja.
                window.addEventListener("resize", function () {
                    if (!collapseEl.classList.contains("show")) return;
                    var entry = abiertos.filter(function (e) { return e.collapseEl === collapseEl; })[0];
                    if (!entry) return;
                    if (enModoFlyout()) {
                        ubicarFlyout(entry);
                    } else {
                        // Bootstrap Collapse maneja el cierre real; esto solo limpia el portal.
                        cerrarFlyout(entry);
                    }
                });
            });

            // Cierra el/los flyout abiertos al tocar/clickear afuera de ellos (y de su propio
            // trigger, para no cerrarlo y reabrirlo en el mismo click). Solo aplica a los que
            // estan en modo flyout -- el accordion expandido de escritorio sigue con su
            // comportamiento normal (se cierra clickeando el mismo item, como toda la vida).
            function alTocarAfuera(e) {
                if (abiertos.length === 0) return;
                abiertos.slice().forEach(function (entry) {
                    if (entry.inner.contains(e.target)) return;
                    var trigger = sidebar.querySelector('[data-bs-target="#' + entry.collapseEl.id + '"]');
                    if (trigger && trigger.contains(e.target)) return;

                    var instancia = window.bootstrap && window.bootstrap.Collapse
                        ? window.bootstrap.Collapse.getOrCreateInstance(entry.collapseEl)
                        : null;
                    if (instancia) {
                        instancia.hide();
                    } else {
                        cerrarFlyout(entry);
                    }
                });
            }
            document.addEventListener("click", alTocarAfuera, true);
            document.addEventListener("touchstart", alTocarAfuera, { passive: true, capture: true });
        })();
    </script>

