            <li class="nav-item">
                <a class="nav-link @(controller == "Ventas" && action != "POS" ? "active" : "")" href="@Url.Action("Index", "Ventas")">
                    <i class="fas fa-fw fa-cash-register"></i>
                    <span>Ventas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(controller == "Ventas" && action == "POS" ? "active" : "")" href="@Url.Action("POS", "Ventas")">
                    <i class="fas fa-fw fa-store"></i>
                    <span>Punto de Venta</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(controller == "Cajas" && action == "CajasAbiertas" ? "active" : "")" href="@Url.Action("CajasAbiertas", "Cajas")">
                    <i class="fas fa-fw fa-file-invoice-dollar"></i>
                    <span>Cierre de Caja</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Elaborados")">
                    <i class="fas fa-fw fa-drumstick-bite"></i>
                    <span>Elaborados</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Movimientos")">
                    <i class="fas fa-fw fa-exchange-alt"></i>
                    <span>Movimientos</span>
                </a>
