    @* Toggle de tema oscuro -- port literal de Web/Views/Shared/_LayoutBase.cshtml (mismas
       claves de localStorage: "carnisys-theme"/"darkMode", mismo id de boton/icono). *@
    <script>
        (function () {
            const STORAGE_KEY = "carnisys-theme";

            function setTheme(mode) {
                const isDark = mode === "dark";
                document.documentElement.classList.toggle("dark-mode", isDark);
                document.body.classList.toggle("dark-mode", isDark);

                var btn = document.getElementById("btnToggleTheme");
                var ico = document.getElementById("icoTheme");
                if (btn && ico) {
                    ico.className = isDark ? "fas fa-sun" : "fas fa-moon";
                    btn.title = isDark ? "Activar modo claro" : "Activar modo oscuro";
                    btn.setAttribute("aria-label", btn.title);
                }

                try {
                    localStorage.setItem(STORAGE_KEY, mode);
                    localStorage.setItem("darkMode", isDark ? "true" : "false");
                } catch (e) { }
            }

            document.addEventListener("DOMContentLoaded", function () {
                var saved = "light";
                try {
                    saved = localStorage.getItem(STORAGE_KEY) || (localStorage.getItem("darkMode") === "true" ? "dark" : "light");
                } catch (e) { }

                setTheme(saved);

                var btn = document.getElementById("btnToggleTheme");
                if (btn) {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        var current = "light";
                        try {
                            current = localStorage.getItem(STORAGE_KEY) || (document.body.classList.contains("dark-mode") ? "dark" : "light");
                        } catch (err) { }
                        setTheme(current === "dark" ? "light" : "dark");
                    });
                }
            });
        })();
    </script>

    @* Toggle a modo iconos del sidebar (2026-09-04, adaptado 2026-09-05 a los nombres de clase
       reales del clasico -- ".sidebar"/".toggled"/"#sidebarToggle") -- vanilla JS, no depende del
       orden de carga de jQuery. *@
    <script>
        (function () {
            var STORAGE_KEY = "carnisys-sidebar-collapsed";
            var sidebar = document.querySelector(".sidebar");
            var toggleBtn = document.getElementById("sidebarToggle");
            if (!sidebar || !toggleBtn) return;

            // Titulos accesibles cuando el sidebar queda en modo iconos -- se generan del texto
            // visible de cada link en vez de escribirlos a mano en las 20+ filas del menu.
            sidebar.querySelectorAll(".nav-link").forEach(function (link) {
                if (link.hasAttribute("title")) return;
                var span = link.querySelector("span");
                var texto = (span ? span.textContent : link.textContent || "").trim();
                if (texto) link.setAttribute("title", texto);
            });

            function applyCollapsed(collapsed) {
                sidebar.classList.toggle("toggled", collapsed);
                document.documentElement.classList.remove("sidebar-toggled-pref");
            }

            var collapsedGuardado = false;
            try {
                collapsedGuardado = localStorage.getItem(STORAGE_KEY) === "1";
            } catch (e) { }

            applyCollapsed(collapsedGuardado);

            toggleBtn.addEventListener("click", function () {
                var collapsed = !sidebar.classList.contains("toggled");
                applyCollapsed(collapsed);
                try {
                    localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
                } catch (e) { }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Gap real cerrado 2026-09-05 (ver docs/DECISIONS.md), port de Web/Views/Shared/_LayoutBase.cshtml
       (lineas 1144-1180). Todo controller portado hasta ahora ya setea TempData["AlertType"/"Title"/
       "Msg"] tras un guardado/error (fidelidad de logica) pero _Layout.cshtml nunca lo leia -- el
       usuario guardaba algo y no veia ningun feedback visual. Mismo mecanismo exacto: SweetAlert2
       (ya cargado arriba), auto-cierre a los 2s solo para "success", CustomEvent "layoutAlertClosed"
       preservado por si alguna vista lo necesita mas adelante (Productos/AddOrEdit "carga continua"
       en el original). *@
    @if (TempData["AlertMsg"] != null)
    {
        <script>
        (function () {
            var type = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertType"] as string ?? "info"))";
            var title = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertTitle"] as string ?? "Aviso"))";
            var msg = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["AlertMsg"] as string ?? ""))";

            var opts = { icon: type, title: title, text: msg };
            if (type === 'success') {
                opts.timer = 2000;
                opts.timerProgressBar = true;
                opts.showConfirmButton = true;
            }

            function avisarCerrado() {
                document.dispatchEvent(new CustomEvent('layoutAlertClosed'));
            }

            if (window.Swal) {
                Swal.fire(opts).then(avisarCerrado);
            } else {
                alert(title + "\n\n" + msg);
                avisarCerrado();
            }
        })();
        </script>
    }
