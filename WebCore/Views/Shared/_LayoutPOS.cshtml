@*
    Port simplificado de Web/Views/Shared/_LayoutPOS.cshtml para la UI de POS (batch 1+2, ver
    docs/10-migracion-aspnet-core/PLAN-POS-UI.md). Diferencia deliberada que sigue vigente:
      - Sin el dropdown de usuario/logout/"Cambiar clave"/modal de sesion expirada/KeepAlive (no
        pedido, fuera de alcance -- ver docs/DECISIONS.md 2026-09-07).
    Scripts: solo los que necesita el batch 1+2 (jquery/bootstrap, SweetAlert2, pos-guard.js). Se
    van agregando mas a medida que avanzan los batches (forma-pago.js en el 3, balanza en el 4,
    etc.) -- no se precargan de una sola vez para no arrastrar dependencias de features que todavia
    no existen en esta vista.

    Topbar por modulo + marca real (2026-09-07, pedido explicito del usuario, ver docs/DECISIONS.md):
    port literal de Web/Views/Shared/_LayoutPOS.cshtml -- color de fondo distinto para Ventas/POS
    (azul) vs PuntosExpendio/POS (ambar/rojizo), y el nombre real de la empresa (o el
    label/valor que el controller haya seteado via ViewBag.PosBrandLabel/PosBrandName, como hace
    PuntosExpendioController.POS con el sector elegido) en vez del texto fijo "CarniSys" que tenia
    esta vista antes de que existiera login/sesion real.
*@
@inject WebCore.Services.IUsuarioSesionService Sesion
@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var posBrandLabel = ViewBag.PosBrandLabel as string;
    var posBrandName = ViewBag.PosBrandName as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>CarniSys | Punto de Venta</title>

    <script>
        (function () {
            try {
                if (localStorage.getItem("carnisys-theme") === "dark") {
                    document.documentElement.classList.add("dark-mode");
                }
            } catch (e) { }
        })();
    </script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        html.dark-mode, html.dark-mode body {
            background: #0f1724 !important;
            color: rgba(255,255,255,.92);
        }

        html.dark-mode {
            color-scheme: dark;
        }
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Shim de compatibilidad Bootstrap 4 -> 5, ver docs/DECISIONS.md (2026-09-04) y
       WebCore/wwwroot/Content/css/bootstrap4-compat.css para el detalle. *@
    <link rel="stylesheet" href="~/Content/css/bootstrap4-compat.css" asp-append-version="true" />
    @* Bug real (2026-09-07, ver docs/DECISIONS.md "Mis actividades: tabla duplicada sin
       estructura"): los modales de Egresos/Mis actividades/Mis ventas que se cargan por AJAX
       dentro del POS (_MisEgresosCaja.cshtml, _EgresosCajaTabla.cshtml, _MisVentas.cshtml) usan
       clases (.egresos-*, .egreso-card, .egresos-tabla-desktop/.egresos-cards-mobile) definidas
       en custom.css -- que _Layout.cshtml (el layout del resto de la app) SI carga, pero este
       layout de POS nunca cargo. Sin custom.css, la regla que oculta la vista de tarjetas movil
       cuando se ve la tabla de escritorio (".egresos-cards-mobile { display:none }") nunca se
       aplicaba: ambas estructuras (tabla + tarjetas) se mostraban apiladas para los mismos datos. *@
    <link rel="stylesheet" href="~/Content/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/pos.css" asp-append-version="true" />
    <!-- UI de Expendios (ver docs/10-migracion-aspnet-core/PLAN-POS-EXPENDIOS-UI.md): reglas
         propias ".pos-expendio-*"/"#modalSectoresPuntoExpendio", no pisan nada de Ventas/POS. -->
    <link rel="stylesheet" href="~/Content/css/pos-expendio.css" asp-append-version="true" />

    <style>
        /* ===== TOPBAR: color por modulo + marca real (2026-09-07, pedido explicito del usuario --
           ver docs/DECISIONS.md) -- port literal de Web/Views/Shared/_LayoutPOS.cshtml. Reemplaza
           el header fijo "CarniSys" con fondo azul unico que tenia WebCore (simplificacion
           deliberada de cuando este layout no tenia sesion real todavia, ver comentario de
           cabecera de este archivo) -- Venta reusa el gradiente del sidebar (azul), Expendio usa
           ambar/rojizo (#b45309), igual que el clasico, con variantes de la misma luminosidad en
           modo oscuro para que ningun modulo "pese" mas que el otro visualmente. */
        .card-header.pos-header-venta {
            background: linear-gradient(180deg, #3a4e67 0%, #243446 100%);
        }

        .card-header.pos-header-expendio {
            background: linear-gradient(180deg, #b45309 0%, #92400e 100%);
        }

        body.dark-mode .card-header.pos-header-venta {
            background: linear-gradient(180deg, #0d1f44 0%, #0b1730 100%) !important;
        }

        body.dark-mode .card-header.pos-header-expendio {
            background: linear-gradient(180deg, #3a2410 0%, #241708 100%) !important;
        }

        .pos-layout-brand {
            display: inline-flex;
            align-items: center;
            min-width: 0;
            max-width: 320px;
        }

        .pos-layout-brand .pos-brand-shell {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            min-width: 0;
        }

        .pos-layout-brand .pos-brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #fff3e8 0%, #ffe0c1 100%);
            color: #b45309;
            border: 1px solid rgba(180, 83, 9, .16);
            flex: 0 0 auto;
        }

        .pos-layout-brand .pos-brand-copy {
            min-width: 0;
            text-align: left;
        }

        .pos-layout-brand .pos-brand-label {
            font-size: .64rem;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: rgba(255,255,255,.78);
            margin-bottom: .18rem;
        }

        .pos-layout-brand .pos-empresa {
            font-weight: 800;
            color: #fff;
            min-width: 0;
            font-size: 1rem;
            line-height: 1.1;
        }

        body.dark-mode .pos-layout-brand .pos-brand-mark {
            background: linear-gradient(135deg, rgba(203,109,50,.18) 0%, rgba(203,109,50,.30) 100%);
            border-color: rgba(255,255,255,.08);
            color: #ffd7be;
        }

        body.dark-mode .pos-layout-brand .pos-brand-label {
            color: #97a7bd;
        }

        body.dark-mode .pos-layout-brand .pos-empresa {
            color: #ecf2ff;
        }

        @@media (max-width: 991.98px) {
            .pos-layout-brand {
                max-width: 200px;
            }

            .pos-layout-brand .pos-brand-shell {
                gap: .38rem;
            }

            .pos-layout-brand .pos-brand-mark {
                width: 28px;
                height: 28px;
            }
        }

        .topbar-icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 !important;
        }

        .topbar-icon-btn:hover {
            background: rgba(255,255,255,.14);
            text-decoration: none;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        #pos-layout-content {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        nav.card-header {
            flex: 0 0 auto;
        }

        #pos-container {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
            padding: 0;
            background-color: #f8f9fc;
        }

        body.dark-mode #pos-container {
            background-color: #1d293a !important;
        }

        @@media (min-width: 992px) {
            html, body {
                overflow: hidden !important;
            }

            #pos-container {
                overflow: hidden !important;
            }
        }

        @@media (max-width: 991.98px) {
            html, body {
                overflow: auto !important;
            }

            #pos-container {
                overflow: visible !important;
            }
        }
    </style>
</head>
<body id="page-top">
    <div id="pos-layout-content">
        <nav class="card-header bg-primary text-white d-flex justify-content-between align-items-center @(controller == "PuntosExpendio" ? "pos-header-expendio" : "pos-header-venta")">
            <div class="pos-layout-brand">
                <div class="pos-brand-shell">
                    <div class="pos-brand-mark">
                        <i class="fas fa-store-alt"></i>
                    </div>
                    <div class="pos-brand-copy">
                        <div class="pos-brand-label">@(string.IsNullOrWhiteSpace(posBrandLabel) ? "Punto de venta" : posBrandLabel)</div>
                        <div class="pos-empresa text-truncate">
                            @(!string.IsNullOrWhiteSpace(posBrandName) ? posBrandName : (Sesion.UsuarioActual?.Empresa?.NombreFantasia ?? ""))
                        </div>
                    </div>
                </div>
            </div>

            <a href="#" id="btnToggleTheme" class="nav-link topbar-icon-btn" title="Cambiar tema">
                <i id="icoTheme" class="fas fa-moon text-light"></i>
            </a>
        </nav>

        <div id="pos-container">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/app/bootstrap4-compat.js?v=2"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/app/swal-single-confirm.js?v=2"></script>
    <script src="~/Scripts/app/pos-guard.js?v=4"></script>

    <script>
        window.buscarProductoUrl = '@Url.Action("BuscarProducto", "Ventas")';
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            const STORAGE_KEY = "carnisys-theme";

            function setTheme(mode) {
                const isDark = (mode === "dark");
                document.documentElement.classList.toggle("dark-mode", isDark);
                document.body.classList.toggle("dark-mode", isDark);

                const ico = document.getElementById("icoTheme");
                if (ico) ico.className = isDark ? "fas fa-sun" : "fas fa-moon";

                try { localStorage.setItem(STORAGE_KEY, mode); } catch (e) { }
            }

            document.addEventListener("DOMContentLoaded", function () {
                setTheme(localStorage.getItem(STORAGE_KEY) || "light");

                const btn = document.getElementById("btnToggleTheme");
                if (btn) {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        setTheme((localStorage.getItem(STORAGE_KEY) || "light") === "dark" ? "light" : "dark");
                    });
                }
            });
        })();
    </script>
</body>
</html>
