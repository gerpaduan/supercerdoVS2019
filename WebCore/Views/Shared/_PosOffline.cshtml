@*
    POS sin conexion (2026-11-27), incluido por _Layout y _LayoutPOS en toda pantalla con sesion iniciada.
    - Disponible (freno de emergencia sin accionar y tabla posclaveunica en la base): registra sw-pos.js, prepara la PC
      (catalogo y usuarios; renueva su vigencia) y sube lo pendiente (Scripts/app/pos-offline-online.js). En Ventas/POS
      ademas muestra el indicador y el aviso de corte.
    - Freno de emergencia accionado: desregistra el service worker, borra sus caches y las claves guardadas (la cola de
      ventas sin subir se conserva).
    Ver docs/DECISIONS.md "POS sin conexion" y docs/03-modulos/ventas-y-pos.md.
*@
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider VersionArchivos
@inject WebCore.Services.IUsuarioSesionService Sesion
@{
    var usuario = User?.Identity?.IsAuthenticated == true && Sesion.EstaAutenticado ? Sesion.UsuarioActual : null;
    bool disponible = usuario != null && usuario.IdSucursal > 0
        && WebCore.Helpers.PosOfflineDisponibilidad.Disponible(Sesion.Empresa);

    bool esPos = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Ventas", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"] as string, "POS", StringComparison.OrdinalIgnoreCase);
    string baseApp = (Context.Request.PathBase.Value ?? "").TrimEnd('/') + "/";

    // Version de la cache del service worker = huella de los archivos de la pagina offline: cambia cuando se publica uno
    // nuevo (asi la PC baja la version nueva) y no cambia si no se toco nada.
    string versionOffline = "";
    string claveLogin = "";
    if (disponible)
    {
        var archivos = new[]
        {
            "/pos-offline.html", "/Scripts/app/pos-offline-db.js", "/Scripts/app/pos-offline-red.js",
            "/Scripts/app/pos-offline-buscar.js", "/Scripts/app/pos-offline-pin.js", "/Scripts/app/pos-offline-vigencia.js",
            "/Scripts/app/pos-offline-sync.js", "/Scripts/app/pos-offline-ticket.js", "/Scripts/app/pos-offline-app.js",
            "/Scripts/carnisys.balanza.js", "/lib/bootstrap/dist/css/bootstrap.min.css", "/sw-pos.js"
        };
        string huellas = string.Join("|", archivos.Select(a => VersionArchivos.AddFileVersionToPath(Context.Request.PathBase, a)));
        versionOffline = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(huellas))).Substring(0, 12);
        claveLogin = usuario!.Id + "|" + usuario.IdSucursal + "|" + (User!.FindFirst(WebCore.Infrastructure.SesionClaims.MomentoLogin)?.Value ?? "");
    }
}
@if (disponible)
{
    <div id="posOfflineDatos" hidden
         data-login="@claveLogin"
         data-pos-instance="@(ViewBag.PosInstanceId as string ?? "")"
         data-sw-url="@(baseApp)sw-pos.js?v=@versionOffline"
         data-sw-scope="@(baseApp)Ventas/POS"></div>
    if (esPos)
    {
        <style>
            /* Lugar: pos-offline-online.js lo mete en el panel derecho del POS, debajo de "Conexion balanza" (.en-panel), asi
               no tapa nada. Fijo arriba al centro solo si ese panel no existe (POS sin caja, detras del modal de apertura). */
            .pos-offline-estado { position: fixed; top: 4px; left: 50%; transform: translateX(-50%); z-index: 1040;
                max-width: min(460px, 46vw); font-size: 0.7rem; line-height: 1.2; background: #fff; color: #212529; border: 1px solid #dee2e6;
                border-radius: 12px; padding: 2px 4px 2px 8px; box-shadow: 0 1px 3px rgba(0,0,0,.15); display: flex; gap: 6px; align-items: center; }
            .pos-offline-estado::before { content: ""; flex: 0 0 8px; height: 8px; border-radius: 50%; background: #adb5bd; }
            .pos-offline-estado.listo::before { background: #198754; }
            .pos-offline-estado.pendiente::before { background: #fd7e14; }
            .pos-offline-estado [data-texto] { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
            .pos-offline-estado .btn { font-size: 0.68rem; padding: 0 6px; white-space: nowrap; border-radius: 10px; }
            .pos-offline-resultado { position: fixed; top: 32px; left: 50%; transform: translateX(-50%); z-index: 1040;
                max-width: min(460px, 92vw); font-size: 0.75rem; background: #fff8e1; color: #212529; border: 1px solid #ffe08a; border-radius: 6px; padding: 6px 8px; }
            /* Celular: solo el punto de color y el boton (el texto completo queda en el title). */
            @@media (max-width: 576px) { .pos-offline-estado:not(.en-panel) [data-texto] { display: none; } }
            .pos-offline-estado.en-panel, .pos-offline-resultado.en-panel { position: static; transform: none; max-width: none; margin-top: 4px; }
            .pos-offline-estado.en-panel { box-shadow: none; display: inline-flex; }
            .pos-offline-estado.en-panel [data-texto] { white-space: normal; }
            .pos-offline-corte { position: fixed; top: 0; left: 0; right: 0; z-index: 1060; background: #b02a37; color: #fff;
                padding: 6px 12px; font-size: 0.85rem; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
            .pos-offline-corte[hidden] { display: none; }
            .pos-offline-corte .btn { font-size: 0.8rem; padding: 2px 8px; }
        </style>
        <div id="posOfflineCorte" class="pos-offline-corte" role="alert" hidden>
            <strong>SIN CONEXIÓN</strong>
            <span data-causa></span>
            <span>La venta en curso queda guardada en esta PC.</span>
            <button type="button" class="btn btn-light" data-ir-offline hidden>Seguir vendiendo sin conexión</button>
        </div>
        <div id="posOfflineResultado" class="pos-offline-resultado" hidden></div>
        <div id="posOfflineEstado" class="pos-offline-estado">
            <span data-texto>Preparando el modo sin conexión…</span>
            <button type="button" class="btn btn-outline-secondary" data-ir-offline title="Abrir el POS sin conexión">Modo sin conexión</button>
        </div>
    }
    <script src="~/Scripts/app/pos-offline-db.js" asp-append-version="true"></script>
    <script src="~/Scripts/app/pos-offline-red.js" asp-append-version="true"></script>
    <script src="~/Scripts/app/pos-offline-vigencia.js" asp-append-version="true"></script>
    <script src="~/Scripts/app/pos-offline-sync.js" asp-append-version="true"></script>
    <script src="~/Scripts/app/pos-offline-online.js" asp-append-version="true"></script>
}
else if (usuario != null && !WebCore.Helpers.PosOfflineSettings.Habilitado)
{
    <script src="~/Scripts/app/pos-offline-db.js" asp-append-version="true"></script>
    <script>
        // Freno de emergencia: se quita el service worker del POS, sus caches y las claves guardadas en esta PC.
        (function () {
            if (!('serviceWorker' in navigator)) return;
            navigator.serviceWorker.getRegistrations().then(function (regs) {
                var propios = regs.filter(function (r) {
                    return ((r.active || r.waiting || r.installing || {}).scriptURL || '').indexOf('sw-pos.js') >= 0;
                });
                if (!propios.length) return;
                propios.forEach(function (r) { r.unregister(); });
                if (window.PosOfflineDb) {
                    window.PosOfflineDb.borrar('catalogo').catch(function () { });
                    window.PosOfflineDb.borrar('sesion').catch(function () { });
                    window.PosOfflineDb.borrar('preparado').catch(function () { });
                }
                if (window.caches && caches.keys) {
                    caches.keys().then(function (ks) {
                        ks.filter(function (k) { return k.indexOf('pos-offline-') === 0; }).forEach(function (k) { caches.delete(k); });
                    }).catch(function () { });
                }
            }).catch(function () { });
        })();
    </script>
}
