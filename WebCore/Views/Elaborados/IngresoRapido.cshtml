@model WebCore.Models.ElaboradoRapidoIndexVm
@using System
@using System.Globalization

@{
    ViewBag.Title = Model.Titulo;
    string successMessage = TempData["ElaboradosSuccessMessage"] as string ?? "";
}

<div class="container-fluid px-2 px-md-3 elaborados-page" data-elaborados-page="ingreso-rapido-lista">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div id="elaboradosSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    @* Pantalla de seleccion (Ingreso rapido y Desarme): a proposito NO usa el diseño compacto del resto del sistema (pedido
       2026-11-02, ver docs/DECISIONS.md). Desde 768 px la tarjeta de filtro y la tabla comparten un bloque del 50% de ancho,
       alineado a la izquierda, con filas altas para elegir con doble clic. Estilos al final de esta vista. *@
    <div class="elaborados-rapido-bloque">
    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
                <div class="mr-3 mb-2">
                    <h4 class="mb-1">@Model.Titulo</h4>
                    <p class="text-muted mb-0">@Model.Descripcion</p>
                </div>
                @if (Model.EsDesarme)
                {
                    <span class="badge badge-info px-3 py-2 text-uppercase">Modo desarme</span>
                }
                else
                {
                    <span class="badge badge-primary px-3 py-2 text-uppercase">Modo ingreso rapido</span>
                }
            </div>

            <div class="elaborados-filtros-grid elaborados-filtros-grid-rapido">
                <div class="form-group mb-0">
                    <label class="elaborados-filtro-label" for="filtroRapidoTexto">Producto o codigo</label>
                    <input id="filtroRapidoTexto" type="text" class="form-control" autocomplete="off" placeholder="Buscar por nombre o codigo" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm elaborados-panel-card">
        <div class="card-body p-0">
            @* En celular (<768px) cada elaborado se muestra como tarjeta (CSS compartido wwwroot/Content/css/tabla-cards.css, ver
               docs/DECISIONS.md 2026-10-27): el nombre encabeza la tarjeta con el codigo tenue a la derecha y el boton Seleccionar
               ocupa todo el ancho al pie. Sirve igual para Ingreso rapido y para Desarme (misma vista). *@
            <div class="table-responsive">
                @* Columnas "Ingreso rapido" (siempre Si) y "Formula" (siempre Cargada) quitadas: el listado solo trae elaborados con
                   ingreso rapido activo y formula (ElaboradosController.CrearItemIngresoRapido), asi que no distinguian nada. *@
                <table class="table table-hover mb-0 rapido-tabla tabla-cards" id="tablaIngresoRapidoLista">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:6rem;">Codigo</th>
                            <th>Elaborado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="js-rapido-row" tabindex="0"
                                data-codigo="@item.Codigo"
                                data-producto="@item.Producto"
                                data-rapido="@(item.IngresoRapido ? "1" : "0")">
                                @* El codigo de la columna solo se ve en la tabla; en la tarjeta va en el titulo (cc-titulo-extra). *@
                                <td class="cc-solo-tabla">@item.Codigo</td>
                                <td class="cc-titulo">
                                    <div class="font-weight-bold cc-titulo-linea">@item.Producto<span class="cc-solo-card cc-titulo-extra">cód @item.Codigo</span></div>
                                    @if (!string.IsNullOrWhiteSpace(item.Receta))
                                    {
                                        <div class="small text-muted text-truncate fw-normal">@item.Receta</div>
                                    }
                                </td>
                                @* En escritorio esta celda se oculta por CSS (se elige con doble clic o Enter sobre la fila) pero el enlace sigue en el
                                   DOM: lo usa elaborados-rapido.js para saber a donde ir. En celular es el boton al pie de la tarjeta. *@
                                <td class="elaborados-table-actions cc-acciones">
                                    <a class="btn btn-sm cc-accion-principal @(Model.EsDesarme ? "btn-outline-info" : "btn-outline-primary")"
                                       href="@Url.Action("EditarIngresoRapido", "Elaborados", new { idElaborado = item.IdCorte, esDesarme = Model.EsDesarme })">
                                        Seleccionar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="sinResultadosRapidos" class="text-center text-muted py-4 d-none">
                No hay productos que coincidan con el filtro actual.
            </div>
        </div>
    </div>
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

<style>
    @@media (min-width: 768px) {
        .elaborados-rapido-bloque {
            width: 50%;
            min-width: 26rem;
            max-width: 100%;
            margin-right: auto;
        }

        /* Filas altas y letra comoda para elegir rapido con doble clic. user-select: no queda el texto marcado al hacer doble clic. */
        .rapido-tabla > tbody > tr {
            cursor: pointer;
            user-select: none;
        }

        .rapido-tabla > tbody > tr > td {
            padding: .95rem 1rem;
            font-size: 1rem;
            line-height: 1.25;
            vertical-align: middle;
        }

        .rapido-tabla > tbody > tr > td.cc-solo-tabla {
            color: var(--ui-text-muted, #6c757d);
        }

        .rapido-tabla > tbody > tr > td.cc-acciones {
            display: none;
        }

        .rapido-tabla > tbody > tr:focus-visible {
            outline: 2px solid var(--ui-accent, #4e73df);
            outline-offset: -2px;
        }

        .elaborados-rapido-bloque .elaborados-filtros-card .form-control {
            min-height: 2.75rem;
            font-size: 1rem;
        }
    }
</style>

@section Scripts {
    <script>
        window.elaboradosRapidoListaConfig = {
            mostrarTodosInicial: false
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/elaborados-rapido.js")" asp-append-version="true"></script>
}
