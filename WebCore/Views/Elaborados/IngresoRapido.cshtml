@model WebCore.Models.ElaboradoRapidoIndexVm
@using System
@using System.Globalization

@{
    ViewBag.Title = Model.Titulo;
    string successMessage = TempData["ElaboradosSuccessMessage"] as string ?? "";
}

<div class="container-fluid px-2 px-md-3 elaborados-page" data-elaborados-page="ingreso-rapido-lista">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div id="elaboradosSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    @* Pantalla de seleccion (Ingreso rapido y Desarme): a proposito NO usa el diseño compacto del resto del sistema.
       2026-11-12: la tabla en un bloque del 50% se reemplazo por una grilla de tarjetas (maqueta aprobada por el usuario,
       ver docs/DECISIONS.md). Cada tarjeta es un enlace a EditarIngresoRapido; elaborados-rapido.js filtra, resalta la
       coincidencia y deja Enter abriendo la tarjeta resaltada (la primera al escribir). Estilos al final de esta vista. *@
    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start mb-2">
                <div class="mr-3 mb-2">
                    <h4 class="mb-1">@Model.Titulo</h4>
                    <p class="text-muted mb-0">@Model.Descripcion</p>
                </div>
                @if (Model.EsDesarme)
                {
                    <span class="badge badge-info px-3 py-2 text-uppercase">Modo desarme</span>
                }
                else
                {
                    <span class="badge badge-primary px-3 py-2 text-uppercase">Modo ingreso rapido</span>
                }
            </div>

            <label class="sr-only" for="filtroRapidoTexto">Producto o codigo</label>
            <div class="rapido-buscador">
                <i class="fas fa-search rapido-buscador-icono" aria-hidden="true"></i>
                <input id="filtroRapidoTexto" type="text" class="form-control" autocomplete="off" placeholder="Escribí nombre o código" />
            </div>
            <div class="rapido-ayuda-teclas text-muted">
                <span><kbd>Enter</kbd> abre el resaltado</span>
                <span><kbd>&larr;</kbd> <kbd>&rarr;</kbd> <kbd>&uarr;</kbd> <kbd>&darr;</kbd> mueven</span>
                <span><kbd>Esc</kbd> limpia</span>
                <span id="contadorRapidos" class="ml-auto" aria-live="polite"></span>
            </div>
        </div>
    </div>

    <div class="rapido-grilla" id="grillaIngresoRapido">
        @foreach (var item in Model.Items)
        {
            <a class="rapido-tarjeta js-rapido-row @(Model.EsDesarme ? "rapido-desarme" : "")"
               href="@Url.Action("EditarIngresoRapido", "Elaborados", new { idElaborado = item.IdCorte, esDesarme = Model.EsDesarme })"
               data-codigo="@item.Codigo"
               data-producto="@item.Producto"
               data-tono="@(item.Codigo % 4)">
                <span class="rapido-inicial" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.Producto) ? "?" : item.Producto.Trim().Substring(0, 1).ToUpperInvariant())</span>
                <span class="rapido-textos">
                    <span class="rapido-nombre js-rapido-nombre">@item.Producto</span>
                    <span class="rapido-detalle">
                        <span>Cód <span class="js-rapido-cod">@item.Codigo</span></span>@if (!string.IsNullOrWhiteSpace(item.Receta)){<span> · @item.Receta</span>}
                    </span>
                </span>
                <kbd class="rapido-enter" aria-hidden="true">Enter</kbd>
            </a>
        }
    </div>
    <div id="sinResultadosRapidos" class="rapido-vacio text-muted d-none">
        Ningún elaborado coincide con «<span id="sinResultadosRapidosTexto"></span>». Probá con otra parte del nombre o el código.
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

<style>
    .rapido-buscador { position: relative; }
    .rapido-buscador .form-control { min-height: 2.9rem; font-size: 1.05rem; padding-left: 2.5rem; }
    .rapido-buscador-icono { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); color: var(--ui-text-muted, #7a838d); pointer-events: none; }
    .rapido-ayuda-teclas { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-top: .5rem; font-size: .8rem; }
    .rapido-ayuda-teclas kbd { font-size: .7rem; padding: .05rem .35rem; color: var(--ui-text, #1f2937); background: var(--ui-surface-alt, #f3f4f6); border: 1px solid var(--ui-border-strong, #c8d0d9); }

    .rapido-grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .65rem; }

    .rapido-tarjeta {
        display: flex; align-items: center; gap: .7rem; min-height: 4rem; padding: .7rem .8rem;
        color: var(--ui-text, #1f2937); text-decoration: none !important;
        background: var(--ui-surface, #fff); border: 1px solid var(--ui-border, #d7dce3); border-radius: .75rem;
    }
    .rapido-tarjeta:hover { background: var(--ui-surface-alt, #f3f4f6); border-color: var(--ui-border-strong, #c8d0d9); color: var(--ui-text, #1f2937); }
    .rapido-tarjeta:focus-visible { outline: 2px solid var(--ui-primary, #2d5b8f); outline-offset: 2px; }
    .rapido-tarjeta.rapido-activa { border-color: var(--ui-primary, #2d5b8f); box-shadow: 0 0 0 1px var(--ui-primary, #2d5b8f); background: var(--ui-primary-soft, rgba(45, 91, 143, .12)); }

    .rapido-inicial {
        flex: 0 0 auto; width: 2.5rem; height: 2.5rem; border-radius: .6rem;
        display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 1.05rem;
        color: var(--ui-text, #1f2937); background: hsla(160, 55%, 45%, .22);
    }
    .rapido-tarjeta[data-tono="1"] .rapido-inicial { background: hsla(250, 60%, 60%, .22); }
    .rapido-tarjeta[data-tono="2"] .rapido-inicial { background: hsla(15, 70%, 55%, .22); }
    .rapido-tarjeta[data-tono="3"] .rapido-inicial { background: hsla(335, 60%, 55%, .22); }

    .rapido-textos { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; }
    /* Hasta 2 lineas: un nombre largo ("Matambre arrollado con huevo...") no queda cortado de entrada. */
    .rapido-nombre { font-weight: 600; font-size: 1rem; line-height: 1.2; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-word; }
    .rapido-detalle { font-size: .8rem; color: var(--ui-text-muted, #7a838d); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rapido-tarjeta mark { padding: 0 .1rem; border-radius: .15rem; color: inherit; background: rgba(250, 199, 117, .75); }

    /* La marca "Enter" solo se ve en la tarjeta resaltada y solo con teclado fisico (escritorio). */
    .rapido-enter { display: none; flex: 0 0 auto; font-size: .7rem; padding: .05rem .35rem; color: var(--ui-text, #1f2937); background: var(--ui-surface-alt, #f3f4f6); border: 1px solid var(--ui-border-strong, #c8d0d9); }
    @@media (min-width: 768px) { .rapido-tarjeta.rapido-activa .rapido-enter { display: inline-block; } }
    @@media (max-width: 767.98px) { .rapido-ayuda-teclas span:not(#contadorRapidos) { display: none; } }

    .rapido-vacio { text-align: center; padding: 2rem 1rem; border: 1px dashed var(--ui-border-strong, #c8d0d9); border-radius: .75rem; }
</style>

@section Scripts {
    <script>
        window.elaboradosRapidoListaConfig = {
            mostrarTodosInicial: false
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/elaborados-rapido.js")" asp-append-version="true"></script>
}
