@model WebCore.Models.ElaboradoDetalleVm
@using System.Globalization

@{
    var cultura = CultureInfo.GetCultureInfo("es-AR");
}

@if (Model == null)
{
    <div class="text-muted">No se pudieron cargar los detalles del elaborado.</div>
}
else
{
    var sucursal = !string.IsNullOrWhiteSpace(Model.Sucursal) ? Model.Sucursal : "-";
    var tieneObservaciones = !string.IsNullOrWhiteSpace(Model.Observaciones);
    var tieneReceta = !string.IsNullOrWhiteSpace(Model.Receta);
    var tieneEstado = !string.IsNullOrWhiteSpace(Model.Estado);
    var fechaCreacion = Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm") : "";
    var fechaActualizacion = Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "";
    bool fueModificado = !string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) || fechaActualizacion != "";
    bool hayIngredientes = Model.IngredientesUtilizados != null && Model.IngredientesUtilizados.Count > 0;
    float totalKgs = 0f;
    if (hayIngredientes)
    {
        foreach (var ing in Model.IngredientesUtilizados) { totalKgs += ing.Kgs; }
    }

    @* Celular (<768px, 2026-10-27): la franja de chips (abajo) se oculta porque repite lo de la tarjeta del elaborado; aca quedan solo
       las observaciones (si hay). La receta NO: solo se usa en las cargas (pedido del usuario). Los ingredientes son una lista compacta
       (tabla-cards-lista). *@
    if (tieneObservaciones)
    {
        <div class="cc-nota-detalle"><span><i class="fas fa-comment-alt"></i>@Model.Observaciones</span></div>
    }

    @* Desktop (2026-11-12, tabla-compacta.css): franja de chips con lo esencial en lugar de la tarjeta lateral de datos
       (el elaborado y su codigo ya estan en la fila de arriba). *@
    <div class="det-head">
        <span class="det-chip chip-id"><i class="fas fa-hashtag"></i><b>@Model.Id</b></span>
        @if (tieneEstado)
        {
            <span class="det-chip chip-out"><i class="fas fa-ban"></i><b>@Model.Estado</b></span>
        }
        <span class="det-chip" title="Sucursal"><i class="fas fa-store"></i><b>@sucursal</b></span>
        @if (tieneReceta)
        {
            <span class="det-chip"><i class="fas fa-book"></i><span class="k">Receta</span> <b>@Model.Receta</b></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.UsuarioCreacion) || fechaCreacion != "")
        {
            <span class="det-chip"><i class="fas fa-user-plus"></i><span class="k">Creó</span> <b>@(!string.IsNullOrWhiteSpace(Model.UsuarioCreacion) ? Model.UsuarioCreacion : "-")</b> <span class="k">@fechaCreacion</span></span>
        }
        @if (fueModificado)
        {
            <span class="det-chip chip-mod"><i class="fas fa-pen"></i><span class="k">Modificó</span> <b>@(!string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) ? Model.UsuarioActualizacion : "-")</b> <span class="k">@fechaActualizacion</span></span>
        }
    </div>

    @if (tieneObservaciones)
    {
        <div class="det-obs"><i class="fas fa-comment-alt"></i><div>@Model.Observaciones</div></div>
    }

    @* Formula secreta (2026-10-04): con la formula visible (hay elevacion) se ofrece "Ocultar". *@
    @if (Model.FormulaSecreta && !Model.FormulaOculta)
    {
        <div class="mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary js-ocultar-formula-detalle" data-id-corte="@Model.IdCorte">
                <i class="fas fa-eye-slash mr-1"></i> Ocultar fórmula
            </button>
        </div>
    }

    @* Ingredientes: columnas compactas (Cód. 15 · Producto 25 · Kgs 8, ver tabla-compacta.css) y total al pie. *@
    <div class="det-lineas elaborado-detalle-lineas">
        <table class="table table-sm mb-0 tabla-cards tabla-cards-lista">
            <thead>
                <tr>
                    <th class="tc-cod">Cód.</th>
                    <th class="tc-prod">Ingrediente utilizado</th>
                    <th class="text-right tc-kg">Kgs</th>
                    <th class="text-center tc-ico">Balanza</th>
                </tr>
            </thead>
            <tbody>
                @* Con la fórmula oculta se listan solo los ingredientes cargados a mano; los de la
                   fórmula secreta quedan resumidos en la fila del candado (ver ConstruirDetalleElaborado). *@
                @if (Model.IngredientesUtilizados != null)
                {
                    foreach (var linea in Model.IngredientesUtilizados)
                    {
                        <tr>
                            <td class="cc-l-cod tc-cod"><span class="cc-solo-card">Cód. </span>@(linea.Codigo > 0 ? linea.Codigo.ToString() : "-")</td>
                            <td class="cc-l-prod tc-prod">@(!string.IsNullOrWhiteSpace(linea.Producto) ? linea.Producto : "-")</td>
                            <td class="text-right cc-l-kg tc-kg">@linea.Kgs.ToString("N3", cultura)</td>
                            @* Balanza: icono (azul = pesado en balanza, gris tenue = no). *@
                            <td class="text-center cc-l-bal cc-l-ultimo tc-ico">
                                <i class="fas fa-balance-scale @(linea.PesoBalanza ? "text-primary" : "cc-ico-off")" role="img"
                                   aria-label="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"
                                   title="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"></i>
                            </td>
                        </tr>
                    }
                }

                @if (Model.FormulaOculta)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            <i class="fas fa-lock mr-1"></i> Ingredientes de la fórmula secreta ocultos.
                            <button type="button" class="btn btn-sm btn-outline-primary ml-2 js-ver-formula-detalle" data-id-embutido="@Model.Id">
                                <i class="fas fa-key mr-1"></i> Ver fórmula
                            </button>
                        </td>
                    </tr>
                }
                else if (!hayIngredientes)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No se encontraron ingredientes utilizados.</td>
                    </tr>
                }
            </tbody>
            @if (hayIngredientes && !Model.FormulaOculta)
            {
                @* Total de los ingredientes mostrados (con la formula oculta seria parcial: no se muestra). Solo desktop. *@
                <tfoot>
                    <tr>
                        <td colspan="2">Total ingredientes · @Model.IngredientesUtilizados.Count línea@(Model.IngredientesUtilizados.Count == 1 ? "" : "s")</td>
                        <td class="tc-kg">@totalKgs.ToString("N3", cultura)</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
