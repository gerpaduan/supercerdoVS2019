@model WebCore.Models.ElaboradoFormulasIndexVm
@using System

@{
    ViewBag.Title = "Formulas";
    string successMessage = TempData["ElaboradosSuccessMessage"] as string ?? "";
}

<div class="container-fluid px-2 px-md-3 elaborados-page">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div id="formulasSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @Html.Partial("~/Views/Elaborados/_Tabs.cshtml", Model.Tabs)

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div></div>
        @if (Model.PuedeCrear)
        {
            <a class="btn btn-primary btn-sm" href="@Url.Action("EditarFormula", "Elaborados", new { id = 0 })">
                <i class="fas fa-plus mr-1"></i> Nueva formula
            </a>
        }
    </div>

    <div class="card shadow-sm mb-3 elaborados-filtros-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Formulas", "Elaborados")">
                <div class="elaborados-filtros-grid elaborados-filtros-grid-formula">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="descripcion">Elaborado</label>
                        <input id="descripcion" name="descripcion" type="text" class="form-control" value="@Model.Descripcion" />
                    </div>

                    <div class="form-group mb-0 elaborados-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-outline-primary btn-block">
                            <i class="fas fa-search mr-1"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-end align-items-center mb-2">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="switchVistaCompletaFormulas">
            <label class="custom-control-label" for="switchVistaCompletaFormulas">Ver detalles</label>
        </div>
    </div>

    <div class="card shadow-sm elaborados-panel-card">
        <div class="card-body p-0">
            @* En celular (<768px) cada formula se muestra como tarjeta (CSS compartido wwwroot/Content/css/tabla-cards.css, ver
               docs/DECISIONS.md 2026-10-27): el elaborado encabeza la tarjeta con el #id tenue a la derecha y el detalle desplegable
               queda pegado debajo (cc-fila-detalle). En desktop no cambia nada. *@
            <div class="table-responsive tabla-full">
                <table class="table table-bordered table-hover mb-0 elaborados-table-compact tabla-cards">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:110px;">Id</th>
                            <th style="width:110px;">Codigo</th>
                            <th>Elaborado</th>
                            <th style="width:160px;">Creado</th>
                            <th style="width:160px;">Actualizado</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No se encontraron formulas para los filtros seleccionados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                var detalle = Model.Detalles != null && Model.Detalles.ContainsKey(item.IdFormula)
                                    ? Model.Detalles[item.IdFormula]
                                    : null;
                                var detailId = "detFormula_" + item.IdFormula;

                                <tr>
                                    @* Id y Codigo de las columnas solo se ven en la tabla; en la tarjeta van en el titulo (#id a la derecha, cod debajo). *@
                                    <td class="cc-solo-tabla">@item.IdFormula</td>
                                    <td class="cc-solo-tabla">@item.Codigo</td>
                                    <td class="cc-titulo">
                                        <div class="cc-titulo-linea">
                                            <span>
                                                @item.Elaborado
                                                @if (item.Secreta)
                                                {
                                                    <i class="fas fa-lock text-muted ml-1" title="Fórmula secreta: no se muestra en Ingreso rápido, Carga ni historial sin usuario y contraseña de alguien con permiso."></i>
                                                }
                                            </span>
                                            <span class="cc-solo-card cc-titulo-extra" title="Número de fórmula">#@item.IdFormula</span>
                                        </div>
                                        <div class="cc-solo-card formula-card-codigo">cód @item.Codigo</div>
                                    </td>
                                    <td data-label="Creado">@item.Creado</td>
                                    <td data-label="Actualizado">@item.Actualizado<span class="cc-solo-card">@(string.IsNullOrWhiteSpace(item.Actualizado) ? "-" : "")</span></td>
                                    <td class="text-left text-nowrap elaborados-table-actions cc-acciones">
                                        @if (Model.PuedeEditar)
                                        {
                                            <a class="btn btn-sm btn-outline-primary cc-accion-principal" href="@Url.Action("EditarFormula", "Elaborados", new { id = item.IdFormula })" title="Ver formula">
                                                <i class="fas fa-eye"></i><span class="cc-solo-card"> Ver</span>
                                            </a>
                                        }
                                        @if (Model.PuedeEliminar)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger js-eliminar-formula" data-id="@item.IdFormula" data-nombre="@item.Elaborado" title="Eliminar formula">
                                                <i class="fas fa-trash"></i><span class="cc-solo-card"> Eliminar</span>
                                            </button>
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-link text-decoration-none btn-detalles-formula"
                                                data-target="#@detailId"
                                                aria-expanded="false"
                                                aria-controls="@detailId"
                                                title="Detalles">
                                            <i class="fas fa-chevron-down"></i><span class="cc-solo-card"> Detalles</span>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="cc-fila-detalle">
                                    <td colspan="6" class="p-0">
                                        <div id="@detailId" class="collapse formula-detalle-collapse">
                                            <div class="p-3 bg-light border-top elaborados-formula-detail-wrap">
                                                @if (detalle == null)
                                                {
                                                    <div class="text-muted">No se pudieron cargar los detalles de la formula.</div>
                                                }
                                                else
                                                {
                                                    @* Celular: la receta va arriba de la lista (el resto de la tarjeta de datos ya esta en la tarjeta de la formula)
                                                       y los ingredientes son una lista compacta (variante tabla-cards-lista): ingrediente y % arriba, codigo y rayo de
                                                       Auto abajo. En desktop siguen siendo columnas con Si/No. *@
                                                    <div class="row align-items-start">
                                                        <div class="col-12 col-xl-8 order-2 order-xl-1">
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-bordered mb-0 elaborados-table-compact tabla-cards tabla-cards-lista">
                                                                    <thead class="thead-light">
                                                                        <tr>
                                                                            <th style="width:120px;">Codigo</th>
                                                                            <th>Ingrediente</th>
                                                                            <th class="text-right" style="width:120px;">%</th>
                                                                            <th class="text-center" style="width:90px;" title="Auto activado: el ingrediente se agrega solo al guardar el Elaborado, calculado como % de lo cargado a mano. Auto desactivado: hay que cargarlo a mano en el Elaborado.">Auto</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @if (detalle.Lineas == null || detalle.Lineas.Count == 0)
                                                                        {
                                                                            <tr>
                                                                                <td colspan="4" class="text-center text-muted">No hay ingredientes cargados.</td>
                                                                            </tr>
                                                                        }
                                                                        else
                                                                        {
                                                                            foreach (var linea in detalle.Lineas)
                                                                            {
                                                                                <tr>
                                                                                    <td class="cc-l-cod"><span class="cc-solo-card">Cód. </span>@linea.Codigo</td>
                                                                                    <td class="cc-l-prod">@linea.Producto</td>
                                                                                    <td class="text-right cc-l-kg">@linea.Porcentaje.ToString("N2")</td>
                                                                                    @* Auto: en celular un rayo (verde = se agrega solo al guardar el elaborado, gris tenue = a mano); en desktop Si/No. *@
                                                                                    <td class="text-center cc-l-bal cc-l-ultimo">
                                                                                        <span class="cc-solo-tabla">@(linea.AgregarAuto ? "Si" : "No")</span>
                                                                                        <i class="cc-solo-card fas fa-bolt @(linea.AgregarAuto ? "text-success" : "cc-ico-off")" role="img"
                                                                                           aria-label="@(linea.AgregarAuto ? "Auto: se agrega solo al guardar el elaborado" : "Manual: se carga a mano en el elaborado")"
                                                                                           title="@(linea.AgregarAuto ? "Auto: se agrega solo al guardar el elaborado" : "Manual: se carga a mano en el elaborado")"></i>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 col-xl-4 order-1 order-xl-2 mb-3 mb-xl-0 @(string.IsNullOrWhiteSpace(detalle.Receta) ? "formula-meta-sin-receta" : "")">
                                                            <div class="elaborados-detail-meta-card formula-meta-card">
                                                                <div class="elaborados-detail-meta-row formula-meta-solo-desktop">
                                                                    <span class="text-muted d-block">Elaborado</span>
                                                                    <span class="font-weight-bold">@detalle.Elaborado</span>
                                                                </div>
                                                                <div class="elaborados-detail-meta-row formula-meta-solo-desktop">
                                                                    <span class="text-muted d-block">Codigo</span>
                                                                    <span class="font-weight-bold">@detalle.Codigo</span>
                                                                </div>
                                                                <div class="elaborados-detail-meta-row">
                                                                    <span class="text-muted d-block">Receta</span>
                                                                    <span class="font-weight-bold">@(!string.IsNullOrWhiteSpace(detalle.Receta) ? detalle.Receta : "-")</span>
                                                                </div>
                                                                <div class="elaborados-detail-meta-row formula-meta-solo-desktop">
                                                                    <span class="text-muted d-block">Creado</span>
                                                                    <span class="font-weight-bold">@detalle.CreadoPor | @detalle.Creado</span>
                                                                </div>
                                                                <div class="elaborados-detail-meta-row mb-0 formula-meta-solo-desktop">
                                                                    <span class="text-muted d-block">Actualizado</span>
                                                                    <span class="font-weight-bold">@detalle.ActualizadoPor | @detalle.Actualizado</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Elaborados/_Styles.cshtml")

<style>
    /* Codigo del elaborado debajo del nombre en la tarjeta (solo celular, ver .cc-solo-card en tabla-cards.css). */
    .elaborados-page .formula-card-codigo {
        font-size: .72rem;
        font-weight: 400;
        color: #6c757d;
        line-height: 1.1;
        margin-top: .12rem;
    }

    /* Celular: la tarjeta de la formula ya muestra elaborado, codigo, creado y actualizado, asi que el detalle deja solo la
       receta (y sin marco); si no hay receta no queda nada que mostrar y se oculta el bloque entero. */
    @@media (max-width: 767.98px) {
        .elaborados-page .formula-meta-solo-desktop,
        .elaborados-page .formula-meta-sin-receta {
            display: none;
        }

        .elaborados-page .formula-meta-card {
            border: 0;
            background: transparent;
            padding: 0;
            height: auto;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var successAlert = document.getElementById('formulasSuccessAlert');
            if (successAlert) {
                window.setTimeout(function () { $(successAlert).alert('close'); }, 3000);
            }

            function syncIcon(button, expanded) {
                if (!button) return;
                button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                var icon = button.querySelector('i');
                if (icon) {
                    icon.classList.toggle('fa-chevron-down', !expanded);
                    icon.classList.toggle('fa-chevron-up', expanded);
                }
            }

            document.addEventListener('click', function (e) {
                var btnDetalle = e.target.closest('.btn-detalles-formula');
                if (btnDetalle) {
                    e.preventDefault();
                    var selector = btnDetalle.getAttribute('data-target');
                    var detalle = selector ? document.querySelector(selector) : null;
                    if (!detalle) return;
                    var expanded = detalle.classList.contains('show');
                    $(detalle).collapse(expanded ? 'hide' : 'show');
                    syncIcon(btnDetalle, !expanded);
                    return;
                }

                var btnEliminar = e.target.closest('.js-eliminar-formula');
                if (!btnEliminar) return;
                e.preventDefault();

                var ejecutar = function () {
                    $.ajax({
                        url: '@Url.Action("EliminarFormula", "Elaborados")',
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token ? token.value : '',
                            idFormula: btnEliminar.getAttribute('data-id')
                        }
                    }).done(function (resp) {
                        if (!resp || !resp.ok) {
                            if (window.Swal) Swal.fire('Error', (resp && resp.mensaje) || 'No se pudo eliminar la formula.', 'error');
                            else alert((resp && resp.mensaje) || 'No se pudo eliminar la formula.');
                            return;
                        }
                        window.location.href = resp.redirectUrl || '@Url.Action("Formulas", "Elaborados")';
                    }).fail(function (xhr) {
                        var msg = 'No se pudo eliminar la formula.';
                        if (xhr && xhr.responseJSON && xhr.responseJSON.mensaje) msg = xhr.responseJSON.mensaje;
                        if (window.Swal) Swal.fire('Error', msg, 'error');
                        else alert(msg);
                    });
                };

                var nombre = btnEliminar.getAttribute('data-nombre') || 'la formula';
                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Eliminar formula',
                        text: 'Esta seguro que desea eliminar la formula de ' + nombre + '?',
                        showCancelButton: true,
                        confirmButtonText: 'Si, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then(function (result) {
                        if (result.isConfirmed) ejecutar();
                    });
                } else if (window.confirm('Esta seguro que desea eliminar la formula de ' + nombre + '?')) {
                    ejecutar();
                }
            });

            document.addEventListener('dblclick', function (e) {
                if (e.target.closest('a, button')) return;
                var row = e.target.closest('tr');
                if (!row) return;
                var btnDetalle = row.querySelector('.btn-detalles-formula');
                if (btnDetalle) btnDetalle.click();
            });

            var switchVista = document.getElementById('switchVistaCompletaFormulas');
            if (switchVista) {
                switchVista.addEventListener('change', function () {
                    var expandir = switchVista.checked;
                    document.querySelectorAll('.formula-detalle-collapse').forEach(function (detalle) {
                        $(detalle).collapse(expandir ? 'show' : 'hide');
                        var btn = document.querySelector('.btn-detalles-formula[data-target="#' + detalle.id + '"]');
                        syncIcon(btn, expandir);
                    });
                });
            }
        })();
    </script>
}
