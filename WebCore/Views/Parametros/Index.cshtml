@model WebCore.Models.ParametrosEmpresaIndexVm
@using System.Linq

@{
    ViewBag.Title = "Parámetros";

    var mensajesValidacion = ViewData.ModelState.Values
        .SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();
}

<div class="container-fluid parametros-index-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Parámetros de la empresa</h1>
            <p class="text-muted mb-0">Configuración particular de la empresa actual, basada en el catálogo general del sistema.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (mensajesValidacion.Any())
            {
                <div class="alert alert-danger">
                    <ul class="mb-0 pl-3">
                        @foreach (var mensaje in mensajesValidacion)
                        {
                            <li>@mensaje</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MensajePermiso))
            {
                <div class="alert @(Model.PuedeAdministrar ? "alert-info" : "alert-secondary")">
                    @Model.MensajePermiso
                </div>
            }

            <form asp-controller="Parametros" asp-action="Guardar" method="post" id="formParametrosEmpresa" novalidate="novalidate">
                @Html.AntiForgeryToken()

                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 220px;">Parámetro</th>
                                <th>Descripción</th>
                                <th style="width: 140px;">Tipo</th>
                                <th style="width: 260px;">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items == null || Model.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No hay parámetros configurados para mostrar.</td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Html.HiddenFor(m => m.Items[i].IdParametro)
                                            @Html.HiddenFor(m => m.Items[i].Nombre)
                                            @Html.HiddenFor(m => m.Items[i].Descripcion)
                                            @Html.HiddenFor(m => m.Items[i].Tipo)
                                            @Html.HiddenFor(m => m.Items[i].TipoDescripcion)
                                            <strong>@Model.Items[i].Nombre</strong>
                                        </td>
                                        <td>@Model.Items[i].Descripcion</td>
                                        <td>
                                            <span class="badge badge-light border">@Model.Items[i].TipoDescripcion</span>
                                        </td>
                                        <td>
                                            @if (Model.Items[i].Tipo == 2)
                                            {
                                                <div class="custom-control custom-switch mt-1">
                                                    @Html.CheckBoxFor(m => m.Items[i].ValorBool, new { @class = "custom-control-input", id = "Items_" + i + "__ValorBool" })
                                                    <label class="custom-control-label" for="@("Items_" + i + "__ValorBool")">Activo</label>
                                                </div>
                                                @Html.HiddenFor(m => m.Items[i].Valor)
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(m => m.Items[i].Valor, new { @class = "form-control", autocomplete = "off" })
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex flex-wrap align-items-center">
                    @if (Model.PuedeAdministrar)
                    {
                        <button type="button"
                                class="btn btn-primary mr-2 mb-2"
                                id="btnHabilitarEdicionParametros"
                                data-edit-readonly-ignore="true">
                            <i class="fas fa-edit mr-1"></i> Modificar
                        </button>

                        <button type="submit"
                                class="btn btn-success mr-2 mb-2 @(Model.SoloLecturaInicial ? "d-none" : "")"
                                id="btnGuardarParametros">
                            <i class="fas fa-save mr-1"></i> Guardar
                        </button>
                    }

                    <a class="btn btn-outline-secondary mb-2" href="@Url.Action("Index", "Home")">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .parametros-index-page {
        font-size: .9rem;
    }

    .parametros-index-page .h3 {
        font-size: 1.28rem;
        line-height: 1.15;
    }

    .parametros-index-page .card-body {
        padding: .82rem 1rem;
    }

    .parametros-index-page .alert,
    .parametros-index-page .text-muted,
    .parametros-index-page .form-text,
    .parametros-index-page small {
        font-size: .8rem;
    }

    .parametros-index-page .form-control {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .parametros-index-page .table {
        font-size: .84rem;
    }

    .parametros-index-page .table th,
    .parametros-index-page .table td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .parametros-index-page .table thead th,
    .parametros-index-page .table > thead > tr > th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .parametros-index-page .badge,
    .parametros-index-page .custom-control-label {
        font-size: .76rem;
    }

    .parametros-index-page .btn {
        font-size: .83rem;
        padding: .34rem .65rem;
    }

    .parametros-index-page .btn.btn-sm {
        font-size: .76rem;
        padding: .28rem .5rem;
    }

    @@media (min-width: 1200px) {
        .parametros-index-page .mb-3 {
            margin-bottom: .85rem !important;
        }

        .parametros-index-page .card-body {
            padding: .7rem .85rem;
        }

        .parametros-index-page .form-control {
            font-size: .84rem !important;
            min-height: 2.15rem !important;
            padding: .28rem .54rem !important;
        }

        .parametros-index-page .table {
            font-size: .8rem;
        }

        .parametros-index-page .table thead th,
        .parametros-index-page .table > thead > tr > th {
            font-size: .69rem !important;
        }
    }
</style>

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/edit-readonly.js?v=1")"></script>
    <script>
        window.EditReadOnly && window.EditReadOnly.init({
            formSelector: "#formParametrosEmpresa",
            soloLecturaInicial: @(Model.SoloLecturaInicial ? "true" : "false"),
            modifyButtonSelector: "#btnHabilitarEdicionParametros",
            saveButtonSelector: "#btnGuardarParametros"
        });
    </script>
}
