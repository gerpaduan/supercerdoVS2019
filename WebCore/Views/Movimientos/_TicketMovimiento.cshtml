@model Entidades.Movimiento
@using System
@using System.Text
@{
    // Port literal de Web/Views/Movimientos/_TicketMovimiento.cshtml (2026-09-10, cuarta ronda de
    // pedidos, ver docs/DECISIONS.md "Batch 7: boton Imprimir en Movimientos + ticket termico").
    // Sin cambios de estructura: la primera linea YA es el nombre del movimiento centrado
    // ("Movimiento"), y "Fecha: ..." es parte del bloque de detalle (4ta linea), no un renglon
    // aislado arriba de todo -- verificado generando un ticket real antes de decidir si tocar
    // algo, ver la entrada de DECISIONS.md de este batch.
    Layout = null;

    var lineas = Model.ListaCortesPorMov;
    int ticketMm = ViewBag.TicketMm != null ? (int)ViewBag.TicketMm : 80;
    int cantMaxChar = ticketMm == 58 ? 32 : 43;
    string ticketClass = ticketMm == 58 ? "ticket-58" : "ticket-80";
    int totalUnidades = 0;
    decimal totalKilos = 0m;
    int anchoProducto = cantMaxChar == 32 ? 15 : 22;
    int anchoCant = cantMaxChar == 32 ? 5 : 6;
    int anchoKgs = cantMaxChar == 32 ? 7 : 8;

    Func<string, int, string> truncar = (texto, maximo) =>
    {
        texto = texto ?? "";
        return texto.Length > maximo ? texto.Substring(0, maximo) : texto;
    };

    Func<string, int, string> centrar = (texto, ancho) =>
    {
        texto = truncar(texto, ancho);
        int espaciosIzquierda = (ancho - texto.Length) / 2;
        if (espaciosIzquierda < 0) espaciosIzquierda = 0;
        return new string(' ', espaciosIzquierda) + texto;
    };

    Func<string, string, int, string> alinearExtremos = (izquierda, derecha, ancho) =>
    {
        izquierda = truncar(izquierda, ancho);
        derecha = truncar(derecha, ancho);
        int espacios = ancho - (izquierda.Length + derecha.Length);
        if (espacios < 1) espacios = 1;
        return izquierda + new string(' ', espacios) + derecha;
    };

    Func<string, int, bool, string> ajustarColumna = (texto, ancho, derecha) =>
    {
        texto = truncar(texto, ancho);
        return derecha ? texto.PadLeft(ancho) : texto.PadRight(ancho);
    };

    var sb = new StringBuilder();
    // El texto se escapa a mano porque el <pre> se emite con Html.Raw (para poder usar <b> y el span del codigo).
    Action<string> linea = texto => sb.AppendLine(System.Net.WebUtility.HtmlEncode(texto ?? ""));
    Action<string> lineaNegrita = texto => sb.AppendLine("<b>" + System.Net.WebUtility.HtmlEncode(texto ?? "") + "</b>");
    Action<string> lineaCodigo = texto => sb.AppendLine("<span class=\"ticket-cod\">" + System.Net.WebUtility.HtmlEncode(texto ?? "") + "</span>");

    // Movimiento, Origen y Destino en negrita (pedido del usuario 2026-09-30; igual que el ticket del agente).
    lineaNegrita(centrar("Movimiento", cantMaxChar));
    linea(truncar("ID: " + Model.IdMovimiento, cantMaxChar));
    lineaNegrita(truncar("Origen: " + (Model.SucursalOrigen != null ? Model.SucursalOrigen.SucursalNombre : "-"), cantMaxChar));
    lineaNegrita(truncar("Destino: " + (Model.SucursalDestino != null ? Model.SucursalDestino.SucursalNombre : "-"), cantMaxChar));
    linea(truncar("Fecha: " + Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm"), cantMaxChar));
    linea(" ");
    linea(ajustarColumna("Producto", anchoProducto, false) + " " + ajustarColumna("Cant.", anchoCant, true) + "    " + ajustarColumna("Kgs.", anchoKgs, true));
    linea(new string('-', cantMaxChar));

    if (lineas != null)
    {
        foreach (var item in lineas)
        {
            if (item == null)
            {
                continue;
            }

            string nombreProducto = item.Corte != null ? item.Corte.CorteDesc : "";
            string codigoProducto = item.Corte != null ? item.Corte.Codigo.ToString() : "";
            string cantidadTexto = item.CantUnidad.ToString();
            string kilosTexto = Convert.ToDecimal(item.CantKg).ToString("N3");

            totalUnidades += item.CantUnidad;
            totalKilos += Convert.ToDecimal(item.CantKg);

            linea(ajustarColumna(nombreProducto, anchoProducto, false) + " " + ajustarColumna(cantidadTexto, anchoCant, true) + "    " + ajustarColumna(kilosTexto, anchoKgs, true));
            lineaCodigo(ajustarColumna("Cod:" + codigoProducto, anchoProducto, false));
        }
    }

    linea(new string('-', cantMaxChar));
    linea(ajustarColumna("Total", anchoProducto, false) + " " + ajustarColumna(totalUnidades.ToString(), anchoCant, true) + "    " + ajustarColumna(totalKilos.ToString("N3"), anchoKgs, true));

    if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        linea("");
        linea("Observaciones:");
        string observacion = Model.Observaciones ?? "";
        for (int i = 0; i < observacion.Length; i += cantMaxChar)
        {
            linea(observacion.Substring(i, Math.Min(cantMaxChar, observacion.Length - i)));
        }
    }

    // Firma de control: 3 lineas en blanco y una linea para escribir el nombre de quien controlo el movimiento.
    linea(" ");
    linea(" ");
    linea(" ");
    const string rotuloControlado = "Controlado por: ";
    linea(rotuloControlado + new string('_', Math.Max(4, cantMaxChar - rotuloControlado.Length)));

    string ticketTexto = sb.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Movimiento @Model.IdMovimiento</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #fff;
        }

        body {
            font-family: Consolas, "Courier New", monospace;
            color: #000;
        }

        .ticket-80 {
            width: 80mm;
            font-size: 12px;
        }

        .ticket-58 {
            width: 58mm;
            font-size: 11px;
        }

        /* Codigo de producto: mas chico y gris claro (en la termica va en fuente B, sin color). */
        .ticket-cod {
            font-size: 0.8em;
            color: #9a9a9a;
        }

        pre.ticket-text {
            margin: 0;
            padding: 2mm;
            white-space: pre-wrap;
            line-height: 1.15;
            box-sizing: border-box;
            text-align: left;
        }
    </style>
</head>
<body class="@ticketClass" onload="if (window.top === window) window.print()">
    <pre class="ticket-text">@Html.Raw(ticketTexto)</pre>

    @for (int i = 0; i < 10; i++)
    {
        <pre class="ticket-line">&nbsp;</pre>
    }
</body>
</html>
