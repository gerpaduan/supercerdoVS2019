@model WebCore.Models.MovimientoDetalleVm

@{
    var observaciones = !string.IsNullOrWhiteSpace(Model.Observaciones) ? Model.Observaciones : "-";
    var creadoPor = !string.IsNullOrWhiteSpace(Model.CreadoPor) ? Model.CreadoPor : "-";
    var fechaCreacion = Model.Creado.HasValue ? Model.Creado.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var actualizadoPor = !string.IsNullOrWhiteSpace(Model.ActualizadoPor) ? Model.ActualizadoPor : "-";
    var fechaActualizacion = Model.Actualizado.HasValue ? Model.Actualizado.Value.ToString("dd/MM/yyyy HH:mm") : "-";
}

@* Observaciones: en celular la tarjeta de datos del registro se oculta, asi que se muestran aca solo si hay texto. *@
@if (!string.IsNullOrWhiteSpace(Model.Observaciones))
{
    <div class="movimiento-detalle-obs"><i class="fas fa-comment-alt mr-1"></i>@Model.Observaciones</div>
}

<div class="row movimiento-detalle-layout">
    <div class="col-12 col-xl-8 order-2 order-xl-1">
        @* En celular (<768px) las lineas se muestran como una lista compacta dentro de una tarjeta (CSS compartido
           wwwroot/Content/css/tabla-cards.css, variante tabla-cards-lista): producto y kilos arriba, codigo y unidades abajo, y
           Balanza / Permitir ingreso como iconos (en desktop siguen siendo columnas con Si/No). *@
        <div class="table-responsive mt-3 mt-xl-0">
            <table class="table table-sm table-bordered mb-0 tabla-cards tabla-cards-lista">
                <thead class="thead-light">
                    <tr>
                        <th style="width:110px;">Código</th>
                        <th>Producto</th>
                        <th class="text-right" style="width:110px;">Cantidad</th>
                        <th class="text-right" style="width:110px;">Kilos</th>
                        <th class="text-center" style="width:90px;">Balanza</th>
                        <th class="text-center" style="width:120px;">Permitir ingreso</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lineas == null || Model.Lineas.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay líneas para este movimiento.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td class="cc-l-cod"><span class="cc-solo-card">Cód. </span>@linea.Codigo</td>
                                <td class="cc-l-prod">@linea.Producto</td>
                                <td class="text-right cc-l-cant">@linea.CantUnidad<span class="cc-solo-card"> un.</span></td>
                                <td class="text-right cc-l-kg">@linea.CantKg.ToString("N3")<span class="cc-solo-card"> kg</span></td>
                                @* Balanza: en celular un icono (azul = pesado en balanza, gris tenue = no); en desktop Si/No. *@
                                <td class="text-center cc-l-bal">
                                    <span class="cc-solo-tabla">@(linea.PesoBalanza ? "Sí" : "No")</span>
                                    <i class="cc-solo-card fas fa-balance-scale @(linea.PesoBalanza ? "text-primary" : "cc-ico-off")" role="img"
                                       aria-label="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"
                                       title="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"></i>
                                </td>
                                @* Permitir ingreso: el operador forzo la linea aunque los kilos no coincidian con las unidades
                                   (movimientos.js, validarRelacionCantidadKilos). Icono verde = autorizado, gris tenue = normal. *@
                                <td class="text-center cc-l-ing">
                                    <span class="cc-solo-tabla">@(linea.PermitirIngreso ? "Sí" : "No")</span>
                                    <i class="cc-solo-card fas fa-user-shield @(linea.PermitirIngreso ? "text-success" : "cc-ico-off")" role="img"
                                       aria-label="@(linea.PermitirIngreso ? "Ingreso permitido: línea autorizada aunque los kilos no coincidían" : "Ingreso normal")"
                                       title="@(linea.PermitirIngreso ? "Ingreso permitido: línea autorizada aunque los kilos no coincidían" : "Ingreso normal")"></i>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12 col-xl-4 order-1 order-xl-2">
        <div class="movimiento-detalle-meta-card">
            <div class="movimiento-detalle-meta-row"><span class="text-muted">ID del registro:</span> <span class="font-weight-bold">@Model.IdMovimiento</span></div>
            <div class="movimiento-detalle-meta-row"><span class="text-muted">Observaciones:</span> <span class="font-weight-bold">@observaciones</span></div>
            <div class="movimiento-detalle-meta-row"><span class="text-muted">Quien lo creo:</span> <span class="font-weight-bold">@creadoPor</span></div>
            <div class="movimiento-detalle-meta-row"><span class="text-muted">Fecha de creacion:</span> <span class="font-weight-bold">@fechaCreacion</span></div>
            <div class="movimiento-detalle-meta-row"><span class="text-muted">Quien lo actualizo:</span> <span class="font-weight-bold">@actualizadoPor</span></div>
            <div class="movimiento-detalle-meta-row mb-0"><span class="text-muted">Fecha de actualizacion:</span> <span class="font-weight-bold">@fechaActualizacion</span></div>
        </div>
    </div>
</div>

<style>
    .movimiento-detalle-layout {
        align-items: flex-start;
    }

    .movimiento-detalle-meta-card {
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        background: #fff;
        padding: .85rem .95rem;
    }

    .movimiento-detalle-meta-row {
        margin-bottom: .45rem;
        line-height: 1.2;
    }

    html.dark-mode .movimiento-detalle-meta-card,
    body.dark-mode .movimiento-detalle-meta-card {
        background: #111827;
        border-color: #374151;
        color: #f3f4f6;
    }

    html.dark-mode .movimiento-detalle-meta-card .text-muted,
    body.dark-mode .movimiento-detalle-meta-card .text-muted {
        color: #9ca3af !important;
    }

    .movimiento-detalle-obs {
        display: none;
    }

    /* Celular: la tarjeta de datos del registro (id, creo, actualizo) se oculta: el id ya va junto a la fecha del movimiento
       y el resto no lo busca el usuario ahi. Las observaciones, si hay, salen arriba de las lineas. */
    @@media (max-width: 767.98px) {
        .movimiento-detalle-meta-card {
            display: none;
        }

        .movimiento-detalle-obs i {
            margin-right: .35rem;
        }

        .movimiento-detalle-obs {
            display: block;
            margin-bottom: .6rem;
            font-size: .82rem;
            color: var(--ui-text-soft, #5f6772);
        }
    }

    @@media (min-width: 1200px) {
        .movimiento-detalle-meta-card {
            position: sticky;
            top: .25rem;
        }
    }
</style>
