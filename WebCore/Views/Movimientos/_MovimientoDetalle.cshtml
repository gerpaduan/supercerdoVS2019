@model WebCore.Models.MovimientoDetalleVm

@{
    var tieneObservaciones = !string.IsNullOrWhiteSpace(Model.Observaciones);
    var fechaCreacion = Model.Creado.HasValue ? Model.Creado.Value.ToString("dd/MM/yyyy HH:mm") : "";
    var fechaActualizacion = Model.Actualizado.HasValue ? Model.Actualizado.Value.ToString("dd/MM/yyyy HH:mm") : "";
    bool fueModificado = !string.IsNullOrWhiteSpace(Model.ActualizadoPor) || fechaActualizacion != "";
    bool hayLineas = Model.Lineas != null && Model.Lineas.Count > 0;
    int totalUnidades = 0;
    float totalKilos = 0f;
    if (hayLineas)
    {
        foreach (var l in Model.Lineas) { totalUnidades += l.CantUnidad; totalKilos += l.CantKg; }
    }
}

@* Observaciones: en celular la franja de chips (abajo) se oculta, asi que se muestran aca solo si hay texto. *@
@if (tieneObservaciones)
{
    <div class="movimiento-detalle-obs"><i class="fas fa-comment-alt mr-1"></i>@Model.Observaciones</div>
}

@* Desktop (2026-11-12, tabla-compacta.css): franja de chips (ID, de donde sale -> a donde entra, quien creo / modifico) en lugar
   de la tarjeta lateral de datos; las observaciones, si hay, en un recuadro amarillo. *@
<div class="det-head">
    <span class="det-chip chip-id"><i class="fas fa-hashtag"></i><b>@Model.IdMovimiento</b></span>
    @if (!string.IsNullOrWhiteSpace(Model.Origen))
    {
        <span class="det-chip chip-out" title="Origen: sale mercadería"><i class="fas fa-sign-out-alt"></i><span class="k">Sale de</span> <b>@Model.Origen</b></span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Origen) && !string.IsNullOrWhiteSpace(Model.Destino))
    {
        <i class="fas fa-long-arrow-alt-right text-muted"></i>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Destino))
    {
        <span class="det-chip chip-in" title="Destino: ingresa mercadería"><i class="fas fa-sign-in-alt"></i><span class="k">Entra a</span> <b>@Model.Destino</b></span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CreadoPor) || fechaCreacion != "")
    {
        <span class="det-chip"><i class="fas fa-user-plus"></i><span class="k">Creó</span> <b>@(!string.IsNullOrWhiteSpace(Model.CreadoPor) ? Model.CreadoPor : "-")</b> <span class="k">@fechaCreacion</span></span>
    }
    @if (fueModificado)
    {
        <span class="det-chip chip-mod"><i class="fas fa-pen"></i><span class="k">Modificó</span> <b>@(!string.IsNullOrWhiteSpace(Model.ActualizadoPor) ? Model.ActualizadoPor : "-")</b> <span class="k">@fechaActualizacion</span></span>
    }
</div>

@if (tieneObservaciones)
{
    <div class="det-obs"><i class="fas fa-comment-alt"></i><div>@Model.Observaciones</div></div>
}

@* Lineas: columnas compactas (Cód. 15 · Producto 25 · Unidades 8 · Kilos 8, ver tabla-compacta.css) y total al pie.
   En celular (<768px) las lineas son una lista compacta dentro de una tarjeta (tabla-cards.css, variante tabla-cards-lista):
   producto y kilos arriba, codigo y unidades abajo, y Balanza / Permitir ingreso como iconos. *@
<div class="det-lineas movimiento-detalle-lineas">
    <table class="table table-sm mb-0 tabla-cards tabla-cards-lista">
        <thead>
            <tr>
                <th class="tc-cod">Cód.</th>
                <th class="tc-prod">Producto</th>
                <th class="text-right tc-un">Unidades</th>
                <th class="text-right tc-kg">Kilos</th>
                <th class="text-center tc-ico">Balanza</th>
                <th class="text-center tc-ico" title="Línea autorizada aunque los kilos no coincidían con las unidades">Ingreso permitido</th>
                <th class="tc-hora" title="Fecha y hora en que se cargó la línea al movimiento">Cargada</th>
            </tr>
        </thead>
        <tbody>
            @if (!hayLineas)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No hay líneas para este movimiento.</td>
                </tr>
            }
            else
            {
                foreach (var linea in Model.Lineas)
                {
                    // Hora de carga de la linea (2026-11-11): escritorio, fecha y hora; celular, solo la hora (o fecha y hora en ambar si fue otro dia
                    // que el guardado del movimiento). Vacia en las lineas anteriores al cambio. Mismo criterio que el detalle de Stock y Compras.
                    var horaLinea = WebCore.Helpers.HoraLineaDetalle.Formatear(linea.CreadoTexto, Model.Creado);
                    <tr>
                        <td class="cc-l-cod tc-cod"><span class="cc-solo-card">Cód. </span>@linea.Codigo</td>
                        <td class="cc-l-prod tc-prod">@linea.Producto</td>
                        <td class="text-right cc-l-cant tc-un">@linea.CantUnidad<span class="cc-solo-card"> un.</span></td>
                        <td class="text-right cc-l-kg tc-kg">@linea.CantKg.ToString("N3")<span class="cc-solo-card"> kg</span></td>
                        @* Balanza: icono (azul = pesado en balanza, gris tenue = no). *@
                        <td class="text-center cc-l-bal tc-ico">
                            <i class="fas fa-balance-scale @(linea.PesoBalanza ? "text-primary" : "cc-ico-off")" role="img"
                               aria-label="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"
                               title="@(linea.PesoBalanza ? "Pesado en balanza" : "Sin balanza")"></i>
                        </td>
                        @* Permitir ingreso: el operador forzo la linea aunque los kilos no coincidian con las unidades
                           (movimientos.js, validarRelacionCantidadKilos). Icono verde = autorizado, gris tenue = normal. *@
                        <td class="text-center cc-l-ing tc-ico">
                            <i class="fas fa-user-shield @(linea.PermitirIngreso ? "text-success" : "cc-ico-off")" role="img"
                               aria-label="@(linea.PermitirIngreso ? "Ingreso permitido: línea autorizada aunque los kilos no coincidían" : "Ingreso normal")"
                               title="@(linea.PermitirIngreso ? "Ingreso permitido: línea autorizada aunque los kilos no coincidían" : "Ingreso normal")"></i>
                        </td>
                        <td class="cc-l-hora tc-hora @(horaLinea.OtroDia ? "cc-l-hora-otro-dia" : "") @(horaLinea.Texto == "" ? "cc-vacio" : "")">
                            <span class="cc-solo-tabla">@(!string.IsNullOrWhiteSpace(linea.CreadoTexto) ? linea.CreadoTexto : "-")</span>
                            <span class="cc-solo-card" title="@(horaLinea.OtroDia ? "Cargada otro día que el movimiento" : "Hora de carga")"><i class="far fa-clock"></i>@horaLinea.Texto</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
        @if (hayLineas)
        {
            @* Total: suma de las columnas Unidades y Kilos (solo desktop; en celular el pie se oculta). *@
            <tfoot>
                <tr>
                    <td colspan="2">Total · @Model.Lineas.Count línea@(Model.Lineas.Count == 1 ? "" : "s")</td>
                    <td class="tc-un">@totalUnidades.ToString("N0")</td>
                    <td class="tc-kg">@totalKilos.ToString("N3")</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

<style>
    .movimiento-detalle-obs {
        display: none;
    }

    /* Celular: la franja de chips se oculta (el id ya va junto a la fecha del movimiento). Las observaciones, si hay, salen arriba de las lineas. */
    @@media (max-width: 767.98px) {
        /* La hora de carga va en el renglon de abajo de la tarjeta, entre el codigo y los iconos (con dos iconos, Balanza y Permitir ingreso,
           el area por defecto de .cc-l-hora de tabla-cards.css pisaria al de balanza). contain: la hora no ensancha las columnas de la tarjeta. */
        .movimiento-detalle-lineas table.tabla-cards.tabla-cards-lista > tbody > tr > td.cc-l-hora {
            grid-area: 2 / 2 / 3 / 4;
            contain: inline-size;
        }

        .movimiento-detalle-obs i {
            margin-right: .35rem;
        }

        .movimiento-detalle-obs {
            display: block;
            margin-bottom: .6rem;
            font-size: .82rem;
            color: var(--ui-text-soft, #5f6772);
        }
    }
</style>
