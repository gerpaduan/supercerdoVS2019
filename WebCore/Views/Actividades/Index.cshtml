@model WebCore.Models.ActividadesIndexVm
@{
    ViewData["Title"] = "Actividades";
}
@*
    Modulo "Actividades" (solo admin), 2026-09-07 -- pedido explicito del usuario, ver
    docs/DECISIONS.md. Linea de tiempo unica de eventos de negocio heterogeneos (precio, ventas
    anuladas/bonificadas, egresos, movimientos, compras, formulas), filtro de fecha (max 7 dias,
    default hoy) + paginacion de 30 items armada en el controller (no hay paginacion real en la
    fuente de datos, se trae el rango completo y se pagina en memoria -- volumen bajo dado el tope
    de 7 dias). El link "Ver venta" en los eventos de venta abre Ventas/DetalleVenta?modal=true
    dentro de un modal (accion ya existente, reusada sin cambios de backend).
*@
<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="fas fa-stream mr-2"></i>Actividades</h4>
    </div>

    <div class="card mb-3 shadow-sm p-3">
        <form method="get" action="@Url.Action("Index", "Actividades")" class="d-flex flex-wrap align-items-end" style="gap: .75rem;">
            <div class="form-group mb-0">
                <label for="fechaDesde" class="small mb-1">Desde</label>
                <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@Model.FechaDesde" />
            </div>
            <div class="form-group mb-0">
                <label for="fechaHasta" class="small mb-1">Hasta</label>
                <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@Model.FechaHasta" />
            </div>
            <div class="form-group mb-0">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
            <div class="form-group mb-0 ml-auto text-muted small">
                Máximo 7 días entre "Desde" y "Hasta".
            </div>
        </form>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:150px;">Fecha</th>
                            <th style="width:170px;">Tipo</th>
                            <th>Descripción</th>
                            <th style="width:110px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No hay actividad registrada en el rango seleccionado.</td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge badge-secondary">@item.Tipo</span></td>
                                <td>@item.Descripcion</td>
                                <td class="text-center">
                                    @if (item.IdVenta.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-ver-venta-actividad" data-venta-id="@item.IdVenta">
                                            Ver venta
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= Model.TotalPaginas; p++)
                {
                    <li class="page-item @(p == Model.Pagina ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Actividades", new { fechaDesde = Model.FechaDesde, fechaHasta = Model.FechaHasta, pagina = p })">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="modalDetalleVentaActividad" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="contenedorDetalleVentaActividad"></div>
    </div>
</div>

@section Scripts {
<script>
    $(document).on('click', '.js-ver-venta-actividad', function () {
        var idVenta = $(this).data('venta-id');
        $.get('@Url.Action("DetalleVenta", "Ventas")', { id: idVenta, modal: true })
            .done(function (html) {
                $('#contenedorDetalleVentaActividad').html(html);
                $('#modalDetalleVentaActividad').modal('show');
            })
            .fail(function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo cargar el resumen de la venta.' });
            });
    });
</script>
}
