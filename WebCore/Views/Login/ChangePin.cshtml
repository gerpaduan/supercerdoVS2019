@model WebCore.Models.ChangePinVm
@{
    // Clave rapida (PIN) del propio usuario, con sesion iniciada (2026-10-02, ver docs/DECISIONS.md
    // "Login por CUIT, clave rapida (PIN) y politica de clave"). Corre logueada: usa el _Layout
    // normal (por convencion de _ViewStart.cshtml). El PIN solo vale desde dispositivos autorizados.
    ViewBag.Title = "Clave rápida (PIN)";
}

<div class="container-fluid changepin-page">
    <div class="d-flex flex-wrap align-items-center justify-content-end mb-3">
        <a class="btn btn-outline-secondary mt-2 mt-md-0" href="@Url.Action("Index", "Home")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Clave rápida (PIN)</h5>

                    @if (!string.IsNullOrWhiteSpace(Model.Success))
                    {
                        <div class="alert alert-success">@Model.Success</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="alert alert-danger">@Model.Error</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    @if (Model.EsAdmin)
                    {
                        <div class="alert alert-info mb-0">Los administradores no usan clave rápida: ingresan siempre con su contraseña.</div>
                    }
                    else
                    {
                        <p class="text-muted small">
                            Un PIN de 4 a 6 dígitos para ingresar rápido. <strong>Solo funciona desde dispositivos autorizados</strong>;
                            desde cualquier otro seguís ingresando con tu contraseña. Estado actual:
                            @if (Model.TienePin) { <span class="badge badge-success">Configurado</span> } else { <span class="badge badge-secondary">Sin configurar</span> }
                        </p>

                        <form asp-controller="Login" asp-action="ChangePin" method="post" novalidate="novalidate">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label for="ClaveActual">Contraseña actual</label>
                                @Html.PasswordFor(m => m.ClaveActual, new { @class = "form-control", autocomplete = "current-password" })
                                @Html.ValidationMessageFor(m => m.ClaveActual, "", new { @class = "text-danger small" })
                            </div>

                            <div class="form-group">
                                <label for="NuevoPin">@(Model.TienePin ? "Nuevo PIN" : "PIN")</label>
                                @Html.PasswordFor(m => m.NuevoPin, new { @class = "form-control", autocomplete = "new-password", inputmode = "numeric", maxlength = "6" })
                                @Html.ValidationMessageFor(m => m.NuevoPin, "", new { @class = "text-danger small" })
                            </div>

                            <div class="form-group">
                                <label for="ConfirmarPin">Confirmar PIN</label>
                                @Html.PasswordFor(m => m.ConfirmarPin, new { @class = "form-control", autocomplete = "new-password", inputmode = "numeric", maxlength = "6" })
                                @Html.ValidationMessageFor(m => m.ConfirmarPin, "", new { @class = "text-danger small" })
                            </div>

                            <p class="text-muted small">4 a 6 dígitos. No puede ser una secuencia (1234), todos iguales (1111) ni el número de tu usuario.</p>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-th mr-1"></i> Guardar PIN
                            </button>
                            @if (Model.TienePin)
                            {
                                <button type="submit" name="accion" value="quitar" class="btn btn-outline-danger ml-2">
                                    <i class="fas fa-trash-alt mr-1"></i> Quitar PIN
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .changepin-page { font-size: .9rem; }
    .changepin-page .card-body { padding: .82rem 1rem; }
    .changepin-page .form-control,
    .changepin-page .btn { font-size: .87rem !important; min-height: 2.3rem !important; padding: .32rem .58rem !important; border-radius: .55rem; }
    .changepin-page label,
    .changepin-page .col-form-label { font-size: .8rem; }
    .changepin-page .alert, .changepin-page .small, .changepin-page .text-muted, .changepin-page .form-text { font-size: .8rem !important; }
    @@media (min-width: 1200px) {
        .changepin-page .form-control, .changepin-page .btn { min-height: 2.15rem !important; font-size: .84rem !important; padding: .28rem .56rem !important; }
    }
</style>
