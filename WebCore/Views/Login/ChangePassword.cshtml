@model WebCore.Models.ChangePasswordVm
@{
    // Cambiar clave con sesion ya iniciada (2026-09-10, item 6 de la segunda ronda de pedidos --
    // ver docs/DECISIONS.md). A diferencia de ForgotPassword/ResetPassword (pre-login, layout
    // standalone carnisys-login.css), esta vista corre logueada -- usa el _Layout.cshtml normal
    // con sidebar (por convencion de _ViewStart.cshtml, no hace falta setearlo).
    ViewBag.Title = "Cambiar contraseña";
}

<div class="container-fluid changepassword-page">
    <div class="d-flex flex-wrap align-items-center justify-content-end mb-3">
        <a class="btn btn-outline-secondary mt-2 mt-md-0" href="@Url.Action("Index", "Home")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Cambiar contraseña</h5>

                    @if (!string.IsNullOrWhiteSpace(Model.Success))
                    {
                        <div class="alert alert-success">@Model.Success</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Error))
                    {
                        <div class="alert alert-danger">@Model.Error</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-controller="Login" asp-action="ChangePassword" method="post" novalidate="novalidate">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="ClaveActual">Contraseña actual</label>
                            @Html.PasswordFor(m => m.ClaveActual, new { @class = "form-control", autocomplete = "current-password" })
                            @Html.ValidationMessageFor(m => m.ClaveActual, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label for="NuevaClave">Nueva contraseña</label>
                            @Html.PasswordFor(m => m.NuevaClave, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.NuevaClave, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label for="ConfirmarClave">Confirmar contraseña</label>
                            @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "text-danger small" })
                        </div>

                        <p class="text-muted small">Mínimo 6 caracteres, sin espacios.</p>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-key mr-1"></i> Guardar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
