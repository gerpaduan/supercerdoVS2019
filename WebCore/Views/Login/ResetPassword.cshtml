@model WebCore.Models.PasswordResetVm
@{
    Layout = null;
}
@* Port de Web/Views/Login/ResetPassword.cshtml, adaptado al diseño propio de WebCore
   (carnisys-login.css) -- 2026-09-09, item 1 de los 12 pendientes (Batch E, ver
   docs/DECISIONS.md). Mejora de seguridad deliberada: se saco el texto del clasico "podés
   guardar una clave de 1 o más caracteres" (ya no es cierto -- minimo real de 6, ver
   PasswordResetVm) y se agrega el requisito explicito en su lugar. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color" content="#062d63">
    <title>Restablecer contraseña - CARNISYS</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/carnisys-login.css")" rel="stylesheet" />
</head>
<body class="carnisys-login">
    <main class="login-page">
        <section class="login-brand-panel" aria-label="Acerca de CARNISYS">
            <a href="@Url.Action("Index", "Landing")" class="login-brand" aria-label="Volver al inicio de CARNISYS">
                <img src="@Url.Content("~/Content/img/CarniSys_Login.png")" alt="CARNISYS" />
            </a>

            <div class="brand-content">
                <span class="brand-eyebrow"><i class="fas fa-balance-scale" aria-hidden="true"></i> Gestión pensada para comercios</span>
                <h1>Elegí una<br /><strong>contraseña nueva.</strong></h1>
                <p>Este enlace es de un solo uso y vence a los pocos minutos, por tu seguridad.</p>
            </div>

            <div class="brand-footer">
                <i class="fas fa-store" aria-hidden="true"></i>
                <span>Creado desde la experiencia real de comercio.</span>
            </div>
        </section>

        <section class="login-form-panel" aria-labelledby="reset-title">
            <div class="login-form-wrap">
                <a href="@Url.Action("Index", "Login")" class="back-home"><i class="fas fa-arrow-left" aria-hidden="true"></i> Volver al login</a>

                <div class="login-heading">
                    <span class="login-kicker">Acceso al sistema</span>
                    <h2 id="reset-title">Restablecer contraseña</h2>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                {
                    <div class="login-alert login-alert-error" role="alert"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> @Model.Mensaje</div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-alert login-alert-error" role="alert">
                        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                        @Html.ValidationSummary(false)
                    </div>
                }

                @if (!Model.TokenValido)
                {
                    <div class="login-support">
                        <i class="fas fa-redo" aria-hidden="true"></i>
                        <span><a href="@Url.Action("ForgotPassword", "Login")">Solicitar un nuevo enlace</a></span>
                    </div>
                }
                else
                {
                    <form asp-controller="Login" asp-action="ResetPassword" method="post" class="carnisys-login-form" novalidate="novalidate">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Token)

                        <div class="login-field">
                            @Html.LabelFor(m => m.NuevaClave)
                            <div class="input-shell">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                @Html.PasswordFor(m => m.NuevaClave, new { placeholder = "Nueva contraseña", autocomplete = "new-password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.NuevaClave, "", new { @class = "field-error" })
                        </div>

                        <div class="login-field">
                            @Html.LabelFor(m => m.ConfirmarClave)
                            <div class="input-shell">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                @Html.PasswordFor(m => m.ConfirmarClave, new { placeholder = "Confirmar contraseña", autocomplete = "new-password" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmarClave, "", new { @class = "field-error" })
                        </div>

                        <p class="login-hint">Mínimo 6 caracteres, sin espacios. Te recomendamos combinar mayúsculas, minúsculas y números.</p>

                        <button type="submit" class="login-submit">Guardar nueva contraseña <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js")"></script>
</body>
</html>
