@model WebCore.Models.ReasignarProductosVm

@* Contenido del modal "productos que usan este tipo / esta marca" (Productos > Tipos y Marcas).
   Lo abre Scripts/app/reasignar-productos.js y lo guarda GuardarReasignacionTipo / GuardarReasignacionMarca.
   Las filas sin selector elegido no se modifican. *@
@{
    string campo = Model.Campo ?? "";
    bool esMarca = string.Equals(campo, "Marca", StringComparison.OrdinalIgnoreCase);
    string articulo = esMarca ? "La marca" : "El tipo";
    string destinoPlural = esMarca ? "la nueva marca" : "el nuevo tipo";
    bool hayDestinos = Model.Opciones.Count > 0 || Model.PermiteSinValor;
}

<form action="/" method="post" id="formReasignarProductos"
      data-url="@Model.UrlGuardar"
      data-origen="@Model.OrigenValor">
    @Html.AntiForgeryToken()

    <div class="alert alert-warning">
        @articulo <strong>@Model.OrigenTexto</strong> lo usan <strong>@Model.Items.Count</strong> producto(s), por eso no se puede eliminar todavía.
        Elegí @destinoPlural de cada producto y guardá. Los productos sin selección no se modifican;
        si no queda ninguno, @(esMarca ? "la marca" : "el tipo") se elimina solo.
    </div>

    <div id="reasignarError" class="alert alert-danger d-none"></div>

    @if (!hayDestinos)
    {
        <div class="alert alert-info mb-0">
            No hay @(esMarca ? "otras marcas" : "otros tipos") a los que pasar los productos. Creá uno primero.
        </div>
    }
    else
    {
        <div class="form-row align-items-center mb-2">
            <div class="col-auto">
                <label class="mb-0 mr-1" for="reasignarTodos">Pasar todos a:</label>
            </div>
            <div class="col-12 col-md-5 col-lg-4">
                <select id="reasignarTodos" class="form-control form-control-sm">
                    <option value="">— elegir —</option>
                    @if (Model.PermiteSinValor)
                    {
                        <option value="0">(Sin marca)</option>
                    }
                    @foreach (var opcion in Model.Opciones)
                    {
                        <option value="@opcion.Value">@opcion.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnReasignarAplicarTodos">Aplicar a todos</button>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 55vh; overflow-y: auto;">
            <table class="table table-sm table-hover mb-0" id="tablaReasignar">
                <thead class="thead-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th style="width:110px;">Código</th>
                        <th>Producto</th>
                        <th style="width:22%;">@campo actual</th>
                        <th style="width:30%;">@(esMarca ? "Nueva marca" : "Nuevo tipo")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-id="@item.IdCorte">
                            <td class="text-nowrap">@item.Codigo</td>
                            <td>@item.Producto</td>
                            <td>@item.Actual</td>
                            <td>
                                <select class="form-control form-control-sm js-reasignar-nuevo" aria-label="@(esMarca ? "Nueva marca" : "Nuevo tipo") de @item.Producto">
                                    <option value="">— sin cambio —</option>
                                    @if (Model.PermiteSinValor)
                                    {
                                        <option value="0">(Sin marca)</option>
                                    }
                                    @foreach (var opcion in Model.Opciones)
                                    {
                                        <option value="@opcion.Value">@opcion.Text</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
        @if (hayDestinos)
        {
            <button type="submit" class="btn btn-primary" id="btnGuardarReasignacion">
                <i class="fas fa-save mr-1"></i> Guardar
            </button>
        }
    </div>
</form>
