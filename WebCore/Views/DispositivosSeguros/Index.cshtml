@model WebCore.Models.DispositivosSegurosIndexVm
@{
    ViewBag.Title = "Dispositivos seguros";
}

<div class="container-fluid dispositivos-seguros-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <p class="text-muted mb-0">
                Los dispositivos de esta lista no quedan bloqueados por intentos fallidos de login desde su IP.
                El bloqueo por cuenta (5 errores de contraseña) sigue aplicando igual.
            </p>
        </div>
    </div>

    @if (Model.PuedeAdministrar)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form asp-controller="DispositivosSeguros" asp-action="Agregar" method="post" id="formAgregarDispositivo">
                    @Html.AntiForgeryToken()
                    <div class="row align-items-end">
                        <div class="col-12 col-md-4">
                            <div class="form-group mb-2">
                                <label for="NumeroSerie">
                                    Número de serie
                                    @* Boton "i" (quinta ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md
                                       "Batch 11"): el parrafo explicativo agregado en la ronda anterior
                                       quedaba siempre visible ocupando espacio permanente -- se mueve a un
                                       modal on-demand, mismo patron ya usado en el proyecto para este caso
                                       exacto (Usuarios/Editar.cshtml, #btnInfoLoginFueraSucursal/
                                       #btnInfoUsuarioProduccion). Texto sin cambios, solo cambia donde vive. *@
                                    <button type="button" class="btn btn-sm btn-link p-0 ml-1 align-baseline" data-bs-toggle="modal" data-bs-target="#modalInfoNumeroSerie" title="¿Qué es el número de serie?" tabindex="-1">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </label>
                                <input type="text" class="form-control" id="NumeroSerie" name="numeroSerie" autocomplete="off" placeholder="Se completa solo si el agente de impresión está corriendo" />
                                <small class="form-text text-muted" id="dispositivoAgenteEstado"></small>
                            </div>
                        </div>
                        <div class="col-12 col-md-5">
                            <div class="form-group mb-2">
                                <label for="Descripcion">Descripción</label>
                                <input type="text" class="form-control" id="Descripcion" name="descripcion" autocomplete="off" maxlength="200" placeholder="Ej: PC de administración, Notebook de Juan" />
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="form-group mb-2">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="fas fa-plus mr-1"></i> Agregar
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Número de serie</th>
                            <th>Descripción</th>
                            <th style="width:160px;">Creado</th>
                            <th style="width:160px;">Creado por</th>
                            @if (Model.PuedeAdministrar)
                            {
                                <th style="width:110px;">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay dispositivos seguros registrados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><code>@item.NumeroSerie</code></td>
                                    <td>@item.Descripcion</td>
                                    <td>@item.CreadoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.NombreUsuarioCreador</td>
                                    @if (Model.PuedeAdministrar)
                                    {
                                        <td>
                                            <form asp-controller="DispositivosSeguros" asp-action="Eliminar" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", item.Id)
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este dispositivo de la lista de seguros?');">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Modal de ayuda del boton "i" de arriba (quinta ronda de pedidos, 2026-09-10, ver
   docs/DECISIONS.md "Batch 11"). Mismo texto que antes vivia siempre visible como <small>. *@
<div class="modal fade" id="modalInfoNumeroSerie" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">¿Qué es el número de serie?</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    No es un número que se pueda buscar en la PC a mano -- es un identificador único de esa máquina que solo se obtiene automáticamente si el <strong>agente de impresión CarniSys</strong> está instalado y corriendo ahí. Si un usuario no-admin necesita agregar su propio equipo, puede consultarlo desde el menú de usuario ("Número de serie") y pasártelo para completar este campo.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .dispositivos-seguros-page {
        font-size: .9rem;
    }

    .dispositivos-seguros-page .card-body {
        padding: .82rem 1rem;
    }

    .dispositivos-seguros-page .form-control,
    .dispositivos-seguros-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
        border-radius: .55rem;
    }

    .dispositivos-seguros-page label,
    .dispositivos-seguros-page .col-form-label {
        font-size: .8rem;
    }

    .dispositivos-seguros-page .alert,
    .dispositivos-seguros-page .small,
    .dispositivos-seguros-page .text-muted,
    .dispositivos-seguros-page .form-text {
        font-size: .8rem !important;
    }

    .dispositivos-seguros-page .table {
        font-size: .84rem;
    }

    .dispositivos-seguros-page .table th,
    .dispositivos-seguros-page .table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .dispositivos-seguros-page .table thead th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    @@media (min-width: 1200px) {
        .dispositivos-seguros-page .form-control,
        .dispositivos-seguros-page .btn {
            min-height: 2.15rem !important;
            font-size: .84rem !important;
            padding: .28rem .56rem !important;
        }

        .dispositivos-seguros-page .table {
            font-size: .81rem;
        }

        .dispositivos-seguros-page .table thead th {
            font-size: .69rem !important;
        }
    }
</style>

@* Gap real cerrado 2026-09-10 (cuarta ronda de pedidos, ver docs/DECISIONS.md "Batch 6"): el JS
   de abajo (window.CarniSysPrintAgent.getDeviceId()) ya existia y ya funcionaba en clasico, pero
   nunca se habia portado el script que expone window.CarniSysPrintAgent -- el "if (!window.
   CarniSysPrintAgent) return;" cortaba siempre, en silencio. print-agent.js ahora se carga
   globalmente en _Layout.cshtml (lo necesita tambien el modal de autoservicio del dropdown de
   usuario, _ModalMiDispositivo.cshtml) -- no hace falta incluirlo de nuevo aca. *@
<script>
    // Los scripts de _LayoutBase.cshtml (jQuery incluido) se cargan al final del body, despues
    // del contenido de esta vista -- si esto corriera inline ni jQuery ni window.CarniSysPrintAgent
    // existirian todavia. window.onload espera a que termine de cargar/ejecutar todo lo anterior
    // (no usa jQuery a proposito, para no depender de que ya haya cargado).
    window.addEventListener('load', function () {
        var $numeroSerie = document.getElementById('NumeroSerie');
        var $estado = document.getElementById('dispositivoAgenteEstado');
        if (!$numeroSerie || !window.CarniSysPrintAgent) return;

        window.CarniSysPrintAgent.getDeviceId()
            .done(function (resp) {
                if (resp && resp.ok && resp.deviceId) {
                    $numeroSerie.value = resp.deviceId;
                    if ($estado) $estado.textContent = 'Detectado automáticamente desde el agente de impresión.';
                }
            })
            .fail(function () {
                // Silencioso: el agente no esta instalado/corriendo en esta maquina -- se completa a mano.
            });
    });
</script>
