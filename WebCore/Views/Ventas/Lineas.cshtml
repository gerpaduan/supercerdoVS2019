@section Scripts {
    @* Selector multi-seleccion de Cliente / Vendedor: el modal va ANTES del script del componente (lee de el las URLs). *@
    <partial name="~/Views/Shared/_FiltroPickerModal.cshtml" />
    <script src="@Url.Content("~/Scripts/app/filtro-picker.js")" asp-append-version="true"></script>
    @* Aviso antes de una busqueda pesada: va antes del script de abajo, que usa window.AvisoBusquedaPesada. *@
    <script src="@Url.Content("~/Scripts/app/aviso-busqueda-pesada.js")" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.querySelector('.js-form-filtros-lineas');
            if (!form) return;

            var inputSucursal = document.getElementById('idSucursalVentasLineas');
            var inputFechaDesde = document.getElementById('fechaDesdeVentasLineas');
            var inputFechaHasta = document.getElementById('fechaHastaVentasLineas');
            var alerta = document.getElementById('alertaFiltrosPendientes');
            var estado = document.getElementById('estadoBusquedaVentasLineas');
            var btnBuscar = document.getElementById('btnBuscarVentasLineas');
            var btnTexto = btnBuscar ? btnBuscar.querySelector('.btn-buscar-texto') : null;
            var nativeFormSubmit = window.HTMLFormElement && window.HTMLFormElement.prototype
                ? window.HTMLFormElement.prototype.submit
                : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
            };

            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === 'function') {
                    window.ModalRequestLoading.trackNavigation(message || 'Cargando solicitud...');
                }
            }

            function submitConLoader(mensaje) {
                showNavigationLoading(mensaje || 'Cargando solicitud...');
                window.setTimeout(function () {
                    if (nativeFormSubmit) {
                        nativeFormSubmit.call(form);
                    } else {
                        form.submit();
                    }
                }, 40);
            }

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            function actualizarAviso() {
                if (!alerta) return;
                alerta.classList.toggle('d-none', !hayFechasPendientes());
            }

            function setBuscando(mensaje) {
                if (btnBuscar) btnBuscar.disabled = true;
                if (btnTexto) btnTexto.textContent = ' Cargando...';
                if (estado) estado.textContent = mensaje || 'Actualizando búsqueda...';
            }

            // ---- Aviso de busqueda pesada (aviso-busqueda-pesada.js) ----
            // Antes de recargar, el servidor cuenta lo que traeria el filtro; si supera el limite se pregunta. Sin el
            // componente, o si el conteo falla, se busca como siempre.
            var urlContar = '@Url.Action("ContarBusqueda", "Ventas")';
            var consultandoCantidad = false;
            var sucursalAplicada = inputSucursal ? inputSucursal.value : '-1';

            function confirmarBusqueda(pantalla, filtros, alSeguir, alCancelar) {
                if (!window.AvisoBusquedaPesada) {
                    alSeguir('');
                    return;
                }
                if (consultandoCantidad) return;
                consultandoCantidad = true;
                if (btnBuscar) btnBuscar.disabled = true;
                window.AvisoBusquedaPesada.confirmar(urlContar, pantalla, filtros).then(function (respuesta) {
                    consultandoCantidad = false;
                    if (btnBuscar) btnBuscar.disabled = false;
                    if (respuesta.continuar) alSeguir(respuesta.mensaje);
                    else if (alCancelar) alCancelar();
                });
            }

            function enviarEnVivo() {
                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                    actualizarAviso();
                }

                confirmarBusqueda('lineas',
                    { fechaDesde: fechasAplicadas.fechaDesde, fechaHasta: fechasAplicadas.fechaHasta, idSucursal: inputSucursal.value },
                    function (mensaje) {
                        setBuscando('Actualizando búsqueda en vivo...');
                        submitConLoader(mensaje);
                    },
                    function () { inputSucursal.value = sucursalAplicada; });
            }

            if (inputFechaDesde) inputFechaDesde.addEventListener('change', actualizarAviso);
            if (inputFechaHasta) inputFechaHasta.addEventListener('change', actualizarAviso);
            if (inputSucursal) inputSucursal.addEventListener('change', enviarEnVivo);

            // ---- Exportar a PDF / Excel ----
            // El archivo respeta lo que se ve en pantalla: sucursal, fechas YA aplicadas (fechasAplicadas, no las que
            // estan a medio editar) y los filtros "en vivo" (producto, cliente, vendedor, formas de pago), que no viajan
            // en el formulario porque se aplican en el navegador (lineas-agrupadas.js). El servidor los recibe por
            // querystring con los mismos nombres que acepta la accion Lineas.
            var botonesExportar = document.querySelectorAll('.js-exportar-lineas');

            function valorFiltroVivo(clave) {
                var input = document.querySelector('[data-live-filter="' + clave + '"]');
                return input ? input.value.trim() : '';
            }

            // Cliente / Vendedor con seleccion exacta (filtro-picker.js): viajan los IDs (data-ids) y el texto va vacio,
            // porque el valor del input es solo un resumen. Sin seleccion, el texto escrito como siempre.
            function idsFiltroVivo(clave) {
                var input = document.querySelector('[data-live-filter="' + clave + '"]');
                return input && input.dataset.ids ? input.dataset.ids : '';
            }

            function textoFiltroVivo(clave) {
                return idsFiltroVivo(clave) ? '' : valorFiltroVivo(clave);
            }

            function formasPagoTildadas() {
                var tildadas = document.querySelectorAll('[data-live-filter="formaPago"]:checked');
                return Array.prototype.map.call(tildadas, function (item) { return item.value; }).join(',');
            }

            function urlExportar(urlBase) {
                var params = new URLSearchParams();
                params.set('idSucursal', inputSucursal ? inputSucursal.value : '-1');
                params.set('fechaDesde', fechasAplicadas.fechaDesde);
                params.set('fechaHasta', fechasAplicadas.fechaHasta);
                params.set('producto', valorFiltroVivo('producto'));
                params.set('cliente', textoFiltroVivo('cliente'));
                params.set('vendedor', textoFiltroVivo('vendedor'));
                params.set('idsCliente', idsFiltroVivo('cliente'));
                params.set('idsVendedor', idsFiltroVivo('vendedor'));
                params.set('formasPago', formasPagoTildadas());
                params.set('descuento', valorFiltroVivo('descuento'));
                params.set('anulaciones', valorFiltroVivo('anulaciones'));
                return urlBase + '?' + params.toString();
            }

            function actualizarEnlacesExportar() {
                Array.prototype.forEach.call(botonesExportar, function (boton) {
                    boton.href = urlExportar(boton.getAttribute('data-export-url'));
                });
            }

            // Se actualizan al tipear/tildar (asi tambien sirven "abrir en otra pestaña" y "copiar enlace") y de nuevo
            // justo antes de descargar.
            Array.prototype.forEach.call(document.querySelectorAll('.js-filtro-vivo'), function (input) {
                input.addEventListener(input.type === 'checkbox' ? 'change' : 'input', actualizarEnlacesExportar);
            });

            Array.prototype.forEach.call(botonesExportar, function (boton) {
                boton.addEventListener('click', function (event) {
                    // Sin ninguna venta visible no hay nada que exportar: se avisa y no se descarga.
                    if (!document.querySelector('.js-registro-card:not(.d-none)')) {
                        event.preventDefault();
                        if (window.Swal && typeof window.Swal.fire === 'function') {
                            window.Swal.fire({
                                icon: 'info',
                                title: 'No hay ventas para exportar',
                                text: 'Ajustá los filtros para que la pantalla muestre al menos una venta.'
                            });
                        } else {
                            window.alert('No hay ventas para exportar.');
                        }
                        return;
                    }

                    actualizarEnlacesExportar();
                });
            });

            // ---- Excel compacto para imprimir ----
            // Antes de descargar pregunta que datos de la venta incluir: vendedor y sucursal van en el renglon de la fecha;
            // cliente, forma de pago, Venta ID y comprobante, en un renglon debajo (que no se genera si no se elige ninguno).
            // La seleccion se recuerda en este navegador (localStorage). Los filtros y las fechas viajan igual que en PDF/Excel.
            var botonCompacto = document.querySelector('.js-exportar-compacto');
            var CLAVE_DATOS_COMPACTO = 'ventasLineasCompactoDatos';
            var DATOS_COMPACTO_INICIALES = ['vendedor', 'cliente'];
            var DATOS_COMPACTO = [
                { clave: 'vendedor', texto: 'Vendedor', grupo: 'principal' },
                { clave: 'sucursal', texto: 'Sucursal', grupo: 'principal' },
                { clave: 'cliente', texto: 'Cliente', grupo: 'extra' },
                { clave: 'formaPago', texto: 'Forma de pago', grupo: 'extra' },
                { clave: 'ventaId', texto: 'Venta ID', grupo: 'extra' },
                { clave: 'comprobante', texto: 'Nro/comprobante', grupo: 'extra' }
            ];

            function leerDatosCompacto() {
                try {
                    var guardado = window.localStorage.getItem(CLAVE_DATOS_COMPACTO);
                    if (guardado !== null) return guardado.split(',').filter(Boolean);
                } catch (e) {
                    // localStorage no disponible (modo privado, datos bloqueados): se usan los datos iniciales.
                }
                return DATOS_COMPACTO_INICIALES;
            }

            function guardarDatosCompacto(datos) {
                try {
                    window.localStorage.setItem(CLAVE_DATOS_COMPACTO, datos.join(','));
                } catch (e) {
                    // Solo es una comodidad: si no se puede guardar, la proxima vez vuelve a los datos iniciales.
                }
            }

            function casillasCompacto(grupo, seleccionados) {
                return DATOS_COMPACTO.filter(function (dato) { return dato.grupo === grupo; }).map(function (dato) {
                    return '<label style="display:block; margin:2px 0"><input type="checkbox" class="swal-dato-compacto" value="' + dato.clave + '"'
                        + (seleccionados.indexOf(dato.clave) >= 0 ? ' checked' : '') + '> ' + dato.texto + '</label>';
                }).join('');
            }

            function descargarCompacto(datos) {
                // La respuesta es un archivo (attachment): el navegador lo descarga y la pantalla no se recarga.
                window.location.href = urlExportar(botonCompacto.getAttribute('data-export-url')) + '&datos=' + encodeURIComponent(datos.join(','));
            }

            if (botonCompacto) {
                botonCompacto.addEventListener('click', function () {
                    if (!document.querySelector('.js-registro-card:not(.d-none)')) {
                        if (window.Swal && typeof window.Swal.fire === 'function') {
                            window.Swal.fire({
                                icon: 'info',
                                title: 'No hay ventas para exportar',
                                text: 'Ajustá los filtros para que la pantalla muestre al menos una venta.'
                            });
                        } else {
                            window.alert('No hay ventas para exportar.');
                        }
                        return;
                    }

                    var seleccionados = leerDatosCompacto();
                    if (!window.Swal || typeof window.Swal.fire !== 'function') {
                        descargarCompacto(seleccionados);
                        return;
                    }

                    window.Swal.fire({
                        title: 'Excel compacto para imprimir',
                        html: '<div style="text-align:left; font-size:.95rem">'
                            + '<p style="margin:0 0 .6rem">Sin colores, letra chica y dos columnas por hoja, ordenado por fecha y hora. '
                            + 'Cada venta muestra su fecha, su hora y su total. ¿Qué datos querés agregar?</p>'
                            + '<strong>En el renglón de la fecha</strong>' + casillasCompacto('principal', seleccionados)
                            + '<strong style="display:block; margin-top:.6rem">En un renglón debajo (opcional)</strong>' + casillasCompacto('extra', seleccionados)
                            + '</div>',
                        showCancelButton: true,
                        confirmButtonText: 'Descargar',
                        cancelButtonText: 'Cancelar',
                        focusConfirm: false,
                        preConfirm: function () {
                            var marcadas = window.Swal.getPopup().querySelectorAll('.swal-dato-compacto:checked');
                            return Array.prototype.map.call(marcadas, function (casilla) { return casilla.value; });
                        }
                    }).then(function (resultado) {
                        if (!resultado.isConfirmed) return;
                        guardarDatosCompacto(resultado.value);
                        descargarCompacto(resultado.value);
                    });
                });
            }

            actualizarEnlacesExportar();

            form.addEventListener('submit', function (event) {
                if (form.dataset.loadingSubmitPending === 'true') {
                    form.dataset.loadingSubmitPending = '';
                    return;
                }

                event.preventDefault();
                var pedidas = {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
                };
                // Las fechas pasan a "aplicadas" recien si se confirma: si se cancela, los exports siguen con las de la pantalla.
                confirmarBusqueda('lineas',
                    { fechaDesde: pedidas.fechaDesde, fechaHasta: pedidas.fechaHasta, idSucursal: inputSucursal ? inputSucursal.value : '-1' },
                    function (mensaje) {
                        fechasAplicadas = pedidas;
                        actualizarAviso();
                        setBuscando('Actualizando búsqueda...');
                        form.dataset.loadingSubmitPending = 'true';
                        submitConLoader(mensaje);
                    },
                    function () {
                        // lineas-agrupadas.js oculta el aviso al enviar: si se cancela, las fechas siguen sin aplicar y hay que mostrarlo.
                        actualizarAviso();
                        if (inputFechaDesde) inputFechaDesde.focus();
                    });
            });

            // "Volver" recarga el indice de Ventas con el mismo periodo: tambien se avisa. Con Ctrl/Shift (otra pestaña) no se intercepta.
            var enlaceVolver = document.querySelector('.js-volver-ventas');
            if (enlaceVolver) {
                enlaceVolver.addEventListener('click', function (event) {
                    if (event.ctrlKey || event.metaKey || event.shiftKey || event.button !== 0) return;
                    event.preventDefault();
                    confirmarBusqueda('ventas',
                        { fechaDesde: enlaceVolver.dataset.fechaDesde, fechaHasta: enlaceVolver.dataset.fechaHasta, idSucursal: enlaceVolver.dataset.idSucursal },
                        function (mensaje) {
                            showNavigationLoading(mensaje || 'Cargando solicitud...');
                            window.location.href = enlaceVolver.href;
                        });
                });
            }

            // ---- Producto ----
            var inputProducto = document.getElementById('productoVentasLineas');
            var borrarProducto = document.querySelector('.js-borrar-producto');
            if (borrarProducto && inputProducto) {
                borrarProducto.addEventListener('click', function () {
                    inputProducto.value = '';
                    inputProducto.dispatchEvent(new Event('input', { bubbles: true }));
                    inputProducto.focus();
                });
            }
            // Cursor puesto en Producto al entrar, solo en computadora (en un celular o tablet abriria el teclado solo).
            if (inputProducto && window.matchMedia && window.matchMedia('(min-width: 768px) and (pointer: fine)').matches) {
                inputProducto.focus({ preventScroll: true });
            }
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/lineas-agrupadas.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/Scripts/app/columnas-visibles.js")" asp-append-version="true"></script>
}

