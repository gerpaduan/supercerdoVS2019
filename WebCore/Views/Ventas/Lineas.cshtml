@model VentaLineasIndexVm
@using Entidades
@inject WebCore.Services.IUsuarioSesionService Sesion

@{
    ViewBag.Title = "Lineas de venta";
    var sucursales = ViewBag.Sucursales as List<Sucursal> ?? new List<Sucursal>();
    // Color de cada sucursal en la tabla: su posicion en la lista (lineas-agrupadas.js usa el mismo orden, el del select).
    var colorSucursal = sucursales.Select((s, i) => new { Nombre = s.SucursalNombre ?? "", Indice = i % 4 })
        .GroupBy(x => x.Nombre).ToDictionary(g => g.Key, g => g.First().Indice);
}

<div class="container-fluid px-2 px-md-3" data-lineas-agrupadas-page="ventas">
    <partial name="_AvisoReservadasListado" />
    @* Sin titulo propio: el nombre de la pantalla ya lo muestra la barra superior (2026-11-26, ver docs/DECISIONS.md). *@
    <div class="vl-acciones">
        <a class="btn btn-sm btn-outline-secondary vl-volver js-volver-ventas" title="Volver al indice de ventas"
           data-fecha-desde="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm")" data-fecha-hasta="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm")" data-id-sucursal="@Model.IdSucursal"
           href="@Url.Action("Index", "Ventas", new { fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm"), idSucursal = Model.IdSucursal })">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
        @* "Ver detalles" solo aplica a la vista agrupada (en la vista plana ya se ven todos los datos): lineas-agrupadas.js lo oculta. *@
        <div class="custom-control custom-switch js-detalles-switch-wrap">
            <input type="checkbox" class="custom-control-input js-toggle-detalles-general" id="expandirDetallesVentas" />
            <label class="custom-control-label" for="expandirDetallesVentas">Ver detalles</label>
        </div>
        @* Columnas visibles de la tabla plana (columnas-visibles.js; la eleccion se recuerda por usuario en este navegador). Solo se
           muestra en "Ver solo líneas": lineas-agrupadas.js alterna .js-solo-vista-plana. Cada value es la clase "lc-<value>" de la
           columna; data-control = queda en la vista rapida "Control"; disabled = siempre visible. *@
        <div class="vl-columnas js-solo-vista-plana d-none" data-columnas
             data-columnas-tabla=".lineas-tabla-plana" data-columnas-clave="lineasColumnasOcultas_ventas_@(Sesion.UsuarioActual?.Id)">
            <button type="button" class="btn btn-sm btn-outline-secondary js-columnas-boton" aria-expanded="false">
                <i class="fas fa-columns mr-1"></i> <span class="js-columnas-texto">Columnas</span> <i class="fas fa-caret-down ml-1"></i>
            </button>
            <div class="vl-col-panel js-columnas-panel">
                <div class="vl-col-titulo">Vista rápida</div>
                <div class="vl-col-rapidas">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-columnas-todas">Todas</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary js-columnas-control">Control</button>
                </div>
                <div class="vl-col-titulo">Columnas</div>
                <div class="js-columnas-lista">
                    <label><input type="checkbox" value="fecha" data-control checked> Fecha y hora</label>
                    <label><input type="checkbox" value="nro-comprobante" checked> Nro/comprobante</label>
                    <label><input type="checkbox" value="sucursal" checked> Sucursal</label>
                    <label><input type="checkbox" value="cliente" checked> Cliente</label>
                    <label><input type="checkbox" value="vendedor" checked> Vendedor</label>
                    <label><input type="checkbox" value="forma-de-pago" checked> Forma de pago</label>
                    <label><input type="checkbox" value="codigo" data-control checked> Código</label>
                    <label><input type="checkbox" value="producto" data-control checked disabled> Producto <small>siempre</small></label>
                    <label><input type="checkbox" value="kg" data-control checked> Cantidad / kg</label>
                    <label><input type="checkbox" value="precio" checked> Precio</label>
                    <label><input type="checkbox" value="descuento" checked> Desc./Rec.</label>
                    <label><input type="checkbox" value="total" checked> Total línea</label>
                    <label><input type="checkbox" value="creado" checked> Creado</label>
                </div>
            </div>
        </div>
        @* Alterna entre tarjetas por venta y una tabla plana con una fila por linea (ordenable). Ver lineas-agrupadas.js. *@
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVistaSoloLineas"
                data-clave-vista="ventas"
                data-texto-plana="Ver solo líneas"
                data-texto-agrupada="Ver agrupado por venta">
            <i class="fas fa-list mr-1"></i><span class="js-vista-texto">Ver solo líneas</span>
        </button>
            @* Exportar PDF / Excel: el href inicial (con los filtros del servidor) es solo un respaldo; el script del final
               lo reconstruye con los filtros "en vivo" y las fechas aplicadas (ver "Exportar a PDF / Excel" en Scripts). *@
            <a class="btn btn-sm btn-outline-danger js-exportar-lineas"
               href="@Url.Action("LineasPdf", "Ventas", new { fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss"), idSucursal = Model.IdSucursal, cliente = Model.Cliente, vendedor = Model.Vendedor, idsCliente = Model.IdsCliente, idsVendedor = Model.IdsVendedor, producto = Model.Producto, formasPago = Model.FormasPagoCsv })"
               data-export-url="@Url.Action("LineasPdf", "Ventas")"
               title="Exportar a PDF lo que se ve en pantalla">
                <i class="fas fa-file-pdf mr-1"></i> PDF
            </a>
            <a class="btn btn-sm btn-outline-success js-exportar-lineas"
               href="@Url.Action("LineasExcel", "Ventas", new { fechaDesde = Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss"), fechaHasta = Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss"), idSucursal = Model.IdSucursal, cliente = Model.Cliente, vendedor = Model.Vendedor, idsCliente = Model.IdsCliente, idsVendedor = Model.IdsVendedor, producto = Model.Producto, formasPago = Model.FormasPagoCsv })"
               data-export-url="@Url.Action("LineasExcel", "Ventas")"
               title="Exportar a Excel lo que se ve en pantalla">
                <i class="fas fa-file-excel mr-1"></i> Excel
            </a>
            @* Excel compacto para imprimir (sin colores, letra 8, dos columnas por hoja): antes de descargar pregunta que
               datos de la venta incluir (ver "Excel compacto" en Scripts). *@
            <button type="button" class="btn btn-sm btn-outline-success js-exportar-compacto"
                    data-export-url="@Url.Action("LineasExcelCompacto", "Ventas")"
                    title="Excel sin colores y en dos columnas por hoja, para imprimir">
                <i class="fas fa-print mr-1"></i> Excel compacto
            </button>
    </div>

    <div class="card shadow-sm mb-2 elaborados-filtros-card" data-filtros-celular>
        <div class="card-body">
            <form method="get" action="@Url.Action("Lineas", "Ventas")" class="js-form-filtros-lineas">
                <div id="alertaFiltrosPendientes" class="alert alert-warning d-none mb-3" role="alert">
                    Se modificaron filtros principales. Presioná <strong>Buscar</strong> para recargar los datos.
                </div>

                <div class="elaborados-filtros-grid vl-fila vl-fila-1">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha desde</label>
                        <input name="fechaDesde" id="fechaDesdeVentasLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Fecha hasta</label>
                        <input name="fechaHasta" id="fechaHastaVentasLineas" type="datetime-local" step="1" class="form-control" value="@Model.FechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="idSucursalVentasLineas" class="form-control">
                            <option value="-1" selected="@(Model.IdSucursal == -1 ? "selected" : null)">Todas</option>
                            @foreach (var sucursal in sucursales)
                            {
                                <option value="@sucursal.IdSucursal" selected="@(sucursal.IdSucursal == Model.IdSucursal ? "selected" : null)">@sucursal.SucursalNombre</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0 lineas-filtro-accion">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block" id="btnBuscarVentasLineas">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                        </button>
                    </div>
                    @* Limpiar filtros: vuelve a la pantalla como se entra (hoy de 00:00 a 23:59, todas las sucursales y sin filtros). *@
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label d-none d-lg-block">&nbsp;</label>
                        <a class="btn btn-outline-secondary btn-block js-limpiar-filtros"
                           href="@Url.Action("Lineas", "Ventas", new { fechaDesde = DateTime.Today.ToString("yyyy-MM-ddT00:00:00"), fechaHasta = DateTime.Today.ToString("yyyy-MM-ddT23:59:00") })">
                            <i class="fas fa-eraser mr-1"></i> Limpiar filtros
                        </a>
                    </div>
                </div>

                <div id="estadoBusquedaVentasLineas" class="text-muted small" aria-live="polite"></div>

                <div class="elaborados-filtros-grid vl-fila vl-fila-2">
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Cliente</label>
                        @* Selector multi-seleccion (filtro-picker.js): F10 clientes. Con seleccion filtra por ID exacto; el hidden
                           idsCliente (dentro del form) conserva la seleccion al apretar Buscar / cambiar de sucursal. *@
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="cliente" value="@Model.Cliente" placeholder="Nombre o identificacion" autocomplete="off"
                               data-filtro-picker="cliente" data-filtro-picker-tecla="F10" data-ids-name="idsCliente"
                               data-ids="@Model.IdsCliente" data-items="@WebCore.Services.FiltroPickerService.ItemsAJson(Model.ClientesSeleccionados)" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label">Vendedor</label>
                        @* Idem: F9 vendedores. *@
                        <input type="text" class="form-control js-filtro-vivo" data-live-filter="vendedor" value="@Model.Vendedor" placeholder="Nombre del vendedor" autocomplete="off"
                               data-filtro-picker="vendedor" data-filtro-picker-tecla="F9" data-ids-name="idsVendedor"
                               data-ids="@Model.IdsVendedor" data-items="@WebCore.Services.FiltroPickerService.ItemsAJson(Model.VendedoresSeleccionados)" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label d-block">Forma de pago</label>
                        <div class="vl-pagos">
                            @foreach (var formaPago in new[] { "Efectivo", "Debito", "Credito", "CtaCte", "Qr", "Transferencia" })
                            {
                                <label class="vl-pago mb-0">
                                    <input type="checkbox"
                                           class="js-filtro-vivo"
                                           data-live-filter="formaPago"
                                           value="@formaPago"
                                           @(Model.FormasPagoSeleccionadas.Any(x => string.Equals(x, formaPago, StringComparison.OrdinalIgnoreCase)) ? "checked" : "") />
                                    <span>@formaPago</span>
                                </label>
                            }
                        </div>
                    </div>
                    @* Filtros por linea (2026-11-27): se aplican en el navegador como los demas; llevan name para que Buscar conserve lo
                       elegido. El servidor solo los aplica en PDF y Excel (LineasVentaClasificacion). *@
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="filtroDescuentoVentasLineas">Descuento / recargo</label>
                        <select name="descuento" id="filtroDescuentoVentasLineas" class="form-control js-filtro-vivo" data-live-filter="descuento">
                            <option value="">Todas</option>
                            <option value="desc" selected="@(Model.FiltroDescuento == "desc" ? "selected" : null)">Con descuento</option>
                            <option value="rec" selected="@(Model.FiltroDescuento == "rec" ? "selected" : null)">Con recargo</option>
                            <option value="precio" selected="@(Model.FiltroDescuento == "precio" ? "selected" : null)">Precio distinto al de lista</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="elaborados-filtro-label" for="filtroAnulacionesVentasLineas">Anulaciones</label>
                        <select name="anulaciones" id="filtroAnulacionesVentasLineas" class="form-control js-filtro-vivo" data-live-filter="anulaciones">
                            <option value="">Todas</option>
                            <option value="ventas" selected="@(Model.FiltroAnulaciones == "ventas" ? "selected" : null)">Ventas con anulaciones</option>
                            <option value="solo" selected="@(Model.FiltroAnulaciones == "solo" ? "selected" : null)">Solo lo anulado</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="lineas-resumen-grid cols-4 vl-totales mb-2">
        <div class="card lineas-resumen-card vl-total vl-total-kg">
            <div class="card-body">
                <span class="vl-total-label" data-texto-normal="Total Kg" data-texto-solo="Kg anulados">Total Kg</span>
                <span class="vl-total-valor" id="totalKg">0,000</span>
            </div>
        </div>
        <div class="card lineas-resumen-card vl-total vl-total-pesos">
            <div class="card-body">
                <span class="vl-total-label" data-texto-normal="Total pesos" data-texto-solo="Pesos anulados">Total pesos</span>
                <span class="vl-total-valor" id="totalImporte">$ 0,00</span>
            </div>
        </div>
        <div class="card lineas-resumen-card vl-total vl-total-lineas">
            <div class="card-body">
                <span class="vl-total-label" data-texto-normal="Cantidad de lineas" data-texto-solo="Ítems anulados">Cantidad de lineas</span>
                <span class="vl-total-valor" id="totalLineas">0</span>
            </div>
        </div>
        <div class="card lineas-resumen-card vl-total vl-total-registros">
            <div class="card-body">
                <span class="vl-total-label" data-texto-normal="Cantidad de registros" data-texto-solo="Ventas">Cantidad de registros</span>
                <span class="vl-total-valor" id="totalRegistros">0</span>
            </div>
        </div>
    </div>

    @* Producto: ultimo campo, inmediatamente arriba de la tabla, con el cursor puesto al entrar. Va fuera del <form> a proposito:
       filtra en vivo y Enter no recarga la pantalla (antes borraba lo escrito). *@
    <div class="vl-producto mb-2">
        <div class="input-group">
            <label class="input-group-text mb-0" for="productoVentasLineas"><i class="fas fa-search mr-1"></i> Producto</label>
            <input type="text" id="productoVentasLineas" class="form-control js-filtro-vivo" data-live-filter="producto" value="@Model.Producto" placeholder="Tipeá código o descripción" autocomplete="off" spellcheck="false" />
            <button type="button" class="btn btn-outline-secondary js-borrar-producto" title="Borrar producto" aria-label="Borrar producto"><i class="fas fa-times"></i></button>
        </div>
    </div>

    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-server @(Model.Ventas != null && Model.Ventas.Count > 0 ? "d-none" : "")">
        No se encontraron ventas con lineas para los filtros seleccionados.
    </div>
    <div class="alert alert-light text-center text-muted lineas-empty-state js-lineas-empty-client d-none">
        No hay resultados con el filtro en vivo.
    </div>

    @* Vista agrupada (tarjeta por venta). Se oculta el CONTENEDOR y no las tarjetas: los botones de exportar de abajo
       consultan `.js-registro-card:not(.d-none)` para saber si hay resultados. *@
    <div class="js-vista-agrupada">
    @if (Model.Ventas != null)
    {
        foreach (var venta in Model.Ventas)
        {
            var cliente = venta.Campos.FirstOrDefault(x => x.Etiqueta == "Cliente");
            var vendedor = venta.Campos.FirstOrDefault(x => x.Etiqueta == "Vendedor");
            var formaPago = venta.Campos.FirstOrDefault(x => x.Etiqueta == "Forma de pago");
            <div class="card shadow-sm mb-3 linea-registro-card js-registro-card"
                 data-cliente="@(cliente != null ? cliente.Valor : "")"
                 data-vendedor="@(vendedor != null ? vendedor.Valor : "")"
                 data-id-cliente="@venta.IdCliente"
                 data-id-vendedor="@venta.IdVendedor"
                 data-formaPago="@(formaPago != null ? formaPago.Valor : "")"
                 data-fecha="@venta.FechaVenta.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)"
                 data-creado="@(venta.Creado == DateTime.MinValue ? "" : venta.Creado.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture))"
                 data-creado-texto="@(venta.Creado == DateTime.MinValue ? "-" : venta.Creado.ToString("dd/MM/yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture))">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            @{
                                var sucursalVenta = venta.Campos.FirstOrDefault(x => x.Etiqueta == "Sucursal")?.Valor ?? "-";
                            }
                            <div class="linea-resumen-principal">
                                <span class="vl-fecha">@venta.FechaVenta.ToString("dd/MM/yyyy") <span class="vl-hora">@venta.FechaVenta.ToString("HH:mm")</span></span>
                                <span class="vl-suc vl-suc-@(colorSucursal.TryGetValue(sucursalVenta, out var indiceColor) ? indiceColor : 0)">@sucursalVenta</span>
                                <span class="vl-vend">@(vendedor != null ? vendedor.Valor : "-")</span>
                            </div>
                            <div class="linea-resumen-secundario">@venta.ResumenSecundario</div>
                        </div>
                        <div class="linea-resumen-tools mt-2 mt-md-0">
                            <span class="badge badge-success badge-pill px-3 py-2">@venta.TotalTexto</span>
                            <a class="btn btn-sm btn-outline-primary" href="@venta.EditUrl">Ver registro</a>
                        </div>
                    </div>
                    <div class="row mt-3 linea-registro-extra d-none">
                        @foreach (var campo in venta.Campos)
                        {
                            <div class="col-12 col-md-4 mb-2">
                                <div class="small text-muted text-uppercase">@campo.Etiqueta</div>
                                <div>@campo.Valor</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-responsive js-sync-scroll-body">
                    <table class="table table-sm table-hover mb-0 vl-tabla lineas-cel lineas-cel-precio">
                        <thead class="thead-light">
                            <tr>
                                <th>Codigo producto</th>
                                <th>Producto</th>
                                <th class="text-right">Cantidad / kg</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Total linea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in venta.Lineas)
                            {
                                var claseAnulada = linea.TipoAnulacion == "contra" ? "anulada contra" : (linea.TipoAnulacion == "original" ? "anulada original-anulada" : "");

                                <tr class="js-linea-row @claseAnulada"
                                    data-descuento="@linea.TipoDescuento"
                                    data-descuento-texto="@linea.DescuentoTexto"
                                    data-anulacion="@linea.TipoAnulacion"
                                    data-solo-anulado="@(linea.SoloAnulado ? "1" : "0")"
                                    data-venta-anulacion="@(venta.ConAnulacion ? "1" : "0")"
                                    data-cancelada="@(venta.Cancelada ? "1" : "0")"
                                    data-codigo="@linea.Codigo"
                                    data-producto="@linea.Producto"
                                    data-kg="@linea.CantidadKg"
                                    data-precio="@linea.Precio"
                                    data-total="@linea.Total"
                                    data-unidades="0">
                                    <td class="lc-codigo">@linea.Codigo</td>
                                    <td class="lc-producto">
                                        <span class="js-producto-nombre">@linea.Producto</span>
                                        @if (linea.TipoDescuento != "")
                                        {
                                            <span class="vl-dr vl-dr-@linea.TipoDescuento">@linea.DescuentoTexto</span>
                                        }
                                        @if (linea.TipoAnulacion != "")
                                        {
                                            <span class="vl-marca">@(linea.TipoAnulacion == "contra" ? "Anulación" : "Anulada")</span>
                                        }
                                        @if (venta.Cancelada)
                                        {
                                            <span class="vl-marca vl-marca-cancelada">Venta cancelada</span>
                                        }
                                    </td>
                                    <td class="text-right lc-kg"><span class="vl-cant">@linea.CantidadKgTexto</span></td>
                                    <td class="text-right lc-precio" data-label="Precio">@linea.PrecioTexto</td>
                                    <td class="text-right lc-total" data-label="Total">@linea.TotalTexto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    </div>

    @* Vista plana ("Ver solo líneas"): una fila por línea. La arma lineas-agrupadas.js a partir de las tarjetas de arriba
       (encabezado y filas se generan en el navegador); empieza oculta. *@
    <div class="card shadow-sm js-vista-plana d-none">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 vl-tabla elaborados-table-compact lineas-tabla-plana">
                <thead class="thead-light"><tr class="js-plana-encabezado"></tr></thead>
                <tbody class="js-plana-cuerpo"></tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Lineas de venta (rediseño 2026-11-26, ver docs/DECISIONS.md): botones chicos, filtros en dos renglones, totales en tira, Producto pegado
       a la tabla y datos resaltados. Todo va acotado a esta pantalla: Compras, Stock y Movimientos comparten el script pero no estos estilos. */
    .container-fluid[data-lineas-agrupadas-page="ventas"] {
        font-size: .86rem;
    }

    /* ---- Botones de arriba ---- */
    [data-lineas-agrupadas-page="ventas"] .vl-acciones { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: .35rem; margin-bottom: .45rem; }
    body.app-shell [data-lineas-agrupadas-page="ventas"] .vl-acciones .btn { font-size: .76rem; line-height: 1.15; padding: .24rem .6rem; min-height: 0; border-radius: .45rem; margin: 0; }
