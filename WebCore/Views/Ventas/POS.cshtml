@model Entidades.Venta

@{
    ViewBag.Title = "CarniSys | Punto de Venta";
    Layout = "~/Views/Shared/_LayoutPOS.cshtml";

    bool cajaAbierta = ViewBag.CajaAbierta != null && (bool)ViewBag.CajaAbierta;
    // Item 5 (2026-09-07, ver docs/DECISIONS.md): usuario con permiso real de "modificar venta" --
    // puede editar la fecha de la venta en curso, y puede haber entrado sin caja abierta (se le
    // advierte, queda a su criterio).
    int diasLimitFechaVentaPOS = ViewBag.DiasLimitFechaVentaPOS != null ? (int)ViewBag.DiasLimitFechaVentaPOS : 0;
    // Item 5b (2026-09-12, ver docs/DECISIONS.md): primera validacion de fecha -- con caja real
    // abierta, piso = fecha de apertura. Vacio si no hay caja real (solo Admin llega hasta aca
    // sin caja, ver PuedeOperarSinCajaYEditarFecha + item 7) -- en ese caso, sin piso de caja,
    // solo rige la ventana de dias existente (diasLimitFechaVentaPOS).
    string cajaAperturaFechaPOS = ViewBag.CajaAperturaFecha as string ?? "";
    bool advertenciaCajaCerrada = ViewBag.AdvertenciaCajaCerrada != null && (bool)ViewBag.AdvertenciaCajaCerrada;
    // Usuario de produccion (Batch 5, 2026-09-06, ver docs/DECISIONS.md): con requiereOperadorPOS
    // el controller devuelve Model=null (igual que !cajaAbierta) -- se necesita distinguir los 2
    // casos aca para mostrar el modal correcto (seleccion de operador vs abrir caja).
    bool esUsuarioProduccionPOS = ViewBag.EsUsuarioProduccion != null && (bool)ViewBag.EsUsuarioProduccion;
    bool requiereOperadorPOS = ViewBag.RequiereOperadorPOS != null && (bool)ViewBag.RequiereOperadorPOS;
    int idSucursalPOS = ViewBag.IdSucursalPOS != null ? (int)ViewBag.IdSucursalPOS : 0;
    int idUsuarioPOS = ViewBag.IdUsuarioPOS != null ? (int)ViewBag.IdUsuarioPOS : 0;
    string sucursalNombrePOS = ViewBag.SucursalNombre as string ?? "";
    string posModoInstancia = ViewBag.PosModoInstancia as string ?? "original";
    string posInstanceId = ViewBag.PosInstanceId as string ?? "";
    string returnUrlPOS = ViewBag.ReturnUrlPOS as string ?? "";
    bool esEdicionVenta = ViewBag.EsEdicionVenta != null && (bool)ViewBag.EsEdicionVenta;
    int idVentaEditar = ViewBag.IdVentaEditar != null ? (int)ViewBag.IdVentaEditar : 0;
    bool soloFormaPago = ViewBag.SoloFormaPago != null && (bool)ViewBag.SoloFormaPago;
    int idCierreActividadPOS = ViewBag.IdCierreActividadPOS != null ? (int)ViewBag.IdCierreActividadPOS : 0;
    int idConsumidorFinalPOS = ViewBag.IdConsumidorFinal != null ? (int)ViewBag.IdConsumidorFinal : 0;

    // Precarga de POSState en modo edicion -- port de Web/Views/Ventas/POS.cshtml:24-63 (batch 7,
    // iteracion 5). "anulado"/"indexAnulado" replican EXACTAMENTE la logica del original
    // (incluida la comparacion IdLineaVenta contra el diccionario agrupado por IndexAnulado) --
    // no se "corrigio" nada raro que se haya notado ahi, paridad de comportamiento (CLAUDE.md §11.1).
    var lineasActivasEdicion = (Model != null && Model.LineasVenta != null)
        ? Model.LineasVenta.Where(l => !Entidades.LineaVenta.esAnulado(l.Estado)).ToList()
        : new List<Entidades.LineaVenta>();
    var lineasAnuladasPorLineaEdicion = (Model != null && Model.LineasVenta != null)
        ? Model.LineasVenta
            .Where(l => Entidades.LineaVenta.esAnulado(l.Estado) && l.IndexAnulado > 0)
            .GroupBy(l => l.IndexAnulado)
            .ToDictionary(g => g.Key, g => g.First())
        : new Dictionary<int, Entidades.LineaVenta>();
    var lineasEdicionPos = new List<object>();
    var listaExpendiosEdicionPos = new List<int>();
    if (esEdicionVenta)
    {
        var indexLinea = 1;
        foreach (var linea in lineasActivasEdicion)
        {
            if (linea.IdExpendio > 0 && !listaExpendiosEdicionPos.Contains(linea.IdExpendio))
            {
                listaExpendiosEdicionPos.Add(linea.IdExpendio);
            }

            // Bug real encontrado por el usuario (2026-09-07, ver docs/DECISIONS.md): "precioOriginal"
            // quedaba igual a linea.PrecioKg (el precio YA BONIFICADO con el que se guardo la
            // venta) -- el modal "Linea de venta" usa ese campo como base para calcular el % (ver
            // pos-cart.js, #modalPrecio/syncDesdePrecio), asi que al reabrir una linea que ya tenia
            // descuento, cualquier recalculo de % partia del precio bonificado en vez del precio
            // de lista, aplicando el descuento dos veces en cascada. Fix: precioOriginal usa
            // linea.Corte.PrecioKg (el precio de LISTA actual del producto -- getVentaById hace
            // JOIN contra la tabla corte en vivo, ver DatosPostgres/VentaPg.cs), igual criterio
            // que el resto del sistema (historial de precios, badge "cambio de precio" en
            // expendios) usa para comparar contra el precio de lista de HOY, no el historico.
            lineasEdicionPos.Add(new
            {
                index = indexLinea++,
                producto = linea.Corte.CorteDesc,
                codigo = linea.Corte.codigo,
                cant = Math.Abs(linea.CantKg).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture),
                precio = "$ " + linea.PrecioKg.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                precioOriginal = "$ " + linea.Corte.PrecioKg.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                subtotal = "$ " + (Math.Abs(linea.CantKg) * linea.PrecioKg).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                bonificacion = linea.Bonificacion,
                anulado = lineasAnuladasPorLineaEdicion.ContainsKey(linea.IdLineaVenta),
                indexAnulado = -1,
                balanza = linea.PesoBalanza,
                pesable = linea.Corte.Pesable,
                idExpendio = linea.IdExpendio,
                esHistorica = true
            });
        }
    }
}

