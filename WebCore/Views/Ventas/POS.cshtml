            function volverDesdeSoloFormaPago() {
                window.desactivarAvisoSalidaPOS?.();
                window.location.href = window.api.venta.detalle + "?id=" + encodeURIComponent($("#idVentaEditar").val());
            }

            function aplicarModoSoloFormaPago() {
                if (!window.POSModo?.soloFormaPago) return;

                $("body").addClass("pos-solo-forma-pago");
                $("#inputCodigo, #inputCantidad, #fechaVentaEditable, #btnAgregarManual, #btnBuscarPersona, #btnConsumidorFinal, #btnScanner")
