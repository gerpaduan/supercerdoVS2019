            // usuario -- ver docs/DECISIONS.md): si el producto de la fila copiada YA esta
            // cargado en el carrito de esta venta, se ofrece aplicarle el precio del historial
            // ahi mismo -- como si se hubiese hecho a mano desde el modal "Linea de venta" con
            // "Bonificar por precio" (mismo calculo exacto de % que syncDesdePrecio() en
            // pos-cart.js: pct = (1 - precioNuevo/precioLista) * 100, linea.bonificacion queda
            // seteado y el carrito lo muestra igual que cualquier otra bonificacion). Si el
            // usuario dice que no, o el producto no esta en el carrito, se comporta como antes
            // (solo copia el precio para pegar despues en el modal de linea).
            function buscarLineaCarritoPorCodigo(codigo) {
                var cod = String(codigo == null ? "" : codigo).trim();
                if (!cod) return null;

                return (POSState.getLineas() || []).find(function (linea) {
                    return linea && !linea.anulado && String(linea.codigo) === cod;
                }) || null;
            }

            function aplicarPrecioHistorialALineaCarrito(linea, precioNuevo) {
                var precioLista = parseFloat(String(linea.precioOriginal ?? linea.precio).replace("$", "").trim());
                var cant = parseFloat(String(linea.cant).replace(",", "."));

                if (!isFinite(precioLista) || precioLista <= 0 || !isFinite(cant) || cant <= 0) return false;

                var pct = (1 - (precioNuevo / precioLista)) * 100.0;
                pct = Math.round(pct * 100) / 100.0;

                linea.precio = "$ " + precioNuevo.toFixed(2);
                linea.subtotal = "$ " + (precioNuevo * cant).toFixed(2);
                linea.bonificacion = pct;

                posCart.renderTable(POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();
                posCart.updateCartSummary?.();
                return true;
            }

            $(document).on("click", "#modalFinanzasPOS .js-copiar-precio-historial", function () {
                var $btn = $(this);
                var precio = parseFloat($btn.data("precio"));
                if (!isFinite(precio)) return;

                window.POSPrecioCopiado = precio;
                actualizarBotonPegarPrecio();

                var $icono = $btn.find("i");
                $icono.removeClass("fa-copy").addClass("fa-check text-success");
                setTimeout(function () {
                    $icono.removeClass("fa-check text-success").addClass("fa-copy");
                }, 1200);

                var codigo = $btn.data("codigo");
                var lineaEnCarrito = buscarLineaCarritoPorCodigo(codigo);
                if (!lineaEnCarrito) return;

                var producto = $btn.data("producto") || lineaEnCarrito.producto || ("código " + codigo);
                var preguntar = function () {
                    if (aplicarPrecioHistorialALineaCarrito(lineaEnCarrito, precio)) {
                        if (window.Swal) {
                            window.Swal.fire({
                                icon: "success",
                                title: "Precio actualizado",
                                text: producto + " quedó con el precio del historial en el carrito.",
                                timer: 1800,
                                timerProgressBar: true,
                                showConfirmButton: false
                            });
                        }
                    }
                };

                if (window.Swal) {
                    window.Swal.fire({
                        icon: "question",
                        title: "Cambiar precio en el carrito",
                        text: producto + " ya está cargado en la venta actual. ¿Cambiar su precio al de este historial?",
                        showCancelButton: true,
                        confirmButtonText: "Sí, cambiar",
                        cancelButtonText: "No, solo copiar"
                    }).then(function (result) {
                        if (result.isConfirmed) preguntar();
                    });
                } else if (confirm(producto + " ya está en el carrito. ¿Cambiar su precio al de este historial?")) {
                    preguntar();
                }
            });

            $("#modalLineaVenta").on("shown.bs.modal", actualizarBotonPegarPrecio);

            $("#btnPegarPrecioCopiado").on("click", function () {
