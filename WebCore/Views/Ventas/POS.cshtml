                window.POSState.setListaExpendios(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(listaExpendiosEdicionPos)));
                posCart.renderTable(window.POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();
                posCart.updateCartSummary?.();
                posComment.updateButtonState?.();
                posExpendios.syncAssignedFromCart?.();
                </text>
            }

            // ===== Batch 7, iteracion 6: soloFormaPago ("Cambiar Forma de Pago") =====
            // Reusa toda la mecanica de edicion de venta de la iteracion 5 -- solo bloquea la UI
            // de productos y abre el modal de forma de pago automaticamente. Port literal de
