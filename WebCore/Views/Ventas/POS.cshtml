                duplicateWindowName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize("CarniSysPOSDuplicado-" + idUsuarioPOS + "-" + idSucursalPOS))
            };
            window.POSModo = window.POSModo || {};
            window.POSModo.instancia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posModoInstancia));
            window.POSModo.instanceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceId));
            window.POSModo.soloFormaPago = @(soloFormaPago ? "true" : "false");
            window.POSModo.returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrlPOS));
            window.POSMultiInstance?.init?.();

            // ===== Buscador de cliente real (F9), 2026-09-06 (retomado, ver docs/DECISIONS.md).
            // Port literal de Web/Views/Ventas/POS.cshtml:1829-1881 (helpers) y :2133-2196
            // (handlers de #btnBuscarPersona/#btnConsumidorFinal). =====
            var posCtaCtePermisoCompleto = @(ViewBag.PuedeVerCtaCteCompleta != null && (bool)ViewBag.PuedeVerCtaCteCompleta ? "true" : "false");

            window.api = window.api || {};
            window.api.persona = {
                listar: '@Url.Action("Listar", "Personas")',
                buscar: '@Url.Action("Buscar", "Personas")',
                obtener: '@Url.Action("Obtener", "Personas")',
                crear: '@Url.Action("PersonaModal", "Personas")',
                guardarCrear: '@Url.Action("GuardarPersonaModal", "Personas")'
            };

            function normalizeClientText(value) {
                return (value || "").toString().trim();
            }

            function setClienteIdentificacionVisual(identificacion, razonSocial) {
                var razon = normalizeClientText(razonSocial || $("#razonSocial").val());
                var identificacionNormalizada = normalizeClientText(identificacion);
                var $wrap = $("#clienteIdentificacionWrap");
                var $texto = $("#clienteIdentificacionTexto");
                var $valor = $("#clienteIdentificacionValor");

                if (!$wrap.length || !$texto.length) return;

                var mostrar = !!identificacionNormalizada && !!razon &&
                    identificacionNormalizada.localeCompare(razon, undefined, { sensitivity: 'accent' }) !== 0;

                if ($valor.length) $valor.val(identificacionNormalizada);
                $texto.text(identificacionNormalizada);
                $wrap.attr("title", identificacionNormalizada);
                $wrap.toggleClass("d-none", !mostrar);
            }

            window.setClienteIdentificacionVisual = setClienteIdentificacionVisual;

            // Gate del historial de precios por cliente (F8 / boton), 2026-09-06 (retomado -- ver
            // docs/DECISIONS.md): mismo criterio de sensibilidad que Finanzas/CtaCtePersona -- se
            // oculta con Consumidor Final y con clientes de cuenta corriente si el usuario no tiene
            // permiso para ver cuentas corrientes completas. Este chequeo del lado del cliente es
            // solo comodidad de UX; el limite real lo vuelve a aplicar el controller
            // (VentasController.HistorialPreciosCliente) antes de devolver los precios. Port literal
            // de Web/Views/Ventas/POS.cshtml:1883-1933.
            function actualizarAccesoHistorialPreciosCliente(idPersona) {
                var $btn = $("#btnHistorialPreciosCliente");
                idPersona = parseInt(idPersona, 10) || 0;

                // Un precio copiado es especifico del cliente del que se copio -- si cambia el
                // cliente, no tiene sentido seguir ofreciendo "Pegar" con un precio de otro cliente.
                window.POSPrecioCopiado = null;

                function deshabilitar() {
                    window.POSHistorialPreciosHabilitado = false;
                    $btn.addClass("d-none");
                }

                function habilitar() {
                    window.POSHistorialPreciosHabilitado = true;
                    $btn.removeClass("d-none");
                }

                if (!idPersona || idPersona === @idConsumidorFinalPOS) {
                    deshabilitar();
                    return;
                }

                if (!window.api || !window.api.persona || !window.api.persona.obtener) {
                    deshabilitar();
                    return;
                }

                $.get(window.api.persona.obtener, { id: idPersona })
                    .done(function (resp) {
                        if (!resp || !resp.ok) {
                            deshabilitar();
                            return;
                        }

                        var ocultarPorCtaCte = !!resp.ctaCte && !posCtaCtePermisoCompleto;
                        if (ocultarPorCtaCte) {
                            deshabilitar();
                        } else {
                            habilitar();
                        }
                    })
                    .fail(deshabilitar);
            }

            window.actualizarAccesoHistorialPreciosCliente = actualizarAccesoHistorialPreciosCliente;

            function resolverIdentificacionClienteActual() {
                var idPersonaActual = parseInt($("#idPersona").val(), 10) || 0;
                var razonActual = normalizeClientText($("#razonSocial").val());
                var identificacionActual = normalizeClientText($("#clienteIdentificacionValor").val() || $("#clienteIdentificacionTexto").text());

                if (!idPersonaActual || idPersonaActual === @idConsumidorFinalPOS || !razonActual || identificacionActual) {
                    return;
                }

                if (!window.api || !window.api.persona || !window.api.persona.obtener) return;

                $.get(window.api.persona.obtener, { id: idPersonaActual }).done(function (resp) {
                    if (!resp || !resp.ok) return;

                    var razonRespuesta = normalizeClientText(resp.razonSocial || razonActual);
                    var identificacionRespuesta = normalizeClientText(resp.identificacion);
                    if (!identificacionRespuesta) return;

                    setClienteIdentificacionVisual(identificacionRespuesta, razonRespuesta || razonActual);
                });
            }

            resolverIdentificacionClienteActual();
            actualizarAccesoHistorialPreciosCliente($('#idPersona').val());

            $(document).on('click', '#btnBuscarPersona', function () {
