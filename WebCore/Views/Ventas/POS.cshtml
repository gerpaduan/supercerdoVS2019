    @* Usuario de produccion (Batch 5, 2026-09-06, ver docs/DECISIONS.md) -- port literal de
       Web/Views/Ventas/POS.cshtml:1396-1486. Vive en un bloque propio, ANTES del IIFE de
       "cajaAbierta" de abajo: con requiereOperadorPOS el controller devuelve Model=null (mismo
       caso que !cajaAbierta), asi que este bloque no puede depender de #pos-app/#inputCodigo --
       solo depende del modal de _ModalSeleccionUsuario.cshtml, que ahora se renderiza siempre
       (ver el @@if/else if/else de mas arriba). *@
    <script>
        (function () {
            window.PosOperadorConfig = {
                esUsuarioProduccion: @(esUsuarioProduccionPOS ? "true" : "false"),
                requiereOperadorPOS: @(requiereOperadorPOS ? "true" : "false"),
                posInstanceId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceId)),
                urlAutorizar: '@Url.Action("AutorizarOperadorPOS", "Ventas")',
                urlCerrar: '@Url.Action("CerrarOperadorPOS", "Ventas")',
                usuariosActivos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UsuariosActivosEmpresa ?? new System.Collections.Generic.List<object>()))
            };

            var cfg = window.PosOperadorConfig;
            if (!cfg.esUsuarioProduccion) return;

            var loginObligatorioPendiente = false;

            // No confiar en que pos-multi-instance.js ya sincronizo posInstanceId a la URL --
            // un location.reload() plano perdia el posInstanceId y el servidor generaba uno
            // nuevo en cada vuelta, mostrando el login en loop infinito (bug real ya encontrado
            // y corregido en el clasico). Se arma la URL a mano, explicita.
            function recargarConOperadorAutorizado() {
                var url = new URL(window.location.href);
                url.searchParams.set('posInstanceId', cfg.posInstanceId);
                window.PosNavegandoInternoPOS = true;
                window.location.href = url.toString();
            }

            function pedirOperador(esInicial) {
                loginObligatorioPendiente = esInicial;
                window.SeleccionUsuario.abrir({
                    titulo: esInicial ? 'Autorizate para operar este Punto de Venta' : 'Cambiar operario',
                    usuarios: cfg.usuariosActivos,
                    requierePassword: true,
                    validarUrl: cfg.urlAutorizar + '?posInstanceId=' + encodeURIComponent(cfg.posInstanceId),
                    obligatorio: esInicial
                }).then(function () {
                    loginObligatorioPendiente = false;
                    recargarConOperadorAutorizado();
                }).catch(function () {
                    if (esInicial) window.location.href = '@Url.Action("Index", "Home")';
                });
            }

            // Red de seguridad: si el login era obligatorio y el modal se cierra sin resolver
            // (Escape/backdrop/"Cancelar"/X), el Promise de SeleccionUsuario.abrir() nunca se
            // resuelve NI se rechaza (ver seleccion-usuario.js) -- sin esto, .catch() nunca corre.
            $(document).on('hidden.bs.modal', '#modalSeleccionUsuario', function () {
                if (loginObligatorioPendiente && !$(this).data('resuelto')) {
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });

            if (cfg.requiereOperadorPOS) {
                pedirOperador(true);
            }

            $(document).on('click', '#btnCambiarOperadorPOS', function () {
                pedirOperador(false);
            });

            // BUG real ya encontrado y corregido en el clasico: 'pagehide' dispara con CUALQUIER
            // navegacion, incluida una vuelta a esta misma instancia de POS (reload post-login,
            // cambio de sucursal, reset post-venta) -- el sendBeacon de limpieza competia con el
            // GET de la pagina siguiente por la misma Session, borrando el operador recien
            // autorizado antes de que la pagina nueva lo buscara. Las navegaciones que vuelven a
            // esta misma instancia marcan window.PosNavegandoInternoPOS=true antes de navegar.
            window.addEventListener('pagehide', function () {
                if (window.PosNavegandoInternoPOS) return;
                if (navigator.sendBeacon) {
                    var data = new Blob([JSON.stringify({ posInstanceId: cfg.posInstanceId })], { type: 'application/json' });
                    navigator.sendBeacon(cfg.urlCerrar + '?posInstanceId=' + encodeURIComponent(cfg.posInstanceId), data);
                }
            });
        })();
    </script>

    <script>
        (function () {
            if (@(requiereOperadorPOS ? "true" : "false")) return;

            var cajaAbierta = @(cajaAbierta ? "true" : "false");

            if (!cajaAbierta) {
                function pad(n) { return (n < 10 ? "0" : "") + n; }
                function nowAR() {
                    var d = new Date();
                    return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear()
                        + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
                }

                function mostrarErrorAbrirCaja(msg) {
                    if (window.Swal) {
                        Swal.fire({ icon: "error", title: "No se pudo abrir la caja", text: msg || "Error" });
                    } else {
                        alert(msg || "No se pudo abrir la caja");
                    }
                }

                window.abrirCaja = function () {
                    var cajaInicio = $("#montoInicial").val();
                    var fechaHora = $("#fechaHoraApertura").val();

                    $.ajax({
                        url: "@Url.Action("AbrirCaja", "Cajas")",
                        type: "POST",
                        dataType: "json",
                        // posInstanceId real (2026-09-06, ver docs/DECISIONS.md) -- antes iba
                        // vacio a proposito, asi que CajasController.AbrirCaja nunca podia
                        // resolver el operador real de la cuenta compartida de produccion.
                        data: { cajaInicio: cajaInicio, fechaHora: fechaHora, posInstanceId: window.PosOperadorConfig?.posInstanceId || "" },
                        success: function (r) {
                            if (r && r.ok) {
                                $("#modalAbrirCaja").modal("hide");
                                // Mismo fix que pvbContinuarNuevaVenta (2026-09-10, item 9, ver
                                // docs/DECISIONS.md) -- bug secundario de la misma familia.
                                window.PosNavegandoInternoPOS = true;
                                location.reload();
                                return;
                            }
                            mostrarErrorAbrirCaja((r && r.mensaje) ? r.mensaje : "Error al abrir caja.");
                        },
                        error: function () {
                            mostrarErrorAbrirCaja("No se pudo contactar al servidor.");
                        }
                    });
                };

                $(function () {
                    $("#fechaHoraApertura").val(nowAR());
                    $("#modalAbrirCaja").modal("show");
                    $("#modalAbrirCaja").on("shown.bs.modal", function () {
                        $("#montoInicial").trigger("focus");
                    });

                    $("#btnCancelarAbrirCaja").off("click").on("click", function () {
                        window.location.href = "@Url.Action("Index", "Home")";
                    });

                    // Item 7 (2026-09-11, ver docs/DECISIONS.md "gate de caja abierta"): checkbox
                    // + boton solo existen cuando ViewBag.PuedeOperarSinCajaBypass es true (ver
                    // _AbrirCajaModal.cshtml) -- confirmacion explicita, requerida SIEMPRE que no
                    // haya caja real, antes de entrar a POS con el banner de advertencia.
                    $("#chkOperarSinCaja").off("change").on("change", function () {
                        $("#btnContinuarSinCaja").prop("disabled", !$(this).is(":checked"));
                    });

                    $("#btnContinuarSinCaja").off("click").on("click", function () {
                        var $btn = $(this);
                        $btn.prop("disabled", true);

                        $.ajax({
                            url: "@Url.Action("ContinuarSinCajaAbierta", "Ventas")",
                            type: "POST",
                            dataType: "json",
                            data: { posInstanceId: "@posInstanceId" },
                            headers: { RequestVerificationToken: document.querySelector('#globalAntiForgeryToken input[name="__RequestVerificationToken"]')?.value || "" },
                            success: function (r) {
                                if (r && r.ok) {
                                    window.PosNavegandoInternoPOS = true;
                                    location.reload();
                                    return;
                                }
                                mostrarErrorAbrirCaja((r && r.msg) ? r.msg : "No se pudo continuar sin abrir caja.");
                                $btn.prop("disabled", false);
                            },
                            error: function () {
                                mostrarErrorAbrirCaja("No se pudo contactar al servidor.");
                                $btn.prop("disabled", false);
                            }
                        });
                    });

                    $("#montoInicial").off("keydown").on("keydown", function (e) {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            window.abrirCaja();
                        }
                        if (e.key === "Escape") {
                            e.preventDefault();
                            $("#btnCancelarAbrirCaja").trigger("click");
                        }
                    });
                });

                return;
            }

            // ===== Caja abierta: bootstrap del POS (batch 1+2) =====

            function beep() {
                var audio = document.getElementById("beep");
                if (!audio) return;
                audio.currentTime = 0;
                audio.play();
            }

            function mostrarErrorConexion(msg) {
                if (window.Swal) {
                    Swal.fire({ icon: "error", title: "Sin conexión", text: msg, allowOutsideClick: false });
                } else {
                    alert(msg);
                }
            }

            var posProduct = null;
            var posCart = null;
            var posBalanza = null;

            var posKeyboard = window.POSKeyboard.create({
                handleEnter: function () { return posProduct ? posProduct.handleEnter() : null; },
                calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
                // omitirSugerenciaAlta=true (5to arg): bug real reportado 2026-09-12 -- el teclado
                // virtual llama a finishTyping en CADA digito (writeCharacter/backspace de
                // pos-keyboard.js), igual que bindLiveSearch() hace con el tipeo fisico via keyup.
                // Sin este flag, la sugerencia de alta rapida aparecia con el codigo a medio
                // escribir; recien debe ofrecerse al confirmar con Enter (fisico o "Enter" del
                // propio teclado virtual, que pasa por handleEnter(), no por aca).
                finishTyping: function (value) { return posProduct ? posProduct.finishTyping(value, undefined, undefined, undefined, true) : null; },
                setEnterDesdeTecladoVirtual: function (value) { return posProduct ? posProduct.setEnterDesdeTecladoVirtual(value) : null; },
                onManualModeRequested: function (inputId) { return posBalanza ? posBalanza.alternarDesdeAsterisco(inputId) : null; }
            });

            posProduct = window.POSProduct.create({
                soloFormaPago: false,
                calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
                addProduct: function () { return posCart ? posCart.addProduct() : null; },
                getInputActivo: function () { return posKeyboard.getInputActivo(); },
                clearInputActivo: function () { return posKeyboard.clearInputActivo(); },
                showConnectionError: mostrarErrorConexion,
                onProductoChanged: function (producto) { return posBalanza ? posBalanza.onProductoChanged(producto) : null; },
                onProductoConfirmed: function (producto) { return posBalanza ? posBalanza.onProductoConfirmed(producto) : null; }
            });

            posCart = window.POSCart.create({
                POSState: window.POSState,
                soloFormaPago: false,
                eliminarFisicoLineasPendientes: false,
                // Bonificar sin restriccion -- mismo criterio que el resto de la migracion
                // (usuario stub Admin=true, el chequeo de permiso del original siempre da OK).
                puedeBonificar: true,
                getProductoSeleccionado: function () { return posProduct.getProductoSeleccionado(); },
                setProductoSeleccionado: function (value) { return posProduct.setProductoSeleccionado(value); },
                getPrecioActual: function () { return posProduct.getPrecioActual(); },
                beep: beep,
                focusCodigo: function () { return posKeyboard.focusCodigo(); },
                showWaiting: function () { return posProduct.showWaiting(); },
                scrollPantallaMobile: function () { },
                handleEnter: function () { return posProduct.handleEnter(); },
                getTypingTimer: function () { return posProduct.getTypingTimer(); },
                setEnterDesdeTecladoVirtual: function (value) { return posProduct.setEnterDesdeTecladoVirtual(value); },
