            window.POSFormaPagoConfig = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FormasPagoConfig ?? new Dictionary<string, decimal>()));
            if (typeof window.POSState.setRequierePreseleccionFormaPago === "function") {
