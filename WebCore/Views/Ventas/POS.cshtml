            // ===== Batch 6: post-venta basico (ticket + PDF + email, sin AFIP automatica) =====
            // Reemplaza al modal real de post-venta (modal-postventa.js: ticket ESC/POS con
            // agente local, factura AFIP automatica, WhatsApp -- 1298 lineas, no portado, ver
            // header del archivo). Este modal reducido cubre: ticket termico HTML (58/80mm, el
            // navegador hace de "agente" con su propio dialogo de impresion), PDF (con eleccion de
            // tipo de comprobante) y email -- ver docs/DECISIONS.md 2026-09-06.
            var pvbDocumentoEmail = "detalle";

            // Tamaño de ticket recordado (2026-09-06, pedido explicito del usuario -- ver
            // docs/DECISIONS.md): misma clave literal que usa Web clasico (postventa_ticket_mm)
            // para el mismo concepto, aunque WebCore no comparte localStorage con el clasico (son
            // origenes distintos) -- se reutiliza el nombre solo por consistencia de convencion.
            var KEY_TICKET_MM = "postventa_ticket_mm";
            function pvbObtenerMedidaTicket() {
                var guardado = parseInt(localStorage.getItem(KEY_TICKET_MM), 10);
                return (guardado === 58 || guardado === 80) ? guardado : null;
            }
            function pvbGuardarMedidaTicket(mm) {
                try { localStorage.setItem(KEY_TICKET_MM, String(mm)); } catch (e) { }
            }
            function pvbActualizarTextoMedida() {
                var mm = pvbObtenerMedidaTicket() || 80;
                $("#pvbTicketMedidaTexto").text(mm + "mm");
            }
            function pvbElegirMedidaTicket() {
                return Swal.fire({
                    title: "Tamaño de ticket",
                    input: "select",
                    inputOptions: { 80: "80 mm", 58: "58 mm" },
                    inputValue: pvbObtenerMedidaTicket() || 80,
                    showCancelButton: true,
                    confirmButtonText: "Usar este tamaño",
                    cancelButtonText: "Cancelar"
                }).then(function (result) {
                    if (!result.isConfirmed) return null;
                    var mm = parseInt(result.value, 10);
                    pvbGuardarMedidaTicket(mm);
                    pvbActualizarTextoMedida();
                    return mm;
                });
            }

            window.mostrarModalPostVenta = function (ventaId) {
                // Filtros del modal de expendios reiniciados al finalizar (pedido explicito del
                // usuario, ver docs/DECISIONS.md).
                posExpendios.resetFiltros();
                // Sin beep al finalizar (2026-09-06, pedido explicito del usuario -- ver
                // docs/DECISIONS.md): se confundia con el beep de "producto agregado al carrito"
                // (options.beep() en pos-cart.js), que sigue sonando igual que siempre. Se saca
                // SOLO este beep puntual, no la funcion beep() en si (la sigue usando el resto
                // del POS).

                var total = window.POSState?.getTotal ? window.POSState.getTotal() : 0;
                $("#pvbResumenVenta").text("Venta #" + ventaId + " registrada correctamente.");
                $("#pvbTotalVenta").text("$ " + total.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $("#btnPvbImprimir").data("venta-id", ventaId);
                $("#btnPvbTicket").data("venta-id", ventaId);
                $("#btnPvbEmail").data("venta-id", ventaId);
                pvbActualizarTextoMedida();

                $("#modalPostVentaBasico").modal("show");
            };

            // ===== Ticket termico HTML (58/80mm), 2026-09-06 (pedido explicito del usuario -- ver
            // docs/DECISIONS.md) =====
            $("#btnPvbTicket").on("click", function () {
                var ventaId = $(this).data("venta-id");
                var mmRecordado = pvbObtenerMedidaTicket();

                function abrirTicket(mm) {
                    window.open(window.api.venta.imprimirTicketHtml + "?id=" + ventaId + "&mm=" + mm, "_blank");
                }

                if (mmRecordado) {
                    abrirTicket(mmRecordado);
