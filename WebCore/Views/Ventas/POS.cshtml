            // pos-cart.js/forma-pago.js/pos-multi-instance.js YA llaman a window.POSDraft?.save?.()
            // y window.desactivarAvisoSalidaPOS (definido en pos-cart.js) -- nada mas que tocar ahi.
            window.POSDraft = window.POSDraft || (function () {
                const keyBase = "carnisys-pos-venta-en-curso";
                const idSucursalActual = parseInt($("#idSucursalPOS").val(), 10) || 0;
                const idUsuarioActual = @idUsuarioPOS;
                const draftSuffix = (window.POSMultiInstanceConfig && window.POSMultiInstanceConfig.instanceId)
                    ? window.POSMultiInstanceConfig.instanceId
                    : "default";
                const key = keyBase + "-" + idUsuarioActual + "-" + idSucursalActual + "-" + draftSuffix;

                function save() {
                    if (window.esEdicionVenta) {
                        clear();
                        return;
                    }

                    if (window.POSFinalizandoVenta || window.POSVentaFinalizada) {
                        localStorage.removeItem(key);
                        return;
                    }

                    const lineas = POSState.getLineas();

                    if (!lineas.some(function (linea) { return !!linea; })) {
                        if (window.POSCancelacionEnCurso) return;
                        localStorage.removeItem(key);
                        return;
                    }

                    localStorage.setItem(key, JSON.stringify({
                        lineas: lineas,
                        listaExpendios: POSState.getListaExpendios ? POSState.getListaExpendios() : [],
                        formaPagoPreseleccionada: POSState.getFormaPagoPreseleccionada ? POSState.getFormaPagoPreseleccionada() : null,
                        idUsuarioPOS: idUsuarioActual,
                        idSucursalPOS: idSucursalActual,
                        idPersona: $("#idPersona").val(),
                        razonSocial: $("#razonSocial").val(),
                        observaciones: POSState.getObservaciones(),
                        fechaVenta: $("#fechaVenta").val()
                    }));
                }

                function tryParseDraft() {
                    try {
                        return JSON.parse(localStorage.getItem(key) || "null");
                    } catch (e) {
                        localStorage.removeItem(key);
                        return null;
                    }
                }

                function esDraftCompatible(draft) {
                    if (!draft || !Array.isArray(draft.lineas)) return false;

                    const lineasCargadas = draft.lineas.filter(function (linea) { return !!linea; });
                    if (!lineasCargadas.length) return false;

                    const draftSucursal = parseInt(draft.idSucursalPOS, 10);
                    if (Number.isFinite(draftSucursal) && draftSucursal > 0 && draftSucursal !== idSucursalActual) return false;

                    const draftUsuario = parseInt(draft.idUsuarioPOS, 10);
                    if (Number.isFinite(draftUsuario) && draftUsuario > 0 && draftUsuario !== idUsuarioActual) return false;

                    return true;
                }

                function restore() {
                    if (window.POSMultiInstance?.isBlocked?.()) {
                        return false;
                    }

                    let draft = tryParseDraft();

                    if (!esDraftCompatible(draft)) {
                        if (draft != null) localStorage.removeItem(key);
                        draft = null;
                    }

                    if (!draft) return false;

                    POSState.setLineas(draft.lineas);
                    POSState.setListaExpendios?.(draft.listaExpendios || []);
                    POSState.setFormaPagoPreseleccionada?.(draft.formaPagoPreseleccionada || null);

                    if (draft.idPersona) $("#idPersona").val(draft.idPersona);
                    if (draft.razonSocial) $("#razonSocial").val(draft.razonSocial);
                    if (draft.idPersona) {
                        // 2026-09-06 (retomado -- ver docs/DECISIONS.md): al restaurar un borrador
                        // con un cliente real (no Consumidor Final), hay que re-resolver la
                        // identificacion visual y el gate de historial de precios -- sin esto, el
                        // draft restaurado dejaba la linea "Ident.:" y el boton de historial en el
                        // estado que tenian antes de recargar la pagina, no el del cliente restaurado.
                        resolverIdentificacionClienteActual();
                        actualizarAccesoHistorialPreciosCliente(draft.idPersona);
                    }
                    if (draft.observaciones != null) POSState.setObservaciones(draft.observaciones);
                    if (draft.fechaVenta) $("#fechaVenta").val(draft.fechaVenta);

                    return true;
                }

                function clear() {
                    localStorage.removeItem(key);
                }

                return { save: save, restore: restore, clear: clear };
            })();

            const ventaRestauradaPOS = window.esEdicionVenta ? false : window.POSDraft.restore();
            if (ventaRestauradaPOS) {
                posCart.renderTable(window.POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();
                posCart.updateCartSummary?.();
                posComment.updateButtonState?.();
                posExpendios.syncAssignedFromCart?.();
            }

            function hayVentaActivaPOS() {
                if (window.POSFinalizandoVenta) return false;
                if (window.POSCancelacionEnCurso) return true;

                const lineas = window.POSState?.getLineas?.() || [];
                return lineas.some(function (linea) { return !!linea; });
