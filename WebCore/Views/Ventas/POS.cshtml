                            </div>

                            <div class="col-6">
                                <label id="lblTipoPorcentaje" class="small">% bonificación</label>
                                <input id="txtPorcentaje" class="form-control text-right" inputmode="decimal" autocomplete="off" readonly>
                            </div>
                        </div>

                        <button id="btnAplicarBonificacion" class="btn btn-primary btn-block mt-3">
                            Aplicar bonificación
                        </button>

                        <div class="mt-2"></div>
                    </div>

                    <div id="bloqueCantidad" style="display:none">
                        <button id="btnAplicarCantidad" class="btn btn-primary btn-block mt-3">
                            Aplicar cantidad
                        </button>

                        <div class="mt-2"></div>
                    </div>

                    <div class="d-flex flex-column" style="gap:.5rem;">

                        <button id="btnMostrarBonificar" class="btn btn-success">
                            <i class="fas fa-percentage"></i> Bonificar
                        </button>

                        <button id="btnMostrarCantidad" class="btn btn-info">
                            <i class="fas fa-sort-numeric-up"></i> Cantidad
                        </button>

                        <button id="btnEliminarItem" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>

    @Html.Partial("~/Views/Ventas/_FormaPagoModal.cshtml")
    @Html.Partial("~/Views/Ventas/_ModalExpendiosPOS.cshtml")
    @Html.Partial("~/Views/Ventas/_ModalObservacionesExpendio.cshtml")
    @Html.Partial("~/Views/Ventas/_ModalPostVentaBasico.cshtml")
    @Html.Partial("~/Views/Ventas/_ModalComentarioVenta.cshtml")
    @Html.Partial("~/Views/Ventas/_ModalAyudaPOS.cshtml")
    @Html.Partial("~/Views/Shared/_CalculadoraBilletesModal.cshtml")

    <div id="globalAntiForgeryToken" style="display:none;">
        @Html.AntiForgeryToken()
    </div>
}
else
{
    @Html.Partial("~/Views/Cajas/_AbrirCajaModal.cshtml")
}

@section Scripts {
    <script src="~/Scripts/carnisys.balanza.js?v=1"></script>
    <script src="~/Scripts/app/pos-state.js?v=1"></script>
    <script src="~/Scripts/app/pos-keyboard.js?v=1"></script>
    <script src="~/Scripts/app/pos-product.js?v=1"></script>
    <script src="~/Scripts/app/pos-cart.js?v=1"></script>
    <script src="~/Scripts/app/pos-balanza.js?v=1"></script>
    <script src="~/Scripts/app/forma-pago.js?v=1"></script>
    <script src="~/Scripts/app/ventas-expendios-pos.js?v=1"></script>
    <script src="~/Scripts/app/pos-comment.js?v=1"></script>
    <script src="~/Scripts/app/pos-help.js?v=1"></script>
    <script src="~/Content/vendor/zxing/zxing.min.js"></script>
    <script src="~/Scripts/app/scanner.js"></script>
    <script src="~/Scripts/app/calculadora-billetes.js?v=3239"></script>
    <script src="~/Scripts/app/calculadora-billetes-targets.js?v=7"></script>
    <script src="~/Scripts/app/pos-multi-instance.js?v=1"></script>

    <script>
        (function () {
            var cajaAbierta = @(cajaAbierta ? "true" : "false");

            if (!cajaAbierta) {
                function pad(n) { return (n < 10 ? "0" : "") + n; }
                function nowAR() {
                    var d = new Date();
                    return pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear()
                        + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
                }

                function mostrarErrorAbrirCaja(msg) {
                    if (window.Swal) {
                        Swal.fire({ icon: "error", title: "No se pudo abrir la caja", text: msg || "Error" });
                    } else {
                        alert(msg || "No se pudo abrir la caja");
                    }
                }

                window.abrirCaja = function () {
                    var cajaInicio = $("#montoInicial").val();
                    var fechaHora = $("#fechaHoraApertura").val();

                    $.ajax({
                        url: "@Url.Action("AbrirCaja", "Cajas")",
                        type: "POST",
                        dataType: "json",
                        data: { cajaInicio: cajaInicio, fechaHora: fechaHora, posInstanceId: "" },
                        success: function (r) {
                            if (r && r.ok) {
                                $("#modalAbrirCaja").modal("hide");
                                location.reload();
                                return;
                            }
                            mostrarErrorAbrirCaja((r && r.mensaje) ? r.mensaje : "Error al abrir caja.");
                        },
                        error: function () {
                            mostrarErrorAbrirCaja("No se pudo contactar al servidor.");
                        }
                    });
                };

                $(function () {
                    $("#fechaHoraApertura").val(nowAR());
                    $("#modalAbrirCaja").modal("show");
                    $("#modalAbrirCaja").on("shown.bs.modal", function () {
                        $("#montoInicial").trigger("focus");
                    });

                    $("#btnCancelarAbrirCaja").off("click").on("click", function () {
                        window.location.href = "@Url.Action("Index", "Home")";
                    });

                    $("#montoInicial").off("keydown").on("keydown", function (e) {
                        if (e.key === "Enter") {
                            e.preventDefault();
                            window.abrirCaja();
                        }
                    });
                });

                return;
            }

            // ===== Caja abierta: bootstrap del POS (batch 1+2) =====

            function beep() {
                var audio = document.getElementById("beep");
                if (!audio) return;
                audio.currentTime = 0;
                audio.play();
            }

            function mostrarErrorConexion(msg) {
                if (window.Swal) {
                    Swal.fire({ icon: "error", title: "Sin conexión", text: msg, allowOutsideClick: false });
                } else {
                    alert(msg);
                }
            }

            var posProduct = null;
            var posCart = null;
            var posBalanza = null;

            var posKeyboard = window.POSKeyboard.create({
                handleEnter: function () { return posProduct ? posProduct.handleEnter() : null; },
                calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
                finishTyping: function (value) { return posProduct ? posProduct.finishTyping(value) : null; },
                setEnterDesdeTecladoVirtual: function (value) { return posProduct ? posProduct.setEnterDesdeTecladoVirtual(value) : null; },
                onManualModeRequested: function (inputId) { return posBalanza ? posBalanza.alternarDesdeAsterisco(inputId) : null; }
            });

            posProduct = window.POSProduct.create({
                soloFormaPago: false,
                calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
                addProduct: function () { return posCart ? posCart.addProduct() : null; },
                getInputActivo: function () { return posKeyboard.getInputActivo(); },
                clearInputActivo: function () { return posKeyboard.clearInputActivo(); },
                showConnectionError: mostrarErrorConexion,
                onProductoChanged: function (producto) { return posBalanza ? posBalanza.onProductoChanged(producto) : null; },
                onProductoConfirmed: function (producto) { return posBalanza ? posBalanza.onProductoConfirmed(producto) : null; }
            });

            posCart = window.POSCart.create({
                POSState: window.POSState,
                soloFormaPago: false,
                eliminarFisicoLineasPendientes: false,
                // Bonificar sin restriccion -- mismo criterio que el resto de la migracion
                // (usuario stub Admin=true, el chequeo de permiso del original siempre da OK).
                puedeBonificar: true,
                getProductoSeleccionado: function () { return posProduct.getProductoSeleccionado(); },
                setProductoSeleccionado: function (value) { return posProduct.setProductoSeleccionado(value); },
                getPrecioActual: function () { return posProduct.getPrecioActual(); },
                beep: beep,
                focusCodigo: function () { return posKeyboard.focusCodigo(); },
                showWaiting: function () { return posProduct.showWaiting(); },
                scrollPantallaMobile: function () { },
                handleEnter: function () { return posProduct.handleEnter(); },
                getTypingTimer: function () { return posProduct.getTypingTimer(); },
                setEnterDesdeTecladoVirtual: function (value) { return posProduct.setEnterDesdeTecladoVirtual(value); },
                beforeAddProduct: function (producto, cantidad) { return posBalanza ? posBalanza.beforeAddProduct(producto, cantidad) : { ok: true }; }
            });

            // ===== Batch 4: balanza fisica =====
            // Degrada sola a modo manual si el agente local (127.0.0.1:5100) no responde -- ver
            // Scripts/carnisys.balanza.js. #modalPesable del original NO se porta: confirmado
            // codigo muerto (ningun JS lo referencia, ver docs/DECISIONS.md).
            function mostrarAvisoBalanzaDiscreto(msg) {
                var $msg = $("#msgBalanzaPOS");
                if (!$msg.length) return;
                $msg.text(msg || "");
            }

            posBalanza = window.POSBalanza.create({
                baseUrl: "http://127.0.0.1:5100",
                statusIntervalMs: 2500,
                pesoIntervalMs: 250,
                calculateSubtotal: function () { return posCart ? posCart.calculateSubtotal() : null; },
                focusCantidad: function () { return posKeyboard.focusCantidad(); },
                focusCodigo: function () { return posKeyboard.focusCodigo(); },
                showNotice: mostrarAvisoBalanzaDiscreto
            });

            // ===== Batch 7 (parcial): comentario de venta =====
            // Se crea antes que posExpendios porque este la referencia (updateComentarioBadge).
            var posComment = window.POSComment.create({
                POSState: window.POSState,
                focusCodigo: function () { return posKeyboard.focusCodigo(); }
            });

            // ===== Batch 5: expendios asociados =====
            // BuscarExpendiosPOS/ObtenerExpendioPOS ya portados y verificados con datos reales
            // (PLAN-POS.md). Se abre con el atajo AvPag (PageDown), via el hook
            // window.posHotkeysHooks.AvPag registrado mas abajo (posHelp, batch 7 iteracion 2) --
            // no hay boton visible en ningun lado de POS.cshtml, se verifico con grep.
            var posExpendios = window.POSExpendios.create({
                POSState: window.POSState,
                renderTable: function (lineas) { return posCart ? posCart.renderTable(lineas) : null; },
                recalculateTotal: function () { return posCart ? posCart.recalculateTotal() : null; },
                updateSaleState: function () { return posCart ? posCart.updateSaleState() : null; },
                updateCartSummary: function () { return posCart ? posCart.updateCartSummary?.() : null; },
                beep: beep,
                showWaiting: function () { return posProduct ? posProduct.showWaiting() : null; },
                focusCodigo: function () { return posKeyboard.focusCodigo(); },
                updateComentarioBadge: function () { return posComment.updateButtonState(); }
            });
            window.POSExpendiosCurrent = posExpendios;

            // ===== Batch 7, iteracion 2: Ayuda (F1) =====
            var posHelp = window.POSHelp.create({
                focusCodigo: function () { return posKeyboard.focusCodigo(); },
                clickIfEnabled: function (selector) {
                    var button = document.querySelector(selector);
                    if (button && !button.disabled) {
                        button.click();
                    }
                }
            });

            window.posHotkeysHooks = window.posHotkeysHooks || {};
            window.posHotkeysHooks.AvPag = function () {
                window.POSExpendiosCurrent?.open?.();
            };
            // ===== Batch 7, iteracion 3: calculadora de billetes (F3) =====
            // Standalone -- sin usarDetalleExterno/selectorInputTotal, distinto del uso en
            // Cajas/_AddOrEditEgresoCaja.cshtml que si mergea el resultado en un textarea.
            window.posHotkeysHooks.F3 = function () {
                window.CalculadoraBilletes?.open?.({
                    tituloPantalla: "Ingreso de billetes",
                    titulo: "Detalle de billetes"
                });
            };
            // F2/F4-F8 y F9 (Buscar cliente) NO se registran a proposito: sus modulos originales
            // (CtasCtes/POSCompras/POSEgresos/POSFinanzas, boton de cliente) no estan portados
            // todavia -- pos-help.js los deja degradar solos (evento sin listener / boton
            // disabled), ver header del archivo.

            posProduct.init();
            posCart.init();
            posBalanza.init();
            posExpendios.init();
            posComment.init();
            posHelp.init();
            posKeyboard.init();

            // ===== Batch 7, iteracion 3: scanner de camara =====
            // Port literal de Web/Views/Ventas/POS.cshtml (~1614-1644): scanner.js/zxing.min.js
            // ya estaban portados byte-a-byte en WebCore (probados en Stock/Editar.cshtml), solo
            // faltaba el wiring en POS. manejarEnter -> window.manejarEnter, ya expuesto por
            // pos-product.js. #btnLimpiarScanner del partial compartido _ScannerCodigoBarra.cshtml
            // NO se usa aca a proposito: el bloque HTML de POS es el propio del original (con
            // Flash/Cerrar camara nomas), no el partial compartido con otros modulos.
            var scannerPOS = new BarcodeScanner({
                videoSelector: "#videoScanner",
                containerSelector: "#scannerContainer",
                onCodeDetected: function (codigo) {
                    document.querySelector("#inputCodigo").value = codigo;
                    document.querySelector("#inputCodigo").focus();
                    window.manejarEnter();
                }
            });
            document.getElementById("btnScanner")?.addEventListener("click", () => scannerPOS.iniciar());
            document.getElementById("btnCerrarScanner")?.addEventListener("click", () => scannerPOS.cerrar());
            document.getElementById("btnFlash")?.addEventListener("click", async () => {
                var estado = await scannerPOS.toggleFlash();
                var btn = document.getElementById("btnFlash");
                if (estado) {
                    btn.classList.remove("btn-secondary");
                    btn.classList.add("btn-warning");
                    btn.textContent = "Flash activo";
                } else {
                    btn.classList.remove("btn-warning");
                    btn.classList.add("btn-secondary");
                    btn.textContent = "Flash";
                }
            });

            // ===== Batch 3: forma de pago + Finalizar =====
            // URLs que consume forma-pago.js (Scripts/app/forma-pago.js, sin cambios de logica) --
            // FinalizarVenta/ModificarVenta ya portados y verificados con datos reales (PLAN-POS.md).
            window.api = window.api || {};
            window.api.venta = {
                pos: "@Url.Action("POS", "Ventas")",
                finalizar: "@Url.Action("FinalizarVenta", "Ventas")",
                modificar: "@Url.Action("ModificarVenta", "Ventas")",
                detalle: "@Url.Action("DetalleVenta", "Ventas")",
                buscarExpendiosPos: "@Url.Action("BuscarExpendiosPOS", "Ventas")",
                obtenerExpendioPos: "@Url.Action("ObtenerExpendioPOS", "Ventas")",
                imprimir: "@Url.Action("Imprimir", "Ventas")",
                obtenerDatosEmailComprobante: "@Url.Action("ObtenerDatosEmailComprobante", "Ventas")",
                enviarComprobanteEmail: "@Url.Action("EnviarComprobanteEmail", "Ventas")"
            };

            // Sucursal del cajero actual -- default del filtro de sucursal del modal de
            // expendios (batch 5, ver PLAN-POS-UI.md / docs/DECISIONS.md).
            window.idSucursalUsuarioPOS = @idSucursalPOS;

            // ===== Batch 7, iteracion 4: Duplicar POS (multi-instancia) =====
            // Recortado sin login de operador de produccion (no portado, ver header del
            // archivo) -- solo deteccion de conflicto entre pestañas via localStorage.
            // window.POSModo.instanceId es ademas lo que forma-pago.js:594 manda como
            // posInstanceId al finalizar (antes siempre '', vestigio inerte porque
            // window.POSModo no existia -- con esto queda conectado de verdad).
            window.POSMultiInstanceConfig = {
                role: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posModoInstancia)),
                instanceId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceId)),
                userId: @idUsuarioPOS,
                sucursalId: @idSucursalPOS,
                homeUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Index", "Home"))),
                originalUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("POS", "Ventas", new { modoPos = "original" }))),
                duplicateBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("POS", "Ventas"))),
                originalWindowName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize("CarniSysPOS-" + idUsuarioPOS + "-" + idSucursalPOS + "-original")),
                windowName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize("CarniSysPOS-" + idUsuarioPOS + "-" + idSucursalPOS + "-" + posModoInstancia)),
                duplicateWindowName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize("CarniSysPOSDuplicado-" + idUsuarioPOS + "-" + idSucursalPOS))
            };
            window.POSModo = window.POSModo || {};
            window.POSModo.instancia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posModoInstancia));
            window.POSModo.instanceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceId));
            window.POSModo.soloFormaPago = @(soloFormaPago ? "true" : "false");
            window.POSMultiInstance?.init?.();

            // ===== Batch 7, iteracion 5: edicion de venta existente =====
            // Recortado sin soloFormaPago (queda para una iteracion siguiente, ver
            // docs/10-migracion-aspnet-core/PLAN-POS-UI.md) y sin los permisos reales del
            // original (PuedeModificarUltimaVenta/PuedeCambiarFormaPago) -- ver TODO(claude) en
            // VentasController.POS().
            window.esEdicionVenta = @(esEdicionVenta ? "true" : "false");
            @if (esEdicionVenta)
            {
                <text>
                window.POSState.setLineas(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(lineasEdicionPos)));
                window.POSState.setListaExpendios(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(listaExpendiosEdicionPos)));
                posCart.renderTable(window.POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();
                posCart.updateCartSummary?.();
                posComment.updateButtonState?.();
                posExpendios.syncAssignedFromCart?.();
                </text>
            }

            // ===== Batch 7, iteracion 6: soloFormaPago ("Cambiar Forma de Pago") =====
            // Reusa toda la mecanica de edicion de venta de la iteracion 5 -- solo bloquea la UI
            // de productos y abre el modal de forma de pago automaticamente. Port literal de
            // Web/Views/Ventas/POS.cshtml:2390-2420,2801-2805.
            function volverDesdeSoloFormaPago() {
                window.desactivarAvisoSalidaPOS?.();
                window.location.href = window.api.venta.detalle + "?id=" + encodeURIComponent($("#idVentaEditar").val());
            }

            function aplicarModoSoloFormaPago() {
                if (!window.POSModo?.soloFormaPago) return;

                $("body").addClass("pos-solo-forma-pago");
                $("#inputCodigo, #inputCantidad, #fechaVentaEditable, #btnAgregarManual, #btnBuscarPersona, #btnConsumidorFinal, #btnScanner")
                    .prop("disabled", true)
                    .attr("readonly", "readonly");
                $("#tablaItems").addClass("pos-bloqueado");
                $("#btnSalirPOS").attr("href", window.api.venta.detalle + "?id=" + encodeURIComponent($("#idVentaEditar").val()));

                setTimeout(function () {
                    window.POSGuard
                        ? window.POSGuard.requestModalOpen("formaPago", function () {
                            window.abrirModalFormaPagoFinalizacion?.();
                        })
                        : window.abrirModalFormaPagoFinalizacion?.();
                }, 250);
            }

            $(document).on("hidden.bs.modal.posSoloFormaPago", "#modalFormaPago", function () {
                if (!window.POSModo?.soloFormaPago) return;
                if (window.POSSoloFormaPagoGuardado) return;
                volverDesdeSoloFormaPago();
            });

            aplicarModoSoloFormaPago();

            // RequierePreseleccionFormaPago SI se porta real (no hardcodeado): de esto depende
            // que "Pago Mixto" se pueda habilitar en el modal de Finalizar (ver Obtener
            // ConfiguracionFormaPagoPOS/RequierePreseleccionFormaPagoPOS en VentasController.cs).
            var requierePreseleccionFormaPago = @(ViewBag.RequierePreseleccionFormaPago != null && (bool)ViewBag.RequierePreseleccionFormaPago ? "true" : "false");
            window.POSFormaPagoConfig = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FormasPagoConfig ?? new Dictionary<string, decimal>()));
            if (typeof window.POSState.setRequierePreseleccionFormaPago === "function") {
                window.POSState.setRequierePreseleccionFormaPago(requierePreseleccionFormaPago);
            }

            // Port de Web/Views/Ventas/POS.cshtml:1716-1727 (faltaba en WebCore -- pedido del
            // usuario 2026-09-04 al probar "Modificar venta"). window.POSFormaPagoActual ya lo
            // lee window.preCargarFormaPagoActual (forma-pago.js, ya portado sin cambios): al
            // abrir el modal de Finalizar marca el boton de la forma de pago actual, muestra la
            // leyenda "Forma de pago actual: ..." (#formaPagoActualInfo, ya en _FormaPagoModal.
            // cshtml) y, si fue pago mixto, precarga #montoEfectivo/#montoOtroPago y tilda
            // #chkPagoMixto -- sin este init quedaba siempre vacio (undefined -> "").
            window.POSFormaPagoActual = {
                formaPago: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model != null ? Model.FormaPago ?? "" : "")),
                pagoMixtoEfectivo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model != null ? Model.PagoMixtoEfectivo : 0f)),
                total: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model != null ? Model.TotalImporte : 0f))
            };
            if (window.POSFormaPagoActual.formaPago && typeof window.POSState.setFormaPagoPreseleccionada === "function") {
                window.POSState.setFormaPagoPreseleccionada({
                    id: window.POSFormaPagoActual.formaPago,
                    nombre: window.POSFormaPagoActual.formaPago,
                    tipo: window.POSFormaPagoActual.formaPago
                });
            }

            $("#btnFinalizar").on("click", function () {
                window.abrirModalFormaPagoFinalizacion();
            });

            // ===== Batch 7, iteracion 2: Cancelar Venta =====
            // Port de guardarVentaAnuladaDirectamente (Web/Views/Ventas/POS.cshtml) con un
            // recorte deliberado: el original tiene 2 ramas mas en el handler de click
            // (esEdicionVenta / soloFormaPago) que dependen de la edicion de venta, todavia no
            // portada en WebCore -- ver header del archivo. Si en el futuro se porta edicion de
            // venta, agregar esas 2 ramas ahi mismo.
            var cancelandoVentaPOS = false;
            var indicesCancelacionPOS = [];

            function guardarVentaAnuladaDirectamente(omitirPostVenta) {
                if (cancelandoVentaPOS) return;

                var lineas = window.POSState?.getLineas?.() || [];
                var lineasActivas = lineas.filter(function (linea) {
                    return linea && !linea.anulado;
                });

                if (!lineas.length) {
                    Swal.fire({
                        icon: "info",
                        title: "Venta vacía",
                        text: "No hay una venta en curso para cancelar."
                    });
                    return;
                }

                cancelandoVentaPOS = true;
                window.POSCancelacionEnCurso = true;
                indicesCancelacionPOS = lineasActivas.map(function (linea) {
                    return linea.index;
                });
                $("#btnCancelarItem").prop("disabled", true);

                lineasActivas.forEach(function (linea) {
                    window.POSState.anularLinea(linea.index);
                });

                posCart.renderTable(window.POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();

                finalizarVenta({
                    formaPago: "Efectivo",
                    esPagoMixto: false,
                    efectivo: 0,
                    idPersona: $("#idPersona").val(),
                    omitirPostVenta: omitirPostVenta === true
                });
            }

            $("#btnCancelarItem").on("click", function () {
                if (window.POSModo?.soloFormaPago) {
                    volverDesdeSoloFormaPago();
                    return;
                }

                if (window.esEdicionVenta) {
                    Swal.fire({
                        icon: "warning",
                        title: "¿Salir de la edición?",
                        text: "Se descartarán los cambios no guardados.",
                        showCancelButton: true,
                        confirmButtonText: "Sí",
                        cancelButtonText: "No"
                    }).then(function (result) {
                        if (!result.isConfirmed) return;
                        window.location.href = window.api.venta.detalle + "?id=" + encodeURIComponent($("#idVentaEditar").val());
                    });
                    return;
                }

                Swal.fire({
                    icon: "warning",
                    title: "¿Realmente desea cancelar la venta?",
                    showCancelButton: true,
                    confirmButtonText: "Sí",
                    cancelButtonText: "No"
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    guardarVentaAnuladaDirectamente(true);
                });
            });

            $(document).on("ventaCancelacion:error", function () {
                indicesCancelacionPOS.forEach(function (index) {
                    var linea = window.POSState?.findLineaByIndex?.(index);
                    if (linea) linea.anulado = false;
                });

                indicesCancelacionPOS = [];
                cancelandoVentaPOS = false;
                window.POSCancelacionEnCurso = false;
                $("#btnCancelarItem").prop("disabled", false);
                posCart.renderTable(window.POSState.getLineas());
                posCart.recalculateTotal();
                posCart.updateSaleState();
            });

            // ===== Batch 6: post-venta basico (ticket + email, sin AFIP) =====
            // Reemplaza al modal real de post-venta (modal-postventa.js: ticket ESC/POS con
            // agente local, factura AFIP automatica, WhatsApp -- 1298 lineas, no portado, ver
            // header del archivo). Este modal reducido cubre imprimir (PDF via Imprimir, el
            // navegador hace de "agente" con su propio dialogo de impresion) y email (mismos
            // endpoints ya portados que usa Ventas/DetalleVenta).
            var pvbDocumentoEmail = "detalle";

            window.mostrarModalPostVenta = function (ventaId) {
                // Filtros del modal de expendios reiniciados al finalizar (pedido explicito del
                // usuario, ver docs/DECISIONS.md).
                posExpendios.resetFiltros();
                beep();

                var total = window.POSState?.getTotal ? window.POSState.getTotal() : 0;
                $("#pvbResumenVenta").text("Venta #" + ventaId + " registrada correctamente.");
                $("#pvbTotalVenta").text("$ " + total.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $("#btnPvbImprimir").attr("href", window.api.venta.imprimir + "?id=" + ventaId + "&documento=detalle");
                $("#btnPvbImprimir").data("venta-id", ventaId);
                $("#btnPvbEmail").data("venta-id", ventaId);

                $("#modalPostVentaBasico").modal("show");
            };

            function pvbContinuarNuevaVenta() {
                $("#modalPostVentaBasico").modal("hide");
                // Si esta es la pestaña "duplicado" (Duplicar POS, batch 7 iteracion 4): marca
                // el flag para que, tras el reload, pos-multi-instance.js la cierre y devuelva
                // el foco al POS original -- mismo patron que modal-postventa.js (el modal real,
                // no portado) usa en cerrarPostVentaYRecargar.
                window.POSMultiInstance?.closeAfterPostVenta?.();
                window.location.reload();
            }

            $("#btnPvbContinuar").on("click", pvbContinuarNuevaVenta);
            // Sin boton de cerrar (X) a proposito -- misma logica que el modal real
            // (data-backdrop="static", sin data-dismiss en el header): el cajero elige una
            // accion explicita ("Nueva venta") antes de volver al POS, no se puede pasar por alto
            // sin querer con un click afuera o Escape.

            $("#btnPvbEmail").on("click", function () {
                var ventaId = $(this).data("venta-id");
                $("#pvbEmailError").addClass("d-none").text("");

                $.ajax({
                    url: window.api.venta.obtenerDatosEmailComprobante,
                    type: "GET",
                    dataType: "json",
                    data: { id: ventaId }
                }).done(function (resp) {
                    if (!resp || !resp.ok) {
                        Swal.fire({ icon: "error", title: "No se pudo preparar el email", text: (resp && resp.msg) || "Error desconocido." });
                        return;
                    }

                    pvbDocumentoEmail = resp.tieneFactura ? "factura" : "detalle";
                    $("#pvbEmailDestino").val(resp.email || "");
                    $("#pvbEmailAsunto").val(resp.asunto || "");
                    $("#pvbEmailMensaje").val(resp.mensaje || "");
                    $("#modalEmailPostVentaPOS").modal("show");
                }).fail(function (xhr) {
                    Swal.fire({ icon: "error", title: "No se pudo preparar el email", text: (xhr.responseJSON && xhr.responseJSON.msg) || "Error de conexión." });
                });
            });

            $("#btnPvbConfirmarEmail").on("click", function () {
                var ventaId = $("#btnPvbEmail").data("venta-id");
                var email = ($("#pvbEmailDestino").val() || "").trim();
                var asunto = ($("#pvbEmailAsunto").val() || "").trim();
                var mensaje = ($("#pvbEmailMensaje").val() || "").trim();

                if (!email) {
                    $("#pvbEmailError").removeClass("d-none").text("Ingrese un email destino.");
                    return;
                }

                var $btn = $(this);
                $btn.prop("disabled", true);

                $.ajax({
                    url: window.api.venta.enviarComprobanteEmail,
                    type: "POST",
                    dataType: "json",
                    data: {
                        idVenta: ventaId,
                        emailDestino: email,
                        asunto: asunto,
                        mensaje: mensaje,
                        documento: pvbDocumentoEmail
                    }
                }).done(function (resp) {
                    $btn.prop("disabled", false);

                    if (!resp || !resp.ok) {
                        $("#pvbEmailError").removeClass("d-none").text((resp && resp.msg) || "No se pudo enviar el email.");
                        return;
                    }

                    $("#modalEmailPostVentaPOS").modal("hide");
                    Swal.fire({ icon: "success", title: "Email enviado", text: "El comprobante se envió correctamente." });
                }).fail(function (xhr) {
                    $btn.prop("disabled", false);
                    $("#pvbEmailError").removeClass("d-none").text((xhr.responseJSON && xhr.responseJSON.msg) || "No se pudo enviar el email.");
                });
            });

            (function () {
                var dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
                var meses = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

                function actualizarFechaHora() {
                    var ahora = new Date();
                    var texto = dias[ahora.getDay()] + " " + ahora.getDate() + " de " + meses[ahora.getMonth()]
                        + ", " + ahora.getFullYear() + ". " + String(ahora.getHours()).padStart(2, "0")
                        + ":" + String(ahora.getMinutes()).padStart(2, "0");

                    var span = document.getElementById("fechaHoraPOS");
                    if (span) span.innerText = texto;
                }

                actualizarFechaHora();
                setInterval(actualizarFechaHora, 60000);
            })();
        })();
    </script>
}
