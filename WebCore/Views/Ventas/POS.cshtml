            // ===== Factura Electronica (AFIP), 2026-09-06 (retomado -- ver docs/DECISIONS.md) =====
            // Port acotado de Web/Scripts/app/modal-postventa.js: solo abrirFacturaVentaModal/
            // abrirFacturaSinVentaModal/traerModalFacturaAlFrente (el modal en si, ya completo via
            // factura-electronica.js), NO el resto de ese archivo (ticket ESC/POS, WhatsApp, PDF
            // con seleccion de NC, email con seleccion de comprobante) -- esas piezas dependen del
            // modal post-venta COMPLETO (#modalPostVenta), que WebCore reemplaza a proposito por
            // _ModalPostVentaBasico.cshtml (ver header de ese archivo). Simplificacion deliberada:
            // al cerrar el modal de factura por cualquier via (facturada, cerrada sin facturar, o
            // cancelada sin forzar), siempre se reabre #modalPostVentaBasico (el clasico abre un
            // modal aparte con CAE/WhatsApp tras facturar con exito, que no existe aca) -- el
            // usuario igual puede imprimir/emailear el comprobante desde ahi.
            window.AppUrls = window.AppUrls || {
                ventasImprimir: '@Url.Action("ImprimirTicket", "Ventas")',
                ventasGenerarFactura: '@Url.Action("GenerarFactura", "Ventas")',
                ventasCerrarSinFacturar: '@Url.Action("CerrarVentaSinFacturar", "Ventas")',
                ventasGenerarNotaCredito: '@Url.Action("GenerarNotaCredito", "Ventas")',
                ventasNuevaFacturaSinVenta: '@Url.Action("NuevaFacturaSinVenta", "Ventas")',
                ventasCrearVentaManual: '@Url.Action("CrearVentaManualParaFactura", "Ventas")',
                ventasLimpiarLineasVentaManual: '@Url.Action("LimpiarLineasVentaManual", "Ventas")',
                personaListar: '@Url.Action("Listar", "Personas")'
            };

            function traerModalFacturaAlFrente($modal) {
                if (!$modal || !$modal.length) return;
                if (!$modal.parent().is('body')) $modal.appendTo('body');

                var zBase = 1040;
                $('.modal.show').not($modal).each(function () {
                    var zActual = parseInt($(this).css('z-index'), 10) || 1040;
                    if (zActual > zBase) zBase = zActual;
                });

                $modal.css('z-index', zBase + 20);
                window.setTimeout(function () {
                    $('.modal-backdrop').last().css('z-index', zBase + 10);
                }, 0);
            }

            var facturaOkPOS = false;

            function abrirFacturaVentaModal(ventaId) {
                if (!ventaId) return;
                facturaOkPOS = false;

                // dataType:'html' fuerza a jQuery a NO auto-parsear la respuesta como JSON aunque
                // el Content-Type sea application/json (el catch generico de ImprimirTicket
                // devuelve {ok:false,msg:...} con ese content-type ante cualquier excepcion).
                $.ajax({
                    url: window.AppUrls.ventasImprimir,
                    type: 'GET',
                    data: { id: ventaId, mm: 0 },
                    dataType: 'html'
                })
                    .fail(function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo abrir la factura electrónica.' });
                    })
                    .done(function (html) {
                        var pareceError = typeof html === 'string' && /^\s*\{\s*"ok"\s*:\s*false/.test(html);
                        if (pareceError) {
                            var msg = 'No se pudo abrir la factura electrónica.';
                            try { msg = JSON.parse(html).msg || msg; } catch (e) { }
                            Swal.fire({ icon: 'error', title: 'Error', text: msg });
                            return;
                        }

                        $('#contenedorFacturaElectronica').html(html);
                        var $modal = $('#modalFacturaElectronica');

                        traerModalFacturaAlFrente($modal);
                        $modal.modal({ backdrop: 'static', keyboard: false, show: true });
                    });
            }

            function abrirFacturaSinVentaModal() {
                facturaOkPOS = false;

                $.get(window.AppUrls.ventasNuevaFacturaSinVenta)
                    .done(function (html) {
                        $('#contenedorFacturaElectronica').html(html);
                        var $modal = $('#modalFacturaElectronica');

                        traerModalFacturaAlFrente($modal);
                        $modal.modal({ backdrop: true, keyboard: true, show: true });
                    })
                    .fail(function () {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo abrir el formulario de factura manual.' });
                    });
            }

            $('#btnPvbFactura').on('click', function () {
                var ventaId = $('#btnPvbImprimir').data('venta-id');
                $('#modalPostVentaBasico').modal('hide');
                abrirFacturaVentaModal(ventaId);
