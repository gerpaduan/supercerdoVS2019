            // ===== PDF con eleccion de tipo de comprobante, 2026-09-06 (pedido explicito del
            // usuario -- "agregar la generacion del pdf como lo hace el mvc clasico" -- ver
            // docs/DECISIONS.md). Mismo criterio que pvSeleccionarOpcionSimple del clasico
            // (Web/Scripts/app/modal-postventa.js): sin factura -> detalle directo; con nota de
            // credito -> elegir entre detalle/factura/nc; agrupa items -> elegir entre
            // detalle/factura; si no, factura directo. Reutiliza ObtenerDatosEmailComprobante
            // (mismos campos que ya consume el flujo de email) sin cambios de backend. =====
            $("#btnPvbImprimir").on("click", function () {
                var ventaId = $(this).data("venta-id");

                function abrirPdf(documento) {
                    window.open(window.api.venta.imprimir + "?id=" + ventaId + "&documento=" + documento, "_blank");
                }

                $.ajax({
                    url: window.api.venta.obtenerDatosEmailComprobante,
                    type: "GET",
                    dataType: "json",
                    data: { id: ventaId }
                }).done(function (resp) {
                    if (!resp || !resp.ok) {
                        Swal.fire({ icon: "error", title: "No se pudo preparar el PDF", text: (resp && resp.msg) || "Error desconocido." });
                        return;
                    }

                    if (!resp.tieneFactura) {
                        abrirPdf("detalle");
                        return;
                    }

                    if (resp.tieneNotaCredito) {
                        Swal.fire({
                            title: "¿Qué comprobante desea imprimir?",
                            input: "select",
                            inputOptions: { detalle: "Detalle", factura: "Factura", nc: "Nota de Crédito" },
                            inputValue: "factura",
                            showCancelButton: true,
                            confirmButtonText: "Imprimir"
                        }).then(function (result) {
                            if (result.isConfirmed) abrirPdf(result.value);
                        });
                        return;
                    }

                    if (resp.facturaAgrupaItems) {
                        Swal.fire({
                            title: "¿Qué comprobante desea imprimir?",
                            input: "select",
                            inputOptions: { detalle: "Detalle", factura: "Factura" },
                            inputValue: "factura",
                            showCancelButton: true,
                            confirmButtonText: "Imprimir"
                        }).then(function (result) {
                            if (result.isConfirmed) abrirPdf(result.value);
                        });
                        return;
                    }

                    abrirPdf("factura");
                }).fail(function (xhr) {
                    Swal.fire({ icon: "error", title: "No se pudo preparar el PDF", text: (xhr.responseJSON && xhr.responseJSON.msg) || "Error de conexión." });
                });
            });

            // ===== Atajos numericos 1-5 en el modal de post-venta, 2026-09-06 (pedido explicito
            // del usuario -- ver docs/DECISIONS.md): orden = Nueva venta(1)/Ticket(2)/PDF(3)/
            // Email(4)/Factura(5), igual al orden visual de los botones. =====
            $(document).on("keydown", function (e) {
                if (!$("#modalPostVentaBasico").hasClass("show")) return;
                var tag = (e.target.tagName || "").toUpperCase();
                if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;

                var mapaAtajos = {
                    "1": "#btnPvbContinuar",
                    "2": "#btnPvbTicket",
                    "3": "#btnPvbImprimir",
                    "4": "#btnPvbEmail",
                    "5": "#btnPvbFactura"
                };
