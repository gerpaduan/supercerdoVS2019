            posExpendios.init();
            posComment.init();
            posHelp.init();
            posKeyboard.init();

            // Atajos globales Home/End/F9/F10 (2026-09-06, retomado -- ver docs/DECISIONS.md).
            // Port literal de Web/Views/Ventas/POS.cshtml:2202-2234. F9 (#btnBuscarPersona) y F10
            // (#btnAgregarManual) quedan como no-ops seguros hoy: ambos botones estan `disabled`
            // en el markup (buscador de cliente/producto avanzado todavia no portados) y el guard
            // `!btn.disabled` ya lo contempla -- se portan igual para no repetir este trabajo
            // cuando esos modulos lleguen, y para que el navegador no intercepte las teclas.
            document.addEventListener("keydown", function (e) {
                if ($(".modal.show").length) return;

                if (e.key === "End") {
                    e.preventDefault();
                    const btn = document.getElementById("btnFinalizar");
                    if (btn && !btn.disabled) btn.click();
                }

                if (e.key === "Home") {
                    e.preventDefault();
                    const inp = document.getElementById("inputCodigo");
                    if (inp) {
                        inp.focus();
                        try { inp.select(); } catch { }
                    }
                }

                if (e.key === "F9" || e.key === "F10") e.preventDefault();
                else return;

                if (e.key === "F9") {
                    const btn = document.getElementById("btnBuscarPersona");
                    if (btn && !btn.disabled) btn.click();
                    return;
                }

                if (e.key === "F10") {
                    const btn = document.getElementById("btnAgregarManual");
                    if (btn && !btn.disabled) abrirBuscadorProductosPOS();
                    return;
                }
            });

            // ===== Batch 7, iteracion 3: scanner de camara =====
            // Port literal de Web/Views/Ventas/POS.cshtml (~1614-1644): scanner.js/zxing.min.js
            // ya estaban portados byte-a-byte en WebCore (probados en Stock/Editar.cshtml), solo
            // faltaba el wiring en POS. manejarEnter -> window.manejarEnter, ya expuesto por
            // pos-product.js. #btnLimpiarScanner del partial compartido _ScannerCodigoBarra.cshtml
            // NO se usa aca a proposito: el bloque HTML de POS es el propio del original (con
            // Flash/Cerrar camara nomas), no el partial compartido con otros modulos.
            // Alta rapida de producto (codigo no encontrado, ver docs/DECISIONS.md 2026-09-12):
            // se le informa a pos-product.js si esta lectura de camara es la primera vez que se ve
            // este codigo o si ya es la segunda lectura IGUAL consecutiva -- evaluarSugerenciaAlta()
            // recien ofrece el alta rapida en la segunda lectura confirmada. Esto NO cambia en nada
            // el comportamiento de busqueda: manejarEnter() se sigue disparando en cada lectura,
            // igual que siempre (un producto que YA EXISTE se agrega con una sola lectura, como hoy).
            var ultimoCodigoLeidoPOS = null;

            var scannerPOS = new BarcodeScanner({
                videoSelector: "#videoScanner",
                containerSelector: "#scannerContainer",
                onCodeDetected: function (codigo) {
                    // Con el formulario de alta rapida abierto, la camara sigue corriendo en
                    // segundo plano (no se cierra sola) -- sin este corte, cualquier lectura
                    // pisaria #inputCodigo y dispararia una busqueda nueva mientras el cajero esta
                    // completando el formulario. No es el mismo chequeo que el de dos-lecturas de
                    // abajo: esto corta TODO el manejo de esta lectura, no solo la sugerencia.
                    if (posProduct && typeof posProduct.isModoAltaProductoActivo === "function" && posProduct.isModoAltaProductoActivo()) {
                        return;
                    }

                    var confirmadoPorDobleLectura = (ultimoCodigoLeidoPOS === codigo);
                    ultimoCodigoLeidoPOS = codigo;

                    if (posProduct && typeof posProduct.registrarOrigenLecturaCamara === "function") {
                        posProduct.registrarOrigenLecturaCamara(codigo, confirmadoPorDobleLectura);
                    }

                    document.querySelector("#inputCodigo").value = codigo;
                    document.querySelector("#inputCodigo").focus();
                    window.manejarEnter();
                }
            });
            document.getElementById("btnScanner")?.addEventListener("click", () => scannerPOS.iniciar());
