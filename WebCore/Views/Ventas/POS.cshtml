                window.mostrarModalPostVenta(ventaId);
            });

            $('#modalFacturaElectronica').on('hidden.bs.modal', function () {
                if (!facturaOkPOS) {
                    window.mostrarModalPostVenta($('#btnPvbImprimir').data('venta-id'));
                }
            });

            // Sin boton dedicado todavia (mismo estado que el clasico -- el research de este
            // batch no encontro un trigger de "facturar sin venta" wireado en Web/Views/Ventas/
            // POS.cshtml, solo la funcion expuesta via window.VentasFacturaModal.abrirSinVenta
            // para uso puntual). Se expone igual para no perder la funcionalidad ya portada.
            //
            // empresaPuedeFacturar/requiereFacturaAutomatica (bug real reportado 2026-09-09, ver
            // docs/DECISIONS.md): faltaban desde que se definio este objeto -- forma-pago.js:728-730
            // ya llama a requiereFacturaAutomatica(payload.formaPago) al finalizar una venta para
            // decidir si abre la Factura Electronica directo en vez del modal basico, pero como la
            // funcion no existia la condicion siempre daba false. Port literal de
            // Web/Scripts/app/modal-postventa.js:10-28 (pvEmpresaTieneCertificadoFacturaElectronica/
            // pvFacturaElectronicaRequeridaPorFormaPago), leyendo window.POSFacturaElectronicaConfig
            // (recien agregado arriba) y window.normalizarTipoFormaPago (forma-pago.js, ya portado).
            function empresaTieneCertificadoFacturaElectronicaPOS() {
                var cfg = window.POSFacturaElectronicaConfig || null;
                if (!cfg || typeof cfg.empresaTieneCertificado === 'undefined') return true;
                return cfg.empresaTieneCertificado === true;
            }

            function facturaElectronicaRequeridaPorFormaPagoPOS(formaPago) {
                var normalizada = typeof window.normalizarTipoFormaPago === 'function'
                    ? window.normalizarTipoFormaPago(formaPago)
                    : (formaPago || '');

                return empresaTieneCertificadoFacturaElectronicaPOS()
                    && !!normalizada
                    && normalizada !== 'Efectivo'
                    && normalizada !== 'CtaCte';
            }

            window.VentasFacturaModal = window.VentasFacturaModal || {
                abrir: abrirFacturaVentaModal,
                abrirSinVenta: abrirFacturaSinVentaModal,
                empresaPuedeFacturar: empresaTieneCertificadoFacturaElectronicaPOS,
                requiereFacturaAutomatica: facturaElectronicaRequeridaPorFormaPagoPOS
            };

            function pvbContinuarNuevaVenta() {
                $("#modalPostVentaBasico").modal("hide");
                // Si esta es la pestaña "duplicado" (Duplicar POS, batch 7 iteracion 4): marca
                // el flag para que, tras el reload, pos-multi-instance.js la cierre y devuelva
                // el foco al POS original -- mismo patron que modal-postventa.js (el modal real,
                // no portado) usa en cerrarPostVentaYRecargar.
                window.POSMultiInstance?.closeAfterPostVenta?.();
                // Bug real (2026-09-10, item 9 de la segunda ronda de pedidos, ver
                // docs/DECISIONS.md): faltaba este flag -- sin el, el listener de 'pagehide'
                // (mas abajo en este archivo) mandaba el sendBeacon de limpieza de operador en
                // CADA venta, forzando a pedir la autorizacion de nuevo a cada rato aunque la
                // vista de POS nunca se hubiera cerrado. Mismo patron ya usado en
                // recargarConOperadorAutorizado().
                window.PosNavegandoInternoPOS = true;
                window.location.reload();
            }

            $("#btnPvbContinuar").on("click", pvbContinuarNuevaVenta);
            // Sin boton de cerrar (X) a proposito -- misma logica que el modal real
            // (data-backdrop="static", sin data-dismiss en el header): el cajero elige una
            // accion explicita ("Nueva venta") antes de volver al POS, no se puede pasar por alto
            // sin querer con un click afuera o Escape.

            $("#btnPvbEmail").on("click", function () {
                var ventaId = $(this).data("venta-id");
                $("#pvbEmailError").addClass("d-none").text("");

                $.ajax({
                    url: window.api.venta.obtenerDatosEmailComprobante,
                    type: "GET",
                    dataType: "json",
                    data: { id: ventaId }
                }).done(function (resp) {
                    if (!resp || !resp.ok) {
                        Swal.fire({ icon: "error", title: "No se pudo preparar el email", text: (resp && resp.msg) || "Error desconocido." });
                        return;
                    }

                    pvbDocumentoEmail = resp.tieneFactura ? "factura" : "detalle";
                    $("#pvbEmailDestino").val(resp.email || "");
                    $("#pvbEmailAsunto").val(resp.asunto || "");
                    $("#pvbEmailMensaje").val(resp.mensaje || "");
                    $("#modalEmailPostVentaPOS").modal("show");
                }).fail(function (xhr) {
                    Swal.fire({ icon: "error", title: "No se pudo preparar el email", text: (xhr.responseJSON && xhr.responseJSON.msg) || "Error de conexión." });
                });
            });

            $("#btnPvbConfirmarEmail").on("click", function () {
                var ventaId = $("#btnPvbEmail").data("venta-id");
                var email = ($("#pvbEmailDestino").val() || "").trim();
                var asunto = ($("#pvbEmailAsunto").val() || "").trim();
                var mensaje = ($("#pvbEmailMensaje").val() || "").trim();

                if (!email) {
                    $("#pvbEmailError").removeClass("d-none").text("Ingrese un email destino.");
                    return;
                }

                var $btn = $(this);
                $btn.prop("disabled", true);

                $.ajax({
                    url: window.api.venta.enviarComprobanteEmail,
                    type: "POST",
                    dataType: "json",
                    data: {
                        idVenta: ventaId,
                        emailDestino: email,
                        asunto: asunto,
                        mensaje: mensaje,
                        documento: pvbDocumentoEmail
                    }
                }).done(function (resp) {
                    $btn.prop("disabled", false);

                    if (!resp || !resp.ok) {
                        $("#pvbEmailError").removeClass("d-none").text((resp && resp.msg) || "No se pudo enviar el email.");
                        return;
                    }

                    $("#modalEmailPostVentaPOS").modal("hide");
                    Swal.fire({ icon: "success", title: "Email enviado", text: "El comprobante se envió correctamente." });
                }).fail(function (xhr) {
                    $btn.prop("disabled", false);
                    $("#pvbEmailError").removeClass("d-none").text((xhr.responseJSON && xhr.responseJSON.msg) || "No se pudo enviar el email.");
                });
            });

            (function () {
                var dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
                var meses = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
                var diasLimitFechaVentaPOS = @diasLimitFechaVentaPOS;
                var cajaAperturaFechaPOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cajaAperturaFechaPOS));

                function pad2(n) { return String(n).padStart(2, "0"); }

                function formatDatetimeLocal(fecha) {
                    return fecha.getFullYear() + "-" + pad2(fecha.getMonth() + 1) + "-" + pad2(fecha.getDate())
                        + "T" + pad2(fecha.getHours()) + ":" + pad2(fecha.getMinutes());
                }

                function actualizarFechaHora() {
                    var ahora = new Date();
                    var texto = dias[ahora.getDay()] + " " + ahora.getDate() + " de " + meses[ahora.getMonth()]
                        + ", " + ahora.getFullYear() + ". " + pad2(ahora.getHours()) + ":" + pad2(ahora.getMinutes());

                    var span = document.getElementById("fechaHoraPOS");
                    if (span) span.innerText = texto;
                }

                actualizarFechaHora();
                setInterval(actualizarFechaHora, 60000);

                // Item 5 (2026-09-11, ver docs/DECISIONS.md "fecha del POS: click-to-reveal +
                // ventana de dias"): click (o Enter/Espacio con teclado) en el chip revela el
                // input editable -- reemplaza el gate binario anterior por permiso, ahora
                // universal para cualquier usuario.
                var $chipWrap = $("#fechaHoraPOSWrap");
                var $editableWrap = $("#fechaVentaEditableWrap");
                var $editable = $("#fechaVentaEditable");

                function revelarFechaEditable() {
                    $chipWrap.addClass("d-none");
                    $editableWrap.removeClass("d-none");
                    $editable.trigger("focus");
                }

                $("#fechaHoraPOSChip").on("click", revelarFechaEditable).on("keydown", function (e) {
                    if (e.key !== "Enter" && e.key !== " ") return;
                    e.preventDefault();
                    revelarFechaEditable();
                });

                // #fechaVentaEditable sincroniza el hidden #fechaVenta -- el mismo campo que ya
                // lee forma-pago.js al finalizar/modificar la venta, sin tocar ese archivo. Item 5
                // (2026-09-11): valida contra la ventana de dias permitida -- fuera de rango,
                // revierte a la fecha/hora actual real. El servidor vuelve a validar lo mismo
                // (VentasController.FechaVentaDentroDeVentanaPermitida) -- esto es solo UX, no el
                // unico control, no se puede bypassear editando el DOM a mano.
                if ($editable.length) {
                    $editable.on("change input", function () {
                        var value = $(this).val();
                        if (!value) return;

                        var seleccionada = new Date(value);
                        var ahora = new Date();

                        // Item 5b (2026-09-12, ver docs/DECISIONS.md): con caja real abierta, la
                        // fecha no puede ser anterior a cuando se abrio -- primera validacion,
                        // mas precisa que la ventana de dias. La ventana de dias sigue aplicando
                        // ADEMAS (no se reemplaza): se toma el piso mas restrictivo de los 2. Sin
                        // caja real (bypass de Admin, cajaAperturaFechaPOS vacio), solo rige la
                        // ventana de dias, igual que antes.
                        var minima = new Date();
                        minima.setHours(0, 0, 0, 0);
                        minima.setDate(minima.getDate() - diasLimitFechaVentaPOS);

                        if (cajaAperturaFechaPOS) {
                            var minimaPorCaja = new Date(cajaAperturaFechaPOS);
                            if (minimaPorCaja > minima) minima = minimaPorCaja;
                        }

                        if (isNaN(seleccionada.getTime()) || seleccionada < minima || seleccionada > ahora) {
                            var valorAhora = formatDatetimeLocal(ahora);
                            $(this).val(valorAhora);
                            $("#fechaVenta").val(valorAhora);
                            return;
                        }

                        $("#fechaVenta").val(value);
                    });
                }
            })();
        })();
    </script>
}
