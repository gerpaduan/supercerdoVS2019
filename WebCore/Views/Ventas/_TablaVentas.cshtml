@model List<Entidades.Venta>

@{
    bool modoModal = ViewBag.ModoModalVentas != null && (bool)ViewBag.ModoModalVentas;
    // Mis ventas (modal) llega desde el POS (desdePos + pestaña) o desde Cajas Abiertas: el panel de la tarjeta
    // necesita lo mismo que el detalle modal para calcular "Modificar venta" / "Cambiar forma de pago".
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    string posInstanceIdMisVentas = ViewBag.PosInstanceIdMisVentas as string ?? "";
}

<ul id="listaVentas" class="list-group list-group-flush">
    @if (Model == null || Model.Count == 0)
    {
        <li class="list-group-item text-center text-muted py-4">
            <i class="fas fa-search fa-2x mb-2"></i><br />
            No hay coincidencias
        </li>
    }
    else
    {
        foreach (var ventaAgrupada in Model.GroupBy(v => v.FechaVenta.Date))
        {
            if (ventaAgrupada.Any())
            {
                <li class="list-group-item bg-light font-weight-bold fecha-grupo">
                    @ventaAgrupada.Key.ToString("dd/MM/yyyy")
                </li>

                foreach (var venta in ventaAgrupada)
                {
                    // Al tocar la tarjeta se despliega el detalle en el lugar (_VentasExpandible.cshtml); el detalle
                    // completo se abre desde "Abrir detalle" dentro del panel.
                    var resumenUrl = Url.Action("DetalleVentaResumen", "Ventas", new
                    {
                        id = venta.IdVenta,
                        modal = modoModal,
                        desdePos = desdePos,
                        posInstanceId = desdePos ? posInstanceIdMisVentas : ""
                    });
                    // Mismo formato que BuildFacturaDTO/_TicketHTML.cshtml del original ("Debito |
                    // Efectivo") para que el listado no oculte que la venta se cobro combinando
                    // efectivo con otro medio -- gap encontrado por el usuario probando el batch 3.
                    string formaPagoTexto = venta.PagoMixtoEfectivo > 0
                        ? venta.FormaPago + " | Efectivo"
                        : venta.FormaPago;

                    <li class="list-group-item venta-item @(modoModal ? "venta-item-modal" : "")"
                        data-forma-pago="@venta.FormaPago.ToString()"
                        data-tipo-comprobante="@venta.TipoComprobante.ToString()"
                        data-cliente="@venta.Persona.razonSocial"
                        data-identificacion="@venta.Persona.Identificacion"
                        data-vendedor="@venta.Vendedor.Nombre.ToLower()"
                        data-id-cliente="@venta.IdPersona"
                        data-id-vendedor="@venta.IdVendedor"
                        data-venta-id="@venta.IdVenta"
                        data-resumen-url="@resumenUrl"
                        data-modal="@(modoModal ? "true" : "false")"
                        role="button"
                        tabindex="0"
                        aria-expanded="false">
                        <div class="venta-icono">
                            @if (!string.IsNullOrEmpty(venta.FormaPago))
                            {
                                switch (venta.FormaPago.ToLower())
                                {
                                    case "efectivo":
                                        <i class="fas fa-money-bill-wave fa-2x text-success"></i>
                                        break;
                                    case "qr":
                                        <i class="fas fa-qrcode fa-2x text-primary"></i>
                                        break;
                                    case "debito":
                                    case "credito":
                                        <i class="fas fa-credit-card fa-2x text-info"></i>
                                        break;
                                    case "ctacte":
                                        <i class="fas fa-university fa-2x text-warning"></i>
                                        break;
                                    case "transferencia":
                                        <i class="fas fa-exchange-alt fa-2x text-secondary"></i>
                                        break;
                                    default:
                                        <i class="fas fa-money-check fa-2x text-muted"></i>
                                        break;
                                }
                            }
                        </div>

                        <div class="venta-info">
                            @if (modoModal)
                            {
                                // Mis ventas (modal) compacto: comprobante + cliente en un renglon y caja + id en otro
                                // (docs/DECISIONS.md, 2026-11-10). Ventas/Index conserva el formato de abajo.
                                bool mostrarCliente = !Entidades.Persona.esConsumidorFinal(venta.Persona);
                                bool mostrarIdentificacion = mostrarCliente && venta.Persona != null && venta.Persona.TieneIdentificacionDistinta();
                                <div class="venta-linea-principal">
                                    <span class="venta-comprobante">@venta.TipoComprobante - @formaPagoTexto</span>
                                    @if (mostrarCliente)
                                    {
                                        <span>· a @venta.Persona.razonSocial</span>
                                    }
                                </div>
                                <div class="venta-id">
                                    @if (mostrarIdentificacion)
                                    {
                                        @venta.Persona.Identificacion<text> · </text>
                                    }
                                    Caja: @venta.Vendedor.Nombre · idVenta @venta.IdVenta
                                </div>
                            }
                            else
                            {
                                <div class="venta-tipo-persona font-weight-bold">
                                    @venta.TipoComprobante - @formaPagoTexto
                                </div>
                                @if (!@Entidades.Persona.esConsumidorFinal(@venta.Persona))
                                {
                                    <div class="venta-tipo-persona font-weight-bold">
                                        a @venta.Persona.razonSocial
                                    </div>
                                    @if (venta.Persona != null && venta.Persona.TieneIdentificacionDistinta())
                                    {
                                        <div class="venta-id">@venta.Persona.Identificacion</div>
                                    }
                                }
                                <div class="venta-id">Caja: @venta.Vendedor.Nombre</div>
                                <div class="venta-id">idVenta @venta.IdVenta</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(venta.Observaciones))
                            {
                                <div class="venta-obs" title="@venta.Observaciones">
                                    <i class="fas fa-sticky-note mr-1"></i>@(
                                        venta.Observaciones.Length > 45
                                            ? venta.Observaciones.Substring(0, 45) + "..."
                                            : venta.Observaciones
                                    )
                                </div>
                            }
                        </div>

                        <div class="venta-total">
                            @* data-valor con punto decimal (cultura invariante): lo suman con parseFloat los filtros de
                               Mis ventas y de Ventas/Index; con la cultura es-AR salia "508,76" y parseFloat cortaba en
                               la coma, perdiendo los centavos del total filtrado (2026-11-10). *@
                            <div class="importe @(venta.TotalImporte <= 0 ? "text-danger font-weight-bold" : "")"
                                 data-valor="@venta.TotalImporte.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @((venta.TotalImporte > 0 ? "+ " : "") + venta.TotalImporte.ToString("C"))
                            </div>

                            @* El chevron va junto a la hora (no como un elemento aparte de la fila): asi no le quita
                               ancho a la fila y en celular el importe no baja de renglon. *@
                            <div class="text-muted small">
                                @venta.FechaVenta.ToString("HH:mm") hs
                                <i class="fas fa-chevron-down venta-chevron" aria-hidden="true"></i>
                            </div>
                        </div>

                        <div class="venta-detalle-panel" hidden></div>
                    </li>
                }
            }
        }
    }
</ul>
