@*
    Port de Web/Views/Ventas/_ModalExpendiosPOS.cshtml (batch 5, ver
    docs/10-migracion-aspnet-core/PLAN-POS-UI.md) + refinamiento pedido explicito por el usuario
    (2026-09-04, ver docs/DECISIONS.md): filtros avanzados (fecha hasta + sucursal, colapsables
    igual que Stock/ExistenciaPorSucursales.cshtml), boton "Limpiar filtros", checkbox "Cargar
    todos" con confirmacion, columna Sucursal (solo cuando el filtro no es "mi sucursal"), y
    densidad compacta (mismo criterio que el resto de la migracion, docs/DECISIONS.md
    "convencion de UI"). Requiere ViewBag.Sucursales (VentasController.POS) y
    window.idSucursalUsuarioPOS (inyectado en POS.cshtml).
*@
<div class="modal fade" id="modalExpendiosPOS" data-backdrop="static" data-keyboard="true" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content shadow modal-expendios-compact">
            <div class="modal-header">
                <h5 class="modal-title mb-0">
                    <i class="fas fa-inbox mr-2"></i>Expendios
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row align-items-end">
                    <div class="col-12 col-md-3 mb-2">
                        <label class="small mb-1" for="expFiltroFechaDesde">Fecha desde</label>
                        <input type="datetime-local" class="form-control" id="expFiltroFechaDesde" />
                    </div>

                    <div class="col-12 col-md-3 mb-2">
                        <label class="small mb-1" for="expFiltroEstado">Estado</label>
                        <select class="form-control" id="expFiltroEstado">
                            <option value="Pendientes" selected>Pendientes</option>
                            <option value="Asignados">Asignados</option>
                            <option value="Todos">Todos</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="small mb-1" for="expFiltroTexto">Búsqueda</label>
                        <input type="text" class="form-control" id="expFiltroTexto" placeholder="Número de expendio / identificación cliente" />
                    </div>

                    <div class="col-12 col-md-2 mb-2 d-flex align-items-end">
                        <button type="button" class="btn btn-primary btn-block" id="btnBuscarExpendiosPOS">
                            <i class="fas fa-search mr-1"></i>Buscar
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between mb-2 exp-filtros-toolbar">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="expSwitchFiltrosAvanzados">
                        <label class="custom-control-label small" for="expSwitchFiltrosAvanzados">Filtros avanzados</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLimpiarFiltrosExpendiosPOS">
                        <i class="fas fa-eraser mr-1"></i>Limpiar filtros
                    </button>
                </div>

                <div class="row d-none exp-filtros-avanzados" id="panelFiltrosAvanzadosExpendiosPOS">
                    <div class="col-12 col-md-4 mb-2">
                        <label class="small mb-1" for="expFiltroFechaHasta">Fecha hasta</label>
                        <input type="datetime-local" class="form-control" id="expFiltroFechaHasta" />
                    </div>

                    <div class="col-12 col-md-4 mb-2">
                        <label class="small mb-1" for="expFiltroSucursal">Sucursal</label>
                        <select class="form-control" id="expFiltroSucursal">
                            <option value="-1">Todas las sucursales</option>
                            @foreach (var s in (ViewBag.Sucursales as List<Entidades.Sucursal>) ?? new List<Entidades.Sucursal>())
                            {
                                <option value="@s.idSucursal">@s.sucursal</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between mb-2 exp-cargar-todos-row">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="chkCargarTodosExpendiosPOS">
                        <label class="custom-control-label small" for="chkCargarTodosExpendiosPOS">Cargar todos los expendios mostrados</label>
                    </div>
                </div>

                <div class="small text-muted mb-2">
                    Atajos: <strong>AvPag</strong> abre este modal, <strong>Enter</strong> en fecha busca, <strong>Enter</strong> en búsqueda carga el primer expendio visible y <strong>Esc</strong> cierra.
                </div>

                <div class="alert alert-info d-none" id="msgExpendiosPOS"></div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0" id="tablaExpendiosPOS">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:95px;">Fecha</th>
                                <th style="width:70px;">Hora</th>
                                <th style="width:95px;">Nro.Exp.</th>
                                <th>Identificación cliente</th>
                                <th style="width:120px;">Sector</th>
                                <th class="exp-col-sucursal d-none" style="width:130px;">Sucursal</th>
                                <th>Producto</th>
                                <th style="width:95px;" class="text-right">Cantidad</th>
                                <th style="width:160px;">Vendedor</th>
                                <th style="width:40px;" class="text-center" title="Observación">Obs.</th>
                                <th style="width:110px;" class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">No hay expendios para mostrar.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnQuitarExpendiosPOS">
                    <i class="fas fa-trash-alt mr-1"></i>Quitar expendios cargados
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Densidad compacta (un paso mas chica que el default de Bootstrap que tenia este modal --
       mismo criterio que el resto de la migracion, ver docs/DECISIONS.md "convencion de UI"). */
    .modal-expendios-compact {
        font-size: .84rem;
    }

    .modal-expendios-compact .modal-title {
        font-size: 1rem;
    }

    .modal-expendios-compact label.small,
    .modal-expendios-compact .custom-control-label.small {
        font-size: .74rem;
        font-weight: 600;
        color: #495057;
    }

    .modal-expendios-compact .form-control,
    .modal-expendios-compact .btn {
        min-height: 2.1rem;
        font-size: .82rem;
        padding: .26rem .52rem;
        border-radius: .5rem;
    }

    .modal-expendios-compact .btn-sm {
        min-height: 1.85rem;
        font-size: .76rem;
        padding: .2rem .5rem;
    }

    .modal-expendios-compact .small,
    .modal-expendios-compact .text-muted {
        font-size: .74rem !important;
    }

    .modal-expendios-compact #tablaExpendiosPOS {
        font-size: .8rem;
    }

    .modal-expendios-compact #tablaExpendiosPOS th,
    .modal-expendios-compact #tablaExpendiosPOS td {
        padding: .34rem .48rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .modal-expendios-compact #tablaExpendiosPOS thead th {
        font-size: .66rem !important;
        text-transform: uppercase;
        letter-spacing: .02em;
        padding-top: .38rem;
        padding-bottom: .38rem;
    }

    .modal-expendios-compact .badge {
        font-size: .68rem;
    }

    .exp-filtros-toolbar {
        margin-top: -.25rem;
    }
</style>
