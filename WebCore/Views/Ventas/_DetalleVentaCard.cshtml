@model Entidades.Venta
@*
    Card de detalle de una venta -- extraida como partial compartida entre DetalleVenta.cshtml
    (pantalla completa) y DetalleFactura.cshtml (embebida bajo el detalle de la factura), porque
    ASP.NET Core no tiene equivalente directo a Html.Action del Web original (que invocaba
    DetalleVenta como "child action" con modal=true). En vez de duplicar el markup, ambas vistas
    llaman a esta partial con el mismo Model (Entidades.Venta) y ViewBag (ModoModal, DesdePOS,
    IdCierreActividad, ReturnUrlDetalle, TieneFacturaVenta, TieneNotaCreditoVenta,
    IdNotaCreditoVenta).

    "Modificar venta" (batch 7 iteracion 5) y "Cambiar Forma de Pago" (iteracion 6) agregados
    (ver docs/10-migracion-aspnet-core/PLAN-POS-UI.md) -- SIN el chequeo de permisos real del
    original (PuedeModificarUltimaVenta/PuedeCambiarFormaPago, Web/Controllers/VentasController.
    cs:2521-2643): ambos ViewBag se fijan en `true` siempre porque WebCore corre con usuario
    unico Admin=true, sin sesion. TODO(claude): portar esas reglas reales (y "usuario
    produccion") cuando se diseñe login/sesion real -- ver docs/10-migracion-aspnet-core/gaps.md.

    "Factura / Imprimir" (2026-09-10, item 1 de la segunda ronda de pedidos -- ver
    docs/DECISIONS.md "Batch 9: Factura/Imprimir en DetalleVenta/DetalleFactura") abre
    #modalComprobanteVenta (_ModalComprobanteVenta.cshtml, incluida una sola vez al final de este
    archivo -- como esta partial ya es compartida sin duplicarse por DetalleVenta.cshtml/
    DetalleFactura.cshtml, el modal queda disponible en ambas vistas automaticamente).
*@
@{
    bool modoModal = ViewBag.ModoModal != null && (bool)ViewBag.ModoModal;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    string returnUrlDetalle = ViewBag.ReturnUrlDetalle as string ?? "";
    var index = 1;
    bool mostrarBotonVolver = modoModal || !string.IsNullOrWhiteSpace(returnUrlDetalle);
    string hrefBotonVolver = (!modoModal && !string.IsNullOrWhiteSpace(returnUrlDetalle)) ? returnUrlDetalle : "#";
    bool tieneFacturaVenta = ViewBag.TieneFacturaVenta != null && (bool)ViewBag.TieneFacturaVenta;
    bool tieneNotaCreditoVenta = ViewBag.TieneNotaCreditoVenta != null && (bool)ViewBag.TieneNotaCreditoVenta;
    int idNotaCreditoVenta = ViewBag.IdNotaCreditoVenta != null ? (int)ViewBag.IdNotaCreditoVenta : 0;
    string razonSocialCliente = Model.Persona != null ? Model.Persona.razonSocial ?? "" : "";
    string identificacionCliente = Model.Persona != null ? Model.Persona.Identificacion ?? "" : "";
    bool mostrarIdentificacionCliente = !string.IsNullOrWhiteSpace(identificacionCliente)
        && !string.Equals(identificacionCliente.Trim(), razonSocialCliente.Trim(), StringComparison.OrdinalIgnoreCase);
    // Mismo formato que BuildFacturaDTO/_TicketHTML.cshtml del original ("Debito | Efectivo") --
    // gap encontrado por el usuario probando el batch 3: el detalle no mostraba que la venta se
    // cobro combinando efectivo con otro medio.
    string formaPagoTexto = Model.PagoMixtoEfectivo > 0
        ? Model.FormaPago + " | Efectivo"
        : Model.FormaPago;
}

<style>
    .detalle-documento-header .detalle-documento-titulo {
        font-size: 14px;
    }

    .detalle-documento-header .badge {
        font-size: 0.625rem;
    }

    /* Ver docs/DECISIONS.md, Batch 2 de la quinta ronda: font-weight-bold no existe en el
       bootstrap.min.css real de este proyecto -- se fija el h5 en peso normal explicito y se usa
       <strong> (bold real del navegador) solo en el valor, ver el HTML mas abajo. */
    .detalle-venta-resumen h5 {
        font-size: 14px;
        font-weight: 400;
    }

    .detalle-venta-identificacion {
        font-size: 14px;
    }
</style>

<div class="card shadow mb-4 w-100 w-md-50 @(modoModal ? "" : "mx-auto") vista-venta @(modoModal ? "vista-venta-modal" : "")">
    <div class="card-header py-3 d-flex justify-content-between align-items-center detalle-documento-header">
        <div class="d-flex align-items-center">
            @if (mostrarBotonVolver)
            {
                <a href="@hrefBotonVolver" class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverListadoVentasDetalle">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h6 class="m-0 font-weight-bold text-primary detalle-documento-titulo">Detalle de Venta</h6>
        </div>
        <span class="badge badge-info">#@Model.IdVenta</span>
    </div>

    <div class="card-body bg-white">
        <div class="row mb-3 detalle-documento-resumen detalle-venta-resumen">
            @* Negrita en las variables (quinta ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md
               "Batch 2: negrita en Cliente/Tipo Comprobante/Fecha/Forma de pago"). Antes, el
               font-weight-bold estaba en el <h5> entero (etiqueta + valor) y el valor ademas tenia
               text-muted (gris) -- las 2 reglas competian, restandole el efecto de negrita al
               valor. Ahora la etiqueta queda en peso normal (font-weight:400, CSS de arriba) y el
               valor usa <strong> -- NO la clase "font-weight-bold" (confirmado que no existe en el
               bootstrap.min.css real de este proyecto, ver el comentario de la regla CSS de
               arriba), asi que se usa negrita real de <strong> (default del navegador). *@
            <div class="col-md-6">
                <h5 class="text-dark">
                    Cliente: <strong>@razonSocialCliente</strong>
                </h5>
                @if (mostrarIdentificacionCliente)
                {
                    <div class="text-muted detalle-venta-identificacion">Ident: @identificacionCliente</div>
                }
            </div>
            <div class="col-md-6 text-md-right">
                <h5 class="text-dark">
                    <strong>@Model.FechaVenta</strong>
                </h5>
            </div>
            <div class="col-md-6">
                <h5 class="text-dark">
                    Tipo Comprobante: <strong>@Model.TipoComprobante</strong>
                </h5>
            </div>
            <div class="col-md-6 text-md-right">
                <h5 class="text-dark">
                    Forma de pago: <strong>@formaPagoTexto</strong>
                </h5>
            </div>
        </div>

        @if (tieneFacturaVenta || tieneNotaCreditoVenta)
        {
            <div class="alert alert-light border mb-3">
                @if (tieneFacturaVenta)
                {
                    <div><strong>Factura asociada:</strong> sí</div>
                }
                @if (tieneNotaCreditoVenta && idNotaCreditoVenta > 0)
                {
                    <div>
                        <strong>Nota de crédito asociada:</strong>
                        <a href="@Url.Action("DetalleFactura", "Ventas", new { id = idNotaCreditoVenta, returnUrl = returnUrlDetalle })">ver detalle</a>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="alert alert-light border mb-4">
                <div class="font-weight-bold text-secondary mb-1">
                    <i class="fas fa-sticky-note mr-2"></i>Comentario
                </div>
                <div class="text-dark comentario-venta">@Model.Observaciones</div>
            </div>
        }

        <div class="venta-lineas bg-white">
            @foreach (var linea in Model.LineasVenta)
            {
                <div class="mb-3">
                    <div>
                        #@index <strong>@linea.Corte.CorteDesc</strong> (cod: @linea.Corte.codigo)&nbsp;&nbsp;
                    </div>

                    @{
                        // Bonificacion/recargo por linea (quinta ronda de pedidos, 2026-09-10, ver
                        // docs/DECISIONS.md "Batch 1: bonificacion en las lineas de DetalleVenta").
                        // Mismo texto/formato que ya usa el carrito del POS (pos-cart.js,
                        // funcion renderTable) -- texto plano, sin badge propio.
                        string bonifTexto = linea.Bonificacion == 0
                            ? ""
                            : (linea.Bonificacion > 0
                                ? $" | Bonif:{linea.Bonificacion:0.##}%"
                                : $" | Recargo:{Math.Abs(linea.Bonificacion):0.##}%");
                    }
                    <div class="d-flex justify-content-between">
                        <div>
                            &nbsp;&nbsp;&nbsp;&nbsp; @linea.CantKg.ToString("0.###") x @linea.PrecioKg.ToString("C")@bonifTexto
                        </div>

                        <div class="text-right font-weight-bold">
                            @((linea.CantKg * linea.PrecioKg).ToString("C"))
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>

        @* Alineacion del total (quinta ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md
           "Batch 3: alinear el total a la derecha con los decimales en linea"). Antes el total
           vivia en un .row.mt-3 > .col aparte, FUERA de .card-body -- .card-body tiene su propio
           padding-right (Bootstrap default), pero el .row de afuera no, asi que el borde derecho
           del total quedaba mas a la derecha que el de las lineas (que si estan dentro de
           .card-body). Moviendolo DENTRO de .card-body, con el mismo ancho/padding que las
           lineas, el borde derecho coincide. Se saco tambien un triple espacio en blanco literal
           que quedaba despues del monto (empujaba el ultimo caracter visible mas a la izquierda). *@
        <div class="text-right mt-3">
            <h4 class="font-weight-bold mb-0">
                Total Venta: <span class="text-success">@Model.TotalImporte.ToString("C")</span>
            </h4>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col">
            @* Bug real reportado 2026-09-12 (ver docs/DECISIONS.md): SIN data-bs-toggle a proposito.
               El data-api nativo de Bootstrap (bootstrap.bundle.js, handler de
               "[data-bs-toggle=modal]") oculta automaticamente CUALQUIER .modal.show antes de
               abrir el target ("avoid conflict when clicking modal toggler while another one is
               open") -- con esta vista embebida en POS, eso ocultaba #modalFinanzasPOS (el fondo)
               ademas de nunca volver a mostrarlo al cerrar el comprobante: pantalla oscura, nada
               visible, exactamente el bug reportado. Se abre por JS (mismo criterio ya usado para
               #modalBuscarPersona/#modalBuscarProducto en compras.js) para no pasar por ese
               data-api. *@
            <button type="button" class="btn btn-light btn-block text-left mb-2" id="btnFacturaImprimirDetalle">
                <i class="fas fa-print mr-2"></i> Factura / Imprimir
            </button>
        </div>
    </div>
    @if (ViewBag.PuedeModificarVenta != null && (bool)ViewBag.PuedeModificarVenta)
    {
        <div class="row mt-2">
            <div class="col">
                @* Bug real reportado 2026-09-11 (ver docs/DECISIONS.md): al modificar una venta
                   desde POS (siempre desdePos=true aca, ver POS.cshtml:1809-1811), al guardar
                   volvia al layout de DetalleVenta en vez de a POS -- forma-pago.js:713 ya lee
                   window.POSModo.returnUrl, pero nadie se lo mandaba. Se pasa returnUrl=POS solo
                   cuando venimos de POS; fuera de POS (pantalla completa de Actividades/Cajas
                   Abiertas) se sigue cayendo al fallback de forma-pago.js (DetalleVenta). *@
                <a id="btnModificarVentaDetalle"
                   href="@Url.Action("POS", "Ventas", new { idVentaEditar = Model.IdVenta, returnUrl = desdePos ? Url.Action("POS", "Ventas") : null })"
                   class="btn btn-light btn-block text-left mb-2">
                    <i class="fas fa-edit mr-2"></i> Modificar venta
                </a>
            </div>
        </div>
    }
    @if (ViewBag.PuedeCambiarFormaPago != null && (bool)ViewBag.PuedeCambiarFormaPago)
    {
        <div class="row mt-2">
            <div class="col">
                <a id="btnCambiarFormaPagoDetalle"
                   href="@Url.Action("POS", "Ventas", new { idVentaEditar = Model.IdVenta, soloFormaPago = true, returnUrl = desdePos ? Url.Action("POS", "Ventas") : null })"
                   class="btn btn-light btn-block text-left mb-2">
                    <i class="fas fa-sync-alt mr-2"></i> Cambiar Forma de Pago
                </a>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_ModalComprobanteVenta", Model)

<style>
    .venta-lineas {
        background-color: var(--ui-surface, #fff);
        color: var(--ui-text, inherit);
    }

        .venta-lineas .mb-3 {
            padding: .5rem 0;
            border: none;
        }

        .venta-lineas .font-weight-bold {
            margin-bottom: .25rem;
        }

    @@media (min-width: 992px) {
        .vista-venta {
            width: 60% !important;
            max-width: none;
            margin: 0 !important;
            padding-left: 0;
            padding-right: 0;
        }
    }

    .vista-venta-modal {
        width: 100% !important;
        max-width: 700px;
        margin: 0 auto 1rem auto !important;
    }

    .vista-venta-modal .card-body,
    .vista-venta-modal .card-header {
        text-align: left;
    }

    .vista-venta-modal .row {
        margin-left: 0;
        margin-right: 0;
    }

    .vista-venta-modal .col {
        padding-left: 0;
        padding-right: 0;
    }

    @@media (min-width: 992px) {
        .vista-venta-modal {
            width: 100% !important;
            margin: 0 auto 1rem auto !important;
            padding-left: 0;
            padding-right: 0;
        }
    }

    .comentario-venta {
        white-space: pre-wrap;
    }
</style>

<script>
    (function () {
        function volverDetalleVenta() {
            var returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrlDetalle));

            if (returnUrl) {
                if (@(modoModal && desdePos ? "true" : "false") && window.POSFinanzas && typeof window.POSFinanzas.cargar === "function") {
                    window.POSFinanzas.cargar(returnUrl, "Cuenta corriente");
                    return;
                }

                window.location.href = returnUrl;
                return;
            }

            if (@(desdePos ? "true" : "false") && window.POSVentas && typeof window.POSVentas.abrirMis === "function") {
                window.POSVentas.abrirMis();
                return;
            }

            if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirVentas === "function") {
                window.CajasAbiertas.abrirVentas(@idCierreActividad);
                return;
            }

            window.history.back();
        }

        function enlazarBotonVolverDetalle() {
            var btn = document.getElementById("btnVolverListadoVentasDetalle");
            if (!btn || btn.dataset.volverDetalleBound === "true") return;

            btn.dataset.volverDetalleBound = "true";
            btn.addEventListener("click", function (event) {
                event.preventDefault();
                volverDetalleVenta();
            });
        }

        // Bug real reportado 2026-09-12 (ver docs/DECISIONS.md): "Modificar venta"/"Cambiar Forma
        // de Pago" son links <a href> planos -- si esta vista esta embebida en POS (dentro de
        // #modalFinanzasPOS), navegar dispara el beforeunload de pos-cart.js:460-474 (hay un
        // .modal.show abierto) aunque sea una navegacion interna intencional. Mismo mecanismo ya
        // usado para casos identicos (POS.cshtml:2326-2328, forma-pago.js:680): desactivar el
        // aviso ANTES de dejar navegar (sin preventDefault, el link sigue funcionando igual).
        function desactivarAvisoAntesDeNavegar(idBoton) {
            var btn = document.getElementById(idBoton);
            if (!btn) return;
            btn.addEventListener("click", function () {
                if (typeof window.desactivarAvisoSalidaPOS === "function") {
                    window.desactivarAvisoSalidaPOS();
                }
            });
        }

        desactivarAvisoAntesDeNavegar("btnModificarVentaDetalle");
        desactivarAvisoAntesDeNavegar("btnCambiarFormaPagoDetalle");

        // Causa raiz real del "pantalla oscurecida, no muestra nada" (2026-09-12, ver
        // docs/DECISIONS.md): NO era el z-index -- el boton usaba data-bs-toggle="modal" plano, y
        // el propio data-api de Bootstrap (bootstrap.bundle.js, handler de
        // "[data-bs-toggle=modal]") oculta automaticamente CUALQUIER .modal.show antes de abrir el
        // target ("avoid conflict when clicking modal toggler while another one is open") --
        // ocultaba #modalFinanzasPOS (el fondo) y nunca lo volvia a mostrar. Como
        // #modalComprobanteVenta es DESCENDIENTE del DOM de #modalFinanzasPOS (se carga por AJAX
        // dentro de #contenedorFinanzasPOS), ocultar el ancestro colapsa tambien al descendiente
        // (0x0, invisible) sin importar su propio display/show. Se abre por JS en vez de
        // data-bs-toggle para no pasar por ese data-api -- mismo criterio ya usado para
        // #modalBuscarPersona/#modalBuscarProducto en compras.js.
        // jQuery se chequea DENTRO del handler (al click, no al bindearlo): en la vista standalone
        // (DetalleVenta/DetalleFactura con Layout completo) este script corre dentro de
        // @@RenderBody(), que en _Layout.cshtml se renderiza ANTES que <script src="jquery.min.js">
        // (cargado al final del <body>) -- mismo problema de orden ya documentado arriba en este
        // archivo para factura-electronica.js/detalle-venta-comprobante.js. Chequear window.jQuery
        // aca (al bindear) haria que el botón quedara sin ningún click handler en ese caso; al
        // click, la pagina ya esta completamente cargada hace rato.
        var btnFactura = document.getElementById("btnFacturaImprimirDetalle");
        if (btnFactura) {
            btnFactura.addEventListener("click", function () {
                if (window.jQuery) {
                    window.jQuery("#modalComprobanteVenta").modal("show");
                }
            });
        }

        // Con el fix de arriba, #modalFinanzasPOS ya queda abierto de fondo -- vuelve a aplicar el
        // problema original de z-index empatado (custom.css fija el mismo z-index fijo para TODO
        // .modal/.modal-backdrop) mas el hecho de ser descendiente del DOM de #modalFinanzasPOS, no
        // sibling. Mismo mecanismo ya usado 3 veces en el proyecto (elevarZIndexSobreModalAbierto
        // en compras.js, posPagoStack/traerModalFacturaAlFrente en Ventas/POS.cshtml) -- solo actua
        // si YA hay otro modal abierto (no rompe el caso standalone, donde no hay nada que apilar).
        //
        // Ademas: esta partial (_DetalleVentaCard.cshtml, y con ella _ModalComprobanteVenta.cshtml)
        // se carga por AJAX DENTRO de #contenedorFinanzasPOS -- #modalComprobanteVenta queda como
        // DESCENDIENTE del DOM de #modalFinanzasPOS, no como sibling. Con z-index empatado (mismo
        // valor para ambos), el navegador desempata por orden en el DOM -- pero ademas, al ser
        // descendiente, ni siquiera compite en el mismo contexto de apilamiento que #modalFinanzasPOS.
        // Re-parentarlo a body (ultimo hijo) antes de mostrarlo resuelve ambos problemas de una vez
        // -- mismo criterio que compras.js aplica para #modalBuscarPersona/#modalBuscarProducto.
        document.addEventListener("show.bs.modal", function (evt) {
            if (!evt.target || evt.target.id !== "modalComprobanteVenta") return;

            var modalesAbiertos = document.querySelectorAll(".modal.show").length;
            if (modalesAbiertos === 0) return;

            if (evt.target.parentNode !== document.body) {
                document.body.appendChild(evt.target);
            }

            var zIndex = 1040 + (10 * modalesAbiertos);
            evt.target.style.setProperty("z-index", zIndex, "important");

            setTimeout(function () {
                var backdrops = document.querySelectorAll(".modal-backdrop:not(.modal-stack)");
                var backdrop = backdrops.length ? backdrops[backdrops.length - 1] : null;
                if (backdrop) {
                    backdrop.style.setProperty("z-index", zIndex - 1, "important");
                    backdrop.classList.add("modal-stack");
                }
            }, 0);
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", enlazarBotonVolverDetalle);
        } else {
            enlazarBotonVolverDetalle();
        }
    })();
</script>
