@model List<Entidades.Venta>

@{
    string mensaje = ViewBag.Mensaje as string;
    decimal total = ViewBag.TotalVisible != null ? (decimal)ViewBag.TotalVisible : 0;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    string tituloVentas = ViewBag.TituloVentas as string ?? "Mis ventas";
    string subtituloVentas = ViewBag.SubtituloVentas as string;
    bool mostrarTotalMisVentas = ViewBag.MostrarTotalMisVentas == null || (bool)ViewBag.MostrarTotalMisVentas;
    ViewBag.ModoModalVentas = true;
}

<div class="egresos-pos vista-venta mis-ventas-modal">
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-warning m-3">@mensaje</div>
        @* Sin el permiso: el operador puede pedir la autorizacion de otro usuario (pos-autorizacion.js, 2026-11-03). *@
        @if (ViewBag.AutorizacionAccion is string accionAutorizar)
        {
            string posInstanceAutorizar = ViewBag.PosInstanceIdMisVentas as string ?? "";
            <div class="mx-3 mb-3">
                <button type="button" class="btn btn-primary btn-sm js-pos-autorizar"
                        data-accion="@accionAutorizar"
                        data-id-registro="0"
                        data-pos-instance-id="@posInstanceAutorizar"
                        data-recargar-url="@Url.Action("MisVentas", "Ventas", new { desdePos = true, posInstanceId = posInstanceAutorizar })"
                        data-recargar-titulo="Mis ventas">
                    <i class="fas fa-user-check mr-1"></i> Autorizar con otro usuario
                </button>
            </div>
        }
    }
    else
    {
        @* Barra compacta: el resumen (cantidad y total de lo filtrado) va a la izquierda de los filtros, en vez de
           un bloque aparte debajo (docs/DECISIONS.md, 2026-11-10). Los ids los actualiza aplicarFiltrosMisVentas. *@
        <div class="egresos-pos-toolbar mis-ventas-filtros">
            <div class="mis-ventas-filtros-campos">
                <div class="mis-ventas-resumen">
                    @{ int cantidadVentas = (Model ?? new List<Entidades.Venta>()).Count; }
                    <span id="misVentasCantidad">@cantidadVentas</span>
                    <span id="misVentasCantidadEtiqueta">@(cantidadVentas == 1 ? "venta" : "ventas")</span>
                    @if (mostrarTotalMisVentas)
                    {
                        <span class="mis-ventas-resumen-sep">·</span>
                        <strong id="misVentasTotal">@total.ToString("C")</strong>
                    }
                </div>
                <div class="form-group mis-ventas-filtro-cliente mb-2 mb-md-0">
                    <div class="input-group input-group-sm">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                        </div>
                        <input type="text" id="misVentasBuscarCliente" class="form-control" placeholder="Buscar cliente..." autocomplete="off" />
                    </div>
                </div>
                <div class="form-group mis-ventas-filtro-forma-pago mb-2 mb-md-0">
                    <select id="misVentasFormaPago" class="form-control form-control-sm">
                        <option value="">Forma de pago (todas)</option>
                        @foreach (Entidades.Venta.FormaPagoEnum fp in Enum.GetValues(typeof(Entidades.Venta.FormaPagoEnum)))
                        {
                            <option value="@fp.ToString().ToLower()">@fp.ToString()</option>
                        }
                    </select>
                </div>
                <button type="button" class="btn btn-outline-secondary mis-ventas-filtro-volver" id="btnVolverMisActividadesDesdeVentas">
                    <i class="fas fa-arrow-left mr-1"></i> Volver
                </button>
            </div>
        </div>

        <div class="px-2 pb-2">
            <div class="card shadow-sm ventas-card w-100">
                <div class="card-body p-0">
                    @Html.Partial("~/Views/Ventas/_TablaVentas.cshtml", Model)
                </div>
            </div>
        </div>

        @* Tarjetas expandibles: tocar una venta despliega su detalle; "Abrir detalle" lo abre en este mismo modal. *@
        <partial name="_VentasExpandible" />
    }
</div>

<style>
    .mis-ventas-modal {
        font-size: 0.875rem;
    }

    .egresos-pos .ventas-card {
        border: 1px solid #e9ecef;
        border-radius: .75rem;
    }

    .egresos-pos-toolbar h5 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #212529;
    }

    .egresos-pos-toolbar .form-control,
    .egresos-pos-toolbar .btn {
        min-height: 2.65rem;
        border-radius: .55rem;
    }

    .venta-item-modal { cursor: pointer; }

    .venta-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        padding: 10px 15px;
    }

    .venta-icono { flex: 0 0 auto; margin-right: 10px; }

    .venta-info { flex: 1 1 auto; min-width: 0; }

    .venta-tipo-persona { word-wrap: break-word; white-space: normal; }

    .venta-id { font-size: 0.8rem; color: #6c757d; }

    .venta-obs {
        font-size: 0.8rem;
        color: #4f5d75;
        margin-top: .15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 30rem;
    }

    .venta-total { text-align: right; flex: 0 0 auto; }

    .venta-total .importe { font-weight: bold; color: #28a745; }

    .venta-item:hover { background-color: #f8f9fc; }

    .mis-ventas-modal.vista-venta {
        width: 100%;
        max-width: none;
        margin: 0 !important;
        padding-left: 0;
        padding-right: 0;
    }

    @@media (max-width: 576px) {
        .venta-tipo-persona {
            max-width: 17ch;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }
    }

    .mis-ventas-filtros {
        background: #f8f9fc;
    }

    .mis-ventas-filtros-campos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: .6rem;
        width: 100%;
    }

    .mis-ventas-filtro-cliente {
        flex: 1 1 220px;
        max-width: 320px;
        margin: 0;
    }

    .mis-ventas-filtro-forma-pago {
        flex: 0 1 200px;
        margin: 0;
    }

    .mis-ventas-filtros .input-group-text {
        background: #fff;
        color: #858796;
    }

    @@media (max-width: 767.98px) {
        .mis-ventas-filtros-campos {
            justify-content: stretch;
        }

        .mis-ventas-filtro-cliente,
        .mis-ventas-filtro-forma-pago,
        .mis-ventas-filtro-volver {
            flex: 1 1 100%;
            max-width: none;
            width: 100%;
        }
    }

    /* --- Modal compacto (docs/DECISIONS.md, 2026-11-10): menos altura con la misma informacion. --- */

    /* En Cajas Abiertas el modal se inyecta dentro de #contenedorActividadesCaja, que conserva las clases
       text-center text-muted del aviso de carga: sin esto las filas salian centradas y grises. */
    .mis-ventas-modal {
        text-align: left;
        color: var(--ui-text, #3a3b45);
    }

    /* Barra: sin el margen/padding de 1rem de .egresos-pos-toolbar (custom.css) y controles de ~2rem. */
    .mis-ventas-modal .mis-ventas-filtros {
        margin: .5rem .5rem .5rem;
        padding: .45rem .65rem;
    }

    .mis-ventas-modal .mis-ventas-filtros .form-control,
    .mis-ventas-modal .mis-ventas-filtros .btn,
    .mis-ventas-modal .mis-ventas-filtros .input-group-text {
        min-height: 2rem;
        height: 2rem;
        font-size: .82rem;
        border-radius: .4rem;
    }

    .mis-ventas-modal .mis-ventas-filtros .btn {
        padding-top: 0;
        padding-bottom: 0;
    }

    .mis-ventas-modal .mis-ventas-filtros-campos {
        gap: .5rem;
    }

    /* Resumen "N ventas · $ total" a la izquierda: ocupa el espacio libre y empuja los filtros a la derecha. */
    .mis-ventas-resumen {
        flex: 1 1 auto;
        color: #858796;
        white-space: nowrap;
    }

    .mis-ventas-resumen strong {
        color: #212529;
        font-size: .95rem;
    }

    html.dark-mode .mis-ventas-resumen {
        color: #97a7bd;
    }

    html.dark-mode .mis-ventas-resumen strong {
        color: #e3eaf3;
    }

    .mis-ventas-modal #listaVentas .fecha-grupo {
        padding: .25rem .75rem;
        font-size: .8rem;
    }

    .mis-ventas-modal .venta-item {
        padding: .4rem .75rem;
    }

    /* Icono de forma de pago chico y de ancho fijo (el markup comparte fa-2x con Ventas/Index). */
    .mis-ventas-modal .venta-icono {
        flex: 0 0 1.75rem;
        margin-right: .4rem;
        text-align: center;
    }

    .mis-ventas-modal .venta-icono .fa-2x {
        font-size: 1.25rem;
    }

    /* Base 0 (no auto): con tipo + cliente en un renglon, auto hacia bajar el importe de renglon en celular. */
    .mis-ventas-modal .venta-info {
        flex: 1 1 0;
        line-height: 1.3;
    }

    .mis-ventas-modal .venta-linea-principal {
        overflow-wrap: anywhere;
    }

    .mis-ventas-modal .venta-comprobante {
        font-weight: 700;
    }

    .mis-ventas-modal .venta-id {
        font-size: .78rem;
    }

    @@media (max-width: 576px) {
        .mis-ventas-modal .venta-linea-principal {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }

    @@media (max-width: 767.98px) {
        .mis-ventas-modal .mis-ventas-resumen,
        .mis-ventas-modal .mis-ventas-filtro-cliente {
            flex: 1 1 100%;
        }

        /* Forma de pago y Volver comparten renglon en celular. */
        .mis-ventas-modal .mis-ventas-filtro-forma-pago {
            flex: 1 1 0;
            width: auto;
        }

        .mis-ventas-modal .mis-ventas-filtro-volver {
            flex: 0 0 auto;
            width: auto;
        }
    }

    html.dark-mode .mis-ventas-filtros {
        background: #132032;
    }

    html.dark-mode .mis-ventas-filtros .input-group-text {
        background: #172638;
        color: #97a7bd;
        border-color: #2a3b52;
    }
</style>

<script>
    (function () {
        function aplicarFiltrosMisVentas() {
            var textoCliente = ($("#misVentasBuscarCliente").val() || "").toLowerCase();
            var formaPagoSel = ($("#misVentasFormaPago").val() || "").toLowerCase();
            var total = 0;
            var cant = 0;

            $("#listaVentas .venta-item").each(function () {
                var $item = $(this);
                var cliente = (($item.data("cliente") || "") + " " + ($item.data("identificacion") || "")).toLowerCase();
                var formaPago = (($item.data("forma-pago") || "") + "").toLowerCase();

                var mostrar = (!textoCliente || cliente.indexOf(textoCliente) >= 0) &&
                    (!formaPagoSel || formaPago === formaPagoSel);

                $item.toggle(mostrar);

                if (mostrar) {
                    var valor = parseFloat($item.find(".importe").data("valor")) || 0;
                    total += valor;
                    cant++;
                }
            });

            $("#listaVentas .fecha-grupo").each(function () {
                var $grupo = $(this);
                var $siguiente = $grupo.nextUntil(".fecha-grupo", ".venta-item:visible");
                $grupo.toggle($siguiente.length > 0);
            });

            $("#misVentasCantidad").text(cant);
            $("#misVentasCantidadEtiqueta").text(cant === 1 ? "venta" : "ventas");
            $("#misVentasTotal").text(total.toLocaleString("es-AR", { style: "currency", currency: "ARS" }));
        }

        function abrirDetalleVenta(idVenta) {
            if (!idVenta) return;

            if (@(desdePos ? "true" : "false") && window.POSVentas && typeof window.POSVentas.abrirDetalle === "function") {
                window.POSVentas.abrirDetalle(idVenta);
                return;
            }

            if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirDetalleVenta === "function") {
                window.CajasAbiertas.abrirDetalleVenta(idVenta, @idCierreActividad);
            }
        }

        $(document)
            .off("input.misVentasFiltro", "#misVentasBuscarCliente")
            .on("input.misVentasFiltro", "#misVentasBuscarCliente", aplicarFiltrosMisVentas)
            .off("change.misVentasFiltro", "#misVentasFormaPago")
            .on("change.misVentasFiltro", "#misVentasFormaPago", aplicarFiltrosMisVentas)
            // Tocar la tarjeta despliega su detalle (_VentasExpandible.cshtml); el detalle completo, con todas sus
            // acciones, se abre desde "Abrir detalle" dentro del panel.
            .off("click.misVentasDetalle", "#listaVentas .venta-abrir-detalle")
            .on("click.misVentasDetalle", "#listaVentas .venta-abrir-detalle", function (evento) {
                evento.preventDefault();
                abrirDetalleVenta($(this).data("venta-id"));
            })
            .off("click.misVentasVolver", "#btnVolverMisActividadesDesdeVentas")
            .on("click.misVentasVolver", "#btnVolverMisActividadesDesdeVentas", function () {
                if (@(desdePos ? "true" : "false") && window.POSEgresos && typeof window.POSEgresos.abrirMis === "function") {
                    window.POSEgresos.abrirMis();
                    return;
                }

                if (@idCierreActividad > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirActividades === "function") {
                    window.CajasAbiertas.abrirActividades(@idCierreActividad);
                }
            });
    })();
</script>
