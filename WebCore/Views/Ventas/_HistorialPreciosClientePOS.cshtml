@model System.Collections.Generic.List<WebCore.Models.HistorialPrecioProductoVm>
@using System.Globalization

@* Historial de "ultimo precio por producto" de un cliente (F8 del POS), 2026-09-06 (retomado --
   ver docs/DECISIONS.md). Port literal de Web/Views/Ventas/_HistorialPreciosClientePOS.cshtml.
   Se carga dentro de #modalFinanzasPOS (mismo mecanismo generico que F2/F5/F6/F7). El boton
   "copiar precio" de cada fila lo consume el JS de POS.cshtml (window.POSPrecioCopiado) para
   pegarlo en #txtPrecioKg al editar una linea de venta. *@

@{
    string error = ViewBag.HistorialPreciosError as string ?? "";
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning mb-0 py-2">@error</div>
}
else if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info mb-0 py-2">Este cliente todavía no tiene compras registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover mb-0 historial-precios-tabla">
            <thead class="thead-light">
                <tr>
                    <th style="width:100px;">Código</th>
                    <th>Producto</th>
                    <th class="text-right" style="width:130px;">Precio</th>
                    <th class="text-nowrap" style="width:115px;">Fecha</th>
                    <th class="text-center" style="width:75px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var precioTexto = item.PrecioKg.ToString("N2", new CultureInfo("es-AR"));
                    <tr>
                        <td>@item.Codigo</td>
                        <td>@item.Producto</td>
                        <td class="text-right font-weight-bold">$ @precioTexto</td>
                        <td class="text-nowrap">@(item.FechaVenta.HasValue ? item.FechaVenta.Value.ToString("dd/MM/yyyy") : "-")</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-secondary js-copiar-precio-historial"
                                    data-precio="@(item.PrecioKg.ToString(CultureInfo.InvariantCulture))"
                                    data-codigo="@item.Codigo"
                                    data-producto="@item.Producto"
                                    title="Copiar precio">
                                <i class="fas fa-copy"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* "Airear" el historial de precios (2026-09-06, pedido explicito del usuario -- ver
   docs/DECISIONS.md): mas padding/tamaño de fuente que el original (que lo comprimia al 50% del
   ancho de modal-xl, ver el CSS de POS.cshtml) -- decision deliberada de mejora sobre el diseño
   original del clasico (permitido explicitamente, ver docs/DECISIONS.md "Web es fuente de verdad
   de diseño, mejoras bienvenidas"), no un port literal en este punto puntual. *@
<style>
    #modalFinanzasPOS .historial-precios-tabla td,
    #modalFinanzasPOS .historial-precios-tabla th { padding: .55rem .75rem; font-size: .92rem; line-height: 1.3; }
</style>
