</style>

@* Config para detalle-venta-comprobante.js (nuevo, wire de los botones de arriba) -- las URLs
   de AFIP (imprimirTicket/generarFactura/cerrarVentaSinFacturar) NO se repiten aca, viven en
   window.AppUrls (arriba), que es lo que factura-electronica.js espera. La asignacion del
   config en si es JS vainilla (segura a nivel de modulo), pero el <script src> de
   detalle-venta-comprobante.js SI usa "$" a nivel de modulo -- mismo problema y mismo fix
   (inyeccion diferida a DOMContentLoaded) que factura-electronica.js mas arriba. *@
<script>
    window.DetalleVentaComprobanteConfig = {
        ventaId: @Model.IdVenta,
        urls: {
            imprimir: '@Url.Action("Imprimir", "Ventas")',
            imprimirTicketHtml: '@Url.Action("ImprimirTicketHtml", "Ventas")',
            obtenerDatosEmailComprobante: '@Url.Action("ObtenerDatosEmailComprobante", "Ventas")',
            enviarComprobanteEmail: '@Url.Action("EnviarComprobanteEmail", "Ventas")'
        }
    };

    (function () {
        function inyectar() {
            var s = document.createElement('script');
            s.src = '@Url.Content("~/Scripts/app/detalle-venta-comprobante.js")?v=1';
            document.body.appendChild(s);
        }

        if (window.jQuery || document.readyState !== 'loading') {
            inyectar();
        } else {
            document.addEventListener('DOMContentLoaded', inyectar);
        }
    })();
</script>
