@{
    // Port literal de Web/Views/SeleccionUsuario/Index.cshtml (2026-09-09, ver docs/DECISIONS.md
    // "Batch B: permisos reales + operador de produccion"). Pantalla compartida: "quien esta
    // haciendo esto" para la cuenta de produccion, usada por Movimientos/Stock/Elaborados ANTES
    // de entrar a la vista de edicion. Sin contrasena. Al elegir, vuelve a returnUrl con
    // idUsuarioCreador agregado; al cancelar, vuelve a cancelUrl (el Index del modulo que llamo).
    ViewBag.Title = "Seleccionar usuario";
    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Home");
    string cancelUrl = ViewBag.CancelUrl as string ?? Url.Action("Index", "Home");
}

<div class="container-fluid mt-5">
    <div class="text-center">
        <h4 class="text-primary"><i class="fas fa-user-shield mr-1"></i> ¿Quién está haciendo esto?</h4>
        <p class="text-gray-500 mb-4">Esta sesión usa la cuenta de producción -- elegí tu nombre para continuar.</p>
    </div>
</div>

@Html.Partial("~/Views/Shared/_ModalSeleccionUsuario.cshtml")

@section Scripts {
    <script src="~/Scripts/app/seleccion-usuario.js?v=3"></script>
    <script>
        (function () {
            var usuariosActivos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UsuariosActivosEmpresa ?? new System.Collections.Generic.List<object>()));
            var returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrl));
            var cancelUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cancelUrl));

            // Mismo bug real ya documentado en el clasico (Stock/Nuevo): returnUrl puede llegar
            // con "idUsuarioCreador=0" ya incluido -- concatenar a mano duplicaria el parametro y
            // el model binder tomaria el primer valor (0), volviendo a mostrar este selector en
            // loop. new URL(...).searchParams.set(...) reemplaza el valor existente.
            function volverCon(idUsuario) {
                var url = new URL(returnUrl, window.location.origin);
                url.searchParams.set('idUsuarioCreador', idUsuario);
                window.location.href = url.toString();
            }

            function pedirUsuario() {
                window.SeleccionUsuario.abrir({
                    titulo: '¿Quién está haciendo esto?',
                    usuarios: usuariosActivos,
                    requierePassword: false
                }).then(function (usuario) {
                    volverCon(usuario.id);
                }).catch(function () {
                    window.location.href = cancelUrl;
                });
            }

            // Red de seguridad: si el modal se cierra sin resolver, el Promise de .abrir() no se
            // resuelve ni se rechaza -- sin esto el .catch() no correria nunca y la pantalla
            // quedaria colgada (mismo comentario que el clasico).
            $(document).on('hidden.bs.modal', '#modalSeleccionUsuario', function () {
                if (!$(this).data('resuelto')) {
                    window.location.href = cancelUrl;
                }
            });

            pedirUsuario();
        })();
    </script>
}
