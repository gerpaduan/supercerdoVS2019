@model SectorAbmVm

@{
    bool editando = !string.IsNullOrWhiteSpace(Model.SectorOriginal);
}

<div class="container-fluid px-2 px-md-3 sectores-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("ExpendiosGenerados", "PuntosExpendio")">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-lg-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="font-weight-bold text-uppercase text-muted mb-3 sectores-section-title">@(editando ? "Modificar sector" : "Nuevo sector")</h6>

                    <form asp-controller="PuntosExpendio" asp-action="GuardarSector" method="post">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.SectorOriginal)

                        <div class="form-group">
                            <label for="Nombre">Nombre del sector</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", maxlength = "80", autocomplete = "off" })
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-success mr-2">
                                <i class="fas fa-save mr-1"></i> @(editando ? "Guardar cambios" : "Crear sector")
                            </button>

                            @if (editando)
                            {
                                <a class="btn btn-outline-secondary" href="@Url.Action("Sectores", "PuntosExpendio")">Cancelar</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Sector</th>
                                    <th class="text-center" style="width:120px;">En uso</th>
                                    <th style="width:180px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Sectores == null || Model.Sectores.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No hay sectores cargados.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model.Sectores)
                                    {
                                        <tr>
                                            <td>@item.Nombre</td>
                                            <td class="text-center">@(item.EnUso ? "Sí" : "No")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a class="btn btn-outline-primary" href="@Url.Action("Sectores", "PuntosExpendio", new { editar = item.Nombre })" title="Modificar sector">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" action="@Url.Action("EliminarSector", "PuntosExpendio")" class="d-inline" onsubmit="return confirm('¿Eliminar el sector @item.Nombre?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="sector" value="@item.Nombre" />
                                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar sector" disabled="@(item.EnUso ? "disabled" : null)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sectores-page {
        font-size: .86rem;
    }

    .sectores-page .card-body {
        padding: .8rem .92rem;
    }

    .sectores-page .sectores-section-title {
        font-size: .72rem;
        letter-spacing: .04em;
    }

    .sectores-page label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .18rem;
    }

    .sectores-page .form-control,
    .sectores-page .btn {
        min-height: 2.15rem;
        font-size: .84rem;
        padding: .28rem .56rem;
        border-radius: .52rem;
    }

    .sectores-page table th,
    .sectores-page table td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
        font-size: .84rem;
    }

    .sectores-page table thead th {
        font-size: .68rem !important;
        text-transform: uppercase;
        letter-spacing: .02em;
        padding-top: .4rem;
        padding-bottom: .4rem;
    }

    .sectores-page .btn-group-sm > .btn {
        font-size: .76rem;
        padding: .18rem .42rem;
    }
</style>

<script>
    (function () {
        function showNavigationLoading(message) {
            if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
            }
        }

        document.addEventListener("submit", function (event) {
            var form = event.target;
            if (!form || !form.closest || !form.closest(".container-fluid")) return;
            showNavigationLoading("Cargando solicitud...");
        });

        document.addEventListener("click", function (event) {
            var link = event.target.closest ? event.target.closest(".container-fluid a[href]") : null;
            if (!link) return;
            if (link.target === "_blank" || link.hasAttribute("download")) return;

            var href = link.getAttribute("href") || "";
            if (!href || href.charAt(0) === "#" || /^javascript:/i.test(href)) return;

            event.preventDefault();
            showNavigationLoading("Cargando solicitud...");
            window.setTimeout(function () {
                window.location.href = link.href;
            }, 0);
        });
    })();
</script>
