@using System.Collections.Generic
@*
    Botones "PDF"/"Email" de cada card (agregados 2026-09-03, ver docs/DECISIONS.md) reemplazan al
    boton unico "Imprimir" original (que abria _ModalPostPuntoExpendio.cshtml con 3 opciones:
    ticket/PDF/email). Solo el ticket ESC/POS sigue sin portar (depende del agente de impresion
    local, sin relacion con el bloqueante de PDF que ya se resolvio con QuestPDF) -- ver cabecera
    de PuntosExpendioController.cs.
*@
@{
    var fechaHoy = ViewBag.FechaHoy as string ?? "";
    var sectores = ViewBag.SectoresExpendio as List<SelectListItem> ?? new List<SelectListItem>();
    var sucursales = ViewBag.SucursalesExpendio as List<SelectListItem> ?? new List<SelectListItem>();
    var usuarios = ViewBag.UsuariosExpendio as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <div>
            <p class="mb-0 text-muted">Consulta general de expendios registrados en la empresa.</p>
        </div>
        <div class="d-flex flex-wrap mt-2 mt-sm-0" style="gap:.5rem;">
            @* Alterna entre tarjetas por expendio y una tabla plana con una fila por linea (ordenable), como Ventas > Lineas. *@
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVistaSoloLineasExpendios"
                    data-texto-plana="Ver solo líneas"
                    data-texto-agrupada="Ver agrupado por expendio">
                <i class="fas fa-list mr-1"></i><span class="js-vista-texto">Ver solo líneas</span>
            </button>
            @* Exportar PDF / Excel: el href lo reconstruye el script con las fechas y filtros que se ven en pantalla. *@
            <a class="btn btn-sm btn-outline-danger js-exportar-expendios" id="btnExportarExpendiosPdf" href="@Url.Action("ExpendiosGeneradosPdf", "PuntosExpendio")"
               title="Exportar a PDF lo que se ve en pantalla">
                <i class="fas fa-file-pdf mr-1"></i> PDF
            </a>
            <a class="btn btn-sm btn-outline-success js-exportar-expendios" id="btnExportarExpendiosExcel" href="@Url.Action("ExpendiosGeneradosExcel", "PuntosExpendio")"
               title="Exportar a Excel lo que se ve en pantalla">
                <i class="fas fa-file-excel mr-1"></i> Excel
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="form-row align-items-end">
                <div class="col-12 col-md-2 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosFechaDesde">Fecha desde</label>
                    <input type="datetime-local" step="1" class="form-control form-control-sm" id="filtroExpendiosFechaDesde" value="@fechaHoy" />
                </div>
                <div class="col-12 col-md-2 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosFechaHasta">Fecha hasta</label>
                    <input type="datetime-local" step="1" class="form-control form-control-sm" id="filtroExpendiosFechaHasta" value="@fechaHoy" />
                </div>
                <div class="col-12 col-md-2 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosEstado">Estado</label>
                    <select class="form-control form-control-sm" id="filtroExpendiosEstado">
                        <option value="">Todos</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Asignado">Asignado</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosSucursal">Sucursal</label>
                    <select class="form-control form-control-sm" id="filtroExpendiosSucursal">
                        <option value="">Todas</option>
                        @foreach (var item in sucursales)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 mb-2">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosSector">Sector</label>
                    <select class="form-control form-control-sm" id="filtroExpendiosSector">
                        <option value="">Todos</option>
                        @foreach (var item in sectores)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 mb-2">
                    <button type="button" class="btn btn-primary btn-sm btn-block" id="btnBuscarExpendiosGenerados">
                        <i class="fas fa-search mr-1"></i>Buscar
                    </button>
                </div>
            </div>

            <div class="form-row">
                <div class="col-12 col-md-3 mb-2 mb-md-0">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosCliente">Cliente / Nro remito</label>
                    @* Selector multi-seleccion (filtro-picker.js): F10 / lupa busca personas y filtra por su ID (la X lo quita). Sin
                       seleccion es texto libre: identificacion del expendio o nro de remito. *@
                    <input type="text" class="form-control form-control-sm" id="filtroExpendiosCliente" placeholder="Nombre, identificación o nro de remito" autocomplete="off"
                           data-filtro-picker="cliente" data-filtro-picker-tecla="F10" />
                </div>
                <div class="col-12 col-md-3 mb-2 mb-md-0">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosProducto">Producto</label>
                    <input type="text" class="form-control form-control-sm" id="filtroExpendiosProducto" placeholder="Código o descripción" autocomplete="off" />
                </div>
                <div class="col-12 col-md-3 mb-2 mb-md-0">
                    <label class="small font-weight-bold mb-1" for="filtroExpendiosUsuario">Usuario</label>
                    <select class="form-control form-control-sm" id="filtroExpendiosUsuario">
                        <option value="">Todos</option>
                        @foreach (var item in usuarios)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <div class="small text-muted pt-4 d-none" id="msgFiltroFechaExpendiosGenerados">
                        Cambio el rango de fechas. Presione Buscar para actualizar los datos.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3 expendios-totales-card">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap justify-content-between">
                <h5 class="text-muted m-0" style="font-weight: 500;">Expendios: <span id="totExpendiosCantidad">0</span></h5>
                <h5 class="text-muted m-0" style="font-weight: 500;">Lineas: <span id="totExpendiosLineas">0</span></h5>
                <h5 class="text-muted m-0" style="font-weight: 500;">Kgs.: <span id="totExpendiosKg">0,000</span></h5>
                <h5 class="text-muted m-0" style="font-weight: 500;">Total: <span id="totExpendiosImporte">$ 0,00</span></h5>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-info d-none" id="msgExpendiosGenerados"></div>

            <div id="expendiosGeneradosCards" class="expendios-cards">
                <div class="text-center text-muted py-4">No hay expendios para mostrar.</div>
            </div>

            @* Vista "Ver solo lineas": encabezado y filas los arma el script (se redibuja con cada filtro). *@
            <div id="expendiosGeneradosPlana" class="table-responsive d-none">
                <table class="table table-sm table-hover mb-0 lineas-tabla-plana expendios-tabla-plana">
                    <thead class="thead-light"><tr id="expendiosPlanaEncabezado"></tr></thead>
                    <tbody id="expendiosPlanaCuerpo"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Estilos de la tabla plana (encabezados ordenables) compartidos con Ventas > Lineas. *@
@Html.Partial("~/Views/Shared/_LineasAgrupadasStyles.cshtml")

<style>
    .expendios-cards {
        display: flex;
        flex-direction: column;
        gap: .85rem;
    }

    .expendio-card {
        border-left: 4px solid var(--ui-border-strong);
    }

    @@media (min-width: 992px) {
        .expendios-cards {
            align-items: flex-start;
        }

        .expendio-card {
            width: 70%;
        }
    }

    .expendio-card--asignado {
        border-left-color: var(--secondary);
    }

    .expendio-card--pendiente {
        border-left-color: var(--warning);
    }

    .expendio-card-header {
        padding: .75rem 1rem;
        border-bottom: 1px solid var(--ui-border);
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: .5rem;
    }

    .expendio-card-titulo {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .expendio-card-numero {
        font-weight: 700;
        color: var(--ui-primary);
        font-size: 1.05rem;
    }

    .expendio-card-fecha {
        color: #6c757d;
        font-size: .82rem;
    }

    .expendio-card-cliente {
        font-weight: 600;
        margin-top: .2rem;
    }

    .expendio-card-meta {
        font-size: .78rem;
        color: #6c757d;
        margin-top: .15rem;
    }

    .expendio-card-body {
        padding: 0 1rem;
    }

    .expendio-card-lineas {
        font-size: .84rem;
    }

    .expendio-card-lineas th,
    .expendio-card-lineas td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .expendio-card-lineas thead th {
        font-size: .72rem !important;
        color: #6c757d;
        border-top: none;
    }

    .expendio-card-footer {
        padding: .5rem 1rem .75rem;
        text-align: right;
        font-size: .82rem;
        color: #6c757d;
        border-top: 1px solid var(--ui-border);
        margin-top: .25rem;
    }

    .expendio-card-footer strong {
        color: var(--ui-primary);
    }

    .expendios-tabla-plana {
        font-size: .82rem;
    }

    .expendios-tabla-plana th,
    .expendios-tabla-plana td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .expendios-tabla-plana thead th {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    /* Totales (Expendios / Lineas / Kgs. / Total): misma letra que el encabezado de la tabla. 14px = lo que termina
       aplicando ui-refresh.css ("body.app-shell #content .table thead th"), que le gana a los .72rem de la regla de arriba. */
    .expendios-totales-card h5 {
        font-size: 14px;
    }
</style>

@section Scripts {
    @* Selector multi-seleccion de Cliente (filtro-picker.js): el modal va ANTES del script del componente (lee de el las URLs). *@
    <partial name="~/Views/Shared/_FiltroPickerModal.cshtml" />
    <script src="@Url.Content("~/Scripts/app/filtro-picker.js")" asp-append-version="true"></script>
    <script>
        (function (window, $, document) {
            'use strict';

            var config = {
                url: '@Url.Action("ExpendiosGeneradosData", "PuntosExpendio")',
                urlPdf: '@Url.Action("ExpendiosGeneradosPdf", "PuntosExpendio")',
                urlExcel: '@Url.Action("ExpendiosGeneradosExcel", "PuntosExpendio")',
                urlEnviarEmail: '@Url.Action("EnviarComprobanteEmailExpendio", "PuntosExpendio")',
                claveVistaPlana: 'lineasVistaSoloLineas_expendios'
            };
            var $cliente = $('#filtroExpendiosCliente');
            var cache = [];
            // Lo que se consulto al servidor: fechas YA aplicadas (no las que estan a medio editar) y personas elegidas.
            // Los exports viajan con esto, para que el archivo coincida con lo que se ve.
            var fetchState = {
                fechaDesde: $('#filtroExpendiosFechaDesde').val() || '',
                fechaHasta: $('#filtroExpendiosFechaHasta').val() || '',
                ids: ''
            };
            var vistaPlana = false;
            var ordenPlana = { clave: 'fecha', dir: 'desc' };

            // ---- Formato ----
            function formatKg(value) {
                return Number(value || 0).toLocaleString('es-AR', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
            }

            function formatMoney(value) {
                return '$ ' + Number(value || 0).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function escapeHtml(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // Igual que Normalizar de ExpendiosGeneradosFiltro.cs (los filtros se repiten en C# para los exports).
            function normalizeText(value) {
                return String(value == null ? '' : value).toLowerCase().replace(/\s+/g, ' ').trim();
            }

            function showMessage(type, text) {
                var $msg = $('#msgExpendiosGenerados');
                if (!text) {
                    $msg.addClass('d-none')
                        .removeClass('alert-info alert-warning alert-danger alert-success')
                        .text('');
                    return;
                }

                var css = {
                    info: 'alert-info',
                    warning: 'alert-warning',
                    danger: 'alert-danger',
                    success: 'alert-success'
                }[type || 'info'] || 'alert-info';

                $msg.removeClass('d-none alert-info alert-warning alert-danger alert-success')
                    .addClass(css)
                    .text(text);
            }

            // ---- Filtros en vivo ----
            // IDs elegidos en el selector (filtro-picker.js); '' si el filtro esta en modo texto libre.
            function idsCliente() {
                return String($cliente.attr('data-ids') || '');
            }

            // Texto de Cliente / remito; con personas elegidas el input solo muestra un resumen y no se usa.
            function textoCliente() {
                return idsCliente() ? '' : $cliente.val();
            }

            function valoresFiltros() {
                return {
                    texto: textoCliente() || '',
                    producto: $('#filtroExpendiosProducto').val() || '',
                    sucursal: $('#filtroExpendiosSucursal').val() || '',
                    estado: $('#filtroExpendiosEstado').val() || '',
                    sector: $('#filtroExpendiosSector').val() || '',
                    usuario: $('#filtroExpendiosUsuario').val() || ''
                };
            }

            // Mismas reglas que ExpendiosGeneradosFiltro.Aplicar (C#). Con Producto cada expendio conserva SOLO las
            // lineas que coinciden (codigo o descripcion) y sus kilos / importe pasan a ser los de esas lineas.
            function getFilteredItems() {
                var f = valoresFiltros();
                var texto = normalizeText(f.texto);
                var producto = normalizeText(f.producto);
                var sucursal = normalizeText(f.sucursal);
                var estado = normalizeText(f.estado);
                var sector = normalizeText(f.sector);
                var usuario = normalizeText(f.usuario);
                var resultado = [];

                cache.forEach(function (item) {
                    // Busca por identificacion del cliente O por numero de remito (sector REMITOS).
                    if (texto && normalizeText(item.identificacionExpendio).indexOf(texto) < 0 && normalizeText(item.nroRemito).indexOf(texto) < 0) return;
                    if (sucursal && normalizeText(item.sucursal) !== sucursal) return;
                    if (estado && normalizeText(item.estado) !== estado) return;
                    if (sector && normalizeText(item.sector) !== sector) return;
                    if (usuario && normalizeText(item.usuario) !== usuario) return;

                    if (!producto) {
                        resultado.push(item);
                        return;
                    }

                    var lineas = (item.lineas || []).filter(function (linea) {
                        return normalizeText(linea.codigo).indexOf(producto) >= 0 || normalizeText(linea.producto).indexOf(producto) >= 0;
                    });
                    if (!lineas.length) return;

                    resultado.push($.extend({}, item, {
                        lineas: lineas,
                        cantItems: lineas.length,
                        totalKg: lineas.reduce(function (acc, l) { return acc + Number(l.cantKg || 0); }, 0),
                        totalImporte: lineas.reduce(function (acc, l) { return acc + Number(l.total || 0); }, 0)
                    }));
                });

                return resultado;
            }

            // ---- Vista agrupada (una tarjeta por expendio) ----
            function renderDetalle(lineas) {
                if (!lineas || !lineas.length) {
                    return '<div class="small text-muted py-2">Sin detalle de lineas.</div>';
                }

                var html = '<div class="table-responsive"><table class="table table-sm table-borderless mb-0 expendio-card-lineas"><thead><tr>'
                    + '<th style="width:90px;">Codigo</th>'
                    + '<th>Producto</th>'
                    + '<th style="width:95px;" class="text-right">Kgs.</th>'
                    + '<th style="width:110px;" class="text-right">Precio</th>'
                    + '<th style="width:110px;" class="text-right">Total</th>'
                    + '</tr></thead><tbody>';

                lineas.forEach(function (linea) {
                    html += '<tr>'
                        + '<td>' + escapeHtml(linea.codigo || 0) + '</td>'
                        + '<td>' + escapeHtml(linea.producto || '') + '</td>'
                        + '<td class="text-right">' + formatKg(linea.cantKg) + '</td>'
                        + '<td class="text-right">' + formatMoney(linea.precioKg) + '</td>'
                        + '<td class="text-right">' + formatMoney(linea.total) + '</td>'
                        + '</tr>';
                });

                html += '</tbody></table></div>';
                return html;
            }

            function renderExpendioCard(item) {
                var estadoClass = item.estado === 'Asignado' ? 'badge-secondary' : 'badge-warning';
                var cardEstadoClass = item.estado === 'Asignado' ? 'expendio-card--asignado' : 'expendio-card--pendiente';
                var meta = 'Sector: ' + escapeHtml(item.sector || '-')
                    + ' &middot; Usuario: ' + escapeHtml(item.usuario || '-')
                    + ' &middot; Sucursal: ' + escapeHtml(item.sucursal || '-');

                return '<div class="card shadow-sm expendio-card ' + cardEstadoClass + '">'
                    + '<div class="expendio-card-header">'
                    + '<div>'
                    + '<div class="expendio-card-titulo">'
                    + '<span class="expendio-card-numero">#' + escapeHtml(item.idExpendio || 0) + '</span>'
                    + '<span class="expendio-card-fecha">' + escapeHtml(item.fecha || '') + ' ' + escapeHtml(item.hora || '') + '</span>'
                    + '<span class="badge ' + estadoClass + '">' + escapeHtml(item.estado || '') + '</span>'
                    + '</div>'
                    + '<div class="expendio-card-cliente">' + escapeHtml(item.identificacionExpendio || 'Consumidor final') + (item.nroRemito ? ' <span class="badge badge-secondary">Remito ' + escapeHtml(item.nroRemito) + '</span>' : '') + '</div>'
                    + '<div class="expendio-card-meta">' + meta + '</div>'
                    + '</div>'
                    + '<div>'
                    + '<a class="btn btn-sm btn-outline-secondary mr-1" href="' + escapeHtml(item.pdfUrl || '#') + '" target="_blank">PDF</a>'
                    + '<button type="button" class="btn btn-sm btn-outline-primary btnEmailExpendioGenerado" data-email-url="' + escapeHtml(item.emailUrl || '') + '" data-id-expendio="' + escapeHtml(item.idExpendio || 0) + '">Email</button>'
                    + '</div>'
                    + '</div>'
                    + '<div class="expendio-card-body">'
                    + renderDetalle(item.lineas || [])
                    + '</div>'
                    + '<div class="expendio-card-footer">'
                    + escapeHtml(item.cantItems || '0') + ' items &middot; '
                    + formatKg(item.totalKg) + ' kg &middot; '
                    + '<strong>' + formatMoney(item.totalImporte) + '</strong>'
                    + '</div>'
                    + '</div>';
            }

            function renderCards(items) {
                var $cont = $('#expendiosGeneradosCards');
                $cont.empty();

                if (!items || !items.length) {
                    $cont.append('<div class="text-center text-muted py-4">No hay expendios para mostrar.</div>');
                    return;
                }

                items.forEach(function (item) {
                    $cont.append(renderExpendioCard(item));
                });
            }

            // ---- Vista "Ver solo lineas" (tabla plana, una fila por linea, ordenable) ----
            // tipo: 'texto' | 'num' | 'fecha'. valor: lo que se ordena; texto: lo que se muestra.
            var columnasPlana = [
                { clave: 'fecha', titulo: 'Fecha', tipo: 'fecha', primerOrden: 'desc', nowrap: true,
                    valor: function (i) { return i.fechaExpendio || ''; }, texto: function (i) { return (i.fecha || '') + ' ' + (i.hora || ''); } },
                { clave: 'expendio', titulo: 'Expendio', tipo: 'num',
                    valor: function (i) { return Number(i.idExpendio || 0); }, texto: function (i) { return '#' + (i.idExpendio || 0); } },
                { clave: 'estado', titulo: 'Estado', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.estado); }, texto: function (i) { return i.estado || ''; } },
                { clave: 'cliente', titulo: 'Cliente', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.identificacionExpendio); }, texto: function (i) { return i.identificacionExpendio || 'Consumidor final'; } },
                { clave: 'remito', titulo: 'Nro remito', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.nroRemito); }, texto: function (i) { return i.nroRemito || ''; } },
                { clave: 'sector', titulo: 'Sector', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.sector); }, texto: function (i) { return i.sector || ''; } },
                { clave: 'usuario', titulo: 'Usuario', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.usuario); }, texto: function (i) { return i.usuario || ''; } },
                { clave: 'sucursal', titulo: 'Sucursal', tipo: 'texto',
                    valor: function (i) { return normalizeText(i.sucursal); }, texto: function (i) { return i.sucursal || ''; } },
                { clave: 'codigo', titulo: 'Código', tipo: 'num', linea: true,
                    valor: function (i, l) { return Number(l.codigo || 0); }, texto: function (i, l) { return l.codigo || '-'; } },
                { clave: 'producto', titulo: 'Producto', tipo: 'texto', linea: true,
                    valor: function (i, l) { return normalizeText(l.producto); }, texto: function (i, l) { return l.producto || ''; } },
                { clave: 'kg', titulo: 'Kgs.', tipo: 'num', derecha: true, linea: true,
                    valor: function (i, l) { return Number(l.cantKg || 0); }, texto: function (i, l) { return formatKg(l.cantKg); } },
                { clave: 'precio', titulo: 'Precio', tipo: 'num', derecha: true, linea: true,
                    valor: function (i, l) { return Number(l.precioKg || 0); }, texto: function (i, l) { return formatMoney(l.precioKg); } },
                { clave: 'total', titulo: 'Total', tipo: 'num', derecha: true, linea: true,
                    valor: function (i, l) { return Number(l.total || 0); }, texto: function (i, l) { return formatMoney(l.total); } }
            ];

            function ordenarFilasPlana(filas) {
                var col = columnasPlana.filter(function (c) { return c.clave === ordenPlana.clave; })[0] || columnasPlana[0];
                var sentido = ordenPlana.dir === 'asc' ? 1 : -1;

                filas.sort(function (a, b) {
                    var va = col.valor(a.item, a.linea);
                    var vb = col.valor(b.item, b.linea);

                    // Sin dato siempre al final, sea cual sea el sentido.
                    if (col.tipo !== 'num') {
                        var vaVacio = va === '' || va === undefined;
                        var vbVacio = vb === '' || vb === undefined;
                        if (vaVacio !== vbVacio) return vaVacio ? 1 : -1;
                    }

                    var cmp = col.tipo === 'num' ? va - vb : (va < vb ? -1 : (va > vb ? 1 : 0));
                    // Empate: orden original (estable) sin importar el sentido.
                    return cmp === 0 ? a.idx - b.idx : cmp * sentido;
                });
            }

            function renderPlana(items) {
                var filas = [];
                (items || []).forEach(function (item) {
                    (item.lineas || []).forEach(function (linea) {
                        filas.push({ item: item, linea: linea, idx: filas.length });
                    });
                });
                ordenarFilasPlana(filas);

                var head = columnasPlana.map(function (col) {
                    var activa = col.clave === ordenPlana.clave;
                    return '<th class="js-plana-ordenable' + (col.derecha ? ' text-right' : '') + '" data-clave="' + col.clave
                        + '" title="Ordenar por ' + escapeHtml(col.titulo) + '"' + (activa ? ' aria-sort="' + (ordenPlana.dir === 'asc' ? 'ascending' : 'descending') + '"' : '') + '>'
                        + escapeHtml(col.titulo) + '<span class="js-plana-flecha">' + (activa ? (ordenPlana.dir === 'asc' ? '▲' : '▼') : '') + '</span></th>';
                }).join('') + '<th></th>';
                $('#expendiosPlanaEncabezado').html(head);

                if (!filas.length) {
                    $('#expendiosPlanaCuerpo').html('<tr><td colspan="' + (columnasPlana.length + 1) + '" class="text-center text-muted py-4">No hay lineas para mostrar.</td></tr>');
                    return;
                }

                $('#expendiosPlanaCuerpo').html(filas.map(function (fila) {
                    var celdas = columnasPlana.map(function (col) {
                        var clases = [];
                        if (col.derecha) clases.push('text-right');
                        if (col.nowrap) clases.push('js-plana-nowrap');
                        return '<td' + (clases.length ? ' class="' + clases.join(' ') + '"' : '') + '>' + escapeHtml(col.texto(fila.item, fila.linea)) + '</td>';
                    }).join('');
                    var pdf = fila.item.pdfUrl
                        ? '<a class="btn btn-sm btn-outline-secondary" href="' + escapeHtml(fila.item.pdfUrl) + '" target="_blank" title="PDF del expendio" aria-label="PDF del expendio"><i class="fas fa-file-pdf"></i></a>'
                        : '';
                    return '<tr>' + celdas + '<td class="text-nowrap">' + pdf + '</td></tr>';
                }).join(''));
            }

            // ---- Totales y refresco ----
            function renderTotales(items) {
                var totLineas = 0;
                var totKg = 0;
                var totImporte = 0;

                (items || []).forEach(function (item) {
                    totLineas += (item.lineas || []).length;
                    totKg += Number(item.totalKg || 0);
                    totImporte += Number(item.totalImporte || 0);
                });

                $('#totExpendiosCantidad').text((items ? items.length : 0).toLocaleString('es-AR'));
                $('#totExpendiosLineas').text(totLineas.toLocaleString('es-AR'));
                $('#totExpendiosKg').text(formatKg(totKg));
                $('#totExpendiosImporte').text(formatMoney(totImporte));
            }

            function aplicarModoVista() {
                $('#expendiosGeneradosCards').toggleClass('d-none', vistaPlana);
                $('#expendiosGeneradosPlana').toggleClass('d-none', !vistaPlana);

                var $boton = $('#btnVistaSoloLineasExpendios');
                $boton.find('.js-vista-texto').text($boton.attr(vistaPlana ? 'data-texto-agrupada' : 'data-texto-plana'));
                $boton.find('i').toggleClass('fa-list', !vistaPlana).toggleClass('fa-layer-group', vistaPlana);
                $boton.attr('aria-pressed', vistaPlana ? 'true' : 'false');
            }

            function applyFilters() {
                var items = getFilteredItems();
                if (vistaPlana) renderPlana(items);
                else renderCards(items);
                renderTotales(items);
                actualizarEnlacesExportar();
            }

            // ---- Exportar a PDF / Excel ----
            // El archivo respeta lo que se ve: fechas y personas YA consultadas (fetchState) y los filtros en vivo.
            // El servidor aplica los mismos filtros (ExpendiosGeneradosFiltro) sobre lo que consulta.
            function urlExportar(urlBase) {
                var f = valoresFiltros();
                var params = new URLSearchParams();
                params.set('fechaDesde', fetchState.fechaDesde);
                params.set('fechaHasta', fetchState.fechaHasta);
                params.set('idsCliente', fetchState.ids);
                params.set('estado', f.estado);
                params.set('sucursal', f.sucursal);
                params.set('sector', f.sector);
                params.set('usuario', f.usuario);
                params.set('texto', f.texto);
                params.set('producto', f.producto);
                return urlBase + '?' + params.toString();
            }

            function actualizarEnlacesExportar() {
                $('#btnExportarExpendiosPdf').attr('href', urlExportar(config.urlPdf));
                $('#btnExportarExpendiosExcel').attr('href', urlExportar(config.urlExcel));
            }

            $('.js-exportar-expendios').on('click', function (event) {
                // Sin ningun expendio visible no hay nada que exportar: se avisa y no se descarga.
                if (!getFilteredItems().length) {
                    event.preventDefault();
                    if (window.Swal && typeof window.Swal.fire === 'function') {
                        window.Swal.fire({
                            icon: 'info',
                            title: 'No hay expendios para exportar',
                            text: 'Ajustá los filtros para que la pantalla muestre al menos un expendio.'
                        });
                    } else {
                        window.alert('No hay expendios para exportar.');
                    }
                    return;
                }

                actualizarEnlacesExportar();
            });

            // ---- Carga ----
            function setDateHint(visible) {
                $('#msgFiltroFechaExpendiosGenerados').toggleClass('d-none', !visible);
            }

            function loadData() {
                var fechaDesde = $('#filtroExpendiosFechaDesde').val() || '';
                var fechaHasta = $('#filtroExpendiosFechaHasta').val() || '';

                if (fechaDesde && fechaHasta && fechaDesde > fechaHasta) {
                    showMessage('warning', 'La fecha desde no puede ser mayor a la fecha hasta.');
                    return;
                }

                fetchState.fechaDesde = fechaDesde;
                fetchState.fechaHasta = fechaHasta;
                fetchState.ids = idsCliente();
                setDateHint(false);
                showMessage(null, '');
                var consultando = '<div class="text-center text-muted py-4">Consultando expendios...</div>';
                $('#expendiosGeneradosCards').html(consultando);
                $('#expendiosPlanaCuerpo').html('<tr><td colspan="' + (columnasPlana.length + 1) + '" class="text-center text-muted py-4">Consultando expendios...</td></tr>');

                $.ajax({
                    url: config.url,
                    type: 'GET',
                    dataType: 'json',
                    cache: false,
                    data: {
                        fechaDesde: fechaDesde,
                        fechaHasta: fechaHasta,
                        idsCliente: fetchState.ids
                    }
                })
                    .done(function (resp) {
                        if (!resp || resp.ok === false) {
                            cache = [];
                            applyFilters();
                            showMessage('warning', resp && resp.mensaje ? resp.mensaje : 'No se pudieron consultar los expendios.');
                            return;
                        }

                        cache = resp.items || [];
                        applyFilters();
                        if (!cache.length) {
                            showMessage('info', 'No hay expendios para el rango de fechas seleccionado.');
                        } else if (resp.truncado) {
                            showMessage('warning', 'La consulta alcanzó el máximo de expendios que se cargan por vez: puede haber expendios más viejos sin mostrar. Acotá el rango de fechas.');
                        }
                    })
                    .fail(function () {
                        cache = [];
                        applyFilters();
                        showMessage('danger', 'No se pudieron consultar los expendios.');
                    });
            }

            $('#btnBuscarExpendiosGenerados').on('click', function () {
                loadData();
            });

            // Flujo minimo de envio de comprobante por email (sin modal rico -- ver
            // docs/10-migracion-aspnet-core/README.md): trae asunto/mensaje por defecto,
            // pide el email destino con prompt() y postea directo.
            $(document).on('click', '.btnEmailExpendioGenerado', function () {
                var $btn = $(this);
                var emailUrl = $btn.data('email-url');
                var idExpendio = parseInt($btn.data('id-expendio') || 0, 10) || 0;
                if (!emailUrl || !idExpendio) return;

                $.getJSON(emailUrl).done(function (resp) {
                    if (!resp || !resp.ok) {
                        showMessage('warning', (resp && resp.msg) || 'No se pudieron obtener los datos del email.');
                        return;
                    }

                    var destino = window.prompt('Email destino:', resp.email || '');
                    if (!destino) return;

                    $.post(config.urlEnviarEmail, {
                        idExpendio: idExpendio,
                        emailDestino: destino,
                        asunto: resp.asunto,
                        mensaje: resp.mensaje
                    }).done(function (envioResp) {
                        showMessage(envioResp && envioResp.ok ? 'success' : 'danger',
                            (envioResp && envioResp.msg) || 'Error desconocido enviando el email.');
                    }).fail(function () {
                        showMessage('danger', 'No se pudo enviar el email.');
                    });
                }).fail(function () {
                    showMessage('danger', 'No se pudieron obtener los datos del email.');
                });
            });

            $('#filtroExpendiosFechaDesde, #filtroExpendiosFechaHasta').on('change', function () {
                var cambioPendiente = fetchState.fechaDesde !== ($('#filtroExpendiosFechaDesde').val() || '')
                    || fetchState.fechaHasta !== ($('#filtroExpendiosFechaHasta').val() || '');
                setDateHint(cambioPendiente);
            });

            // Cliente: el texto libre filtra en vivo sobre lo cargado. Elegir (o quitar con la X) personas cambia lo que
            // se consulta al servidor: el selector dispara "filtropicker:change" tras su evento "input".
            $cliente.on('filtropicker:change', loadData);
            $('#filtroExpendiosCliente, #filtroExpendiosProducto').on('input', applyFilters);
            $('#filtroExpendiosEstado, #filtroExpendiosSucursal, #filtroExpendiosSector, #filtroExpendiosUsuario').on('change', applyFilters);

            // Orden de la vista plana: primer clic en una columna ordena ascendente (fecha: la mas reciente primero); otro clic invierte.
            $('#expendiosPlanaEncabezado').on('click', 'th.js-plana-ordenable', function () {
                var clave = $(this).attr('data-clave');
                var col = columnasPlana.filter(function (c) { return c.clave === clave; })[0];
                if (!col) return;

                if (ordenPlana.clave === clave) ordenPlana.dir = ordenPlana.dir === 'asc' ? 'desc' : 'asc';
                else ordenPlana = { clave: clave, dir: col.primerOrden || 'asc' };
                applyFilters();
            });

            $('#btnVistaSoloLineasExpendios').on('click', function () {
                vistaPlana = !vistaPlana;
                aplicarModoVista();
                applyFilters();
                try {
                    window.localStorage.setItem(config.claveVistaPlana, vistaPlana ? '1' : '0');
                } catch (e) {
                    // Solo es una comodidad (sin storage la proxima vez vuelve a las tarjetas); no se loguea.
                }
            });

            // Se recuerda el modo elegido para no volver siempre a las tarjetas.
            try {
                vistaPlana = window.localStorage.getItem(config.claveVistaPlana) === '1';
            } catch (e) {
                // localStorage no disponible (modo privado, datos bloqueados): arranca en tarjetas.
            }
            aplicarModoVista();

            loadData();
        })(window, window.jQuery, document);
    </script>
}
