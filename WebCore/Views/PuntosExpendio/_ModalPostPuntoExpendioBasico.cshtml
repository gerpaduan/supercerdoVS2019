@*
    UI de Expendios (ver docs/10-migracion-aspnet-core/PLAN-POS-EXPENDIOS-UI.md) -- version
    reducida y deliberada de Web/Views/PuntosExpendio/_ModalPostPuntoExpendio.cshtml (146 lineas:
    ticket ESC/POS con agente local, WhatsApp, configurar impresora). Mismo patron ya usado en
    Ventas/_ModalPostVentaBasico.cshtml (batch 6 del POS de Ventas): solo PDF (ImprimirPdf, ya
    portado) y Email (ObtenerDatosEmailExpendio/EnviarComprobanteEmailExpendio, ya portados).
*@
@* 2026-09-30 (pedido explicito del usuario): mismo esquema que el post-venta de Ventas -- opciones numeradas
   (1 Nuevo expendio, 2 Ticket, 3 PDF, 4 Email, 5 PDF lista de precios solo PRESUPUESTO). Elegir una cierra el
   modal y limpia la vista; el expendio ya esta guardado. Escape/click afuera NO limpian: la vista queda en el mismo
   expendio y Finalizar reabre este modal sin volver a guardar. Backdrop static (click afuera no cierra) y teclado
   habilitado (Escape cierra); Bootstrap 5 solo lee los data-bs-*. *@
<div class="modal fade" id="modalPostPuntoExpendioBasico" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-bs-backdrop="static" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content modal-postventa-compact">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title mb-0">
                    <i class="fas fa-check-circle mr-2"></i>Punto de expendio guardado
                </h5>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3" id="ppebResumen">Expendio registrado correctamente.</p>

                <div class="d-flex flex-column" style="gap:.5rem;">
                    <button type="button" class="btn btn-success" id="btnPpebContinuar">
                        <span class="badge badge-light mr-1">1</span>
                        <i class="fas fa-store mr-1"></i>Nuevo expendio
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btnPpebTicket">
                        <span class="badge badge-light mr-1">2</span>
                        <i class="fas fa-receipt mr-1"></i>Imprimir ticket
                    </button>
                    <div class="small text-muted" id="ppebTicketMedidaInfo" style="margin-top:-.35rem;">
                        Tamaño: <span id="ppebTicketMedidaTexto">80mm</span> ·
                        <a href="#" id="ppebTicketCambiarMedida">cambiar</a>
                    </div>
                    <a class="btn btn-outline-primary" id="btnPpebPdf" target="_blank" rel="noopener">
                        <span class="badge badge-light mr-1">3</span>
                        <i class="fas fa-file-pdf mr-1"></i>Ver / imprimir PDF
                    </a>
                    <button type="button" class="btn btn-outline-success" id="btnPpebEmail">
                        <span class="badge badge-light mr-1">4</span>
                        <i class="fas fa-envelope mr-1"></i>Enviar por email
                    </button>
                    @* Solo sector PRESUPUESTO (lo muestra punto-expendio-pos.js): variante del PDF con
                       la lista de precios sin cantidades ni totales (formato=precios). *@
                    <a class="btn btn-outline-primary d-none" id="btnPpebPdfPrecios" target="_blank" rel="noopener">
                        <span class="badge badge-light mr-1">5</span>
                        <i class="fas fa-tags mr-1"></i>PDF lista de precios (sin cantidades)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEmailPostPuntoExpendio" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content modal-postventa-compact">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Enviar comprobante por email</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @* Solo sector PRESUPUESTO: elige que PDF se adjunta (completo o lista de precios). *@
                <div class="form-group d-none" id="ppebEmailFormatoWrap">
                    <label for="ppebEmailFormato">PDF adjunto</label>
                    <select class="form-control" id="ppebEmailFormato">
                        <option value="completo">Completo (cantidades y totales)</option>
                        <option value="precios">Lista de precios (sin cantidades)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="ppebEmailDestino">Email destino</label>
                    <input type="email" class="form-control" id="ppebEmailDestino" maxlength="200" placeholder="cliente@dominio.com">
                </div>
                <div class="form-group">
                    <label for="ppebEmailAsunto">Asunto</label>
                    <input type="text" class="form-control" id="ppebEmailAsunto" maxlength="200">
                </div>
                <div class="form-group mb-0">
                    <label for="ppebEmailMensaje">Mensaje</label>
                    <textarea class="form-control" id="ppebEmailMensaje" rows="5"></textarea>
                </div>
                <div class="alert alert-danger d-none mb-0 mt-2" id="ppebEmailError"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" type="button" id="btnPpebConfirmarEmail">
                    <i class="fas fa-paper-plane mr-1"></i>Enviar email
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-postventa-compact {
        font-size: .86rem;
    }

    .modal-postventa-compact .modal-title {
        font-size: 1rem;
    }

    html.dark-mode .modal-postventa-compact label {
        color: #cbd8ea;
    }

    .modal-postventa-compact label {
        font-size: .78rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .18rem;
    }

    .modal-postventa-compact .form-control,
    .modal-postventa-compact .btn {
        min-height: 2.15rem;
        font-size: .84rem;
        padding: .28rem .56rem;
        border-radius: .5rem;
    }
</style>
