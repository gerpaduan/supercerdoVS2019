@model WebCore.Models.CompraIndexDetalleVm
@using System

@functions {
    // Resumen en un renglon de la compra vinculada / pesaje asociado para la tarjeta de celular:
    // "Proveedor · 11 medias · 504,00 kg" (se omite lo que no tenga dato).
    string StockRelacionadoResumen(string proveedor, int? medias, float? kgs)
    {
        var partes = new System.Collections.Generic.List<string>();
        if (!string.IsNullOrWhiteSpace(proveedor)) partes.Add(proveedor.Trim());
        if (medias.HasValue) partes.Add(medias.Value + " medias");
        if (kgs.HasValue) partes.Add(kgs.Value.ToString("N2") + " kg");
        return partes.Count == 0 ? "-" : string.Join(" · ", partes);
    }
}

@{
    string detalleError = ViewBag.StockDetalleError as string ?? "";
}

@if (!string.IsNullOrWhiteSpace(detalleError))
{
    <div class="text-danger">@detalleError</div>
}
else if (Model == null)
{
    <div class="text-muted">No se pudieron cargar los detalles del movimiento.</div>
}
else
{
    var referenciaPesaje = Model.IdPesajeRelacionado.HasValue ? Model.IdPesajeRelacionado.Value.ToString() : "";
    var referenciaAjuste = Model.IdAjusteRelacionado.HasValue ? Model.IdAjusteRelacionado.Value.ToString() : "";
    var observaciones = !string.IsNullOrWhiteSpace(Model.Observaciones) ? Model.Observaciones : "-";
    var usuarioCreacion = !string.IsNullOrWhiteSpace(Model.UsuarioCreacion) ? Model.UsuarioCreacion : "-";
    var fechaCreacion = Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var usuarioActualizacion = !string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) ? Model.UsuarioActualizacion : "-";
    var fechaActualizacion = Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var sucursalDetalle = !string.IsNullOrWhiteSpace(Model.Sucursal) ? Model.Sucursal : "-";
    var tipoDetalle = !string.IsNullOrWhiteSpace(Model.TipoCompra) ? Model.TipoCompra : "-";

    @* Celular (<768px, 2026-10-27): se oculta la tarjeta de datos del registro (abajo) porque repite lo de la tarjeta del
       movimiento; aca quedan las observaciones (si hay) y el boton Ver Porc(%) de los pesajes (mismo handler delegado por
       clase en Stock/Index.cshtml). Las lineas son una lista compacta (tabla-cards-lista). En desktop no cambia nada. *@
    if (!string.IsNullOrWhiteSpace(Model.Observaciones) || Model.EsPesaje)
    {
        <div class="cc-nota-detalle">
            <span>
                @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                {
                    <i class="fas fa-comment-alt"></i>@Model.Observaciones
                }
            </span>
            @if (Model.EsPesaje)
            {
                <button type="button" class="btn btn-sm btn-outline-info btn-ver-porcentaje-pesaje-index" data-id-compra="@Model.IdCompra">
                    <i class="fas fa-percent"></i>Ver Porc(%)
                </button>
            }
        </div>
    }

    <div class="row stock-detalle-layout">
        <div class="col-12 col-xl-8 order-2 order-xl-1">
            @if (Model.EsPesaje && Model.IdCompraVinculada.HasValue && Model.IdCompraVinculada.Value > 0)
            {
                <div class="stock-relacionado-box @(Model.CompraVinculadaEsPesaje ? "stock-relacionado-pesaje-padre" : "stock-relacionado-compra") mt-3">
                    <div class="small text-uppercase font-weight-bold mb-2">@(Model.CompraVinculadaEsPesaje ? "Pesaje padre vinculado #" : "Compra vinculada #")@Model.IdCompraVinculada.Value</div>
                    @if (!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada))
                    {
                        <div class="font-weight-bold">@Model.EstadoCompraVinculada</div>
                    }
                    else
                    {
                        <div class="stock-relacionado-resumen">@StockRelacionadoResumen(Model.ProveedorCompraVinculada, Model.CantMediasCompraVinculada, Model.KgsCompraVinculada)</div>
                        <div class="row stock-relacionado-grid">
                            <div class="col-12 col-md-3 mb-2 mb-md-0">
                                <div class="text-muted">Fecha de compra</div>
                                <div class="font-weight-bold">@(Model.FechaCompraVinculada.HasValue ? Model.FechaCompraVinculada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                            </div>
                            <div class="col-12 col-md-4 mb-2 mb-md-0">
                                <div class="text-muted">Proveedor</div>
                                <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorCompraVinculada) ? Model.ProveedorCompraVinculada : "-")</div>
                            </div>
                            <div class="col-6 col-md-2">
                                <div class="text-muted">Cant.Medias</div>
                                <div class="font-weight-bold">@(Model.CantMediasCompraVinculada.HasValue ? Model.CantMediasCompraVinculada.Value.ToString() : "-")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Kgs.Medias</div>
                                <div class="font-weight-bold">@(Model.KgsCompraVinculada.HasValue ? Model.KgsCompraVinculada.Value.ToString("N2") : "-")</div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue && Model.IdPesajeRelacionado.Value > 0)
            {
                <div class="stock-relacionado-box stock-relacionado-pesaje mt-3">
                    <div class="small text-uppercase font-weight-bold mb-2">Pesaje asociado #@Model.IdPesajeRelacionado.Value</div>
                    @if (!string.IsNullOrWhiteSpace(Model.EstadoPesajeRelacionado))
                    {
                        <div class="font-weight-bold">@Model.EstadoPesajeRelacionado</div>
                    }
                    else
                    {
                        <div class="stock-relacionado-resumen">@StockRelacionadoResumen(Model.ProveedorPesajeRelacionado, Model.CantMediasPesajeRelacionado, Model.KgsPesajeRelacionado)</div>
                        <div class="row stock-relacionado-grid">
                            <div class="col-12 col-md-3 mb-2 mb-md-0">
                                <div class="text-muted">Fecha del pesaje</div>
                                <div class="font-weight-bold">@(Model.FechaPesajeRelacionado.HasValue ? Model.FechaPesajeRelacionado.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                            </div>
                            <div class="col-12 col-md-4 mb-2 mb-md-0">
                                <div class="text-muted">Proveedor</div>
                                <div class="font-weight-bold">@(!string.IsNullOrWhiteSpace(Model.ProveedorPesajeRelacionado) ? Model.ProveedorPesajeRelacionado : "-")</div>
                            </div>
                            <div class="col-6 col-md-2">
                                <div class="text-muted">Cant.Medias</div>
                                <div class="font-weight-bold">@(Model.CantMediasPesajeRelacionado.HasValue ? Model.CantMediasPesajeRelacionado.Value.ToString() : "-")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Kgs.Medias</div>
                                <div class="font-weight-bold">@(Model.KgsPesajeRelacionado.HasValue ? Model.KgsPesajeRelacionado.Value.ToString("N2") : "-")</div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.EsPesaje && Model.PesajesHijosVinculadosIds != null && Model.PesajesHijosVinculadosIds.Count > 0)
            {
                <div class="stock-relacionado-box stock-relacionado-hijos mt-3">
                    <div class="small text-uppercase font-weight-bold mb-2">Pesajes vinculados a este (@Model.PesajesHijosVinculadosIds.Count)</div>
                    <div>
                        @foreach (var idHijo in Model.PesajesHijosVinculadosIds)
                        {
                            <span class="badge badge-pill badge-secondary mr-1 mb-1">#@idHijo</span>
                        }
                    </div>
                </div>
            }

            <div class="table-responsive mt-3 mt-xl-0">
                <table class="table table-sm table-hover mb-0 stock-detalle-tabla tabla-cards tabla-cards-lista">
                    <thead class="thead-light">
                        <tr>
                            <th>Codigo producto</th>
                            <th>Producto</th>
                            <th class="text-right">Cantidad / kg</th>
                            <th class="text-center">Balanza</th>
                            <th>Creado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lineas == null || Model.Lineas.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No hay lineas para este movimiento.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var linea in Model.Lineas)
                            {
                                var horaLinea = WebCore.Helpers.HoraLineaDetalle.Formatear(linea.CreadoTexto, Model.FechaCompra);
                                <tr>
                                    <td class="cc-l-cod"><span class="cc-solo-card">Cód. </span>@linea.Codigo</td>
                                    <td class="cc-l-prod">@linea.Producto</td>
                                    <td class="text-right cc-l-kg">@linea.CantidadKgTexto</td>
                                    @* Balanza: en celular un icono (azul = pesado en balanza, gris tenue = no); en desktop Si / -. *@
                                    <td class="text-center cc-l-bal cc-l-ultimo">
                                        <span class="cc-solo-tabla">@(linea.Balanza ? "Si" : "-")</span>
                                        <i class="cc-solo-card fas fa-balance-scale @(linea.Balanza ? "text-primary" : "cc-ico-off")" role="img"
                                           aria-label="@(linea.Balanza ? "Pesado en balanza" : "Sin balanza")"
                                           title="@(linea.Balanza ? "Pesado en balanza" : "Sin balanza")"></i>
                                    </td>
                                    @* Creado: en celular solo la hora, o fecha y hora en ambar si la linea se cargo otro dia que el registro. *@
                                    <td class="cc-l-hora @(horaLinea.OtroDia ? "cc-l-hora-otro-dia" : "") @(horaLinea.Texto == "" ? "cc-vacio" : "")">
                                        <span class="cc-solo-tabla">@(!string.IsNullOrWhiteSpace(linea.CreadoTexto) ? linea.CreadoTexto : "-")</span>
                                        <span class="cc-solo-card" title="@(horaLinea.OtroDia ? "Cargada otro día que el registro" : "Hora de carga")"><i class="far fa-clock"></i>@horaLinea.Texto</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-12 col-xl-4 order-1 order-xl-2">
            <div class="stock-detalle-meta-card">
                <div class="stock-detalle-meta-row"><span class="text-muted">ID del registro:</span> <span class="font-weight-bold">@Model.IdCompra</span></div>
                @if (Model.EsPesaje)
                {
                    <div class="stock-detalle-meta-row">
                        <button type="button"
                                class="btn btn-sm btn-outline-info btn-ver-porcentaje-pesaje-index"
                                data-id-compra="@Model.IdCompra">
                            <i class="fas fa-percent mr-1"></i> Ver Porc(%)
                        </button>
                    </div>
                }
                @if (Model.EsPesaje && Model.IdAjusteRelacionado.HasValue)
                {
                    <div class="stock-detalle-meta-row">
                        <span class="text-muted">Referencia:</span>
                        <span class="badge badge-pill badge-success ml-2">Aj. #@referenciaAjuste</span>
                    </div>
                }
                else if (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue)
                {
                    <div class="stock-detalle-meta-row">
                        <span class="text-muted">Referencia:</span>
                        <span class="badge badge-pill badge-info ml-2">Pesaje #@referenciaPesaje</span>
                    </div>
                }
                <div class="stock-detalle-meta-row"><span class="text-muted">Observaciones:</span> <span class="font-weight-bold">@observaciones</span></div>
                <div class="stock-detalle-meta-row"><span class="text-muted">Quien lo creo:</span> <span class="font-weight-bold">@usuarioCreacion</span></div>
                <div class="stock-detalle-meta-row"><span class="text-muted">Fecha de creacion:</span> <span class="font-weight-bold">@fechaCreacion</span></div>
                <div class="stock-detalle-meta-row"><span class="text-muted">Quien lo actualizo:</span> <span class="font-weight-bold">@usuarioActualizacion</span></div>
                <div class="stock-detalle-meta-row"><span class="text-muted">Fecha de actualizacion:</span> <span class="font-weight-bold">@fechaActualizacion</span></div>
                <div class="stock-detalle-meta-row"><span class="text-muted">Sucursal:</span> <span class="font-weight-bold">@sucursalDetalle</span></div>
                <div class="stock-detalle-meta-row mb-0"><span class="text-muted">Accion:</span> <span class="font-weight-bold">@tipoDetalle</span></div>
            </div>
        </div>
    </div>

    <style>
        .stock-detalle-layout {
            align-items: flex-start;
        }

        .stock-detalle-meta-card {
            border: 1px solid var(--ui-border, #dee2e6);
            border-radius: .5rem;
            background: var(--ui-surface, #fff);
            color: var(--ui-text, inherit);
            padding: .85rem .95rem;
        }

        .stock-detalle-meta-row {
            margin-bottom: .45rem;
            line-height: 1.2;
        }

        .stock-detalle-tabla thead th {
            font-size: .76rem;
            padding-top: .3rem;
            padding-bottom: .3rem;
        }

        .stock-relacionado-resumen {
            display: none;
        }

        @@media (max-width: 767.98px) {
            .stock-detalle-meta-card,
            .stock-relacionado-grid {
                display: none;
            }

            .stock-relacionado-resumen {
                display: block;
                font-size: .8rem;
            }

            /* Con el contenedor adelante: la regla base de .stock-relacionado-box vive en _StockTabla.cshtml y no hay que
               depender del orden en que se cargan los estilos. */
            .stock-detalle-layout .stock-relacionado-box {
                padding: .55rem .7rem;
            }

            .stock-detalle-layout .stock-relacionado-box > .small {
                margin-bottom: .2rem !important;
            }
        }

        @@media (min-width: 1200px) {
            .stock-detalle-meta-card {
                position: sticky;
                top: .25rem;
            }
        }
    </style>
}
