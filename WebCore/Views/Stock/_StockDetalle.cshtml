@model WebCore.Models.CompraIndexDetalleVm
@using System

@functions {
    // Resumen en un renglon de la compra vinculada / pesaje asociado:
    // "Proveedor · 11 medias · 504,00 kg" (se omite lo que no tenga dato).
    string StockRelacionadoResumen(string proveedor, int? medias, float? kgs)
    {
        var partes = new System.Collections.Generic.List<string>();
        if (!string.IsNullOrWhiteSpace(proveedor)) partes.Add(proveedor.Trim());
        if (medias.HasValue) partes.Add(medias.Value + " medias");
        if (kgs.HasValue) partes.Add(kgs.Value.ToString("N2") + " kg");
        return partes.Count == 0 ? "-" : string.Join(" · ", partes);
    }
}

@{
    string detalleError = ViewBag.StockDetalleError as string ?? "";
}

@if (!string.IsNullOrWhiteSpace(detalleError))
{
    <div class="text-danger">@detalleError</div>
}
else if (Model == null)
{
    <div class="text-muted">No se pudieron cargar los detalles del movimiento.</div>
}
else
{
    var observaciones = Model.Observaciones;
    var tieneObservaciones = !string.IsNullOrWhiteSpace(observaciones);
    var sucursalDetalle = !string.IsNullOrWhiteSpace(Model.Sucursal) ? Model.Sucursal : "-";
    var tipoDetalle = !string.IsNullOrWhiteSpace(Model.TipoCompra) ? Model.TipoCompra : "-";
    var fechaCreacion = Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm") : "";
    var fechaActualizacion = Model.FechaActualizacion.HasValue ? Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "";
    bool fueModificado = !string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) || fechaActualizacion != "";
    bool hayLineas = Model.Lineas != null && Model.Lineas.Count > 0;
    decimal totalKg = 0m;
    if (hayLineas)
    {
        foreach (var l in Model.Lineas) { totalKg += l.CantidadKg; }
    }

    @* Celular (<768px, 2026-10-27): la franja de chips (abajo) se oculta porque repite lo de la tarjeta del movimiento; aca quedan
       las observaciones (si hay) y el boton Ver Porc(%) de los pesajes (mismo handler delegado por clase en Stock/Index.cshtml).
       Las lineas son una lista compacta (tabla-cards-lista). *@
    if (tieneObservaciones || Model.EsPesaje)
    {
        <div class="cc-nota-detalle">
            <span>
                @if (tieneObservaciones)
                {
                    <i class="fas fa-comment-alt"></i>@observaciones
                }
            </span>
            @if (Model.EsPesaje)
            {
                <button type="button" class="btn btn-sm btn-outline-info btn-ver-porcentaje-pesaje-index" data-id-compra="@Model.IdCompra">
                    <i class="fas fa-percent"></i>Ver Porc(%)
                </button>
            }
        </div>
    }

    @* Desktop (2026-11-12, tabla-compacta.css): franja de chips con lo esencial en lugar de la tarjeta lateral de datos. *@
    <div class="det-head">
        <span class="det-chip chip-id"><i class="fas fa-hashtag"></i><b>@Model.IdCompra</b></span>
        <span class="det-chip" title="Sucursal"><i class="fas fa-store"></i><b>@sucursalDetalle</b></span>
        <span class="det-chip" title="Acción"><i class="fas fa-tag"></i><b>@tipoDetalle</b></span>
        @if (!string.IsNullOrWhiteSpace(Model.UsuarioCreacion) || fechaCreacion != "")
        {
            <span class="det-chip"><i class="fas fa-user-plus"></i><span class="k">Creó</span> <b>@(!string.IsNullOrWhiteSpace(Model.UsuarioCreacion) ? Model.UsuarioCreacion : "-")</b> <span class="k">@fechaCreacion</span></span>
        }
        @if (fueModificado)
        {
            <span class="det-chip chip-mod"><i class="fas fa-pen"></i><span class="k">Modificó</span> <b>@(!string.IsNullOrWhiteSpace(Model.UsuarioActualizacion) ? Model.UsuarioActualizacion : "-")</b> <span class="k">@fechaActualizacion</span></span>
        }
        <span class="det-spacer"></span>
        @if (Model.EsPesaje)
        {
            <button type="button" class="btn btn-sm btn-outline-info btn-ver-porcentaje-pesaje-index" data-id-compra="@Model.IdCompra">
                <i class="fas fa-percent mr-1"></i> Ver Porc(%)
            </button>
        }
    </div>

    @if (tieneObservaciones)
    {
        <div class="det-obs"><i class="fas fa-comment-alt"></i><div>@observaciones</div></div>
    }

    @* Cajas vinculadas: compra / pesaje padre, pesaje asociado (ajuste), ajuste relacionado y pesajes hijos. *@
    @if ((Model.EsPesaje && Model.IdCompraVinculada.HasValue && Model.IdCompraVinculada.Value > 0)
        || (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue && Model.IdPesajeRelacionado.Value > 0)
        || (Model.EsPesaje && Model.IdAjusteRelacionado.HasValue)
        || (Model.EsPesaje && Model.PesajesHijosVinculadosIds != null && Model.PesajesHijosVinculadosIds.Count > 0))
    {
        <div class="det-vinc">
            @if (Model.EsPesaje && Model.IdCompraVinculada.HasValue && Model.IdCompraVinculada.Value > 0)
            {
                <div class="det-caja">
                    <div class="t">@(Model.CompraVinculadaEsPesaje ? "Pesaje padre vinculado #" : "Compra vinculada #")@Model.IdCompraVinculada.Value</div>
                    @if (!string.IsNullOrWhiteSpace(Model.EstadoCompraVinculada))
                    {
                        <div class="r">@Model.EstadoCompraVinculada</div>
                    }
                    else
                    {
                        <div class="r">@StockRelacionadoResumen(Model.ProveedorCompraVinculada, Model.CantMediasCompraVinculada, Model.KgsCompraVinculada)</div>
                        <div class="f text-muted">@(Model.FechaCompraVinculada.HasValue ? Model.FechaCompraVinculada.Value.ToString("dd/MM/yyyy HH:mm") : "")</div>
                    }
                </div>
            }

            @if (Model.EsAjuste && Model.IdPesajeRelacionado.HasValue && Model.IdPesajeRelacionado.Value > 0)
            {
                <div class="det-caja">
                    <div class="t">Pesaje asociado #@Model.IdPesajeRelacionado.Value</div>
                    @if (!string.IsNullOrWhiteSpace(Model.EstadoPesajeRelacionado))
                    {
                        <div class="r">@Model.EstadoPesajeRelacionado</div>
                    }
                    else
                    {
                        <div class="r">@StockRelacionadoResumen(Model.ProveedorPesajeRelacionado, Model.CantMediasPesajeRelacionado, Model.KgsPesajeRelacionado)</div>
                        <div class="f text-muted">@(Model.FechaPesajeRelacionado.HasValue ? Model.FechaPesajeRelacionado.Value.ToString("dd/MM/yyyy HH:mm") : "")</div>
                    }
                </div>
            }

            @* El ajuste relacionado ya se ve como etiqueta "Aj. #" en la tarjeta de celular: la caja es solo de desktop. *@
            @if (Model.EsPesaje && Model.IdAjusteRelacionado.HasValue)
            {
                <div class="det-caja caja-ok det-solo-desk">
                    <div class="t">Ajuste relacionado</div>
                    <div class="r">Aj. #@Model.IdAjusteRelacionado.Value</div>
                </div>
            }

            @if (Model.EsPesaje && Model.PesajesHijosVinculadosIds != null && Model.PesajesHijosVinculadosIds.Count > 0)
            {
                <div class="det-caja">
                    <div class="t">Pesajes vinculados a este (@Model.PesajesHijosVinculadosIds.Count)</div>
                    <div>
                        @foreach (var idHijo in Model.PesajesHijosVinculadosIds)
                        {
                            <span class="badge badge-pill badge-secondary mr-1 mb-1">#@idHijo</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Lineas: columnas compactas (Cód. 15 · Producto 25 · Kg 8, ver tabla-compacta.css) y total al pie. *@
    <div class="det-lineas">
        <table class="table table-sm mb-0 tabla-cards tabla-cards-lista">
            <thead>
                <tr>
                    <th class="tc-cod">Cód.</th>
                    <th class="tc-prod">Producto</th>
                    <th class="text-right tc-kg">Cantidad / kg</th>
                    <th class="text-center tc-ico">Balanza</th>
                    <th class="tc-hora">Cargada</th>
                </tr>
            </thead>
            <tbody>
                @if (!hayLineas)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay lineas para este movimiento.</td>
                    </tr>
                }
                else
                {
                    foreach (var linea in Model.Lineas)
                    {
                        var horaLinea = WebCore.Helpers.HoraLineaDetalle.Formatear(linea.CreadoTexto, Model.FechaCompra);
                        <tr>
                            <td class="cc-l-cod tc-cod"><span class="cc-solo-card">Cód. </span>@linea.Codigo</td>
                            <td class="cc-l-prod tc-prod">@linea.Producto</td>
                            <td class="text-right cc-l-kg tc-kg">@linea.CantidadKgTexto</td>
                            @* Balanza: en celular un icono (azul = pesado en balanza, gris tenue = no); en desktop tambien icono. *@
                            <td class="text-center cc-l-bal cc-l-ultimo tc-ico">
                                <i class="fas fa-balance-scale @(linea.Balanza ? "text-primary" : "cc-ico-off")" role="img"
                                   aria-label="@(linea.Balanza ? "Pesado en balanza" : "Sin balanza")"
                                   title="@(linea.Balanza ? "Pesado en balanza" : "Sin balanza")"></i>
                            </td>
                            @* Creado: en celular solo la hora, o fecha y hora en ambar si la linea se cargo otro dia que el registro. *@
                            <td class="cc-l-hora tc-hora @(horaLinea.OtroDia ? "cc-l-hora-otro-dia" : "") @(horaLinea.Texto == "" ? "cc-vacio" : "")">
                                <span class="cc-solo-tabla">@(!string.IsNullOrWhiteSpace(linea.CreadoTexto) ? linea.CreadoTexto : "-")</span>
                                <span class="cc-solo-card" title="@(horaLinea.OtroDia ? "Cargada otro día que el registro" : "Hora de carga")"><i class="far fa-clock"></i>@horaLinea.Texto</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (hayLineas)
            {
                @* Total: suma de lo que muestra la columna (solo desktop; en celular el pie se oculta). *@
                <tfoot>
                    <tr>
                        <td colspan="2">Total · @Model.Lineas.Count línea@(Model.Lineas.Count == 1 ? "" : "s")</td>
                        <td class="tc-kg">@totalKg.ToString("N3")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
