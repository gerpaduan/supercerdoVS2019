@model Entidades.ExistenciaPorSucursalesVm
@using System
@using System.Globalization
@using System.Linq

@*
    Tabla de Existencia por sucursales (HTML parcial: la carga la vista y la reemplaza el Buscar por AJAX).
    Columnas: Cod. | Producto | [Stock | Estado | A pedir] por sucursal || ... || [Stock | Estado] Total | Total pedido | $ ult.
    compra | Importe est. | +. Una fila por producto (mas su detalle expandible). Las columnas del pedido ("A pedir", Total
    pedido, precio e importe) viajan siempre en el HTML pero estan ocultas hasta que se enciende "Ingresar pedido"
    (existencia-pedido.js las llena: el parcial solo deja el esqueleto y los datos que hacen falta en data-). Todos los
    estilos viven en ExistenciaPorSucursales.cshtml (este parcial es solo HTML): asi no se repiten en cada refresco. El
    ordenamiento, los filtros de la barra, el modo compacto y la edicion del punto de stock los hace el JS de la vista
    leyendo los atributos data- de cada fila. Estado de cada celda: Negocio.ExistenciaEstado (el estado de la consulta SQL
    usa el punto global legacy, no el real de la sucursal). Detalle: docs/DECISIONS.md 2026-10-19.
*@

@functions {
    // Numeros para atributos data-: invariantes (punto decimal) para que el JS los lea sin ambiguedad.
    private static string Inv(double valor)
    {
        return valor.ToString("R", CultureInfo.InvariantCulture);
    }

    // Textos y clases del estado: compartidos con las exportaciones (WebCore.Helpers.ExistenciaEstadoTextos).
    private static string TextoEstado(Negocio.ExistenciaEstado estado) => WebCore.Helpers.ExistenciaEstadoTextos.Texto(estado);
    private static string ClaseEstado(Negocio.ExistenciaEstado estado) => WebCore.Helpers.ExistenciaEstadoTextos.ClaseEstado(estado);
    private static string ClaseStock(Negocio.ExistenciaEstado estado) => WebCore.Helpers.ExistenciaEstadoTextos.ClaseStock(estado);
}

@{
    var columnas = Model != null ? Model.Columnas : new System.Collections.Generic.List<Entidades.SucursalColumnaStockVm>();
    var productos = Model != null ? Model.Productos : new System.Collections.Generic.List<Entidades.ProductoStockPorSucursalVm>();
    // Columna "Total" solo cuando se muestran 2 o mas sucursales: con una sola no hay nada que sumar. Suma solo las mostradas.
    bool mostrarTotal = Model != null && columnas.Count > 1;
    // El lapiz para editar el punto de stock solo aparece con el permiso de Productos (lo resuelve StockController).
    bool puedeEditarPunto = ViewBag.PuedeEditarPunto is bool permiso && permiso;
    // Columnas del <tr>: Cod. + Producto + 3 por sucursal (Stock + Estado + A pedir; Estado y A pedir siguen en el DOM aunque esten
    // ocultas) + 2 del Total + 3 del pedido (Total pedido, $ ult. compra, Importe est.) + el "+".
    // Cod. + Producto, 4 por sucursal (Stock/Estado/A pedir/Sugerido), Total (2), cierre del pedido (3), boton de detalle (1) y la columna de relleno (1).
    int totalColumnas = 2 + (columnas.Count * 4) + (mostrarTotal ? 2 : 0) + 3 + 1 + 1;
}

@if (Model == null || !Model.ConsultaRealizada)
{
    <div class="p-4 text-center text-muted">
        Presioná Buscar para consultar stock.
    </div>
}
else if (productos == null || productos.Count == 0)
{
    <div class="p-4 text-center text-muted">
        @(string.IsNullOrWhiteSpace(Model.Mensaje) ? "No se encontraron datos para los filtros seleccionados." : Model.Mensaje)
    </div>
}
else
{
    @* Sin la clase js-sync-scroll-body: la tabla scrollea por dentro con su propia barra (alto acotado por el JS de la vista), asi que la
       barra horizontal flotante de table-scroll-sync.js sobraba y quedaba duplicada. *@
    <div class="table-responsive tabla-full">
        <table class="table table-bordered table-hover mb-0 tabla-existencia-sucursales">
            <thead class="thead-light">
                <tr>
                    <th rowspan="2" class="ex-col-cod ex-sortable" data-sort-key="cod" title="Ordenar por código">Cód.</th>
                    <th rowspan="2" class="ex-col-prod ex-sortable" data-sort-key="nom" title="Ordenar por producto">Producto</th>
                    @for (int i = 0; i < columnas.Count; i++)
                    {
                        @* El colspan lo ajusta el JS segun las columnas visibles (Estado y A pedir se pueden ocultar). *@
                        <th colspan="2" class="ex-grupo ex-grupo-ini @(i % 2 == 1 ? "ex-alt" : "")" data-id-sucursal="@columnas[i].IdSucursal">
                            <span class="ex-grupo-nombre">@columnas[i].Sucursal</span>
                            <button type="button" class="btn btn-sm ex-btn-aceptar-suc ex-col-pedir" data-id-sucursal="@columnas[i].IdSucursal"
                                    title="Cargar las sugerencias de @columnas[i].Sucursal (solo los productos visibles)">
                                <i class="fas fa-magic"></i>
                            </button>
                        </th>
                    }
                    @if (mostrarTotal)
                    {
                        <th colspan="2" class="ex-grupo ex-grupo-ini ex-grupo-total">Total</th>
                    }
                    <th rowspan="2" class="ex-pedido-fin ex-grupo-ini ex-sortable ex-th-tp" data-sort-key="tp" title="Ordenar por el total pedido">Total pedido</th>
                    @* Precio e importe: ocultos hasta que el usuario enciende "Ver precios" (clase existencia-precios-on, ver la vista). *@
                    <th rowspan="2" class="ex-pedido-fin ex-col-precio" title="Precio de la última compra (por kg o unidad)">$ últ. compra</th>
                    <th rowspan="2" class="ex-pedido-fin ex-col-precio ex-sortable" data-sort-key="imp" title="Ordenar por el importe estimado">Importe est.</th>
                    <th rowspan="2" class="existencia-col-toggle"></th>
                    @* Relleno: absorbe el ancho que sobra para que ninguna otra columna se estire (todas quedan al ancho de su contenido). *@
                    <th rowspan="2" class="ex-col-relleno" aria-hidden="true"></th>
                </tr>
                <tr>
                    @for (int i = 0; i < columnas.Count; i++)
                    {
                        <th class="ex-sub ex-sortable ex-grupo-ini @(i % 2 == 1 ? "ex-alt" : "")" data-sort-key="s@(columnas[i].IdSucursal)" title="Ordenar por stock de @columnas[i].Sucursal">Stock</th>
                        <th class="ex-sub ex-sortable ex-col-estado @(i % 2 == 1 ? "ex-alt" : "")" data-sort-key="e@(columnas[i].IdSucursal)" title="Ordenar por estado en @columnas[i].Sucursal (primero los faltantes)">Estado</th>
                        <th class="ex-sub ex-sortable ex-col-pedir @(i % 2 == 1 ? "ex-alt" : "")" data-sort-key="p@(columnas[i].IdSucursal)" title="Ordenar por lo pedido a @columnas[i].Sucursal">A pedir</th>
                        @* Solo en el modo movimiento (ver la vista): lo que conviene enviar = consumo del periodo - stock. Lo llena existencia-movimiento.js. *@
                        <th class="ex-sub ex-sortable ex-col-sug @(i % 2 == 1 ? "ex-alt" : "")" data-sort-key="g@(columnas[i].IdSucursal)" title="Sugerido a enviar (ventas + uso en elaborados del período − stock): ordenar, primero el mayor">Sugerido</th>
                    }
                    @if (mostrarTotal)
                    {
                        <th class="ex-sub ex-sortable ex-grupo-ini ex-grupo-total" data-sort-key="st" title="Ordenar por stock total">Stock</th>
                        <th class="ex-sub ex-sortable ex-col-estado ex-grupo-total" data-sort-key="et" title="Ordenar por estado del total (primero los faltantes)">Estado</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in productos)
                {
                    string detailId = "detalleExistencia_" + producto.IdCorte;

                    // Estado de cada sucursal y del total, con el punto REAL de la sucursal.
                    var celdas = columnas.Select(c =>
                        producto.Celdas.FirstOrDefault(x => x.IdSucursal == c.IdSucursal)
                        ?? new Entidades.StockSucursalCeldaVm { IdSucursal = c.IdSucursal, Sucursal = c.Sucursal, EstadoStock = "SIN STOCK" }).ToList();
                    var estados = celdas.Select(c => Negocio.ExistenciaEstado.Calcular(c.StockActual, c.PuntoStock)).ToList();
                    double totalStock = celdas.Sum(c => (double)c.StockActual);
                    double totalPunto = celdas.Sum(c => (double)c.PuntoStock);
                    var estadoTotal = Negocio.ExistenciaEstado.Calcular(totalStock, totalPunto);

                    // Datos para ordenar y filtrar en el navegador (numeros invariantes; las claves son ids numericos, no hace falta escapar).
                    var atributos = new System.Text.StringBuilder();
                    for (int i = 0; i < columnas.Count; i++)
                    {
                        atributos.Append(" data-s-").Append(columnas[i].IdSucursal).Append("=\"").Append(Inv(celdas[i].StockActual)).Append("\"");
                        atributos.Append(" data-e-").Append(columnas[i].IdSucursal).Append("=\"").Append(Inv(estados[i].ClaveOrden)).Append("\"");
                    }
                    atributos.Append(" data-s-t=\"").Append(Inv(totalStock)).Append("\" data-e-t=\"").Append(Inv(estadoTotal.ClaveOrden)).Append("\"");
                    // Orden por lo pedido (Ingresar pedido): arrancan en 0 y existencia-pedido.js los mantiene al cargar cantidades.
                    for (int i = 0; i < columnas.Count; i++)
                    {
                        atributos.Append(" data-p-").Append(columnas[i].IdSucursal).Append("=\"0\"");
                    }
                    atributos.Append(" data-tp=\"0\" data-imp=\"0\"");
                    // Promedio por unidad (para el "= N un." del pedido): el del producto, que es el mismo en todas las sucursales.
                    double promedioProducto = celdas.Select(c => (double)c.Promedio).FirstOrDefault(p => p > 0);
                    bool productoPesable = celdas.Any(c => c.Pesable);
                    atributos.Append(" data-prom=\"").Append(Inv(promedioProducto)).Append("\" data-pes=\"").Append(productoPesable ? "1" : "0").Append("\"");
                    // Clases de estado presentes en alguna sucursal mostrada: alimentan el filtro "Estado" de la barra.
                    var clases = estados.Select(e => e.ClaseFiltro).Where(c => c.Length > 0).Distinct().ToList();
                    bool algunoSinPunto = estados.Any(e => e.SinPuntoCargado);

                    <tr class="existencia-producto-row"
                        data-detail-target="#@detailId"
                        data-texto="@producto.TextoBusqueda"
                        data-id-corte="@producto.IdCorte"
                        data-cod="@producto.Codigo"
                        data-nom="@producto.Corte"
                        data-clases="@string.Join(" ", clases)"
                        data-sinpto="@(algunoSinPunto ? "1" : "0")"
                        @Html.Raw(atributos.ToString())>
                        <td class="ex-col-cod-cell"><div class="ex-cod-txt" title="@producto.Codigo">@producto.Codigo</div></td>
                        <td class="ex-col-prod-cell">
                            <div class="existencia-producto-desc" title="@producto.Corte">@producto.Corte</div>
                        </td>
                        @for (int i = 0; i < columnas.Count; i++)
                        {
                            var celda = celdas[i];
                            var estado = estados[i];
                            string altClase = i % 2 == 1 ? "ex-alt" : "";
                            var equivalenteUnidades = Entidades.StockUnidadesHelper.FormatearEquivalenteUnidades((decimal)celda.StockActual, (decimal)celda.Promedio, celda.Pesable);

                            <td class="text-right text-nowrap ex-grupo-ini ex-col-stock @altClase @ClaseStock(estado)" title="@TextoEstado(estado)">
                                @celda.StockActual.ToString("N3")
                                @if (equivalenteUnidades != null)
                                {
                                    <span class="existencia-unidades">@equivalenteUnidades</span>
                                }
                            </td>
                            <td class="text-right text-nowrap ex-col-estado @altClase"
                                data-id-corte="@producto.IdCorte" data-id-sucursal="@celda.IdSucursal"
                                data-stock="@Inv(celda.StockActual)" data-punto="@Inv(celda.PuntoStock)">
                                <span class="ex-est @ClaseEstado(estado) js-ex-estado-texto">@TextoEstado(estado)</span>
                                <span class="existencia-unidades js-ex-pto">@(celda.PuntoStock > 0 ? "pto " + celda.PuntoStock.ToString("N0") : "")</span>
                                @if (puedeEditarPunto)
                                {
                                    <button type="button" class="ex-btn-pto" title="Editar el punto de stock de @columnas[i].Sucursal"
                                            data-nombre="@producto.Corte" data-sucursal="@columnas[i].Sucursal">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                }
                            </td>
                            @* A pedir (Ingresar pedido): el input y las pistas las arma existencia-pedido.js; aca queda el esqueleto. *@
                            <td class="text-right ex-col-pedir ex-pedir-cell @altClase" data-id-corte="@producto.IdCorte" data-id-sucursal="@celda.IdSucursal">
                                <div class="ex-ped-celda">
                                    <input type="text" inputmode="decimal" autocomplete="off" class="form-control form-control-sm ex-in-pedir"
                                           data-id-corte="@producto.IdCorte" data-id-sucursal="@celda.IdSucursal"
                                           aria-label="A pedir de @producto.Corte a @columnas[i].Sucursal" />
                                    <span class="ex-ped-eq"></span>
                                    <span class="ex-ped-hint"></span>
                                </div>
                            </td>
                            <td class="text-right ex-col-sug ex-sug-celda @altClase" data-id-corte="@producto.IdCorte" data-id-sucursal="@celda.IdSucursal"></td>
                        }
                        @if (mostrarTotal)
                        {
                            <td class="text-right text-nowrap ex-grupo-ini ex-grupo-total font-weight-bold" title="Suma de stock en las sucursales mostradas">
                                @totalStock.ToString("N3")
                            </td>
                            <td class="text-right text-nowrap ex-col-estado ex-grupo-total ex-estado-total" title="Total menos la suma de los puntos de stock de las sucursales mostradas">
                                <span class="ex-est js-ex-estado-texto @ClaseEstado(estadoTotal)">@TextoEstado(estadoTotal)</span>
                                <span class="existencia-unidades js-ex-pto">@(totalPunto > 0 ? "pto " + totalPunto.ToString("N0") : "")</span>
                            </td>
                        }
                        @* Cierre del pedido (Ingresar pedido): total pedido a todas las sucursales, precio de la ultima compra e importe estimado. *@
                        <td class="text-right text-nowrap ex-pedido-fin ex-grupo-ini ex-tp-cell">
                            <span class="ex-tp-cant font-weight-bold"></span>
                            <span class="ex-tp-eq"></span>
                        </td>
                        <td class="text-right text-nowrap ex-pedido-fin ex-col-precio ex-precio-cell"></td>
                        <td class="text-right text-nowrap ex-pedido-fin ex-col-precio ex-importe-cell font-weight-bold"></td>
                        <td class="text-center existencia-col-toggle-cell">
                            <button type="button" class="btn btn-link p-0 btn-toggle-existencia" data-target="#@detailId" title="Expandir detalle">
                                <i class="far fa-plus-square"></i>
                            </button>
                        </td>
                        <td class="ex-col-relleno" aria-hidden="true"></td>
                    </tr>
                    <tr id="@detailId" class="existencia-detalle-row d-none">
                        <td colspan="@totalColumnas" class="p-0">
                            <div class="p-3 border-top existencia-detalle-box">
                                <div class="existencia-producto-completo">
                                    <strong>@producto.Corte</strong> · cód. @producto.Codigo
                                </div>
                                <div class="table-responsive existencia-detalle-scroll-sync js-sync-scroll-body">
                                    <table class="table table-sm table-bordered mb-0 existencia-detalle-tabla">
                                        <thead class="thead-light">
                                            <tr>
                                                <th class="existencia-detalle-destacado">Sucursal</th>
                                                <th title="FechaUltimoCierre">F. Cierre</th>
                                                <th class="text-right existencia-detalle-destacado" title="StockInicial">St. Ini.</th>
                                                <th class="text-right">Compras</th>
                                                <th class="text-right" title="IngresoElaborado">Ing. Elab.</th>
                                                <th class="text-right" title="IngresoStock">Ing. Stock</th>
                                                <th class="text-right" title="IngresoMovimiento">Ing. Mov.</th>
                                                <th class="text-right" title="AjusteStock">Ajuste</th>
                                                <th class="text-right existencia-detalle-destacado" title="TotalIngresos">Tot. Ing.</th>
                                                <th class="text-right" title="EgresoStock">Egr. Stock</th>
                                                <th class="text-right" title="EgresoMovimiento">Egr. Mov.</th>
                                                <th class="text-right" title="EgresoElaborado">Egr. Elab.</th>
                                                <th class="text-right">Ventas</th>
                                                <th class="text-right existencia-detalle-destacado" title="TotalEgresos">Tot. Egr.</th>
                                                <th class="text-right existencia-detalle-stockactual" title="StockActual">Stock Act.</th>
                                                <th title="Estado según el punto de stock de la sucursal">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detalle in producto.Detalles.OrderBy(x => x.Sucursal))
                                            {
                                                var estadoDetalle = Negocio.ExistenciaEstado.Calcular(detalle.StockActual, detalle.PuntoStock);
                                                <tr>
                                                    <td class="existencia-detalle-destacado">@detalle.Sucursal</td>
                                                    <td>@(detalle.FechaUltimoCierre.HasValue ? detalle.FechaUltimoCierre.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                                    <td class="text-right existencia-detalle-destacado">@detalle.StockInicial.ToString("N3")</td>
                                                    <td class="text-right">@detalle.Compras.ToString("N3")</td>
                                                    <td class="text-right">@detalle.IngresoElaborado.ToString("N3")</td>
                                                    <td class="text-right">@detalle.IngresoStock.ToString("N3")</td>
                                                    <td class="text-right">@detalle.IngresoMovimiento.ToString("N3")</td>
                                                    <td class="text-right">@detalle.AjusteStock.ToString("N3")</td>
                                                    <td class="text-right existencia-detalle-destacado">@detalle.TotalIngresos.ToString("N3")</td>
                                                    <td class="text-right">@detalle.EgresoStock.ToString("N3")</td>
                                                    <td class="text-right">@detalle.EgresoMovimiento.ToString("N3")</td>
                                                    <td class="text-right">@detalle.EgresoElaborado.ToString("N3")</td>
                                                    <td class="text-right">@detalle.Ventas.ToString("N3")</td>
                                                    <td class="text-right">@detalle.TotalEgresos.ToString("N3")</td>
                                                    <td class="text-right existencia-detalle-stockactual @ClaseStock(estadoDetalle)">@detalle.StockActual.ToString("N3")</td>
                                                    <td class="@ClaseEstado(estadoDetalle)">@TextoEstado(estadoDetalle)@(detalle.PuntoStock > 0 ? " · pto " + detalle.PuntoStock.ToString("N0") : "")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
