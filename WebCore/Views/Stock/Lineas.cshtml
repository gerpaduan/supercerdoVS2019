@Html.Partial("~/Views/Elaborados/_Styles.cshtml")
@Html.Partial("~/Views/Shared/_LineasAgrupadasStyles.cshtml")
@Html.Partial("~/Views/Shared/_FiltrosCompactosStyles.cshtml")

<style>
    /* Fila unica de escritorio (_FiltrosCompactosStyles): desde, hasta (datetime-local con segundos: ancho fijo), sucursal,
       producto (flexible), tipo de operacion y Buscar. */
    .stock-lineas-top .elaborados-filtros-card {
        --fc-cols: 13rem 13rem minmax(6.5rem, 9rem) minmax(8rem, 1fr) 8rem 5.5rem;
    }

    @@media (min-width: 1200px) {
        /* Los estilos propios de la pantalla (.container-fluid[data-lineas-agrupadas-page] ...) tienen mas especificidad que
           los de .fc-*: se repiten aca con un nivel mas para que la barra compacta gane. */
        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .stock-lineas-top > * {
            margin-bottom: 0 !important;
        }

        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .fc-card .card-body {
            padding: .5rem .65rem;
        }

        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .fc-card .form-control,
        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .fc-card .btn {
            height: 1.95rem;
            min-height: 1.95rem;
            font-size: .84rem;
            padding: .15rem .5rem;
            line-height: 1.2;
        }

        /* Volver al indice: misma altura que los campos y botones de la fila de filtros (por defecto un boton mide ~2.4rem). */
        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .fc-acciones .btn {
            height: 1.95rem;
            min-height: 1.95rem;
            font-size: .84rem;
            padding: .15rem .6rem;
            line-height: 1.2;
        }

        /* Totales: las 4 tarjetas pasan de una grilla de 4 columnas a una fila de chips (etiqueta + valor) en la barra. */
        body.app-shell .stock-lineas-top > .stock-lineas-totales {
            order: 1;
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: .4rem;
        }

        body.app-shell .container-fluid[data-lineas-agrupadas-page="stock"] .stock-lineas-totales .lineas-resumen-card .card-body {
            display: flex;
            align-items: baseline;
            gap: .45rem;
            padding: .28rem .65rem !important;
        }

        body.app-shell .stock-lineas-totales .lineas-resumen-card .card-body > * {
            margin: 0 !important;
            white-space: nowrap;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('.js-form-filtros-lineas');
            if (!form) return;

            var inputSucursal = document.getElementById('idSucursalStockLineas');
            var inputFechaDesde = document.getElementById('fechaDesdeStockLineas');
            var inputFechaHasta = document.getElementById('fechaHastaStockLineas');
            var alerta = document.getElementById('alertaFiltrosPendientes');
            var estado = document.getElementById('estadoBusquedaStockLineas');
            var btnBuscar = document.getElementById('btnBuscarStockLineas');
            var btnTexto = btnBuscar ? btnBuscar.querySelector('.btn-buscar-texto') : null;
            var nativeFormSubmit = window.HTMLFormElement && window.HTMLFormElement.prototype
                ? window.HTMLFormElement.prototype.submit
                : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
            };

            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === 'function') {
                    window.ModalRequestLoading.trackNavigation(message || 'Cargando solicitud...');
                }
            }

            function submitConLoader() {
                showNavigationLoading('Cargando solicitud...');
                window.setTimeout(function () {
                    if (nativeFormSubmit) {
                        nativeFormSubmit.call(form);
                    } else {
                        form.submit();
                    }
                }, 40);
            }

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            var textoEstadoOk = estado ? estado.textContent : '';
            var textoEstadoPendiente = 'Cambiaste las fechas: tocá Buscar para actualizar.';

            // Fechas cambiadas sin aplicar: en pantalla angosta se muestra la alerta amarilla; en escritorio (la alerta esta
            // oculta por CSS) el aviso es el texto de estado y el boton Buscar en ambar.
            function actualizarAviso() {
                var pendiente = hayFechasPendientes();
                if (alerta) alerta.classList.toggle('d-none', !pendiente);
                if (btnBuscar) {
                    btnBuscar.classList.toggle('btn-warning', pendiente);
                    btnBuscar.classList.toggle('btn-outline-primary', !pendiente);
                }
                if (estado) {
                    estado.textContent = pendiente ? textoEstadoPendiente : textoEstadoOk;
                    estado.title = pendiente ? textoEstadoPendiente : '';
                    estado.classList.toggle('fc-estado-pendiente', pendiente);
                }
            }

            function setBuscando(mensaje) {
                if (btnBuscar) btnBuscar.disabled = true;
                if (btnTexto) btnTexto.textContent = ' Cargando...';
                if (estado) estado.textContent = mensaje || 'Actualizando búsqueda...';
            }

            function enviarEnVivo() {
                setBuscando('Actualizando búsqueda en vivo...');

                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                }

                submitConLoader();
            }

            if (inputFechaDesde) {
                inputFechaDesde.addEventListener('change', actualizarAviso);
            }

            if (inputFechaHasta) {
                inputFechaHasta.addEventListener('change', actualizarAviso);
            }

            if (inputSucursal) {
                inputSucursal.addEventListener('change', enviarEnVivo);
            }

            form.addEventListener('submit', function (event) {
                if (form.dataset.loadingSubmitPending === 'true') {
                    form.dataset.loadingSubmitPending = '';
                    return;
                }

                event.preventDefault();
                fechasAplicadas = {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : '',
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : ''
                };
                actualizarAviso();
                setBuscando('Actualizando búsqueda...');
            });
            form.addEventListener('submit', function (event) {
                if (form.dataset.loadingSubmitPending === 'true') {
                    return;
                }

                event.preventDefault();
                form.dataset.loadingSubmitPending = 'true';
                submitConLoader();
            });
        })();
    </script>
    <script src="@Url.Content("~/Scripts/app/lineas-agrupadas.js")" asp-append-version="true"></script>
}
