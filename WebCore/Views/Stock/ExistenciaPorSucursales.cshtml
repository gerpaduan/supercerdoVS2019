@model Entidades.ExistenciaPorSucursalesVm
@using System
@using System.Linq

@*
    Existencia por sucursales: stock y estado de cada producto, una sucursal por grupo de columnas.
    Barra de una sola linea (modo compacto, recordado por navegador) con filtros avanzados plegados, tabla ordenable y
    autoactualizacion encendida desde que se abre. La tabla la arma _TablaExistenciaPorSucursales.cshtml; toda la logica del
    navegador (orden, filtros, compacto, autoactualizar, editar punto de stock, exportar) esta en
    Scripts/app/existencia-sucursales.js. Reglas y porques: docs/DECISIONS.md 2026-10-19 y
    docs/11-manual-de-uso/pantallas/Stock.ExistenciaPorSucursales.md.
*@

@{
    ViewBag.Title = "Existencia por sucursales";

    var filtro = Model != null ? Model.Filtro : new Entidades.ExistenciaStockPorSucursalFiltroVm();
    string fechaHasta = filtro.FechaHasta.HasValue ? filtro.FechaHasta.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    string fechaMinima = filtro.FechaMinimaConsulta.HasValue ? filtro.FechaMinimaConsulta.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    // TODO(claude): el original lee Session["Usuario"].Empresa.Cuit para elegir el intervalo de
    // autoactualizacion (15 min para la empresa real con CUIT 20306210786, 30 para el resto). Sin
    // sesion real, se verifico contra la base local (empresa id=1, la del stub de WebCore) que
    // ese CUIT SI coincide -- se hardcodea directamente a 15 en vez de reproducir el chequeo
    // (mismo resultado observable para el usuario de prueba de todo el juez de paridad).
    int intervaloAutoMinutos = 15;

    // Modo ventana independiente (?popup=true): layout minimo sin sidebar/topbar, el mismo patron que
    // Productos/AddOrEdit?embed=true. Se abre desde el boton "Abrir en ventana" de la vista normal.
    bool popup = ViewBag.Popup is bool esPopup && esPopup;
    if (popup)
    {
        Layout = "~/Views/Shared/_LayoutEmbed.cshtml";
    }

    // "Con movimiento" usa la actividad de "Que pedir": solo Postgres. Los limites de la autoactualizacion salen de App.config.
    bool movimientoDisponible = ViewBag.MovimientoDisponible is bool md && md;
    int jitterInicialMaxSegundos = ViewBag.JitterInicialMaxSegundos is int jit ? jit : 0;
    int reintentoCargaSegundos = ViewBag.ReintentoCargaSegundos is int rei ? rei : 120;

    // "Ingresar pedido": sugerencias y precios salen de la actividad de "Que pedir" (solo Postgres); el autoguardado usa los borradores
    // en servidor (modulo PEDIDO_STOCK) cuando estan habilitados. Datos del operador y de la sucursal del borrador: StockController.
    bool pedidoDisponible = ViewBag.PedidoDisponible is bool pd && pd;
    bool pedidoBorradorHabilitado = ViewBag.PedidoBorradorHabilitado is bool pbh && pbh;
    var modalBorradoresData = new ViewDataDictionary(ViewData);
    modalBorradoresData["TituloBorradoresGenerico"] = "Pedidos sin guardar";

    bool todasTildadas = filtro.IdsSucursales == null || filtro.IdsSucursales.Count == 0;

    // Desplegables de seleccion multiple de los filtros avanzados (Tipos / Proveedores / Marcas): sin nada tildado = sin filtro.
    var desplegables = new[]
    {
        new { Clave = "tipos", Etiqueta = "Tipos", Campo = "tipos", Singular = "tipo", Plural = "tipos",
              // La lista de tipos trae una fila "Todos" propia de la grilla de tipos: aca "Todos" es el tilde de arriba, no un tipo.
              Items = filtro.TiposDisponibles.Where(t => !string.Equals((t ?? "").Trim(), "Todos", StringComparison.OrdinalIgnoreCase))
                  .Select(t => new { Valor = t, Texto = t }).ToList() },
        new { Clave = "proveedores", Etiqueta = "Proveedores", Campo = "idsProveedores", Singular = "proveedor", Plural = "proveedores",
              Items = filtro.ProveedoresDisponibles.Select(p => new { Valor = p.IdPersona.ToString(), Texto = p.RazonSocial }).ToList() },
        new { Clave = "marcas", Etiqueta = "Marcas", Campo = "idsMarcas", Singular = "marca", Plural = "marcas",
              Items = filtro.MarcasDisponibles.Select(m => new { Valor = m.IdPersona.ToString(), Texto = m.RazonSocial }).ToList() }
    };
}

<div class="container-fluid existencia-sucursales-page" id="existenciaPage">
    @* Antes de pintar el resto: aplica el modo compacto recordado (sin parpadeo del diseno normal). Mismo criterio que usa el JS
       de la pantalla; la ventana independiente tiene su propia clave y arranca compacta. *@
    <script>
        (function () {
            try {
                var esPopup = @(popup ? "true" : "false");
                var guardado = localStorage.getItem(esPopup ? "existenciaCompactoPopup" : "existenciaCompacto");
                var compacto = guardado === null ? esPopup : guardado === "1";
                if (compacto) document.getElementById("existenciaPage").classList.add("existencia-compacto");
            } catch (e) {
                if (@(popup ? "true" : "false")) document.getElementById("existenciaPage").classList.add("existencia-compacto");
            }
        })();
    </script>

    @if (popup)
    {
        // _LayoutEmbed no tiene barra superior: el titulo de la pantalla se muestra aca.
        <h5 class="existencia-popup-titulo mb-2">Existencia por sucursales</h5>
    }

    @* Token para los POST de esta pantalla (editar punto de stock, exportar): _LayoutEmbed no trae el global del layout normal. *@
    @Html.AntiForgeryToken()

    <div class="card shadow-sm ex-card">
        <div class="card-body ex-barra-wrap">
            <form id="formExistenciaSucursales" autocomplete="off">
                <div class="ex-barra">
                    @* Interruptor GRANDE (no un chip chico): al encenderlo cada sucursal gana la columna "A pedir". Apagado = solo contorno,
                       encendido = relleno de color; toda la etiqueta es clickeable. Lo maneja Scripts/app/existencia-pedido.js. *@
                    <div class="ex-ctl ex-ctl-pedido">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-pedido-toggle">
                            <input type="checkbox" class="ex-chip-input" id="switchPedidoExistencia" />
                            <label class="ex-pedido-toggle-texto" for="switchPedidoExistencia"
                                   title="Cargar cantidades a pedir por sucursal, con sugerencias según el consumo del período">
                                <i class="fas fa-clipboard-list ex-pt-ico-off" aria-hidden="true"></i>
                                <i class="fas fa-clipboard-check ex-pt-ico-on" aria-hidden="true"></i>
                                <span>Ingresar pedido</span>
                            </label>
                        </span>
                    </div>
                    @if (pedidoBorradorHabilitado)
                    {
                        @* Pedidos que quedaron a medio cargar (corte de luz, cierre del navegador): visible aunque el modo pedido este apagado. *@
                        <div class="ex-ctl">
                            <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                            <button type="button" class="btn btn-outline-secondary" id="btnVerBorradoresPedido"
                                    title="Pedidos que quedaron a medio cargar (corte de luz, cierre del navegador)">
                                <i class="fas fa-history"></i><span class="ex-btn-texto ml-1">Borradores sin guardar</span>
                                <span id="badgeBorradoresGenerico" class="badge badge-warning d-none ml-1">0</span>
                            </button>
                        </div>
                    }

                    <div class="ex-ctl ex-ctl-sucursales">
                        <label class="ex-lbl" for="btnSucursalesExistencia">Sucursales</label>
                        <!-- Seleccion multiple: una, varias o todas. Los checkboxes viajan en el form como idsSucursales
                             repetido (vacio de tildadas no se permite, ver script). -->
                        <div class="dropdown ui-multiselect">
                            <button type="button" id="btnSucursalesExistencia" class="btn dropdown-toggle ui-multiselect-toggle"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                <span id="lblSucursalesExistencia">Todas</span>
                            </button>
                            <div class="dropdown-menu" id="menuSucursalesExistencia">
                                <div class="custom-control custom-checkbox ui-multiselect-todas">
                                    <input type="checkbox" class="custom-control-input" id="chkSucursalTodasExistencia" @(todasTildadas ? "checked" : null)>
                                    <label class="custom-control-label" for="chkSucursalTodasExistencia">Todas</label>
                                </div>
                                <div class="dropdown-divider"></div>
                                @foreach (var sucursal in filtro.SucursalesDisponibles)
                                {
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input chk-sucursal-existencia" name="idsSucursales"
                                               id="chkSucursalExistencia_@sucursal.IdSucursal" value="@sucursal.IdSucursal"
                                               data-nombre="@sucursal.Sucursal"
                                               @((todasTildadas || filtro.IdsSucursales.Contains(sucursal.IdSucursal)) ? "checked" : null)>
                                        <label class="custom-control-label" for="chkSucursalExistencia_@sucursal.IdSucursal">@sucursal.Sucursal</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="ex-ctl ex-ctl-texto">
                        <label class="ex-lbl" for="filtroTextoExistencia">Producto</label>
                        <div class="ex-input-icon">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input type="search" id="filtroTextoExistencia" name="texto" class="form-control"
                                   placeholder="Producto o código" autocomplete="off" />
                        </div>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <!-- Fecha hasta ya no se elige a mano: siempre se recalcula a la fecha/hora exacta del momento de la
                             busqueda (manual o autoactualizada, ver el submit del form en el script). Viaja oculta. -->
                        <input type="hidden" id="filtroFechaHastaExistencia" name="fechaHasta" value="@fechaHasta" min="@fechaMinima" />
                        <button type="submit" class="btn btn-primary" id="btnBuscarExistencia" title="Buscar (actualiza el stock ahora)">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto">Buscar</span>
                        </button>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl" for="filtroClaseEstadoExistencia">Estado</label>
                        <select id="filtroClaseEstadoExistencia" class="form-control" title="Mostrar solo los productos con este estado en alguna de las sucursales">
                            <option value="todos">Todos los estados</option>
                            <option value="bien">Bien (OK)</option>
                            <option value="falta">Faltantes</option>
                            <option value="sinpto">Punto de stock 0</option>
                        </select>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <button type="button" class="btn btn-outline-secondary" id="btnFiltrosAvanzadosExistencia" aria-expanded="false"
                                aria-controls="panelFiltrosAvanzadosExistencia" title="Tipos, proveedores, marcas y movimiento">
                            <i class="fas fa-sliders-h mr-1"></i>Filtros<span id="badgeFiltrosExistencia" class="badge badge-primary ml-1 d-none">0</span>
                        </button>
                    </div>

                    <span class="ex-sep d-none d-lg-block"></span>

                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Actualiza el stock cada @intervaloAutoMinutos minutos, hasta 6 veces">
                            <input type="checkbox" class="ex-chip-input" id="switchAutoActualizarExistencia" />
                            <label class="ex-chip-texto" for="switchAutoActualizarExistencia"><i class="fas fa-sync-alt mr-1"></i>Auto <span id="lblAutoChipExistencia" class="ex-chip-detalle"></span></label>
                        </span>
                    </div>
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Mostrar la columna Estado (faltante, punto de stock)">
                            <input type="checkbox" class="ex-chip-input" id="switchEstadoStockExistencia" checked />
                            <label class="ex-chip-texto" for="switchEstadoStockExistencia">Estado</label>
                        </span>
                    </div>
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Expandir el detalle de todos los productos">
                            <input type="checkbox" class="ex-chip-input" id="switchExpandirExistencia" />
                            <label class="ex-chip-texto" for="switchExpandirExistencia">Expandir</label>
                        </span>
                    </div>
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Diseño compacto: filas de una línea y barra reducida (se recuerda en este navegador)">
                            <input type="checkbox" class="ex-chip-input" id="switchCompactoExistencia" />
                            <label class="ex-chip-texto" for="switchCompactoExistencia"><i class="fas fa-compress-alt mr-1"></i>Compacto</label>
                        </span>
                    </div>

                    <span class="ex-grow"></span>

                    <div class="ex-ctl ex-ctl-acciones">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary" id="btnExcelExistencia" title="Exportar a Excel lo que se ve (filtros y orden actuales)">
                                <i class="far fa-file-excel"></i><span class="ex-btn-texto ml-1">Excel</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnPdfExistencia" title="Exportar a PDF lo que se ve (filtros y orden actuales)">
                                <i class="far fa-file-pdf"></i><span class="ex-btn-texto ml-1">PDF</span>
                            </button>
                            @if (!popup)
                            {
                                <button type="button" class="btn btn-outline-secondary" id="btnAbrirVentanaExistencia"
                                        title="Abrir esta pantalla en una ventana independiente, sin menús">
                                    <i class="fas fa-external-link-alt"></i><span class="ex-btn-texto ml-1">Ventana</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="ex-avanzados d-none" id="panelFiltrosAvanzadosExistencia">
                    @foreach (var d in desplegables)
                    {
                        <div class="ex-ctl ex-ctl-ms">
                            <label class="ex-lbl-fijo">@d.Etiqueta</label>
                            <div class="dropdown ui-multiselect ex-ms" data-ms="@d.Clave" data-singular="@d.Singular" data-plural="@d.Plural">
                                <button type="button" class="btn dropdown-toggle ui-multiselect-toggle" data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <span class="ex-ms-resumen">Todos</span>
                                </button>
                                <div class="dropdown-menu ex-ms-menu">
                                    <input type="search" class="form-control form-control-sm ex-ms-buscar" placeholder="Buscar…" autocomplete="off" />
                                    <div class="custom-control custom-checkbox ui-multiselect-todas">
                                        <input type="checkbox" class="custom-control-input ex-ms-todos" id="chkTodos_@d.Clave" checked>
                                        <label class="custom-control-label" for="chkTodos_@d.Clave">Todos</label>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <div class="ex-ms-lista">
                                        @for (int i = 0; i < d.Items.Count; i++)
                                        {
                                            <div class="custom-control custom-checkbox ex-ms-item" data-texto="@d.Items[i].Texto.ToLowerInvariant()">
                                                <input type="checkbox" class="custom-control-input ex-ms-chk" name="@d.Campo" value="@d.Items[i].Valor"
                                                       data-nombre="@d.Items[i].Texto" id="chk_@(d.Clave)_@i">
                                                <label class="custom-control-label" for="chk_@(d.Clave)_@i">@d.Items[i].Texto</label>
                                            </div>
                                        }
                                        @if (d.Items.Count == 0)
                                        {
                                            <div class="text-muted small px-2 py-1">No hay opciones cargadas.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="ex-ctl ex-ctl-periodo">
                        <label class="ex-lbl-fijo" for="filtroPeriodoDesdeExistencia">Período desde</label>
                        <div class="ex-periodo">
                            <input type="date" id="filtroPeriodoDesdeExistencia" name="periodoDesde" class="form-control" />
                            <span class="ex-periodo-atajos">
                                @foreach (var dias in new[] { 7, 15, 30, 60, 90, 180, 365 })
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm ex-periodo-dias" data-dias="@dias" title="Desde hace @dias días">@(dias)&nbsp;d</button>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="ex-ctl ex-ctl-movimiento">
                        <label class="ex-lbl-fijo">Con movimiento</label>
                        <div class="ex-movimiento" title="@(movimientoDisponible ? "" : "No disponible con este motor de datos")">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="chkConMovimientoExistencia" name="conMovimiento" value="true"
                                       @(movimientoDisponible ? null : "disabled")>
                                <label class="custom-control-label" for="chkConMovimientoExistencia">Solo con al menos</label>
                            </div>
                            <input type="number" id="filtroMovimientoMinimoExistencia" name="movimientoMinimo" class="form-control ex-mov-min"
                                   min="0.001" step="any" value="1" disabled />
                            <select id="filtroMovimientoMedidaExistencia" name="movimientoMedida" class="form-control ex-mov-medida" disabled>
                                <option value="salidas">Salidas (kg/un.)</option>
                                <option value="dias">Días con venta</option>
                            </select>
                        </div>
                        <div class="ex-ayuda">
                            @if (movimientoDisponible)
                            {
                                <text><b>Salidas</b> = ventas + uso en elaborados, desde la fecha del período hasta ahora. <b>Días con venta</b> cuenta solo ventas. Cumple si alguna sucursal mostrada alcanza el mínimo.</text>
                            }
                            else
                            {
                                <text>No disponible con este motor de datos (solo Postgres).</text>
                            }
                        </div>
                    </div>
                </div>
            </form>

            @* ---------- Barra del pedido (solo visible con "Ingresar pedido" encendido) ---------- *@
            <div class="ex-pedido-barra d-none" id="barraPedidoExistencia">
                <div class="ex-pedido-leyenda">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span id="lblLeyendaPedidoExistencia">Cargando sugerencias…</span>
                    <a href="#" id="lnkCambiarPeriodoPedido" class="ml-1">Cambiar</a>
                    <span class="ex-pedido-ayuda ml-1" id="lblAyudaPedidoExistencia" tabindex="0" role="note"
                          title="La sugerencia se calcula por sucursal: consumo del período (lo vendido más lo que se usó en elaborados desde la fecha elegida) menos el stock actual. Si el stock alcanza se avisa «stock suficiente». Ejemplo, pedidos cada 30 días: período desde hoy − 30; si se vendieron 80,500 y se usaron 12,000 en elaborados (92,500) y hay 40,000 de stock, se sugiere pedir 52,500. Las sugerencias no se cargan solas: las aceptás vos. Si el stock es negativo se toma como 0.">
                        <i class="far fa-question-circle" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="ex-pedido-acciones">
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo" for="selSugerirSegunExistencia">Sugerir según</label>
                        <select id="selSugerirSegunExistencia" class="form-control">
                            <option value="consumo">Consumo − stock</option>
                            <option value="punto">Hasta el punto de stock</option>
                            <option value="mayor">El mayor de los dos</option>
                        </select>
                    </div>
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo">&nbsp;</label>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-primary" id="btnAceptarTodasExistencia"
                                    title="Cargar las sugerencias en las celdas de todas las sucursales (solo los productos que se ven)">
                                <i class="fas fa-magic mr-1"></i>Aceptar sugerencias
                            </button>
                            <button type="button" class="btn btn-outline-warning" id="btnCompletarPuntoExistencia"
                                    title="Cargar «hasta el punto de stock» solo en las celdas que están bajo el punto">
                                <i class="fas fa-bullseye mr-1"></i>Completar bajo el punto <span id="lblCantBajoPuntoExistencia">(0)</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarPedidoExistencia" title="Borrar todas las cantidades cargadas">
                                <i class="fas fa-eraser mr-1"></i>Limpiar
                            </button>
                        </div>
                    </div>
                    <span class="ex-grow"></span>
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo">&nbsp;</label>
                        <button type="button" class="btn btn-primary" id="btnGuardarPedidoExistencia" disabled
                                title="Revisar el pedido antes de guardarlo (muestra solo los productos con cantidad)">
                            <i class="fas fa-save mr-1"></i>Guardar pedido <span id="lblContadorPedidoExistencia" class="ex-pedido-contador">(0 productos)</span>
                        </button>
                    </div>
                </div>
                <div class="ex-pedido-resumen">
                    <span id="lblResumenCeldasPedido" class="ex-pedido-chip"></span>
                    <span id="lblResumenTotalPedido" class="ex-pedido-chip ex-pedido-total"></span>
                    <span id="lblEstadoBorradorPedido" class="text-muted small d-none"></span>
                </div>
            </div>
        </div>

        <div class="card-body ex-estado-linea">
            <span class="ex-estado-item"><span class="text-muted">Actualizado:</span> <strong id="lblUltimaActualizacionExistencia">-</strong></span>
            <span class="ex-estado-item text-success" id="lblAutoActualizarExistencia">Cada @intervaloAutoMinutos minutos, hasta 6 veces.</span>
            <span class="ex-estado-item text-warning d-none" id="lblAvisoPendienteExistencia">Hay filtros sin aplicar.</span>
            <span class="ex-estado-item text-muted" id="lblEstadoConsultaExistencia">Presioná Buscar para consultar stock.</span>
            <span class="ex-estado-item text-muted" id="lblFechaMinimaExistencia"></span>
            <span class="ex-grow"></span>
            <span class="ex-estado-item text-muted" id="lblPieExistencia"></span>
        </div>

        <div class="p-0 ex-tabla-wrap" id="contenedorTablaExistenciaSucursales">
            @Html.Partial("~/Views/Stock/_TablaExistenciaPorSucursales.cshtml", Model)
        </div>
    </div>
</div>

@* Vista preliminar del pedido: solo los productos con cantidad cargada. El cuerpo lo arma existencia-pedido.js. *@
<div class="modal fade" id="modalPreviaPedidoExistencia" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="tituloPreviaPedidoExistencia">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="tituloPreviaPedidoExistencia"><i class="fas fa-clipboard-check mr-2"></i>Vista preliminar del pedido</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body p-0" id="cuerpoPreviaPedidoExistencia"></div>
            <div class="modal-footer ex-previa-pie">
