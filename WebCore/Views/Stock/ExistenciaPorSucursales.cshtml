@model Entidades.ExistenciaPorSucursalesVm
@using System
@using System.Linq

@*
    Existencia por sucursales: stock y estado de cada producto, una sucursal por grupo de columnas.
    Barra de una sola linea (diseño siempre compacto) con filtros avanzados plegados, tabla ordenable y
    autoactualizacion encendida desde que se abre. La tabla la arma _TablaExistenciaPorSucursales.cshtml; toda la logica del
    navegador (orden, filtros, autoactualizar, editar punto de stock, exportar) esta en
    Scripts/app/existencia-sucursales.js. Reglas y porques: docs/DECISIONS.md 2026-10-19 y
    docs/11-manual-de-uso/pantallas/Stock.ExistenciaPorSucursales.md.
*@

@{
    ViewBag.Title = "Existencia por sucursales";

    var filtro = Model != null ? Model.Filtro : new Entidades.ExistenciaStockPorSucursalFiltroVm();
    string fechaHasta = filtro.FechaHasta.HasValue ? filtro.FechaHasta.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    string fechaMinima = filtro.FechaMinimaConsulta.HasValue ? filtro.FechaMinimaConsulta.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    // TODO(claude): el original lee Session["Usuario"].Empresa.Cuit para elegir el intervalo de
    // autoactualizacion (15 min para la empresa real con CUIT 20306210786, 30 para el resto). Sin
    // sesion real, se verifico contra la base local (empresa id=1, la del stub de WebCore) que
    // ese CUIT SI coincide -- se hardcodea directamente a 15 en vez de reproducir el chequeo
    // (mismo resultado observable para el usuario de prueba de todo el juez de paridad).
    int intervaloAutoMinutos = 15;

    // Modo ventana independiente (?popup=true): layout minimo sin sidebar/topbar, el mismo patron que
    // Productos/AddOrEdit?embed=true. Se abre desde el boton "Abrir en ventana" de la vista normal.
    bool popup = ViewBag.Popup is bool esPopup && esPopup;
    // Modo "movimiento": esta misma pantalla como panel de stock de la sucursal DESTINO de Movimientos/Editar (en un iframe o en una ventana
    // independiente). Siempre compacta; sin pedido, selector de sucursales, exportar ni "Ventana"; con la columna "Sugerido a enviar".
    // Habla con el movimiento por un BroadcastChannel (existencia-movimiento.js). Ver docs/DECISIONS.md (2026-10-20).
    bool modoMovimiento = ViewBag.ModoMovimiento is bool mm && mm;
    string canalMovimiento = (ViewBag.CanalMovimiento as string) ?? "";
    if (popup)
    {
        Layout = "~/Views/Shared/_LayoutEmbed.cshtml";
    }

    // "Con movimiento" usa la actividad de "Que pedir": solo Postgres. Los limites de la autoactualizacion salen de App.config.
    bool movimientoDisponible = ViewBag.MovimientoDisponible is bool md && md;
    int jitterInicialMaxSegundos = ViewBag.JitterInicialMaxSegundos is int jit ? jit : 0;
    int reintentoCargaSegundos = ViewBag.ReintentoCargaSegundos is int rei ? rei : 120;

    // "Ingresar pedido": sugerencias y precios salen de la actividad de "Que pedir" (solo Postgres); el autoguardado usa los borradores
    // en servidor (modulo PEDIDO_STOCK) cuando estan habilitados. Datos del operador y de la sucursal del borrador: StockController.
    bool pedidoDisponible = ViewBag.PedidoDisponible is bool pd && pd;
    bool pedidoBorradorHabilitado = ViewBag.PedidoBorradorHabilitado is bool pbh && pbh;
    var modalBorradoresData = new ViewDataDictionary(ViewData);
    modalBorradoresData["TituloBorradoresGenerico"] = "Pedidos sin guardar";

    // Permiso para editar el punto de stock (lo resuelve StockController). Sin permiso no hay lapices ni el interruptor "Editar puntos".
    bool puedeEditarPunto = ViewBag.PuedeEditarPunto is bool pep && pep;

    bool todasTildadas =filtro.IdsSucursales == null || filtro.IdsSucursales.Count == 0;

    // Desplegables de seleccion multiple de los filtros avanzados (Tipos / Proveedores / Marcas): sin nada tildado = sin filtro.
    var desplegables = new[]
    {
        new { Clave = "tipos", Etiqueta = "Tipos", Campo = "tipos", Singular = "tipo", Plural = "tipos",
              // La lista de tipos trae una fila "Todos" propia de la grilla de tipos: aca "Todos" es el tilde de arriba, no un tipo.
              Items = filtro.TiposDisponibles.Where(t => !string.Equals((t ?? "").Trim(), "Todos", StringComparison.OrdinalIgnoreCase))
                  .Select(t => new { Valor = t, Texto = t }).ToList() },
        new { Clave = "proveedores", Etiqueta = "Proveedores", Campo = "idsProveedores", Singular = "proveedor", Plural = "proveedores",
              Items = filtro.ProveedoresDisponibles.Select(p => new { Valor = p.IdPersona.ToString(), Texto = p.RazonSocial }).ToList() },
        new { Clave = "marcas", Etiqueta = "Marcas", Campo = "idsMarcas", Singular = "marca", Plural = "marcas",
              Items = filtro.MarcasDisponibles.Select(m => new { Valor = m.IdPersona.ToString(), Texto = m.RazonSocial }).ToList() }
    };
}

@* El diseño es SIEMPRE compacto (clase fija existencia-compacto): ya no hay interruptor ni preferencia por navegador. *@
<div class="container-fluid existencia-sucursales-page existencia-compacto@(modoMovimiento ? " ex-modo-mov" : "")" id="existenciaPage">

    @if (popup && !modoMovimiento)
    {
        // _LayoutEmbed no tiene barra superior: el titulo de la pantalla se muestra aca.
        <h5 class="existencia-popup-titulo mb-2">Existencia por sucursales</h5>
    }

    @* Token para los POST de esta pantalla (editar punto de stock, exportar): _LayoutEmbed no trae el global del layout normal. *@
    @Html.AntiForgeryToken()

    <div class="card shadow-sm ex-card">
        <div class="card-body ex-barra-wrap">
            <form id="formExistenciaSucursales" autocomplete="off">
                <div class="ex-barra">
                    @* Interruptor GRANDE (no un chip chico): al encenderlo cada sucursal gana la columna "A pedir". Apagado = solo contorno,
                       encendido = relleno de color; toda la etiqueta es clickeable. Lo maneja Scripts/app/existencia-pedido.js. *@
                    <div class="ex-ctl ex-ctl-pedido">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-pedido-toggle">
                            <input type="checkbox" class="ex-chip-input" id="switchPedidoExistencia" />
                            <label class="ex-pedido-toggle-texto" for="switchPedidoExistencia"
                                   title="Cargar cantidades a pedir por sucursal, con sugerencias según el consumo del período">
                                <i class="fas fa-clipboard-list ex-pt-ico-off" aria-hidden="true"></i>
                                <i class="fas fa-clipboard-check ex-pt-ico-on" aria-hidden="true"></i>
                                <span>Ingresar pedido</span>
                            </label>
                        </span>
                    </div>
                    @if (pedidoBorradorHabilitado)
                    {
                        @* Pedidos que quedaron a medio cargar (corte de luz, cierre del navegador): visible aunque el modo pedido este apagado. *@
                        <div class="ex-ctl ex-ctl-borradores">
                            <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                            <button type="button" class="btn btn-outline-secondary" id="btnVerBorradoresPedido"
                                    title="Pedidos que quedaron a medio cargar (corte de luz, cierre del navegador)">
                                <i class="fas fa-history"></i><span class="ex-btn-texto ml-1">Borradores sin guardar</span>
                                <span id="badgeBorradoresGenerico" class="badge badge-warning d-none ml-1">0</span>
                            </button>
                        </div>
                    }

                    <div class="ex-ctl ex-ctl-sucursales">
                        <label class="ex-lbl" for="btnSucursalesExistencia">Sucursales</label>
                        <!-- Seleccion multiple: una, varias o todas. Los checkboxes viajan en el form como idsSucursales
                             repetido (vacio de tildadas no se permite, ver script). -->
                        <div class="dropdown ui-multiselect">
                            <button type="button" id="btnSucursalesExistencia" class="btn dropdown-toggle ui-multiselect-toggle"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                <span id="lblSucursalesExistencia">Todas</span>
                            </button>
                            <div class="dropdown-menu" id="menuSucursalesExistencia">
                                <div class="custom-control custom-checkbox ui-multiselect-todas">
                                    <input type="checkbox" class="custom-control-input" id="chkSucursalTodasExistencia" @(todasTildadas ? "checked" : null)>
                                    <label class="custom-control-label" for="chkSucursalTodasExistencia">Todas</label>
                                </div>
                                <div class="dropdown-divider"></div>
                                @foreach (var sucursal in filtro.SucursalesDisponibles)
                                {
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input chk-sucursal-existencia" name="idsSucursales"
                                               id="chkSucursalExistencia_@sucursal.IdSucursal" value="@sucursal.IdSucursal"
                                               data-nombre="@sucursal.Sucursal"
                                               @((todasTildadas || filtro.IdsSucursales.Contains(sucursal.IdSucursal)) ? "checked" : null)>
                                        <label class="custom-control-label" for="chkSucursalExistencia_@sucursal.IdSucursal">@sucursal.Sucursal</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="ex-ctl ex-ctl-texto">
                        <label class="ex-lbl" for="filtroTextoExistencia">Producto</label>
                        <div class="ex-input-icon">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input type="search" id="filtroTextoExistencia" name="texto" class="form-control"
                                   placeholder="Producto o código" autocomplete="off" />
                        </div>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <!-- Fecha hasta ya no se elige a mano: siempre se recalcula a la fecha/hora exacta del momento de la
                             busqueda (manual o autoactualizada, ver el submit del form en el script). Viaja oculta. -->
                        <input type="hidden" id="filtroFechaHastaExistencia" name="fechaHasta" value="@fechaHasta" min="@fechaMinima" />
                        <button type="submit" class="btn btn-primary" id="btnBuscarExistencia" title="Buscar (actualiza el stock ahora)">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto">Buscar</span>
                        </button>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl" for="filtroClaseEstadoExistencia">Estado</label>
                        <select id="filtroClaseEstadoExistencia" class="form-control" title="Mostrar solo los productos con este estado en alguna de las sucursales">
                            <option value="todos">Todos los estados</option>
                            <option value="bien">Bien (OK)</option>
                            <option value="falta">Faltantes</option>
                            <option value="sinpto">Punto de stock 0</option>
                        </select>
                    </div>

                    <div class="ex-ctl">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <button type="button" class="btn btn-outline-secondary" id="btnFiltrosAvanzadosExistencia" aria-expanded="false"
                                aria-controls="panelFiltrosAvanzadosExistencia" title="Tipos, proveedores, marcas y movimiento">
                            <i class="fas fa-sliders-h mr-1"></i>Filtros<span id="badgeFiltrosExistencia" class="badge badge-primary ml-1 d-none">0</span>
                        </button>
                    </div>

                    <span class="ex-sep d-none d-lg-block"></span>

                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Actualiza el stock cada @intervaloAutoMinutos minutos, hasta 6 veces">
                            <input type="checkbox" class="ex-chip-input" id="switchAutoActualizarExistencia" />
                            <label class="ex-chip-texto" for="switchAutoActualizarExistencia"><i class="fas fa-sync-alt mr-1"></i>Auto <span id="lblAutoChipExistencia" class="ex-chip-detalle"></span></label>
                        </span>
                    </div>
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Mostrar la columna Estado (faltante, punto de stock)">
                            <input type="checkbox" class="ex-chip-input" id="switchEstadoStockExistencia" checked />
                            <label class="ex-chip-texto" for="switchEstadoStockExistencia">Estado</label>
                        </span>
                    </div>
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <span class="ex-chip" title="Expandir el detalle de todos los productos">
                            <input type="checkbox" class="ex-chip-input" id="switchExpandirExistencia" />
                            <label class="ex-chip-texto" for="switchExpandirExistencia">Expandir</label>
                        </span>
                    </div>
                    @* Solo con permiso (Producto.NuevoCorte). Arranca apagado en cada carga: los lapices del punto de stock no se ven hasta encenderlo,
                       para no modificar un punto sin querer. No se recuerda entre visitas. *@
                    @if (puedeEditarPunto)
                    {
                        <div class="ex-ctl ex-ctl-chip ex-ctl-editar-punto">
                            <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                            <span class="ex-chip" title="Mostrar los lápices para editar el punto de stock (apagado, no se puede modificar por error)">
                                <input type="checkbox" class="ex-chip-input" id="switchEditarPuntoExistencia" />
                                <label class="ex-chip-texto" for="switchEditarPuntoExistencia"><i class="fas fa-pencil-alt mr-1"></i>Editar puntos</label>
                            </span>
                        </div>
                    }

                    <span class="ex-grow"></span>

                    <div class="ex-ctl ex-ctl-acciones">
                        <label class="ex-lbl d-none d-md-block">&nbsp;</label>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary" id="btnExcelExistencia" title="Exportar a Excel lo que se ve (filtros y orden actuales)">
                                <i class="far fa-file-excel"></i><span class="ex-btn-texto ml-1">Excel</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnPdfExistencia" title="Exportar a PDF lo que se ve (filtros y orden actuales)">
                                <i class="far fa-file-pdf"></i><span class="ex-btn-texto ml-1">PDF</span>
                            </button>
                            @if (!popup)
                            {
                                <button type="button" class="btn btn-outline-secondary" id="btnAbrirVentanaExistencia"
                                        title="Abrir esta pantalla en una ventana independiente, sin menús">
                                    <i class="fas fa-external-link-alt"></i><span class="ex-btn-texto ml-1">Ventana</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="ex-avanzados d-none" id="panelFiltrosAvanzadosExistencia">
                    @foreach (var d in desplegables)
                    {
                        <div class="ex-ctl ex-ctl-ms">
                            <label class="ex-lbl-fijo">@d.Etiqueta</label>
                            <div class="dropdown ui-multiselect ex-ms" data-ms="@d.Clave" data-singular="@d.Singular" data-plural="@d.Plural">
                                <button type="button" class="btn dropdown-toggle ui-multiselect-toggle" data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                                    <span class="ex-ms-resumen">Todos</span>
                                </button>
                                <div class="dropdown-menu ex-ms-menu">
                                    <input type="search" class="form-control form-control-sm ex-ms-buscar" placeholder="Buscar…" autocomplete="off" />
                                    <div class="custom-control custom-checkbox ui-multiselect-todas">
                                        <input type="checkbox" class="custom-control-input ex-ms-todos" id="chkTodos_@d.Clave" checked>
                                        <label class="custom-control-label" for="chkTodos_@d.Clave">Todos</label>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    <div class="ex-ms-lista">
                                        @for (int i = 0; i < d.Items.Count; i++)
                                        {
                                            <div class="custom-control custom-checkbox ex-ms-item" data-texto="@d.Items[i].Texto.ToLowerInvariant()">
                                                <input type="checkbox" class="custom-control-input ex-ms-chk" name="@d.Campo" value="@d.Items[i].Valor"
                                                       data-nombre="@d.Items[i].Texto" id="chk_@(d.Clave)_@i">
                                                <label class="custom-control-label" for="chk_@(d.Clave)_@i">@d.Items[i].Texto</label>
                                            </div>
                                        }
                                        @if (d.Items.Count == 0)
                                        {
                                            <div class="text-muted small px-2 py-1">No hay opciones cargadas.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="ex-ctl ex-ctl-periodo">
                        <label class="ex-lbl-fijo" for="filtroPeriodoDesdeExistencia">Período desde</label>
                        <div class="ex-periodo">
                            <input type="date" id="filtroPeriodoDesdeExistencia" name="periodoDesde" class="form-control" />
                            <span class="ex-periodo-atajos">
                                @* Los atajos son la unica lista de dias: el JS (existencia-sucursales.js) la lee de estos botones. *@
                                @* En el modo movimiento solo los atajos cortos: otro periodo se elige escribiendo la fecha. *@
                                @foreach (var dias in (modoMovimiento ? new[] { 1, 2, 3, 7, 15 } : new[] { 1, 2, 3, 7, 15, 30, 60, 365 }))
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm ex-periodo-dias" data-dias="@dias"
                                            title="@((dias == 1 ? "Desde hace 1 día" : "Desde hace " + dias + " días") + ". Con fecha hasta: desde " + dias + (dias == 1 ? " día" : " días") + " antes de esa fecha.")">@(dias)&nbsp;d</button>
                                }
                            </span>
                            @* Fecha hasta (opcional): sin ella se cuenta hasta ahora. Con ella el periodo queda cerrado (ej. el mes pasado). El campo
                               arranca deshabilitado y oculto para que no viaje en la busqueda mientras no se agregue. *@
                            <button type="button" class="btn btn-outline-secondary btn-sm ex-periodo-agregar" id="btnAgregarHastaExistencia"
                                    title="Agregar una fecha hasta para cerrar el período (por defecto se cuenta hasta ahora)">+ Fecha hasta</button>
                            <span class="ex-periodo-hasta d-none" id="grupoPeriodoHastaExistencia">
                                <label for="filtroPeriodoHastaExistencia" class="mb-0">hasta</label>
                                <input type="date" id="filtroPeriodoHastaExistencia" name="periodoHasta" class="form-control" disabled />
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnQuitarHastaExistencia"
                                        title="Quitar la fecha hasta (se vuelve a contar hasta ahora)" aria-label="Quitar la fecha hasta">&times;</button>
                            </span>
                        </div>
                    </div>

                    <div class="ex-ctl ex-ctl-movimiento">
                        <label class="ex-lbl-fijo">Con movimiento</label>
                        <div class="ex-movimiento" title="@(movimientoDisponible ? "" : "No disponible con este motor de datos")">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="chkConMovimientoExistencia" name="conMovimiento" value="true"
                                       @(movimientoDisponible ? null : "disabled")>
                                <label class="custom-control-label" for="chkConMovimientoExistencia">Solo con al menos</label>
                            </div>
                            <input type="number" id="filtroMovimientoMinimoExistencia" name="movimientoMinimo" class="form-control ex-mov-min"
                                   min="0.001" step="any" value="1" disabled />
                            <select id="filtroMovimientoMedidaExistencia" name="movimientoMedida" class="form-control ex-mov-medida" disabled>
                                <option value="salidas">Salidas (kg/un.)</option>
                                <option value="dias">Días con venta</option>
                            </select>
                        </div>
                        <div class="ex-ayuda">
                            @if (movimientoDisponible)
                            {
                                <text><b>Salidas</b> = ventas + uso en elaborados, desde la fecha del período hasta ahora (o hasta la fecha «hasta», si la agregás). <b>Días con venta</b> cuenta solo ventas. Cumple si alguna sucursal mostrada alcanza el mínimo.</text>
                            }
                            else
                            {
                                <text>No disponible con este motor de datos (solo Postgres).</text>
                            }
                        </div>
                    </div>
                </div>
            </form>

            @if (modoMovimiento)
            {
                @* Modo movimiento: el periodo (desde / hasta) sale del panel de Filtros y queda siempre a la vista junto a la leyenda de la columna
                   "Sugerido a enviar" (existencia-movimiento.js mueve ahi el bloque del periodo). *@
                <div class="ex-mov-bloque ex-mov-colapsado" id="bloqueMovExistencia">
                    @* Compacto por defecto (una linea con el resumen del periodo); "Cambiar período" (o un click en la tira) lo abre. No se recuerda:
                       siempre arranca compacto. *@
                    <button type="button" class="ex-mov-colapsar" id="btnColapsarBloqueMov" aria-expanded="false" title="Mostrar el período y la explicación del sugerido">
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        <span class="ex-mov-colapsar-txt">Cambiar período</span>
                    </button>
                    <span class="ex-mov-resumen" id="lblResumenMov">Sugerido: calculando…</span>
                    @* Fechas escritas a mano sin aplicar: las sugerencias siguen con el periodo anterior hasta confirmar (existencia-movimiento.js). *@
                    <span class="ex-mov-aviso-pendiente d-none" id="avisoPendienteMov" role="status">
                        <span id="lblPendienteMov"></span>
                        <button type="button" class="btn btn-warning btn-sm ex-mov-aplicar" id="btnAplicarPeriodoMov">
                            <i class="fas fa-sync-alt" aria-hidden="true"></i> Actualizar sugerencias
                        </button>
                    </span>
                    <div class="ex-mov-periodo" id="hostPeriodoMov"></div>
                    <div class="ex-mov-leyenda">
                        <i class="fas fa-info-circle" aria-hidden="true"></i>
                        <span id="lblLeyendaSugeridoMov">Calculando las sugerencias…</span>
                        <span id="lblRecalculadoMov" class="ex-mov-recalculado"></span>
                    </div>
                </div>
            }

            @* Resumen de los filtros avanzados (Tipos, Proveedores, Marcas y "Con movimiento") de la ULTIMA busqueda: se ve solo si hay alguno aplicado y
               el panel "Filtros" esta cerrado, para no perder de vista por que faltan productos. Cada chip se edita con un click y se quita con la x.
               Los chips los arma existencia-sucursales.js (renderResumenFiltros). *@
            <div class="ex-resumen-filtros d-none" id="resumenFiltrosExistencia">
                <span class="ex-rf-etiqueta"><i class="fas fa-filter" aria-hidden="true"></i> Filtros aplicados:</span>
                <span class="ex-rf-lista"></span>
                <span class="ex-rf-pendiente d-none" title="Cambiaste filtros y todavía no tocaste Buscar: lo que se ve es la última búsqueda">⚠ sin aplicar</span>
                <button type="button" class="ex-rf-limpiar" title="Quitar todos los filtros avanzados y volver a buscar">Limpiar</button>
            </div>

            @* ---------- Barra del pedido (solo visible con "Ingresar pedido" encendido) ---------- *@
            @* El boton de la izquierda colapsa la barra a UNA linea (resumen + Guardar) para que no ocupe el alto de la pantalla; se recuerda
               en este navegador. Lo maneja Scripts/app/existencia-pedido.js. *@
            <div class="ex-pedido-barra d-none" id="barraPedidoExistencia">
                <div class="ex-pedido-linea1">
                <button type="button" class="ex-pedido-colapsar" id="btnColapsarBarraPedido" aria-expanded="true" aria-controls="cuerpoBarraPedidoExistencia"
                        title="Ocultar las opciones del pedido (queda una sola línea con el resumen y Guardar)">
                    <i class="fas fa-chevron-up" aria-hidden="true"></i>
                </button>
                <div class="ex-pedido-leyenda">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span id="lblLeyendaPedidoExistencia">Cargando sugerencias…</span>
                    <a href="#" id="lnkCambiarPeriodoPedido" class="ml-1">Cambiar</a>
                    <span class="ex-pedido-ayuda ml-1" id="lblAyudaPedidoExistencia" tabindex="0" role="note"
                          title="La sugerencia se calcula por sucursal: consumo del período (lo vendido más lo que se usó en elaborados desde la fecha elegida hasta ahora, o hasta la fecha «hasta» si la agregaste) menos el stock actual. Si el stock alcanza se avisa «stock suficiente». Ejemplo, pedidos cada 30 días: período desde hoy − 30; si se vendieron 80,500 y se usaron 12,000 en elaborados (92,500) y hay 40,000 de stock, se sugiere pedir 52,500. Las sugerencias no se cargan solas: las aceptás vos. Si el stock es negativo se toma como 0.">
                        <i class="far fa-question-circle" aria-hidden="true"></i>
                    </span>
                </div>
                @* Solo se ve con la barra colapsada: el resumen del pedido y un Guardar (el mismo que el de las opciones). *@
                <div class="ex-pedido-mini">
                    <span class="ex-pedido-mini-texto" id="lblMiniPedidoExistencia">Pedido sin cantidades cargadas</span>
                    <button type="button" class="btn btn-primary btn-sm" id="btnGuardarMiniPedidoExistencia" disabled
                            title="Revisar el pedido antes de guardarlo (muestra solo los productos con cantidad)">
                        <i class="fas fa-save mr-1"></i>Guardar pedido
                    </button>
                </div>
                </div>
                <div class="ex-pedido-cuerpo" id="cuerpoBarraPedidoExistencia">
                <div class="ex-pedido-acciones">
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo" for="selSugerirSegunExistencia">Sugerir según</label>
                        <select id="selSugerirSegunExistencia" class="form-control">
                            <option value="consumo">Consumo − stock</option>
                            <option value="punto">Hasta el punto de stock</option>
                            <option value="mayor">El mayor de los dos</option>
                        </select>
                    </div>
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo">&nbsp;</label>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-primary" id="btnAceptarTodasExistencia"
                                    title="Cargar las sugerencias en las celdas de todas las sucursales (solo los productos que se ven)">
                                <i class="fas fa-magic mr-1"></i>Aceptar sugerencias
                            </button>
                            <button type="button" class="btn btn-outline-warning" id="btnCompletarPuntoExistencia"
                                    title="Cargar «hasta el punto de stock» solo en las celdas que están bajo el punto">
                                <i class="fas fa-bullseye mr-1"></i>Completar bajo el punto <span id="lblCantBajoPuntoExistencia">(0)</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarPedidoExistencia" title="Borrar todas las cantidades cargadas">
                                <i class="fas fa-eraser mr-1"></i>Limpiar
                            </button>
                        </div>
                    </div>
                    @* Los precios (ultima compra e importe estimado) estan ocultos siempre: se ven solo si el usuario enciende este interruptor
                       (columnas de la tabla y de la vista preliminar). No se recuerda: cada vez que se abre la pantalla arranca apagado. *@
                    <div class="ex-ctl ex-ctl-chip">
                        <label class="ex-lbl-fijo">&nbsp;</label>
                        <span class="ex-chip" title="Mostrar el precio de la última compra y el importe estimado de cada producto (en la tabla y en la vista preliminar). Por defecto están ocultos.">
                            <input type="checkbox" class="ex-chip-input" id="switchPreciosPedidoExistencia" />
                            <label class="ex-chip-texto" for="switchPreciosPedidoExistencia"><i class="fas fa-dollar-sign mr-1"></i>Ver precios</label>
                        </span>
                    </div>
                    <span class="ex-grow"></span>
                    <div class="ex-ctl">
                        <label class="ex-lbl-fijo">&nbsp;</label>
                        <button type="button" class="btn btn-primary" id="btnGuardarPedidoExistencia" disabled
                                title="Revisar el pedido antes de guardarlo (muestra solo los productos con cantidad)">
                            <i class="fas fa-save mr-1"></i>Guardar pedido <span id="lblContadorPedidoExistencia" class="ex-pedido-contador">(0 productos)</span>
                        </button>
                    </div>
                </div>
                <div class="ex-pedido-resumen">
                    <span id="lblResumenCeldasPedido" class="ex-pedido-chip"></span>
                    <span id="lblResumenTotalPedido" class="ex-pedido-chip ex-pedido-total"></span>
                    <span id="lblEstadoBorradorPedido" class="text-muted small d-none"></span>
                </div>
                </div>
            </div>
        </div>

        <div class="card-body ex-estado-linea">
            <span class="ex-estado-item"><span class="text-muted">Actualizado:</span> <strong id="lblUltimaActualizacionExistencia">-</strong></span>
            <span class="ex-estado-item text-success" id="lblAutoActualizarExistencia">Cada @intervaloAutoMinutos minutos, hasta 6 veces.</span>
            <span class="ex-estado-item text-warning d-none" id="lblAvisoPendienteExistencia">Hay filtros sin aplicar.</span>
            <span class="ex-estado-item text-muted" id="lblEstadoConsultaExistencia">Presioná Buscar para consultar stock.</span>
            <span class="ex-estado-item text-muted" id="lblFechaMinimaExistencia"></span>
            <span class="ex-grow"></span>
            <span class="ex-estado-item text-muted" id="lblPieExistencia"></span>
        </div>

        <div class="p-0 ex-tabla-wrap" id="contenedorTablaExistenciaSucursales">
            @Html.Partial("~/Views/Stock/_TablaExistenciaPorSucursales.cshtml", Model)
        </div>
    </div>
</div>

@* Vista preliminar del pedido: solo los productos con cantidad cargada. El cuerpo lo arma existencia-pedido.js. *@
<div class="modal fade" id="modalPreviaPedidoExistencia" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="tituloPreviaPedidoExistencia">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="tituloPreviaPedidoExistencia"><i class="fas fa-clipboard-check mr-2"></i>Vista preliminar del pedido</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body p-0" id="cuerpoPreviaPedidoExistencia"></div>
            <div class="modal-footer ex-previa-pie">
                <div class="ex-previa-resumen" id="resumenPreviaPedidoExistencia"></div>
                <div class="ex-previa-botones">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal"><i class="fas fa-arrow-left mr-1"></i>Volver a editar</button>
                    @* Guarda con Pedidos/Guardar (modulo Pedidos, Fase 3) y abre el dialogo de ticket/PDF/mail/Excel de pedido-acciones.js. *@
                    <button type="button" class="btn btn-success" id="btnConfirmarPedidoExistencia" title="Guardar el pedido tal como se ve en esta vista">
                        <i class="fas fa-check mr-1"></i>Confirmar y guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (pedidoBorradorHabilitado)
{
    @Html.Partial("~/Views/Shared/_ModalBorradoresGenerico.cshtml", modalBorradoresData)
}

<style>
    /* ---------- Base (diseño normal) ---------- */
    .existencia-sucursales-page { font-size: .9rem; }
    .existencia-sucursales-page .card-body { padding: .7rem .85rem; }
    .existencia-popup-titulo { font-weight: 700; font-size: 1rem; }

    .ex-card { display: flex; flex-direction: column; overflow: visible; }
    .ex-barra-wrap { order: 1; }
    .ex-estado-linea { order: 2; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1rem; padding-top: 0 !important; font-size: .8rem; }
    .ex-tabla-wrap { order: 3; }

    .ex-barra { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .55rem .6rem; }
    .ex-ctl { display: flex; flex-direction: column; min-width: 0; }
    .ex-ctl-sucursales { width: 13rem; }
    .ex-ctl-texto { flex: 1 1 13rem; min-width: 10rem; }
    .ex-grow { flex: 1 1 auto; }
    .ex-sep { width: 1px; align-self: stretch; background: var(--ui-border, #dee2e6); margin: 0 .1rem; }
    .ex-lbl, .ex-lbl-fijo { font-size: .74rem; color: var(--ui-text-muted, #6c757d); margin-bottom: .15rem; }

    .existencia-sucursales-page .ex-barra .form-control,
    .existencia-sucursales-page .ex-barra .btn,
    .existencia-sucursales-page .ex-avanzados .form-control,
    .existencia-sucursales-page .ex-avanzados .btn:not(.btn-sm),
    .existencia-sucursales-page .ui-multiselect-toggle {
        min-height: 2.15rem;
        font-size: .84rem;
        padding: .28rem .6rem;
    }

    .ex-input-icon { position: relative; }
    .ex-input-icon > i { position: absolute; left: .6rem; top: 50%; transform: translateY(-50%); color: var(--ui-text-muted, #6c757d); font-size: .8rem; pointer-events: none; }
    .ex-input-icon > input { padding-left: 1.9rem; }

    /* Interruptores en forma de "chip": el checkbox real (para el JS) queda oculto y la etiqueta se pinta como boton. */
    .ex-chip { position: relative; display: inline-flex; }
    .ex-chip-input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
    .ex-chip-texto {
        display: inline-flex; align-items: center; margin: 0; cursor: pointer; user-select: none;
        min-height: 2.15rem; padding: 0 .7rem; font-size: .8rem; white-space: nowrap;
        border: 1px solid var(--ui-border-strong, #ced4da); border-radius: .55rem; background: var(--ui-surface, #fff); color: var(--ui-text, #212529);
    }
    .ex-chip-texto:hover { border-color: var(--ui-primary, #2d5b8f); }
    .ex-chip-input:checked + .ex-chip-texto { background: var(--ui-primary-soft, rgba(45, 91, 143, .12)); border-color: var(--ui-primary, #2d5b8f); color: var(--ui-primary, #2d5b8f); font-weight: 600; }
    .ex-chip-input:focus-visible + .ex-chip-texto { outline: 2px solid var(--ui-primary, #2d5b8f); outline-offset: 1px; }
    .ex-chip-detalle { margin-left: .25rem; font-weight: 400; font-variant-numeric: tabular-nums; }

    /* ---------- Ingresar pedido ---------- */
    /* Interruptor grande: >= 38 px de alto, ícono + texto, toda la etiqueta clickeable. Apagado = contorno; encendido = relleno.
       Tambien en Compacto conserva su tamaño (no es un chip chico). */
    .ex-pedido-toggle { position: relative; display: inline-flex; }
    .ex-pedido-toggle-texto {
        display: inline-flex; align-items: center; gap: .5rem; margin: 0; cursor: pointer; user-select: none; white-space: nowrap;
        min-height: 2.6rem; padding: 0 1.15rem; font-size: .95rem; font-weight: 700; border-radius: .6rem;
        border: 2px solid var(--ui-primary, #2d5b8f); background: var(--ui-surface, #fff); color: var(--ui-primary, #2d5b8f);
        transition: background-color .12s, color .12s;
    }
    .ex-pedido-toggle-texto:hover { background: var(--ui-primary-soft, rgba(45, 91, 143, .12)); }
    /* !important: el tema global pinta las <label> con su propio color y dejaba el texto oscuro sobre el relleno. */
    .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto,
    .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto span { background-color: var(--ui-primary, #2d5b8f); color: #fff !important; }
    .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto span { background-color: transparent; }
    .ex-pedido-toggle .ex-pedido-toggle-texto { color: var(--ui-primary, #2d5b8f) !important; }
    .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto { color: #fff !important; }
    .ex-pedido-toggle .ex-chip-input:focus-visible + .ex-pedido-toggle-texto { outline: 3px solid var(--ui-primary, #2d5b8f); outline-offset: 2px; }
    .ex-pedido-toggle .ex-pt-ico-on, .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto .ex-pt-ico-off { display: none; }
    .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto .ex-pt-ico-on { display: inline-block; }
    /* 2026-10-30: mismo tamano que los demas botones/chips de la barra (Auto, Estado, Expandir...): alto 1.85rem, letra .78rem, borde fino.
       Conserva el color (contorno azul / relleno al encender) para que siga destacando. */
    .existencia-compacto .ex-pedido-toggle-texto { min-height: 1.85rem; padding: 0 .55rem; gap: .35rem; font-size: .78rem; font-weight: 600; border-width: 1px; border-radius: .55rem; }

    /* Las columnas del pedido existen siempre en el HTML y se muestran solo con el modo encendido. */
    .ex-col-pedir, .ex-pedido-fin { display: none; }
    .existencia-pedido-on th.ex-col-pedir, .existencia-pedido-on td.ex-col-pedir,
    .existencia-pedido-on th.ex-pedido-fin, .existencia-pedido-on td.ex-pedido-fin { display: table-cell; }
    .existencia-pedido-on .ex-grupo .ex-btn-aceptar-suc.ex-col-pedir { display: inline-block; }
    /* Precio de la ultima compra e importe estimado: siguen ocultos con el pedido encendido hasta que se enciende "Ver precios".
       (Van despues de la regla de arriba: empatan en especificidad y gana la ultima.) */
    .existencia-pedido-on th.ex-col-precio, .existencia-pedido-on td.ex-col-precio { display: none; }
    .existencia-pedido-on.existencia-precios-on th.ex-col-precio, .existencia-pedido-on.existencia-precios-on td.ex-col-precio { display: table-cell; }

    .ex-pedido-barra { margin-top: .6rem; padding: .55rem .7rem; border: 1px solid var(--ui-primary, #2d5b8f); border-radius: .6rem; background: var(--ui-primary-soft, rgba(45, 91, 143, .07)); }
    .ex-pedido-barra.d-none { display: none !important; }
    /* Primera linea de la barra: boton para colapsar + leyenda (o, colapsada, el resumen con su Guardar). */
    .ex-pedido-linea1 { display: flex; align-items: flex-start; gap: .5rem; margin-bottom: .45rem; }
    .ex-pedido-colapsar {
        flex: 0 0 auto; width: 1.6rem; height: 1.6rem; padding: 0; line-height: 1; border-radius: .4rem; cursor: pointer;
        border: 1px solid var(--ui-primary, #2d5b8f); background: transparent; color: var(--ui-primary, #2d5b8f); font-size: .75rem;
    }
    .ex-pedido-colapsar:hover { background: var(--ui-primary-soft, rgba(45, 91, 143, .12)); }
    .ex-pedido-colapsar:focus-visible { outline: 2px solid var(--ui-primary, #2d5b8f); outline-offset: 1px; }
    .ex-pedido-mini { display: none; flex: 1 1 auto; min-width: 0; align-items: center; justify-content: space-between; gap: .6rem; font-size: .8rem; font-weight: 600; }
    .ex-pedido-mini-texto { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-pedido-barra.ex-colapsada { padding-top: .3rem; padding-bottom: .3rem; }
    .ex-pedido-barra.ex-colapsada .ex-pedido-linea1 { margin-bottom: 0; align-items: center; }
    .ex-pedido-barra.ex-colapsada .ex-pedido-leyenda,
    .ex-pedido-barra.ex-colapsada .ex-pedido-cuerpo { display: none; }
    .ex-pedido-barra.ex-colapsada .ex-pedido-mini { display: flex; }
    .ex-pedido-leyenda { font-size: .8rem; flex: 1 1 auto; min-width: 0; }
    .ex-pedido-leyenda .ex-pedido-ayuda { cursor: help; color: var(--ui-text-muted, #6c757d); }
    .ex-pedido-acciones { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .45rem .6rem; }
    .ex-pedido-acciones .ex-ctl select { min-width: 12rem; }
    .existencia-sucursales-page .ex-pedido-acciones .form-control,
    .existencia-sucursales-page .ex-pedido-acciones .btn { min-height: 2.15rem; font-size: .84rem; padding: .28rem .6rem; }
    .ex-pedido-resumen { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .6rem; margin-top: .45rem; font-size: .8rem; }
    .ex-pedido-chip { display: inline-block; padding: .12rem .55rem; border-radius: 1rem; background: var(--ui-surface, #fff); border: 1px solid var(--ui-border, #dee2e6); }
    .ex-pedido-chip:empty { display: none; }
    .ex-pedido-total { font-weight: 700; }
    .ex-pedido-contador { font-weight: 400; opacity: .9; }

    .ex-btn-aceptar-suc { border: 0; background: transparent; color: var(--ui-primary, #2d5b8f); padding: 0 .3rem; margin-left: .25rem; line-height: 1; display: none; }
    .ex-btn-aceptar-suc:hover { color: #198754; }

    /* "A pedir" pegada a Stock y Estado: la celda no tiene ancho minimo (toma el de su contenido) y el contenido va alineado a la
       izquierda, justo despues del Estado; antes la casilla quedaba contra el borde derecho de una celda ancha y habia que cruzar la
       tabla con la vista para leer producto, stock y estado y despues tipear la cantidad. */
    .ex-pedir-cell { min-width: 11rem; }
    .tabla-existencia-sucursales td.ex-pedir-cell { text-align: left; }
    .ex-ped-celda { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: .2rem .4rem; }
    .existencia-sucursales-page input.ex-in-pedir { width: 6.2rem; text-align: right; font-variant-numeric: tabular-nums; padding: .15rem .4rem; height: auto; min-height: 1.7rem; font-size: .84rem; }
    .existencia-sucursales-page input.ex-in-pedir.ex-in-invalido { border-color: #dc3545; background-color: rgba(220, 53, 69, .08); }
    .existencia-sucursales-page input.ex-in-pedir.ex-in-cargada { border-color: var(--ui-primary, #2d5b8f); font-weight: 600; }
    .ex-ped-eq { font-size: .72rem; color: var(--ui-text-muted, #7a838d); white-space: nowrap; }
    .ex-ped-hint { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: .2rem; }
    .ex-ped-hint:empty { display: none; }
    .ex-ped-hint .ex-pista, .ex-ped-hint .ex-chip-punto {
        border: 1px dashed var(--ui-text-muted, #7a838d); background: transparent; border-radius: .9rem; padding: 0 .5rem; font-size: .72rem;
        line-height: 1.5; color: var(--ui-text-soft, #5f6772); cursor: pointer; white-space: nowrap;
    }
    .ex-ped-hint .ex-pista:hover { border-color: var(--ui-primary, #2d5b8f); color: var(--ui-primary, #2d5b8f); }
    .ex-ped-hint .ex-chip-punto { border-color: #b7791f; color: #8a5a12; }
    .ex-ped-hint .ex-chip-punto:hover { background: rgba(183, 121, 31, .14); }
    .ex-ped-hint .ex-suficiente { font-size: .72rem; color: #198754; white-space: nowrap; }
    .ex-tp-eq { display: block; font-size: .72rem; color: var(--ui-text-muted, #7a838d); font-weight: 400; }
    .ex-precio-cell { color: var(--ui-text-soft, #5f6772); }
    .ex-precio-cell .ex-sinprecio { color: var(--ui-text-muted, #7a838d); font-size: .74rem; }
    /* Compacto: casilla angosta (entra "159,256"), todo en un renglon y las pistas en su version corta (sin los textos .ex-h-lbl).
       El selector lleva las dos clases del contenedor para ganarle en especificidad a la regla base de arriba. */
    .existencia-compacto .ex-ped-celda { flex-wrap: nowrap; gap: 0 .3rem; }
    /* Ancho minimo = casilla + "≈ N un.": al tipear una cantidad la columna no se ensancha (no se corren las columnas de la derecha). */
    .existencia-compacto .ex-pedir-cell { min-width: 9.2rem; }
    .existencia-sucursales-page.existencia-compacto input.ex-in-pedir { width: 4.9rem; min-height: 1.45rem; padding: .05rem .35rem; font-size: .78rem; line-height: 1.2; }
    .existencia-compacto .ex-ped-hint { flex-wrap: nowrap; }
    .existencia-compacto .ex-ped-hint .ex-pista, .existencia-compacto .ex-ped-hint .ex-chip-punto { padding: 0 .4rem; font-size: .7rem; line-height: .945rem; }
    .existencia-compacto .ex-h-lbl { display: none; }
    .existencia-compacto .ex-tp-eq { display: inline; margin-left: .3rem; }
    /* La fila donde se esta tipeando se resalta de punta a punta: ayuda a seguir producto, stock y estado hasta la casilla. */
    .existencia-sucursales-page .existencia-producto-row:focus-within > td { background-color: var(--ex-fila-activa, #e7eff9); }
    html.dark-mode .existencia-sucursales-page { --ex-fila-activa: #2b394d; }
    .existencia-compacto .ex-pedido-barra { margin-top: .35rem; padding: .35rem .5rem; }
    .existencia-compacto .ex-pedido-barra.ex-colapsada { padding-top: .25rem; padding-bottom: .25rem; }

    /* Vista preliminar del pedido */
    .ex-previa-tabla { font-size: .84rem; margin: 0; }
    .ex-previa-tabla th { position: sticky; top: 0; background: var(--ui-table-head, #eceff3); z-index: 2; font-size: .72rem; text-transform: uppercase; }
    .ex-previa-tabla td, .ex-previa-tabla th { padding: .35rem .6rem; vertical-align: middle; }
    .ex-previa-aviso { color: #b7791f; cursor: help; margin-left: .3rem; }
    .ex-previa-pie { justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; }
    .ex-previa-resumen { font-size: .84rem; }
    .ex-previa-resumen b { font-variant-numeric: tabular-nums; }

    /* Reglas "de celular": solo en dispositivos tactiles angostos. Una ventana de escritorio angosta (la ventana independiente abre en
       un tercio de la pantalla, ~640 px) conserva el diseno de escritorio: barra compacta y columnas Cod./Producto de ancho fijo. */
    @@media (max-width: 767.98px) and (pointer: coarse) {
        .ex-ctl-pedido { width: 100%; }
        .ex-pedido-toggle, .ex-pedido-toggle-texto { width: 100%; justify-content: center; }
        .ex-pedido-acciones .ex-ctl, .ex-pedido-acciones .btn-group { width: 100%; }
        .ex-pedido-acciones .btn-group { flex-wrap: wrap; }
    }

    /* En modo oscuro el primario es un azul claro: el texto del interruptor encendido pasa a oscuro para conservar el contraste. */
    html.dark-mode .ex-pedido-toggle .ex-chip-input:checked + .ex-pedido-toggle-texto { color: #0b1220 !important; }
    html.dark-mode .ex-pedido-barra { background: rgba(125, 170, 220, .1); }
    html.dark-mode .ex-pedido-chip { background: #273043; border-color: rgba(255, 255, 255, .18); }
    html.dark-mode .ex-ped-hint .ex-suficiente { color: #6fd39a; }
    html.dark-mode .ex-ped-hint .ex-chip-punto { color: #f2c46d; border-color: #f2c46d; }
    html.dark-mode .ex-previa-aviso { color: #f2c46d; }

    /* ---------- Filtros avanzados (cerrados hasta que el usuario los abre) ---------- */
    .ex-avanzados {
        display: flex; flex-wrap: wrap; align-items: flex-start; gap: .6rem 1rem; margin-top: .6rem; padding-top: .6rem;
        border-top: 1px dashed var(--ui-border, #dee2e6);
    }
    .ex-avanzados.d-none { display: none !important; }

    /* ---------- Modo movimiento (panel de stock del destino de Movimientos/Editar) ---------- */
    /* La columna "Sugerido a enviar" existe siempre en el HTML y solo se ve en este modo (como las columnas del pedido). */
    .ex-col-sug { display: none; }
    .ex-modo-mov th.ex-col-sug, .ex-modo-mov td.ex-col-sug { display: table-cell; }
    /* Sin pedido, sin selector de sucursales (lo fija el movimiento), sin exportar/ventana: la pantalla es solo para mirar y elegir. */
    .ex-modo-mov .ex-ctl-pedido, .ex-modo-mov .ex-ctl-borradores, .ex-modo-mov .ex-ctl-sucursales,
    .ex-modo-mov .ex-ctl-acciones, .ex-modo-mov .ex-ctl-movimiento { display: none !important; }
    /* El panel es angosto (~la mitad de la pantalla): Cod. y Producto mas cortos que en la pantalla normal (15 y 25 caracteres). */
    .ex-modo-mov .tabla-existencia-sucursales { --ex-cod-ch: 9ch; --ex-prod-ch: 22ch; }
    .ex-mov-bloque {
        display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .8rem; margin-top: .35rem; padding: .25rem .5rem;
        border: 1px dashed var(--ui-primary, #2d5b8f); border-radius: .5rem; background: var(--ui-primary-soft, rgba(45, 91, 143, .07)); font-size: .78rem;
    }
    .ex-mov-colapsar {
        flex: 0 0 auto; display: inline-flex; align-items: center; gap: .3rem; height: 1.4rem; padding: 0 .45rem; line-height: 1; border-radius: .35rem;
        cursor: pointer; font-size: .72rem; font-weight: 600; white-space: nowrap;
        border: 1px solid var(--ui-primary, #2d5b8f); background: transparent; color: var(--ui-primary, #2d5b8f);
    }
    .ex-mov-colapsar .fas { font-size: .65rem; }
    .ex-mov-colapsar:hover { background: var(--ui-primary-soft, rgba(45, 91, 143, .12)); }
    .ex-mov-bloque.ex-mov-colapsado { cursor: pointer; }
    /* Fechas sin aplicar: la tira pasa a ambar (aun compacta, puede ocupar dos renglones) y los sugeridos se atenuan y no se pueden cargar. */
    .ex-mov-aviso-pendiente { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .3rem .5rem; font-weight: 600; color: #8a5a00; }
    .ex-mov-aviso-pendiente.d-none { display: none !important; }
    .ex-mov-aplicar { padding: .05rem .5rem; font-size: .74rem; line-height: 1.3; white-space: nowrap; }
    .ex-mov-bloque.ex-mov-pendiente { border-style: solid; border-color: #d39e00; background: #fff7e0; }
    .ex-mov-bloque.ex-mov-colapsado.ex-mov-pendiente { flex-wrap: wrap; }
    html.dark-mode .ex-mov-bloque.ex-mov-pendiente { background: #3a2f12; }
    html.dark-mode .ex-mov-aviso-pendiente { color: #ffd77a; }
    .ex-sug-pendiente .ex-sug-num, .ex-sug-pendiente .ex-sug-ok { opacity: .4; }
    .ex-sug-pendiente .ex-sug-num { cursor: not-allowed; }
    .ex-mov-resumen { display: none; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
    /* Colapsado: una linea (boton + resumen + "recalculado"); el periodo y la explicacion quedan ocultos hasta abrirlo. */
    .ex-mov-bloque.ex-mov-colapsado { flex-wrap: nowrap; gap: .4rem; padding: .15rem .45rem; }
    .ex-mov-bloque.ex-mov-colapsado .ex-mov-resumen { display: inline; }
    .ex-mov-bloque.ex-mov-colapsado .ex-mov-periodo,
    .ex-mov-bloque.ex-mov-colapsado .ex-mov-leyenda > :not(.ex-mov-recalculado) { display: none; }
    .ex-mov-bloque.ex-mov-colapsado .ex-mov-leyenda { flex: 0 1 auto; }
    .ex-mov-bloque .ex-ctl-periodo { flex-direction: row; align-items: center; gap: .4rem; }
    .ex-mov-bloque .ex-ctl-periodo .ex-lbl-fijo { margin: 0; white-space: nowrap; }
    .ex-mov-leyenda { flex: 1 1 14rem; min-width: 0; color: var(--ui-text-soft, #5f6772); }
    .ex-mov-recalculado { margin-left: .4rem; color: var(--ui-text-muted, #6c757d); white-space: nowrap; }
    /* Fila elegible con doble click (carga el producto en el movimiento) y fila de un producto que ya va en el movimiento. */
    .ex-modo-mov .existencia-producto-row { cursor: pointer; }
    .ex-modo-mov .existencia-producto-row.ex-en-mov > td { background-color: var(--ex-fila-mov, #e7eff9); }
    .ex-en-mov-tag { margin-left: .35rem; font-size: .8em; font-weight: 600; color: var(--ui-primary, #2d5b8f); white-space: nowrap; }
    .ex-en-mov-tag.ex-revisar { color: #b7791f; }
    html.dark-mode .ex-modo-mov { --ex-fila-mov: #2b394d; }
    .ex-sug-celda { white-space: nowrap; }
    .ex-sug-num { border: 1px dashed var(--ui-text-muted, #7a838d); border-radius: .9rem; background: transparent; padding: 0 .5rem; font: inherit; font-weight: 700; cursor: pointer; color: var(--ui-text, #212529); }
    .ex-sug-num:hover { border-color: var(--ui-primary, #2d5b8f); color: var(--ui-primary, #2d5b8f); }
    .ex-sug-ok { color: #198754; font-weight: 600; }
    .ex-sug-cambio { box-shadow: inset 0 0 0 2px #f2c46d; }
    html.dark-mode .ex-sug-ok { color: #6fd39a; }

    /* ---------- Resumen de los filtros avanzados aplicados (con el panel "Filtros" cerrado) ---------- */
    .ex-resumen-filtros {
        display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .4rem; margin-top: .5rem; padding: .25rem .55rem;
        border: 1px dashed var(--ui-primary, #2d5b8f); border-radius: .5rem; background: var(--ui-primary-soft, rgba(45, 91, 143, .07)); font-size: .8rem;
    }
    .ex-resumen-filtros.d-none { display: none !important; }
    .ex-rf-etiqueta { color: var(--ui-text-muted, #6c757d); white-space: nowrap; }
    .ex-rf-lista { display: contents; }
    .ex-rf-chip {
        display: inline-flex; align-items: center; max-width: 26rem; overflow: hidden;
        border: 1px solid var(--ui-border-strong, #ced4da); border-radius: 1rem; background: var(--ui-surface, #fff);
    }
    .ex-rf-texto {
        min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;
        border: 0; background: transparent; font: inherit; color: inherit; padding: .05rem .3rem .05rem .6rem;
    }
    .ex-rf-texto:hover { color: var(--ui-primary, #2d5b8f); }
    .ex-rf-quitar { border: 0; background: transparent; padding: 0 .5rem 0 .2rem; line-height: 1; font-size: 1rem; color: var(--ui-text-muted, #6c757d); cursor: pointer; }
    .ex-rf-quitar:hover { color: #dc3545; }
    .ex-rf-pendiente { color: #b7791f; white-space: nowrap; }
    .ex-rf-pendiente.d-none { display: none !important; }
    .ex-rf-limpiar { margin-left: auto; border: 0; background: transparent; padding: 0; font: inherit; color: var(--ui-primary, #2d5b8f); text-decoration: underline; cursor: pointer; }
    html.dark-mode .ex-rf-pendiente { color: #f2c46d; }
    .existencia-compacto .ex-resumen-filtros { margin-top: .3rem; padding: .12rem .45rem; font-size: .74rem; }
    .ex-ctl-ms { width: 13rem; }
    .ex-ms-menu { min-width: 16rem; }
    .ex-ms-menu .ex-ms-buscar { margin-bottom: .35rem; }
    .ex-ms-lista { max-height: 13rem; overflow-y: auto; }
    .ex-periodo { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
    .ex-periodo input[type=date] { width: 9.5rem; }
    .ex-periodo-atajos { display: inline-flex; gap: .2rem; flex-wrap: wrap; }
    .ex-periodo .ex-periodo-agregar { border-style: dashed; }
    .ex-periodo-hasta { display: inline-flex; align-items: center; gap: .35rem; }
    .ex-periodo-hasta.d-none { display: none !important; }
    .existencia-sucursales-page .ex-periodo-dias.active { background: var(--ui-primary, #2d5b8f) !important; color: #fff !important; border-color: var(--ui-primary, #2d5b8f) !important; }
    .ex-movimiento { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
    .ex-movimiento .custom-control { margin: 0; }
    .ex-mov-min { width: 5.5rem; }
    .ex-mov-medida { width: 9.5rem; }
    .ex-ayuda { font-size: .72rem; color: var(--ui-text-muted, #6c757d); max-width: 28rem; margin-top: .2rem; }

    /* ---------- Tabla ---------- */
    .ex-tabla-wrap .tabla-full { overflow: auto; }
    /* Anchos: Cod. y Producto son FIJOS (15 y 25 caracteres) y quedan pegados; Stock, Estado, A pedir y el resto toman el ancho de su
       contenido. El ancho que sobra lo absorbe la columna de relleno (.ex-col-relleno, la ultima), asi nada se estira y todo queda
       a la vista sin mover los ojos. Con "width: 100%" la tabla ocupa al menos el ancho disponible y crece (con scroll) si no entra. */
    .tabla-existencia-sucursales { --ex-cod-ch: 15ch; --ex-prod-ch: 25ch; width: 100%; font-size: .84rem; margin-bottom: 0; }
    .tabla-existencia-sucursales th,
    .tabla-existencia-sucursales td { vertical-align: middle; padding: .42rem .58rem; line-height: 1.2; }
    .tabla-existencia-sucursales thead th {
        font-size: .72rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase;
        position: sticky; top: 0; z-index: 4; background: var(--ui-table-head, #eceff3);
    }
    /* Encabezados en una sola linea. Lleva ".table" porque el CSS global del sitio (".table thead th { white-space: normal }") empata en
       especificidad con la regla de arriba y le gana por orden de carga. */
    .tabla-existencia-sucursales.table thead th { white-space: nowrap; }
    /* La columna de relleno no tiene relleno interno (si no, el padding de las celdas de arriba le deja un minimo de ~10 px). */
    .tabla-existencia-sucursales .ex-col-relleno,
    .existencia-compacto .tabla-existencia-sucursales .ex-col-relleno { width: 100%; padding: 0; }
    .tabla-existencia-sucursales thead th.ex-sortable { cursor: pointer; user-select: none; }
    .tabla-existencia-sucursales thead th.ex-sortable:hover { color: var(--ui-primary, #2d5b8f); }
    .tabla-existencia-sucursales thead th.ex-orden-asc::after { content: " ▲"; font-size: .65rem; }
    .tabla-existencia-sucursales thead th.ex-orden-desc::after { content: " ▼"; font-size: .65rem; }
    .tabla-existencia-sucursales thead th.ex-grupo { text-align: center; }

    /* Las dos primeras columnas (Cod. y Producto) quedan fijas a la izquierda al desplazar. */
    /* El ancho de "Cod." lo da el codigo mas largo (un codigo de barras entra en una linea): el JS lo mide y lo deja en --ex-cod-w
       para que "Producto" quede pegado justo a su derecha. */
    .ex-col-cod, .ex-col-cod-cell { position: sticky; left: 0; z-index: 3; white-space: nowrap; text-align: left; color: var(--ui-text-soft, #5f6772); }
    .ex-col-prod, .ex-col-prod-cell { position: sticky; left: var(--ex-cod-w, 7rem); z-index: 3; box-shadow: inset -1px 0 0 var(--ui-border-strong, #ced4da); }
    /* El ancho fijo lo da el contenido interno (un bloque de 15 / 25 caracteres): el texto que no entra se corta con "..." y el nombre
       completo queda en el tooltip. */
    .ex-cod-txt { width: var(--ex-cod-ch); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ex-col-cod-cell, .ex-col-prod-cell { background-color: var(--ui-surface, #fff); }
    .tabla-existencia-sucursales thead .ex-col-cod,
    .tabla-existencia-sucursales thead .ex-col-prod { z-index: 6; background: var(--ui-table-head, #eceff3); }

    /* Separador entre sucursales: doble linea + un tinte suave en las impares, para distinguirlas de un vistazo. */
    .tabla-existencia-sucursales .ex-grupo-ini { border-left: 3px double var(--ui-text-muted, #7a838d) !important; }
    .tabla-existencia-sucursales td.ex-alt,
    .tabla-existencia-sucursales th.ex-alt { background-image: linear-gradient(rgba(128, 128, 128, .08), rgba(128, 128, 128, .08)); }
    .ex-grupo-total { font-weight: 600; }
    /* Columna Stock en negrita (el "≈ N un." de al lado queda en peso normal). El Total ya es negrita. */
    .tabla-existencia-sucursales td.ex-col-stock { font-weight: 700; }
    .tabla-existencia-sucursales td.ex-col-stock .existencia-unidades { font-weight: 400; }

    .existencia-producto-row { cursor: pointer; }
    .existencia-producto-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-word; font-weight: 600; width: var(--ex-prod-ch); }
    .existencia-unidades { display: block; font-size: .72rem; color: #858796; }
    .existencia-producto-completo { font-size: .78rem; color: #6c757d; margin-bottom: .6rem; }
    .existencia-producto-completo strong { color: inherit; }

    .ex-est { font-weight: 600; }
    .ex-est-neg { color: #dc3545; }
    .ex-est-falta { color: #dc3545; }
    .ex-est-punto { color: #b7791f; }
    .ex-est-ok { color: #198754; }
    .ex-est-sin { color: var(--ui-text-muted, #7a838d); font-weight: 400; }
    /* Los lapices existen en la tabla (si hay permiso) pero se ven solo con el interruptor "Editar puntos" encendido (clase ex-editar-pto en la pagina). */
    .ex-btn-pto { display: none; }
    .ex-editar-pto .ex-btn-pto { display: inline; }
    .ex-btn-pto {
        border: 0; background: transparent; padding: 0 .25rem; margin-left: .15rem; color: var(--ui-text-muted, #7a838d);
        font-size: .72rem; cursor: pointer; line-height: 1;
    }
    .ex-btn-pto:hover { color: var(--ui-primary, #2d5b8f); }

    .existencia-detalle-box { background: #f8f9fc; overflow: hidden; }
    .existencia-detalle-scroll-sync { max-width: 100%; max-height: 22rem; overflow: auto; }
    .existencia-detalle-tabla { width: max-content; min-width: 100%; font-size: .79rem; }
    .existencia-detalle-tabla th, .existencia-detalle-tabla td { white-space: nowrap; }
    .existencia-detalle-tabla thead th { font-size: .67rem !important; line-height: 1.1; padding-top: .32rem; padding-bottom: .32rem; position: static; }
    .existencia-detalle-destacado { background: #f4f8fc; font-weight: 600; }
    .existencia-detalle-stockactual { background: #e7f1fb; font-weight: 700; }

    /* Mini-editor del punto de stock (flota sobre la celda). */
    .ex-pop-pto {
        position: fixed; z-index: 2000; width: 16rem; padding: .65rem .75rem; border-radius: .7rem;
        background: var(--ui-surface, #fff); border: 1px solid var(--ui-border-strong, #ced4da); box-shadow: 0 10px 28px rgba(15, 23, 42, .2);
        font-size: .8rem;
    }
    .ex-pop-pto .ex-pop-titulo { font-weight: 600; margin-bottom: .1rem; }
    .ex-pop-pto .ex-pop-sub { color: var(--ui-text-muted, #6c757d); margin-bottom: .4rem; }
    .ex-pop-pto .ex-pop-fila { display: flex; gap: .35rem; }
    .ex-pop-pto input { width: 6rem; text-align: right; }
    .ex-pop-pto .ex-pop-error { color: #dc3545; margin-top: .3rem; min-height: 1rem; }

    html.dark-mode .existencia-detalle-box { background: #273043; }
    html.dark-mode .existencia-detalle-destacado { background: #2b394d; color: #f8f9fc; }
    html.dark-mode .existencia-detalle-stockactual { background: #35506f; color: #fff; }
    html.dark-mode .existencia-producto-completo,
    html.dark-mode .existencia-unidades { color: rgba(255, 255, 255, .72); }
    html.dark-mode .ex-est-neg, html.dark-mode .ex-est-falta { color: #ff8a8a; }
    html.dark-mode .ex-est-ok { color: #6fd39a; }
    html.dark-mode .ex-est-punto { color: #f2c46d; }

    /* ---------- Diseño compacto: barra de una linea, filas de un renglon ---------- */
    /* "!important": los rotulos de relleno (&nbsp;) llevan "d-md-block" de Bootstrap (display: block !important a partir de 768 px) y sin esto
       seguian ocupando ~17 px en compacto: los controles que los tienen (Ingresar pedido, Borradores, Buscar, Filtros, chips, Excel/PDF) quedaban
       ~10 px mas abajo que los que no (Sucursales, Producto, Estado). */
    .existencia-compacto .ex-lbl { display: none !important; }
    .existencia-compacto .ex-card > .card-body { padding: .3rem .5rem; }
    .existencia-compacto .ex-barra { align-items: center; gap: .3rem .4rem; }
    .existencia-compacto .ex-barra .form-control,
    .existencia-compacto .ex-barra .btn,
    .existencia-compacto .ui-multiselect-toggle,
    .existencia-compacto .ex-chip-texto { min-height: 1.85rem; font-size: .78rem; padding: .12rem .5rem; }
    .existencia-compacto .ex-chip-texto { padding: 0 .55rem; }
    .existencia-compacto .ex-ctl-sucursales { width: 10.5rem; }
    .existencia-compacto .ex-ctl-texto { flex: 1 1 9rem; min-width: 8rem; }
    .existencia-compacto .btn-buscar-texto,
    .existencia-compacto .ex-btn-texto { display: none; }
    .existencia-compacto .ex-ctl-chip, .existencia-compacto .ex-ctl { justify-content: center; }
    .existencia-compacto .ex-estado-linea { order: 4; padding: .15rem .6rem !important; font-size: .72rem; border-top: 1px solid var(--ui-border, #dee2e6); }
    .existencia-compacto .ex-avanzados { margin-top: .35rem; padding-top: .35rem; }
    /* Letra de la tabla compacta: .78rem (2026-10-30: se bajo 1 pt; antes era .78rem + 1pt). El interlineado es una medida fija (.975rem =
       .78rem x 1,25) para que el alto de las filas no dependa de la letra: lo siguen fijando el boton + y la casilla. */
    .existencia-compacto .tabla-existencia-sucursales { font-size: .78rem; }
    .existencia-compacto .tabla-existencia-sucursales th,
    .existencia-compacto .tabla-existencia-sucursales td { padding: .1rem .3rem; line-height: .975rem; }
    /* Los textos chicos de la tabla (unidades, pistas, equivalentes) usan su tamano propio, cada uno con su interlineado. */
    .existencia-compacto .existencia-unidades,
    .existencia-compacto .ex-ped-eq,
    .existencia-compacto .ex-tp-eq,
    .existencia-compacto .ex-ped-hint .ex-suficiente,
    .existencia-compacto .ex-btn-pto { font-size: .72rem; }
    .existencia-compacto .ex-precio-cell .ex-sinprecio { font-size: .74rem; }
    /* Columna Estado: 1 pt menos que el resto de la tabla (Stock). El "pto N" y el lapiz van con ella (si no, quedarian mas grandes que el estado). */
    .existencia-compacto .tabla-existencia-sucursales td.ex-col-estado { font-size: calc(.78rem - 1pt); }
    .existencia-compacto .tabla-existencia-sucursales td.ex-col-estado .existencia-unidades,
    .existencia-compacto .tabla-existencia-sucursales td.ex-col-estado .ex-btn-pto { font-size: inherit; }
    /* Encabezados: 1 pt menos que el contenido de Producto (.78rem; 2026-10-30, antes iban a la par). "!important" porque ui-refresh.css fija
       "body.app-shell #content .table thead th { font-size: 14px }" (con id) y le ganaba a esta regla: el encabezado salia mas grande que el contenido. */
    .existencia-compacto .tabla-existencia-sucursales thead th { font-size: calc(.78rem - 1pt) !important; padding-top: .18rem; padding-bottom: .18rem; }
    .existencia-compacto .existencia-producto-desc { display: block; white-space: nowrap; text-overflow: ellipsis; font-weight: 500; }
    .existencia-compacto .existencia-unidades { display: inline; margin-left: .3rem; }
    .existencia-compacto .existencia-col-toggle-cell { padding: 0 .3rem; }
    /* Ventana angosta (un tercio de la pantalla): se recortan los margenes laterales para que Cod. + Producto + Stock + Estado entren sin desplazar. */
    .existencia-sucursales-page.existencia-compacto { padding-left: 0; padding-right: 0; }
    .app-embed .container-fluid:has(> .existencia-sucursales-page.existencia-compacto) { padding-left: .35rem; padding-right: .35rem; }

    @@media (max-width: 767.98px) and (pointer: coarse) {
        .ex-barra { align-items: stretch; }
        .ex-ctl-sucursales, .ex-ctl-texto, .ex-ctl-ms { width: 100%; flex: 1 1 100%; }
        /* En pantallas chicas solo "Cod." queda fijo: dos columnas fijas se comerian casi todo el ancho. */
        .ex-col-prod, .ex-col-prod-cell { position: static; }
        /* En el celular el ancho fijo de 15/25 caracteres sobra: Cod. y Producto toman su contenido hasta un tope. */
        .ex-cod-txt { width: auto; max-width: 11ch; }
        .existencia-producto-desc, .existencia-compacto .existencia-producto-desc { width: auto; max-width: 15ch; }
    }
</style>

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/ventana-independiente.js")" asp-append-version="true"></script>
    <script>
        // Configuracion que el JS de la pantalla no puede saber solo: URLs, flags del servidor y limites de config.
        window.ExistenciaConfig = {
            popup: @(popup ? "true" : "false"),
            ventanaUrl: '@Url.Action("ExistenciaPorSucursales", "Stock", new { popup = true })',
            ventanaNombre: 'existenciaPorSucursales',
            buscarUrl: '@Url.Action("BuscarExistenciaPorSucursales", "Stock")',
            exportarUrl: '@Url.Action("ExportarExistencia", "Stock")',
            fechaMinimaUrl: '@Url.Action("ObtenerFechaMinimaExistencia", "Stock")',
            guardarPuntoUrl: '@Url.Action("GuardarPuntosStockSucursal", "Productos")',
            intervaloAutoMinutos: @intervaloAutoMinutos,
            maxAutoActualizaciones: 6,
            jitterInicialMaxSegundos: @jitterInicialMaxSegundos,
            reintentoCargaSegundos: @reintentoCargaSegundos,
            movimientoDisponible: @(movimientoDisponible ? "true" : "false"),
            // Modo movimiento (panel de stock del destino de Movimientos/Editar): ver existencia-movimiento.js.
            modoMovimiento: @(modoMovimiento ? "true" : "false"),
            canalMovimiento: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(canalMovimiento)),
            idSucursalMovimiento: @(ViewBag.IdSucursalMovimiento is int idSucMov ? idSucMov : 0),
            urlMovimiento: '@Url.Action("ExistenciaPorSucursales", "Stock")'
        };

        // "Ingresar pedido" (existencia-pedido.js): URLs, disponibilidad del motor y config del autoguardado en servidor (borradores).
        window.ExistenciaPedidoConfig = {
            disponible: @(pedidoDisponible ? "true" : "false"),
            consumoUrl: '@Url.Action("ConsumoPeriodo", "Stock")',
            preciosUrl: '@Url.Action("UltimosPreciosCompra", "Stock")',
            guardarUrl: '@Url.Action("Guardar", "Pedidos")',
            // De donde sale el importe estimado: textos y limite de "precio viejo" de una sola fuente (Negocio.PedidoTextos / Pedidos:DiasPrecioViejo).
            precios: {
                aclaracion: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Negocio.PedidoTextos.AclaracionPrecio)),
                etiquetaTotal: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Negocio.PedidoTextos.EtiquetaTotal(0))),
                etiquetaTotalParcial: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Negocio.PedidoTextos.EtiquetaTotal(1))),
                diasPrecioViejo: @WebCore.Helpers.PedidoPrecioSettings.DiasPrecioViejo,
                avisoPrecioViejo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Negocio.PedidoTextos.AvisoPrecioViejo(WebCore.Helpers.PedidoPrecioSettings.DiasPrecioViejo)))
            },
            borrador: {
                habilitado: @(pedidoBorradorHabilitado ? "true" : "false"),
                modulo: '@Entidades.BorradorGenerico.ModuloPedidoStock',
                idSucursal: @(ViewBag.PedidoIdSucursalBorrador is int idSucBorrador ? idSucBorrador : 0),
                idOperador: @(ViewBag.PedidoIdOperador is int idOpBorrador ? idOpBorrador : 0),
                nombreOperador: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.PedidoNombreOperador as string) ?? "")),
                latidoSegundos: @WebCore.Helpers.BorradorGenericoSettings.LatidoSegundos,
                maxLineas: @WebCore.Helpers.BorradorGenericoSettings.MaxLineas,
                urls: {
                    guardar: '@Url.Action("GuardarBorrador", "BorradoresGenerico")',
                    evento: '@Url.Action("EventoBorrador", "BorradoresGenerico")',
                    listar: '@Url.Action("ListarBorradores", "BorradoresGenerico")',
                    recuperar: '@Url.Action("RecuperarBorrador", "BorradoresGenerico")',
                    descartar: '@Url.Action("DescartarBorrador", "BorradoresGenerico")',
                    marcarFinalizado: '@Url.Action("MarcarFinalizado", "BorradoresGenerico")'
                }
            }
        };
    </script>
    <script src="@Url.Content("~/Scripts/app/existencia-sucursales.js")" asp-append-version="true"></script>
    @* Antes de existencia-pedido.js: el modulo del pedido usa window.BorradorGenerico (autoguardado en servidor) y, tras guardar,
       window.PedidoAcciones (ticket, PDF, mail y Excel; pedido-acciones.js). El ticket lo imprime ticket-print.js: _Layout ya lo trae,
       _LayoutEmbed (ventana independiente) no. *@
    <script src="@Url.Content("~/Scripts/app/borrador-generico.js")" asp-append-version="true"></script>
    @if (popup)
    {
        <script src="@Url.Content("~/Scripts/app/ticket-print.js")" asp-append-version="true"></script>
    }
    <script src="@Url.Content("~/Scripts/app/pedido-acciones.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/Scripts/app/existencia-pedido.js")" asp-append-version="true"></script>
    @* Despues de existencia-pedido.js: usa window.ExistenciaPedidoCalculo (la misma regla de la sugerencia). Inerte fuera del modo movimiento. *@
    <script src="@Url.Content("~/Scripts/app/existencia-movimiento.js")" asp-append-version="true"></script>
}
