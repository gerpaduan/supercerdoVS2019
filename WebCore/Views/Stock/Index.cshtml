    @@media (max-width: 767.98px) {
        .stock-acciones-grid,
        .stock-filtros-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            // BUG real encontrado: restoreStateIfNeeded() (mas abajo) navega solo si la URL
            // actual no tiene querystring -- pero el redirect de Guardar() tras un guardado
            // exitoso ("/Stock", sin parametros) tambien cae en ese caso, asi que la restauracion
            // de filtros pisaba esa pagina (y el TempData del cartel de exito) antes de que el
            // usuario llegara a verla. Este flag corta la restauracion cuando hay un aviso
            // pendiente. Ver docs/DECISIONS.md.
            var hayAlertaPendiente = @Html.Raw((TempData["AlertMsg"] != null) ? "true" : "false");

            var draftKeyToClear = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(stockDraftKeyToClear))";
            if (draftKeyToClear && window.localStorage) {
                try {
                    window.localStorage.removeItem(draftKeyToClear);
                } catch (e) {
                }
            }

            var storageKey = "stock_index_filters_v1";
            var form = document.querySelector('.stock-filtros-card form');
            var inputFechaDesde = document.getElementById('fechaDesde');
            var inputFechaHasta = form ? form.querySelector('input[name="fechaHasta"]') : null;
            var inputSucursal = form ? form.querySelector('select[name="idSucursal"]') : null;
            var inputTipoCompra = form ? form.querySelector('select[name="tipoCompra"]') : null;
            var alertaPendiente = document.getElementById("alertaFiltrosPendientesStock");
            var nativeFormSubmit = window.HTMLFormElement && window.HTMLFormElement.prototype
                ? window.HTMLFormElement.prototype.submit
                : null;
            var fechasAplicadas = {
                fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                fechaHasta: inputFechaHasta ? inputFechaHasta.value : ""
            };

            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                    window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
                }
            }

            function navegarConLoader(url, useReplace) {
                if (!url) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    if (useReplace) {
                        window.location.replace(url);
                    } else {
                        window.location.href = url;
                    }
                }, 40);
            }

            function submitConLoader() {
                if (!form) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    if (nativeFormSubmit) {
                        nativeFormSubmit.call(form);
                    } else {
                        form.submit();
                    }
                }, 40);
            }

            function buildState() {
                return {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : "",
                    idSucursal: inputSucursal ? inputSucursal.value : "",
                    tipoCompra: inputTipoCompra ? inputTipoCompra.value : ""
                };
            }

            function saveState() {
                if (!form || !window.sessionStorage) return;
                window.sessionStorage.setItem(storageKey, JSON.stringify(buildState()));
            }

            function hayFechasPendientes() {
                return !!inputFechaDesde && !!inputFechaHasta
                    && (inputFechaDesde.value !== fechasAplicadas.fechaDesde
                        || inputFechaHasta.value !== fechasAplicadas.fechaHasta);
            }

            var estadoBusqueda = document.getElementById("estadoBusquedaStock");
            var btnBuscarStock = document.getElementById("btnBuscarStock");
            var textoEstadoOk = estadoBusqueda ? estadoBusqueda.textContent : "";
            var textoEstadoPendiente = "Cambiaste las fechas: tocá Buscar para actualizar.";

            // Fechas cambiadas sin aplicar: en pantalla angosta se muestra la alerta amarilla; en escritorio (la
            // alerta esta oculta por CSS) el aviso es el texto de estado y el boton Buscar en ambar.
            function actualizarAvisoPendiente() {
                var pendiente = hayFechasPendientes();
                if (alertaPendiente) alertaPendiente.classList.toggle("d-none", !pendiente);
                if (btnBuscarStock) {
                    btnBuscarStock.classList.toggle("btn-warning", pendiente);
                    btnBuscarStock.classList.toggle("btn-primary", !pendiente);
                }
                if (estadoBusqueda) {
                    estadoBusqueda.textContent = pendiente ? textoEstadoPendiente : textoEstadoOk;
                    estadoBusqueda.title = pendiente ? textoEstadoPendiente : "";
                    estadoBusqueda.classList.toggle("fc-estado-pendiente", pendiente);
                }
            }

            function setBuscandoStock(mensaje) {
                var btnBuscar = document.getElementById("btnBuscarStock");
                var btnTexto = btnBuscar ? btnBuscar.querySelector(".btn-buscar-texto") : null;
                var estado = document.getElementById("estadoBusquedaStock");

                if (btnBuscar) {
                    btnBuscar.disabled = true;
                }

                if (btnTexto) {
                    btnTexto.textContent = " Cargando...";
                }

                if (estado) {
                    estado.textContent = mensaje || "Actualizando búsqueda...";
                }
            }

            function enviarFiltrosEnVivo() {
                if (!form) return;

                saveState();
                setBuscandoStock("Actualizando búsqueda en vivo...");

                if (hayFechasPendientes()) {
                    if (inputFechaDesde) inputFechaDesde.value = fechasAplicadas.fechaDesde;
                    if (inputFechaHasta) inputFechaHasta.value = fechasAplicadas.fechaHasta;
                    saveState();
                }

                submitConLoader();
            }

            function restoreStateIfNeeded() {
                if (!form || !window.sessionStorage || window.location.search || hayAlertaPendiente) return;

                var raw = window.sessionStorage.getItem(storageKey);
                if (!raw) return;

                try {
                    var state = JSON.parse(raw);
                    var params = new URLSearchParams();
                    if (state.fechaDesde) params.set("fechaDesde", state.fechaDesde);
                    if (state.fechaHasta) params.set("fechaHasta", state.fechaHasta);
                    if (state.idSucursal) params.set("idSucursal", state.idSucursal);
                    if (state.tipoCompra) params.set("tipoCompra", state.tipoCompra);

                    var query = params.toString();
                    if (query) {
                        navegarConLoader(form.action + "?" + query, true);
                    }
                } catch (e) {
                    window.sessionStorage.removeItem(storageKey);
                }
            }

            restoreStateIfNeeded();
            saveState();
            actualizarAvisoPendiente();

            if (form) {
                form.addEventListener("submit", function (event) {
                    if (form.dataset.loadingSubmitPending === "true") {
                        form.dataset.loadingSubmitPending = "";
                        return;
                    }

                    event.preventDefault();
                    fechasAplicadas = {
                        fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                        fechaHasta: inputFechaHasta ? inputFechaHasta.value : ""
                    };
                    saveState();
                    var btnBuscar = document.getElementById("btnBuscarStock");
                    var btnTexto = btnBuscar ? btnBuscar.querySelector(".btn-buscar-texto") : null;
                    var estado = document.getElementById("estadoBusquedaStock");

                    if (btnBuscar) {
                        btnBuscar.disabled = true;
                    }

                    if (btnTexto) {
                        btnTexto.textContent = " Cargando...";
                    }

                    if (estado) {
                        estado.textContent = "Actualizando búsqueda...";
                    }
                    form.dataset.loadingSubmitPending = "true";
                    submitConLoader();
                });
                form.querySelectorAll("input, select").forEach(function (el) {
                    el.addEventListener("change", saveState);
                    el.addEventListener("input", saveState);
                });
            }

            if (inputFechaDesde) {
                inputFechaDesde.addEventListener("change", actualizarAvisoPendiente);
            }

            if (inputFechaHasta) {
                inputFechaHasta.addEventListener("change", actualizarAvisoPendiente);
            }

            if (inputSucursal) {
                inputSucursal.addEventListener("change", enviarFiltrosEnVivo);
            }

            if (inputTipoCompra) {
                inputTipoCompra.addEventListener("change", enviarFiltrosEnVivo);
            }

            document.querySelectorAll(".stock-btn-lineas, .stock-action-btn").forEach(function (link) {
                link.addEventListener("click", function (event) {
                    var href = link.getAttribute("href") || "";
                    if (!href) return;
                    event.preventDefault();
                    navegarConLoader(href, false);
                });
            });

            var successAlert = document.getElementById("stockSuccessAlert");
            if (successAlert) {
                window.setTimeout(function () {
                    $(successAlert).alert("close");
                }, 2500);
            }

            const switchVista = document.getElementById("switchVistaCompletaStock");
            if (!switchVista) return;

            function syncIcon(button, expanded) {
                if (!button) return;
                button.setAttribute("aria-expanded", expanded ? "true" : "false");
                const icon = button.querySelector("i");
                if (icon) {
                    icon.classList.toggle("fa-chevron-down", !expanded);
                    icon.classList.toggle("fa-chevron-up", expanded);
                }
            }

            function cargarDetalleStock(detalle) {
                if (!detalle) return;

                const contenedor = detalle.querySelector(".stock-detalle-lazy");
                if (!contenedor) return;

                if (contenedor.getAttribute("data-loaded") === "true"
                    || contenedor.getAttribute("data-loading") === "true") {
                    return;
                }

                const url = contenedor.getAttribute("data-url");
                if (!url) return;

                contenedor.setAttribute("data-loading", "true");
                contenedor.innerHTML = '<div class="text-muted">Cargando detalle...</div>';

                $.get(url)
                    .done(function (html) {
                        contenedor.innerHTML = html;
                        contenedor.setAttribute("data-loaded", "true");
                    })
                    .fail(function () {
                        contenedor.innerHTML = '<div class="text-danger">No se pudo cargar el detalle del movimiento.</div>';
                    })
                    .always(function () {
                        contenedor.removeAttribute("data-loading");
                    });
            }

            document.addEventListener("click", function (e) {
                const btn = e.target.closest(".btn-detalles-stock");
                if (!btn) return;

                e.preventDefault();
                const selector = btn.getAttribute("data-target");
                const detalle = selector ? document.querySelector(selector) : null;
                if (!detalle) return;

                cargarDetalleStock(detalle);

                const expanded = detalle.classList.contains("show");
                $(detalle).collapse(expanded ? "hide" : "show");
                syncIcon(btn, !expanded);
            });

            document.addEventListener("dblclick", function (e) {
                if (e.target.closest("a, button")) return;
                const row = e.target.closest("tr");
                if (!row) return;
                const btnDetalle = row.querySelector(".btn-detalles-stock");
                if (btnDetalle) btnDetalle.click();
            });

            switchVista.addEventListener("change", function () {
                const expandir = switchVista.checked;
                document.querySelectorAll(".stock-detalle-collapse").forEach(function (detalle) {
                    if (expandir) {
                        cargarDetalleStock(detalle);
                    }
                    $(detalle).collapse(expandir ? "show" : "hide");
                    const btn = document.querySelector('.btn-detalles-stock[data-target="#' + detalle.id + '"]');
                    syncIcon(btn, expandir);
                });
            });

            function escapeHtmlStock(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function clearPorcentajeWarningStock() {
                $('#stockPorcentajeWarning').addClass('d-none').text('');
            }

            function showPorcentajeWarningStock(text) {
                $('#stockPorcentajeWarning').text(text || '').removeClass('d-none');
            }

            function renderTablaPorcentajesStock($table, tabla, emptyText) {
                var $thead = $table.find('thead');
                var $tbody = $table.find('tbody');
                var columnas = tabla && $.isArray(tabla.columnas) ? tabla.columnas : [];
                var filas = tabla && $.isArray(tabla.filas) ? tabla.filas : [];
                var visibles = $.grep(columnas, function (col) { return !col.oculta; });
                var headHtml = '';
                var bodyHtml = '';

                if (!visibles.length) {
                    $thead.html('');
                    $tbody.html('<tr><td class="text-center text-muted py-3">' + escapeHtmlStock(emptyText || 'Sin datos.') + '</td></tr>');
                    return;
                }

                headHtml += '<tr>';
                $.each(columnas, function (_, col) {
                    if (col.oculta) return;
                    headHtml += '<th' + (col.alineacionDerecha ? ' class="text-right"' : '') + '>' + escapeHtmlStock(col.nombre || '') + '</th>';
                });
                headHtml += '</tr>';

                if (!filas.length) {
                    bodyHtml = '<tr><td colspan="' + visibles.length + '" class="text-center text-muted py-3">' + escapeHtmlStock(emptyText || 'Sin datos.') + '</td></tr>';
                } else {
                    $.each(filas, function (_, fila) {
                        bodyHtml += '<tr>';
                        $.each(columnas, function (colIndex, col) {
                            if (col.oculta) return;
                            var valor = $.isArray(fila) ? (fila[colIndex] || '') : '';
                            bodyHtml += '<td' + (col.alineacionDerecha ? ' class="text-right"' : '') + '>' + escapeHtmlStock(valor) + '</td>';
                        });
                        bodyHtml += '</tr>';
                    });
                }

                $thead.html(headHtml);
                $tbody.html(bodyHtml);
            }

            function actualizarEstadoAjustePesajeStock(estado) {
                var texto = $.trim(estado || '');
                var actualizado = texto.toLowerCase() === 'actualizado';
                $('#lblEstadoAjusteModalStock')
                    .text(texto || '-')
                    .toggleClass('text-success', actualizado)
                    .toggleClass('text-danger', !actualizado);
            }

            function cargarPorcentajesPesajeStock(idCompra) {
                clearPorcentajeWarningStock();
                $('#stockIndexPesajeIdActual').val(idCompra || 0);
                $('#btnGenerarAjustePesajeStock').prop('disabled', true);
                actualizarEstadoAjustePesajeStock('-');
                renderTablaPorcentajesStock($('#tablaPromMediasStock'), null, 'Cargando...');
                renderTablaPorcentajesStock($('#tablaPorcCortesStock'), null, 'Cargando...');

                $.ajax({
                    url: '@Url.Action("VerPorcentajesPesaje", "Stock")',
                    method: 'POST',
                    data: {
                        idCompra: idCompra
                    }
                }).done(function (resp) {
                    if (!resp || resp.ok !== true) {
                        showPorcentajeWarningStock((resp && resp.mensaje) || 'No se pudo obtener el análisis del pesaje.');
                        renderTablaPorcentajesStock($('#tablaPromMediasStock'), null, 'Sin datos.');
                        renderTablaPorcentajesStock($('#tablaPorcCortesStock'), null, 'Sin datos.');
                        return;
                    }

                    actualizarEstadoAjustePesajeStock(resp.estado || '');
                    $('#btnGenerarAjustePesajeStock').prop('disabled', resp.puedeGenerarAjuste !== true);
                    renderTablaPorcentajesStock($('#tablaPromMediasStock'), resp.promMedias, 'Sin datos de promedios.');
                    renderTablaPorcentajesStock($('#tablaPorcCortesStock'), resp.porcCortes, 'Sin datos de porcentajes.');
                }).fail(function () {
                    showPorcentajeWarningStock('No se pudo obtener el análisis del pesaje.');
                    renderTablaPorcentajesStock($('#tablaPromMediasStock'), null, 'Sin datos.');
                    renderTablaPorcentajesStock($('#tablaPorcCortesStock'), null, 'Sin datos.');
                });
            }

            $(document).on('click', '.btn-ver-porcentaje-pesaje-index', function () {
                var idCompra = parseInt($(this).data('id-compra'), 10) || 0;
                if (idCompra <= 0) {
                    return;
                }

                $('#modalPorcentajesPesajeStock').modal('show');
                cargarPorcentajesPesajeStock(idCompra);
            });

            $('#btnGenerarAjustePesajeStock').on('click', function () {
                var idCompra = parseInt($('#stockIndexPesajeIdActual').val(), 10) || 0;
                var token = $('input[name="__RequestVerificationToken"]').first().val() || '';

                if (idCompra <= 0 || !token) {
                    showPorcentajeWarningStock('No se pudo identificar el pesaje.');
                    return;
                }

                clearPorcentajeWarningStock();
                $('#btnGenerarAjustePesajeStock').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("GenerarAjustePesaje", "Stock")',
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: token,
                        idCompra: idCompra
                    }
                }).done(function (resp) {
                    if (!resp || resp.ok !== true) {
                        var mensajeError = (resp && resp.mensaje) || 'No se pudo generar el ajuste.';
                        showPorcentajeWarningStock(mensajeError);
                        if ($.trim($('#lblEstadoAjusteModalStock').text() || '').toLowerCase() !== 'actualizado') {
                            $('#btnGenerarAjustePesajeStock').prop('disabled', false);
                        }
                        return;
                    }

                    actualizarEstadoAjustePesajeStock(resp.estado || 'Actualizado');
                    $('#modalPorcentajesPesajeStock').modal('hide');

                    if (window.Swal && typeof window.Swal.fire === 'function') {
                        window.Swal.fire({
                            icon: 'success',
                            title: 'Ajuste generado correctamente',
                            text: resp.mensaje || 'El Ajuste de Stock se realizó correctamente.'
                        }).then(function () {
                            window.location.reload();
                        });
                    } else {
                        window.location.reload();
                    }
                }).fail(function () {
                    showPorcentajeWarningStock('No se pudo generar el ajuste.');
                    if ($.trim($('#lblEstadoAjusteModalStock').text() || '').toLowerCase() !== 'actualizado') {
                        $('#btnGenerarAjustePesajeStock').prop('disabled', false);
                    }
                });
            });
        })();
    </script>
}
