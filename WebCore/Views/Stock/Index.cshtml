        line-height: 1.05;
        padding-top: .42rem;
        padding-bottom: .42rem;
    }

    .stock-index-page .tabla-full .btn-sm {
        padding: .18rem .42rem;
        line-height: 1.15;
    }

    .modal-stock-compact .modal-content {
        border-radius: .75rem;
    }

    .modal-stock-compact .modal-header {
