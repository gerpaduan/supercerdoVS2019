@model WebCore.Models.CompraIndexVm
@using System
@using System.Collections.Generic
@using System.Data

@{
    ViewBag.Title = "Stock";

    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    int idSucursal = ViewBag.IdSucursal != null ? (int)ViewBag.IdSucursal : 0;
    string tipoCompra = ViewBag.TipoCompra as string ?? "Ver Todos";
    DateTime fechaDesde = ViewBag.FechaDesde != null ? (DateTime)ViewBag.FechaDesde : DateTime.Today.AddDays(-7);
    DateTime fechaHasta = ViewBag.FechaHasta != null ? (DateTime)ViewBag.FechaHasta : DateTime.Today;
    float totalKg = ViewBag.TotalKg != null ? (float)ViewBag.TotalKg : 0f;
    string stockDraftKeyToClear = TempData["StockDraftKeyToClear"] as string ?? "";
}

<div class="container-fluid stock-index-page">
    @* Bloque superior: en escritorio (>= 1200 px) los filtros van en una sola fila (fechas primero) y debajo una barra con
       Total Kg, estado, "Ver detalles" y todos los botones (Ingreso ... Ver eliminados); las tarjetas de botones se disuelven
       (fc-contents). Por debajo de 1200 px conserva el orden de siempre. Estilos en Shared/_FiltrosCompactosStyles. *@
    <div class="fc-top stock-top">
    <div class="d-flex justify-content-end mb-3 fc-contents">
        <a class="btn btn-outline-primary stock-btn-lineas" href="@Url.Action("Lineas", "Stock", new { idSucursal = idSucursal, tipoCompra = tipoCompra, fechaDesde = fechaDesde.ToString("yyyy-MM-dd"), fechaHasta = fechaHasta.ToString("yyyy-MM-dd") })">
            <i class="fas fa-stream mr-1"></i> Ver lineas
        </a>
        @if (ViewBag.PuedeVerEliminados == true)
        {
            <a class="btn btn-outline-danger ml-2 stock-btn-lineas" href="@Url.Action("Index", "RegistrosEliminados", new { modulo = "STOCK" })" id="btnVerEliminadosStockIndex">
                <i class="fas fa-trash-alt mr-1"></i> Ver eliminados
            </a>
        }
    </div>

    <div class="card shadow-sm mb-3 stock-acciones-card fc-contents">
        <div class="card-body">
            <div class="stock-acciones-grid">
                <a class="btn btn-success stock-action-btn" href="@Url.Action("Nuevo", "Stock", new { tipoCompra = "Ingreso Stock" })">
                    <i class="fas fa-box-open"></i>
                    <span>Ingreso</span>
                </a>
                <a class="btn btn-danger stock-action-btn" href="@Url.Action("Nuevo", "Stock", new { tipoCompra = "Egreso Stock" })">
                    <i class="fas fa-minus-circle"></i>
                    <span>Egreso</span>
                </a>
                <a class="btn btn-primary stock-action-btn" href="@Url.Action("Nuevo", "Stock", new { tipoCompra = "Cierre Stock" })">
                    <i class="fas fa-balance-scale"></i>
                    <span>Cierre</span>
                </a>
                <a class="btn btn-info stock-action-btn" href="@Url.Action("Nuevo", "Stock", new { tipoCompra = "Pesaje Cortes" })">
                    <i class="fas fa-weight-hanging"></i>
                    <span>Pesaje</span>
                </a>
                <a class="btn btn-warning stock-action-btn" href="@Url.Action("Nuevo", "Stock", new { tipoCompra = "Ajuste Stock" })">
                    <i class="fas fa-sliders-h"></i>
                    <span>Ajuste</span>
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3 stock-filtros-card fc-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index", "Stock")">
                <div class="stock-filtros-stack fc-grid">
                    <div id="alertaFiltrosPendientesStock" class="alert alert-warning d-none mb-0 fc-alerta" role="alert">
                        Cambiaste las fechas. Presioná <strong>Buscar</strong> para actualizar los resultados.
                    </div>

                    <div class="stock-filtros-row stock-filtros-row-sucursal fc-fila">
                        <div class="form-group mb-0 fc-c3">
                            <label class="stock-filtro-label">Sucursal</label>
                            <select name="idSucursal" class="form-control" id="idSucursalStock">
                                <option value="0" selected="@(idSucursal == 0 ? "selected" : null)">Todas</option>
                                @foreach (var s in sucursales)
                                {
                                    <option value="@s.IdSucursal" selected="@(s.IdSucursal == idSucursal ? "selected" : null)">@s.SucursalNombre</option>
                                }
                            </select>
                        </div>

                        <div class="form-group mb-0 fc-c4">
                            <label class="stock-filtro-label">Acción</label>
                            <select name="tipoCompra" class="form-control" id="tipoCompraStock">
                                <option value="Ver Todos" selected="@(tipoCompra == "Ver Todos" ? "selected" : null)">Todas</option>
                                <option value="Ingreso Stock" selected="@(tipoCompra == "Ingreso Stock" ? "selected" : null)">Ingreso</option>
                                <option value="Egreso Stock" selected="@(tipoCompra == "Egreso Stock" ? "selected" : null)">Egreso</option>
                                <option value="Cierre Stock" selected="@(tipoCompra == "Cierre Stock" ? "selected" : null)">Cierre</option>
                                <option value="Pesaje Cortes" selected="@(tipoCompra == "Pesaje Cortes" ? "selected" : null)">Pesaje</option>
                                <option value="Ajuste Stock" selected="@(tipoCompra == "Ajuste Stock" ? "selected" : null)">Ajuste</option>
                            </select>
                        </div>
                    </div>

                    <div class="stock-filtros-row stock-filtros-row-fechas fc-fila">
                        <div class="form-group mb-0 fc-c1">
                            <label class="stock-filtro-label">Desde</label>
                            <input type="date" id="fechaDesde" name="fechaDesde" value="@fechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
                            @Html.Partial("_AdvertenciaPermisoFecha")
                        </div>

                        <div class="form-group mb-0 fc-c2">
                            <label class="stock-filtro-label">Hasta</label>
                            <input type="date" name="fechaHasta" value="@fechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>

                        <div class="form-group mb-0 stock-filtro-accion fc-c5">
                            <label class="stock-filtro-label d-none d-lg-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block" id="btnBuscarStock">
                                <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Estado de la busqueda: vive fuera del form para ocupar un lugar en la barra de escritorio.
       En escritorio tambien avisa "Cambiaste las fechas" (ahi se oculta la alerta amarilla). *@
    <div id="estadoBusquedaStock" class="fc-estado text-muted small mb-2">Resultados actualizados.</div>

    <div class="row mb-3 fc-totales">
        <div class="col-12 col-md-4">
            <div class="card border-left-primary shadow-sm h-100 index-total-card">
                <div class="card-body">
                    <div class="index-total-label text-xs font-weight-bold text-primary text-uppercase mb-1">Total Kg</div>
                    <div class="index-total-value font-weight-bold text-gray-800">@totalKg.ToString("N3")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end align-items-center mb-2 fc-vista">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="switchVistaCompletaStock">
            <label class="custom-control-label" for="switchVistaCompletaStock">Ver detalles</label>
        </div>
    </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @Html.Partial("~/Views/Stock/_StockTabla.cshtml", Model)
        </div>
    </div>

    <div class="d-none">
        @Html.AntiForgeryToken()
    </div>

    <div class="modal fade modal-stock-compact" id="modalPorcentajesPesajeStock" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title">Ver Porcentaje Cortes</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="stockIndexPesajeIdActual" value="0" />
                    <div id="stockPorcentajeWarning" class="alert alert-warning py-2 px-3 mb-3 d-none"></div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                        <div class="mb-2">
                            <span class="font-weight-bold">Estado:</span>
                            <span id="lblEstadoAjusteModalStock" class="font-weight-bold text-danger">-</span>
                        </div>
                        <button type="button" class="btn btn-success mb-2" id="btnGenerarAjustePesajeStock">
                            <i class="fas fa-balance-scale mr-1"></i> Generar Ajuste
                        </button>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered mb-0 stock-table-compact" id="tablaPromMediasStock">
                            <thead class="thead-light"></thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0 stock-table-compact" id="tablaPorcCortesStock">
                            <thead class="thead-light"></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Views/Shared/_FiltrosCompactosStyles.cshtml")

<style>
    .stock-acciones-card,
    .stock-filtros-card {
        border: 1px solid #e9ecef;
        border-radius: .75rem;
    }

    /* Fila unica de escritorio (_FiltrosCompactosStyles): desde, hasta, sucursal, accion, Buscar.
       minmax: sucursal y accion crecen hasta su maximo y, si el ancho aprieta, bajan al minimo. */
    .stock-filtros-card {
        --fc-cols: 8.6rem 8.6rem minmax(8rem, 14rem) minmax(7rem, 10rem) 5.5rem;
    }

    /* Escritorio: las tarjetas de botones se disuelven y sus botones pasan a la barra (Ingreso ... Ajuste,
       Ver lineas, Ver eliminados), a la misma altura que Buscar. */
    @@media (min-width: 1200px) {
        body.app-shell .stock-top .stock-acciones-card .card-body,
        body.app-shell .stock-top .stock-acciones-grid {
            display: contents;
        }

        body.app-shell .stock-top .stock-action-btn {
            order: 4;
            min-height: 1.95rem;
            padding: .15rem .6rem;
            font-size: .84rem;
            white-space: nowrap;
        }

        body.app-shell .stock-top .stock-btn-lineas {
            order: 5;
            min-height: 1.95rem;
            margin-left: 0 !important;
            white-space: nowrap;
        }

        /* La barra de Stock va llena: el aviso de fechas pendientes se cortaba, asi que baja a su propio renglon. */
        body.app-shell .stock-top > .fc-estado.fc-estado-pendiente {
            order: 9;
            flex: 0 0 100%;
        }
    }

    /* 1200-1299 px: con el menu lateral quedan ~940 px utiles y la barra (Total Kg, Ver detalles y siete botones)
       no entra en un renglon: "Ver eliminados" baja al segundo. Se ajusta el relleno para que baje lo menos posible
       y los dos botones de la derecha se alinean al borde derecho en vez de quedar huerfanos a la izquierda. */
    @@media (min-width: 1200px) and (max-width: 1299.98px) {
        body.app-shell .stock-top {
            column-gap: .5rem;
        }

        body.app-shell .stock-top .stock-action-btn {
            padding: .15rem .4rem;
        }

        body.app-shell .stock-top .stock-btn-lineas {
            padding: .15rem .4rem;
            margin-left: auto !important;
        }
    }

    .stock-index-page .card-body {
        padding: .72rem .9rem;
    }

    .stock-acciones-grid,
    .stock-filtros-stack,
    .stock-filtros-row {
        display: grid;
        gap: .65rem;
    }

    .stock-filtros-card {
        font-size: .9rem;
    }

    .stock-filtros-card .card-body {
        padding: .68rem .82rem;
    }

    .stock-filtro-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .18rem;
    }

    .stock-filtros-card .form-control,
    .stock-filtros-card .btn,
    .stock-action-btn {
        min-height: 2.35rem;
        border-radius: .5rem;
    }

    .stock-filtros-card .form-control,
    .stock-filtros-card .btn {
        font-size: .87rem;
        padding: .32rem .62rem;
    }

    .stock-filtros-card .alert,
    .stock-filtros-card .small,
    .stock-filtros-card .text-muted,
    .stock-filtros-card .btn-buscar-texto {
        font-size: .8rem !important;
    }

    .stock-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .32rem;
        font-weight: 600;
        font-size: .92rem;
        padding: .1rem .42rem;
        min-height: 1.65rem;
        line-height: 1;
    }

    .stock-action-btn i {
        font-size: inherit;
        line-height: 1;
    }

    .stock-action-btn span {
        line-height: 1;
    }

    .stock-btn-lineas {
