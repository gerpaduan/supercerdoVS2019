@model WebCore.Models.EmpleadoHistorialVm
@{
    ViewBag.Title = "Historial de " + Model.EmpleadoNombre;
}

<div class="container-fluid empleados-historial-page">
    <h4 class="mb-3">
        Historial — @Model.EmpleadoNombre
        <button type="button" class="btn btn-sm btn-link p-0 ml-1" data-bs-toggle="modal" data-bs-target="#modalInfoHistorial" title="Cómo usar esta pantalla">
            <i class="fas fa-info-circle"></i>
        </button>
    </h4>

    @{
        var primerDiaEsteMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var primerDiaMesAnterior = primerDiaEsteMes.AddMonths(-1);
        var ultimoDiaMesAnterior = primerDiaEsteMes.AddDays(-1);
    }
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form asp-controller="Empleados" asp-action="Historial" method="get" class="form-inline mb-2">
                <input type="hidden" name="id" value="@Model.IdEmpleado" />
                <label class="mr-2">Desde</label>
                <input type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" class="form-control mr-3" />
                <label class="mr-2">Hasta</label>
                <input type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" class="form-control mr-3" />
                <button type="submit" class="btn btn-outline-secondary">Filtrar (otro período)</button>
            </form>
            <a class="btn btn-sm btn-outline-secondary mr-1" href="@Url.Action("Historial", new { id = Model.IdEmpleado, desde = primerDiaEsteMes.ToString("yyyy-MM-dd"), hasta = DateTime.Today.ToString("yyyy-MM-dd") })">Este mes</a>
            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Historial", new { id = Model.IdEmpleado, desde = primerDiaMesAnterior.ToString("yyyy-MM-dd"), hasta = ultimoDiaMesAnterior.ToString("yyyy-MM-dd") })">Mes anterior</a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header">Tarifas (todo el historial, vigentes a la fecha "Hasta")</div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="thead-light">
                    <tr><th>Turno</th><th>Día</th><th>Valor</th><th>Vigente desde</th></tr>
                </thead>
                <tbody>
                    @if (Model.Tarifas == null || Model.Tarifas.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No hay tarifas cargadas.</td></tr>
                    }
                    else
                    {
                        foreach (var t in Model.Tarifas.OrderByDescending(t => t.VigenteDesde))
                        {
                            <tr>
                                <td>@(t.Turno == Entidades.Turno.Manana ? "Mañana" : t.Turno == Entidades.Turno.Tarde ? "Tarde" : "General")</td>
                                <td>@(t.DiaSemana?.ToString() ?? "Todos")</td>
                                <td>@t.Valor.ToString("N2")</td>
                                <td>@t.VigenteDesde.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">Liquidaciones en el período</div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="thead-light">
                    <tr><th>Período</th><th>Total</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @if (Model.Liquidaciones == null || Model.Liquidaciones.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">No hay liquidaciones en este rango.</td></tr>
                    }
                    else
                    {
                        foreach (var l in Model.Liquidaciones.OrderByDescending(l => l.PeriodoDesde))
                        {
                            <tr>
                                <td>@l.PeriodoDesde.ToString("dd/MM/yyyy HH:mm") al @l.PeriodoHasta.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>$@l.TotalLiquidado.ToString("N2")</td>
                                <td>
                                    <span class="badge @(l.Estado == Entidades.LiquidacionSueldo.estadoLiquidacion.Confirmada ? "badge-success" : "badge-secondary")">@l.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <a href="@Url.Action("Index", "Empleados")" class="btn btn-outline-secondary mt-3">Volver</a>
</div>

<div class="modal fade" id="modalInfoHistorial" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable empleados-historial-page">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cómo usar "Historial" (admin)</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>"Este mes"/"Mes anterior" son atajos rápidos para el rango de fechas; "Filtrar (otro período)" permite elegir cualquier fecha desde/hasta a mano.</p>
                <p>"Tarifas" muestra todo el historial de tarifas cargadas al empleado (nunca se borran, cada cambio agrega una nueva vigente desde una fecha) — la fila que aplica en un momento dado es la más reciente con "Vigente desde" anterior o igual a esa fecha, para el turno/día que corresponda.</p>
                <p>"Liquidaciones en el período" muestra los sueldos ya calculados/confirmados de este empleado dentro del rango de fechas filtrado.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .empleados-historial-page {
        font-size: .9rem;
    }

    .empleados-historial-page .card-body {
        padding: .82rem 1rem;
    }

    .empleados-historial-page .form-control,
    .empleados-historial-page .btn {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .empleados-historial-page .table {
        font-size: .84rem;
    }

    .empleados-historial-page .table th,
    .empleados-historial-page .table td {
        padding: .42rem .58rem;
        vertical-align: middle;
    }

    .empleados-historial-page .table thead th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .empleados-historial-page .badge {
        font-size: .7rem;
    }
</style>
