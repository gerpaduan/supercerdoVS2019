@model WebCore.Models.JornadasIndexVm
@{
    ViewBag.Title = "Jornadas";
}

<div class="container-fluid jornadas-index-page">
    <h4 class="mb-3">Jornadas</h4>

    @if (Model.CorreccionesPendientes != null && Model.CorreccionesPendientes.Count > 0)
    {
        <div class="card shadow-sm mb-3 border-warning">
            <div class="card-header bg-warning-light">
                <i class="fas fa-exclamation-triangle text-warning mr-1"></i>
                Correcciones pendientes de revisar (@Model.CorreccionesPendientes.Count)
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="thead-light"><tr><th>Fecha</th><th>Entrada</th><th>Salida</th><th>Motivo</th><th>Corregido el</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.CorreccionesPendientes)
                        {
                            <tr>
                                <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@(r.HoraEntrada?.ToString(@"hh\:mm") ?? "-")</td>
                                <td>@(r.HoraSalida?.ToString(@"hh\:mm") ?? "-")</td>
                                <td>@r.MotivoCorreccion</td>
                                <td>@(r.Actualizado?.ToString("dd/MM/yyyy HH:mm") ?? "(fichaje con motivo)")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form asp-controller="Jornadas" asp-action="Index" method="get" class="form-inline">
                <label class="mr-2">Empleado</label>
                <select name="idEmpleado" class="form-control mr-3" onchange="this.form.submit()">
                    <option value="">-- Elegir --</option>
                    @foreach (var e in Model.Empleados)
                    {
                        <option value="@e.Id" selected="@(Model.IdEmpleadoSeleccionado == e.Id)">@e.RazonSocial (@e.Legajo)</option>
                    }
                </select>
                <label class="mr-2">Desde</label>
                <input type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" class="form-control mr-3" />
                <label class="mr-2">Hasta</label>
                <input type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" class="form-control mr-3" />
                <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
            </form>
        </div>
    </div>

    @if (Model.IdEmpleadoSeleccionado.HasValue)
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead class="thead-light">
                        <tr><th>Fecha</th><th>Turno</th><th>Entrada</th><th>Salida</th><th>Cantidad</th><th>Corregir</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Registros == null || Model.Registros.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No hay marcaciones en este rango.</td></tr>
                        }
                        else
                        {
                            foreach (var r in Model.Registros)
                            {
                                <tr>
                                    <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@(r.Turno == Entidades.Turno.Manana ? "Mañana" : r.Turno == Entidades.Turno.Tarde ? "Tarde" : "-")</td>
                                    <td>@(r.HoraEntrada?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(r.HoraSalida?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(r.Cantidad?.ToString("0.##") ?? "-")</td>
                                    <td>
                                        <form asp-controller="Jornadas" asp-action="Corregir" method="post" class="form-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idRegistroJornada" value="@r.Id" />
                                            <input type="hidden" name="idEmpleadoVolver" value="@Model.IdEmpleadoSeleccionado" />
                                            <input type="time" name="horaEntrada" value="@(r.HoraEntrada?.ToString(@"hh\:mm"))" class="form-control form-control-sm mr-1" style="width:100px;" />
                                            <input type="time" name="horaSalida" value="@(r.HoraSalida?.ToString(@"hh\:mm"))" class="form-control form-control-sm mr-1" style="width:100px;" />
                                            <input type="number" step="0.5" name="cantidad" value="@r.Cantidad" class="form-control form-control-sm mr-1" style="width:80px;" />
                                            <input type="text" name="motivo" class="form-control form-control-sm mr-1" placeholder="Motivo (obligatorio)" required style="width:160px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Corregir</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .jornadas-index-page {
        font-size: .9rem;
    }

    .jornadas-index-page .card-body {
        padding: .82rem 1rem;
    }

    .jornadas-index-page .form-control {
        font-size: .87rem !important;
        min-height: 2.3rem !important;
        padding: .32rem .58rem !important;
    }

    .jornadas-index-page .form-control-sm {
        font-size: .8rem !important;
        min-height: 1.9rem !important;
        padding: .22rem .45rem !important;
    }

    .jornadas-index-page .table {
        font-size: .84rem;
    }

    .jornadas-index-page .table th,
    .jornadas-index-page .table td {
        padding: .42rem .58rem;
        vertical-align: middle;
    }

    .jornadas-index-page .table thead th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .jornadas-index-page .btn {
        font-size: .78rem;
        padding: .23rem .5rem;
    }
</style>
