@model WebCore.Models.MiJornadaVm
@{
    ViewBag.Title = "Mi jornada";
}

<div class="container-fluid mi-jornada-page">
    <h4 class="mb-3">
        Mi jornada — @Model.EmpleadoNombre
        <button type="button" class="btn btn-sm btn-link p-0 ml-1" data-bs-toggle="modal" data-bs-target="#modalInfoMiJornada" title="Cómo usar esta pantalla">
            <i class="fas fa-info-circle"></i>
        </button>
    </h4>

    @if (!string.IsNullOrEmpty(Model.VacacionAvisoHasta))
    {
        <div class="alert alert-info">Estás de vacaciones hasta el @Model.VacacionAvisoHasta. No hace falta que marques tu jornada estos días.</div>
    }

    @if (!Model.RequiereRegistro)
    {
        <div class="alert alert-secondary">
            Tu forma de liquidación (@Model.FormaLiquidacion) es de sueldo fijo por período: no necesitás marcar tu jornada.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body text-center py-4">
                @if (Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.Hora)
                {
                    <form asp-controller="Jornadas" asp-action="MarcarHora" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-lg @(Model.EstaAbierto ? "btn-danger" : "btn-success") px-5">
                            @(Model.EstaAbierto ? "Marcar salida" : "Marcar entrada")
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Jornadas" asp-action="MarcarJornada" method="post" class="d-inline mr-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="turno" value="@Entidades.Turno.Manana" />
                        <button type="submit" class="btn btn-lg btn-success px-4">
                            Cargar @(Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.MediaJornada ? "media jornada" : "jornada") — Mañana
                        </button>
                    </form>
                    <form asp-controller="Jornadas" asp-action="MarcarJornada" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="turno" value="@Entidades.Turno.Tarde" />
                        <button type="submit" class="btn btn-lg btn-primary px-4">
                            Cargar @(Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.MediaJornada ? "media jornada" : "jornada") — Tarde
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">@Model.MarcacionesTitulo</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="thead-light"><tr><th>Fecha</th><th>Turno</th><th>Entrada</th><th>Salida</th><th>Cantidad</th><th>Observación</th></tr></thead>
                    <tbody>
                        @if (Model.MarcacionesRecientes == null || Model.MarcacionesRecientes.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No hay marcaciones recientes.</td></tr>
                        }
                        else
                        {
                            foreach (var m in Model.MarcacionesRecientes.OrderByDescending(m => m.Fecha).ThenByDescending(m => m.HoraEntrada))
                            {
                                <tr>
                                    <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@(m.Turno == Entidades.Turno.Manana ? "Mañana" : m.Turno == Entidades.Turno.Tarde ? "Tarde" : "-")</td>
                                    <td>@(m.HoraEntrada?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(m.HoraSalida?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(m.Cantidad?.ToString("0.##") ?? "-")</td>
                                    <td>@(string.IsNullOrEmpty(m.Observaciones) ? "-" : m.Observaciones)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#colAgregarPropio">
                    ¿Te olvidaste de fichar un día anterior? Cargalo acá
                </button>
            </div>
            <div class="collapse" id="colAgregarPropio">
                <div class="card-body">
                    <form asp-controller="Jornadas" asp-action="AgregarPropio" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label>Fecha</label>
                                <input type="date" name="fecha" class="form-control form-control-sm" required max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            @if (Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.Hora)
                            {
                                <div class="form-group col-md-2">
                                    <label>Entrada</label>
                                    <input type="time" name="horaEntrada" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label>Salida</label>
                                    <input type="time" name="horaSalida" class="form-control form-control-sm" />
                                </div>
                            }
                            else
                            {
                                <div class="form-group col-md-3">
                                    <label>Turno</label>
                                    <select name="turno" class="form-control form-control-sm">
                                        <option value="@Entidades.Turno.Manana">Mañana</option>
                                        <option value="@Entidades.Turno.Tarde">Tarde</option>
                                    </select>
                                </div>
                            }
                            <div class="form-group col-md-5">
                                <label>Motivo (obligatorio)</label>
                                <input type="text" name="motivo" class="form-control form-control-sm" required placeholder="¿Por qué lo cargás fuera de hora?" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-warning">Cargar marcación</button>
                        <small class="text-muted d-block mt-1">Esta carga queda marcada como autoreportada — la revisa un administrador antes de liquidar.</small>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalInfoMiJornada" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable mi-jornada-page">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cómo usar "Mi jornada"</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Acá marcás tu propia jornada de hoy: si cobrás por hora, "Marcar entrada"/"Marcar salida"; si cobrás por jornada o media jornada, elegís el turno (Mañana o Tarde) que trabajaste.</p>
                <p>Esa tabla muestra tus marcaciones desde tu última liquidación confirmada (o los últimos 14 días si todavía no tenés ninguna), sin mostrar ningún monto de sueldo.</p>
                <p>Si te olvidaste de fichar un día anterior, usá "¿Te olvidaste de fichar...?" más abajo: pedí la fecha real y un motivo (siempre obligatorio ahí). Esa carga queda identificada como cargada por vos mismo, y no podés marcarla como feriado — eso lo decide un administrador.</p>
                <p>Si tu dispositivo (tablet/mostrador) está habilitado para fichar sin loguearte cada vez, también podés usar la pantalla "Fichaje" para marcar tu jornada ahí.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .mi-jornada-page {
        font-size: .9rem;
    }

    .mi-jornada-page .card-body {
        padding: .82rem 1rem;
    }

    /* Los botones grandes de marcar entrada/salida/jornada son btn-lg a proposito (accion
       tactil principal de la pantalla) -- no se achican, solo el resto (tablas, texto). */
    .mi-jornada-page .table {
        font-size: .84rem;
    }

    .mi-jornada-page .table th,
    .mi-jornada-page .table td {
        padding: .42rem .58rem;
        vertical-align: middle;
    }

    .mi-jornada-page .table thead th {
        font-size: .72rem !important;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }
</style>
