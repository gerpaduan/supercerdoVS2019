@model WebCore.Models.FichajeConfirmarVm
@{
    ViewBag.Title = "Fichaje";
    bool esHora = Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.Hora;
}

<div class="container-fluid">
    <div class="card shadow-sm mx-auto" style="max-width:480px;">
        <div class="card-body text-center py-4">
            <h4>
                Hola @Model.EmpleadoNombre
                <button type="button" class="btn btn-sm btn-link p-0 ml-1" data-bs-toggle="modal" data-bs-target="#modalInfoFichajeConfirmar" title="Cómo usar esta pantalla">
                    <i class="fas fa-info-circle"></i>
                </button>
            </h4>

            @if (esHora)
            {
                <p class="lead">
                    Vas a registrar tu <strong>@(Model.EsIngreso ? "Ingreso" : "Salida")</strong>
                    a las <strong id="horaMostrada">@Model.HoraPropuestaTexto</strong> hs.
                </p>
            }
            else
            {
                <p class="lead">
                    Vas a cargar tu <strong>@(Model.FormaLiquidacion == Entidades.Empleado.formaLiquidacion.MediaJornada ? "media jornada" : "jornada")</strong> de hoy.
                </p>
            }

            <form asp-controller="Jornadas" asp-action="FichajeRegistrar" method="post" id="formFichaje">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEmpleado" value="@Model.IdEmpleado" />

                @if (esHora)
                {
                    <input type="hidden" name="horaCorregida" id="horaCorregida" value="" />

                    <div id="panelModificarHora" class="d-none text-left mt-3 mb-3 p-3 border rounded bg-light">
                        <div class="form-group">
                            <label>Motivo</label>
                            <select id="motivoSelect" class="form-control">
                                @foreach (var m in WebCore.Models.FichajeConfirmarVm.MotivosTipicos)
                                {
                                    <option value="@m">@m</option>
                                }
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="form-group" id="grupoMotivoOtro" style="display:none;">
                            <label>Especificar motivo</label>
                            <input type="text" id="motivoOtroInput" name="motivoOtro" class="form-control" />
                        </div>
                        <input type="hidden" name="motivo" id="motivoHidden" />
                        <div class="form-group">
                            <label>Hora correcta</label>
                            <input type="time" id="horaInput" class="form-control" value="@Model.HoraPropuestaTexto" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group text-left mt-3">
                        <label>Turno</label>
                        <select name="turno" class="form-control">
                            <option value="@Entidades.Turno.Manana" selected="@(Model.TurnoEstimado == Entidades.Turno.Manana)">Mañana</option>
                            <option value="@Entidades.Turno.Tarde" selected="@(Model.TurnoEstimado == Entidades.Turno.Tarde)">Tarde</option>
                        </select>
                    </div>
                }

                <div class="form-group text-left mt-3">
                    <label>Observación (opcional)</label>
                    <input type="text" name="observacion" class="form-control" placeholder="Ej: llegué tarde porque había tráfico" />
                </div>

                <button type="submit" class="btn btn-success btn-lg btn-block mt-2">Registrar</button>
                <a href="@Url.Action("Fichaje", "Jornadas")" class="btn btn-outline-secondary btn-block mt-2">Cancelar</a>
                @if (esHora)
                {
                    <button type="button" id="btnModificarHora" class="btn btn-link mt-2">¿Te olvidaste de fichar antes? Modificar hora</button>
                }
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalInfoFichajeConfirmar" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cómo usar esta confirmación</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                @if (esHora)
                {
                    <p>Confirmá tu ingreso o egreso a la hora mostrada. Si necesitás corregir la hora real (por ejemplo, te olvidaste de fichar antes), usá "Modificar hora": ahí el motivo es obligatorio.</p>
                }
                else
                {
                    <p>Confirmá el turno (Mañana o Tarde) que trabajaste hoy. El sistema propone uno según la hora actual, pero podés cambiarlo si no es el correcto.</p>
                }
                <p>La "Observación" es opcional y no corrige la hora — sirve para dejar una nota puntual (ej. "llegué tarde por tráfico"). Queda guardada junto con tu marcación para que la vea un administrador.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (esHora)
    {
        <script>
            (function () {
                var panel = document.getElementById('panelModificarHora');
                var btn = document.getElementById('btnModificarHora');
                var motivoSelect = document.getElementById('motivoSelect');
                var grupoOtro = document.getElementById('grupoMotivoOtro');
                var motivoOtro = document.getElementById('motivoOtroInput');
                var motivoHidden = document.getElementById('motivoHidden');
                var horaInput = document.getElementById('horaInput');
                var horaCorregida = document.getElementById('horaCorregida');
                var form = document.getElementById('formFichaje');

                btn.addEventListener('click', function () {
                    panel.classList.toggle('d-none');
                });

                motivoSelect.addEventListener('change', function () {
                    grupoOtro.style.display = motivoSelect.value === 'Otro' ? 'block' : 'none';
                });

                form.addEventListener('submit', function () {
                    if (!panel.classList.contains('d-none')) {
                        horaCorregida.value = horaInput.value;
                        motivoHidden.value = motivoSelect.value;
                    }
                });
            })();
        </script>
    }
}
