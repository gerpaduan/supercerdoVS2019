@* Port literal de Web/Views/Cajas/_AbrirCajaModal.cshtml -- usado por Ventas/POS.cshtml cuando
   no hay caja abierta (ver docs/10-migracion-aspnet-core/PLAN-POS-UI.md, batch 1+2). La logica de
   "abrirCaja()" vive inline en POS.cshtml, no aca (mismo lugar que el original). *@
<div class="modal fade"
     id="modalAbrirCaja"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-cash-register mr-2"></i>
                    Apertura de Caja
                </h5>
            </div>

            <div class="modal-body">

                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="fas fa-store mr-1"></i> Sucursal
                    </label>
                    <input type="text" class="form-control bg-light" value="@ViewBag.SucursalNombre" readonly>
                </div>

                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="far fa-clock mr-1"></i> Fecha y hora
                    </label>
                    <input type="text" id="fechaHoraApertura" class="form-control bg-light" readonly>
                </div>

                <div class="form-group">
                    <label class="font-weight-bold text-gray-700">
                        <i class="fas fa-dollar-sign mr-1"></i> Caja inicial
                    </label>
                    <input type="text" id="montoInicial" class="form-control form-control-lg" placeholder="Ingrese monto inicial">
                </div>

                @* Item 7 (2026-09-11, ver docs/DECISIONS.md "gate de caja abierta"): antes, tener
                   este permiso (PuedeOperarSinCajaYEditarFecha) saltaba este modal en silencio --
                   ahora el modal SIEMPRE se muestra sin caja real, y el permiso solo habilita esta
                   opcion, que debe tildarse explicitamente para continuar sin abrir caja. *@
                @if (ViewBag.PuedeOperarSinCajaBypass != null && (bool)ViewBag.PuedeOperarSinCajaBypass)
                {
                    <div class="form-group custom-control custom-checkbox mb-0">
                        <input type="checkbox" class="custom-control-input" id="chkOperarSinCaja">
                        <label class="custom-control-label" for="chkOperarSinCaja">
                            Quiero realizar una venta rápida sin apertura de caja
                        </label>
                    </div>
                }

            </div>

            <div class="modal-footer d-block">

                <button type="button" class="btn btn-success btn-block btn-lg" onclick="abrirCaja()">
                    <i class="fas fa-unlock mr-2"></i>
                    Abrir Caja
                </button>

                @if (ViewBag.PuedeOperarSinCajaBypass != null && (bool)ViewBag.PuedeOperarSinCajaBypass)
                {
                    <button type="button" class="btn btn-outline-warning btn-block" id="btnContinuarSinCaja" disabled>
                        <i class="fas fa-bolt mr-2"></i>
                        Continuar sin abrir caja
                    </button>
                }

                <button type="button" class="btn btn-outline-secondary btn-block" id="btnCancelarAbrirCaja">
                    Cancelar
                </button>

            </div>

        </div>
    </div>
</div>
