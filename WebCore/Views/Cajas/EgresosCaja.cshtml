@model System.Data.DataTable
@using System.Data

@{
    ViewBag.Title = "Egresos de Caja";

    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    var usuarios = ViewBag.Usuarios as DataTable;
    var tipos = ViewBag.TiposEgresoCaja as DataTable;
    int idSucursal = ViewBag.IdSucursal != null ? (int)ViewBag.IdSucursal : 0;
    int idUsuario = ViewBag.IdUsuario != null ? (int)ViewBag.IdUsuario : -1;
    int idTipo = ViewBag.IdTipoEgresoCaja != null ? (int)ViewBag.IdTipoEgresoCaja : 0;
    string descripcion = ViewBag.Descripcion ?? "";
    DateTime fechaDesde = ViewBag.FechaDesde != null ? (DateTime)ViewBag.FechaDesde : DateTime.Today;
    DateTime fechaHasta = ViewBag.FechaHasta != null ? (DateTime)ViewBag.FechaHasta : DateTime.Today.AddDays(1).AddSeconds(-1);
    string filtroGasto = ViewBag.FiltroGasto as string ?? "todos";
    bool sinPermiso = ViewBag.SinPermiso != null && (bool)ViewBag.SinPermiso;
    string mensajePermiso = ViewBag.MensajePermiso as string ?? "No tiene permisos para acceder a esta pantalla.";
    bool puedeVerTipos = ViewBag.PuedeVerTiposEgreso != null && (bool)ViewBag.PuedeVerTiposEgreso;
}

<div class="egresos-page">
    @if (sinPermiso)
    {
        <div class="alert alert-warning">
            @mensajePermiso
        </div>
    }
    else
    {
        @* Bloque superior: en escritorio (>= 1200 px) los filtros van arriba (fechas primero) y debajo UNA barra con Items/Total, estado,
           "Vista completa" y los botones (Nuevo Egreso ...); la tabla es el ultimo item (#tablaEgresosCaja se disuelve con display:contents para
           que el resumen entre en la barra). Por debajo de 1200 px conserva el orden de siempre. Estilos: Shared/_FiltrosCompactosStyles + <style> de abajo. *@
        <div class="fc-top egresos-top">
        <div class="egresos-actions fc-acciones">
            <button type="button" class="btn btn-success" id="btnNuevoEgresoCaja">
                <i class="fas fa-plus mr-1"></i> Nuevo Egreso
            </button>
            <button type="button" class="btn btn-outline-success" id="btnCalcularComisionesElectronicas">
                <i class="fas fa-calculator mr-1"></i> Calcular comisiones electrónicas
            </button>
            @if (puedeVerTipos)
            {
                <button type="button" class="btn btn-outline-primary" id="btnTiposEgresoCaja">
                    <i class="fas fa-tags mr-1"></i> Tipos Egresos
                </button>
            }
        </div>

        <form id="formFiltrosEgresos" class="egresos-filtros egresos-filtros-card fc-card">
            <div class="egresos-filtros-stack">
                <div class="egresos-filtros-grid">
                    <div class="form-group mb-0 egr-f-sucursal">
                        <label class="egresos-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="filtroSucursalEgreso" class="form-control">
                            <option value="0" selected="@(idSucursal == 0 ? "selected" : null)">Todas</option>
                            @if (sucursales != null)
                            {
                                foreach (var s in sucursales)
                                {
                                    <option value="@s.IdSucursal" selected="@(s.IdSucursal == idSucursal ? "selected" : null)">@s.SucursalNombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-0 egr-f-desde">
                        <label class="egresos-filtro-label">Desde</label>
                        <input type="datetime-local" step="1" name="fechaDesde" id="filtroDesdeEgreso" value="@fechaDesde.ToString("yyyy-MM-ddTHH:mm:ss")" class="form-control" />
                    </div>

                    <div class="form-group mb-0 egr-f-hasta">
                        <label class="egresos-filtro-label">Hasta</label>
                        <input type="datetime-local" step="1" name="fechaHasta" id="filtroHastaEgreso" value="@fechaHasta.ToString("yyyy-MM-ddTHH:mm:ss")" class="form-control" />
                    </div>

                    <div class="form-group mb-0 egr-f-usuario">
                        <label class="egresos-filtro-label">Usuario</label>
                        <select name="idUsuario" id="filtroUsuarioEgreso" class="form-control">
                            @if (usuarios != null)
                            {
                                foreach (DataRow row in usuarios.Rows)
                                {
                                    int id = Convert.ToInt32(row["id"]);
                                    <option value="@id" selected="@(id == idUsuario ? "selected" : null)">@row["nombre"]</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-0 egr-f-tipo">
                        <label class="egresos-filtro-label">Tipo</label>
                        <select name="idTipoEgresoCaja" id="filtroTipoEgreso" class="form-control">
                            <option value="0">Todos</option>
                            @if (tipos != null)
                            {
                                foreach (DataRow row in tipos.Rows)
                                {
                                    int id = Convert.ToInt32(row["id"]);
                                    if (id == 0 || id == 100 || id == 200) { continue; }
                                    <option value="@id" selected="@(id == idTipo ? "selected" : null)">@row["tipoEgresoCaja"]</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-0 egr-f-descripcion">
                        <label class="egresos-filtro-label">Descripcion</label>
                        <input type="text" name="descripcion" id="filtroDescripcionEgreso" value="@descripcion" class="form-control" autocomplete="off" />
                    </div>

                    <div class="form-group mb-0 egr-f-gasto">
                        <label class="egresos-filtro-label">Gasto</label>
                        <select name="filtroGasto" id="filtroGastoEgreso" class="form-control">
                            <option value="todos" selected="@(filtroGasto == "todos" ? "selected" : null)">Todos</option>
                            <option value="gastos" selected="@(filtroGasto == "gastos" ? "selected" : null)">Solo gastos</option>
                            <option value="no-gastos" selected="@(filtroGasto == "no-gastos" ? "selected" : null)">No gastos</option>
                        </select>
                    </div>

                    <div class="form-group mb-0 egresos-filtro-accion">
                        <label class="egresos-filtro-label d-none d-lg-block">&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block" id="btnBuscarEgresosCaja">
                            <i class="fas fa-search mr-1"></i><span class="btn-buscar-texto"> Buscar</span>
                        </button>
                    </div>
                </div>

                @* fc-alerta: en escritorio el aviso de fechas cambiadas no es esta alerta sino Buscar en ambar + el texto de estado de la barra. *@
                <div class="egresos-filtros-row">
                    <div id="mensajeCambioFechasEgresos" class="alert alert-warning py-2 px-3 mb-0 d-none fc-alerta" role="alert">
                        Cambió la fecha. Debe presionar el botón Buscar para actualizar la búsqueda.
                    </div>
                </div>
            </div>
        </form>

        @* Estado fuera del formulario para que en escritorio entre en la barra (mismo id: egresos-caja.js lo sigue escribiendo). *@
        <div id="estadoBusquedaEgresos" class="text-muted small egresos-estado fc-estado">Resultados actualizados.</div>

        <div class="d-flex justify-content-end align-items-center mb-2 fc-vista">
            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="switchVistaCompletaEgresos">
                <label class="custom-control-label" for="switchVistaCompletaEgresos">Vista completa</label>
            </div>
        </div>

        <div id="tablaEgresosCaja" class="egresos-tabla-host">
            @Html.Partial("~/Views/Cajas/_EgresosCajaTabla.cshtml", Model)
        </div>
        </div>
    }
</div>

@Html.Partial("~/Views/Shared/_FiltrosCompactosStyles.cshtml")

<style>
    .egresos-page {
        font-size: .9rem;
    }

    .egresos-page .mb-2 {
        margin-bottom: .7rem !important;
    }

    .egresos-filtros-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: .75rem;
        padding: .72rem .85rem;
        margin-bottom: .9rem;
    }

    .egresos-filtros-stack {
        display: grid;
        gap: .65rem;
    }

    .egresos-filtros-row,
    .egresos-filtros-grid {
        display: grid;
        gap: .65rem;
    }

    .egresos-filtro-label {
        font-size: .76rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .18rem;
    }

    .egresos-filtros-card .form-control {
        min-height: 2.35rem;
        border-radius: .55rem;
        font-size: .87rem;
        padding: .32rem .62rem;
    }

    .egresos-filtros-card .btn {
        min-height: 2.35rem;
        border-radius: .55rem;
        font-size: .87rem;
        padding: .32rem .62rem;
    }

    .egresos-filtros-card .alert,
    .egresos-filtros-card .small,
    .egresos-filtros-card .text-muted,
    .egresos-filtros-card .btn-buscar-texto,
    .egresos-page .custom-control-label {
        font-size: .8rem !important;
    }

    .egresos-page .egresos-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: .85rem;
    }

    .egresos-page .egresos-actions .btn {
        font-size: .84rem;
        padding: .36rem .7rem;
    }

    .egresos-page .egresos-resumen {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-bottom: .55rem;
        font-size: .8rem;
    }

    .egresos-page .egresos-resumen .text-muted {
        font-size: .7rem !important;
        margin-right: .22rem;
    }

    .egresos-page .egresos-resumen strong {
        font-size: .92rem;
        line-height: 1.05;
    }

    .egresos-page .egresos-tabla-desktop .table {
        font-size: .84rem;
    }

    .egresos-page .egresos-tabla-desktop .table th,
    .egresos-page .egresos-tabla-desktop .table td {
        padding: .42rem .58rem;
        line-height: 1.15;
        vertical-align: middle;
    }

    .egresos-page .egresos-tabla-desktop .table thead th,
    .egresos-page .egresos-tabla-desktop .table > thead > tr > th {
        font-size: .72rem !important;
        line-height: 1.05;
        padding: .38rem .5rem;
    }

    .egresos-page .egresos-tabla-desktop .btn {
        font-size: .78rem;
        padding: .2rem .42rem;
    }

    .egresos-page .egresos-tabla-desktop .small,
    .egresos-page .egresos-tabla-desktop .text-muted,
    .egresos-page .egreso-detalle-collapse .text-muted {
        font-size: .74rem !important;
    }

    .egresos-page .egreso-detalle-collapse .p-3 {
        padding: .7rem .85rem !important;
    }

    .egresos-page .egreso-detalle-meta-card {
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        background: #fff;
        padding: .85rem .95rem;
    }

    .egresos-page .egreso-detalle-meta-row {
        margin-bottom: .45rem;
        line-height: 1.2;
    }

    .egresos-page .egreso-detalle-principal {
        padding-bottom: .6rem;
        border-bottom: 1px solid #e9ecef;
    }

    .egresos-page .egreso-detalle-valor-principal {
        display: block;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
        white-space: pre-wrap;
    }

    html.dark-mode .egresos-page .egreso-detalle-meta-card,
    body.dark-mode .egresos-page .egreso-detalle-meta-card {
        background: #111827;
        border-color: #374151;
        color: #f3f4f6;
    }

    html.dark-mode .egresos-page .egreso-detalle-meta-card .text-muted,
    body.dark-mode .egresos-page .egreso-detalle-meta-card .text-muted {
        color: #9ca3af !important;
    }

    html.dark-mode .egresos-page .egreso-detalle-principal,
    body.dark-mode .egresos-page .egreso-detalle-principal {
        border-bottom-color: #374151;
    }

    @@media (min-width: 1200px) {
        .egresos-page .egresos-actions {
            margin-bottom: .75rem;
        }

        .egresos-filtros-card {
            padding: .65rem .8rem;
        }

        .egresos-filtros-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            align-items: end;
        }

        .egresos-filtros-card .form-control,
        .egresos-filtros-card .btn {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
        }

        /* ---- Modo compacto de escritorio (pedido 2026-10-31; mismo criterio que Compras/Stock > Index) ----
           Los selectores llevan body.app-shell por ui-refresh.css / custom.css (ver _FiltrosCompactosStyles). */

        /* Fechas primero; el orden del HTML (celular) no cambia: aca se reordena con "order". */
        body.app-shell .egresos-top .egr-f-desde { order: 1; }
        body.app-shell .egresos-top .egr-f-hasta { order: 2; }
        body.app-shell .egresos-top .egr-f-sucursal { order: 3; }
        body.app-shell .egresos-top .egr-f-usuario { order: 4; }
        body.app-shell .egresos-top .egr-f-tipo { order: 5; }
        body.app-shell .egresos-top .egr-f-descripcion { order: 6; }
        body.app-shell .egresos-top .egr-f-gasto { order: 7; }
        body.app-shell .egresos-top .egresos-filtro-accion { order: 8; }

        /* El renglon de la alerta de fechas queda vacio en escritorio (la alerta es .fc-alerta): se saca para que no sume el gap. */
        body.app-shell .egresos-top .egresos-filtros-row { display: none; }

        body.app-shell .egresos-top .egresos-filtros-grid { gap: .4rem .5rem; }

        body.app-shell .egresos-top .egresos-filtros-card { margin-bottom: 0; padding: 0 .65rem; }

        body.app-shell .egresos-top .egresos-filtros-stack { gap: 0; }

        /* Los botones (Nuevo Egreso ...) pasan a la barra, a la altura de Buscar. */
        body.app-shell .egresos-top .egresos-actions .btn {
            font-size: .84rem;
            padding: .15rem .6rem;
        }

        /* Items / Total: de tarjetas con la etiqueta arriba a una linea "Items 14" como el resto de las barras. #tablaEgresosCaja se
           disuelve (display:contents) para que el resumen y la tabla sean items de la barra; el resumen va primero y la tabla ocupa todo el ancho. */
        body.app-shell .egresos-top > .egresos-tabla-host { display: contents; }

        body.app-shell .egresos-top .egresos-tabla-host > .egresos-resumen {
            order: 1;
            margin: 0;
            justify-content: flex-start;
            gap: .4rem;
            flex: 0 0 auto;
        }

        body.app-shell .egresos-top .egresos-tabla-host > .egresos-resumen > div {
            display: flex;
            align-items: baseline;
            gap: .45rem;
            min-width: 0;
            padding: .28rem .65rem;
            text-align: left;
            white-space: nowrap;
        }

        body.app-shell .egresos-top .egresos-tabla-host > .egresos-resumen span,
        body.app-shell .egresos-top .egresos-tabla-host > .egresos-resumen strong {
            display: inline;
            margin: 0;
        }

        body.app-shell .egresos-top .egresos-tabla-host > :not(.egresos-resumen) {
            order: 10;
            flex: 0 0 100%;
            max-width: 100%;
            min-width: 0;
        }

        /* Tabla: una linea por fila. "Creado" (fecha y usuario) pasa de dos renglones a uno. */
        body.app-shell .egresos-page .egresos-tabla-desktop .table th,
        body.app-shell .egresos-page .egresos-tabla-desktop .table td {
            padding: .15rem .5rem;
            line-height: 1.2;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .table thead th {
            padding: .25rem .5rem;
            white-space: nowrap !important;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .celda-creado-fecha,
        body.app-shell .egresos-page .egresos-tabla-desktop .celda-creado-usuario {
            display: inline;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .celda-creado-usuario {
            display: inline-block;
            max-width: 4rem;
            margin-left: .4rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: bottom;
        }

        /* Sucursal (6.a columna) en un renglon ("San Lorenzo" se partia). El Tipo (2.a) tambien, hasta 10 rem: "Entregas Dinero" entra en una linea y
           un tipo muy largo ("Gastos Personales / Nelcy-German") baja a dos. La Descripcion es la que cede y baja de renglon si es larga. El Detalle
           (resumen de su primera linea) baja de 220 px a 9 rem para que entre la fila sin scroll horizontal. */
        body.app-shell .egresos-page .egresos-tabla-desktop .table td:nth-child(6) {
            white-space: nowrap;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .table td:nth-child(2) {
            min-width: 7rem;
            max-width: 10rem;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .table td .text-truncate {
            max-width: 9rem !important;
        }

        body.app-shell .egresos-page .egresos-tabla-desktop .table td .btn-sm {
            height: 1.4rem;
            min-height: 0;
            padding: 0 .45rem;
            font-size: .74rem;
            line-height: 1;
        }

        .egresos-page .egresos-resumen {
            margin-bottom: .45rem;
        }

        .egresos-page .egresos-resumen strong {
            font-size: .86rem;
        }

        .egresos-page .egresos-tabla-desktop .table {
            font-size: .8rem;
        }

        .egresos-page .egresos-tabla-desktop .table thead th,
        .egresos-page .egresos-tabla-desktop .table > thead > tr > th {
            font-size: .69rem !important;
        }
    }

    /* Ventana ancha (>= 1550 px; con el menu lateral quedan ~1300 px utiles): los 8 campos entran en UNA fila. Desde/Hasta de ancho fijo para
       que se vea la fecha con segundos ("31/10/2026 23:59:59" y el icono del calendario); el resto reparte lo que queda. */
    @@media (min-width: 1550px) {
        .egresos-filtros-grid {
            grid-template-columns: 14.5rem 14.5rem minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(7rem, 1fr) minmax(8rem, 1.4fr) 7.5rem 5.5rem;
        }
    }

    /* Importe con la misma letra que las demas columnas (antes 1.2 rem en negrita por custom.css .egreso-monto); numeros alineados en columna. */
    .egresos-page .egresos-tabla-desktop .egreso-monto {
        font-size: inherit;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
    }

    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .egresos-filtros-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: end;
        }
    }

    @@media (max-width: 767.98px) {
        .egresos-filtros-row,
        .egresos-filtros-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="modal fade" id="modalEgresoCaja" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalEgresoCajaTitulo">Nuevo Egreso de Caja</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="contenedorEgresoCaja">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalTiposEgresoCaja" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalTiposEgresoCajaTitulo">Tipos Egresos</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="contenedorTiposEgresoCaja">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function showNavigationLoading(message) {
                if (window.ModalRequestLoading && typeof window.ModalRequestLoading.trackNavigation === "function") {
                    window.ModalRequestLoading.trackNavigation(message || "Cargando solicitud...");
                }
            }

            function navegarConLoader(url) {
                if (!url) return;
                showNavigationLoading("Cargando solicitud...");
                window.setTimeout(function () {
                    window.location.replace(url);
                }, 0);
            }

            var storageKey = "egresos_caja_filters_v1";
            var form = document.getElementById('formFiltrosEgresos');
            var inputFechaDesde = document.getElementById('filtroDesdeEgreso');
            var inputFechaHasta = document.getElementById('filtroHastaEgreso');
            var inputSucursal = document.getElementById('filtroSucursalEgreso');
            var inputUsuario = document.getElementById('filtroUsuarioEgreso');
            var inputTipo = document.getElementById('filtroTipoEgreso');
            var inputDescripcion = document.getElementById('filtroDescripcionEgreso');

            function buildState() {
                return {
                    fechaDesde: inputFechaDesde ? inputFechaDesde.value : "",
                    fechaHasta: inputFechaHasta ? inputFechaHasta.value : "",
                    idSucursal: inputSucursal ? inputSucursal.value : "",
                    idUsuario: inputUsuario ? inputUsuario.value : "",
                    idTipoEgresoCaja: inputTipo ? inputTipo.value : "",
                    descripcion: inputDescripcion ? inputDescripcion.value : ""
                };
            }

            function saveState() {
                if (!form || !window.sessionStorage) return;
                window.sessionStorage.setItem(storageKey, JSON.stringify(buildState()));
            }

            function restoreStateIfNeeded() {
                if (!form || !window.sessionStorage || window.location.search) return;

                var raw = window.sessionStorage.getItem(storageKey);
                if (!raw) return;

                try {
                    var state = JSON.parse(raw);
                    var params = new URLSearchParams();
                    if (state.idSucursal) params.set("idSucursal", state.idSucursal);
                    if (state.idUsuario) params.set("idUsuario", state.idUsuario);
                    if (state.idTipoEgresoCaja) params.set("idTipoEgresoCaja", state.idTipoEgresoCaja);
                    if (state.descripcion) params.set("descripcion", state.descripcion);
                    if (state.fechaDesde) params.set("fechaDesde", state.fechaDesde);
                    if (state.fechaHasta) params.set("fechaHasta", state.fechaHasta);

                    var query = params.toString();
                    if (query) {
                        navegarConLoader(window.location.pathname + "?" + query);
                    }
                } catch (e) {
                    window.sessionStorage.removeItem(storageKey);
                }
            }

            restoreStateIfNeeded();
            saveState();

            if (form) {
                form.addEventListener("submit", function () {
                    saveState();
                });
                form.querySelectorAll("input, select").forEach(function (el) {
                    el.addEventListener("change", saveState);
                    el.addEventListener("input", saveState);
                });
            }
        })();

        window.EgresosCajaUrls = {
            listar: '@Url.Action("EgresosCaja", "Cajas")',
            nuevo: '@Url.Action("NuevoEgresoCaja", "Cajas")',
            guardar: '@Url.Action("GuardarEgresoCaja", "Cajas")',
            comisionesFormulario: '@Url.Action("CalcularComisionesElectronicas", "Cajas")',
            comisionesResumen: '@Url.Action("ObtenerResumenComisionesElectronicas", "Cajas")',
            comisionesGuardar: '@Url.Action("GuardarComisionesElectronicas", "Cajas")',
            tipos: '@Url.Action("TiposEgresoCaja", "Cajas")',
            tiposOpciones: '@Url.Action("TiposEgresoCajaOpciones", "Cajas")',
            tipoFormulario: '@Url.Action("AddOrEditTipoEgresoCaja", "Cajas")',
            tipoGuardar: '@Url.Action("GuardarTipoEgresoCaja", "Cajas")',
            tipoEliminar: '@Url.Action("EliminarTipoEgresoCaja", "Cajas")'
        };

        window.EgresosCajaPermisos = {
            sinPermiso: @Html.Raw((sinPermiso ? "true" : "false")),
            mensaje: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensajePermiso)),
            puedeVerTipos: @Html.Raw((ViewBag.PuedeVerTiposEgreso != null && (bool)ViewBag.PuedeVerTiposEgreso ? "true" : "false")),
            puedeEditarTipos: @Html.Raw((ViewBag.PuedeEditarTiposEgreso != null && (bool)ViewBag.PuedeEditarTiposEgreso ? "true" : "false")),
            usuarioAdmin: @Html.Raw((ViewBag.UsuarioAdmin != null && (bool)ViewBag.UsuarioAdmin ? "true" : "false"))
        };
    </script>
<script src="@Url.Content("~/Scripts/app/money-input-mask.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Scripts/app/egresos-caja.js")" asp-append-version="true"></script>
}
