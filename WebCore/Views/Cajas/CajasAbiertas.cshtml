        function renderPreviewCambioSucursalCaja(resp) {
            if (!resp || !resp.ok) {
                $("#cambioSucursalCajaPreview").removeClass("text-muted").addClass("text-danger").text((resp && resp.mensaje) || "No se pudo generar la vista previa.");
                $("#cambioSucursalMovimientosDestinoWrap").addClass("d-none");
                $("#btnConfirmarCambioSucursalCaja").prop("disabled", true);
                return;
            }

            const mensaje = $('<div>').text(resp.mensaje || "").html();
            let html = '<div class="mb-2"><strong>Rango:</strong> ' + $('<div>').text(resp.fechaDesde + ' - ' + resp.fechaHasta).html() + '</div>';
            html += '<div class="mb-2"><strong>Origen:</strong> ' + $('<div>').text(resp.sucursalActual || "").html() + '</div>';
            html += '<div class="mb-3"><strong>Destino:</strong> ' + $('<div>').text(resp.sucursalNueva || "").html() + '</div>';

            if (resp.tablas && resp.tablas.length) {
                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-2"><thead><tr><th>Tabla</th><th class="text-right">Registros</th></tr></thead><tbody>';
                resp.tablas.forEach(function (item) {
                    html += '<tr><td>' + $('<div>').text(item.tabla).html() + '</td><td class="text-right">' + item.cantidad + '</td></tr>';
                });
                html += '</tbody></table></div>';
            }

            html += '<div class="small ' + (resp.puedeEjecutar ? 'text-muted' : 'text-danger') + '">' + mensaje + '</div>';
            $("#cambioSucursalCajaPreview").removeClass("text-muted text-danger").html(html);

            if (resp.hayMovimientosEnDestino) {
                $("#cambioSucursalMovimientosDestinoAlerta").text(resp.advertenciaMovimientosEnDestino || "La sucursal destino ya tiene movimientos registrados en el mismo rango de fechas.");
                $("#chkCambioSucursalAceptaRiesgo").prop("checked", false);
                $("#cambioSucursalMovimientosDestinoWrap").removeClass("d-none");
            } else {
                $("#cambioSucursalMovimientosDestinoWrap").addClass("d-none");
            }

            reevaluarBotonConfirmarCambioSucursal(resp);
            window.CajasAbiertas._ultimoPreviewCambioSucursal = resp;
        }

