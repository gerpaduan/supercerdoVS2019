        function esNumeroValido(v) {
            return /^-?\d*(\.\d+)?$/.test(v);
        }

        function toFloat(value) {
            if (value == null) return 0;

            let v = String(value).trim();
            if (v === "") return 0;

            v = v.replace(/\$/g, "").replace(/\s+/g, "");

            if (/[eE]/.test(v) && v.indexOf(",") === -1) {
                const exponencial = Number(v);
                return isFinite(exponencial) ? exponencial : 0;
            }

            const tieneComa = v.indexOf(",") >= 0;
            const tienePunto = v.indexOf(".") >= 0;

            if (tieneComa && tienePunto) {
                v = v.replace(/\./g, "").replace(",", ".");
            } else if (tieneComa) {
                v = v.replace(",", ".");
            }

            const numero = Number(v);
            return isFinite(numero) ? numero : 0;
        }

        function formatNumberEsAr(value, permitirVacio) {
            if (value == null || value === "") {
                return permitirVacio ? "" : "0,00";
            }

            const numero = toFloat(value);
            return numero.toLocaleString("es-AR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function setFormattedValue(selector, value, permitirVacio) {
            $(selector).val(formatNumberEsAr(value, !!permitirVacio));
        }

        function toEditableNumberString(value) {
            if (value == null) return "";

            const texto = String(value).trim();
            if (texto === "") return "";

            return toFloat(texto).toFixed(2);
        }

        function toPostNumberString(value) {
            const texto = value == null ? "" : String(value).trim();
            if (texto === "") return "";
            return toFloat(texto).toFixed(2);
        }

        function guardarCierreCaja() {
            let data = {
                Id: $("#Id").val(),
                CajaCierre: toPostNumberString($("#CajaCierre").val()),
                Diferencia: toPostNumberString($("#Diferencia").val()),
                ImporteRetirado: toPostNumberString($("#ImporteRetirado").val()),
                CajaInicioSiguiente: toPostNumberString($("#CajaInicioSiguiente").val()),
                modoModificacion: $("#ModoModificacion").val() === "true"
            };

            $.ajax({
                url: '@Url.Action("CerrarCaja", "Cajas")',
                type: 'POST',
                data: data,
                success: function (resp) {
                    if (!resp.ok) {
                        $("#cerrarCajaError").removeClass("d-none").text(resp.error);
                        return;
                    }

                    const esModificacion = $("#ModoModificacion").val() === "true";
                    Swal.fire({
                        icon: 'success',
                        title: esModificacion ? 'Cierre actualizado' : 'Caja cerrada',
                        text: esModificacion ? (resp.mensaje || 'El cierre de caja se actualizó correctamente') : 'La caja se cerró correctamente',
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: '#4e73df',
                        focusConfirm: true
                    }).then(() => {
                        $("#modalCerrarCaja").modal("hide");
                        filtrar();
                    });
                }
            });
        }

        function validarNumero(input) {
            let v = input.value;
            if (!v) {
                input.value = "";
                return;
            }

            v = v.replace(/[^\d,.\-]/g, "");
            v = v.replace(/,/g, ".");

            const signo = v.startsWith("-") ? "-" : "";
            v = (signo ? v.substring(1) : v).replace(/-/g, "");

            const partes = v.split(".");
            if (partes.length > 2) {
                v = partes.shift() + "." + partes.join("");
            }

            input.value = signo + v;
        }

        $(document).on('focus', '#CajaCierre, #ImporteRetirado', function () {
            if (!this.value) {
                return;
            }

            this.value = toEditableNumberString(this.value);
        });

        $(document).on('blur', '#CajaCierre, #ImporteRetirado', function () {
            if (!this.value || !String(this.value).trim()) {
                return;
            }

            this.value = formatNumberEsAr(this.value, false);
            recalcularCierre();
        });

        function recalcularCierre() {
            let cajaInicial = toFloat($("#CajaInicial").val());
            let ventas = toFloat($("#Ventas").val());
            let gastos = toFloat($("#EgresosCaja").val());
            let cajaCierre = toFloat($("#CajaCierre").val());
            let importeRetirado = toFloat($("#ImporteRetirado").val());

            let diferencia = (gastos + cajaCierre) - (cajaInicial + ventas);

            if ($("#CajaCierre").val().length > 0)
                $("#Diferencia").val(formatNumberEsAr(diferencia, false));
            else
                $("#Diferencia").val("");

            let cajaInicioSiguiente = cajaCierre - importeRetirado;
            $("#CajaInicioSiguiente").val(formatNumberEsAr(cajaInicioSiguiente, false));

            colorearDiferencia();
        }

        function colorearDiferencia() {
            let valor = toFloat($("#Diferencia").val());

            if (isNaN(valor)) {
                $("#Diferencia").css("background-color", "white");
                return;
            }

            if (valor >= -100 && valor <= 100) {
                $("#Diferencia").css("background-color", "#c8f7c5");
            }
            else if ((valor > 100 && valor <= 300) || (valor < -100 && valor >= -300)) {
                $("#Diferencia").css("background-color", "#fff3b0");
            }
            else {
                $("#Diferencia").css("background-color", "#f7c6c6");
            }
        }
    </script>
    <script src="@Url.Content("~/Scripts/app/egresos-caja.js")" asp-append-version="true"></script>
}
