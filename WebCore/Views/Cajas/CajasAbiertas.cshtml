@model System.Data.DataTable

@{
    ViewBag.Title = "Cajas Abiertas";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    bool hayVariasSucursales = ViewBag.HayVariasSucursales != null && (bool)ViewBag.HayVariasSucursales;
    bool puedeModificarCierres = ViewBag.PuedeModificarCierres != null && (bool)ViewBag.PuedeModificarCierres;
    bool tienePermisoCerrarCaja = ViewBag.TienePermisoCerrarCaja != null && (bool)ViewBag.TienePermisoCerrarCaja;
    var usuariosActivosEmpresa = ViewBag.UsuariosActivosEmpresa as List<object> ?? new List<object>();
    int? idSucursal = ViewBag.IdSucursal;
    string buscar = ViewBag.Buscar ?? "";
    DateTime fechaDesde = ViewBag.FechaDesde != null ? (DateTime)ViewBag.FechaDesde : DateTime.Today.AddDays(-7);
    var historialCierres = ViewBag.HistorialCierres as System.Data.DataTable ?? new System.Data.DataTable();
}

<div class="container-fluid px-2 px-md-3 cajas-page cajas-form-compact">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-3 cajas-panel-card">
        <div class="card-body">
            <form id="formFiltros">
                <div class="row mb-3">
                    <div class="col-12 col-md-4 col-xl-3">
                        <label for="idSucursal" class="cajas-filtro-label">Sucursal</label>
                        <select name="idSucursal" id="idSucursal" class="form-control">
                            @if (sucursales.Count > 1)
                            {
                                <option value="" selected="@(!idSucursal.HasValue ? "selected" : null)">-- Todas las sucursales --</option>
                            }
                            @foreach (var s in sucursales)
                            {
                                <option value="@s.IdSucursal" selected="@(s.IdSucursal == idSucursal ? "selected" : null)">
                                    @s.SucursalNombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-xl-3">
                        <label for="fechaDesde" class="cajas-filtro-label">Fecha desde</label>
                        <input type="date"
                               name="fechaDesde"
                               id="fechaDesde"
                               value="@fechaDesde.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>

                    <div class="col-12 col-md-4 col-xl-4">
                        <label for="buscarVendedor" class="cajas-filtro-label">Vendedor</label>
                        <div class="input-group">
                            <input type="text"
                                   name="buscar"
                                   id="buscarVendedor"
                                   value="@buscar"
                                   class="form-control"
                                   placeholder="buscar vendedor"
                                   onkeyup="filtrar()" />

                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button" id="btnBuscarCajasAbiertas" onclick="filtrar()">
                                    <span class="btn-buscar-texto">Buscar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @Html.Partial("~/Views/Shared/_AdvertenciaPermisoFecha.cshtml")

                <div id="estadoBusquedaCajasAbiertas" class="text-muted small">Resultados actualizados.</div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-3 cajas-panel-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Cajas abiertas</h6>
                <div id="estadoBusquedaCajasAbiertasTabla" class="text-muted small">Resultados actualizados.</div>
            </div>
            <div id="tablaResultado" class="cajas-resultado-wrap">
                @Html.Partial("~/Views/Cajas/_TablaCajasAbiertas.cshtml", Model)
            </div>
        </div>
    </div>

    @if (tienePermisoCerrarCaja)
    {
        <div class="card shadow-sm cajas-panel-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Historial de cierres</h6>
                    <div id="estadoBusquedaHistorialCajas" class="text-muted small">Resultados actualizados.</div>
                </div>
                <div id="tablaResultadoHistorial" class="cajas-resultado-wrap">
                    @Html.Partial("~/Views/Cajas/_TablaCierresDeCaja.cshtml", historialCierres)
                </div>
            </div>
        </div>
    }

    <style>
        .cajas-page h6 {
            font-size: .92rem;
            font-weight: 700;
            color: #2f3a4a;
        }

        .cajas-page #tablaResultadoHistorial .btn-sm,
        .cajas-page #tablaResultado .btn-sm {
            padding: .18rem .42rem;
            line-height: 1.12;
            font-size: .76rem;
        }

        .cajas-page #tablaResultadoHistorial table {
            font-size: .8rem;
        }

        .cajas-page #tablaResultadoHistorial th,
        .cajas-page #tablaResultadoHistorial td {
            padding: .36rem .48rem;
            vertical-align: middle;
            line-height: 1.12;
        }

        .cajas-page #tablaResultadoHistorial thead th {
            font-size: .69rem !important;
            text-transform: uppercase;
            letter-spacing: .02em;
        }

        .cajas-page .badge-modificar {
            font-size: .72rem;
            padding: .28rem .42rem;
        }

        .cajas-page #permisoFechaWarning {
            margin-top: .65rem !important;
        }

        .cajas-page {
            font-size: .9rem;
        }

        .cajas-page .cajas-panel-card {
            border: 1px solid #e9ecef;
            border-radius: .75rem;
        }

        .cajas-page .cajas-panel-card > .card-body,
        .cajas-page .cajas-panel-card .card-body {
            padding: .8rem .92rem;
        }

        .cajas-page .cajas-filtro-label {
            font-size: .76rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: .18rem;
        }

        .cajas-page .cajas-form-compact .form-control,
        .cajas-page .cajas-form-compact .input-group-text,
        .cajas-page .cajas-form-compact .btn:not(.btn-sm) {
            min-height: 2.15rem;
            font-size: .84rem;
            padding: .28rem .56rem;
            border-radius: .52rem;
        }

        .cajas-page .small,
        .cajas-page .text-muted {
            font-size: .76rem !important;
        }

        .cajas-page #tablaCajas {
            font-size: .82rem;
        }

        .cajas-page #tablaCajas th,
        .cajas-page #tablaCajas td {
            padding: .36rem .48rem;
            vertical-align: middle;
            line-height: 1.12;
        }

        .cajas-page #tablaCajas thead th,
        .cajas-page #tablaCajas > thead > tr > th {
            font-size: .72rem !important;
            line-height: 1.05;
            padding-top: .42rem;
            padding-bottom: .42rem;
            text-transform: uppercase;
            letter-spacing: .02em;
        }

        @@media (min-width: 1200px) {
            .cajas-page .cajas-panel-card > .card-body,
            .cajas-page .cajas-panel-card .card-body {
                padding: .72rem .84rem;
            }

            .cajas-page .cajas-form-compact .form-control,
            .cajas-page .cajas-form-compact .input-group-text,
            .cajas-page .cajas-form-compact .btn:not(.btn-sm) {
                min-height: 2.02rem;
                font-size: .81rem;
                padding: .24rem .5rem;
            }

            .cajas-page #tablaCajas,
            .cajas-page #tablaResultadoHistorial table {
                font-size: .79rem;
            }

            .cajas-page #tablaCajas thead th,
            .cajas-page #tablaCajas > thead > tr > th,
            .cajas-page #tablaResultadoHistorial thead th {
                font-size: .69rem !important;
            }
        }
    </style>

</div>

@if (hayVariasSucursales)
{
    <div class="modal fade" id="modalCambioSucursalCaja" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Cambiar sucursal de caja abierta</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="CambioSucursalIdCierre" />
                    <input type="hidden" id="CambioSucursalIdActual" />

                    <div class="alert alert-warning mb-3">
                        Esta accion corregira la sucursal de la caja y de todas las operaciones asociadas. Usar solo cuando el cajero trabajo por error en una sucursal incorrecta.
                    </div>

                    <div id="cambioSucursalCajaError" class="alert alert-danger d-none"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Cajero</label>
                            <input type="text" id="CambioSucursalUsuarioCaja" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label>Apertura</label>
                            <input type="text" id="CambioSucursalFechaInicio" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Sucursal actual</label>
                            <input type="text" id="CambioSucursalActualNombre" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label>Nueva sucursal</label>
                            <select id="CambioSucursalNueva" class="form-control">
                                <option value="">Seleccionar sucursal...</option>
                                @foreach (var s in sucursales)
                                {
                                    <option value="@s.IdSucursal">@s.SucursalNombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label>Vista previa</label>
                        <div id="cambioSucursalCajaPreview" class="border rounded p-3 bg-light text-muted">
                            Selecciona la nueva sucursal para calcular los registros que se van a corregir.
                        </div>
                    </div>

                    <div id="cambioSucursalMovimientosDestinoWrap" class="mt-3 d-none">
                        <div id="cambioSucursalMovimientosDestinoAlerta" class="alert alert-warning mb-2"></div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="chkCambioSucursalAceptaRiesgo">
                            <label class="form-check-label" for="chkCambioSucursalAceptaRiesgo">
                                Entiendo el riesgo y quiero continuar de todos modos
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnConfirmarCambioSucursalCaja" class="btn btn-warning" onclick="confirmarCambioSucursalCaja()" disabled>Cambiar sucursal</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="modalEgresoCaja" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalEgresoCajaTitulo">Nuevo Egreso de Caja</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="contenedorEgresoCaja">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Actividades -->
<div class="modal fade" id="modalActividadesCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Actividades</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div id="contenedorActividadesCaja" class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cerrar Caja -->
<div class="modal fade" id="modalCerrarCaja" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalCerrarCajaTitulo">Cerrar Caja</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="cerrarCajaError" class="alert alert-danger d-none"></div>

                <form id="formCerrarCaja">

                    <input type="hidden" id="Id" name="Id" />
                    <input type="hidden" id="ModoModificacion" name="modoModificacion" value="false" />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Usuario Inicio</label>
                            <input type="text" id="CajaDesc" class="form-control" readonly />
                        </div>

                        @* Pedido explicito del usuario (2026-09-07, ver docs/DECISIONS.md): antes
                           "Sucursal" iba en su propia fila arriba, como texto plano
                           (<div class="font-weight-bold">) en vez de label+input readonly como el
                           resto de los campos del modal -- se movio al lado de "Usuario Inicio". *@
                        <div class="col-md-6">
                            <label>Sucursal</label>
                            <input type="text" id="labelSucursal" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6 order-2 order-md-1">
                            <label>Caja Inicial</label>
                            <input type="text" id="CajaInicial" class="form-control" readonly />
                        </div>

                        <div class="col-md-6 order-1 order-md-2">
                            <label>Apertura</label>
                            <input type="text" id="FechaApertura" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Usuario Cierre</label>
                            <input type="text" id="Usuario" class="form-control" readonly />
                        </div>

                        <div class="col-md-6">
                            <label>Fecha Cierre</label>
                            <input type="text" id="FechaCierre" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Ventas</label>
                            <input type="text" id="Ventas" class="form-control" readonly />
                        </div>

                        <div class="col-md-6">
                            <label>EgresosCaja</label>
                            <input type="text" id="EgresosCaja" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Caja Cierre</label>
                            <input type="text" step="0.01" id="CajaCierre" name="CajaCierre" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>

                        <div class="col-md-6">
                            <label>Diferencia</label>
                            <input type="text" id="Diferencia" name="Diferencia" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Importe Retirado</label>
                            <input type="text" id="ImporteRetirado" name="ImporteRetirado" class="form-control" oninput="validarNumero(this); recalcularCierre();" />
                        </div>
                        <div class="col-md-6">
                            <label>Queda en Caja</label>
                            <input type="text" id="CajaInicioSiguiente" name="CajaInicioSiguiente" class="form-control" readonly style="font-weight:bold; font-size:1.25rem;" />
                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                @* Boton "Actividades" (quinta ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md
                   "Batch 6: boton Actividades en el pie de Cerrar Caja"): antes, el unico punto de
                   entrada a Actividades era el boton de la fila en la tabla de cajas abiertas
                   (fuera de este modal) -- el usuario tenia que cerrar/salir de Cerrar Caja para
                   llegar ahi. mr-auto lo empuja al extremo izquierdo del footer flex. Reusa
                   abrirModalActividades(idCierre) tal cual (ya global, lineas 677-707), con el id
                   de esta misma caja (input hidden #Id, ya cargado al abrir el modal). El z-index
                   de "modal sobre modal" ya esta resuelto para este caso exacto -- ver el handler
                   compartido de show.bs.modal para #modalActividadesCaja/#modalCerrarCaja/etc. *@
                <button type="button" class="btn btn-outline-secondary mr-auto" onclick="abrirModalActividades($('#Id').val())">
                    <i class="fas fa-stream mr-1"></i> Actividades
                </button>
                <button type="button" class="btn btn-danger" id="btnGuardarCierreCaja" onclick="guardarCierreCaja()">Cerrar Caja</button>
                <button class="btn btn-secondary" data-dismiss="modal" onclick="modalCerrarCaja()">Cancelar</button>
            </div>

        </div>
    </div>
</div>

