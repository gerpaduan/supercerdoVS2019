@section Scripts {
    <script src="@Url.Content("~/Scripts/app/seleccion-usuario.js")" asp-append-version="true"></script>
    <script>
        window.EgresosCajaUrls = {
            nuevo: '@Url.Action("NuevoEgresoCaja", "Cajas")',
            guardar: '@Url.Action("GuardarEgresoCaja", "Cajas")'
        };
        window.CajasHistorialUrls = {
            listar: '@Url.Action("HistorialCierresCaja", "Cajas")'
        };
        window.VentasCajaUrls = {
            mis: '@Url.Action("MisVentas", "Ventas")',
            detalle: '@Url.Action("DetalleVenta", "Ventas")'
        };
        window.CambioSucursalCajaUrls = {
            preview: '@Url.Action("PreviewCambioSucursalCaja", "Cajas")',
            guardar: '@Url.Action("CambiarSucursalCaja", "Cajas")'
        };
        window.CajasStepUpUrls = {
            autorizar: '@Url.Action("AutorizarAccionCierre", "Cajas")',
            revocar: '@Url.Action("RevocarAutorizacionCierre", "Cajas")'
        };
        window.CajasStepUpUsuarios = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(usuariosActivosEmpresa));
        window.CajasStepUpTienePermisoDirecto = @(tienePermisoCerrarCaja ? "true" : "false");

        // Autorizacion temporal de Cierre de Caja (step-up de credenciales) -----------
        // Si el usuario logueado ya tiene el permiso de cerrar caja, o si ya autorizo
        // hace menos de 5 minutos en esta misma vista, ejecuta la accion directo. Si no,
        // abre el selector de usuario+contraseña (componente reusable, ver
        // seleccion-usuario.js) y recien ejecuta la accion si la autorizacion vino bien.
        // Step-up real portado (tercera ronda de pedidos, 2026-09-10, ver docs/DECISIONS.md) --
        // esta rama SI se ejecuta para cualquier usuario logueado sin Permisos.Caja.CerrarCaja
        // directo (el comentario anterior, de cuando WebCore corria con usuario stub Admin, ya
        // no aplica desde que se porto el login real).
        var cierreCajaElevacionExpira = 0;
        var CIERRE_CAJA_ELEVACION_MS = 5 * 60 * 1000;

        function conAutorizacionCierre(accion) {
            if (window.CajasStepUpTienePermisoDirecto || Date.now() < cierreCajaElevacionExpira) {
                accion();
                return;
            }

            window.SeleccionUsuario.abrir({
                titulo: 'Autorizar accion de Cierre de Caja',
                usuarios: window.CajasStepUpUsuarios,
                requierePassword: true,
                validarUrl: window.CajasStepUpUrls.autorizar
            }).then(function (usuario) {
                cierreCajaElevacionExpira = Date.now() + CIERRE_CAJA_ELEVACION_MS;
                accion();
            }).catch(function () {
                // Modal cerrado sin autorizar (Cancelar/Esc/backdrop) -- no se ejecuta la accion.
            });
        }

        window.addEventListener('beforeunload', function () {
            if (navigator.sendBeacon) {
                navigator.sendBeacon(window.CajasStepUpUrls.revocar);
            }
        });

        function setBuscandoCajasAbiertas(buscando, mensaje) {
            const $btn = $("#btnBuscarCajasAbiertas");
            const $texto = $btn.find(".btn-buscar-texto");
            const $estado = $("#estadoBusquedaCajasAbiertasTabla");

            $btn.prop("disabled", buscando);
            $texto.text(buscando ? "Cargando..." : "Buscar");
            $estado.text(mensaje || (buscando ? "Actualizando búsqueda..." : "Resultados actualizados."));
        }

        function setBuscandoHistorial(buscando, mensaje) {
            const $estado = $("#estadoBusquedaHistorialCajas");
            $estado.text(mensaje || (buscando ? "Actualizando búsqueda..." : "Resultados actualizados."));
        }

        function filtrar() {
            const idSucursal = $("#idSucursal").val() || "";
            const buscar = $("#buscarVendedor").val() || "";
            const fechaDesde = $("#fechaDesde").val() || "";

            let pos = 0;
            const txt = document.getElementById("buscarVendedor");
            if (txt && document.activeElement === txt && typeof txt.selectionStart === "number") {
                pos = txt.selectionStart;
            }

            setBuscandoCajasAbiertas(true);
            $("#tablaResultado").html('<div class="p-4 text-center text-muted">Cargando resultados...</div>');

            if (window.CajasStepUpTienePermisoDirecto) {
                setBuscandoHistorial(true);
