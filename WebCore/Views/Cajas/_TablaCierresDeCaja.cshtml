@model System.Data.DataTable
@using System.Data
@using System.Globalization

@functions {
    string Valor(DataRow row, string columna)
    {
        if (row == null || row.Table == null || !row.Table.Columns.Contains(columna) || row[columna] == DBNull.Value)
            return "";

        return Convert.ToString(row[columna]) ?? "";
    }

    string FormatearFecha(DataRow row, string columna)
    {
        DateTime fecha;
        return DateTime.TryParse(Valor(row, columna), out fecha) ? fecha.ToString("dd/MM/yyyy HH:mm") : Valor(row, columna);
    }

    string FormatearMonto(DataRow row, string columna)
    {
        decimal monto;
        string valor = Valor(row, columna);
        if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.CurrentCulture, out monto) ||
            decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out monto))
            return monto.ToString("N2");

        return valor;
    }

    // Avisos del cierre (2026-10-06, ver docs/DECISIONS.md "Cambios en cajas cerradas y reapertura"): cantidad de
    // cambios (altas/modificaciones/eliminaciones de ventas, compras, pagos, egresos) hechos DESPUES del cierre y de
    // reaperturas. Las columnas solo vienen en Postgres: sin ellas (SQL Server) devuelve 0 y no se muestra nada.
    int Entero(DataRow row, string columna)
    {
        return int.TryParse(Valor(row, columna), out int n) ? n : 0;
    }

    // true solo si la consulta marco esta fila como "ultima caja del usuario" (Puede_Reabrir, solo Postgres).
    bool PuedeReabrirFila(DataRow row)
    {
        string v = Valor(row, "Puede_Reabrir");
        return v.Equals("True", StringComparison.OrdinalIgnoreCase) || v == "1" || v.Equals("t", StringComparison.OrdinalIgnoreCase);
    }

    // Origen del importe de cierre (conteo del cajero, 2026-10-06, ver docs/DECISIONS.md): se compara lo que declaro
    // el cajero (Conteo_Cajero) contra el cierre oficial (Caja_Cierre). La columna solo viene en Postgres; sin ella
    // (SQL Server) no se muestra nada. Devuelve (texto, clase del badge, detalle para el tooltip).
    (string Texto, string Clase, string Detalle) OrigenCierre(DataRow row)
    {
        if (row == null || row.Table == null || !row.Table.Columns.Contains("Conteo_Cajero"))
            return ("", "", "");

        string detalle = Valor(row, "Conteo_Cajero_Detalle");
        string fecha = Valor(row, "Conteo_Cajero_Fecha");
        string cuando = DateTime.TryParse(fecha, out DateTime f) ? f.ToString("dd/MM/yyyy HH:mm") : "";

        if (!decimal.TryParse(Valor(row, "Conteo_Cajero"), NumberStyles.Any, CultureInfo.CurrentCulture, out decimal conteo)
            && !decimal.TryParse(Valor(row, "Conteo_Cajero"), NumberStyles.Any, CultureInfo.InvariantCulture, out conteo))
            return ("Cargado por el encargado", "badge-secondary", "El cajero no cargó su cierre.");

        string conteoTxt = conteo.ToString("N2");
        string encabezado = "El cajero declaró $ " + conteoTxt + (cuando != "" ? " (" + cuando + ")" : "");
        string detalleTooltip = string.IsNullOrWhiteSpace(detalle) ? encabezado : encabezado + "\n" + detalle;

        bool hayCierre = decimal.TryParse(Valor(row, "Caja_Cierre"), NumberStyles.Any, CultureInfo.CurrentCulture, out decimal cierre)
            || decimal.TryParse(Valor(row, "Caja_Cierre"), NumberStyles.Any, CultureInfo.InvariantCulture, out cierre);

        return hayCierre && Math.Abs(cierre - conteo) < 0.005m
            ? ("Ingresado por el cajero", "badge-success", detalleTooltip)
            : ("Modificado por el encargado", "badge-warning", detalleTooltip);
    }
}

@{
    int items = Model != null ? Model.Rows.Count : 0;
    bool puedeModificarCierres = ViewBag.PuedeModificarCierres != null && (bool)ViewBag.PuedeModificarCierres;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div class="text-muted small">Resultados: @items</div>
    <div class="text-muted small">Histórico por sucursal desde la fecha seleccionada.</div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-bordered table-hover mb-0" id="tablaCierresHistoricos">
        <thead class="thead-light">
            <tr>
                <th>Id</th>
                <th>Iniciada por</th>
                <th>Inicio</th>
                <th>Cierre</th>
                <th class="text-right">Caja inicial</th>
                <th class="text-right">Ventas</th>
                <th class="text-right">EgresosCaja</th>
                <th class="text-right">Caja cierre</th>
                <th class="text-right">Diferencia</th>
                <th class="text-right">Caja ini sig</th>
                <th class="text-right">Retirado</th>
                <th>Cerrada por</th>
                <th title="Quién cargó el importe de Caja cierre: el cajero (desde Mi cierre) o el encargado">Origen del cierre</th>
                <th title="Cambios hechos en ventas, compras, pagos o egresos de esta caja después de cerrarla, y reaperturas">Avisos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Rows.Count > 0)
            {
                foreach (DataRow row in Model.Rows)
                {
                    <tr>
                        <td>@Valor(row, "id")</td>
                        <td>@Valor(row, "Iniciada_Por")</td>
                        <td>@FormatearFecha(row, "Inicio")</td>
                        <td>@FormatearFecha(row, "Cierre")</td>
                        <td class="text-right">@FormatearMonto(row, "Caja_Inicial")</td>
                        <td class="text-right">@FormatearMonto(row, "Ventas")</td>
                        <td class="text-right">@FormatearMonto(row, "EgresosCaja")</td>
                        <td class="text-right">@FormatearMonto(row, "Caja_Cierre")</td>
                        <td class="text-right">@FormatearMonto(row, "Diferencia")</td>
                        <td class="text-right">@FormatearMonto(row, "Caja_Ini_Sig")</td>
                        <td class="text-right">@FormatearMonto(row, "Retirado")</td>
                        <td>@Valor(row, "Cerrada_Por")</td>
                        @{ var origen = OrigenCierre(row); }
                        <td class="text-nowrap">
                            @if (origen.Texto != "")
                            {
                                <span class="badge @origen.Clase" title="@origen.Detalle">@origen.Texto</span>
                            }
                        </td>
                        @{
                            int cambiosPosteriores = Entero(row, "Cambios_Posteriores");
                            int reaperturas = Entero(row, "Reaperturas");
                            string cambiosFecha = FormatearFecha(row, "Cambios_Posteriores_Fecha");
                        }
                        <td class="text-nowrap">
                            @if (cambiosPosteriores > 0)
                            {
                                <span class="badge badge-danger" title="Se modificaron datos de esta caja después de cerrarla (última vez: @cambiosFecha). El cierre guardado puede estar desactualizado: abrí Modificar para ver el detalle.">
                                    <i class="fas fa-exclamation-triangle"></i> Modificada (@cambiosPosteriores)
                                </span>
                            }
                            @if (reaperturas > 0)
                            {
                                <span class="badge badge-info" title="Esta caja fue reabierta y vuelta a cerrar @reaperturas vez/veces.">
                                    <i class="fas fa-lock-open"></i> Reabierta (@reaperturas)
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (puedeModificarCierres)
                            {
                                <button type="button" class="btn btn-warning btn-sm" onclick="abrirModalCerrarCaja(@Valor(row, "id"), true)">
                                    <i class="fas fa-edit"></i> Modificar
                                </button>
                                @if (PuedeReabrirFila(row))
                                {
                                    @* Solo la ULTIMA caja de ese usuario en esa sucursal (la consulta marca Puede_Reabrir). *@
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-reabrir-caja" data-id="@Valor(row, "id")"
                                            title="Reabrir esta caja para que el vendedor pueda seguir vendiendo">
                                        <i class="fas fa-lock-open"></i> Reabrir
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="badge badge-secondary badge-modificar">Solo admin</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="15" class="text-center text-muted py-4">No se encontraron cierres de caja para los filtros seleccionados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
