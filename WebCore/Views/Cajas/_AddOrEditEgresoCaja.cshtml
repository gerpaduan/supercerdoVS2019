@model Entidades.EgresoCaja
@using System.Data
@using System.Globalization
@using System.Linq

@{
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    bool usuarioAdmin = ViewBag.UsuarioAdmin != null && (bool)ViewBag.UsuarioAdmin;
    bool esEdicion = ViewBag.EsEdicion != null && (bool)ViewBag.EsEdicion;
    var usuario = ViewBag.UsuarioActual as Entidades.Usuario;
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal>;
    var tipos = ViewBag.TiposEgresoCaja as DataTable;
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    int idSucursal = Model != null && Model.Sucursal != null && Model.Sucursal.idSucursal > 0 ? Model.Sucursal.idSucursal : (ViewBag.IdSucursal != null ? (int)ViewBag.IdSucursal : 0);
    bool mostrarSucursales = !desdePos && idCierreActividad == 0;
    string monto = Model != null && Model.Monto > 0 ? Model.Monto.ToString("0.##", CultureInfo.InvariantCulture) : "";
    // Sucursal del egreso: el repo Postgres solo trae el id (Model.Sucursal.SucursalNombre viene vacio), asi que se
    // resuelve por id contra la lista. Antes caia a la sucursal del USUARIO y mostraba otra al modificar un egreso.
    string sucursalActual = "";
    var sucursalDelEgreso = sucursales != null ? sucursales.FirstOrDefault(s => s.IdSucursal == idSucursal) : null;
    if (sucursalDelEgreso != null && !string.IsNullOrWhiteSpace(sucursalDelEgreso.SucursalNombre))
    {
        sucursalActual = sucursalDelEgreso.SucursalNombre;
    }
    else if (Model != null && Model.Sucursal != null && !string.IsNullOrWhiteSpace(Model.Sucursal.SucursalNombre))
    {
        sucursalActual = Model.Sucursal.SucursalNombre;
    }
    else if (usuario != null && usuario.Sucursal != null && !string.IsNullOrWhiteSpace(usuario.Sucursal.SucursalNombre))
    {
        sucursalActual = usuario.Sucursal.SucursalNombre;
    }
}

<div class="egreso-form-wrap">
    <form id="formEgresoCaja" data-desde-pos="@desdePos.ToString().ToLower()" data-id-cierre="@idCierreActividad">
        <input type="hidden" name="id" value="@(Model != null ? Model.Id : 0)" />
        <input type="hidden" name="desdePos" value="@desdePos.ToString().ToLower()" />
        <input type="hidden" name="idCierre" value="@idCierreActividad" />

        <div id="egresoCajaError" class="alert alert-danger d-none"></div>

        @* Encabezado en UNA linea (vendedor y sucursal juntos): ocupaba tres renglones y empujaba el formulario fuera
           de la pantalla (2026-10-06, ver docs/DECISIONS.md). *@
        <div class="egreso-form-head">
            <div class="egreso-form-head-linea">
                <span class="text-muted">@(esEdicion ? "Modificacion" : "Vendedor"):</span>
                <strong>@(usuario != null ? usuario.Nombre : "-")</strong>
                @if (!string.IsNullOrWhiteSpace(sucursalActual))
                {
                    <span class="egreso-form-head-sep" aria-hidden="true">&middot;</span>
                    <span class="text-muted">Sucursal:</span> <strong>@sucursalActual</strong>
                }
            </div>
            @if (desdePos)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnVolverMisEgresos">
                    <i class="fas fa-arrow-left"></i>
                </button>
            }
        </div>

        <div class="egreso-form-grid @(mostrarSucursales ? "egreso-con-sucursal" : "")">
            @if (mostrarSucursales)
            {
                <div class="form-group egreso-field egreso-field-sucursal">
                    <label>Sucursal</label>
                    <select class="form-control" name="idSucursal" id="egresoSucursal">
                        @if (sucursales != null)
                        {
                            foreach (var s in sucursales)
                            {
                                <option value="@s.IdSucursal" selected="@(s.IdSucursal == idSucursal ? "selected" : null)">@s.SucursalNombre</option>
                            }
                        }
                    </select>
                </div>
            }

            <div class="form-group egreso-field egreso-field-fecha">
                <label>Fecha</label>
                <input type="datetime-local"
                       class="form-control"
                       name="fecha"
                       id="egresoFecha"
                       value="@Model.Fecha.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="form-group egreso-field egreso-field-tipo">
                <label>Tipo</label>
                <select class="form-control" name="idTipoEgresoCaja" id="idTipoEgresoCaja">
                    <option value="0">Seleccione un tipo</option>
                    @if (tipos != null)
                    {
                        foreach (DataRow row in tipos.Rows)
                        {
                            int idTipo = Convert.ToInt32(row["id"]);
                            bool reservado = row.Table.Columns.Contains("Reservado")
                                && row["Reservado"] != DBNull.Value
                                && Convert.ToBoolean(row["Reservado"]);
                            if (idTipo == 0) { continue; }
                            if (!esEdicion && reservado) { continue; }
                            <option value="@idTipo" selected="@(Model != null && idTipo == Model.IdTipoEgresoCaja ? "selected" : null)">@row["tipoEgresoCaja"]</option>
                        }
                    }
                </select>
            </div>

            @if (!mostrarSucursales)
            {
                <input type="hidden" name="idSucursal" value="@idSucursal" />
            }

            <div class="form-group egreso-field egreso-field-descripcion">
                <label>Descripcion</label>
                <input type="text" class="form-control" id="egresoDescripcion" name="descripcion" maxlength="100" autocomplete="off" value="@(Model != null ? Model.Descripcion : "")" />
            </div>

            <div class="form-group egreso-field egreso-field-monto">
                <label>Monto</label>
                <div class="input-group">
                    <input type="text"
                           class="form-control solo-decimal egreso-monto"
                           id="egresoMonto"
                           name="monto"
                           inputmode="decimal"
                           autocomplete="off"
                           value="@monto" />
                    <div class="input-group-append">
                        <button type="button"
                                id="btnCalculadoraBilletesEgreso"
                                class="btn btn-outline-secondary js-calculadora-billetes-launch js-calculadora-billetes-egreso"
                                data-cb-context="egreso"
                                data-cb-input="#egresoMonto, [name='monto']"
                                data-cb-conteo="#egresoConteoBilletes"
                                data-cb-sin-post="true"
                                title="Calcular efectivo (Alt+B)">
                            <i class="fas fa-money-bill-wave"></i>
                        </button>
                    </div>
                </div>
            </div>

            @{
                string detalleActual = Model != null ? (Model.Detalle ?? "") : "";
                bool detalleTieneContenido = !string.IsNullOrWhiteSpace(detalleActual);
            }
            <div class="form-group egreso-field egreso-field-detalle">
                @* Pedido real (2026-09-15, ver docs/DECISIONS.md): colapsado por defecto salvo que
                   ya tenga contenido (edicion de un registro con detalle cargado) -- mismo patron
                   ya usado para "Observacion del comprobante" en _FacturaElectronica.cshtml
                   (feUsarObservaciones/feObservacionesWrap): un switch revela el campo, que queda
                   disabled mientras esta oculto (no se manda al servidor si no se activo). *@
                <div class="custom-control custom-switch mb-2">
                    <input type="checkbox" class="custom-control-input" id="egresoUsarDetalle" @(detalleTieneContenido ? "checked" : "")>
                    <label class="custom-control-label" for="egresoUsarDetalle">Detalle</label>
                </div>
                <div id="egresoDetalleWrap">
                    <textarea class="form-control" id="egresoDetalle" name="detalle" rows="2">@detalleActual</textarea>
                </div>
            </div>

            @* Conteo de billetes (2026-10-05, ver docs/DECISIONS.md): solo lectura; lo llena el contador (boton de
               billetes del Monto) en vez de volcarse al Detalle, y se imprime despues del detalle en el comprobante.
               "Limpiar contador" lo deja vacio. Siempre visible: se ve de un vistazo que hay un conteo cargado. *@
            <div class="form-group egreso-field egreso-field-conteo">
                <div class="d-flex justify-content-between align-items-center">
                    <label for="egresoConteoBilletes" class="mb-1">Conteo de billetes</label>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLimpiarConteoBilletesEgreso"
                            title="Dejar vacío el conteo de billetes">
                        <i class="fas fa-eraser mr-1"></i>Limpiar contador
                    </button>
                </div>
                <textarea class="form-control" id="egresoConteoBilletes" name="conteoBilletes" rows="3" readonly tabindex="-1">@(Model != null ? Model.ConteoBilletes : "")</textarea>
            </div>
        </div>

        <div class="egreso-form-actions">
            @if (esEdicion)
            {
                @* Modo vista: Imprimir (abre el modal de comprobante: cerrar / ticket / PDF / mail) junto a Modificar.
                   Al activar la modificacion ambos se ocultan (ver setSoloLectura). *@
                <div class="egreso-acciones-vista">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btnImprimirEgresoCaja"
                            data-edit-readonly-ignore="true"
                            data-id="@(Model != null ? Model.Id : 0)"
                            data-ticket-url="@Url.Action("ImprimirTicketEgreso", "Cajas", new { id = Model != null ? Model.Id : 0 })"
                            data-ticket-payload-url="@Url.Action("ImprimirTicketEgresoPayload", "Cajas", new { id = Model != null ? Model.Id : 0 })"
                            data-pdf-url="@Url.Action("ImprimirPdfEgreso", "Cajas", new { id = Model != null ? Model.Id : 0 })"
                            data-email-datos-url="@Url.Action("ObtenerDatosEmailEgreso", "Cajas", new { id = Model != null ? Model.Id : 0 })"
                            data-email-enviar-url="@Url.Action("EnviarEgresoEmail", "Cajas")">
                        <i class="fas fa-print mr-1"></i> Imprimir
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            id="btnHabilitarEdicionEgresoCaja"
                            data-edit-readonly-ignore="true">
                        <i class="fas fa-edit mr-1"></i> Modificar
                    </button>
                </div>
            }
            <button type="submit" class="btn btn-success btn-block @(esEdicion ? "d-none" : "")" id="btnGuardarEgresoCaja">
                <i class="fas fa-save mr-1"></i> Guardar egreso
            </button>
        </div>
    </form>
</div>

<style>
    .egreso-form-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .55rem;
        padding-bottom: .45rem;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
    }

    .egreso-form-head .text-muted {
        margin-bottom: 0;
        line-height: 1.1;
    }

    .egreso-form-head strong {
        line-height: 1.15;
    }

    .egreso-form-head small {
        margin-bottom: 0;
        line-height: 1.1;
    }

    .egreso-form-grid .form-group label {
        margin-bottom: .25rem;
        font-size: .875rem;
    }

    .egreso-form-grid .form-group {
        margin-bottom: .5rem;
    }

    /* Que el formulario entre entero en el modal sin scroll: menos aire en el contenedor y en el encabezado (que ahora
       es una sola linea). Los selectores llevan body.app-shell para ganarle a ui-refresh.css / custom.css. */
    body.app-shell .egreso-form-wrap {
        padding: .65rem .9rem;
        margin-bottom: 0;
    }

    body.app-shell .egreso-form-head {
        padding: .35rem .75rem;
        margin-bottom: .55rem;
    }

    .egreso-form-head-linea { line-height: 1.3; }
    .egreso-form-head-sep { margin: 0 .4rem; opacity: .6; }

    /* El conteo de billetes es de solo lectura: sin handle de redimensionar (su alto se ajusta al contenido). */
    .egreso-form-grid .egreso-field-conteo textarea {
        min-height: 4.4rem;
        resize: none;
        line-height: 1.25;
        font-size: calc(1rem - 2pt); /* 2 pt mas chico que el resto de los campos */
    }

    .egreso-form-grid .egreso-field-detalle textarea {
        min-height: 4.4rem;
        resize: vertical;
    }

    @@media (min-width: 992px) {
        .egreso-form-wrap {
            max-width: 100%;
        }

        /* 12 columnas: Fecha | Tipo (o Sucursal | Fecha | Tipo), Descripcion | Monto, Detalle | Conteo. */
        .egreso-form-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: 0 1rem;
            align-items: start;
        }

        .egreso-form-grid .egreso-field {
            min-width: 0;
        }

        .egreso-form-grid .egreso-field-sucursal { grid-column: span 4; }
        .egreso-form-grid .egreso-field-fecha,
        .egreso-form-grid .egreso-field-tipo { grid-column: span 6; }
        .egreso-form-grid.egreso-con-sucursal .egreso-field-fecha,
        .egreso-form-grid.egreso-con-sucursal .egreso-field-tipo { grid-column: span 4; }
        .egreso-form-grid .egreso-field-descripcion { grid-column: span 8; }
        .egreso-form-grid .egreso-field-monto { grid-column: span 4; }
        .egreso-form-grid .egreso-field-detalle,
        .egreso-form-grid .egreso-field-conteo { grid-column: span 6; }

        .egreso-form-actions {
            margin-top: .25rem;
        }

        .egreso-form-actions > .btn {
            max-width: 18rem;
            margin-left: auto;
        }

        .egreso-form-actions .egreso-acciones-vista {
            max-width: 22rem;
            margin-left: auto;
        }
    }

    /* Modo vista: Imprimir y Modificar lado a lado, cada uno a mitad de ancho (se ocultan solos con d-none). */
    .egreso-acciones-vista { display: flex; gap: .5rem; margin-bottom: .5rem; }
    .egreso-acciones-vista .btn { flex: 1 1 0; }
</style>

<script>
    (function () {
        if (window.EgresosCaja && typeof window.EgresosCaja.bindForm === "function") {
            window.EgresosCaja.bindForm("#formEgresoCaja");
        }

        var soloLecturaInicial = @Html.Raw(esEdicion ? "true" : "false");
        var esDesdePos = @Html.Raw(desdePos ? "true" : "false");
        var form = document.getElementById("formEgresoCaja");
        var btnModificar = document.getElementById("btnHabilitarEdicionEgresoCaja");
        var btnGuardar = document.getElementById("btnGuardarEgresoCaja");
        var selectSucursal = document.getElementById("egresoSucursal") || (form ? form.querySelector("[name='idSucursal']") : null);
        var inputFecha = document.getElementById("egresoFecha") || (form ? form.querySelector("[name='fecha']") : null);
        var selectTipo = document.getElementById("idTipoEgresoCaja") || (form ? form.querySelector("[name='idTipoEgresoCaja']") : null);
        var inputDescripcion = document.getElementById("egresoDescripcion") || (form ? form.querySelector("[name='descripcion']") : null);
        var inputMonto = document.getElementById("egresoMonto") || (form ? form.querySelector("[name='monto']") : null);
        var inputDetalle = document.getElementById("egresoDetalle") || (form ? form.querySelector("[name='detalle']") : null);
        var chkUsarDetalle = document.getElementById("egresoUsarDetalle");
        var wrapDetalle = document.getElementById("egresoDetalleWrap");

        // Pedido real (2026-09-15, ver docs/DECISIONS.md): mismo patron que
        // syncObservacionesComprobante (factura-electronica.js) -- oculta y deshabilita el
        // textarea mientras el switch esta apagado (deshabilitado = $form.serialize() no lo manda
        // al guardar), lo muestra y habilita cuando se prende.
        function syncUsarDetalle() {
            if (!chkUsarDetalle || !wrapDetalle || !inputDetalle) return;
            var activo = chkUsarDetalle.checked;
            wrapDetalle.classList.toggle("d-none", !activo);
            inputDetalle.disabled = !activo;
        }

        if (chkUsarDetalle) {
            chkUsarDetalle.addEventListener("change", syncUsarDetalle);
        }
        syncUsarDetalle();

        // La calculadora de billetes escribe el conteo en #egresoDetalle por JS: con el switch "Detalle" apagado el
        // textarea esta oculto y DESHABILITADO (no se manda al guardar), y el conteo se perdia. Si se cargo un
        // detalle, se prende el switch para que se vea y se guarde. jQuery (no addEventListener) porque la
        // calculadora dispara sus eventos con $.trigger.
        if (chkUsarDetalle && inputDetalle && window.jQuery) {
            window.jQuery(inputDetalle).on("input change", function () {
                if (!chkUsarDetalle.checked && (inputDetalle.value || "").trim() !== "") {
                    chkUsarDetalle.checked = true;
                    syncUsarDetalle();
                }
            });
        }

        // Pedido real (2026-09-15, ver docs/DECISIONS.md): solo numeros validos, puntos de miles
        // en pantalla, y "." tecleado se interpreta como la coma decimal -- mismo mecanismo ya
        // usado en Productos/Index.cshtml (#PrecioKg). egresos-caja.js (bindForm) manda el valor
        // "de negocio" (sin puntos de miles) al guardar, no el que se ve en pantalla.
        if (inputMonto && window.MoneyInputMask) {
            window.MoneyInputMask.attach(inputMonto);
        }
        var tiposDisponibles = [];
        var busquedaTipoTexto = "";
        var busquedaTipoTimer = null;
        var ultimaTeclaTipo = "";

        if (selectTipo && selectTipo.options) {
            Array.prototype.forEach.call(selectTipo.options, function (option) {
                var id = option && option.value ? parseInt(option.value, 10) : 0;
                var texto = option ? (option.text || "") : "";
                if (!id || !texto) {
                    return;
                }

                tiposDisponibles.push({
                    id: id,
                    texto: texto,
                    normalizado: texto.toLowerCase()
                });
            });
        }

        function dispararEventos(control, eventos) {
            if (!control || !eventos || !eventos.length) {
                return;
            }

            eventos.forEach(function (nombre) {
                var evt;
                try {
                    evt = new Event(nombre, { bubbles: true });
                } catch (e) {
                    evt = document.createEvent("Event");
                    evt.initEvent(nombre, true, true);
                }

                control.dispatchEvent(evt);
            });
        }

        function focusAndSelect(control) {
            if (!control) {
                return;
            }

            control.focus();
            if (typeof control.select === "function" && control.tagName !== "SELECT") {
                control.select();
            }
        }

        function buscarTipoCoincidente(texto) {
            var valor = (texto || "").toString().trim().toLowerCase();
            if (!valor) {
                return null;
            }

            for (var i = 0; i < tiposDisponibles.length; i++) {
                if (tiposDisponibles[i].normalizado === valor) {
                    return tiposDisponibles[i];
                }
            }

            for (var j = 0; j < tiposDisponibles.length; j++) {
                if (tiposDisponibles[j].normalizado.indexOf(valor) === 0) {
                    return tiposDisponibles[j];
                }
            }

            for (var k = 0; k < tiposDisponibles.length; k++) {
                if (tiposDisponibles[k].normalizado.indexOf(valor) >= 0) {
                    return tiposDisponibles[k];
                }
            }

            return null;
        }

        function seleccionarTipoCoincidente(texto) {
            if (!selectTipo) {
                return false;
            }

            var coincidencia = buscarTipoCoincidente(texto);
            if (!coincidencia) {
                return false;
            }

            selectTipo.value = String(coincidencia.id);
            dispararEventos(selectTipo, ["input", "change"]);
            return true;
        }

        function resetBusquedaTipo() {
            busquedaTipoTexto = "";
            ultimaTeclaTipo = "";
            if (busquedaTipoTimer) {
                clearTimeout(busquedaTipoTimer);
                busquedaTipoTimer = null;
            }
        }

        function acumularBusquedaTipo(caracter) {
            busquedaTipoTexto += caracter.toLowerCase();
            if (busquedaTipoTimer) {
                clearTimeout(busquedaTipoTimer);
            }

            busquedaTipoTimer = setTimeout(function () {
                resetBusquedaTipo();
            }, 850);
        }

        function refrescarBusquedaTipo() {
            if (busquedaTipoTimer) {
                clearTimeout(busquedaTipoTimer);
            }

            busquedaTipoTimer = setTimeout(function () {
                resetBusquedaTipo();
            }, 850);
        }

        function seleccionarSiguienteTipoPorInicial(caracter) {
            if (!selectTipo) {
                return false;
            }

            var valor = (caracter || "").toString().trim().toLowerCase();
            if (!valor) {
                return false;
            }

            var coincidencias = [];
            for (var i = 0; i < tiposDisponibles.length; i++) {
                if (tiposDisponibles[i].normalizado.indexOf(valor) === 0) {
                    coincidencias.push(tiposDisponibles[i]);
                }
            }

            if (!coincidencias.length) {
                return false;
            }

            var actual = (selectTipo.value || "").toString();
            var indiceActual = -1;
            for (var j = 0; j < coincidencias.length; j++) {
                if (String(coincidencias[j].id) === actual) {
                    indiceActual = j;
                    break;
                }
            }

            var siguiente = coincidencias[(indiceActual + 1) % coincidencias.length];
            selectTipo.value = String(siguiente.id);
            dispararEventos(selectTipo, ["input", "change"]);
            return true;
        }

        function bindBusquedaTipoSelect(control) {
            if (!control) {
                return;
            }

            control.addEventListener("keydown", function (evt) {
                if (evt.altKey || evt.ctrlKey || evt.metaKey) {
                    return;
                }

                var tecla = evt.key || "";
                if (tecla.length !== 1 || /\s/.test(tecla)) {
                    return;
                }

                var teclaNormalizada = tecla.toLowerCase();
                if (busquedaTipoTexto.length === 1
                    && busquedaTipoTexto === teclaNormalizada
                    && ultimaTeclaTipo === teclaNormalizada) {
                    refrescarBusquedaTipo();
                    seleccionarSiguienteTipoPorInicial(teclaNormalizada);
                    evt.preventDefault();
                    return;
                }

                acumularBusquedaTipo(tecla);
                ultimaTeclaTipo = teclaNormalizada;

                if (seleccionarTipoCoincidente(busquedaTipoTexto)) {
                    evt.preventDefault();
                    return;
                }

                seleccionarTipoCoincidente(tecla);
                evt.preventDefault();
            });

            control.addEventListener("blur", resetBusquedaTipo);
        }

        function avanzarFocusEgreso(actual) {
            if (!actual) {
                return;
            }

            if (actual === selectSucursal) {
                focusAndSelect(inputFecha);
                return;
            }

            if (actual === selectTipo) {
                focusAndSelect(esDesdePos ? inputDescripcion : inputFecha);
                return;
            }

            if (actual === inputFecha) {
                focusAndSelect(esDesdePos ? inputDescripcion : selectTipo);
                return;
            }

            if (actual === inputDescripcion) {
                focusAndSelect(inputMonto);
                return;
            }

            if (actual === inputMonto) {
                focusAndSelect(inputDetalle);
                return;
            }

            if (actual === inputDetalle) {
                if (btnGuardar && !btnGuardar.classList.contains("d-none") && !btnGuardar.disabled) {
                    btnGuardar.focus();
                    btnGuardar.click();
                }
            }
        }

        function bindEnterFlow(control) {
            if (!control) {
                return;
            }

            control.addEventListener("keydown", function (evt) {
                if (evt.key !== "Enter" || evt.shiftKey || evt.altKey || evt.ctrlKey || evt.metaKey) {
                    return;
                }

                evt.preventDefault();
                avanzarFocusEgreso(control);
            });
        }

        function setSoloLectura(readOnly) {
            if (!form) {
                return;
            }

            var controls = form.querySelectorAll("input, select, textarea");
            var calcButtons = form.querySelectorAll(".js-calculadora-billetes-launch");
            Array.prototype.forEach.call(controls, function (control) {
                if (!control || control.type === "hidden") {
                    return;
                }

                // El conteo de billetes es SIEMPRE de solo lectura (lo llena el contador, no se tipea).
                if (control.id === "egresoConteoBilletes") {
                    return;
                }

                if (readOnly) {
                    if (control.tagName === "SELECT") {
                        control.disabled = true;
                    } else {
                        control.readOnly = true;
                    }
                } else {
                    if (control.tagName === "SELECT") {
                        control.disabled = false;
                    } else {
                        control.readOnly = false;
                    }
                }
            });

            Array.prototype.forEach.call(calcButtons, function (button) {
                button.disabled = !!readOnly;
            });

            if (btnLimpiarConteo) {
                btnLimpiarConteo.disabled = !!readOnly;
            }

            if (btnModificar) {
                btnModificar.classList.toggle("d-none", !readOnly);
            }

            // Imprimir solo existe en modo vista: al activar la modificacion desaparece junto con Modificar
            // (se oculta el contenedor para no dejar un hueco de margen).
            var acciones = document.querySelector("#formEgresoCaja .egreso-acciones-vista");
            if (acciones) {
                acciones.classList.toggle("d-none", !readOnly);
            }

            if (btnGuardar) {
                btnGuardar.classList.toggle("d-none", readOnly);
                btnGuardar.disabled = readOnly;
            }
        }

        if (form) {
            form.addEventListener("submit", function (evt) {
                if (soloLecturaInicial) {
                    evt.preventDefault();
                    return false;
                }
            });
        }

        // Imprimir (modo vista): abre el mismo modal de comprobante que al guardar. Sin onClose: el formulario sigue abierto.
        var btnImprimir = document.getElementById("btnImprimirEgresoCaja");
        if (btnImprimir) {
            btnImprimir.addEventListener("click", function () {
                if (!window.PostComprobanteModal) {
                    return;
                }
                window.PostComprobanteModal.open({
                    titulo: "Egreso de caja N° " + btnImprimir.dataset.id,
                    mensaje: "¿Qué querés hacer con el comprobante?",
                    ticketUrl: btnImprimir.dataset.ticketUrl,
                    ticketPayloadUrl: btnImprimir.dataset.ticketPayloadUrl,
                    pdfUrl: btnImprimir.dataset.pdfUrl,
                    emailDatosUrl: btnImprimir.dataset.emailDatosUrl,
                    emailEnviarUrl: btnImprimir.dataset.emailEnviarUrl,
                    emailIdCampo: "idEgreso",
                    id: btnImprimir.dataset.id
                });
            });
        }

        if (btnModificar) {
            btnModificar.addEventListener("click", function () {
                soloLecturaInicial = false;
                setSoloLectura(false);
            });
        }

        // Calculadora de billetes: la abre el delegado de calculadora-billetes-targets.js a partir de los data-cb-*
        // del boton (monto -> #egresoMonto, conteo -> #egresoConteoBilletes, sin modal de impresion). Antes habia
        // aca un handler propio ademas del delegado (abria la calculadora dos veces y volcaba el conteo al Detalle):
        // se quito para que haya UNA sola fuente. "Limpiar contador" deja vacio el conteo.
        // El conteo ajusta su alto al contenido (entre 3 y 7 renglones) para verse completo sin scroll en el modal.
        // jQuery (no addEventListener) porque la calculadora dispara sus eventos con $.trigger.
        function ajustarAlturaConteo() {
            var campo = document.getElementById("egresoConteoBilletes");
            if (!campo) {
                return;
            }

            var renglones = (campo.value || "").split("\n").length;
            campo.rows = Math.min(7, Math.max(3, renglones));
        }

        if (window.jQuery) {
            window.jQuery("#egresoConteoBilletes").on("input change", ajustarAlturaConteo);
        }
        ajustarAlturaConteo();

        var btnLimpiarConteo = document.getElementById("btnLimpiarConteoBilletesEgreso");
        if (btnLimpiarConteo) {
            btnLimpiarConteo.addEventListener("click", function () {
                var inputConteo = document.getElementById("egresoConteoBilletes");
                if (!inputConteo) {
                    return;
                }

                inputConteo.value = "";
                dispararEventos(inputConteo, ["input", "change"]);
            });
        }

        bindBusquedaTipoSelect(selectTipo);
        bindEnterFlow(selectSucursal);
        bindEnterFlow(selectTipo);
        bindEnterFlow(inputFecha);
        bindEnterFlow(inputDescripcion);
        bindEnterFlow(inputMonto);
        bindEnterFlow(inputDetalle);

        setSoloLectura(soloLecturaInicial);

        // Pedido real (2026-09-15, ver docs/DECISIONS.md): Alt+Enter guarda el registro, o si el
        // formulario todavia esta en modo solo-lectura (edicion sin "Modificar" presionado
        // todavia), habilita la edicion -- mismo combo ya establecido en el proyecto para
        // guardar (Scripts/app/form-hotkeys.js: Alt+Enter=Guardar), pero implementado localmente
        // (no via ese modulo compartido) porque aca el boton "destino" cambia dinamicamente entre
        // Modificar/Guardar segun soloLecturaInicial, y form-hotkeys.js cachea el boton una sola
        // vez al iniciar (no sirve para un destino que cambia en la misma carga del formulario).
        // Se re-registra en cada carga de este parcial (reemplaza el handler anterior por su
        // referencia en window) para no acumular listeners duplicados en document tras abrir el
        // modal varias veces.
        if (window.__egresoCajaAltEnterHandler) {
            document.removeEventListener("keydown", window.__egresoCajaAltEnterHandler, true);
        }
        window.__egresoCajaAltEnterHandler = function (evt) {
            if (!evt.altKey || evt.ctrlKey || evt.metaKey || evt.shiftKey || evt.repeat) return;
            if (String(evt.key || "").toLowerCase() !== "enter") return;
            if (!form || !$(form).is(":visible")) return;
            if (window.Swal && typeof window.Swal.isVisible === "function" && window.Swal.isVisible()) return;

            // Mismo criterio que form-hotkeys.js (getTopVisibleModal): si hay un modal visible, el
            // atajo solo actua si este formulario esta dentro de ese modal (o es el modal mismo) --
            // evita disparar el guardado/habilitar si este form quedo abierto detras de otro modal.
            var $topModal = $(".modal.show:visible").last();
            if ($topModal.length && !$.contains($topModal[0], form) && $topModal[0] !== form) return;

            evt.preventDefault();
            evt.stopPropagation();

            if (soloLecturaInicial) {
                if (btnModificar && !btnModificar.classList.contains("d-none")) {
                    btnModificar.click();
                }
                return;
            }

            if (btnGuardar && !btnGuardar.disabled && !btnGuardar.classList.contains("d-none")) {
                if (typeof form.requestSubmit === "function") {
                    form.requestSubmit(btnGuardar);
                } else {
                    btnGuardar.click();
                }
            }
        };
        document.addEventListener("keydown", window.__egresoCajaAltEnterHandler, true);

        function enfocarInicialEgreso() {
            var selector = @Html.Raw(esEdicion ? "\"#btnHabilitarEdicionEgresoCaja\"" : (desdePos ? "\"#idTipoEgresoCaja\"" : "\"#egresoFecha\""));
            var el = document.querySelector(selector);
            if (!el) {
                return;
            }

            el.focus();
            if (!@Html.Raw(esEdicion ? "true" : "false") && typeof el.select === "function") {
                el.select();
            }
        }

        setTimeout(function () {
            enfocarInicialEgreso();
        }, 100);

        if (esDesdePos) {
            setTimeout(enfocarInicialEgreso, 220);
            setTimeout(enfocarInicialEgreso, 420);
        }
    })();
</script>
