@model System.Data.DataTable
@using System.Data
@using System.Collections.Generic
@using System.Globalization
@using System.Linq

@functions {
    string Valor(DataRow row, string columna)
    {
        if (row == null || row.Table == null || !row.Table.Columns.Contains(columna) || row[columna] == DBNull.Value)
            return "";

        return Convert.ToString(row[columna]) ?? "";
    }

    string NormalizarNombreColumna(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "";

        return new string(nombre.Normalize(System.Text.NormalizationForm.FormD)
            .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            .ToArray())
            .Replace(" ", "")
            .Trim()
            .ToLowerInvariant();
    }

    string ValorFlexible(DataRow row, params string[] columnas)
    {
        if (row == null || row.Table == null || columnas == null || columnas.Length == 0)
            return "";

        foreach (string columna in columnas)
        {
            if (string.IsNullOrWhiteSpace(columna))
                continue;

            if (row.Table.Columns.Contains(columna) && row[columna] != DBNull.Value)
                return Convert.ToString(row[columna]) ?? "";
        }

        foreach (DataColumn column in row.Table.Columns)
        {
            string nombreActual = NormalizarNombreColumna(column.ColumnName);

            foreach (string columna in columnas)
            {
                if (NormalizarNombreColumna(columna) == nombreActual && row[column] != DBNull.Value)
                    return Convert.ToString(row[column]) ?? "";
            }
        }

        return "";
    }

    string Descripcion(DataRow row)
    {
        if (row == null || row.Table == null)
            return "";

        foreach (DataColumn column in row.Table.Columns)
        {
            string nombre = column.ColumnName;
            string nombreSinAcentos = new string(nombre.Normalize(System.Text.NormalizationForm.FormD)
                .Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                .ToArray());

            if (string.Equals(nombreSinAcentos, "Descripcion", StringComparison.OrdinalIgnoreCase))
                return Valor(row, nombre);
        }

        return "";
    }

    string Fecha(DataRow row, string columna)
    {
        DateTime fecha;
        return DateTime.TryParse(Valor(row, columna), out fecha) ? fecha.ToString("dd/MM/yyyy HH:mm") : Valor(row, columna);
    }

    // Parte de la fecha (formato indicado) para la vista de actividades, que muestra fecha y hora en renglones separados.
    string FechaParte(DataRow row, string columna, string formato)
    {
        DateTime fecha;
        return DateTime.TryParse(Valor(row, columna), out fecha) ? fecha.ToString(formato) : "";
    }

    // Clase de color del pill de Tipo segun la categoria del movimiento (solo vista de actividades).
    string ClasePillTipo(DataRow row)
    {
        if (EsPagoCobro(row)) return "egreso-tipo-pill-cobro";
        if (EsCtaCte(row)) return "egreso-tipo-pill-ctacte";
        if (EsPagoElectronico(row)) return "egreso-tipo-pill-electronico";
        return "egreso-tipo-pill-egreso";
    }

    // Fecha con segundos (dd/MM/yyyy HH:mm:ss) para la columna Creado, igual que en Elaborados.
    string FechaHora(DataRow row, string columna)
    {
        DateTime fecha;
        return DateTime.TryParse(Valor(row, columna), out fecha) ? fecha.ToString("dd/MM/yyyy HH:mm:ss") : "";
    }

    string Monto(DataRow row)
    {
        decimal monto;
        string valor = Valor(row, "Monto");
        if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.CurrentCulture, out monto) ||
            decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out monto))
            return monto.ToString("N2");

        return valor;
    }

    string Id(DataRow row)
    {
        return Valor(row, "id");
    }

    bool EsPagoElectronico(DataRow row)
    {
        return string.Equals(Valor(row, "TipoEgresoCaja"), "Pago Electronico", StringComparison.OrdinalIgnoreCase);
    }

    bool EsCtaCte(DataRow row)
    {
        return string.Equals(Valor(row, "TipoEgresoCaja"), "Cta Cte", StringComparison.OrdinalIgnoreCase);
    }

    bool EsPagoCobro(DataRow row)
    {
        string tipo = Valor(row, "TipoEgresoCaja");
        if (string.IsNullOrWhiteSpace(tipo))
            return false;

        string tipoNormalizado = tipo.Replace(" ", "");
        return tipoNormalizado.IndexOf("Pago", StringComparison.OrdinalIgnoreCase) >= 0 &&
               tipoNormalizado.IndexOf("Cobro", StringComparison.OrdinalIgnoreCase) >= 0;
    }

    // Venta vinculada (2026-11-14, ver docs/DECISIONS.md "Forma de pago y venta vinculada"): el egreso "Pago Electronico" / "Cta Cte"
    // de una venta guarda tabla = "Ventas" e idtabla = nro de venta (Negocio.Venta.egresoCajaPagoTarjeta). Devuelve ese nro, o 0 si
    // la fila no tiene venta vinculada (otros tipos, o la consulta no trae las columnas: p. ej. el motor SQL Server).
    int IdVentaVinculada(DataRow row)
    {
        if (!EsPagoElectronico(row) && !EsCtaCte(row))
            return 0;
        if (!string.Equals(Valor(row, "Tabla"), "Ventas", StringComparison.OrdinalIgnoreCase))
            return 0;

        int idVenta;
        return int.TryParse(Valor(row, "IdTabla"), NumberStyles.Integer, CultureInfo.InvariantCulture, out idVenta) && idVenta > 0 ? idVenta : 0;
    }

    // Descripcion que se muestra en la fila de Mis actividades cuando hay venta vinculada (2026-11-14, docs/DECISIONS.md "Descripcion
    // corta"): solo el nombre de la venta ("Venta Mixta", "Venta Debito"...), sin importes, sin "ID:nnn" ni etiqueta de venta; esos datos
    // estan en el desplegable. Cta Cte: "Venta Cta Cte" (el cliente se muestra aparte). El texto completo se guarda en la base tal cual.
    string DescripcionCorta(DataRow row)
    {
        string completa = Descripcion(row);
        if (IdVentaVinculada(row) == 0)
            return completa;
        if (EsCtaCte(row))
            return "Venta Cta Cte";

        int corte = completa.IndexOf(" - ", StringComparison.Ordinal);
        return corte > 0 ? completa.Substring(0, corte).Trim() : completa;
    }

    string ClienteRazonSocial(DataRow row)
    {
        return Valor(row, "ClienteRazonSocial").Trim();
    }

    // Nombre corto del cliente de una venta a cuenta corriente: su Identificacion; si esta vacia, la razon social; y si la consulta no
    // trae al cliente (p. ej. el motor SQL Server) se toma del texto del egreso: "Venta a <razon social> - ID:nnn".
    string ClienteNombreCorto(DataRow row)
    {
        string identificacion = Valor(row, "ClienteIdentificacion").Trim();
        if (identificacion.Length > 0)
            return identificacion;

        string razonSocial = ClienteRazonSocial(row);
        if (razonSocial.Length > 0)
            return razonSocial;

        const string prefijo = "Venta a ";
        string descripcion = Descripcion(row);
        int fin = descripcion.LastIndexOf(" - ID:", StringComparison.Ordinal);
        return descripcion.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) && fin > prefijo.Length
            ? descripcion.Substring(prefijo.Length, fin - prefijo.Length).Trim()
            : "";
    }

    // Bloque "Cliente" del desplegable de una venta a cuenta corriente: la razon social y, mas sutil y sin rotulo, el nombre corto
    // (la Identificacion) solo si es distinto; si son iguales se muestra una sola vez.
    void ClienteBloque(DataRow row)
    {
        string razonSocial = ClienteRazonSocial(row);
        string nombreCorto = ClienteNombreCorto(row);
        string principal = razonSocial.Length > 0 ? razonSocial : nombreCorto;
        if (principal.Length == 0)
            return;

        bool mostrarNombreCorto = nombreCorto.Length > 0 && !string.Equals(nombreCorto, principal, StringComparison.OrdinalIgnoreCase);
        <div class="egreso-cliente-bloque">
            <span class="egreso-cliente-lbl">Cliente</span>
            <span class="egreso-cliente-rs">@principal</span>
            @if (mostrarNombreCorto)
            {
                <span class="egreso-cliente-id">@nombreCorto</span>
            }
        </div>
    }

    // "ANULACION:" (anulacion de un egreso) o "ELIMINADO:" (egreso opuesto que genera Negocio.Compra.eliminarCompra al borrar una compra).
    bool EsAnulacion(DataRow row)
    {
        string descripcion = Descripcion(row);
        return descripcion.StartsWith("ANULACION", StringComparison.OrdinalIgnoreCase)
            || descripcion.StartsWith("ELIMINADO:", StringComparison.OrdinalIgnoreCase);
    }

    bool FueReemplazadoPorAnulacion(DataRow row, ISet<string> descripcionesAnuladas)
    {
        if (row == null || descripcionesAnuladas == null || descripcionesAnuladas.Count == 0)
            return false;

        return descripcionesAnuladas.Contains(Descripcion(row));
    }

    bool EsEgresoCajaModificado(DataRow row)
    {
        if (row == null)
            return false;

        if (EsPagoCobro(row) || EsCtaCte(row) || EsPagoElectronico(row) || EsAnulacion(row))
            return false;

        return !string.IsNullOrWhiteSpace(Valor(row, "Actualizado"));
    }

    string Categoria(DataRow row)
    {
        if (EsPagoCobro(row))
            return "Pago | Cobro";
        if (EsCtaCte(row))
            return "Cta Cte";
        if (EsPagoElectronico(row))
            return "Pago electronico";
        return "Egreso de caja";
    }

    bool EsGasto(DataRow row, DataTable tiposEgresoCajaLookup)
    {
        if (row == null)
            return false;

        if (row.Table.Columns.Contains("Gasto") && row["Gasto"] != DBNull.Value)
        {
            string valorDirecto = Convert.ToString(row["Gasto"]);
            return string.Equals(valorDirecto, "true", StringComparison.OrdinalIgnoreCase) || valorDirecto == "1";
        }

        if (tiposEgresoCajaLookup == null || !tiposEgresoCajaLookup.Columns.Contains("Es_Gasto"))
            return false;

        string tipoFila = Valor(row, "TipoEgresoCaja");
        foreach (DataRow tipo in tiposEgresoCajaLookup.Rows)
        {
            if (string.Equals(Convert.ToString(tipo["tipoEgresoCaja"]), tipoFila, StringComparison.OrdinalIgnoreCase))
            {
                string valor = Convert.ToString(tipo["Es_Gasto"]);
                return string.Equals(valor, "true", StringComparison.OrdinalIgnoreCase) || valor == "1";
            }
        }

        return false;
    }
}

@{
    int items = Model != null ? Model.Rows.Count : 0;
    decimal total = 0;
    bool modoActividades = ViewBag.ModoActividades != null && (bool)ViewBag.ModoActividades;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    var idsModificables = ViewBag.IdsEgresosModificables as HashSet<int> ?? new HashSet<int>();
    var comprasModificables = ViewBag.ComprasModificables as Dictionary<int, int> ?? new Dictionary<int, int>();
    var descripcionesAnuladas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    // Subconjunto de las anuladas que lo fueron por eliminar la compra (egreso "ELIMINADO:"): el aviso de la fila lo dice.
    var descripcionesEliminadas = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    string sucursalActividad = ViewBag.SucursalActividad as string ?? "";
    // Caja de la Actividad (Cajas abiertas): el "Abrir detalle" de la venta vinculada la necesita para abrir el detalle en ese modal.
    int idCierreActividad = ViewBag.IdCierreActividad != null ? (int)ViewBag.IdCierreActividad : 0;
    var tiposEgresoCajaLookup = ViewBag.TiposEgresoCaja as DataTable;
    // Hay al menos una fila con venta vinculada: recien ahi se incluyen los estilos/scripts del panel de venta (abajo de todo).
    bool hayVentasVinculadas = modoActividades && Model != null && Model.Rows.Cast<DataRow>().Any(r => IdVentaVinculada(r) > 0);
    // En Mis actividades / Actividades (modoActividades) la columna Detalle se oculta: la fila avisa con una etiqueta
    // "Con detalle" y el texto se ve al desplegar la fila (2026-10-06, ver docs/DECISIONS.md). En el listado completo se mantiene.
    // + la columna Creado (antes de Acciones).
    // La columna Sucursal se oculta si todas las filas son de la sucursal que ya dice el encabezado del modal (2026-10-28, ver docs/DECISIONS.md).
    // En Cajas abiertas / Actividades con filas de otra sucursal sigue apareciendo.
    bool ocultarSucursal = modoActividades
        && !string.IsNullOrWhiteSpace(sucursalActividad)
        && Model != null
        && Model.Rows.Cast<DataRow>().All(r =>
        {
            string sucursalDeFila = ValorFlexible(r, "Sucursal", "sucursal");
            return string.IsNullOrWhiteSpace(sucursalDeFila)
                || string.Equals(sucursalDeFila.Trim(), sucursalActividad.Trim(), StringComparison.OrdinalIgnoreCase);
        });
    int columnasTabla = (modoActividades ? 7 : 8) - (ocultarSucursal ? 1 : 0);

    if (Model != null && Model.Columns.Contains("Monto"))
    {
        foreach (DataRow row in Model.Rows)
        {
            decimal monto;
            string valor = Convert.ToString(row["Monto"]) ?? "";
            if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.CurrentCulture, out monto) ||
                decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out monto))
            {
                total += monto;
            }

            string descripcion = Descripcion(row);
            if (descripcion.StartsWith("ANULACION:", StringComparison.OrdinalIgnoreCase) || descripcion.StartsWith("ELIMINADO:", StringComparison.OrdinalIgnoreCase))
            {
                string descripcionOriginal = descripcion.Substring(descripcion.IndexOf(':') + 1).Trim();
                if (!string.IsNullOrWhiteSpace(descripcionOriginal))
                {
                    descripcionesAnuladas.Add(descripcionOriginal);
                    if (descripcion.StartsWith("ELIMINADO:", StringComparison.OrdinalIgnoreCase))
                        descripcionesEliminadas.Add(descripcionOriginal);
                }
            }
        }
    }
}

@* Pago Electronico con rango demasiado largo: el controller no consulta y avisa aca (vale para la carga completa y para el ajax). *@
@if (ViewBag.AvisoRangoEgresos is string avisoRangoEgresos && !string.IsNullOrEmpty(avisoRangoEgresos))
{
    <div class="alert alert-warning py-2 px-3 mb-2" role="alert">@avisoRangoEgresos</div>
}

@if (!modoActividades)
{
    <div class="egresos-resumen">
        <div>
            <span class="text-muted">Items</span>
            <strong>@items</strong>
        </div>
        <div>
            <span class="text-muted">Total</span>
            <strong>$ @total.ToString("N2")</strong>
        </div>
    </div>
}

@* Listado completo (/Cajas/EgresosCaja, 2026-11-16, ver docs/DECISIONS.md "Egresos de Caja en pantalla angosta"): en celular y en
   ventana de escritorio angosta (<768 px) la tabla se ve como tarjetas con el mismo estilo que Movimientos (wwwroot/Content/css/tabla-cards.css),
   en vez de las tarjetas propias de abajo. Mis actividades / Actividades (modoActividades) conservan sus tarjetas de siempre. *@
<div class="table-responsive egresos-tabla-desktop @(modoActividades ? "egresos-actividades-tabla" : "egresos-tabla-cards")">
    <table class="table table-sm @(modoActividades ? "" : "table-bordered tabla-cards") table-hover mb-0">
        <thead class="thead-light">
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Descripcion</th>
                <th class="text-right">Monto</th>
                @if (!modoActividades)
                {
                    <th>Detalle</th>
                }
                @if (!ocultarSucursal)
                {
                    <th>Sucursal</th>
                }
                <th class="text-nowrap">Creado</th>
                <th class="text-nowrap">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="@columnasTabla" class="text-center text-muted py-4">No se encontraron egresos.</td>
                </tr>
            }
            else
            {
                int index = 0;
                foreach (DataRow row in Model.Rows)
                {
                    index++;
                    string id = Id(row);
                    string detalleId = "egreso_det_" + (!string.IsNullOrWhiteSpace(id) ? id : index.ToString());
                    bool esAnulacion = EsAnulacion(row);
                    bool esHistorico = !esAnulacion && FueReemplazadoPorAnulacion(row, descripcionesAnuladas);
                    bool esEgresoModificado = !esHistorico && EsEgresoCajaModificado(row);
                    int idInt;
                    bool puedeModificarEgreso = int.TryParse(id, out idInt) && idsModificables.Contains(idInt);
                    int idCompraRelacionado = int.TryParse(id, out idInt) && comprasModificables.ContainsKey(idInt) ? comprasModificables[idInt] : 0;
                    // Una compra ya eliminada (su egreso quedo marcado como anulado) y el egreso ELIMINADO no se pueden modificar.
                    bool puedeModificarCompra = idCompraRelacionado > 0 && !esAnulacion && !esHistorico;
                    bool mostrarBotonModificar = (puedeModificarEgreso || puedeModificarCompra) && !string.IsNullOrWhiteSpace(id);
                    string sucursalFila = ValorFlexible(row, "Sucursal", "sucursal");
                    if (string.IsNullOrWhiteSpace(sucursalFila))
                    {
                        sucursalFila = sucursalActividad;
                    }
                    string urlModificar = puedeModificarCompra
                        ? Url.Action("ModificarCompra", "Compras", new { id = idCompraRelacionado, origen = desdePos ? "pos" : "layout" })
                        : "";
                    string tipoModificacion = puedeModificarCompra ? "compra" : "egreso";
                    string detalleTexto = Valor(row, "Detalle");
                    // El conteo de billetes tambien se ve al desplegar la fila: cuenta como "tiene detalle" para la etiqueta.
                    int idVentaVinculada = modoActividades ? IdVentaVinculada(row) : 0;
                    // La venta vinculada tambien se ve al desplegar la fila: cuenta como "tiene detalle" para la etiqueta.
                    bool tieneDetalle = !string.IsNullOrWhiteSpace(detalleTexto) || !string.IsNullOrWhiteSpace(Valor(row, "ConteoBilletes")) || idVentaVinculada > 0;

                    <tr class="egreso-row @((esAnulacion || esHistorico) ? "egreso-row-anulado" : "")" data-id="@id" data-esgasto="@(EsGasto(row, tiposEgresoCajaLookup) ? "1" : "0")">
                        @if (modoActividades)
                        {
                            <td class="text-nowrap">
                                <div>@FechaParte(row, "Fecha", "dd/MM/yyyy")</div>
                                <div class="egreso-fecha-hora">@FechaParte(row, "Fecha", "HH:mm")</div>
                            </td>
                            <td>
                                <span class="egreso-tipo-pill @ClasePillTipo(row)" title="@Categoria(row)">@Valor(row, "TipoEgresoCaja")</span>
                            </td>
                        }
                        else
                        {
                            @* En tarjeta: la fecha encabeza la tarjeta y el numero de egreso queda tenue a la derecha. *@
                            <td class="text-nowrap cc-titulo cc-titulo-flex">@Fecha(row, "Fecha")<span class="cc-solo-card cc-titulo-extra" title="Número de egreso">#@id</span></td>
                            <td class="cc-destacado egr-c-tipo" data-label="Tipo">@Valor(row, "TipoEgresoCaja")</td>
                        }
                        <td class="cc-ancho egr-c-desc" data-label="Descripción">
                            @if (idVentaVinculada > 0)
                            {
                                @* Con venta vinculada: solo el nombre de la venta (+ el cliente si es a cuenta corriente); el resto va en el desplegable. *@
                                <span class="egreso-desc-corta">@DescripcionCorta(row)</span>
                                @if (EsCtaCte(row) && ClienteNombreCorto(row).Length > 0)
                                {
                                    <span class="egreso-cliente">· @ClienteNombreCorto(row)</span>
                                }
                            }
                            else
                            {
                                @Descripcion(row)
                            }
                            @if (esHistorico)
                            {
                                <div class="small text-muted mt-1">@(descripcionesEliminadas.Contains(Descripcion(row)) ? "Compra eliminada: ver el egreso ELIMINADO." : "Registro anterior reemplazado por una modificacion.")</div>
                            }
                            else if (esEgresoModificado)
                            {
                                <div class="small text-muted mt-1">Registro modificado. Verificar cambios.</div>
                            }
                            @if (modoActividades && tieneDetalle)
                            {
                                @* Boton "Ver detalle" (2026-11-14): pildora con un circulo que gira al abrir y cambia a "Ocultar detalle".
                                   El estado abierto lo marca el CSS con :has(.collapse.show) (el aria-expanded no se actualiza con bootstrap4-compat). *@
                                <div class="mt-1"><button type="button" class="egreso-ver-detalle" data-toggle="collapse" data-target="#@detalleId" aria-expanded="false" aria-controls="@detalleId" title="Desplegá la fila para ver el detalle"><span class="egreso-ver-detalle-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg></span><span class="evd-abrir">Ver detalle</span><span class="evd-cerrar">Ocultar detalle</span></button></div>
                            }
                        </td>
                        <td class="text-right text-nowrap egreso-monto cc-destacado egr-c-monto" data-label="Monto">$ @Monto(row)</td>
                        @if (!modoActividades)
                        {
                        <td class="cc-ancho egr-c-detalle @(string.IsNullOrWhiteSpace(detalleTexto) ? "cc-vacio" : "")" data-label="Detalle">
                            @* Resumen de la primera linea del detalle (el texto completo va en el tooltip y en el desplegable). *@
                            @{
                                var detalleResumen = detalleTexto.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
                            }
                            @if (!string.IsNullOrWhiteSpace(detalleTexto))
                            {
                                <span class="d-inline-block text-truncate align-middle" style="max-width:220px;" title="@detalleTexto">@detalleResumen</span>
                            }
                        </td>
                        }
                        @if (!ocultarSucursal)
                        {
                            <td class="egr-c-sucursal" data-label="Sucursal">@sucursalFila</td>
                        }
                        <td class="text-nowrap egr-c-creado" data-label="Creado">
                            @* "Modificado" solo si el egreso se modifico de verdad (esEgresoModificado excluye los tipos
                               que se actualizan solos y los registros reemplazados por una anulacion). *@
                            @await Html.PartialAsync("~/Views/Shared/_CeldaCreadoModificado.cshtml", new WebCore.Models.CeldaCreadoModificadoVm
                            {
                                Creado = FechaHora(row, "Creado"),
                                CreadoPor = Valor(row, "Creado Por"),
                                Actualizado = FechaHora(row, "Actualizado"),
                                ActualizadoPor = Valor(row, "Actualizado Por"),
                                MostrarModificado = esEgresoModificado
                            })
                        </td>
                        <td class="text-nowrap egreso-acciones cc-acciones">
                            <button type="button"
                                    class="btn btn-sm btn-link text-decoration-none btn-detalle-egreso"
                                    data-toggle="collapse"
                                    data-target="#@detalleId"
                                    aria-expanded="false"
                                    aria-controls="@detalleId"
                                    title="Detalles"
                                    aria-label="Detalles">
                                <i class="fas fa-chevron-down"></i><span class="cc-solo-card"> Detalle</span>
                            </button>
                            @* Imprimir: abre el mismo modal que al guardar el egreso (cerrar / ticket 58-80 / PDF / mail). *@
                            @if (!string.IsNullOrWhiteSpace(id))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary btn-imprimir-egreso"
                                        data-id="@id"
                                        data-ticket-url="@Url.Action("ImprimirTicketEgreso", "Cajas", new { id })"
                                        data-ticket-payload-url="@Url.Action("ImprimirTicketEgresoPayload", "Cajas", new { id })"
                                        data-pdf-url="@Url.Action("ImprimirPdfEgreso", "Cajas", new { id })"
                                        data-email-datos-url="@Url.Action("ObtenerDatosEmailEgreso", "Cajas", new { id })"
                                        data-email-enviar-url="@Url.Action("EnviarEgresoEmail", "Cajas")"
                                        title="Imprimir"
                                        aria-label="Imprimir">
                                    <i class="fas fa-print"></i><span class="cc-solo-card"> Imprimir</span>
                                </button>
                            }
                            @if (mostrarBotonModificar)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-primary btn-modificar-egreso"
                                        data-id="@id"
                                        data-id-compra="@(puedeModificarCompra ? idCompraRelacionado : 0)"
                                        data-url="@urlModificar"
                                        data-tipo-modificacion="@tipoModificacion"
                                        title="Modificar"
                                        aria-label="Modificar">
                                    <i class="fas fa-edit"></i><span class="cc-solo-card"> Modificar</span>
                                </button>
                            }
                        </td>
                    </tr>
                    <tr class="egreso-detalle-row cc-fila-detalle">
                        <td colspan="@columnasTabla" class="p-0">
                            @if (modoActividades)
                            {
                                @* Mis actividades / Actividades (2026-11-10, ver docs/DECISIONS.md "Detalle desplegado de Mis actividades"):
                                   panel compacto pegado a la fila. No repite lo que ya dice la fila (Creado por / Creado) ni el encargado
                                   (Sucursal, salvo que haya filas de otra sucursal) y no muestra campos vacios. Estilos en _MisEgresosCaja. *@
                                string conteoActividad = Valor(row, "ConteoBilletes");
                                string actualizadoActividad = Fecha(row, "Actualizado");
                                string actualizadoPorActividad = Valor(row, "Actualizado Por");
                                <div id="@detalleId" class="collapse egreso-detalle-collapse">
                                    <div class="egreso-detalle-panel">
                                        @* Con venta vinculada no se muestra el "Detalle" automatico (" | Kgs | Precio | TOT"): lo reemplaza el panel
                                           de la venta, que trae las lineas y el comentario (2026-11-14). *@
                                        @if (idVentaVinculada == 0)
                                        {
                                            <div class="egreso-detalle-panel-lbl">Detalle</div>
                                            @if (string.IsNullOrWhiteSpace(detalleTexto))
                                            {
                                                <div class="egreso-detalle-panel-vacio">Sin detalle cargado</div>
                                            }
                                            else
                                            {
                                                <div class="egreso-detalle-panel-txt">@detalleTexto</div>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(conteoActividad))
                                        {
                                            <div class="egreso-detalle-panel-conteo"><strong>Conteo de billetes</strong>@("\n" + conteoActividad)</div>
                                        }
                                        @if (idVentaVinculada > 0)
                                        {
                                            @* Se carga al desplegar la fila (script del final): Ventas/DetalleVentaResumen, el mismo panel de Mis ventas. *@
                                            <div class="egreso-venta-vinculada" data-id-venta="@idVentaVinculada" data-id-cierre="@idCierreActividad">
                                                @* Encabezado en un renglon: "Venta vinculada #N" y, en Cta Cte, el Cliente al lado (2026-11-16). *@
                                                <div class="egreso-venta-vinculada-encab">
                                                    <div class="egreso-venta-vinculada-cab">Venta vinculada #@idVentaVinculada</div>
                                                    @if (EsCtaCte(row))
                                                    {
                                                        ClienteBloque(row);
                                                    }
                                                </div>
                                                <div class="egreso-venta-vinculada-cuerpo venta-detalle-panel">
                                                    <div class="vr-cargando">Se carga al desplegar…</div>
                                                </div>
                                            </div>
                                        }
                                        <div class="egreso-detalle-panel-meta">
                                            @if (!ocultarSucursal && !string.IsNullOrWhiteSpace(sucursalFila))
                                            {
                                                <span><i class="fas fa-store mr-1"></i>@sucursalFila</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(actualizadoActividad))
                                            {
                                                <span><i class="fas fa-pen mr-1"></i>@(string.IsNullOrWhiteSpace(actualizadoPorActividad) ? "Modificado " : "Modificado por ")<b>@actualizadoPorActividad</b> · @actualizadoActividad</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(id))
                                            {
                                                <span class="egreso-detalle-panel-num">Egreso N° @id</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                            <div id="@detalleId" class="collapse egreso-detalle-collapse">
                                <div class="p-3 border-top egreso-detalle-wrap">
                                    <div class="egreso-detalle-meta-card">
                                        <div class="egreso-detalle-meta-row egreso-detalle-principal">
                                            <span class="text-muted d-block">Detalle</span>
                                            <span class="egreso-detalle-valor-principal">@(string.IsNullOrWhiteSpace(Valor(row, "Detalle")) ? "-" : Valor(row, "Detalle"))</span>
                                        </div>
                                        @* Conteo de billetes (solo lectura): campo propio, aparte del detalle. *@
                                        @if (!string.IsNullOrWhiteSpace(Valor(row, "ConteoBilletes")))
                                        {
                                            <div class="egreso-detalle-meta-row mt-2">
                                                <span class="text-muted d-block">Conteo de billetes</span>
                                                <span class="egreso-detalle-valor-principal" style="white-space:pre-line;font-size:calc(1rem - 2pt);">@Valor(row, "ConteoBilletes")</span>
                                            </div>
                                        }
                                        <div class="row mt-2">
                                            @* col-6: en tarjeta (<768 px) los datos van de a dos por renglon; desde md siguen de a cuatro. *@
                                            <div class="col-6 col-md-3 mb-2">
                                                <span class="text-muted d-block">Sucursal</span>
                                                <span class="font-weight-bold">@sucursalFila</span>
                                            </div>
                                            <div class="col-6 col-md-3 mb-2">
                                                <span class="text-muted d-block">Creado por</span>
                                                <span class="font-weight-bold">@Valor(row, "Creado Por")</span>
                                            </div>
                                            <div class="col-6 col-md-3 mb-2">
                                                <span class="text-muted d-block">Creado</span>
                                                <span class="font-weight-bold">@Fecha(row, "Creado")</span>
                                            </div>
                                            <div class="col-6 col-md-3 mb-2">
                                                <span class="text-muted d-block">Actualizado por</span>
                                                <span class="font-weight-bold">@Valor(row, "Actualizado Por")</span>
                                            </div>
                                            <div class="col-6 col-md-3 mb-2">
                                                <span class="text-muted d-block">Actualizado</span>
                                                <span class="font-weight-bold">@Fecha(row, "Actualizado")</span>
                                            </div>
                                            <div class="col-6 col-md-3 mb-2 mb-md-0">
                                                <span class="text-muted d-block">ID</span>
                                                <span class="font-weight-bold">@id</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* Tarjetas propias: solo Mis actividades / Actividades (modoActividades). El listado completo usa la tabla como tarjetas (arriba). *@
@if (modoActividades)
{
<div class="egresos-cards-mobile">
    @if (Model == null || Model.Rows.Count == 0)
    {
        <div class="text-center text-muted py-4">No se encontraron egresos.</div>
    }
    else
    {
        int index = 0;
        foreach (DataRow row in Model.Rows)
        {
            index++;
            string id = Id(row);
            string detalleId = "egreso_card_det_" + (!string.IsNullOrWhiteSpace(id) ? id : index.ToString());
            bool esAnulacion = EsAnulacion(row);
            bool esHistorico = !esAnulacion && FueReemplazadoPorAnulacion(row, descripcionesAnuladas);
            bool esEgresoModificado = !esHistorico && EsEgresoCajaModificado(row);
            int idInt;
            bool puedeModificarEgreso = int.TryParse(id, out idInt) && idsModificables.Contains(idInt);
            int idCompraRelacionado = int.TryParse(id, out idInt) && comprasModificables.ContainsKey(idInt) ? comprasModificables[idInt] : 0;
            bool puedeModificarCompra = idCompraRelacionado > 0 && !esAnulacion && !esHistorico;
            bool mostrarBotonModificar = (puedeModificarEgreso || puedeModificarCompra) && !string.IsNullOrWhiteSpace(id);
            string sucursalFila = ValorFlexible(row, "Sucursal", "sucursal");
            if (string.IsNullOrWhiteSpace(sucursalFila))
            {
                sucursalFila = sucursalActividad;
            }
            string urlModificar = puedeModificarCompra
                ? Url.Action("ModificarCompra", "Compras", new { id = idCompraRelacionado, origen = desdePos ? "pos" : "layout" })
                : "";
            string tipoModificacion = puedeModificarCompra ? "compra" : "egreso";

            <div class="egreso-card @((esAnulacion || esHistorico) ? "egreso-row-anulado" : "")" data-esgasto="@(EsGasto(row, tiposEgresoCajaLookup) ? "1" : "0")">
                <div class="egreso-card-top">
                    <strong>
                        @Valor(row, "TipoEgresoCaja")
                        @if (modoActividades)
                        {
                            <div class="small text-muted mt-1 d-none">@Categoria(row)</div>
                        }
                    </strong>
                    <span>$ @Monto(row)</span>
                </div>
                <div class="egreso-card-line">@Fecha(row, "Fecha")</div>
                <div class="egreso-card-line">
                    @if (modoActividades && IdVentaVinculada(row) > 0)
                    {
                        <span class="egreso-desc-corta">@DescripcionCorta(row)</span>
                        @if (EsCtaCte(row) && ClienteNombreCorto(row).Length > 0)
                        {
                            <span class="egreso-cliente">· @ClienteNombreCorto(row)</span>
                        }
                    }
                    else
                    {
                        @Descripcion(row)
                    }
                    @if (esHistorico)
                    {
                        <div class="small text-muted mt-1">@(descripcionesEliminadas.Contains(Descripcion(row)) ? "Compra eliminada: ver el egreso ELIMINADO." : "Registro anterior reemplazado por una modificacion.")</div>
                    }
                    else if (esEgresoModificado)
                    {
                        <div class="small text-muted mt-1">Registro modificado. Verificar cambios.</div>
                    }
                </div>
                <div class="d-flex flex-wrap mt-2">
                    <button type="button"
                            class="btn btn-sm btn-link text-decoration-none pl-0 btn-detalle-egreso"
                            data-toggle="collapse"
                            data-target="#@detalleId"
                            aria-expanded="false"
                            aria-controls="@detalleId"
                            title="Detalles"
                            aria-label="Detalles">
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(id))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary mr-1 btn-imprimir-egreso"
                                data-id="@id"
                                data-ticket-url="@Url.Action("ImprimirTicketEgreso", "Cajas", new { id })"
                                data-ticket-payload-url="@Url.Action("ImprimirTicketEgresoPayload", "Cajas", new { id })"
                                data-pdf-url="@Url.Action("ImprimirPdfEgreso", "Cajas", new { id })"
                                data-email-datos-url="@Url.Action("ObtenerDatosEmailEgreso", "Cajas", new { id })"
                                data-email-enviar-url="@Url.Action("EnviarEgresoEmail", "Cajas")"
                                title="Imprimir"
                                aria-label="Imprimir">
                            <i class="fas fa-print"></i>
                        </button>
                    }
                    @if (mostrarBotonModificar)
                    {
                        <button type="button"
                                class="btn btn-sm btn-primary btn-modificar-egreso"
                                data-id="@id"
                                data-id-compra="@(puedeModificarCompra ? idCompraRelacionado : 0)"
                                data-url="@urlModificar"
                                data-tipo-modificacion="@tipoModificacion"
                                title="Modificar"
                                aria-label="Modificar">
                            <i class="fas fa-edit"></i>
                        </button>
                    }
                </div>
                <div id="@detalleId" class="collapse egreso-detalle-collapse">
                    @* Con venta vinculada el "Detalle" automatico se omite en Mis actividades: lo reemplaza el panel de la venta (abajo). *@
                    @if (!string.IsNullOrWhiteSpace(Valor(row, "Detalle")) && !(modoActividades && IdVentaVinculada(row) > 0))
                    {
                        <div class="egreso-card-detail">@Valor(row, "Detalle")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Valor(row, "ConteoBilletes")))
                    {
                        <div class="egreso-card-detail" style="white-space:pre-line;font-size:calc(1em - 2pt);"><strong>Conteo de billetes</strong>@("\n" + Valor(row, "ConteoBilletes"))</div>
                    }
                    <div class="egreso-card-line">Sucursal: @sucursalFila</div>
                    <div class="egreso-card-line">Creado: @Fecha(row, "Creado")</div>
                    <div class="egreso-card-line">Creado por: @Valor(row, "Creado Por")</div>
                    @* En Mis actividades / Actividades no se muestran los campos vacios (2026-11-10); el listado completo queda igual. *@
                    @if (!modoActividades || !string.IsNullOrWhiteSpace(Valor(row, "Actualizado")))
                    {
                        <div class="egreso-card-line">Actualizado: @Fecha(row, "Actualizado")</div>
                    }
                    @if (!modoActividades || !string.IsNullOrWhiteSpace(Valor(row, "Actualizado Por")))
                    {
                        <div class="egreso-card-line">Actualizado por: @Valor(row, "Actualizado Por")</div>
                    }
                    @if (modoActividades && IdVentaVinculada(row) > 0)
                    {
                        int idVentaVinculadaCard = IdVentaVinculada(row);
                        <div class="egreso-venta-vinculada" data-id-venta="@idVentaVinculadaCard" data-id-cierre="@idCierreActividad">
                            <div class="egreso-venta-vinculada-encab">
                                <div class="egreso-venta-vinculada-cab">Venta vinculada #@idVentaVinculadaCard</div>
                                @if (EsCtaCte(row))
                                {
                                    ClienteBloque(row);
                                }
                            </div>
                            <div class="egreso-venta-vinculada-cuerpo venta-detalle-panel">
                                <div class="vr-cargando">Se carga al desplegar…</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
}

@if (hayVentasVinculadas)
{
    @* Venta vinculada de Pago Electronico / Cta Cte (2026-11-14, docs/DECISIONS.md "Forma de pago y venta vinculada"): el panel de la
       venta (Ventas/DetalleVentaResumen, el mismo de Mis ventas) se carga por AJAX la primera vez que se despliega la fila. Los
       estilos del panel (.vr-*, .vl-*, .fp-*) y los clics de "Modificar venta" / "Cambiar forma de pago" los pone _VentasExpandible. *@
    <partial name="~/Views/Ventas/_VentasExpandible.cshtml" />

    <script>
        (function () {
            // Idempotente: este parcial se vuelve a inyectar al abrir el modal y al filtrar por tipo.
            if (window.__egresoVentaVinculadaInit) return;
            window.__egresoVentaVinculadaInit = true;

            var URL_RESUMEN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("DetalleVentaResumen", "Ventas")));
            var URL_DETALLE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("DetalleVenta", "Ventas")));
            var MENSAJE_GENERICO = 'No se pudo cargar la venta. Probá de nuevo.';

            // En el POS (F6) el panel se pide con el operador de esta pestaña, igual que Mis ventas; fuera del POS (Cajas abiertas) no.
            function enPos() {
                return !!(window.POSVentas && typeof window.POSVentas.abrirDetalle === 'function');
            }

            // Mensaje a mostrar: el del servidor si viene corto (texto o JSON {msg}); si no, uno generico.
            function mensajeDeRespuesta(texto) {
                try {
                    var json = JSON.parse(texto);
                    if (json && typeof json.msg === 'string' && json.msg) return json.msg;
                } catch (errorJson) {
                    // No era JSON: se prueba como texto plano.
                }
                return texto && texto.length > 0 && texto.length <= 200 && texto.indexOf('<') < 0 ? texto : MENSAJE_GENERICO;
            }

            function cargar(caja) {
                var cuerpo = caja.querySelector('.egreso-venta-vinculada-cuerpo');
                if (!cuerpo || caja.dataset.cargado === 'true' || caja.dataset.cargando === 'true') return;

                var url = URL_RESUMEN + '?id=' + encodeURIComponent(caja.dataset.idVenta)
                    + '&modal=true&desdePos=' + (enPos() ? 'true' : 'false')
                    + '&posInstanceId=' + encodeURIComponent((window.POSModo && window.POSModo.instanceId) || '');

                caja.dataset.cargando = 'true';
                cuerpo.innerHTML = '<div class="vr-cargando">Cargando venta…</div>';

                fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (respuesta) {
                        // Sesion vencida: el servidor redirige al login y el fetch lo sigue solo (devolveria la pagina de login).
                        if (respuesta.redirected) throw new Error('Tu sesión venció. Recargá la página.');
                        if (!respuesta.ok) {
                            return respuesta.text().then(function (texto) { throw new Error(mensajeDeRespuesta(texto)); });
                        }
                        return respuesta.text();
                    })
                    .then(function (html) {
                        cuerpo.innerHTML = html;
                        caja.dataset.cargado = 'true';
                    })
                    .catch(function (error) {
                        console.error('egreso-venta-vinculada: no se pudo cargar la venta ' + caja.dataset.idVenta, error);
                        var aviso = document.createElement('div');
                        aviso.className = 'vr-error';
                        aviso.textContent = error && error.message ? error.message : MENSAJE_GENERICO;
                        cuerpo.innerHTML = '';
                        cuerpo.appendChild(aviso);
                    })
                    .then(function () {
                        delete caja.dataset.cargando;
                    });
            }

            // Bootstrap 5 dispara show.bs.collapse nativo (burbujea hasta document) al desplegar la fila de Mis actividades.
            document.addEventListener('show.bs.collapse', function (evento) {
                var destino = evento.target;
                if (!(destino instanceof Element)) return;
                destino.querySelectorAll('.egreso-venta-vinculada').forEach(cargar);
            });

            // "Abrir detalle" de la venta vinculada: en el POS y en Cajas abiertas se abre dentro del mismo modal (como Mis ventas);
            // en otro contexto, navega al detalle completo.
            document.addEventListener('click', function (evento) {
                var destino = evento.target;
                if (!(destino instanceof Element)) return;
                var boton = destino.closest('.egreso-venta-vinculada .venta-abrir-detalle');
                if (!boton) return;

                evento.preventDefault();
                var idVenta = parseInt(boton.dataset.ventaId, 10) || 0;
                if (idVenta <= 0) return;

                var caja = boton.closest('.egreso-venta-vinculada');
                var idCierre = parseInt(caja && caja.dataset.idCierre, 10) || 0;
                if (enPos()) {
                    window.POSVentas.abrirDetalle(idVenta);
                } else if (idCierre > 0 && window.CajasAbiertas && typeof window.CajasAbiertas.abrirDetalleVenta === 'function') {
                    window.CajasAbiertas.abrirDetalleVenta(idVenta, idCierre);
                } else {
                    window.location.href = URL_DETALLE + '?id=' + encodeURIComponent(idVenta);
                }
            });
        })();
    </script>
}
