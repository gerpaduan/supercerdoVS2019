    :is(body, body.app-shell) .egreso-form-wrap .form-group { margin-bottom: .5rem; }

    /* Grilla de comisiones electronicas */
    :is(body, body.app-shell) .egreso-form-wrap .card-body { padding: .82rem 1rem; }
    :is(body, body.app-shell) .egreso-form-wrap .table { font-size: .84rem; }
