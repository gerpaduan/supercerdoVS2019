@model WebCore.Models.UtilitiesIndexVm

@{
    ViewBag.Title = "CarniSys | Utilidades";
}

<div class="container-fluid utilidades-page">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Utilidades</h1>
            <p class="mb-0 text-muted">Descarga e instalación de agentes locales y futuras herramientas auxiliares.</p>
        </div>
    </div>

    @* Acceso rapido al contador de billetes (2026-11-10, ver docs/DECISIONS.md): Utilidades es visible para todo
       usuario, asi que cualquiera cuenta efectivo sin entrar al POS ni a Cajas. El modal (#modalCalculadoraBilletes)
       y sus scripts ya vienen del _Layout; este boton lo dispara el delegado de calculadora-billetes-targets.js
       (clase js-calculadora-billetes-launch) y tambien responde a Alt+B. Sin data-cb-input a proposito: es el modo
       "suelto" (igual que F3 en el POS), no vuelca el total en ningun campo y Aceptar ofrece ticket/PDF/WhatsApp. *@
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-left-primary">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                    <div class="mr-3 mb-2 mb-md-0">
                        <div class="text-xs font-weight-bold text-uppercase text-muted mb-1">Herramienta</div>
                        <h5 class="mb-1">Contador de billetes</h5>
                        <p class="text-muted mb-0">Contá el efectivo por denominación y obtené el total. Al aceptar podés imprimir el detalle. Atajo: <kbd>Alt</kbd> + <kbd>B</kbd>.</p>
                    </div>
                    <button type="button"
                            id="btnUtilidadesContadorBilletes"
                            class="btn btn-primary js-calculadora-billetes-launch"
                            data-cb-context="utilidades"
                            title="Contador de billetes (Alt+B)">
                        <i class="fas fa-money-bill-wave mr-1"></i> Abrir contador
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Instaladores de mini-apps (2026-11-13 y 2026-11-17, ver docs/DECISIONS.md): Stock, Movimientos, Elaborados, Punto de venta y Punto de expendio se
       instalan como aplicacion propia (ventana + icono + nombre propios, sin menu lateral). El navegador solo ofrece instalar desde una pagina que enlaza
       el manifest de esa app, asi que cada boton abre en una ventana chica la pagina anfitriona {Carpeta}/InstalarApp (InstalarAppController), que enlaza
       ese manifest y muestra el boton "Instalar" (pwa-instalar.js). Los manifests y el scope viven en wwwroot/manifest-*.json.
       Si se agrega otra mini-app: manifest propio + entrada en _PwaHead + entrada en InstalarAppController + una fila aca. *@
    @{
        var miniApps = new[]
        {
            new { Nombre = "Stock", Descripcion = "Carga y modificación de stock en su propia ventana.", Icono = "fa-boxes", Carpeta = "Stock" },
            new { Nombre = "Movimientos", Descripcion = "Movimientos de stock entre sucursales en su propia ventana.", Icono = "fa-truck-loading", Carpeta = "Movimientos" },
            new { Nombre = "Elaborados", Descripcion = "Carga y fórmulas de elaborados (embutidos) en su propia ventana.", Icono = "fa-industry", Carpeta = "Elaborados" },
            new { Nombre = "Punto de venta", Descripcion = "Ventas de mostrador (POS) en su propia ventana.", Icono = "fa-cash-register", Carpeta = "Ventas" },
            new { Nombre = "Punto de expendio", Descripcion = "Expendio de mercadería en su propia ventana.", Icono = "fa-store", Carpeta = "PuntosExpendio" },
            new { Nombre = "Existencia por sucursal", Descripcion = "Stock y estado de cada producto por sucursal, en su propia ventana.", Icono = "fa-warehouse", Carpeta = "Existencia" }
        };
    }
    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Aplicaciones instalables</h6>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">Instalá estas pantallas como aplicaciones independientes: cada una abre en su propia ventana, con su nombre y su ícono, sin menú lateral y solo con esa pantalla. Al tocar «Instalar» se abre una ventana chica con el botón «Instalar»; al confirmar en el navegador la app queda instalada y esa ventana se cierra sola. Para tener el ícono en la barra de tareas: clic derecho sobre el ícono de la app → «Anclar a la barra de tareas» (el navegador no permite hacerlo solo). Solo funciona desde <strong>https://carnisys.com</strong> con Chrome o Edge.</p>
            @* Instalacion en lote (2026-11-17): marcar las apps y «Instalar seleccionadas», o «Instalar todas». utilidades-instalar-apps.js abre UNA ventana chica
               que va instalando una tras otra (cola ?cola=... de InstalarApp/Index): el navegador pide un clic en «Instalar» por cada app, no se puede evitar. *@
            <div class="d-flex flex-wrap align-items-center mb-3" id="barraInstalarLote">
                <div class="form-check mr-3 mb-2">
                    <input class="form-check-input" type="checkbox" id="chkInstalarTodas">
                    <label class="form-check-label" for="chkInstalarTodas">Seleccionar todas</label>
                </div>
                <button type="button" class="btn btn-primary btn-sm mr-2 mb-2" id="btnInstalarSeleccionadas" disabled>
                    <i class="fas fa-download mr-1"></i> Instalar seleccionadas <span class="badge badge-light ml-1" id="cntInstalarSeleccionadas">0</span>
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm mr-3 mb-2" id="btnInstalarTodas">
                    <i class="fas fa-download mr-1"></i> Instalar todas
                </button>
                <span class="small text-muted mb-2">Se instalan una detrás de otra en una ventana chica; hay que tocar «Instalar» y confirmar en cada una.</span>
            </div>
            <div class="row">
                @foreach (var app in miniApps)
                {
                    <div class="col-12 col-md-6 col-xl-4 mb-3">
                        <div class="border rounded p-3 h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="mb-1"><i class="fas @app.Icono mr-1 text-primary"></i> @app.Nombre</h5>
                                <input class="form-check-input js-instalar-marca position-static ml-2 mt-1" type="checkbox" data-app="@app.Carpeta"
                                       id="chkInstalar@(app.Carpeta)" title="Marcar para instalar con «Instalar seleccionadas»" aria-label="Seleccionar @app.Nombre">
                            </div>
                            <p class="text-muted mb-3">@app.Descripcion</p>
                            <div class="mt-auto">
                                @* El href es la pagina anfitriona; utilidades-instalar-apps.js la abre en una ventana chica (si el popup se bloquea, rige el enlace). *@
                                <a class="btn btn-primary btn-sm js-instalar-app"
                                   href="@Url.Content("~/" + app.Carpeta + "/InstalarApp")" data-app="@app.Carpeta"
                                   target="_blank"
                                   id="btnUtilidadesInstalar@(app.Carpeta)">
                                    <i class="fas fa-download mr-1"></i> Instalar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model.Agentes)
        {
            <div class="col-12 col-lg-6 mb-4">
                <div class="card shadow-sm h-100 border-left-@(item.Disponible ? "success" : "secondary")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="text-xs font-weight-bold text-uppercase text-muted mb-1">@item.Categoria</div>
                                <h5 class="mb-1">@item.Nombre</h5>
                            </div>
                            <span class="badge badge-@(item.Disponible ? "success" : "secondary")">@item.Estado</span>
                        </div>

                        <p class="text-muted mb-3">@item.Descripcion</p>

                        <div class="small text-muted mb-1">Archivo: <strong>@item.ArchivoNombre</strong></div>
                        <div class="small text-muted mb-1">Tamaño: <strong>@item.ArchivoTamano</strong></div>
                        <div class="small text-muted mb-3">Última actualización: <strong>@item.Version</strong></div>

                        <div class="alert alert-light border small mb-3">
                            @item.NotaInstalacion
                        </div>

                        <div class="mt-auto">
                            @if (item.Disponible)
                            {
                                <a class="btn btn-primary btn-sm" href="@item.ArchivoUrl" download>
                                    <i class="fas fa-download mr-1"></i> Descargar
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled>
                                    <i class="fas fa-clock mr-1"></i> Próximamente
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Más herramientas</h6>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var item in Model.OtrasUtilidades)
                {
                    <div class="col-12 col-md-6 mb-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>@item.Nombre</strong>
                                <span class="badge badge-secondary">@item.Estado</span>
                            </div>
                            <div class="text-muted small mb-2">@item.Descripcion</div>
                            <div class="small text-muted">@item.NotaInstalacion</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/app/utilidades-instalar-apps.js" asp-append-version="true"></script>
}

<style>
    .utilidades-page {
        font-size: .9rem;
    }

    .utilidades-page .card-body {
        padding: .82rem 1rem;
    }

    .utilidades-page .btn {
        font-size: .87rem;
        padding: .32rem .58rem;
        border-radius: .55rem;
    }

    .utilidades-page .badge,
    .utilidades-page .small,
    .utilidades-page .text-muted,
    .utilidades-page .text-xs {
        font-size: .8rem !important;
    }
</style>
