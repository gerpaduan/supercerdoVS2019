@model WebCore.Models.UtilitiesIndexVm

@{
    ViewBag.Title = "CarniSys | Utilidades";
}

<div class="container-fluid utilidades-page">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Utilidades</h1>
            <p class="mb-0 text-muted">Descarga e instalación de agentes locales y futuras herramientas auxiliares.</p>
        </div>
    </div>

    @* Acceso rapido al contador de billetes (2026-11-10, ver docs/DECISIONS.md): Utilidades es visible para todo
       usuario, asi que cualquiera cuenta efectivo sin entrar al POS ni a Cajas. El modal (#modalCalculadoraBilletes)
       y sus scripts ya vienen del _Layout; este boton lo dispara el delegado de calculadora-billetes-targets.js
       (clase js-calculadora-billetes-launch) y tambien responde a Alt+B. Sin data-cb-input a proposito: es el modo
       "suelto" (igual que F3 en el POS), no vuelca el total en ningun campo y Aceptar ofrece ticket/PDF/WhatsApp. *@
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-left-primary">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                    <div class="mr-3 mb-2 mb-md-0">
                        <div class="text-xs font-weight-bold text-uppercase text-muted mb-1">Herramienta</div>
                        <h5 class="mb-1">Contador de billetes</h5>
                        <p class="text-muted mb-0">Contá el efectivo por denominación y obtené el total. Al aceptar podés imprimir el detalle. Atajo: <kbd>Alt</kbd> + <kbd>B</kbd>.</p>
                    </div>
                    <button type="button"
                            id="btnUtilidadesContadorBilletes"
                            class="btn btn-primary js-calculadora-billetes-launch"
                            data-cb-context="utilidades"
                            title="Contador de billetes (Alt+B)">
                        <i class="fas fa-money-bill-wave mr-1"></i> Abrir contador
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Instaladores de mini-apps (2026-11-13, ver docs/DECISIONS.md): Stock, Movimientos y Elaborados se instalan como aplicacion propia (ventana + icono
       en la barra de tareas). El navegador solo ofrece instalar desde una pagina que enlaza el manifest de esa app, asi que cada boton abre la pantalla
       con ?instalar=1 en una pestana nueva y alli pwa-instalar.js (cargado por _PwaHead) muestra la barra con "Instalar". Los manifests y el scope viven
       en wwwroot/manifest-*.json. Si se agrega otra mini-app: manifest propio + entrada en _PwaHead + una fila aca. *@
    @{
        var miniApps = new[]
        {
            new { Nombre = "Stock", Descripcion = "Carga y modificación de stock en su propia ventana.", Icono = "fa-boxes", Controlador = "Stock" },
            new { Nombre = "Movimientos", Descripcion = "Movimientos de stock entre sucursales en su propia ventana.", Icono = "fa-truck-loading", Controlador = "Movimientos" },
            new { Nombre = "Elaborados", Descripcion = "Carga y fórmulas de elaborados (embutidos) en su propia ventana.", Icono = "fa-industry", Controlador = "Elaborados" }
        };
    }
    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Aplicaciones instalables</h6>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">Instalá estas pantallas como aplicaciones: cada una abre en su propia ventana y tiene su ícono en la barra de tareas. Al tocar «Instalar» se abre la pantalla y arriba aparece el botón que confirma la instalación. Solo funciona desde <strong>https://carnisys.com</strong> con Chrome o Edge.</p>
            <div class="row">
                @foreach (var app in miniApps)
                {
                    <div class="col-12 col-md-4 mb-3 mb-md-0">
                        <div class="border rounded p-3 h-100 d-flex flex-column">
                            <h5 class="mb-1"><i class="fas @app.Icono mr-1 text-primary"></i> @app.Nombre</h5>
                            <p class="text-muted mb-3">@app.Descripcion</p>
                            <div class="mt-auto">
                                <a class="btn btn-primary btn-sm"
                                   href="@Url.Action("Index", app.Controlador, new { instalar = 1 })"
                                   target="_blank" rel="noopener"
                                   id="btnUtilidadesInstalar@(app.Nombre)">
                                    <i class="fas fa-download mr-1"></i> Instalar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model.Agentes)
        {
            <div class="col-12 col-lg-6 mb-4">
                <div class="card shadow-sm h-100 border-left-@(item.Disponible ? "success" : "secondary")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="text-xs font-weight-bold text-uppercase text-muted mb-1">@item.Categoria</div>
                                <h5 class="mb-1">@item.Nombre</h5>
                            </div>
                            <span class="badge badge-@(item.Disponible ? "success" : "secondary")">@item.Estado</span>
                        </div>

                        <p class="text-muted mb-3">@item.Descripcion</p>

                        <div class="small text-muted mb-1">Archivo: <strong>@item.ArchivoNombre</strong></div>
                        <div class="small text-muted mb-1">Tamaño: <strong>@item.ArchivoTamano</strong></div>
                        <div class="small text-muted mb-3">Última actualización: <strong>@item.Version</strong></div>

                        <div class="alert alert-light border small mb-3">
                            @item.NotaInstalacion
                        </div>

                        <div class="mt-auto">
                            @if (item.Disponible)
                            {
                                <a class="btn btn-primary btn-sm" href="@item.ArchivoUrl" download>
                                    <i class="fas fa-download mr-1"></i> Descargar
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled>
                                    <i class="fas fa-clock mr-1"></i> Próximamente
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Más herramientas</h6>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var item in Model.OtrasUtilidades)
                {
                    <div class="col-12 col-md-6 mb-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>@item.Nombre</strong>
                                <span class="badge badge-secondary">@item.Estado</span>
                            </div>
                            <div class="text-muted small mb-2">@item.Descripcion</div>
                            <div class="small text-muted">@item.NotaInstalacion</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .utilidades-page {
        font-size: .9rem;
    }

    .utilidades-page .card-body {
        padding: .82rem 1rem;
    }

    .utilidades-page .btn {
        font-size: .87rem;
        padding: .32rem .58rem;
        border-radius: .55rem;
    }

    .utilidades-page .badge,
    .utilidades-page .small,
    .utilidades-page .text-muted,
    .utilidades-page .text-xs {
        font-size: .8rem !important;
    }
</style>
