@model System.Data.DataTable
@*
    Listado de todos los pagos y cobros (Finanzas > Pagos), 2026-09-24. Al elegir una fila abre
    Finanzas/AddOrEditPago del pago (solo lectura hasta "Modificar": ahi se puede cambiar la persona o
    eliminarlo). Los pagos eliminados NO se borran: siguen en el listado con la etiqueta ELIMINADO.
    Filtros por GET (texto, rango de fechas, tipo de operacion, ver eliminados), mismo criterio que
    CtaCtePersona.
*@
@{
    ViewBag.Title = "Pagos y cobros";

    string texto = ViewBag.Texto as string ?? "";
    string desde = ViewBag.Desde as string ?? "";
    string hasta = ViewBag.Hasta as string ?? "";
    string operacion = ViewBag.Operacion as string ?? "";
    bool verEliminados = ViewBag.VerEliminados != null && (bool)ViewBag.VerEliminados;

    // Al abrir un pago, "Volver" regresa a este mismo listado con los filtros que estaban aplicados.
    string urlActual = Context.Request.Path + Context.Request.QueryString;
}

<div class="container-fluid px-2 px-md-3" id="pagosListadoContainer">
    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <form method="get" action="@Url.Action("Pagos", "Finanzas")" class="form-row align-items-end" id="formFiltrosPagos">
                <div class="form-group col-md-3 mb-2">
                    <label for="filtroTexto" class="small mb-1">Persona o N° de recibo</label>
                    <input type="text" class="form-control" id="filtroTexto" name="texto" value="@texto" maxlength="100"
                           placeholder="Buscar..." autocomplete="off" />
                </div>
                <div class="form-group col-6 col-md-2 mb-2">
                    <label for="filtroDesde" class="small mb-1">Desde</label>
                    <input type="date" class="form-control" id="filtroDesde" name="desde" value="@desde" />
                </div>
                <div class="form-group col-6 col-md-2 mb-2">
                    <label for="filtroHasta" class="small mb-1">Hasta</label>
                    <input type="date" class="form-control" id="filtroHasta" name="hasta" value="@hasta" />
                </div>
                <div class="form-group col-6 col-md-2 mb-2">
                    <label for="filtroOperacion" class="small mb-1">Operación</label>
                    <select class="form-control" id="filtroOperacion" name="operacion">
                        <option value="" selected="@(operacion == "" ? "selected" : null)">Pagos y cobros</option>
                        <option value="Cobro" selected="@(operacion == "Cobro" ? "selected" : null)">Solo cobros</option>
                        <option value="Pago" selected="@(operacion == "Pago" ? "selected" : null)">Solo pagos</option>
                    </select>
                </div>
                <div class="form-group col-6 col-md-2 mb-2">
                    <div class="custom-control custom-switch mt-4">
                        <input type="checkbox" class="custom-control-input" id="filtroVerEliminados" name="verEliminados" value="true"
                               @(verEliminados ? "checked" : "") />
                        <label class="custom-control-label" for="filtroVerEliminados">Ver eliminados</label>
                    </div>
                    @* un checkbox destildado no se envia: sin este hidden el server tomaria el default (true) *@
                    <input type="hidden" name="verEliminados" value="false" />
                </div>
                <div class="form-group col-md-1 mb-2">
                    <button type="submit" class="btn btn-primary btn-block" title="Filtrar"><i class="fas fa-search"></i></button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm pagos-tabla" id="tablaPagos" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Operación</th>
                            <th>Persona</th>
                            <th>N° Recibo</th>
                            <th>Forma de pago</th>
                            <th class="text-right">Importe</th>
                            <th>Estado</th>
                            <th>Cargado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay pagos ni cobros para mostrar con estos filtros.</td>
                            </tr>
                        }
                        @foreach (System.Data.DataRow fila in Model.Rows)
                        {
                            int idPago = Convert.ToInt32(fila["id"]);
                            bool esEliminado = fila["eliminado"] != DBNull.Value && Convert.ToBoolean(fila["eliminado"]);
                            bool esCobro = string.Equals(Convert.ToString(fila["Operacion"]), "Cobro", StringComparison.OrdinalIgnoreCase);
                            decimal importe = fila["importe"] == DBNull.Value ? 0m : Convert.ToDecimal(fila["importe"]);
                            string urlPago = Url.Action("AddOrEditPago", "Finanzas", new { idPago, returnUrl = urlActual });
                            string clasesFila = "pagos-fila" + (esEliminado ? " pagos-fila-eliminado" : "");

                            <tr class="@clasesFila" data-href="@urlPago" tabindex="0" style="cursor:pointer;">
                                <td>@Convert.ToDateTime(fila["fecha"]).ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="font-weight-bold @(esCobro ? "text-success" : "text-danger")">@fila["Operacion"]</td>
                                <td><a href="@urlPago" class="text-body">@fila["razonSocial"]</a></td>
                                <td>@fila["nroRecibo"]</td>
                                <td>@fila["formaPago"]</td>
                                <td class="text-right font-weight-bold @(esEliminado ? "pagos-importe-eliminado" : "")">@importe.ToString("N2")</td>
                                <td>
                                    @if (esEliminado)
                                    {
                                        <span class="badge badge-danger">ELIMINADO</span>
                                    }
                                </td>
                                <td>@fila["CreadoPor"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    #tablaPagos td, #tablaPagos th { white-space: nowrap; }
    .pagos-tabla { font-size: .88rem; }
    .pagos-fila-eliminado { background-color: #fdf0f0; color: #6c757d; }
    .pagos-importe-eliminado { text-decoration: line-through; }
</style>

<script>
    (function () {
        // Fila completa clickeable (mouse) y con Enter (teclado). El link del nombre ya navega solo.
        function irAlPago(fila) {
            var url = fila && fila.getAttribute('data-href');
            if (url) window.location.href = url;
        }

        var tabla = document.getElementById('tablaPagos');
        if (!tabla) return;

        tabla.addEventListener('click', function (e) {
            if (e.target.closest('a')) return;
            irAlPago(e.target.closest('tr.pagos-fila'));
        });
        tabla.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            irAlPago(e.target.closest('tr.pagos-fila'));
        });
    })();
</script>
