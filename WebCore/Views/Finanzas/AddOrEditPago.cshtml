<div id="globalAntiForgeryToken" style="display:none;">
    @Html.AntiForgeryToken()
</div>

<script src="@Url.Content("~/Scripts/app/modal-cheque.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Scripts/app/pago-cheques.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Scripts/app/form-hotkeys.js")" asp-append-version="true"></script>
<script>
    (function () {
        // Esta vista se renderiza tanto con layout completo (navegacion directa) como sin layout
        // (PartialView via AJAX, ver FinanzasController.AddOrEditPago) -- por eso no puede usar
        // @@section Scripts (rompe cuando se sirve como partial, sin Layout). En el caso con layout,
        // jquery.min.js carga al final del <body>, despues de este bloque -- se difiere a
        // DOMContentLoaded para asegurar que jQuery ya exista (mismo patron que AltaRapidaEmpresa.cshtml).
        function inicializarAddOrEditPago() {
        var idPago = @Model.Id;
        var idPersona = @idPersona;
        var esNuevoPago = @(esNuevo ? "true" : "false");
        var desdePosPago = @(desdePos ? "true" : "false");
        var posInstanceIdPago = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceIdPago));
        var operacionPendienteSeleccion = esNuevoPago;
        var urlPost = '@Url.Action("AddOrEditPagoPost", "Finanzas")';
        var pdfUrlBase = '@Url.Action("ImprimirPdfPago", "Finanzas")';
        var emailConfigUrl = '@Url.Action("ObtenerDatosEmailPago", "Finanzas")';
        var emailSendUrl = '@Url.Action("EnviarComprobantePagoEmail", "Finanzas")';

        function tokenAntiForgery() {
            return document.querySelector('#globalAntiForgeryToken input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Atajos Alt+Enter=Guardar / Alt+C=Cancelar (Batch 5, 2026-09-11, ver docs/DECISIONS.md)
        // -- primer consumidor real de Scripts/app/form-hotkeys.js. #btnGuardarPago ya tiene su
        // propio gate de "elegi primero Pago/Cobro" (mas abajo, ~linea 452) -- FormHotkeys solo
        // dispara un click sintetico, asi que ese gate se respeta solo, sin logica extra aca.
        // #btnVolverAddOrEditPago ya sabe volver (navegacion normal) o cerrar #modalPagoPOS
        // (desdePos, ver el handler unas lineas mas abajo) -- mismo criterio.
        window.FormHotkeys && window.FormHotkeys.init({
            formSelector: '#addOrEditPagoContainer',
            saveSelector: '#btnGuardarPago',
            cancelSelector: '#btnVolverAddOrEditPago'
        });

        // Enter-como-Tab (Batch 5, 2026-09-11, ver docs/DECISIONS.md): Enter en un input avanza
        // al siguiente campo en vez de no hacer nada -- mismo criterio que Productos/AddOrEdit.
        // cshtml (moverFocoComoTab) / Cajas/_AddOrEditEgresoCaja.cshtml (bindEnterFlow), pero con
        // una lista explicita y acotada a los campos reales de este formulario (mas simple de
        // razonar con esta vista corriendo standalone o embebida dentro de 2 modales apilados,
        // #modalPagoPOS sobre #modalFinanzasPOS). Observaciones (textarea) queda como destino
        // final de la cadena pero SIN el keydown -- Enter ahi debe insertar un salto de linea,
        // mismo criterio de exclusion de textarea que el resto del proyecto.
        var ORDEN_CAMPOS_ENTER_PAGO = ['#SucursalId', '#Fecha', '#NroRecibo', '#FormaPago_', '#txtImporte', '#Efectivo', '#Observaciones'];

        function moverFocoSiguienteCampoPago(idActual) {
            var indiceActual = ORDEN_CAMPOS_ENTER_PAGO.indexOf(idActual);
            if (indiceActual < 0) return;

            for (var i = indiceActual + 1; i < ORDEN_CAMPOS_ENTER_PAGO.length; i++) {
                var $siguiente = $(ORDEN_CAMPOS_ENTER_PAGO[i]);
                if ($siguiente.length && $siguiente.is(':visible') && !$siguiente.prop('disabled') && !$siguiente.prop('readonly')) {
                    $siguiente.trigger('focus');
                    if (typeof $siguiente[0].select === 'function') $siguiente[0].select();
                    return;
                }
            }
        }

        $('#SucursalId, #Fecha, #NroRecibo, #FormaPago_, #txtImporte, #Efectivo').on('keydown.pagoEnterTab', function (e) {
            if (e.key !== 'Enter' || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;

            e.preventDefault();
            moverFocoSiguienteCampoPago('#' + this.id);
        });

        function parseDecimal(value) {
            var text = String(value == null ? '' : value).trim().replace(/\./g, '').replace(',', '.');
            var n = parseFloat(text.replace(/[^0-9.\-]/g, ''));
            return isNaN(n) ? 0 : n;
        }

        // Boton "Volver" (Batch 10 de la quinta ronda, 2026-09-10, ver docs/DECISIONS.md): en modo
        // POS, cierra #modalPagoPOS en vez de navegar afuera de /Ventas/POS -- mismo criterio que
        // window.volverDesdePago del clasico.
        if (desdePosPago) {
            $('#btnVolverAddOrEditPago').on('click', function (e) {
                e.preventDefault();
                if (window.POSFinanzas && typeof window.POSFinanzas.cerrarModalPago === 'function') {
                    window.POSFinanzas.cerrarModalPago();
                }
            });
        }

        // ===== "Elegí primero Pago/Cobro" (Batch 10 de la quinta ronda, 2026-09-10, ver
        // docs/DECISIONS.md) -- reversion escopeada del recorte anterior. Solo aplica en alta
        // (esNuevoPago); en edicion la operacion ya es conocida, no hay nada que elegir. =====
        function focoEnControlEditable() {
            var el = document.activeElement;
            if (!el) return false;
            var tag = (el.tagName || '').toLowerCase();
            if (tag === 'textarea' || tag === 'select') return true;
            if (tag !== 'input') return false;
            var tipo = (el.type || '').toLowerCase();
            return tipo !== 'button' && tipo !== 'checkbox' && tipo !== 'radio';
        }

        function setOperacionPendiente(pendiente) {
            operacionPendienteSeleccion = !!pendiente;
            $('.pago-requiere-operacion').find('input, select, textarea').prop('disabled', operacionPendienteSeleccion);
        }

        function actualizarBotonesOperacion() {
            var valor = ($('#AProveedor').val() || '').toString();
            $('.pago-operacion-opcion')
                .removeClass('active btn-danger btn-success')
                .each(function () {
                    var esEsteBotonPago = $(this).attr('data-operacion-valor') === 'true';
                    $(this).addClass(esEsteBotonPago ? 'btn-outline-danger' : 'btn-outline-success');
                });

            if (valor === '') return;

            $('.pago-operacion-opcion[data-operacion-valor="' + valor + '"]')
                .removeClass('btn-outline-danger btn-outline-success')
                .addClass('active ' + (valor === 'true' ? 'btn-danger' : 'btn-success'));
        }

        function seleccionarOperacion(valor) {
            $('#AProveedor').val(valor).trigger('change');
        }

        if (esNuevoPago) {
            $('#AProveedor').on('change', function () {
                var valor = ($(this).val() || '').toString();
                actualizarBotonesOperacion();

                if (valor === '') {
                    setOperacionPendiente(true);
                    return;
                }

                var estabaPendiente = operacionPendienteSeleccion;
                setOperacionPendiente(false);
                actualizarVisibilidadCheques();

                if (estabaPendiente) {
                    var $sucursal = $('#SucursalId:visible:not(:disabled)');
                    if ($sucursal.length) $sucursal.trigger('focus');
                }
            });

            $(document).on('click', '.pago-operacion-opcion', function (e) {
                e.preventDefault();
                seleccionarOperacion($(this).attr('data-operacion-valor'));
            });

            $(document)
                .off('keydown.posPagoAtajos')
                .on('keydown.posPagoAtajos', function (event) {
                    if (desdePosPago && window.POSGuard && !window.POSGuard.isModalOnTop('#modalPagoPOS')) return;
                    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
                    if (focoEnControlEditable()) return;
                    if (!$('.pago-operacion-elegir').is(':visible')) return;

                    if (event.key === '1') {
                        event.preventDefault();
                        seleccionarOperacion('true');
                    } else if (event.key === '2') {
                        event.preventDefault();
                        seleccionarOperacion('false');
                    }
                });

            $('#btnGuardarPago').on('click', function (e) {
                if (!operacionPendienteSeleccion) return;
                e.preventDefault();
                e.stopImmediatePropagation();
                Swal.fire({ icon: 'warning', title: 'Validación', text: 'Seleccione primero si desea realizar un pago o recibir un cobro.' });
            });

            setOperacionPendiente(true);
            actualizarBotonesOperacion();

            // Reintento (no un solo setTimeout) -- Bootstrap 4/5 no soporta oficialmente modales
            // anidados: cuando esta vista corre embebida en #modalPagoPOS (apilado sobre
            // #modalFinanzasPOS), el enforce-focus del modal de AFUERA le gana a un foco puesto
            // una sola vez apenas se inyecta el HTML, devolviendo el foco al boton "cerrar" poco
            // despues. Mismo patron de reintento que enfocarCampoPagoConReintento del clasico
            // (Web/Views/Finanzas/_AddOrEditPagoScripts.cshtml).
            (function enfocarBotonPagoConReintento(intentos) {
                var $btn = $('.pago-operacion-opcion[data-operacion-valor="true"]');
                if ($btn.length) $btn.trigger('focus');
                if (intentos < 8) {
                    setTimeout(function () { enfocarBotonPagoConReintento(intentos + 1); }, 80);
                }
            })(0);
        }

        // ===== Pago con Cheque/EftvoCheque (2026-09-05, ver docs/DECISIONS.md) =====
        // Port de la logica de _AddOrEditPagoScripts.cshtml (Web clasico), acotada a lo que esta
        // vista simplificada necesita.
        function normalizarFormaPago(valor) {
            return (valor || '').toString().trim().toLowerCase();
        }

        function esFormaCheque(valor) {
            var v = normalizarFormaPago(valor);
            return v === 'cheque' || v === 'eftvocheque';
        }

        function esFormaMixta(valor) {
            return normalizarFormaPago(valor) === 'eftvocheque';
        }

        function tieneChequesAsignados() {
            return $('#tablaCheques tbody tr').length > 0;
        }

        function construirChequesJson() {
            var lista = [];

            $('#tablaCheques tbody tr').each(function () {
                lista.push({
                    Id: $(this).data('id') || 0,
                    NroCheque: ($(this).find('td:eq(0)').text() || '').trim(),
                    Banco: ($(this).find('td:eq(1)').text() || '').trim(),
                    FechaPago: ($(this).find('td:eq(2)').text() || '').trim(),
                    Importe: parseFloat(($(this).find('td:eq(3)').text() || '').replace('$', '').trim()) || 0
                });
            });

            $('#ChequesJson').val(JSON.stringify(lista));
        }

        function actualizarVisibilidadCheques() {
            var esCheque = esFormaCheque($('#FormaPago_').val());
            var esMixto = esFormaMixta($('#FormaPago_').val());

            $('#bloqueCheques').toggle(esCheque);
            $('#txtImporte').prop('readonly', esCheque);

            if (esCheque && esMixto) {
                $('#bloqueEfectivo').show();
            } else {
                $('#bloqueEfectivo').hide();
                if (esCheque) $('#Efectivo').val('0');
            }

            if (esCheque && window.PagoCheques) {
                window.PagoCheques.recalcularTotales();
            } else if (!esCheque && window.PagoCheques) {
                window.PagoCheques.clearCheques();
            }
        }

        var ultimaFormaPago = $('#FormaPago_').val();

        $('#FormaPago_').on('change', function () {
            var valorNuevo = $(this).val();

            if (!esFormaCheque(valorNuevo) && tieneChequesAsignados()) {
                Swal.fire({ icon: 'warning', title: 'Validación', text: 'Para cambiar la forma de pago primero debe quitar los cheques asignados.' });
                $(this).val(ultimaFormaPago);
                return;
            }

            ultimaFormaPago = valorNuevo;
            actualizarVisibilidadCheques();
        });

        $('#Efectivo').on('input', function () {
            if (window.PagoCheques) window.PagoCheques.recalcularTotales();
        });

        window.PagoChequeSeed = [
            @if (Model.Cheques != null)
            {
                for (int i = 0; i < Model.Cheques.Count; i++)
                {
                    var c = Model.Cheques[i];
                    <text>{ Id: @c.Id, NroCheque: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.NroCheque ?? ""))', Banco: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.Banco ?? ""))', FechaPago: '@c.FechaPago.ToString("yyyy-MM-dd")', Importe: @c.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture) }@(i < Model.Cheques.Count - 1 ? "," : "")</text>
                }
            }
        ];

        function inicializarPagoChequesCuandoListo() {
            if (!window.PagoCheques) {
                window.setTimeout(inicializarPagoChequesCuandoListo, 60);
                return;
            }

            window.PagoCheques.init({
                buscarChequePorNro: '@Url.Action("BuscarChequePorNro", "Finanzas")',
                getCheques: '@Url.Action("GetCheques", "Finanzas")',
                guardarCheque: '@Url.Action("GuardarCheque", "Finanzas")'
            });

            actualizarVisibilidadCheques();
        }

        inicializarPagoChequesCuandoListo();

        $('#btnGuardarPago').on('click', function () {
            $('#msgErrorPago').addClass('d-none').text('');
            construirChequesJson();

            var payload = {
                Id: idPago,
                Fecha: $('#Fecha').val(),
                FormaPago_: $('#FormaPago_').val(),
                AProveedor: $('#AProveedor').val() === 'true',
                Observaciones: $('#Observaciones').val() || '',
                NroRecibo: $('#NroRecibo').val() || ''
            };

            var params = $.param(payload) +
                '&SucursalId=' + encodeURIComponent($('#SucursalId').val()) +
                '&idPersona=' + encodeURIComponent(idPersona) +
                '&importe=' + encodeURIComponent($('#txtImporte').val()) +
                '&Efectivo=' + encodeURIComponent($('#Efectivo').val() || '0') +
                '&ChequesJson=' + encodeURIComponent($('#ChequesJson').val() || '') +
                '&returnUrl=' + encodeURIComponent($('#hddReturnUrl').val() || '') +
                // Faltaba mandar desdePos (Batch 10 de la quinta ronda, 2026-09-10, ver
                // docs/DECISIONS.md) -- sin esto, AddOrEditPagoPost SIEMPRE recibia desdePos=false
                // por default aunque la vista corriera embebida en POS: nunca forzaba la
                // sucursal/caja abierta del vendedor ni devolvia cerrarModalPago=true.
                '&desdePos=' + (desdePosPago ? 'true' : 'false') +
                '&posInstanceId=' + encodeURIComponent(posInstanceIdPago || '');

            var $btn = $(this);
            $btn.prop('disabled', true);

            $.ajax({
                url: urlPost,
                type: 'POST',
                data: params,
                headers: { RequestVerificationToken: tokenAntiForgery() }
            }).done(function (resp) {
                $btn.prop('disabled', false);

                if (!resp || !resp.ok) {
                    $('#msgErrorPago').removeClass('d-none').text((resp && resp.mensaje) || 'No se pudo guardar el pago.');
                    return;
                }

                // Modo POS (Batch 10 de la quinta ronda, 2026-09-10, ver docs/DECISIONS.md): antes
                // navegaba afuera de /Ventas/POS con window.location.href, perdiendo la venta en
                // curso -- ahora cierra #modalPagoPOS y refresca la Cuenta Corriente ya cargada en
                // #modalFinanzasPOS (resp.redirectUrl ya trae desdePos=true, heredado del
                // returnUrl con el que se abrio este formulario).
                if (resp.cerrarModalPago) {
                    if (window.POSFinanzas && typeof window.POSFinanzas.cerrarModalPago === 'function') {
                        window.POSFinanzas.cerrarModalPago();
                    }
                    if (resp.redirectUrl && window.POSFinanzas && typeof window.POSFinanzas.cargar === 'function') {
                        window.POSFinanzas.cargar(resp.redirectUrl, 'Cuenta corriente');
                    }
                    return;
                }

                window.location.href = resp.redirectUrl;
            }).fail(function (xhr) {
                $btn.prop('disabled', false);
                $('#msgErrorPago').removeClass('d-none').text((xhr.responseJSON && xhr.responseJSON.mensaje) || 'No se pudo guardar el pago.');
            });
        });

        $('#btnEmailPago').on('click', function () {
            $('#pagoEmailError').addClass('d-none').text('');

            $.getJSON(emailConfigUrl, { id: idPago }).done(function (resp) {
                if (!resp || !resp.ok) {
                    Swal.fire({ icon: 'error', title: 'No se pudo preparar el email', text: (resp && resp.msg) || 'Error desconocido.' });
                    return;
                }

                $('#pagoEmailDestino').val(resp.email || '');
                $('#pagoEmailAsunto').val(resp.asunto || '');
                $('#pagoEmailMensaje').val(resp.mensaje || '');
                $('#modalEmailPago').modal('show');
            }).fail(function () {
                Swal.fire({ icon: 'error', title: 'No se pudo preparar el email', text: 'Error de conexión.' });
            });
        });

        $('#btnConfirmarEmailPago').on('click', function () {
            var email = ($('#pagoEmailDestino').val() || '').trim();
            var asunto = ($('#pagoEmailAsunto').val() || '').trim();
            var mensaje = ($('#pagoEmailMensaje').val() || '').trim();

            if (!email) {
                $('#pagoEmailError').removeClass('d-none').text('Ingrese un email destino.');
                return;
            }

            var $btn = $(this);
            $btn.prop('disabled', true);

            $.post(emailSendUrl, { idPago: idPago, emailDestino: email, asunto: asunto, mensaje: mensaje })
                .done(function (resp) {
                    $btn.prop('disabled', false);

                    if (!resp || !resp.ok) {
                        $('#pagoEmailError').removeClass('d-none').text((resp && resp.msg) || 'No se pudo enviar el email.');
                        return;
                    }

                    $('#modalEmailPago').modal('hide');
                    Swal.fire({ icon: 'success', title: 'Email enviado', text: 'El recibo se envió correctamente.' });
                }).fail(function (xhr) {
                    $btn.prop('disabled', false);
                    $('#pagoEmailError').removeClass('d-none').text((xhr.responseJSON && xhr.responseJSON.msg) || 'No se pudo enviar el email.');
                });
        });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", inicializarAddOrEditPago);
        } else {
            inicializarAddOrEditPago();
        }
    })();
</script>

<style>
    .pago-form-compact label {
        font-size: .82rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .2rem;
    }
</style>
