@model Entidades.Pago
@*
    Port simplificado de Web/Views/Finanzas/AddOrEditPago.cshtml (1541 lineas) +
    _AddOrEditPagoScripts.cshtml (698 lineas) -- ver docs/10-migracion-aspnet-core/
    PLAN-ADDOREDITPAGO.md. Alta/edicion de un Pago o Cobro en cuenta corriente.

    Recorte restante (confirmado con el usuario, se mantiene): sin bloque colapsable de
    observaciones -- UI simplificada, misma logica de negocio.

    REVERSION explicita del recorte "sin atajos de teclado 1/2" (Batch 10 de la quinta ronda,
    2026-09-10, ver docs/DECISIONS.md, pedido explicito del usuario): en alta (esNuevo), se
    restaura el flujo "elegí primero Pago/Cobro" -- 2 botones grandes en vez del <select> directo,
    atajos de teclado "1" (Pago)/"2" (Cobro), foco inicial en el boton de Pago, y el resto del
    formulario deshabilitado hasta elegir. Version SCOPEADA del original clasico (698 lineas en
    Web/Views/Finanzas/_AddOrEditPagoScripts.cshtml): se porta el gate de "operacion pendiente" +
    atajos + foco (lo pedido explicitamente), NO se porta el compactado/expansion de la tarjeta de
    operacion ni la revalidacion de cheques ya asignados al cambiar de tipo de operacion (edge
    case de edicion, no de alta, sin markup equivalente en esta version simplificada). En edicion
    (!esNuevo) no cambia nada -- sigue siendo el <select> plano de siempre, sin gate.

    Pago con Cheque/EftvoCheque portado 2026-09-05 (ver docs/DECISIONS.md): reusa el CRUD de
    cheques ya existente (_ChequeBusquedaTabla.cshtml, _ModalAltaCheque.cshtml,
    Scripts/app/modal-cheque.js) mas un port literal de Scripts/app/pago-cheques.js. Los 3
    endpoints AJAX (BuscarChequePorNro/GetCheques/GuardarCheque) ya existian en este controller
    con el contrato exacto que ese script espera -- confirmado antes de tocar nada.
*@
@{
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;
    string posInstanceIdPago = ViewBag.PosInstanceId as string ?? "";
    var sucursales = ViewBag.Sucursales as List<Entidades.Sucursal> ?? new List<Entidades.Sucursal>();
    var personaObj = ViewBag.Persona as Entidades.Persona;
    string persona = personaObj != null ? (personaObj.RazonSocial ?? "") : "";
    decimal saldo = ViewBag.SaldoPersona;
    int idPersona = ViewBag.IdPersona != null ? (int)ViewBag.IdPersona : 0;
    string returnUrl = ViewBag.ReturnUrl as string ?? "";
    bool esNuevo = Model.Id == 0;

    // Pago existente fuera de POS: todos los campos en solo lectura (con texto bien legible) hasta apretar
    // "Modificar"; el boton pasa a "Guardar". En alta y en POS no cambia nada (2026-09-24, ver docs/DECISIONS.md).
    bool pagoEliminado = ViewBag.PagoEliminado != null && (bool)ViewBag.PagoEliminado;
    bool puedeReasignarOEliminar = ViewBag.PuedeReasignarOEliminar != null && (bool)ViewBag.PuedeReasignarOEliminar;
    bool soloLecturaInicial = !esNuevo && !desdePos;
    // Advertencia: la fecha del pago no es el dia en que se cargo el registro. En alta, "carga" = hoy.
    DateTime fechaDeCarga = Model.Creado ?? DateTime.Now;
    bool fechaDistinta = Negocio.CuentaCorriente.TieneFechaDistintaALaCarga(Model);
    // Observaciones: el area de texto aparece desplegada solo si ya tiene contenido.
    bool observacionesConContenido = !string.IsNullOrWhiteSpace(Model.Observaciones);
    ViewBag.Title = esNuevo ? "Nuevo pago o cobro" : "Editar pago o cobro";

    var formasPago = new (string valor, string texto)[]
    {
        ("Efectivo", "Efectivo"),
        ("Debito", "Debito"),
        ("Credito", "Credito"),
        ("Qr", "Qr"),
        ("Transferencia", "Transferencia"),
        ("Cheque", "Cheque"),
        ("EftvoCheque", "Efectivo + Cheques"),
        ("Otro", "Otro")
    };

    var chequeBusquedaViewData = new ViewDataDictionary(ViewData);
    chequeBusquedaViewData["ChequeBusquedaEnPago"] = true;
}

<div id="addOrEditPagoContainer" class="container-fluid px-2 px-md-3 pago-form-compact @(desdePos ? "" : "pago-form-pagina")">
    <div class="alert alert-primary d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <a href="@(string.IsNullOrWhiteSpace(returnUrl) ? Url.Action("CtaCtePersona", "Finanzas", new { idPersona }) : returnUrl)"
               class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverAddOrEditPago">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h5 class="mb-0"><strong id="lblPersonaPago">@persona</strong></h5>
            @if (puedeReasignarOEliminar)
            {
                <button type="button" class="btn btn-sm btn-outline-primary ml-2 d-none" id="btnCambiarPersonaPago" data-pago-fijo="true"
                        title="Asignar este pago o cobro a otra persona">
                    <i class="fas fa-exchange-alt mr-1"></i>Cambiar persona
                </button>
            }
            <span class="badge badge-warning ml-2 d-none" id="avisoCambioPersonaPago"></span>
            @if (pagoEliminado)
            {
                <span class="badge badge-danger ml-2">ELIMINADO</span>
            }
        </div>
        <h5 class="mb-0" id="saldoPersonaPagoWrap">
            Saldo:
            <span class="@(saldo >= 0 ? "text-success" : "text-danger") font-weight-bold">$ @saldo.ToString("N2")</span>
        </h5>
    </div>

    @if (pagoEliminado)
    {
        <div class="alert alert-danger" role="alert" id="alertPagoEliminado">
            <i class="fas fa-ban mr-1"></i>
            <strong>Este @(Model.AProveedor ? "pago" : "cobro") fue eliminado</strong>
            @(Model.FechaEliminacion.HasValue ? "el " + Model.FechaEliminacion.Value.ToString("dd/MM/yyyy HH:mm") : "")
            @(string.IsNullOrWhiteSpace(Model.NombreEliminadoPor) ? "" : "por " + Model.NombreEliminadoPor).
            Su asiento en la cuenta corriente quedó revertido y ya no se puede modificar.
            @if (!string.IsNullOrWhiteSpace(Model.MotivoEliminacion))
            {
                <div class="mt-1"><strong>Motivo:</strong> @Model.MotivoEliminacion</div>
            }
        </div>
    }

    <div class="alert alert-warning py-2 @(fechaDistinta ? "" : "d-none")" role="alert" id="alertFechaDistinta"
         data-fecha-carga="@fechaDeCarga.ToString("yyyy-MM-dd")" style="@(fechaDistinta ? "" : "display:none;")">
        <i class="fas fa-exclamation-triangle mr-1"></i>
        Advertencia: la fecha del pago es distinta al día en que se cargó
        (<span id="lblFechaCarga">@fechaDeCarga.ToString("dd/MM/yyyy")</span>).
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <input type="hidden" id="hddIdPersona" value="@idPersona" />
            <input type="hidden" id="hddReturnUrl" value="@returnUrl" />

            @if (esNuevo)
            {
                <div class="form-group mb-3 pago-operacion-elegir">
                    <label>Operación</label>
                    <div class="d-flex" style="gap:.6rem;">
                        <button type="button" class="pago-op-card pago-op-pago flex-fill pago-operacion-opcion" data-operacion-valor="true">
                            <span class="pago-op-icono"><i class="fas fa-arrow-up"></i></span>
                            <span class="pago-op-texto">
                                <span class="pago-op-titulo">Realizar un pago</span>
                                <small class="pago-op-sub">Entrego dinero &middot; tecla <kbd>1</kbd></small>
                            </span>
                        </button>
                        <button type="button" class="pago-op-card pago-op-cobro flex-fill pago-operacion-opcion" data-operacion-valor="false">
                            <span class="pago-op-icono"><i class="fas fa-arrow-down"></i></span>
                            <span class="pago-op-texto">
                                <span class="pago-op-titulo">Recibir un cobro</span>
                                <small class="pago-op-sub">Recibo dinero &middot; tecla <kbd>2</kbd></small>
                            </span>
                        </button>
                    </div>
                    <select id="AProveedor" name="AProveedor" class="form-control d-none">
                        <option value="" selected>-- Elegí una operación --</option>
                        <option value="false">Cobro (recibo dinero)</option>
                        <option value="true">Pago (entrego dinero)</option>
                    </select>
                </div>
            }

            @* Orden pensado para leer de corrido en un ancho corto: 1) cuando y donde (fecha, recibo, sucursal),
               2) que y cuanto (operacion, forma de pago, importe), 3) observaciones, 4) botones. *@
            <div class="form-row">
                <div class="col-md-6 mb-3 pago-requiere-operacion">
                    <label for="Fecha">Fecha</label>
                    <input type="datetime-local" id="Fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")" />
                </div>

                <div class="col-md-6 mb-3 pago-requiere-operacion">
                    <label for="NroRecibo">N° Recibo</label>
                    <input type="text" id="NroRecibo" class="form-control" value="@Model.NroRecibo" maxlength="50" autocomplete="off" />
                </div>
            </div>

            <div class="form-row">
                @if (!esNuevo)
                {
                    <div class="col-md-4 mb-3">
                        <label for="AProveedor">Operación</label>
                        <select id="AProveedor" name="AProveedor" class="form-control">
                            <option value="false" selected="@(!Model.AProveedor ? "selected" : null)">Cobro (recibo dinero)</option>
                            <option value="true" selected="@(Model.AProveedor ? "selected" : null)">Pago (entrego dinero)</option>
                        </select>
                    </div>
                }
                <div class="col-md-4 mb-3 pago-requiere-operacion">
                    <label for="FormaPago_">Forma de pago</label>
                    <select id="FormaPago_" name="FormaPago_" class="form-control">
                        @foreach (var forma in formasPago)
                        {
                            <option value="@forma.valor" selected="@(Model.FormaPago == forma.valor ? "selected" : null)">@forma.texto</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 mb-3 pago-requiere-operacion">
                    <label for="txtImporte">Importe</label>
                    <div class="input-group">
                        <input type="text" id="txtImporte" class="form-control text-right" inputmode="decimal" autocomplete="off"
                               value="@(Model.Importe > 0 ? Model.Importe.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                        @* Calculadora de billetes (mismo boton que Egresos de caja): carga el total en el importe y el
                           detalle del conteo en Observaciones. Se oculta con cheques (el importe sale de los cheques). *@
                        <div class="input-group-append" id="btnCalculadoraBilletesPagoWrap">
                            <button type="button"
                                    id="btnCalculadoraBilletesPago"
                                    class="btn btn-outline-secondary js-calculadora-billetes-launch"
                                    data-cb-context="pago-importe"
                                    data-cb-input="#txtImporte"
                                    data-cb-detail="#Observaciones"
                                    title="Calcular efectivo">
                                <i class="fas fa-money-bill-wave"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3" id="bloqueEfectivo" style="display:none;">
                    <label for="Efectivo">Efectivo (pago mixto)</label>
                    <input type="text" id="Efectivo" class="form-control text-right" inputmode="decimal" autocomplete="off"
                           value="@(Model.Efectivo > 0 ? Model.Efectivo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                </div>
            </div>

            <div id="bloqueCheques" class="cheques-panel" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Cheques</h6>
                    <small class="text-muted">Buscá, agregá o cargá cheques sin salir del pago.</small>
                </div>

                <div class="form-group">
                    <label for="txtNroCheque">Número de Cheque</label>
                    <div class="input-group">
                        <input type="text" id="txtNroCheque" class="form-control" placeholder="Ingrese número de cheque...">
                        <div class="input-group-append">
                            <button type="button" id="btnAgregarCheque" class="btn btn-primary">Agregar</button>
                            <button type="button" id="btnBuscarCheques" class="btn btn-info">Buscar</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive cheques-tabla-wrap mb-2">
                    <table class="table table-bordered table-sm cheques-table-compact" id="tablaCheques">
                        <thead class="thead-light">
                            <tr>
                                <th>Número</th>
                                <th>Banco</th>
                                <th>Fecha Pago</th>
                                <th>Importe</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="form-group mb-0">
                    <label for="txtTotalCheques">Total Cheques</label>
                    <input type="text" id="txtTotalCheques" class="form-control" readonly value="0">
                </div>
            </div>

            <div class="form-group pago-requiere-operacion">
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="chkObservaciones" @(observacionesConContenido ? "checked" : "") />
                    <label class="custom-control-label" for="chkObservaciones">Observaciones</label>
                </div>
                <div id="bloqueObservaciones" class="mt-2 @(observacionesConContenido ? "" : "d-none")">
                    <textarea id="Observaciones" class="form-control" rows="3" maxlength="500">@Model.Observaciones</textarea>
                </div>
            </div>

            <input type="hidden" id="Id" value="@Model.Id" />
            <input type="hidden" id="ChequesJson" />

            <div class="alert alert-danger d-none" id="msgErrorPago"></div>

            <div class="d-flex justify-content-end flex-wrap" style="gap:.5rem;">
                @if (puedeReasignarOEliminar)
                {
                    <button type="button" class="btn btn-outline-danger mr-auto" id="btnEliminarPago" data-pago-fijo="true"
                            title="Eliminar: genera el asiento opuesto y queda visible como ELIMINADO">
                        <i class="fas fa-trash-alt mr-1"></i>Eliminar
                    </button>
                }
                @if (!esNuevo)
                {
                    <a class="btn btn-outline-secondary" id="btnPdfPago" href="@ViewBag.ImprimirPagoPdfUrl" target="_blank" rel="noopener">
                        <i class="fas fa-file-pdf mr-1"></i>Ver PDF
                    </a>
                    <button type="button" class="btn btn-outline-success" id="btnEmailPago" data-pago-fijo="true">
                        <i class="fas fa-envelope mr-1"></i>Enviar por email
                    </button>
                }
                <button type="button" class="btn btn-outline-secondary" id="btnCancelarPago" data-pago-fijo="true" title="Cancelar (Alt+C o Esc)">
                    <i class="fas fa-times mr-1"></i>Cancelar
                    <small class="pago-atajo">Alt+C / Esc</small>
                </button>
                @if (!pagoEliminado)
                {
                    <button type="button" class="btn btn-primary" id="btnGuardarPago" data-pago-fijo="true">
                        <i class="fas fa-save mr-1"></i><span id="btnGuardarPagoTexto">Guardar</span>
                        <small class="pago-atajo">Alt+Enter</small>
                    </button>
                }
            </div>

            @* Sucursal: se muestra ARRIBA de todo (order:-1) pero va al FINAL del DOM, asi el Tab solo llega hasta
               aca si da toda la vuelta. Por defecto es la sucursal del usuario logueado (FinanzasController). *@
            <div class="form-row pago-sucursal-fila">
                <div class="col-md-6 mb-3 pago-requiere-operacion">
                    <label for="SucursalId">Sucursal</label>
                    <select id="SucursalId" name="SucursalId" class="form-control">
                        @foreach (var sucursal in sucursales)
                        {
                            <option value="@sucursal.idSucursal" selected="@((Model.Sucursal != null && Model.Sucursal.idSucursal == sucursal.idSucursal) ? "selected" : null)">@sucursal.sucursal</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

@if (puedeReasignarOEliminar)
{
    <div class="modal fade" id="modalCambiarPersonaPago" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exchange-alt mr-2"></i>Asignar a otra persona</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control mb-2" id="filtroPersonaPago" placeholder="Buscar por razón social, CUIT o identificación..." autocomplete="off" />
                    <div class="table-responsive" style="max-height:320px; overflow:auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light">
                                <tr><th>CUIT</th><th>Razón social</th><th>Identificación</th></tr>
                            </thead>
                            <tbody id="tablaPersonasPago"></tbody>
                        </table>
                    </div>
                    <small class="text-muted d-block mt-2">Elegí la persona con clic o con Enter (primera de la lista). El cambio se aplica al guardar.</small>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="modalEmailPago" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Enviar comprobante por email</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="pagoEmailDestino">Email destino</label>
                    <input type="email" class="form-control" id="pagoEmailDestino" maxlength="200">
                </div>
                <div class="form-group">
                    <label for="pagoEmailAsunto">Asunto</label>
                    <input type="text" class="form-control" id="pagoEmailAsunto" maxlength="200">
                </div>
                <div class="form-group mb-0">
                    <label for="pagoEmailMensaje">Mensaje</label>
                    <textarea class="form-control" id="pagoEmailMensaje" rows="5"></textarea>
                </div>
                <div class="alert alert-danger d-none mb-0 mt-2" id="pagoEmailError"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" type="button" id="btnConfirmarEmailPago">
                    <i class="fas fa-paper-plane mr-1"></i>Enviar email
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalBuscarCheques" tabindex="-1" role="dialog" aria-labelledby="modalBuscarChequesLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-cheque-compact-dialog" role="document">
        <div class="modal-content modal-cheque-compact">
            <div class="modal-header modal-cheque-compact-header">
                <h5 class="modal-title">
                    <i class="fas fa-search mr-2"></i>Buscar Cheques
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body modal-cheque-compact-body modal-cheque-busqueda-body">
                @Html.Partial("_ChequeBusquedaTabla", (object)null, chequeBusquedaViewData)
            </div>
            <div class="modal-footer modal-cheque-compact-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ModalAltaCheque")

<div class="modal fade" id="modalDetalleCheque" tabindex="-1" role="dialog" aria-labelledby="modalDetalleChequeLabel" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-lg modal-cheque-compact-dialog" role="document">
        <div class="modal-content modal-cheque-compact">
            <div class="modal-header modal-cheque-compact-header">
                <h5 class="modal-title" id="modalDetalleChequeLabel">
                    <i class="fas fa-receipt mr-2"></i>Detalle del cheque
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body modal-cheque-compact-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Número</small>
                        <strong id="detalleChequeNumero">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Estado</small>
                        <strong id="detalleChequeEstado">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Origen</small>
                        <strong id="detalleChequeOrigen">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Banco</small>
                        <strong id="detalleChequeBanco">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Recibido de</small>
                        <strong id="detalleChequeRecibidoDe">-</strong>
                    </div>
                    <div class="col-md-6 mb-3">
                        <small class="text-muted d-block">Entregado a</small>
                        <strong id="detalleChequeEntregadoA">-</strong>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Observaciones</small>
                        <div id="detalleChequeObservaciones">-</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer modal-cheque-compact-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div id="globalAntiForgeryToken" style="display:none;">
    @Html.AntiForgeryToken()
</div>

<script src="@Url.Content("~/Scripts/app/modal-cheque.js")" asp-append-version="true"></script>
<script src="@Url.Content("~/Scripts/app/pago-cheques.js")" asp-append-version="true"></script>
@* form-hotkeys.js tampoco puede ir como <script src> normal: necesita jQuery y con layout completo jQuery carga
   al final del <body> (el modulo salia sin registrar window.FormHotkeys y Alt+Enter / Alt+C no funcionaban fuera
   de POS). Mismo patron que money-input-mask.js: se carga desde el init, cuando jQuery ya existe. *@
<script type="text/plain" id="formHotkeysSrc" src="@Url.Content("~/Scripts/app/form-hotkeys.js")" asp-append-version="true"></script>
@* money-input-mask.js NO puede ir como <script src> normal: se cancela solo si jQuery todavia no cargo
   (en el layout completo jquery.min.js carga al final del <body>). type="text/plain" evita que el
   navegador lo ejecute ni jQuery lo evalue al inyectar el partial; solo sirve para que asp-append-version
   calcule la URL versionada, que el init de abajo lee para cargarlo cuando jQuery ya existe. *@
<script type="text/plain" id="moneyInputMaskSrc" src="@Url.Content("~/Scripts/app/money-input-mask.js")" asp-append-version="true"></script>
<script>
    (function () {
        // Esta vista se renderiza tanto con layout completo (navegacion directa) como sin layout
        // (PartialView via AJAX, ver FinanzasController.AddOrEditPago) -- por eso no puede usar
        // @@section Scripts (rompe cuando se sirve como partial, sin Layout). En el caso con layout,
        // jquery.min.js carga al final del <body>, despues de este bloque -- se difiere a
        // DOMContentLoaded para asegurar que jQuery ya exista (mismo patron que AltaRapidaEmpresa.cshtml).
        function inicializarAddOrEditPago() {
        var idPago = @Model.Id;
        var idPersona = @idPersona;
        var esNuevoPago = @(esNuevo ? "true" : "false");
        var desdePosPago = @(desdePos ? "true" : "false");
        var posInstanceIdPago = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceIdPago));
        var operacionPendienteSeleccion = esNuevoPago;
        // Pago existente fuera de POS: arranca en solo lectura hasta "Modificar" (ver aplicarModoLectura).
        var soloLecturaPago = @(soloLecturaInicial && !pagoEliminado ? "true" : "false");
        var pagoEliminadoVista = @(pagoEliminado ? "true" : "false");
        var idPersonaOriginal = @idPersona;
        var nombrePersonaOriginal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(persona));
        var urlEliminarPago = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UrlEliminarPago as string ?? ""));
        var urlListarPersonasPago = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UrlListarPersonas as string ?? ""));
        var urlPost = '@Url.Action("AddOrEditPagoPost", "Finanzas")';
        var pdfUrlBase = '@Url.Action("ImprimirPdfPago", "Finanzas")';
        var emailConfigUrl = '@Url.Action("ObtenerDatosEmailPago", "Finanzas")';
        var emailSendUrl = '@Url.Action("EnviarComprobantePagoEmail", "Finanzas")';

        function tokenAntiForgery() {
            return document.querySelector('#globalAntiForgeryToken input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Atajos Alt+Enter=Guardar / Alt+C=Cancelar (Batch 5, 2026-09-11, ver docs/DECISIONS.md)
        // -- primer consumidor real de Scripts/app/form-hotkeys.js. #btnGuardarPago ya tiene su
        // propio gate de "elegi primero Pago/Cobro" (mas abajo, ~linea 452) -- FormHotkeys solo
        // dispara un click sintetico, asi que ese gate se respeta solo, sin logica extra aca.
        // #btnVolverAddOrEditPago ya sabe volver (navegacion normal) o cerrar #modalPagoPOS
        // (desdePos, ver el handler unas lineas mas abajo) -- mismo criterio.
        function iniciarAtajosPago() {
            if (!window.FormHotkeys) return;
            window.FormHotkeys.init({
                formSelector: '#addOrEditPagoContainer',
                saveSelector: '#btnGuardarPago',
                cancelSelector: '#btnCancelarPago'
            });
        }

        if (window.FormHotkeys) {
            iniciarAtajosPago();
        } else {
            var origenAtajos = document.getElementById('formHotkeysSrc');
            if (origenAtajos) {
                var scriptAtajos = document.createElement('script');
                scriptAtajos.src = origenAtajos.getAttribute('src');
                scriptAtajos.onload = iniciarAtajosPago;
                scriptAtajos.onerror = function () { console.error('AddOrEditPago: no se pudo cargar form-hotkeys.js'); };
                document.head.appendChild(scriptAtajos);
            }
        }

        // Enter-como-Tab (Batch 5, 2026-09-11, ver docs/DECISIONS.md): Enter en un input avanza
        // al siguiente campo en vez de no hacer nada -- mismo criterio que Productos/AddOrEdit.
        // cshtml (moverFocoComoTab) / Cajas/_AddOrEditEgresoCaja.cshtml (bindEnterFlow), pero con
        // una lista explicita y acotada a los campos reales de este formulario (mas simple de
        // razonar con esta vista corriendo standalone o embebida dentro de 2 modales apilados,
        // #modalPagoPOS sobre #modalFinanzasPOS). Observaciones (textarea) queda como destino
        // final de la cadena pero SIN el keydown -- Enter ahi debe insertar un salto de linea,
        // mismo criterio de exclusion de textarea que el resto del proyecto.
        // Flujo: fecha > recibo > forma de pago > importe > (efectivo) > interruptor de observaciones (se activa con la
        // barra espaciadora). La sucursal queda fuera del flujo: solo se llega con Tab dando toda la vuelta.
        var ORDEN_CAMPOS_ENTER_PAGO = ['#Fecha', '#NroRecibo', '#FormaPago_', '#txtImporte', '#Efectivo', '#chkObservaciones', '#Observaciones'];

        function moverFocoSiguienteCampoPago(idActual) {
            var indiceActual = ORDEN_CAMPOS_ENTER_PAGO.indexOf(idActual);
            if (indiceActual < 0) return;

            for (var i = indiceActual + 1; i < ORDEN_CAMPOS_ENTER_PAGO.length; i++) {
                var $siguiente = $(ORDEN_CAMPOS_ENTER_PAGO[i]);
                if ($siguiente.length && $siguiente.is(':visible') && !$siguiente.prop('disabled') && !$siguiente.prop('readonly')) {
                    $siguiente.trigger('focus');
                    if (typeof $siguiente[0].select === 'function') $siguiente[0].select();
                    return;
                }
            }
        }

        $('#SucursalId, #Fecha, #NroRecibo, #FormaPago_, #txtImporte, #Efectivo').on('keydown.pagoEnterTab', function (e) {
            if (e.key !== 'Enter' || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;

            e.preventDefault();
            moverFocoSiguienteCampoPago('#' + this.id);
        });

        // Importe con formato monetario es-AR (pedido 2026-09-21): "." o "," tipeados = coma decimal, y
        // los puntos de miles se ponen solos ("1.234,50"). Lo hace MoneyInputMask, que se carga aca
        // (ver el <script type="text/plain"> de arriba) porque necesita jQuery ya cargado.
        function adjuntarMascaraImporte() {
            var origen = document.getElementById('moneyInputMaskSrc');
            if (!origen) return;

            function adjuntar() {
                if (window.MoneyInputMask) window.MoneyInputMask.attach('#txtImporte');
            }

            if (window.MoneyInputMask) {
                adjuntar();
                return;
            }

            var script = document.createElement('script');
            script.src = origen.getAttribute('src');
            script.onload = adjuntar;
            // Sin mascara el campo sigue siendo un input de texto valido (el server acepta "1234.50"),
            // pero se deja rastro: silenciarlo esconderia por que el importe no se formatea.
            script.onerror = function () { console.error('AddOrEditPago: no se pudo cargar money-input-mask.js'); };
            document.head.appendChild(script);
        }

        adjuntarMascaraImporte();

        // El server (FinanzasController.ParseFloat) espera "1234,50" o "1234.50": con puntos de miles
        // ("1.234,50") leeria mal el valor. getRawValue saca los puntos de miles.
        function importeParaEnviar() {
            return window.MoneyInputMask
                ? window.MoneyInputMask.getRawValue('#txtImporte')
                : ($('#txtImporte').val() || '');
        }

        function parseDecimal(value) {
            var text = String(value == null ? '' : value).trim().replace(/\./g, '').replace(',', '.');
            var n = parseFloat(text.replace(/[^0-9.\-]/g, ''));
            return isNaN(n) ? 0 : n;
        }

        // Boton "Volver" (Batch 10 de la quinta ronda, 2026-09-10, ver docs/DECISIONS.md): en modo
        // POS, cierra #modalPagoPOS en vez de navegar afuera de /Ventas/POS -- mismo criterio que
        // window.volverDesdePago del clasico.
        if (desdePosPago) {
            $('#btnVolverAddOrEditPago').on('click', function (e) {
                e.preventDefault();
                if (window.POSFinanzas && typeof window.POSFinanzas.cerrarModalPago === 'function') {
                    window.POSFinanzas.cerrarModalPago();
                }
            });
        }

        // ===== "Elegí primero Pago/Cobro" (Batch 10 de la quinta ronda, 2026-09-10, ver
        // docs/DECISIONS.md) -- reversion escopeada del recorte anterior. Solo aplica en alta
        // (esNuevoPago); en edicion la operacion ya es conocida, no hay nada que elegir. =====
        function focoEnControlEditable() {
            var el = document.activeElement;
            if (!el) return false;
            var tag = (el.tagName || '').toLowerCase();
            if (tag === 'textarea' || tag === 'select') return true;
            if (tag !== 'input') return false;
            var tipo = (el.type || '').toLowerCase();
            return tipo !== 'button' && tipo !== 'checkbox' && tipo !== 'radio';
        }

        function setOperacionPendiente(pendiente) {
            operacionPendienteSeleccion = !!pendiente;
            $('.pago-requiere-operacion').find('input, select, textarea').prop('disabled', operacionPendienteSeleccion);
        }

        function actualizarBotonesOperacion() {
            var valor = ($('#AProveedor').val() || '').toString();
            // Los colores de cada tarjeta (pago = rojo, cobro = verde) salen del CSS (.pago-op-card);
            // aca solo se marca cual esta elegida.
            $('.pago-operacion-opcion').removeClass('active').attr('aria-pressed', 'false');

            if (valor === '') return;

            $('.pago-operacion-opcion[data-operacion-valor="' + valor + '"]').addClass('active').attr('aria-pressed', 'true');
        }

        function seleccionarOperacion(valor) {
            $('#AProveedor').val(valor).trigger('change');
        }

        if (esNuevoPago) {
            $('#AProveedor').on('change', function () {
                var valor = ($(this).val() || '').toString();
                actualizarBotonesOperacion();

                if (valor === '') {
                    setOperacionPendiente(true);
                    return;
                }

                var estabaPendiente = operacionPendienteSeleccion;
                setOperacionPendiente(false);
                actualizarVisibilidadCheques();

                if (estabaPendiente) {
                    // tras elegir la operacion el foco pasa a la fecha; la sucursal (ya cargada con la del
                    // usuario) queda al final del Tab
                    var $fecha = $('#Fecha:visible:not(:disabled)');
                    if ($fecha.length) $fecha.trigger('focus');
                }
            });

            $(document).on('click', '.pago-operacion-opcion', function (e) {
                e.preventDefault();
                seleccionarOperacion($(this).attr('data-operacion-valor'));
            });

            $(document)
                .off('keydown.posPagoAtajos')
                .on('keydown.posPagoAtajos', function (event) {
                    if (desdePosPago && window.POSGuard && !window.POSGuard.isModalOnTop('#modalPagoPOS')) return;
                    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
                    if (focoEnControlEditable()) return;
                    if (!$('.pago-operacion-elegir').is(':visible')) return;

                    if (event.key === '1') {
                        event.preventDefault();
                        seleccionarOperacion('true');
                    } else if (event.key === '2') {
                        event.preventDefault();
                        seleccionarOperacion('false');
                    }
                });

            $('#btnGuardarPago').on('click', function (e) {
                if (!operacionPendienteSeleccion) return;
                e.preventDefault();
                e.stopImmediatePropagation();
                Swal.fire({ icon: 'warning', title: 'Validación', text: 'Seleccione primero si desea realizar un pago o recibir un cobro.' });
            });

            setOperacionPendiente(true);
            actualizarBotonesOperacion();

            // Reintento (no un solo setTimeout) -- Bootstrap 4/5 no soporta oficialmente modales
            // anidados: cuando esta vista corre embebida en #modalPagoPOS (apilado sobre
            // #modalFinanzasPOS), el enforce-focus del modal de AFUERA le gana a un foco puesto
            // una sola vez apenas se inyecta el HTML, devolviendo el foco al boton "cerrar" poco
            // despues. Mismo patron de reintento que enfocarCampoPagoConReintento del clasico
            // (Web/Views/Finanzas/_AddOrEditPagoScripts.cshtml).
            (function enfocarBotonPagoConReintento(intentos) {
                var $btn = $('.pago-operacion-opcion[data-operacion-valor="true"]');
                if ($btn.length) $btn.trigger('focus');
                if (intentos < 8) {
                    setTimeout(function () { enfocarBotonPagoConReintento(intentos + 1); }, 80);
                }
            })(0);
        }

        // ===== Pago con Cheque/EftvoCheque (2026-09-05, ver docs/DECISIONS.md) =====
        // Port de la logica de _AddOrEditPagoScripts.cshtml (Web clasico), acotada a lo que esta
        // vista simplificada necesita.
        function normalizarFormaPago(valor) {
            return (valor || '').toString().trim().toLowerCase();
        }

        function esFormaCheque(valor) {
            var v = normalizarFormaPago(valor);
            return v === 'cheque' || v === 'eftvocheque';
        }

        function esFormaMixta(valor) {
            return normalizarFormaPago(valor) === 'eftvocheque';
        }

        function tieneChequesAsignados() {
            return $('#tablaCheques tbody tr').length > 0;
        }

        function construirChequesJson() {
            var lista = [];

            $('#tablaCheques tbody tr').each(function () {
                lista.push({
                    Id: $(this).data('id') || 0,
                    NroCheque: ($(this).find('td:eq(0)').text() || '').trim(),
                    Banco: ($(this).find('td:eq(1)').text() || '').trim(),
                    FechaPago: ($(this).find('td:eq(2)').text() || '').trim(),
                    Importe: parseFloat(($(this).find('td:eq(3)').text() || '').replace('$', '').trim()) || 0
                });
            });

            $('#ChequesJson').val(JSON.stringify(lista));
        }

        function actualizarVisibilidadCheques() {
            var esCheque = esFormaCheque($('#FormaPago_').val());
            var esMixto = esFormaMixta($('#FormaPago_').val());

            $('#bloqueCheques').toggle(esCheque);
            $('#txtImporte').prop('readonly', esCheque);
            $('#btnCalculadoraBilletesPagoWrap').toggle(!esCheque);

            if (esCheque && esMixto) {
                $('#bloqueEfectivo').show();
            } else {
                $('#bloqueEfectivo').hide();
                if (esCheque) $('#Efectivo').val('0');
            }

            if (esCheque && window.PagoCheques) {
                window.PagoCheques.recalcularTotales();
            } else if (!esCheque && window.PagoCheques) {
                window.PagoCheques.clearCheques();
            }

            // esta funcion puede correr despues de aplicarModoLectura (init asincrono de PagoCheques)
            if (soloLecturaPago) aplicarModoLectura(true);
        }

        var ultimaFormaPago = $('#FormaPago_').val();

        $('#FormaPago_').on('change', function () {
            var valorNuevo = $(this).val();

            if (!esFormaCheque(valorNuevo) && tieneChequesAsignados()) {
                Swal.fire({ icon: 'warning', title: 'Validación', text: 'Para cambiar la forma de pago primero debe quitar los cheques asignados.' });
                $(this).val(ultimaFormaPago);
                return;
            }

            ultimaFormaPago = valorNuevo;
            actualizarVisibilidadCheques();
        });

        $('#Efectivo').on('input', function () {
            if (window.PagoCheques) window.PagoCheques.recalcularTotales();
        });

        window.PagoChequeSeed = [
            @if (Model.Cheques != null)
            {
                for (int i = 0; i < Model.Cheques.Count; i++)
                {
                    var c = Model.Cheques[i];
                    <text>{ Id: @c.Id, NroCheque: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.NroCheque ?? ""))', Banco: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.Banco ?? ""))', FechaPago: '@c.FechaPago.ToString("yyyy-MM-dd")', Importe: @c.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture) }@(i < Model.Cheques.Count - 1 ? "," : "")</text>
                }
            }
        ];

        function inicializarPagoChequesCuandoListo() {
            if (!window.PagoCheques) {
                window.setTimeout(inicializarPagoChequesCuandoListo, 60);
                return;
            }

            window.PagoCheques.init({
                buscarChequePorNro: '@Url.Action("BuscarChequePorNro", "Finanzas")',
                getCheques: '@Url.Action("GetCheques", "Finanzas")',
                guardarCheque: '@Url.Action("GuardarCheque", "Finanzas")'
            });

            actualizarVisibilidadCheques();
        }

        inicializarPagoChequesCuandoListo();

        $('#btnGuardarPago').on('click', function () {
            if (soloLecturaPago) {
                habilitarEdicionPago();
                return;
            }

            $('#msgErrorPago').addClass('d-none').text('');
            construirChequesJson();

            var payload = {
                Id: idPago,
                Fecha: $('#Fecha').val(),
                FormaPago_: $('#FormaPago_').val(),
                AProveedor: $('#AProveedor').val() === 'true',
                Observaciones: $('#Observaciones').val() || '',
                NroRecibo: $('#NroRecibo').val() || ''
            };

            var params = $.param(payload) +
                '&SucursalId=' + encodeURIComponent($('#SucursalId').val()) +
                '&idPersona=' + encodeURIComponent(idPersona) +
                '&importe=' + encodeURIComponent(importeParaEnviar()) +
                '&Efectivo=' + encodeURIComponent($('#Efectivo').val() || '0') +
                '&ChequesJson=' + encodeURIComponent($('#ChequesJson').val() || '') +
                '&returnUrl=' + encodeURIComponent($('#hddReturnUrl').val() || '') +
                // Faltaba mandar desdePos (Batch 10 de la quinta ronda, 2026-09-10, ver
                // docs/DECISIONS.md) -- sin esto, AddOrEditPagoPost SIEMPRE recibia desdePos=false
                // por default aunque la vista corriera embebida en POS: nunca forzaba la
                // sucursal/caja abierta del vendedor ni devolvia cerrarModalPago=true.
                '&desdePos=' + (desdePosPago ? 'true' : 'false') +
                '&posInstanceId=' + encodeURIComponent(posInstanceIdPago || '');

            var $btn = $(this);
            $btn.prop('disabled', true);

            $.ajax({
                url: urlPost,
                type: 'POST',
                data: params,
                headers: { RequestVerificationToken: tokenAntiForgery() }
            }).done(function (resp) {
                $btn.prop('disabled', false);

                if (!resp || !resp.ok) {
                    $('#msgErrorPago').removeClass('d-none').text((resp && resp.mensaje) || 'No se pudo guardar el pago.');
                    return;
                }

                // Aviso de guardado: se cierra solo a los 2 segundos, o antes con Enter (mismo criterio que
                // "Compra guardada" y el resto de las vistas). Recien despues se cierra el modal / se navega.
                // El boton queda deshabilitado mientras tanto para no guardar dos veces.
                $btn.prop('disabled', true);

                function continuarTrasGuardarPago() {
                    // Modo POS (Batch 10 de la quinta ronda, 2026-09-10, ver docs/DECISIONS.md): antes
                    // navegaba afuera de /Ventas/POS con window.location.href, perdiendo la venta en
                    // curso -- ahora cierra #modalPagoPOS y refresca la Cuenta Corriente ya cargada en
                    // #modalFinanzasPOS (resp.redirectUrl ya trae desdePos=true, heredado del
                    // returnUrl con el que se abrio este formulario).
                    if (resp.cerrarModalPago) {
                        if (window.POSFinanzas && typeof window.POSFinanzas.cerrarModalPago === 'function') {
                            window.POSFinanzas.cerrarModalPago();
                        }
                        if (resp.redirectUrl && window.POSFinanzas && typeof window.POSFinanzas.cargar === 'function') {
                            window.POSFinanzas.cargar(resp.redirectUrl, 'Cuenta corriente');
                        }
                        return;
                    }

                    window.location.href = resp.redirectUrl;
                }

                Swal.fire({
                    icon: 'success',
                    title: esNuevoPago ? 'Pago guardado' : 'Cambios guardados',
                    text: 'El ' + ($('#AProveedor').val() === 'true' ? 'pago' : 'cobro') + ' se registró correctamente.',
                    timer: 2000,
                    timerProgressBar: true,
                    showConfirmButton: true,
                    confirmButtonText: 'Aceptar (Enter)',
                    allowEnterKey: true,
                    focusConfirm: true
                }).then(continuarTrasGuardarPago);
            }).fail(function (xhr) {
                $btn.prop('disabled', false);
                $('#msgErrorPago').removeClass('d-none').text((xhr.responseJSON && xhr.responseJSON.mensaje) || 'No se pudo guardar el pago.');
            });
        });

        // ===== Solo lectura / Modificar / Cancelar / cambio de persona / Eliminar (2026-09-24) =====

        // Controles de datos del formulario. Los que llevan data-pago-fijo (botones de accion, total de
        // cheques) nunca se bloquean ni se habilitan desde aca.
        function controlesDeDatosPago() {
            return $('#addOrEditPagoContainer .card-body')
                .find('input:not([type="hidden"]), select, textarea, button')
                .not('[data-pago-fijo]');
        }

        // Texto y numeros -> readonly (se ven como campo normal, sin editar); select/checkbox/boton -> disabled.
        function aplicarModoLectura(soloLectura) {
            controlesDeDatosPago().each(function () {
                var $el = $(this);
                var esTexto = $el.is('textarea') || $el.is('input:not([type="checkbox"]):not([type="radio"]):not([type="button"])');
                if (esTexto) {
                    $el.prop('readonly', soloLectura);
                } else {
                    $el.prop('disabled', soloLectura);
                }
            });
            $('#addOrEditPagoContainer').toggleClass('pago-solo-lectura', soloLectura);
        }

        function actualizarBotonPrincipalPago() {
            var $btn = $('#btnGuardarPago');
            if (!$btn.length) return;
            $btn.find('#btnGuardarPagoTexto').text(soloLecturaPago ? 'Modificar' : 'Guardar');
            $btn.find('i').attr('class', soloLecturaPago ? 'fas fa-edit mr-1' : 'fas fa-save mr-1');
            $btn.attr('title', (soloLecturaPago ? 'Modificar' : 'Guardar') + ' (Alt+Enter)');
        }

        function habilitarEdicionPago() {
            soloLecturaPago = false;
            aplicarModoLectura(false);
            // #txtImporte vuelve a su estado real (solo lectura si la forma de pago incluye cheques)
            actualizarVisibilidadCheques();
            actualizarBotonPrincipalPago();
            $('#btnCambiarPersonaPago').removeClass('d-none');
            $('#Fecha').trigger('focus');
        }

        // Cancelar (Alt+C): editando un pago existente descarta los cambios recargando el pago; en cualquier
        // otro caso (alta, solo lectura, POS) equivale a "Volver".
        var salidaConfirmadaPago = false;

        // Sale del pago SIN preguntar (ya se confirmo, o no habia nada que perder).
        function salirDelPago() {
            if (!esNuevoPago && !desdePosPago && !soloLecturaPago) {
                window.location.reload();
                return;
            }
            var $volver = $('#btnVolverAddOrEditPago');
            salidaConfirmadaPago = true;
            if (desdePosPago) {
                $volver.trigger('click');
            } else if ($volver.attr('href')) {
                window.location.href = $volver.attr('href');
            }
            salidaConfirmadaPago = false;
        }

        // ¿El usuario toco algo? Se compara con una foto de los campos tomada al terminar de cargar la pantalla.
        var estadoInicialPago = null;
        function fotoDelFormularioPago() {
            var partes = [];
            $('#addOrEditPagoContainer .card-body').find('input:not([type="hidden"]), select, textarea').each(function () {
                partes.push(this.id + '=' + (this.type === 'checkbox' ? this.checked : $(this).val()));
            });
            construirChequesJson();
            return partes.join('|') + '|persona=' + idPersona + '|cheques=' + ($('#ChequesJson').val() || '');
        }
        function formularioPagoModificado() {
            return estadoInicialPago !== null && fotoDelFormularioPago() !== estadoInicialPago;
        }
        // Espera a que terminen de cargar los cheques y la mascara del importe antes de tomar la foto.
        window.setTimeout(function () { estadoInicialPago = fotoDelFormularioPago(); }, 700);

        // Con cambios sin guardar pide confirmacion: Enter = salir y perder los datos, Esc = seguir en el pago.
        function pedirSalidaDelPago() {
            if (!formularioPagoModificado()) {
                salirDelPago();
                return;
            }
            Swal.fire({
                icon: 'warning',
                title: '¿Salir sin guardar?',
                text: 'Hiciste cambios que todavía no se guardaron. Si salís, se perderán los datos ingresados.',
                showCancelButton: true,
                confirmButtonText: 'Salir y perder los datos (Enter)',
                cancelButtonText: 'Seguir en el pago (Esc)',
                confirmButtonColor: '#d33',
                reverseButtons: true,
                focusConfirm: true,
                allowEnterKey: true,
                allowEscapeKey: true
            }).then(function (resultado) {
                if (resultado.isConfirmed) salirDelPago();
            });
        }

        $('#btnCancelarPago').on('click', function (e) {
            e.preventDefault();
            pedirSalidaDelPago();
        });

        // Esc = Cancelar. Y la flecha "volver" del encabezado tambien avisa si hay cambios. Van en captura sobre
        // document para adelantarse a los handlers propios del POS; se guardan en window para no duplicarlos si la
        // pantalla se vuelve a cargar por AJAX dentro del modal.
        if (window.__pagoAtajosSalida) {
            document.removeEventListener('keydown', window.__pagoAtajosSalida.teclado, true);
            document.removeEventListener('click', window.__pagoAtajosSalida.clic, true);
        }
        window.__pagoAtajosSalida = {
            teclado: function (e) {
                if (e.key !== 'Escape') return;
                if (!document.getElementById('addOrEditPagoContainer')) return;
                if (window.Swal && typeof window.Swal.isVisible === 'function' && window.Swal.isVisible()) return;

                // solo si el pago es lo de arriba: con otro modal abierto (buscar cheques, persona, email) Esc es de ese modal
                var $arriba = $('.modal.show:visible').last();
                if ($arriba.length && $arriba.attr('id') !== 'modalPagoPOS') return;

                e.preventDefault();
                e.stopPropagation();
                pedirSalidaDelPago();
            },
            clic: function (e) {
                if (salidaConfirmadaPago || !e.target.closest || !e.target.closest('#btnVolverAddOrEditPago')) return;
                if (!formularioPagoModificado()) return;
                e.preventDefault();
                e.stopImmediatePropagation();
                pedirSalidaDelPago();
            }
        };
        document.addEventListener('keydown', window.__pagoAtajosSalida.teclado, true);
        document.addEventListener('click', window.__pagoAtajosSalida.clic, true);

        // Observaciones: el interruptor despliega/pliega el area de texto. Con texto cargado no se puede
        // plegar (quedaria oculto algo que se va a guardar).
        $('#chkObservaciones').on('change', function () {
            var $area = $('#Observaciones');
            if (!this.checked && ($area.val() || '').trim() !== '') {
                this.checked = true;
                return;
            }
            $('#bloqueObservaciones').toggleClass('d-none', !this.checked);
            if (this.checked) $area.trigger('focus');
        });

        // La calculadora de billetes escribe el detalle del conteo en #Observaciones por JS: si el area estaba
        // plegada, se despliega para que se vea lo que se va a guardar.
        $('#Observaciones').on('input', function () {
            if (($(this).val() || '').trim() === '' || !$('#bloqueObservaciones').hasClass('d-none')) return;
            $('#chkObservaciones').prop('checked', true);
            $('#bloqueObservaciones').removeClass('d-none');
        });

        // Advertencia "fecha distinta al dia de carga": en vivo al cambiar la fecha.
        function actualizarAlertaFechaDistinta() {
            var $alerta = $('#alertFechaDistinta');
            if (!$alerta.length) return;
            var fechaPago = String($('#Fecha').val() || '').substring(0, 10);
            var fechaCarga = $alerta.attr('data-fecha-carga') || '';
            var distinta = fechaPago !== '' && fechaCarga !== '' && fechaPago !== fechaCarga;
            $alerta.toggleClass('d-none', !distinta).css('display', distinta ? '' : 'none');
        }
        $('#Fecha').on('input change', actualizarAlertaFechaDistinta);

        // ----- Cambiar persona -----
        function cargarPersonasPago() {
            var filtro = ($('#filtroPersonaPago').val() || '').trim();
            $.getJSON(urlListarPersonasPago, { filtro: filtro }).done(function (lista) {
                var $tbody = $('#tablaPersonasPago').empty();
                (lista || []).forEach(function (persona) {
                    // .text() y no un template HTML: la razon social viene de la base y no se confia en ella
                    var $fila = $('<tr style="cursor:pointer;"></tr>')
                        .attr('data-id', persona.idPersona)
                        .data('razon', persona.razonSocial)
                        .append($('<td></td>').text(persona.cuit || ''))
                        .append($('<td></td>').text(persona.razonSocial || ''))
                        .append($('<td></td>').text(persona.identificacion || ''));
                    $tbody.append($fila);
                });
                $tbody.find('tr').first().addClass('table-active');
            }).fail(function () {
                Swal.fire({ icon: 'error', title: 'No se pudo buscar', text: 'Error de conexión al buscar personas.' });
            });
        }

        function seleccionarPersonaPago(id, razonSocial) {
            idPersona = parseInt(id, 10);
            $('#hddIdPersona').val(idPersona);
            $('#lblPersonaPago').text(razonSocial);
            var cambio = idPersona !== idPersonaOriginal;
            $('#avisoCambioPersonaPago')
                .toggleClass('d-none', !cambio)
                .text(cambio ? 'Se reasignará de ' + nombrePersonaOriginal + ' a ' + razonSocial + ' al guardar' : '');
            // el saldo mostrado es el de la persona original: al cambiar deja de ser el de esta operacion
            $('#saldoPersonaPagoWrap').toggleClass('d-none', cambio);
            $('#modalCambiarPersonaPago').modal('hide');
        }

        var temporizadorFiltroPersonaPago = null;
        $('#btnCambiarPersonaPago').on('click', function () {
            $('#filtroPersonaPago').val('');
            $('#tablaPersonasPago').empty();
            $('#modalCambiarPersonaPago').modal('show');
            cargarPersonasPago();
        });
        $('#modalCambiarPersonaPago').on('shown.bs.modal', function () { $('#filtroPersonaPago').trigger('focus'); });
        $('#filtroPersonaPago').on('input', function () {
            window.clearTimeout(temporizadorFiltroPersonaPago);
            temporizadorFiltroPersonaPago = window.setTimeout(cargarPersonasPago, 250);
        });
        $('#filtroPersonaPago').on('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            var $primera = $('#tablaPersonasPago tr').first();
            if ($primera.length) seleccionarPersonaPago($primera.attr('data-id'), $primera.data('razon'));
        });
        $('#tablaPersonasPago').on('click', 'tr', function () {
            seleccionarPersonaPago($(this).attr('data-id'), $(this).data('razon'));
        });

        // ----- Eliminar (asiento opuesto, queda visible como ELIMINADO) -----
        $('#btnEliminarPago').on('click', function () {
            Swal.fire({
                icon: 'warning',
                title: 'Eliminar pago o cobro',
                html: 'Se genera el asiento opuesto en la cuenta corriente y el registro queda visible como <b>ELIMINADO</b>. No se puede deshacer.',
                input: 'textarea',
                inputPlaceholder: 'Motivo de la eliminación (obligatorio)',
                inputAttributes: { maxlength: '300' },
                inputValidator: function (valor) { return (valor || '').trim() ? null : 'El motivo es obligatorio.'; },
                showCancelButton: true,
                confirmButtonText: 'Eliminar',
                confirmButtonColor: '#d33',
                cancelButtonText: 'Cancelar'
            }).then(function (resultado) {
                if (!resultado.isConfirmed) return;

                $.ajax({
                    url: urlEliminarPago,
                    type: 'POST',
                    data: { id: idPago, motivo: resultado.value },
                    headers: { RequestVerificationToken: tokenAntiForgery() }
                }).done(function (resp) {
                    if (!resp || !resp.ok) {
                        Swal.fire({ icon: 'error', title: 'No se pudo eliminar', text: (resp && resp.mensaje) || 'Error desconocido.' });
                        return;
                    }
                    Swal.fire({ icon: 'success', title: 'Eliminado', timer: 1400, showConfirmButton: false }).then(function () {
                        window.location.href = $('#hddReturnUrl').val() || resp.redirectUrl;
                    });
                }).fail(function (xhr) {
                    Swal.fire({ icon: 'error', title: 'No se pudo eliminar', text: (xhr.responseJSON && xhr.responseJSON.mensaje) || 'Error de conexión.' });
                });
            });
        });

        // Estado inicial
        if (soloLecturaPago || pagoEliminadoVista) aplicarModoLectura(true);
        actualizarBotonPrincipalPago();
        actualizarAlertaFechaDistinta();

        $('#btnEmailPago').on('click', function () {
            $('#pagoEmailError').addClass('d-none').text('');

            $.getJSON(emailConfigUrl, { id: idPago }).done(function (resp) {
                if (!resp || !resp.ok) {
                    Swal.fire({ icon: 'error', title: 'No se pudo preparar el email', text: (resp && resp.msg) || 'Error desconocido.' });
                    return;
                }

                $('#pagoEmailDestino').val(resp.email || '');
                $('#pagoEmailAsunto').val(resp.asunto || '');
                $('#pagoEmailMensaje').val(resp.mensaje || '');
                $('#modalEmailPago').modal('show');
            }).fail(function () {
                Swal.fire({ icon: 'error', title: 'No se pudo preparar el email', text: 'Error de conexión.' });
            });
        });

        $('#btnConfirmarEmailPago').on('click', function () {
            var email = ($('#pagoEmailDestino').val() || '').trim();
            var asunto = ($('#pagoEmailAsunto').val() || '').trim();
            var mensaje = ($('#pagoEmailMensaje').val() || '').trim();

            if (!email) {
                $('#pagoEmailError').removeClass('d-none').text('Ingrese un email destino.');
                return;
            }

            var $btn = $(this);
            $btn.prop('disabled', true);

            $.post(emailSendUrl, { idPago: idPago, emailDestino: email, asunto: asunto, mensaje: mensaje })
                .done(function (resp) {
                    $btn.prop('disabled', false);

                    if (!resp || !resp.ok) {
                        $('#pagoEmailError').removeClass('d-none').text((resp && resp.msg) || 'No se pudo enviar el email.');
                        return;
                    }

                    $('#modalEmailPago').modal('hide');
                    Swal.fire({ icon: 'success', title: 'Email enviado', text: 'El recibo se envió correctamente.' });
                }).fail(function (xhr) {
                    $btn.prop('disabled', false);
                    $('#pagoEmailError').removeClass('d-none').text((xhr.responseJSON && xhr.responseJSON.msg) || 'No se pudo enviar el email.');
                });
        });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", inicializarAddOrEditPago);
        } else {
            inicializarAddOrEditPago();
        }
    })();
</script>

<style>
    /* Pantalla completa (fuera de POS): mismo ancho que el modal de pagos del POS (modal-lg, 800px) y centrada. */
    #addOrEditPagoContainer.pago-form-pagina { max-width: 760px !important; margin-left: auto; margin-right: auto; }
    /* El layout usa Bootstrap 5: las utilidades de margen de Bootstrap 4 (mr-1, ml-2) no existen y los iconos de los botones
       y del encabezado quedaban pegados al texto. Se definen aca, solo para esta pantalla. */
    #addOrEditPagoContainer .mr-1 { margin-right: .35rem; }
    #addOrEditPagoContainer .mr-2 { margin-right: .5rem; }
    #addOrEditPagoContainer .ml-2 { margin-left: .5rem; }
    #addOrEditPagoContainer .mr-auto { margin-right: auto; }
    /* Encabezado y tarjeta mas juntos: menos aire entre bloques para no recorrer la pantalla con la vista */
    .pago-form-pagina .alert { margin-bottom: .75rem; }
    .pago-form-pagina .card-body { padding: 1rem 1.15rem; }
    .pago-form-pagina .form-row { margin-left: -.4rem; margin-right: -.4rem; }
    .pago-form-pagina .form-row > [class*="col-"] { padding-left: .4rem; padding-right: .4rem; }
    /* Tamaño de letra y controles como en el modal de pagos del POS: en el layout completo el tamaño base es mas
       grande y la pantalla se veia "inflada". Con el id para ganarle a los estilos del tema. */
    #addOrEditPagoContainer.pago-form-pagina { font-size: .82rem; }
    #addOrEditPagoContainer.pago-form-pagina h5 { font-size: 1rem; }
    #addOrEditPagoContainer.pago-form-pagina label { font-size: .76rem; margin-bottom: .15rem; }
    #addOrEditPagoContainer.pago-form-pagina .form-control,
    #addOrEditPagoContainer.pago-form-pagina .form-select {
        font-size: .82rem;
        padding: .28rem .55rem;
        height: calc(1.5em + .56rem);
        min-height: 0;
        border-radius: .3rem;
    }
    #addOrEditPagoContainer.pago-form-pagina textarea.form-control { height: auto; }
    #addOrEditPagoContainer.pago-form-pagina .btn { font-size: .82rem; padding: .32rem .75rem; }
    #addOrEditPagoContainer.pago-form-pagina .btn-sm { font-size: .76rem; padding: .2rem .5rem; }
    /* La sucursal esta al final del DOM (el Tab llega ultimo) pero se ve arriba de todo: la tarjeta es una columna
       flex y esa fila lleva order:-1. */
    #addOrEditPagoContainer .card-body { display: flex; flex-direction: column; }
    #addOrEditPagoContainer .pago-sucursal-fila { order: -1; }

    /* Tarjetas "Realizar un pago" / "Recibir un cobro" */
    #addOrEditPagoContainer .pago-op-card {
        --pago-op-color: #6c757d; --pago-op-suave: #f1f3f5;
        display: flex; align-items: center; gap: .7rem; text-align: left;
        padding: .6rem .85rem; cursor: pointer;
        border: 2px solid var(--pago-op-color); border-radius: .75rem;
        background: var(--bs-body-bg, #fff); color: inherit;
        transition: background-color .15s, box-shadow .15s, transform .1s;
    }
    #addOrEditPagoContainer .pago-op-pago { --pago-op-color: #dc3545; --pago-op-suave: #fdecee; }
    #addOrEditPagoContainer .pago-op-cobro { --pago-op-color: #198754; --pago-op-suave: #e7f5ee; }
    #addOrEditPagoContainer .pago-op-icono {
        flex: none; width: 2.1rem; height: 2.1rem; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--pago-op-suave); color: var(--pago-op-color);
    }
    #addOrEditPagoContainer .pago-op-texto { display: flex; flex-direction: column; line-height: 1.2; }
    #addOrEditPagoContainer .pago-op-titulo { font-weight: 700; font-size: .95rem; color: var(--pago-op-color); }
    #addOrEditPagoContainer .pago-op-sub { color: #6c757d; font-size: .72rem; }
    #addOrEditPagoContainer .pago-op-card kbd {
        background: #fff; color: #495057; border: 1px solid #ced4da; border-bottom-width: 2px;
        border-radius: .3rem; padding: 0 .3rem; font-size: .7rem; box-shadow: none;
    }
    #addOrEditPagoContainer .pago-op-card:hover,
    #addOrEditPagoContainer .pago-op-card:focus-visible { background: var(--pago-op-suave); box-shadow: 0 .2rem .55rem rgba(0,0,0,.12); outline: none; }
    #addOrEditPagoContainer .pago-op-card:active { transform: scale(.985); }
    #addOrEditPagoContainer .pago-op-card.active { background: var(--pago-op-color); box-shadow: 0 .25rem .65rem rgba(0,0,0,.2); }
    #addOrEditPagoContainer .pago-op-card.active .pago-op-titulo,
    #addOrEditPagoContainer .pago-op-card.active .pago-op-sub { color: #fff; }
    #addOrEditPagoContainer .pago-op-card.active .pago-op-icono { background: rgba(255,255,255,.22); color: #fff; }

    /* Atajo escrito dentro del boton */
    #addOrEditPagoContainer .pago-atajo { margin-left: .4rem; opacity: .75; font-size: .68rem; font-weight: 500; }

    /* Botones de accion juntos y alineados a la derecha, bajo el ultimo campo */
    .pago-form-pagina #btnGuardarPago { min-width: 8.5rem; }
    .pago-form-compact label {
        font-size: .82rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .2rem;
    }

    /* Pago en solo lectura: Bootstrap pinta los campos deshabilitados/readonly en gris claro. Aca se
       muestran con texto oscuro y en negrita para que se lea bien; solo cambia el fondo levemente. */
    #addOrEditPagoContainer.pago-solo-lectura .form-control[readonly],
    #addOrEditPagoContainer.pago-solo-lectura .form-control:disabled,
    #addOrEditPagoContainer.pago-solo-lectura select:disabled,
    #addOrEditPagoContainer.pago-solo-lectura textarea[readonly] {
        background-color: #f4f6fb;
        color: #212529;
        -webkit-text-fill-color: #212529;
        font-weight: 600;
        opacity: 1;
        border-color: #cfd6e4;
    }
    #addOrEditPagoContainer.pago-solo-lectura .custom-control-input:disabled ~ .custom-control-label {
        color: #212529;
        font-weight: 600;
    }
    /* en solo lectura no se pueden quitar cheques ni agregar otros */
    #addOrEditPagoContainer.pago-solo-lectura #tablaCheques .btn { display: none; }
</style>
