@model System.Data.DataTable
@using System.Collections.Generic
@*
    Port simplificado de Web/Views/Finanzas/CtaCtePersona.cshtml (1201 lineas en el original) --
    ver docs/10-migracion-aspnet-core/README.md. Se excluyen: el modo "desdePos" (embebido en POS,
    no portado), los atajos de teclado, y el ordenamiento de columnas por click (JS propio del
    original, no critico). El click en una fila navega a Ventas/DetalleVenta si es una Venta, o
    a Finanzas/AddOrEditPago si es un Pago no historico (ambos ya portados, ver
    docs/10-migracion-aspnet-core/PLAN-ADDOREDITPAGO.md) -- las demas filas no son clickeables.
    Boton "Agregar Pago / Cobro" agregado junto con AddOrEditPago (mismo plan).
*@
@{
    bool renderSinLayout = ViewBag.RenderSinLayout != null && (bool)ViewBag.RenderSinLayout;
    bool mostrarAnulados = ViewBag.MostrarAnulados != null && (bool)ViewBag.MostrarAnulados;
    bool ocultarSaldo = ViewBag.OcultarSaldo != null && (bool)ViewBag.OcultarSaldo;
    bool puedeExportarCuentaCorriente = ViewBag.PuedeExportarCuentaCorriente != null && (bool)ViewBag.PuedeExportarCuentaCorriente;
    bool desdePos = ViewBag.DesdePOS != null && (bool)ViewBag.DesdePOS;

    ViewBag.Title = "Cuenta Corriente";

    var personaObj = ViewBag.Persona as Entidades.Persona;
    string persona = personaObj != null ? (personaObj.RazonSocial ?? "") : "";
    decimal saldo = ViewBag.SaldoPersona;
    string fechaDesde = ViewBag.FechaDesde ?? "";
    string fechaMinimaPermitidaCtaCte = ViewBag.FechaMinimaPermitidaCtaCte as string ?? "";
    string mensajeFechaRecortadaPorPermiso = ViewBag.MensajeFechaRecortadaPorPermiso as string ?? "";
    string returnUrlCtaCte = ViewBag.ReturnUrlCtaCte as string ?? "";
    string posInstanceIdCtaCte = ViewBag.PosInstanceId as string ?? "";
    bool mostrarBotonVolver = !renderSinLayout;
    string hrefBotonVolver = !string.IsNullOrWhiteSpace(returnUrlCtaCte)
        ? returnUrlCtaCte
        : Url.Action("CtasCtes", "Finanzas");

    Func<System.Data.DataRow, string> claveMovimiento = row =>
        string.Join("|",
            Convert.ToString(row["Tabla"]),
            Convert.ToString(row["IdTabla"]),
            Convert.ToString(row["Sucursal"]));

    var ultimoIdPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var cantidadPorClave = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    bool tieneColumnaNroDoc = Model != null && Model.Columns.Contains("NroDoc");

    foreach (System.Data.DataRow row in Model.Rows)
    {
        string clave = claveMovimiento(row);
        int id = Convert.ToInt32(row["ID"]);

        if (!ultimoIdPorClave.ContainsKey(clave) || id > ultimoIdPorClave[clave])
            ultimoIdPorClave[clave] = id;

        cantidadPorClave[clave] = cantidadPorClave.ContainsKey(clave) ? cantidadPorClave[clave] + 1 : 1;
    }
}

<div id="ctactePersonaContainer" class="container-fluid px-2 px-md-3 ctacte-page ctacte-form-compact">
    <div class="alert alert-primary d-flex justify-content-between align-items-center ctacte-header-box">
        <div class="d-flex align-items-center">
            @if (mostrarBotonVolver)
            {
                <a href="@hrefBotonVolver" class="btn btn-sm btn-outline-secondary mr-2" id="btnVolverCtasCtesPersona">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h5 class="mb-0"><strong>@persona</strong></h5>
        </div>
        <div>
            @if (!ocultarSaldo)
            {
                <h5 class="mb-0">
                    Saldo:
                    @if (saldo >= 0)
                    {
                        <span class="text-success font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-danger font-weight-bold">$ @saldo.ToString("N2")</span>
                    }
                </h5>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeFechaRecortadaPorPermiso))
    {
        <div class="alert alert-warning py-2 mb-3" role="alert">
            <i class="fas fa-exclamation-triangle mr-1"></i> @mensajeFechaRecortadaPorPermiso
        </div>
    }

    <div class="card shadow-sm mb-3 ctacte-panel-card">
        <div class="card-body">
            <form method="get" action="@Url.Action("CtaCtePersona", "Finanzas")" id="frmFiltroCtaCte">
                <input type="hidden" name="idPersona" value="@ViewBag.IdPersona" />
                <input type="hidden" name="returnUrl" value="@returnUrlCtaCte" />
                <input type="hidden" name="desdePos" value="@(desdePos ? "true" : "false")" />
                <input type="hidden" name="posInstanceId" value="@posInstanceIdCtaCte" />

                <div class="d-flex flex-wrap justify-content-between align-items-center ctacte-toolbar-row">
                    <div class="d-flex align-items-center flex-wrap ctacte-filtros-group">
                        <div class="input-group ctacte-fecha-group mb-2 mb-md-0">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Desde</span>
                            </div>
                            <input type="date" name="fechaDesde" value="@fechaDesde" class="form-control" id="ctacteFechaDesde"
                                   min="@fechaMinimaPermitidaCtaCte" />
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit" id="btnFiltrarCtaCte">
                                    <i class="fas fa-filter"></i> Filtrar
                                </button>
                            </div>
                        </div>

                        <div class="custom-control custom-switch ctacte-anulados-switch mb-2 mb-md-0">
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="chkMostrarAnulados"
                                   name="mostrarAnulados"
                                   value="true"
                                   onchange="this.form.requestSubmit();"
                                   @(mostrarAnulados ? "checked" : "") />
                            <label class="custom-control-label" for="chkMostrarAnulados">Mostrar anulados</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center ctacte-acciones-row">
                        @* Boton "Agregar Pago / Cobro" (Batch 10 de la quinta ronda, 2026-09-10,
                           ver docs/DECISIONS.md) -- SIN condicionar a puedeExportarCuentaCorriente
                           (antes vivia adentro de ese mismo @if, acoplado sin necesidad a un
                           permiso de exportacion de PDF/Excel que no tiene nada que ver con poder
                           cargar un pago -- mismo criterio que el clasico, Web/Views/Finanzas/
                           CtaCtePersona.cshtml:153-161, boton incondicional, exportar aparte).
                           data-pos-ajax/data-pos-title: para que, si esta vista corre embebida en
                           POS, el interceptor de POSFinanzas la abra en #modalPagoPOS en vez de
                           navegar afuera. *@
                        @* Bug real preexistente encontrado verificando el Batch 10 (2026-09-10, ver
                           docs/DECISIONS.md): Uri.EscapeDataString(...) ya escapa el valor UNA vez, y
                           Url.Action lo vuelve a escapar al armar el href -- returnUrl llegaba doble
                           percent-encoded al controller, DecodeReturnUrlIfNeeded (que solo sabe
                           revertir Base64 o aceptar un string YA crudo con "/") lo dejaba intacto y
                           garabateado, rompiendo la navegacion de "Volver"/redirect tras guardar.
                           Fix: pasar el valor CRUDO (sin escapar a mano) -- Url.Action lo escapa una
                           sola vez, mismo patron ya usado en VentasController/_TablaVentas.cshtml
                           (Batch 4 de esta misma ronda). *@
                        <a href="@Url.Action("AddOrEditPago", "Finanzas", new { idPersona = ViewBag.IdPersona, returnUrl = Context.Request.Path + Context.Request.QueryString, desdePos, posInstanceId = posInstanceIdCtaCte })"
                           class="btn btn-success mr-2"
                           id="btnAgregarPagoCtaCte"
                           data-pos-ajax="@(desdePos ? "true" : "false")"
                           data-pos-title="Pago / Cobro">
                            <i class="fas fa-hand-holding-usd"></i> Agregar Pago / Cobro
                        </a>
                        @if (puedeExportarCuentaCorriente)
                        {
                            <a href="@Url.Action("ExportarPdfPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde, mostrarAnulados })"
                               class="btn btn-outline-danger mr-2">
                                <i class="fas fa-file-pdf"></i> PDF
                            </a>
                            <a href="@Url.Action("ExportarExcelPersona", "Finanzas", new { idPersona = ViewBag.IdPersona, fechaDesde, mostrarAnulados })"
                               class="btn btn-outline-success mr-2">
                                <i class="fas fa-file-excel"></i> Excel
                            </a>
                            <button type="button" class="btn btn-outline-primary ctacte-btn-mail" id="btnEnviarMailCtaCte">
                                <i class="fas fa-envelope"></i> Enviar por mail
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm ctacte-panel-card">
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm ctacte-table-compact" id="tablaPersona" width="100%" cellspacing="0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="display:none;">ID</th>
                            <th>Fecha</th>
                            <th>Operación</th>
                            <th>Tipo</th>
                            <th>Nro.Doc</th>
                            <th>Detalle</th>
                            <th style="text-align:right;">Importe</th>
                            <th style="text-align:right;">Saldo</th>
                            <th>Sucursal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No hay movimientos para mostrar.</td>
                            </tr>
                        }
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            string clave = claveMovimiento(row);
                            int id = Convert.ToInt32(row["ID"]);
                            decimal importeFila = Convert.ToDecimal(row["Importe"]);
                            bool importePositivo = importeFila >= 0;
                            string claseColorOperacion = importePositivo ? "ctacte-color-positivo" : "ctacte-color-negativo";
                            string tipoImporte = importePositivo ? "Crédito" : "Débito";
                            bool tieneMasVersiones = cantidadPorClave.ContainsKey(clave) && cantidadPorClave[clave] > 1;
                            bool esVersionActual = ultimoIdPorClave.ContainsKey(clave) && ultimoIdPorClave[clave] == id;
                            bool esHistorico = tieneMasVersiones && !esVersionActual;
                            bool esPago = string.Equals(Convert.ToString(row["Tabla"]), "Pagos", StringComparison.OrdinalIgnoreCase);
                            bool mostrarAdvertenciaAdmin = tieneMasVersiones && !esPago;
                            string tablaMovimiento = Convert.ToString(row["Tabla"]);
                            int idTablaMovimiento = 0;
                            bool esVenta = string.Equals(tablaMovimiento, "Ventas", StringComparison.OrdinalIgnoreCase)
                                && int.TryParse(Convert.ToString(row["IdTabla"]), out idTablaMovimiento)
                                && idTablaMovimiento > 0;

                            int idTablaPago = 0;
                            int.TryParse(Convert.ToString(row["IdTabla"]), out idTablaPago);
                            bool esPagoEditable = esPago && !esHistorico && idTablaPago > 0;

                            // Compra (2026-09-19): IdTabla es el id de la compra (row["ID"] es el del movimiento
                            // de cta. cte.). Se abre en un modal (Compras/Editar?origen=modal), sin logica de caja.
                            int idTablaCompra = 0;
                            bool esCompraEditable = string.Equals(tablaMovimiento, "Compras", StringComparison.OrdinalIgnoreCase)
                                && !esHistorico
                                && int.TryParse(Convert.ToString(row["IdTabla"]), out idTablaCompra)
                                && idTablaCompra > 0;

                            <tr class="js-fila-ctacte @(esHistorico ? "ctacte-row-historico" : "") @(mostrarAdvertenciaAdmin ? "ctacte-row-modificado" : "") @(!esVenta && !esPagoEditable && !esCompraEditable ? "ctacte-row-sin-operacion" : "")"
                                data-es-venta="@(esVenta ? "true" : "false")"
                                data-id-venta="@idTablaMovimiento"
                                data-es-pago="@(esPagoEditable ? "true" : "false")"
                                data-id-pago="@(esPagoEditable ? idTablaPago : 0)"
                                data-es-compra="@(esCompraEditable ? "true" : "false")"
                                data-id-compra="@(esCompraEditable ? idTablaCompra : 0)"
                                style="cursor:@((esVenta || esPagoEditable || esCompraEditable) ? "pointer" : "default");">
                                <td style="display:none;">@row["ID"]</td>
                                <td>@Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy")</td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">
                                    @row["Tabla"]
                                    @if (esHistorico)
                                    {
                                        <span class="badge badge-secondary ml-1">Versión anterior</span>
                                    }
                                    else if (mostrarAdvertenciaAdmin)
                                    {
                                        <span class="badge badge-warning ml-1">Modificado</span>
                                    }
                                </td>
                                <td class="@claseColorOperacion" style="font-weight:bold;">@tipoImporte</td>
                                <td>@(tieneColumnaNroDoc ? Convert.ToString(row["NroDoc"]) : "")</td>
                                <td>
                                    [ID: @row["IdTabla"]] @row["Detalle"]
                                    @if (esHistorico && esPago)
                                    {
                                        <div class="small text-muted mt-1">Registro anterior anulado por modificación.</div>
                                    }
                                    else if (!esHistorico && mostrarAdvertenciaAdmin)
                                    {
                                        <div class="small text-warning mt-1">Verificar cambios del registro original.</div>
                                    }
                                </td>
                                <td class="@claseColorOperacion" style="text-align:right; font-weight:bold;">@importeFila.ToString("N2")</td>
                                <td style="text-align:right;">@(ocultarSaldo ? "***" : Convert.ToDecimal(row["Saldo"]).ToString("N2"))</td>
                                <td>@row["Sucursal"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Modal para ver/editar una Compra desde su fila (Compras/Editar?origen=modal, ver script de abajo).
   Su id lo usa compras.js (hostModalSelector) para cerrarlo al guardar. *@
<div class="modal fade" id="modalCompraCtaCte" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-file-invoice-dollar mr-2"></i>Compra</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-2" id="contenedorCompraCtaCte" style="background:#f4f7fb;">
                <div class="p-4 text-center text-muted">Cargando...</div>
            </div>
        </div>
    </div>
</div>

@if (puedeExportarCuentaCorriente)
{
    <div class="modal fade" id="modalEmailCtaCte" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Enviar cuenta corriente por mail</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="ccEmailFormato">Adjuntar como</label>
                        <select class="form-control" id="ccEmailFormato">
                            <option value="pdf">PDF</option>
                            <option value="excel">Excel</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ccEmailDestino">Email destino</label>
                        <input type="email" class="form-control" id="ccEmailDestino" maxlength="200" placeholder="cliente@dominio.com">
                    </div>
                    <div class="form-group">
                        <label for="ccEmailAsunto">Asunto</label>
                        <input type="text" class="form-control" id="ccEmailAsunto" maxlength="200">
                    </div>
                    <div class="form-group mb-2">
                        <label for="ccEmailMensaje">Mensaje</label>
                        <textarea class="form-control" id="ccEmailMensaje" rows="6"></textarea>
                    </div>
                    <div class="alert alert-danger d-none mb-0" id="ccEmailError"></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" type="button" id="btnConfirmarEmailCtaCte">
                        <i class="fas fa-paper-plane mr-1"></i> Enviar mail
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .ctacte-page { font-size: .84rem; }
    .ctacte-page .ctacte-panel-card { border: 1px solid #e9ecef; border-radius: .75rem; }
    .ctacte-page .ctacte-panel-card .card-body { padding: .8rem .92rem; }
    .ctacte-page .ctacte-header-box { padding: .62rem .82rem; margin-bottom: .85rem; border-radius: .75rem; }
    .ctacte-page .ctacte-filtros-group { gap: .5rem; }
    /* Bug real encontrado 2026-09-17: con la fuente mas grande de antes (.9rem) y este ancho
       (286px), el input type="date" quedaba sin espacio para mostrar el valor completo dentro
       del input-group (comparte lugar con el prepend "Desde" y el boton "Filtrar"). Bajamos la
       fuente de la pagina a .84rem (mismo criterio que los filtros de Compras/Index.cshtml) y
       ensanchamos el grupo para que el dd/mm/aaaa entre siempre, incluso con distinto locale. */
    .ctacte-page .ctacte-fecha-group { max-width: 320px; }
    .ctacte-page .ctacte-btn-mail { color: #007bff; border-color: #007bff; }
    .ctacte-page .ctacte-btn-mail:hover, .ctacte-page .ctacte-btn-mail:focus { color: #fff; background-color: #007bff; border-color: #007bff; }
    .ctacte-page .ctacte-table-compact { font-size: .82rem; }
    #tablaPersona .ctacte-color-positivo { color: green; }
    #tablaPersona .ctacte-color-negativo { color: red; }
    #tablaPersona td, #tablaPersona th { white-space: nowrap; }
    #modalCompraCtaCte .modal-dialog { max-width: 1320px; width: calc(100% - 1.25rem); }
    .ctacte-row-historico { opacity: .7; }
    .ctacte-row-modificado { background-color: #fff8e1; }
</style>

<script>
    (function () {
        var idPersona = @ViewBag.IdPersona;
        var fechaDesde = '@fechaDesde';
        var desdePosCtaCte = @Html.Raw(desdePos ? "true" : "false");
        var posInstanceIdCtaCte = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(posInstanceIdCtaCte));

        // Alt+Enter = abrir "nuevo pago" (Batch 5, 2026-09-11, ver docs/DECISIONS.md, pedido
        // explicito del usuario). Scopeado al modal visible mas arriba (mismo criterio que
        // Scripts/app/edit-page-guard.js/form-hotkeys.js): si #modalPagoPOS ya esta abierto
        // encima de esta vista, el boton de abajo no es el destino correcto -- se deja pasar el
        // Alt+Enter para que lo maneje el formulario de pago (form-hotkeys.js en AddOrEditPago).
        document.addEventListener('keydown', function (e) {
            if (!e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || e.repeat) return;
            if ((e.key || '').toLowerCase() !== 'enter') return;
            if (window.Swal && typeof window.Swal.isVisible === 'function' && window.Swal.isVisible()) return;

            var $btn = $('#btnAgregarPagoCtaCte');
            if (!$btn.length || !$btn.is(':visible')) return;

            var $topModal = $('.modal.show:visible').last();
            if ($topModal.length && !$.contains($topModal[0], $btn[0]) && !$btn.is($topModal)) return;

            e.preventDefault();
            $btn.trigger('click');
        }, true);
        var puedeExportarCuentaCorriente = @Html.Raw(puedeExportarCuentaCorriente ? "true" : "false");
        var emailConfigUrl = '@Url.Action("ObtenerDatosEmailCuentaCorriente", "Finanzas")';
        var emailSendUrl = '@Url.Action("EnviarCuentaCorrienteEmail", "Finanzas")';

        // Bug real reportado 2026-09-12 (ver docs/DECISIONS.md "Batch 4b"): el filtro de fecha /
        // "Mostrar anulados" es un <form method="get"> plano, sin desdePos en el submit -- al
        // presionar "Filtrar" (o tildar el checkbox, que ahora usa requestSubmit() en vez de
        // submit() para que este handler SI se dispare) hacia una navegacion GET real de pagina
        // completa: con #modalFinanzasPOS abierto, disparaba el beforeunload de pos-cart.js, y
        // ademas -- al no viajar desdePos=true -- el controller devolvia la vista COMPLETA con
        // Layout en vez del parcial embebido, sacando al usuario de POS en vez de "filtrar
        // adentro". Fix: interceptar el submit y recargar DENTRO de #modalFinanzasPOS con el
        // mismo mecanismo que ya usa abrirCtaCtePersona (POS.cshtml:1655-1663). Fuera de POS
        // (desdePosCtaCte false), el form sigue navegando normal, sin cambios.
        var frmFiltroCtaCte = document.getElementById('frmFiltroCtaCte');
        if (frmFiltroCtaCte) {
            frmFiltroCtaCte.addEventListener('submit', function (e) {
                if (!desdePosCtaCte || !window.POSFinanzas || typeof window.POSFinanzas.cargar !== 'function') return;

                e.preventDefault();
                var datos = new FormData(frmFiltroCtaCte);
                var params = new URLSearchParams();
                datos.forEach(function (valor, clave) { params.append(clave, valor); });
                // El checkbox no manda valor si esta destildado -- FormData ya lo omite en ese
                // caso (comportamiento nativo de HTML), consistente con el submit normal del form.
                window.POSFinanzas.cargar('@Url.Action("CtaCtePersona", "Finanzas")?' + params.toString(), 'Cuenta corriente');
            });
        }

        // ---- Compra en modal (Compras/Editar?origen=modal), 2026-09-19 ---------------------------
        // Reusa la misma pantalla de Compras/Editar pero SIN la logica de caja de origen=pos. Al guardar,
        // compras.js cierra el modal y emite el evento nativo 'compra:guardada': aca se recarga la cuenta
        // corriente con los filtros vigentes (submit del mismo formulario de "Filtrar") y se muestra el aviso.
        // OJO: este <script> corre antes de que el layout cargue jQuery -- $ solo se usa dentro de handlers.
        var urlEditarCompra = '@Url.Action("Editar", "Compras")';
        var CLAVE_AVISO_COMPRA = 'ctacteCompraGuardada';

        // Inyecta HTML y ejecuta sus <script> en orden (innerHTML no los ejecuta). Los <script src> ya
        // cargados en la pagina se saltean (misma tecnica que renderConScripts de Ventas/POS.cshtml).
        function renderConScriptsCompra(html, contenedor) {
            var tmp = document.createElement('div');
            tmp.innerHTML = html;
            var scripts = [];
            tmp.querySelectorAll('script').forEach(function (s) {
                scripts.push({ src: s.getAttribute('src'), code: s.text || s.textContent || '' });
                s.parentNode.removeChild(s);
            });
            contenedor.innerHTML = tmp.innerHTML;

            function normalizar(src) {
                try { return new URL(src, document.baseURI).href; } catch (e) { return src; }
            }
            function yaCargado(href) {
                return Array.prototype.some.call(document.scripts, function (s) { return s.src && normalizar(s.src) === href; });
            }
            function ejecutar(i) {
                if (i >= scripts.length) return;
                var item = scripts[i];
                if (item.src) {
                    var href = normalizar(item.src);
                    if (yaCargado(href)) { ejecutar(i + 1); return; }
                    var nuevo = document.createElement('script');
                    nuevo.src = href;
                    nuevo.async = false;
                    nuevo.onload = function () { ejecutar(i + 1); };
                    nuevo.onerror = function () { console.error('No se pudo cargar el script:', href); ejecutar(i + 1); };
                    document.body.appendChild(nuevo);
                    return;
                }
                var inline = document.createElement('script');
                inline.text = item.code;
                document.body.appendChild(inline);
                document.body.removeChild(inline);
                ejecutar(i + 1);
            }
            ejecutar(0);
        }

        function avisarErrorCompra(mensaje) {
            if (window.Swal) { Swal.fire({ icon: 'error', title: 'Compra', text: mensaje }); return; }
            alert(mensaje);
        }

        function abrirCompra(idCompra) {
            var modalEl = document.getElementById('modalCompraCtaCte');
            var contenedor = document.getElementById('contenedorCompraCtaCte');
            if (!modalEl || !contenedor) return;

            // Restos de una apertura anterior (el modal se re-parenta a <body> para apilarse sobre el modal de POS).
            document.querySelectorAll('body > #modalCompraCtaCte').forEach(function (el) {
                if (el !== modalEl && !el.classList.contains('show')) el.remove();
            });
            if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);

            contenedor.innerHTML = '<div class="p-4 text-center text-muted">Cargando...</div>';

            var $modal = $(modalEl);
            var elFondo = document.getElementById('modalFinanzasPOS');
            var abiertos = document.querySelectorAll('.modal.show').length;

            $modal.off('.ctacteCompra');
            if (abiertos > 0) {
                // Con la Cta. Cte. embebida en POS ya hay un modal abierto: se sube el z-index (mismo
                // criterio que compras.js/elevarZIndexSobreModalAbierto) y se pausa el focus-trap del de fondo.
                var zIndex = 1040 + (10 * abiertos);
                modalEl.style.setProperty('z-index', zIndex, 'important');
                $modal.on('shown.bs.modal.ctacteCompra', function () {
                    var $backdrop = $('.modal-backdrop').not('.modal-stack').last();
                    if ($backdrop.length) {
                        $backdrop[0].style.setProperty('z-index', zIndex - 1, 'important');
                        $backdrop.addClass('modal-stack');
                    }
                });
            } else {
                modalEl.style.removeProperty('z-index');
            }
            if (elFondo && window.bootstrap && window.bootstrap.Modal) {
                $modal.on('show.bs.modal.ctacteCompra', function () {
                    var inst = window.bootstrap.Modal.getInstance(elFondo);
                    if (inst && inst._focustrap && typeof inst._focustrap.deactivate === 'function') inst._focustrap.deactivate();
                }).on('hidden.bs.modal.ctacteCompra', function () {
                    var inst = window.bootstrap.Modal.getInstance(elFondo);
                    if (inst && inst._focustrap && typeof inst._focustrap.activate === 'function') inst._focustrap.activate();
                });
            }
            // Al cerrar se vacia el formulario (evita ids duplicados en la proxima apertura).
            $modal.on('hidden.bs.modal.ctacteCompra', function () {
                contenedor.innerHTML = '';
                $('body > #modalBuscarProductoCompra').remove();
            });

            $modal.modal('show');

            fetch(urlEditarCompra + '?id=' + encodeURIComponent(idCompra) + '&origen=modal', {
                credentials: 'same-origin',
                cache: 'no-store',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(function (resp) {
                if (resp.ok) return resp.text();
                return resp.text().then(function (texto) { throw new Error(texto || 'No se pudo abrir la compra.'); });
            }).then(function (html) {
                renderConScriptsCompra(html, contenedor);
            }).catch(function (err) {
                console.error('Cta. Cte.: no se pudo abrir la compra', err);
                $modal.modal('hide');
                avisarErrorCompra(err && err.message ? err.message : 'No se pudo abrir la compra.');
            });
        }

        // Un solo listener por carga (la Cta. Cte. embebida en POS se vuelve a inyectar en cada filtro).
        if (window.__ctacteCompraGuardadaHandler) {
            document.removeEventListener('compra:guardada', window.__ctacteCompraGuardadaHandler);
        }
        window.__ctacteCompraGuardadaHandler = function () {
            if (!frmFiltroCtaCte || !document.body.contains(frmFiltroCtaCte)) return;
            try {
                sessionStorage.setItem(CLAVE_AVISO_COMPRA, '1');
            } catch (e) {
                console.warn('Cta. Cte.: sin sessionStorage, no se mostrara el aviso de compra guardada.', e);
            }
            frmFiltroCtaCte.requestSubmit();
        };
        document.addEventListener('compra:guardada', window.__ctacteCompraGuardadaHandler);

        // Aviso de "compra guardada" tras la recarga (el Swal de compras.js no sobreviviria a la recarga).
        (function mostrarAvisoCompraGuardada() {
            function mostrar() {
                try {
                    if (sessionStorage.getItem(CLAVE_AVISO_COMPRA) !== '1') return;
                    sessionStorage.removeItem(CLAVE_AVISO_COMPRA);
                } catch (e) {
                    console.warn('Cta. Cte.: no se pudo leer el aviso de compra guardada.', e);
                    return;
                }
                if (window.Swal) {
                    Swal.fire({ icon: 'success', title: 'Compra guardada', text: 'La cuenta corriente se actualizó.', timer: 1800, timerProgressBar: true, showConfirmButton: false });
                }
            }
            if (document.readyState === 'complete') mostrar(); else window.addEventListener('load', mostrar);
        })();

        document.querySelectorAll('.js-fila-ctacte').forEach(function (fila) {
            if (fila.dataset.esCompra === 'true') {
                fila.addEventListener('click', function () { abrirCompra(fila.dataset.idCompra); });
                return;
            }

            if (fila.dataset.esVenta === 'true') {
                fila.addEventListener('click', function () {
                    window.location.href = '@Url.Action("DetalleVenta", "Ventas")?id=' + fila.dataset.idVenta;
                });
                return;
            }

            if (fila.dataset.esPago === 'true') {
                fila.addEventListener('click', function () {
                    var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                    var url = '@Url.Action("AddOrEditPago", "Finanzas")?idPersona=' + idPersona + '&idPago=' + fila.dataset.idPago + '&returnUrl=' + returnUrl
                        + (posInstanceIdCtaCte ? '&posInstanceId=' + encodeURIComponent(posInstanceIdCtaCte) : '');

                    // Bug real reportado 2026-09-11 (ver docs/DECISIONS.md): esta fila hacia
                    // window.location.href directo -- una navegacion de pagina completa que, con
                    // #modalFinanzasPOS abierto (embebida en POS), disparaba el guard de
                    // beforeunload de pos-cart.js (cartel "Desea salir del sitio?") y terminaba
                    // sacando al usuario de POS. El boton "Agregar Pago / Cobro" de esta misma
                    // vista (arriba) ya evita esto siendo un <a data-pos-ajax="true">, interceptado
                    // por POS.cshtml para cargar en #modalPagoPOS sin navegar -- se replica ese
                    // mismo comportamiento aca en vez de duplicar el atributo en un <a> generado
                    // por JS.
                    if (desdePosCtaCte && window.POSFinanzas && typeof window.POSFinanzas.cargarPago === 'function') {
                        window.POSFinanzas.cargarPago(url, 'Pago / Cobro');
                        return;
                    }

                    window.location.href = url;
                });
            }
        });

        if (!puedeExportarCuentaCorriente) return;

        function mostrarAnuladosActual() {
            var chk = document.getElementById('chkMostrarAnulados');
            return chk ? chk.checked : false;
        }

        function abrirModalEmail() {
            document.getElementById('ccEmailError').classList.add('d-none');
            document.getElementById('ccEmailDestino').value = '';
            document.getElementById('ccEmailAsunto').value = '';
            document.getElementById('ccEmailMensaje').value = '';
            document.getElementById('ccEmailFormato').value = 'pdf';
            document.getElementById('btnConfirmarEmailCtaCte').disabled = true;

            var params = new URLSearchParams({ idPersona: idPersona, fechaDesde: fechaDesde, mostrarAnulados: mostrarAnuladosActual() });
            fetch(emailConfigUrl + '?' + params.toString())
                .then(function (r) { return r.json(); })
                .then(function (resp) {
                    if (!resp || !resp.ok) {
                        if (window.Swal) Swal.fire({ icon: 'error', title: 'Email', text: (resp && resp.msg) || 'No se pudieron recuperar los datos del email.' });
                        return;
                    }
                    document.getElementById('ccEmailDestino').value = resp.email || '';
                    document.getElementById('ccEmailAsunto').value = resp.asunto || '';
                    document.getElementById('ccEmailMensaje').value = resp.mensaje || '';
                    document.getElementById('btnConfirmarEmailCtaCte').disabled = false;
                    $('#modalEmailCtaCte').modal('show');
                })
                .catch(function () {
                    if (window.Swal) Swal.fire({ icon: 'error', title: 'Email', text: 'No se pudieron recuperar los datos del email.' });
                });
        }

        function confirmarEmail() {
            var destino = (document.getElementById('ccEmailDestino').value || '').trim();
            var asunto = (document.getElementById('ccEmailAsunto').value || '').trim();
            var mensaje = (document.getElementById('ccEmailMensaje').value || '').trim();
            var formato = document.getElementById('ccEmailFormato').value || 'pdf';
            var errorBox = document.getElementById('ccEmailError');

            if (!destino) { errorBox.classList.remove('d-none'); errorBox.textContent = 'Ingresá el email destino.'; return; }
            if (!asunto) { errorBox.classList.remove('d-none'); errorBox.textContent = 'Ingresá el asunto del mail.'; return; }

            errorBox.classList.add('d-none');
            document.getElementById('btnConfirmarEmailCtaCte').disabled = true;

            var body = new URLSearchParams({
                idPersona: idPersona,
                fechaDesde: fechaDesde,
                mostrarAnulados: mostrarAnuladosActual(),
                emailDestino: destino,
                asunto: asunto,
                mensaje: mensaje,
                formato: formato
            });

            fetch(emailSendUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() })
                .then(function (r) { return r.json(); })
                .then(function (resp) {
                    document.getElementById('btnConfirmarEmailCtaCte').disabled = false;
                    if (!resp || !resp.ok) {
                        errorBox.classList.remove('d-none');
                        errorBox.textContent = (resp && resp.msg) || 'No se pudo enviar el mail.';
                        return;
                    }
                    $('#modalEmailCtaCte').modal('hide');
                    if (window.Swal) Swal.fire({ icon: 'success', title: 'Email', text: resp.msg || 'La cuenta corriente se envió correctamente.' });
                })
                .catch(function () {
                    document.getElementById('btnConfirmarEmailCtaCte').disabled = false;
                    errorBox.classList.remove('d-none');
                    errorBox.textContent = 'No se pudo enviar el mail.';
                });
        }

        var btnMail = document.getElementById('btnEnviarMailCtaCte');
        if (btnMail) btnMail.addEventListener('click', abrirModalEmail);

        var btnConfirmar = document.getElementById('btnConfirmarEmailCtaCte');
        if (btnConfirmar) btnConfirmar.addEventListener('click', confirmarEmail);
    })();
</script>
