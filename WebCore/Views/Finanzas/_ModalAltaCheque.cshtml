@using Entidades

<div class="modal fade" id="modalAltaCheque" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg modal-cheque-compact-dialog" role="document">
        <div class="modal-content modal-cheque-compact">

            <!-- HEADER -->
            <div class="modal-header modal-cheque-compact-header">
                <h5 class="modal-title">
                    <i class="fas fa-money-check-alt mr-2"></i>
                    <span id="tituloModalCheque">Alta de Cheque</span>
                </h5>
                <button class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body modal-cheque-compact-body">

                <form id="formCheque" class="cheque-form-compact">

                    <input type="hidden" id="ChequeId" value="0" />

                    <div class="row">
                        <!-- NRO CHEQUE -->
                        <div class="col-md-6 mb-3">
                            <label>Número de Cheque</label>
                            <input type="text" class="form-control"
                                   id="NroCheque" />
                        </div>

                        <!-- BANCO -->
                        <div class="col-md-6 mb-3">
                            <label>Banco</label>
                            <select class="form-control" id="Banco">
                                <option value="">-- Seleccione --</option>
                                @foreach (var banco in (List<string>)ViewBag.Bancos)
                                {
                                    <option value="@banco">@banco</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label>Importe</label>
                            <input type="text" class="form-control solo-decimal" id="Importe" autocomplete = "off"/>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label>Fecha Emisión</label>
                            <input type="date" class="form-control" id="FechaEmision" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label>Fecha Pago</label>
                            <input type="date" class="form-control" id="FechaPago" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- ESTADO -->
                        <div class="col-md-6 mb-3">
                            <label>Estado</label>
                            <select class="form-control" id="Estado">
                                @foreach (Cheque.EstadoEnum e in Enum.GetValues(typeof(Cheque.EstadoEnum)))
                                {
                                    <option value="@e">@e</option>
                                }
                            </select>
                        </div>

                        <!-- PROPIO -->
                        <div class="col-md-6 mb-3">
                            <label>Propio</label>
                            <select class="form-control" id="Propio">
                                <option value="false">No</option>
                                <option value="true">Sí</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Titular</label>
                        <input type="text" class="form-control" id="Titular" />
                    </div>

                    <div class="form-group">
                        <label>Observaciones</label>
                        <textarea class="form-control" id="Observaciones"></textarea>
                    </div>

                </form>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer modal-cheque-compact-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" id="btnGuardarCheque">
                    <i class="fas fa-save mr-1"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    #modalAltaCheque .modal-cheque-compact-dialog {
        max-width: 820px;
    }

    #modalAltaCheque .modal-cheque-compact {
        border: 1px solid #e2e8f0;
        border-radius: .8rem;
        overflow: hidden;
        box-shadow: 0 .45rem 1.4rem rgba(58, 59, 69, .18);
    }

    #modalAltaCheque .modal-cheque-compact-header {
        background: #f8f9fc;
        border-bottom: 1px solid #e2e8f0;
        padding: .9rem 1.05rem;
    }

    #modalAltaCheque .modal-cheque-compact-header .modal-title,
    #modalAltaCheque .modal-cheque-compact-header .close {
        color: #2f3e52;
        text-shadow: none;
    }

    #modalAltaCheque .modal-cheque-compact-header .modal-title {
        font-size: 1rem;
        font-weight: 700;
    }

    #modalAltaCheque .modal-cheque-compact-body {
        padding: .9rem 1rem;
        background: #fff;
    }

    #modalAltaCheque .modal-cheque-compact-footer {
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: .7rem 1rem;
    }

    #modalAltaCheque .cheque-form-compact label {
        margin-bottom: .22rem;
        font-size: .78rem;
        font-weight: 600;
        color: #334155;
    }

    #modalAltaCheque .cheque-form-compact .form-control,
    #modalAltaCheque .cheque-form-compact .btn {
        min-height: 2.1rem;
        border-radius: .5rem;
        font-size: .84rem;
        padding: .28rem .55rem;
    }

    #modalAltaCheque .cheque-form-compact textarea.form-control {
        min-height: 84px;
    }

    #modalAltaCheque .cheque-form-compact .row {
        margin-left: -.35rem;
        margin-right: -.35rem;
    }

    #modalAltaCheque .cheque-form-compact .row > [class*='col-'] {
        padding-left: .35rem;
        padding-right: .35rem;
    }

    @@media (max-width: 767.98px) {
        #modalAltaCheque .modal-cheque-compact-dialog {
            width: calc(100% - .75rem);
            margin: .5rem auto;
        }

        #modalAltaCheque .modal-cheque-compact-header,
        #modalAltaCheque .modal-cheque-compact-body,
        #modalAltaCheque .modal-cheque-compact-footer {
            padding-left: .8rem;
            padding-right: .8rem;
        }
    }
</style>
