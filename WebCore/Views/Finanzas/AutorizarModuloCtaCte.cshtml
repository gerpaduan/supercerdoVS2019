@{
    // Pantalla de login del operador para ver la cuenta corriente de una persona desde una cuenta de produccion.
    // Mismo patron que Views/Compras/AutorizarModulo.cshtml (docs/DECISIONS.md, 2026-11-02). Cancelar vuelve a la
    // pantalla de la que vino el usuario (cancelUrl), no a Home.
    ViewBag.Title = "Autorizar operador";
    ViewBag.Seccion = "Cuenta Corriente";
    string returnUrlModulo = ViewBag.ReturnUrlModuloCtaCte as string ?? Url.Action("CtasCtes", "Finanzas");
    string cancelUrlModulo = ViewBag.CancelUrlModuloCtaCte as string ?? Url.Action("Index", "Home");
}

@Html.AntiForgeryToken()

<div class="container-fluid mt-5">
    <div class="text-center">
        <h4 class="text-primary"><i class="fas fa-user-shield mr-1"></i> Autorizate para continuar</h4>
        <p class="text-gray-500 mb-4">Esta sesión usa la cuenta de producción: identificate con tu usuario y contraseña para ver la cuenta corriente.</p>
    </div>
</div>

@Html.Partial("~/Views/Shared/_ModalSeleccionUsuario.cshtml")

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/seleccion-usuario.js")" asp-append-version="true"></script>
    <script>
        (function () {
            var usuariosActivos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UsuariosActivosEmpresa ?? new System.Collections.Generic.List<object>()));
            var urlAutorizar = '@Url.Action("AutorizarOperadorModuloCtaCte", "Finanzas")';
            var returnUrlModulo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrlModulo));
            var cancelUrlModulo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cancelUrlModulo));

            function pedirOperador() {
                window.SeleccionUsuario.abrir({
                    titulo: 'Autorizate para ver la cuenta corriente',
                    usuarios: usuariosActivos,
                    requierePassword: true,
                    validarUrl: urlAutorizar
                }).then(function () {
                    window.location.href = returnUrlModulo;
                }).catch(function () {
                    window.location.href = cancelUrlModulo;
                });
            }

            $(document).on('hidden.bs.modal', '#modalSeleccionUsuario', function () {
                if (!$(this).data('resuelto')) {
                    window.location.href = cancelUrlModulo;
                }
            });

            pedirOperador();
        })();
    </script>
}
