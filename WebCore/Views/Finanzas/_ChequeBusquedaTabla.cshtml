@{
    string filtroEstado = ViewBag.FiltroEstado ?? "";
    string filtroNroCheque = ViewBag.FiltroNroCheque ?? "";
    string filtroDesde = ViewBag.FiltroDesde ?? "";
    bool chequeBusquedaEnPago = ViewBag.ChequeBusquedaEnPago != null && (bool)ViewBag.ChequeBusquedaEnPago;
}

<div class="cheques-filtros-card mb-3">
    <div class="cheques-filtros-stack">
        <div class="cheques-filtros-row cheques-filtros-row-fechas">
            <div class="form-group mb-0 cheques-filtro-fecha">
                <label class="cheques-filtro-label">Fecha desde</label>
                <input type="date" id="filtroDesde" class="form-control" value="@filtroDesde">
            </div>

            <div class="form-group mb-0 cheques-filtro-accion">
                <label class="cheques-filtro-label d-none d-lg-block">&nbsp;</label>
                <button type="button" class="btn btn-primary btn-block" id="btnFiltrarCheques">
                    <i class="fas fa-filter mr-1"></i> Buscar
                </button>
            </div>
        </div>

        <div class="cheques-filtros-row cheques-filtros-row-busqueda">
            <div class="form-group mb-0">
                <label class="cheques-filtro-label">Estado</label>
                <select id="filtroEstado" class="form-control">
                    <option value="">-- Todos --</option>
                    <option value="PENDIENTE" selected="@(filtroEstado == "PENDIENTE" ? "selected" : null)">Pendiente</option>
                    <option value="ENTREGADO" selected="@(filtroEstado == "ENTREGADO" ? "selected" : null)">Entregado</option>
                    <option value="DEPOSITADO" selected="@(filtroEstado == "DEPOSITADO" ? "selected" : null)">Depositado</option>
                    <option value="ACREDITADO" selected="@(filtroEstado == "ACREDITADO" ? "selected" : null)">Acreditado</option>
                    <option value="RECHAZADO" selected="@(filtroEstado == "RECHAZADO" ? "selected" : null)">Rechazado</option>
                </select>
            </div>

            <div class="form-group mb-0">
                <label class="cheques-filtro-label">Nro Cheque</label>
                <input type="text" id="filtroNroCheque" class="form-control" placeholder="Buscar por numero" value="@filtroNroCheque">
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover table-sm cheques-table-compact" id="tablaBusquedaCheques" width="100%" cellspacing="0">
        <thead class="thead-light">
            <tr>
                <th>ID</th>
                <th>Nro Cheque</th>
                <th>Banco</th>
                <th>Importe</th>
                <th>Fecha Pago</th>
                <th>Estado</th>
                <th>Titular</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@if (chequeBusquedaEnPago)
{
    <div class="small text-muted mt-2">
        Doble clic sobre un cheque para cargarlo al pago.
    </div>
}

<style>
    .cheques-filtros-card {
        border: 1px solid #dbe5f3;
        border-radius: .75rem;
        padding: .85rem;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 .125rem .35rem rgba(58, 59, 69, .06);
    }

    .cheques-filtros-stack {
        display: grid;
        gap: .75rem;
    }

    .cheques-filtros-row {
        display: grid;
        gap: .75rem;
    }

    .cheques-filtro-label {
        font-size: .78rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: .22rem;
    }

    .cheques-filtros-card .form-control {
        min-height: 2.1rem;
        border-radius: .5rem;
        font-size: .84rem;
        padding: .28rem .55rem;
    }

    .cheques-filtros-card .btn {
        min-height: 2.1rem;
        border-radius: .5rem;
        font-size: .84rem;
        padding: .28rem .7rem;
    }

    .cheques-table-compact {
        margin-bottom: 0;
        font-size: .82rem;
        background: #fff;
    }

    .cheques-table-compact th,
    .cheques-table-compact td {
        padding: .38rem .5rem;
        vertical-align: middle;
        line-height: 1.15;
    }

    .cheques-table-compact thead th {
        font-size: .71rem;
        text-transform: uppercase;
        letter-spacing: .02em;
        white-space: nowrap;
        color: #334155;
        background: #eef2f7;
        border-color: #d9e2ef;
    }

    .cheques-table-compact tbody tr:hover {
        background: rgba(13, 110, 253, 0.04);
    }

    @@media (min-width: 1200px) {
        .cheques-filtros-row-fechas {
            grid-template-columns: 1.15fr 140px;
            align-items: end;
            max-width: 420px;
        }

        .cheques-filtros-row-busqueda {
            grid-template-columns: .9fr 1.2fr;
        }
    }

    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .cheques-filtros-row-fechas,
        .cheques-filtros-row-busqueda {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cheques-filtro-accion {
            grid-column: 2;
        }
    }

    @@media (max-width: 767.98px) {
        .cheques-filtros-row {
            grid-template-columns: 1fr;
        }
    }

    html.dark-mode .cheques-filtros-card {
        background: linear-gradient(180deg, #162538 0%, #132234 100%);
        border-color: #2f4d69;
        box-shadow: 0 18px 42px rgba(2, 6, 23, .24);
    }

    html.dark-mode .cheques-filtro-label,
    html.dark-mode .small.text-muted {
        color: #97a7bd !important;
    }

    html.dark-mode .cheques-table-compact {
        background: #152233;
    }

    html.dark-mode .cheques-table-compact thead th {
        background: #172638;
        color: #eaf2fb;
        border-color: #2a3b52;
    }
</style>
