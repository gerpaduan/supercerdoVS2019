<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
    <ProjectReference Include="..\Contratos\Contratos.csproj" />
    <ProjectReference Include="..\DatosPostgres\DatosPostgres.csproj" />
    <ProjectReference Include="..\Datos\Datos.csproj" />
    <ProjectReference Include="..\Negocio\Negocio.csproj" />
    <ProjectReference Include="..\Utilidades.Core\Utilidades.Core.csproj" />
    <ProjectReference Include="..\AFIP\AFIP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Requerido por ComprasController.Guardar para portar la proteccion anti-doble-submit del
         original (MemoryCache.Default.Add, atomico, ver docs/DECISIONS.md, Modulo 5). Se eligio
         este paquete oficial de Microsoft en vez de reimplementar la logica con
         Microsoft.Extensions.Caching.Memory (IMemoryCache no tiene un "Add si no existe" atomico
         built-in) para preservar exactamente la misma garantia de concurrencia ya verificada en
         produccion, sin reescribir un mecanismo de seguridad. -->
    <PackageReference Include="System.Runtime.Caching" Version="9.0.0" />
    <!-- Reemplazo de iTextSharp (no corre en .NET Core) para generacion de PDF: QuestPDF,
         elegido por el usuario en vez de iText7 AGPL (que exige codigo abierto para uso como
         servicio de red, ver docs/10-migracion-aspnet-core/README.md). License Community: gratis
         para el porte de CarniSys. -->
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <!-- QR oficial de AFIP (RG 4892/2020) para el PDF de factura: Utilidades.GenerarDocs.cs
         (clasico) usa QRCodeGenerator + System.Drawing.Bitmap, que no corre en Linux desde
         .NET 6+ (GDI+ removido, bloqueante ya señalado desde el plan original de la migracion).
         El port a WebCore usa PngByteQRCode en cambio (bytes PNG directos, sin System.Drawing). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
