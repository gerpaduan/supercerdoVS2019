@model CarniSys.NG.Application.Purchases.PurchaseDetailItem
@{
    ViewData["Title"] = "Detalle de compra";
}

<section class="hero-panel">
    <p class="eyebrow">Compras NG</p>
    <h1>Compra #@Model.PurchaseId</h1>
    <p class="lead-copy">
        Ficha de compra en solo lectura para validar cabecera, totales y lineas dentro del flujo NG.
    </p>
</section>

<section class="status-card mb-3">
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Purchases" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        @if (ViewBag.CanEditPurchase == true)
        {
            <a asp-controller="Purchases" asp-action="Edit" asp-route-id="@Model.PurchaseId" class="btn app-button">Editar compra</a>
        }
    </div>
</section>

@if (TempData["FlashSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success status-card mt-3" role="alert">
        @successMessage
    </div>
}

@if (TempData["FlashError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger status-card mt-3" role="alert">
        @errorMessage
    </div>
}

<section class="detail-grid">
    <article class="status-card">
        <h2>Cabecera</h2>
        <p><strong>Fecha:</strong> @Model.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Tipo:</strong> @Model.PurchaseType</p>
        <p><strong>Sucursal:</strong> @Model.BranchName</p>
        <p><strong>Estado:</strong> @(string.IsNullOrWhiteSpace(Model.Status) ? "-" : Model.Status)</p>
    </article>

    <article class="status-card">
        <h2>Proveedor</h2>
        <p><strong>Nombre:</strong> @Model.SupplierName</p>
        <p><strong>CUIT:</strong> @(string.IsNullOrWhiteSpace(Model.SupplierTaxId) ? "-" : Model.SupplierTaxId)</p>
        <p><strong>Nro remito:</strong> @(string.IsNullOrWhiteSpace(Model.ReceiptNumber) ? "-" : Model.ReceiptNumber)</p>
        <p><strong>Cuenta corriente:</strong> @(Model.CurrentAccount ? "Si" : "No")</p>
    </article>

    <article class="status-card">
        <h2>Totales</h2>
        <p><strong>Cant. medias:</strong> @(Model.HalfCarcassCount.HasValue ? Model.HalfCarcassCount.Value : 0)</p>
        <p><strong>Kgs. medias:</strong> @(Model.HalfCarcassWeightKg.HasValue ? Model.HalfCarcassWeightKg.Value.ToString("0.###") : "-")</p>
        <p><strong>Total kg:</strong> @Model.TotalKg.ToString("0.###")</p>
        <p><strong>Total $:</strong> @Model.TotalAmount.ToString("0.00")</p>
    </article>

    <article class="status-card">
        <h2>Trazabilidad</h2>
        <p><strong>Creado:</strong> @(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
        <p><strong>Creado por:</strong> @(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "-" : Model.CreatedByName)</p>
        <p><strong>Actualizado:</strong> @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
        <p><strong>Actualizado por:</strong> @(string.IsNullOrWhiteSpace(Model.UpdatedByName) ? "-" : Model.UpdatedByName)</p>
    </article>
    <article class="status-card detail-grid-full">
        <h2>Observaciones</h2>
        <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</p>
    </article>
</section>

<section class="status-card mt-3">
    <h2 class="mb-3">Lineas</h2>
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Referencia</th>
                    <th>Producto</th>
                    <th>Total kg</th>
                    <th>Precio</th>
                    <th>Total $</th>
                    <th>Balanza</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">La compra no tiene lineas cargadas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(line.Code) ? "-" : line.Code)</td>
                            <td>@line.ProductName</td>
                            <td>@line.QuantityKg.ToString("0.###")</td>
                            <td>@line.Price.ToString("0.00")</td>
                            <td>@line.Total.ToString("0.00")</td>
                            <td>@(line.ScaleWeight ? "Si" : "No")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
