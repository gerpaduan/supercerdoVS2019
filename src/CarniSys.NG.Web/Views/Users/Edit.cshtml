@model UserEditViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Editar usuario" : "Nuevo usuario";
}

<section class="hero-panel">
    <p class="eyebrow">Usuarios NG</p>
    <h1>@(Model.IsEdit ? "Editar usuario" : "Nuevo usuario")</h1>
    <p class="lead-copy">
        Esta pantalla replica el set operativo actual de usuarios por empresa. Solo usa sucursales ya existentes de la empresa activa y no abre administracion de sucursales.
    </p>
</section>

<section class="status-card">
    <form method="post" class="product-edit-form">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="IsEdit" type="hidden" />
        <input asp-for="CompanyId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div>
            <label asp-for="FullName" class="form-label">Nombre</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="Login" class="form-label">Usuario</label>
            <input asp-for="Login" class="form-control" />
            <span asp-validation-for="Login" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="BranchId" class="form-label">Sucursal</label>
            <select asp-for="BranchId" asp-items="Model.Branches" class="form-select">
                <option value="0">Sin sucursal por defecto</option>
            </select>
            <span asp-validation-for="BranchId" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="Password" class="form-label">Clave</label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="@(Model.IsEdit ? "Dejar vacia para mantener la actual" : string.Empty)" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <label class="toggle-row">
            <input asp-for="IsAdministrator" class="form-check-input" />
            <span>Admin</span>
        </label>

        <label class="toggle-row">
            <input asp-for="IsActive" class="form-check-input" />
            <span>Activo</span>
        </label>

        <label class="toggle-row">
            <input asp-for="CanLoginOutsideBranch" class="form-check-input" />
            <span>Permitir login fuera de sucursal</span>
        </label>

        <div class="product-edit-actions">
            <button type="submit" class="btn app-button">Guardar usuario</button>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
