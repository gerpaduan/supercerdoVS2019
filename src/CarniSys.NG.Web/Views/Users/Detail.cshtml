@model CarniSys.NG.Application.Users.UserDetailItem
@{
    ViewData["Title"] = "Detalle de usuario";
}

<section class="hero-panel">
    <p class="eyebrow">Usuarios NG</p>
    <h1>@Model.FullName</h1>
    <p class="lead-copy">
        Ficha read-only del usuario dentro de la empresa activa, sin habilitar alta, edicion ni administracion de permisos desde NG.
    </p>
</section>

<section class="detail-grid">
    <article class="status-card">
        <h2>Acceso</h2>
        <p><strong>Usuario:</strong> @Model.Login</p>
        <p><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</p>
        <p><strong>Administrador:</strong> @(Model.IsAdministrator ? "Si" : "No")</p>
        <p><strong>Activo:</strong> @(Model.IsActive ? "Si" : "No")</p>
    </article>

    <article class="status-card">
        <h2>Contexto</h2>
        <p><strong>Empresa:</strong> @Model.CompanyId</p>
        <p><strong>Sucursal:</strong> @(string.IsNullOrWhiteSpace(Model.BranchName) ? "-" : Model.BranchName)</p>
        <p><strong>Id sucursal:</strong> @Model.BranchId</p>
        <p><strong>Login fuera de sucursal:</strong> @(Model.CanLoginOutsideBranch ? "Si" : "No")</p>
    </article>
</section>

<section class="status-card mt-3">
    <a asp-controller="UserPermissions" asp-action="Index" asp-route-id="@Model.UserId" class="app-inline-link">Abrir permisos del usuario</a>
    <span> · </span>
    <a asp-controller="Users" asp-action="Edit" asp-route-id="@Model.UserId" class="app-inline-link">Editar usuario</a>
</section>
