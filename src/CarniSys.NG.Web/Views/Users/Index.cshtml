@model UserListPageViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<section class="hero-panel">
    <p class="eyebrow">Usuarios NG</p>
    <h1>Usuarios en solo lectura</h1>
    <p class="lead-copy">
        Este modulo replica la consulta base de `Usuarios` por empresa y respeta el permiso legacy real de lectura.
    </p>
</section>

<section class="status-card">
    <h2>Busqueda</h2>
    <form method="get" class="product-filters">
        <div>
            <label for="searchText" class="form-label">Filtro</label>
            <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Nombre, usuario o email" />
        </div>
        <div class="form-check mt-4">
            <input id="onlyActive" name="onlyActive" value="true" @(Model.OnlyActive ? "checked" : null) class="form-check-input" type="checkbox" />
            <label for="onlyActive" class="form-check-label">Solo activos</label>
        </div>
        <div class="product-filter-actions">
            <button type="submit" class="btn app-button">Buscar</button>
        </div>
    </form>
</section>

<section class="status-card mt-3">
    @if (Model.CanManageUsers)
    {
        <div class="mb-3">
            <a asp-controller="Users" asp-action="Edit" class="btn app-button">Nuevo usuario</a>
        </div>
    }
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Sucursal</th>
                    <th>Admin</th>
                    <th>Activo</th>
                    <th>Detalle</th>
                    <th>Permisos</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No se encontraron usuarios para el filtro indicado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Login</td>
                            <td>@item.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(item.BranchName) ? "-" : item.BranchName)</td>
                            <td>@(item.IsAdministrator ? "Si" : "No")</td>
                            <td>@(item.IsActive ? "Si" : "No")</td>
                            <td>
                                <a asp-controller="Users" asp-action="Detail" asp-route-id="@item.UserId" class="app-inline-link">Ver ficha</a>
                            </td>
                            <td>
                                <a asp-controller="UserPermissions" asp-action="Index" asp-route-id="@item.UserId" class="app-inline-link">Ver permisos</a>
                                @if (Model.CanManageUsers)
                                {
                                    <span> · </span>
                                    <a asp-controller="Users" asp-action="Edit" asp-route-id="@item.UserId" class="app-inline-link">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
