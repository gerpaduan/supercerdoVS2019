@model ProductEditViewModel
@{
    ViewData["Title"] = "Editar producto";
}

<section class="hero-panel">
    <p class="eyebrow">Productos NG</p>
    <h1>Edicion minima y controlada</h1>
    <p class="lead-copy">
        Esta pantalla modifica campos directos del registro actual de la empresa, incluyendo la marca. No altera codigo, tipo, corte maestro, IVA ni catalogo global.
    </p>
</section>

<section class="status-card">
    <h2>Producto</h2>
    <p><strong>Codigo:</strong> @Model.Code</p>
    <p><strong>Descripcion:</strong> @Model.Description</p>
</section>

<section class="status-card mt-3">
    <form method="post" class="product-edit-form">
        @Html.AntiForgeryToken()
        <input asp-for="ProductId" type="hidden" />
        <input asp-for="Code" type="hidden" />
        <input asp-for="Description" type="hidden" />
        <input asp-for="BrandId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div>
            <label asp-for="BrandName" class="form-label">Marca</label>
            <div class="input-group">
                <input asp-for="BrandName" class="form-control" readonly />
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#productBrandLookupModal">Buscar</button>
                <button type="button" class="btn btn-outline-secondary" id="productClearBrandButton">Limpiar</button>
            </div>
            <span asp-validation-for="BrandName" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="PricePerKilogram" class="form-label">Precio Kg</label>
            <input asp-for="PricePerKilogram" class="form-control" />
            <span asp-validation-for="PricePerKilogram" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="AverageWeight" class="form-label">Promedio</label>
            <input asp-for="AverageWeight" class="form-control" />
            <span asp-validation-for="AverageWeight" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="StockPoint" class="form-label">Punto stock</label>
            <input asp-for="StockPoint" class="form-control" />
            <span asp-validation-for="StockPoint" class="text-danger small"></span>
        </div>

        <div class="product-branch-stock-card">
            <label class="toggle-row mb-2">
                <input asp-for="UseBranchStockPoints" class="form-check-input" data-branch-stock-toggle="true" />
                <span>Editar punto stock por sucursal</span>
            </label>
            <p class="text-muted small mb-3">
                Si no activas esta opcion, el punto stock general se copia a todas las sucursales para mantener compatibilidad con el comportamiento actual.
            </p>

            <div class="branch-stock-grid" data-branch-stock-grid="true" style="display:@(Model.UseBranchStockPoints ? "grid" : "none")">
                @for (var index = 0; index < Model.BranchStockPoints.Count; index++)
                {
                    <input asp-for="BranchStockPoints[index].BranchId" type="hidden" />
                    <input asp-for="BranchStockPoints[index].BranchName" type="hidden" />
                    <div>
                        <label asp-for="BranchStockPoints[index].StockPoint" class="form-label">@Model.BranchStockPoints[index].BranchName</label>
                        <input asp-for="BranchStockPoints[index].StockPoint" class="form-control" />
                        <span asp-validation-for="BranchStockPoints[index].StockPoint" class="text-danger small"></span>
                    </div>
                }
            </div>
        </div>

        <label class="toggle-row">
            <input asp-for="Weighable" class="form-check-input" />
            <span>Pesable</span>
        </label>

        <label class="toggle-row">
            <input asp-for="IncludedInStockClosing" class="form-check-input" />
            <span>Incluido en cierre stock</span>
        </label>

        <label class="toggle-row">
            <input asp-for="Enabled" class="form-check-input" />
            <span>Habilitado</span>
        </label>

        <label class="toggle-row">
            <input asp-for="QuickElaboratedEntry" class="form-check-input" />
            <span>Ingreso rapido elaborado</span>
        </label>

        <div class="product-edit-actions">
            <button type="submit" class="btn app-button">Guardar cambios</button>
            <a asp-controller="ProductDetails" asp-action="Index" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>

@await Html.PartialAsync("_PersonLookupModal", new PersonLookupModalViewModel
{
    ModalId = "productBrandLookupModal",
    Title = "Marcas",
    SearchUrl = Url.Action("Lookup", "Brands") ?? string.Empty,
    SearchPlaceholder = "Nombre de la marca",
    NameColumnTitle = "Marca",
    ShowIdentification = false,
    ShowTaxId = false
})

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const brandLookupModal = document.getElementById("productBrandLookupModal");
            const brandIdInput = document.getElementById("BrandId");
            const brandNameInput = document.getElementById("BrandName");
            const clearBrandButton = document.getElementById("productClearBrandButton");
            const toggle = document.querySelector('[data-branch-stock-toggle="true"]');
            const grid = document.querySelector('[data-branch-stock-grid="true"]');

            function clearBrand() {
                if (brandIdInput) {
                    brandIdInput.value = "";
                }

                if (brandNameInput) {
                    brandNameInput.value = "";
                }
            }

            if (clearBrandButton) {
                clearBrandButton.addEventListener("click", clearBrand);
            }

            if (brandLookupModal) {
                brandLookupModal.addEventListener("lookup:selected", function (event) {
                    const brand = event.detail || {};

                    if (brandIdInput) {
                        brandIdInput.value = brand.personId || "";
                    }

                    if (brandNameInput) {
                        brandNameInput.value = brand.businessName || "";
                    }
                });
            }

            if (!toggle || !grid) {
                return;
            }

            const sync = () => {
                grid.style.display = toggle.checked ? "grid" : "none";
            };

            toggle.addEventListener("change", sync);
            sync();
        })();
    </script>
}
