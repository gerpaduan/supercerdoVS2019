@model ProductTypeEditViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Editar tipo de producto" : "Nuevo tipo de producto";
}

<section class="hero-panel">
    <p class="eyebrow">Productos NG</p>
    <h1>@(Model.IsEdit ? "Editar tipo de producto" : "Nuevo tipo de producto")</h1>
    <p class="lead-copy">
        Esta pantalla administra solo tipos propios de la empresa actual. Los tipos reservados del sistema se mantienen fuera de edicion.
    </p>
</section>

<section class="status-card">
    <form method="post" class="product-edit-form">
        @Html.AntiForgeryToken()
        <input asp-for="OriginalTypeName" type="hidden" />
        <input asp-for="IsEdit" type="hidden" />
        <input asp-for="IsReserved" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div>
            <label asp-for="TypeName" class="form-label">Tipo</label>
            <input asp-for="TypeName" class="form-control" />
            <span asp-validation-for="TypeName" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="SortOrder" class="form-label">Orden</label>
            <input asp-for="SortOrder" class="form-control" />
            <span asp-validation-for="SortOrder" class="text-danger small"></span>
        </div>

        <div class="product-edit-actions">
            <button type="submit" class="btn app-button">Guardar tipo</button>
            <a asp-controller="ProductTypes" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
