@model CarniSys.NG.Application.Movements.MovementDetailItem
@{
    ViewData["Title"] = "Detalle de movimiento";
}

<section class="hero-panel">
    <p class="eyebrow">Movimientos NG</p>
    <h1>Movimiento #@Model.MovementId</h1>
    <p class="lead-copy">
        Ficha completa del movimiento con sus líneas, tomando la misma información base que usa el MVC actual para consulta y auditoría.
    </p>
</section>

<section class="status-card mb-3">
    <div class="d-flex gap-2 flex-wrap">
        @if (ViewBag.CanEdit == true)
        {
            <a asp-controller="Movements" asp-action="Edit" asp-route-id="@Model.MovementId" class="btn app-button">Editar movimiento</a>
        }
        <a asp-controller="Movements" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</section>

<section class="detail-grid">
    <article class="status-card">
        <h2>Cabecera</h2>
        <p><strong>Fecha:</strong> @Model.MovementDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Sucursal origen:</strong> @Model.OriginBranchName</p>
        <p><strong>Sucursal destino:</strong> @Model.DestinationBranchName</p>
        <p><strong>Id movimiento origen:</strong> @(Model.OriginMovementId.HasValue ? Model.OriginMovementId.Value.ToString() : "-")</p>
    </article>

    <article class="status-card">
        <h2>Auditoria</h2>
        <p><strong>Creado:</strong> @(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
        <p><strong>Creado por:</strong> @(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "-" : Model.CreatedByName)</p>
        <p><strong>Actualizado:</strong> @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
        <p><strong>Actualizado por:</strong> @(string.IsNullOrWhiteSpace(Model.UpdatedByName) ? "-" : Model.UpdatedByName)</p>
    </article>

    <article class="status-card">
        <h2>Observaciones</h2>
        <p>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</p>
    </article>
    
</section>

<section class="status-card mt-3">
    <h2>Lineas</h2>
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Producto</th>
                    <th>Kg</th>
                    <th>Unidades</th>
                    <th>Peso balanza</th>
                    <th>Permitir ingreso</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">El movimiento no tiene lineas registradas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.ProductCode</td>
                            <td>@line.ProductName</td>
                            <td>@line.QuantityWeightKg.ToString("0.###")</td>
                            <td>@line.QuantityUnits</td>
                            <td>@(line.ScaleWeight ? "Si" : "No")</td>
                            <td>@(line.AllowEntry ? "Si" : "No")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
