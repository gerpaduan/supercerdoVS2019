@model StockEditViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.IsEdit ? "Modificar stock" : "Nuevo stock";
    var esPesaje = string.Equals(Model.StockOperationType, "Pesaje Cortes", StringComparison.OrdinalIgnoreCase);
    var esAjuste = string.Equals(Model.StockOperationType, "Ajuste Stock", StringComparison.OrdinalIgnoreCase);
    var esEgreso = string.Equals(Model.StockOperationType, "Egreso Stock", StringComparison.OrdinalIgnoreCase);
    var esCierre = string.Equals(Model.StockOperationType, "Cierre Stock", StringComparison.OrdinalIgnoreCase);
    var permiteNegativo = esAjuste || esEgreso;
    var tieneCompraVinculadaPesaje = esPesaje && Model.LinkedWeighingId.HasValue && Model.LinkedWeighingId.Value > 0;
    var quickProductsJson = JsonSerializer.Serialize(Model.QuickProducts.Select(x => new
    {
        productId = x.ProductId,
        code = x.Code,
        description = x.Description,
        type = x.Type,
        weighable = x.Weighable,
        averageWeight = x.AverageWeight
    }));
}

<div class="stock-unified-page">
    <section class="hero-panel">
        <p class="eyebrow">Stock NG</p>
        <h1>@(Model.IsEdit ? "Edicion de stock" : "Nuevo movimiento de stock")</h1>
        <p class="lead-copy">
            Esta pantalla ya usa la misma base visual del MVC para cabecera y lineas. El siguiente tramo seguro es conectar modales y endpoints uno por uno, sin romper el flujo compartido.
        </p>
    </section>

    <section class="status-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <a asp-controller="Stock" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            <span class="table-badge @(string.Equals(Model.Status, "Actualizado", StringComparison.OrdinalIgnoreCase) ? "is-enabled" : "is-disabled") @(esPesaje && !string.IsNullOrWhiteSpace(Model.Status) ? "" : "d-none")">
                Ajuste: @Model.Status
            </span>
        </div>

        <form class="stock-unified-form" method="post" action="@Url.Action("Save", "Stock")" id="stockEditForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StockId" value="@Model.StockId" />
            <input type="hidden" name="IsEdit" value="@Model.IsEdit.ToString().ToLowerInvariant()" />
            <input type="hidden" name="SupplierId" id="SupplierId" value="@Model.SupplierId" />
            <input type="hidden" name="LinkedWeighingId" id="LinkedWeighingId" value="@(Model.LinkedWeighingId?.ToString() ?? string.Empty)" />
            <div id="stockHiddenLinesContainer"></div>

            <div class="stock-header-grid">
                <div>
                    <label for="BranchId" class="form-label">Sucursal</label>
                    <select id="BranchId" name="BranchId" class="form-select">
                        @foreach (var branch in Model.Branches)
                        {
                            if (branch.BranchId == Model.BranchId)
                            {
                                <option value="@branch.BranchId" selected>@branch.BranchName</option>
                            }
                            else
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label for="OperationDate" class="form-label">Fecha</label>
                    <input id="OperationDate" name="OperationDate" type="datetime-local" class="form-control" value="@Model.OperationDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="stock-edit-type-wrap">
                    <label for="StockOperationType" class="form-label">Accion</label>
                    <div class="input-group">
                        <select id="StockOperationType" name="StockOperationType" class="form-select" data-stock-type-select="true">
                            @foreach (var operationType in Model.OperationTypes)
                            {
                                if (string.Equals(operationType, Model.StockOperationType, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@operationType" selected>@operationType</option>
                                }
                                else
                                {
                                    <option value="@operationType">@operationType</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("Edit", "Stock")" formmethod="get" name="id" value="@Model.StockId">Cambiar</button>
                    </div>
                    <div class="form-text">Seguimos el mismo criterio del MVC: una sola vista y la accion define que bloques se ven.</div>
                </div>
            </div>

            <div class="stock-inline-note mt-3">
                <strong>Sucursal activa:</strong> @(string.IsNullOrWhiteSpace(Model.BranchName) ? "-" : Model.BranchName)
            </div>

            <div class="stock-context-grid mt-3">
                <article class="stock-context-card @(esPesaje ? "" : "d-none")" data-stock-block="pesaje">
                    <div class="stock-pesaje-grid">
                        <div class="stock-pesaje-provider">
                            <label class="form-label" for="SupplierName">Proveedor</label>
                            <div class="input-group">
                            <input id="SupplierName" name="SupplierName" class="form-control" value="@Model.SupplierName" placeholder="Seleccione un proveedor" readonly />
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#stockPersonLookupModal">Buscar</button>
                                <button type="button" class="btn btn-outline-secondary" id="stockClearSupplierButton">Limpiar</button>
                            </div>
                            <div class="form-text" id="stockSupplierTaxIdLabel">@(string.IsNullOrWhiteSpace(Model.SupplierTaxId) ? "Sin proveedor seleccionado" : $"CUIT: {Model.SupplierTaxId}")</div>
                        </div>

                        <div>
                            <label for="HalfCarcassCount" class="form-label">Cant. medias</label>
                            <input id="HalfCarcassCount" name="HalfCarcassCount" class="form-control" value="@(Model.HalfCarcassCount?.ToString() ?? string.Empty)" />
                            <div class="form-text">Este valor solo debe venir de carga manual o de una compra vinculada.</div>
                        </div>

                        <div>
                            <label for="HalfCarcassWeightKg" class="form-label">Kgs. medias</label>
                            <input id="HalfCarcassWeightKg" name="HalfCarcassWeightKg" class="form-control" value="@(Model.HalfCarcassWeightKg?.ToString("0.00") ?? string.Empty)" />
                            <div class="form-text">No se completa por la suma de las filas. Puede guardarse en 0.</div>
                            <div class="form-check mt-2">
                                @if (Model.SaveWithoutWeighing)
                                {
                                    <input id="SaveWithoutWeighing" name="SaveWithoutWeighing" class="form-check-input" type="checkbox" checked />
                                }
                                else
                                {
                                    <input id="SaveWithoutWeighing" name="SaveWithoutWeighing" class="form-check-input" type="checkbox" />
                                }
                                <label class="form-check-label" for="SaveWithoutWeighing">Guardar sin pesaje</label>
                            </div>
                        </div>

                        <div class="stock-pesaje-actions">
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#stockWeighingPurchaseModal">Vincular compra</button>
                            <button type="button" class="btn btn-outline-info" disabled title="Pendiente en NG">Vincular pesajes</button>
                            <button type="button" class="btn btn-outline-secondary" data-stock-open-percentages>Ver porc(%)</button>
                        </div>
                    </div>

                    <div class="form-text mt-2">
                        En NG, por ahora, el pesaje solo conserva un vinculo relacionado por cabecera.
                    </div>

                    <div id="stockLinkedWeighingsInfo" class="alert alert-info mt-3 mb-0 d-none"></div>

                    <div class="stock-link-box @(tieneCompraVinculadaPesaje ? "" : "d-none")">
                        <div class="stock-link-title">Compra vinculada @(Model.LinkedWeighingId.HasValue ? $"#{Model.LinkedWeighingId.Value}" : string.Empty)</div>
                        <div class="stock-link-meta-grid">
                            <div>
                                <div class="stock-link-label">Proveedor</div>
                                <div class="stock-link-value">@(string.IsNullOrWhiteSpace(Model.LinkedPurchaseSupplierName) ? "-" : Model.LinkedPurchaseSupplierName)</div>
                            </div>
                            <div>
                                <div class="stock-link-label">Fecha</div>
                                <div class="stock-link-value">@(Model.LinkedPurchaseDate.HasValue ? Model.LinkedPurchaseDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                            </div>
                            <div>
                                <div class="stock-link-label">Cant. medias</div>
                                <div class="stock-link-value">@(Model.LinkedPurchaseHalfCarcassCount?.ToString() ?? "-")</div>
                            </div>
                            <div>
                                <div class="stock-link-label">Kgs. medias</div>
                                <div class="stock-link-value">@(Model.LinkedPurchaseWeightKg?.ToString("0.00") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="stock-context-card @(esAjuste ? "" : "d-none")" data-stock-block="ajuste">
                    <div class="stock-link-title">Pesaje vinculado @(Model.LinkedWeighingId.HasValue ? $"#{Model.LinkedWeighingId.Value}" : string.Empty)</div>
                    <div class="stock-link-meta-grid">
                        <div>
                            <div class="stock-link-label">Proveedor</div>
                            <div class="stock-link-value">@(string.IsNullOrWhiteSpace(Model.AdjustedWeighingSupplierName) ? "-" : Model.AdjustedWeighingSupplierName)</div>
                        </div>
                        <div>
                            <div class="stock-link-label">Fecha</div>
                            <div class="stock-link-value">@(Model.AdjustedWeighingDate.HasValue ? Model.AdjustedWeighingDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                        </div>
                        <div>
                            <div class="stock-link-label">Cant. medias</div>
                            <div class="stock-link-value">@(Model.AdjustedWeighingHalfCarcassCount?.ToString() ?? "-")</div>
                        </div>
                        <div>
                            <div class="stock-link-label">Kgs. medias</div>
                            <div class="stock-link-value">@(Model.AdjustedWeighingWeightKg?.ToString("0.00") ?? "-")</div>
                        </div>
                    </div>
                </article>

                <article class="stock-context-card @(esCierre ? "" : "d-none")" data-stock-block="cierre">
                    <h2>Bloque cierre</h2>
                    <p class="mb-2">Cierre NG con soporte para productos no cargados y carga rapida desde el modal.</p>
                    <div class="product-edit-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#stockMissingClosingProductsModal">Productos no cargados</button>
                    </div>
                </article>

                <article class="stock-context-card @((!esPesaje && !esAjuste && !esCierre) ? "" : "d-none")" data-stock-block="simple">
                    <h2>Bloque comun</h2>
                    <p class="mb-0">Ingreso y egreso comparten la misma base. @(permiteNegativo ? "En egreso la cantidad se guarda como negativa; en ajuste se respeta el signo ingresado." : "Este flujo trabaja con cantidades positivas.")</p>
                </article>
            </div>

            <div class="stock-work-grid mt-3">
                <section class="status-card stock-lines-panel">
                    <div class="stock-section-box">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="mb-0">Agregar producto</h2>
                            <div class="product-edit-actions">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkBalanzaLinea" checked>
                                    <label class="form-check-label" for="chkBalanzaLinea">Balanza</label>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm @(esPesaje ? "" : "d-none")" data-bs-toggle="modal" data-bs-target="#stockWeighingPurchaseModal">Vincular compra</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#stockAccumulatedModal">Ver acumulados</button>
                                <button type="button" class="btn btn-outline-info btn-sm @(esPesaje ? "" : "d-none")" data-stock-open-percentages>Ver porc(%)</button>
                                <button type="button" class="btn btn-outline-primary btn-sm @(esCierre ? "" : "d-none")" data-bs-toggle="modal" data-bs-target="#stockMissingClosingProductsModal">Productos no cargados</button>
                            </div>
                        </div>

                        <div class="stock-scale-status">
                            <div class="small text-muted mb-2">Conexion balanza: <span>Desconocida</span></div>
                            <div class="progress" style="height:4px;">
                                <div class="progress-bar" role="progressbar" style="width:0%"></div>
                            </div>
                        </div>

                        <div class="stock-line-entry-grid mt-3">
                            <div>
                                <label for="LineCode" class="form-label">Codigo</label>
                                <input id="LineCode" class="form-control" type="number" min="0" step="1" />
                            </div>
                            <div>
                                <label for="LineProductName" class="form-label">Producto</label>
                                <div class="input-group">
                                    <input id="LineProductId" type="hidden" />
                                    <input id="LineProductWeighable" type="hidden" />
                                    <input id="LineProductName" class="form-control" readonly />
                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#stockProductLookupModal">Buscar</button>
                                </div>
                            </div>
                            <div>
                                <label for="LineQuantityKg" class="form-label">Cantidad</label>
                                <input id="LineQuantityKg" class="form-control" />
                            </div>
                            <div class="stock-add-line-wrap">
                                <button type="button" class="btn btn-primary w-100" id="stockAddLineButton">Agregar</button>
                            </div>
                        </div>

                        <div id="stockLineLookupMessage" class="form-text mt-2"></div>
                        <div id="stockLineStatus" class="alert d-none mt-3 mb-0" role="alert"></div>
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table app-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-center">Bal</th>
                                    <th>Creado</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody id="stockLinesTableBody"></tbody>
                        </table>
                    </div>
                </section>

                <aside class="stock-side-panel">
                    <section class="status-card">
                        <h2 class="mb-3">Resumen</h2>
                        <div class="stock-summary-row">
                            <span>Total items</span>
                            <strong id="stockSummaryItems">@Model.ItemCount</strong>
                        </div>
                        <div class="stock-summary-row">
                            <span>Total cantidad</span>
                            <strong id="stockSummaryKg">@Model.TotalQuantityKg.ToString("0.000")</strong>
                        </div>
                        <hr />
                        <div class="small text-muted">
                            Accion: <strong>@Model.StockOperationType</strong>
                        </div>
                        @if (permiteNegativo)
                        {
                            <div class="form-text mt-2">En egreso se normaliza a negativo. En ajuste se conserva el signo ingresado.</div>
                        }
                    </section>

                    <section class="status-card mt-3">
                        <label for="Notes" class="form-label">Observaciones</label>
                        <textarea id="Notes" name="Notes" class="form-control" rows="3">@Model.Notes</textarea>
                    </section>

                    @if (Model.IsEdit)
                    {
                        <section class="status-card mt-3">
                            <div class="stock-link-meta-grid">
                                <div>
                                    <div class="stock-link-label">Creado</div>
                                    <div class="stock-link-value">@(string.IsNullOrWhiteSpace(Model.CreatedAtLabel) ? "-" : Model.CreatedAtLabel)</div>
                                    <div class="small text-muted">@(string.IsNullOrWhiteSpace(Model.CreatedByLabel) ? "-" : Model.CreatedByLabel)</div>
                                </div>
                                <div>
                                    <div class="stock-link-label">Actualizado</div>
                                    <div class="stock-link-value">@(string.IsNullOrWhiteSpace(Model.UpdatedAtLabel) ? "-" : Model.UpdatedAtLabel)</div>
                                    <div class="small text-muted">@(string.IsNullOrWhiteSpace(Model.UpdatedByLabel) ? "-" : Model.UpdatedByLabel)</div>
                                </div>
                            </div>
                        </section>
                    }
                </aside>
            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="submit" class="btn app-button">Guardar stock</button>
                <a asp-controller="Stock" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </section>
</div>

<div class="modal fade" id="stockWeighingPurchaseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Vincular compra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="stockWeighingPurchaseStatus" class="alert d-none mb-3" role="alert"></div>
                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-4">
                        <label for="stockWeighingPurchaseSupplierSearch" class="form-label">Proveedor</label>
                        <input type="text" id="stockWeighingPurchaseSupplierSearch" class="form-control" placeholder="Buscar proveedor" autocomplete="off" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <label for="stockWeighingPurchaseFromDate" class="form-label">Fecha desde</label>
                        <input type="date" id="stockWeighingPurchaseFromDate" class="form-control" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <label for="stockWeighingPurchaseToDate" class="form-label">Fecha hasta</label>
                        <input type="date" id="stockWeighingPurchaseToDate" class="form-control" />
                    </div>
                    <div class="col-12 col-lg-2 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-secondary w-100" id="stockWeighingPurchaseResetFilters">Limpiar</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table app-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th class="text-end">Kgs. medias</th>
                                <th class="text-end">Cant. medias</th>
                                <th>Tipo</th>
                                <th>Accion</th>
                            </tr>
                        </thead>
                        <tbody id="stockWeighingPurchaseTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Abra el modal para consultar compras vinculables.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="stockMissingClosingProductsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Productos no cargados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3">
                    Solo para <strong>Cierre Stock</strong>. Se muestran productos con <code>enCierreStock = true</code> que todavia no estan cargados en la grilla actual.
                </div>

                <div id="stockMissingClosingProductsStatus" class="alert d-none mb-3" role="alert"></div>
                <div id="stockMissingClosingProductsInfo" class="alert alert-info d-none mb-3" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" for="stockMissingClosingProductsSearch">Buscar</label>
                    <input type="text" id="stockMissingClosingProductsSearch" class="form-control" placeholder="Codigo o descripcion" autocomplete="off" />
                </div>

                <div class="detail-grid mb-3">
                    <div>
                        <label class="form-label" for="stockMissingClosingProductsFilter">Filtro</label>
                        <select id="stockMissingClosingProductsFilter" class="form-select">
                            <option value="all">Todos</option>
                            <option value="with-stock">Con stock</option>
                            <option value="without-stock">Sin stock</option>
                        </select>
                    </div>
                    <div class="stock-link-meta-grid">
                        <div>
                            <div class="stock-link-label">Pendientes</div>
                            <div class="stock-link-value" id="stockMissingClosingProductsCount">0 productos</div>
                        </div>
                        <div>
                            <div class="stock-link-label">Seleccionados</div>
                            <div class="stock-link-value" id="stockMissingClosingProductsSelectedCount">0</div>
                        </div>
                    </div>
                </div>

                <div class="product-edit-actions mb-3">
                    <button type="button" class="btn app-button" id="stockAddMissingClosingProductsWithStockButton">Agregar con stock actual</button>
                    <button type="button" class="btn btn-outline-secondary" id="stockAddMissingClosingProductsWithoutStockButton">Agregar como sin stock (0,000)</button>
                </div>

                <div class="table-responsive">
                    <table class="table app-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:60px;">
                                    <input type="checkbox" id="stockMissingClosingProductsSelectAll" />
                                </th>
                                <th>Codigo</th>
                                <th>Producto</th>
                                <th class="text-end">Stock actual</th>
                            </tr>
                        </thead>
                        <tbody id="stockMissingClosingProductsTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Abra el modal para consultar pendientes del cierre.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="stockLinkedWeighingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Vincular pesajes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="stockLinkedWeighingsStatus" class="alert d-none mb-3" role="alert"></div>
                <div class="small text-muted mb-3">Sucursal actual: <strong id="stockLinkedWeighingsBranchLabel">-</strong></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-4">
                        <label for="stockLinkedWeighingsSupplierSearch" class="form-label">Proveedor</label>
                        <input type="text" id="stockLinkedWeighingsSupplierSearch" class="form-control" placeholder="Buscar proveedor" autocomplete="off" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <label for="stockLinkedWeighingsFromDate" class="form-label">Fecha desde</label>
                        <input type="date" id="stockLinkedWeighingsFromDate" class="form-control" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <label for="stockLinkedWeighingsToDate" class="form-label">Fecha hasta</label>
                        <input type="date" id="stockLinkedWeighingsToDate" class="form-control" />
                    </div>
                    <div class="col-12 col-lg-2 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-secondary w-100" id="stockLinkedWeighingsResetFilters">Limpiar</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table app-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th class="text-end">Cant. medias</th>
                                <th class="text-end">Kgs. medias</th>
                                <th>Accion</th>
                            </tr>
                        </thead>
                        <tbody id="stockLinkedWeighingsTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Abra el modal para consultar pesajes vinculables.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PersonLookupModal", new PersonLookupModalViewModel
{
    ModalId = "stockPersonLookupModal",
    Title = "Buscar proveedor",
    SearchUrl = Url.Action("Lookup", "People") ?? string.Empty,
    ShowTaxId = true,
    ShowIdentification = true
})

