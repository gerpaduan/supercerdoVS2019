@model StockListPageViewModel
@{
    ViewData["Title"] = "Stock";
}

@functions {
    private static string StateCss(string state)
    {
        return (state ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "OK" => "stock-state-ok",
            "BAJO" => "stock-state-low",
            "NEGATIVO" => "stock-state-negative",
            "SIN STOCK" => "stock-state-empty",
            _ => "stock-state-empty"
        };
    }
}

<section class="hero-panel">
    <p class="eyebrow">Stock NG</p>
    <h1>Existencia por sucursales</h1>
    <p class="lead-copy">
        Este vertical combina la consulta operativa de stock con la edicion NG de ingresos, egresos, cierres, ajustes y pesajes por etapas conservadoras.
    </p>
</section>

<section class="status-card">
    @if (Model.CanManageStock)
    {
        <div class="stock-operation-grid mb-4">
            <article class="stock-operation-card">
                <p class="eyebrow mb-2">Stock operativo</p>
                <h2>Ingreso</h2>
                <p class="mb-2">Alta operativa para entradas manuales de stock.</p>
                <p class="text-muted small mb-3">Comparte la misma pantalla base que egreso, cierre, ajuste y pesaje, igual que en el MVC.</p>
                <a asp-controller="Stock" asp-action="Edit" asp-route-tipoCompra="Ingreso Stock" class="btn app-button">Abrir ingreso</a>
            </article>
            <article class="stock-operation-card">
                <p class="eyebrow mb-2">Stock operativo</p>
                <h2>Egreso</h2>
                <p class="mb-2">Salida operativa de mercaderia fuera del flujo de ventas o movimientos.</p>
                <p class="text-muted small mb-3">Usa la misma vista y cambia bloques segun la accion seleccionada.</p>
                <a asp-controller="Stock" asp-action="Edit" asp-route-tipoCompra="Egreso Stock" class="btn app-button">Abrir egreso</a>
            </article>
            <article class="stock-operation-card">
                <p class="eyebrow mb-2">Stock operativo</p>
                <h2>Cierre</h2>
                <p class="mb-2">Cierre de stock con carga manual y apoyo del modal de productos no cargados.</p>
                <p class="text-muted small mb-3">Mantiene el flujo conservador del legacy sin reescribir la operatoria.</p>
                <a asp-controller="Stock" asp-action="Edit" asp-route-tipoCompra="Cierre Stock" class="btn app-button">Abrir cierre</a>
            </article>
            <article class="stock-operation-card">
                <p class="eyebrow mb-2">Stock operativo</p>
                <h2>Ajuste</h2>
                <p class="mb-2">Ajuste de stock con detalle del pesaje vinculado y generacion posterior del ajuste.</p>
                <p class="text-muted small mb-3">Se mantiene acotado al vinculo unico que hoy soporta el esquema legacy.</p>
                <a asp-controller="Stock" asp-action="Edit" asp-route-tipoCompra="Ajuste Stock" class="btn app-button">Abrir ajuste</a>
            </article>
        </div>
    }

    <form method="get" class="stock-filters">
        <div>
            <label for="searchText" class="form-label">Busqueda</label>
            <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Codigo o descripcion" />
        </div>

        <div>
            <label for="branchId" class="form-label">Sucursal base</label>
            <select id="branchId" name="branchId" class="form-select">
                <option value="0">Todas</option>
                @foreach (var branch in Model.Branches)
                {
                    <option value="@branch.BranchId" selected="@(branch.BranchId == Model.BranchId)">@branch.BranchName</option>
                }
            </select>
        </div>

        <div>
            <label for="type" class="form-label">Tipo</label>
            <input id="type" name="type" value="@Model.Type" class="form-control" placeholder="Tipo exacto" />
        </div>

        <div>
            <label for="stockState" class="form-label">Estado</label>
            <select id="stockState" name="stockState" class="form-select">
                @foreach (var option in Model.StateOptions)
                {
                    <option value="@option" selected="@(string.Equals(option, Model.StockState, StringComparison.OrdinalIgnoreCase))">@option</option>
                }
            </select>
        </div>

        <div>
            <label for="untilDate" class="form-label">Fecha hasta</label>
            <input id="untilDate" name="untilDate" type="datetime-local" value="@Model.UntilDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
        </div>

        <div class="stock-filter-check">
            <label class="toggle-row">
                <input type="checkbox" name="onlyWithStock" value="true" @(Model.OnlyWithStock ? "checked" : null) />
                <span>Solo con stock</span>
            </label>
        </div>

        <div class="product-filter-actions">
            <button type="submit" class="btn app-button">Buscar</button>
        </div>
    </form>
</section>

<section class="status-card mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">Matriz de existencia</h2>
            <p class="mb-0 text-muted">
                @if (Model.Result.Items.Count > 0)
                {
                    <span>@Model.Result.Items.Count producto(s) y @Model.Result.Columns.Count sucursal(es) en la consulta actual.</span>
                }
                else
                {
                    <span>@Model.Result.Message</span>
                }
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table app-table align-middle mb-0 stock-matrix-table">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Producto</th>
                    @foreach (var column in Model.Result.Columns)
                    {
                        <th class="text-end">@column.BranchName</th>
                    }
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@(Model.Result.Columns.Count + 3)" class="text-center text-muted py-4">@Model.Result.Message</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Result.Items)
                    {
                        var collapseId = $"stock-detail-{item.ProductId}";
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Description</td>
                            @foreach (var cell in item.Cells)
                            {
                                <td class="text-end @StateCss(cell.StockState)">
                                    @cell.StockActual.ToString("0.###")
                                </td>
                            }
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                    Ver detalle
                                </button>
                            </td>
                        </tr>
                        <tr class="stock-detail-row">
                            <td colspan="@(Model.Result.Columns.Count + 3)" class="p-0 border-0">
                                <div class="collapse" id="@collapseId">
                                    <div class="stock-detail-panel">
                                        <table class="table app-table align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Sucursal</th>
                                                    <th>Ult. cierre</th>
                                                    <th class="text-end">Stock inicial</th>
                                                    <th class="text-end">Ingresos</th>
                                                    <th class="text-end">Egresos</th>
                                                    <th class="text-end">Stock actual</th>
                                                    <th class="text-end">Pto. stock</th>
                                                    <th class="text-end">Dif.</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var detail in item.Details)
                                                {
                                                    <tr>
                                                        <td>@detail.BranchName</td>
                                                        <td>@(detail.LastStockClosingDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                                        <td class="text-end">@detail.StockInitial.ToString("0.###")</td>
                                                        <td class="text-end">@detail.TotalEntries.ToString("0.###")</td>
                                                        <td class="text-end">@detail.TotalExits.ToString("0.###")</td>
                                                        <td class="text-end @StateCss(detail.StockState)">@detail.StockActual.ToString("0.###")</td>
                                                        <td class="text-end">@detail.StockPoint.ToString("0.###")</td>
                                                        <td class="text-end @StateCss(detail.StockState)">@detail.DifferenceFromPoint.ToString("+0.###;-0.###;0")</td>
                                                        <td>
                                                            <span class="table-badge @StateCss(detail.StockState)">@detail.StockState</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
