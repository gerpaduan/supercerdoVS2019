@model CarniSys.NG.Domain.Authentication.AuthenticatedUser
@{
    ViewData["Title"] = "Permiso de lectura";
}

<section class="hero-panel">
    <p class="eyebrow">Permisos NG</p>
    <h1>Lectura habilitada</h1>
    <p class="lead-copy">
        Esta vista solo abre si el usuario tiene permiso de lectura para <code>formStock</code>.
    </p>
</section>

<section class="status-card">
    <h2>Contexto resuelto</h2>
    <p><strong>Usuario:</strong> @Model.DisplayName</p>
    <p><strong>Empresa:</strong> @Model.Company.Name</p>
    <p><strong>Sucursal:</strong> @Model.ActiveBranch.Name</p>
</section>
