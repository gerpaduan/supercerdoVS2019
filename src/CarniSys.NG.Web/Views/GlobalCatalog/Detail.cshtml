@model ProductDetailPageViewModel
@{
    ViewData["Title"] = "Detalle global";
}

<section class="hero-panel">
    <p class="eyebrow">Catalogo Global NG</p>
    <h1>@Model.Item.Description</h1>
    <p class="lead-copy">
        Ficha de producto global en solo lectura. Este registro funciona como referencia y no puede operarse directamente desde la empresa actual.
    </p>
</section>

<section class="detail-grid">
    <article class="status-card">
        <h2>Identificacion</h2>
        <p><strong>Codigo:</strong> @Model.Item.Code</p>
        <p><strong>Tipo:</strong> @Model.Item.Type</p>
        <p><strong>Empresa:</strong> Global (@Model.Item.CompanyId)</p>
    </article>

    <article class="status-card">
        <h2>Comercial</h2>
        <p><strong>Precio Kg:</strong> @Model.Item.PricePerKilogram.ToString("0.00")</p>
        <p><strong>Pesable:</strong> @(Model.Item.Weighable ? "Si" : "No")</p>
        <p><strong>Promedio:</strong> @Model.Item.AverageWeight.ToString("0.00")</p>
        <p><strong>IVA:</strong> @Model.Item.VatRate.ToString("0.##")%</p>
    </article>

    <article class="status-card">
        <h2>Operacion</h2>
        <p><strong>Habilitado:</strong> @(Model.Item.Enabled ? "Si" : "No")</p>
        <p><strong>En cierre stock:</strong> @(Model.Item.IncludedInStockClosing ? "Si" : "No")</p>
        <p><strong>Ingreso rapido elaborado:</strong> @(Model.Item.QuickElaboratedEntry ? "Si" : "No")</p>
        <p><strong>Punto stock:</strong> @Model.Item.StockPoint</p>
    </article>

    <article class="status-card">
        <h2>Estructura</h2>
        <p><strong>Modo:</strong> @Model.Item.CutMode</p>
        <p><strong>Corte maestro:</strong> @(string.IsNullOrWhiteSpace(Model.Item.MasterProductName) ? "-" : Model.Item.MasterProductName)</p>
        <p><strong>Porcentaje:</strong> @Model.Item.Percentage.ToString("0.##")</p>
        <p><strong>Desperdicio:</strong> @Model.Item.BonePercentage.ToString("0.##")</p>
        <p><strong>Presentacion:</strong> @(Model.Item.PresentationUnits.HasValue ? Model.Item.PresentationUnits.Value.ToString("0.##") : "-")</p>
        <p><strong>Independiente:</strong> @(Model.Item.Independent ? "Si" : "No")</p>
        <p><strong>Nivel:</strong> @Model.Item.Level</p>
    </article>
</section>
