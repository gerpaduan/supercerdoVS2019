@model ProductListPageViewModel
@{
    ViewData["Title"] = "Catalogo global";
}

<section class="hero-panel">
    <p class="eyebrow">Catalogo Global NG</p>
    <h1>Productos globales en solo lectura</h1>
    <p class="lead-copy">
        Esta vista muestra el catalogo base compartido de CarniSys. Desde NG todavia no importa ni modifica estos registros.
    </p>
</section>

<section class="status-card">
    <h2>Filtros</h2>
    <form method="get" class="product-filters">
        <div>
            <label for="searchText" class="form-label">Busqueda</label>
            <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Codigo o descripcion" />
        </div>
        <div>
            <label for="type" class="form-label">Tipo</label>
            <input id="type" name="type" value="@Model.Type" class="form-control" placeholder="Tipo exacto" />
        </div>
        <div class="product-filter-actions">
            <button type="submit" class="btn app-button">Buscar</button>
        </div>
    </form>
</section>

<section class="status-card mt-3">
    <div class="alert alert-warning mb-3">
        Los productos globales no se pueden editar ni usar directamente desde NG. Solo se exponen como referencia funcional.
    </div>
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Descripcion</th>
                    <th>Tipo</th>
                    <th>Precio Kg</th>
                    <th>Estado</th>
                    <th>Pesable</th>
                    <th>Actualizado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No se encontraron productos globales para los filtros indicados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Description</td>
                            <td>@item.Type</td>
                            <td>@item.PricePerKilogram.ToString("0.00")</td>
                            <td>
                                <span class="table-badge @(item.Enabled ? "is-enabled" : "is-disabled")">
                                    @(item.Enabled ? "Habilitado" : "Inactivo")
                                </span>
                            </td>
                            <td>@(item.Weighable ? "Si" : "No")</td>
                            <td>
                                <a asp-controller="GlobalCatalog" asp-action="Detail" asp-route-id="@item.ProductId" class="app-inline-link">
                                    @((item.UpdatedAt ?? item.CreatedAt).ToString("dd/MM/yyyy HH:mm"))
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
