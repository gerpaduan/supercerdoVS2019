@model PersonListPageViewModel
@{
    ViewData["Title"] = "Personas";
}

<section class="hero-panel">
    <p class="eyebrow">Personas NG</p>
    <h1>Personas</h1>
    <p class="lead-copy">
        Esta vista lista personas de la empresa actual y globales. NG mantiene el criterio actual del MVC: no inventa un permiso nuevo para el modulo y bloquea la edicion de registros globales para usuarios de empresa.
    </p>
</section>

<section class="status-card">
    <h2>Busqueda</h2>
    <form method="get" class="product-filters">
        <div>
            <label for="searchText" class="form-label">Filtro</label>
            <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Identificacion, razon social o CUIT" />
        </div>
        <div class="product-filter-actions">
            <button type="submit" class="btn app-button">Buscar</button>
        </div>
    </form>
</section>

<section class="status-card mt-3">
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="People" asp-action="Edit" class="btn app-button">Nueva persona</a>
    </div>
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>Identificacion</th>
                    <th>Razon social</th>
                    <th>IVA</th>
                    <th>CUIT</th>
                    <th>Telefono</th>
                    <th>Cuenta corriente</th>
                    <th>Detalle</th>
                    <th>Edicion</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No se encontraron personas para el filtro indicado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(item.CompanyId == 0 ? "Global" : item.CompanyId.ToString())</td>
                            <td>@item.Identification</td>
                            <td>@item.BusinessName</td>
                            <td>@item.VatLabel</td>
                            <td>@item.TaxId</td>
                            <td>@item.Phone</td>
                            <td>@(item.HasCurrentAccount ? "Si" : "No")</td>
                            <td>
                                <a asp-controller="People" asp-action="Detail" asp-route-id="@item.PersonId" class="app-inline-link">Ver ficha</a>
                            </td>
                            <td>
                                @if (item.CompanyId == 0)
                                {
                                    <span class="text-muted small">Global</span>
                                }
                                else
                                {
                                    <a asp-controller="People" asp-action="Edit" asp-route-id="@item.PersonId" class="app-inline-link">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
