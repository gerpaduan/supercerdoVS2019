@model CarniSys.NG.Application.People.PersonDetailItem
@{
    ViewData["Title"] = "Detalle de persona";
}

<section class="hero-panel">
    <p class="eyebrow">Personas NG</p>
    <h1>@Model.BusinessName</h1>
    <p class="lead-copy">
        Ficha de persona alineada al flujo actual de `Personas`, incluyendo datos fiscales y comerciales antes de pasar a edicion.
    </p>
</section>

<section class="status-card mb-3">
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.CompanyId != 0)
        {
            <a asp-controller="People" asp-action="Edit" asp-route-id="@Model.PersonId" class="btn app-button">Editar persona</a>
        }
        <a asp-controller="People" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</section>

<section class="detail-grid">
    <article class="status-card">
        <h2>Identificacion</h2>
        <p><strong>Empresa:</strong> @(Model.CompanyId == 0 ? "Global" : Model.CompanyId.ToString())</p>
        <p><strong>Identificacion:</strong> @Model.Identification</p>
        <p><strong>Razon social:</strong> @Model.BusinessName</p>
        <p><strong>CUIT:</strong> @Model.TaxId</p>
    </article>

    <article class="status-card">
        <h2>Fiscal</h2>
        <p><strong>IVA:</strong> @Model.VatLabel</p>
        <p><strong>Id IVA:</strong> @Model.VatId</p>
        <p><strong>Cuenta corriente:</strong> @(Model.HasCurrentAccount ? "Si" : "No")</p>
        <p><strong>Bonificacion:</strong> @Model.Discount.ToString("0.##")</p>
    </article>

    <article class="status-card">
        <h2>Contacto</h2>
        <p><strong>Telefono:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</p>
        <p><strong>Domicilio:</strong> @Model.Address</p>
        <p><strong>Ciudad:</strong> @Model.City</p>
    </article>

    <article class="status-card">
        <h2>Otros datos</h2>
        <p><strong>Marca:</strong> @(Model.IsBrand ? "Si" : "No")</p>
        <p><strong>Propietario:</strong> @(string.IsNullOrWhiteSpace(Model.OwnerName) ? "-" : Model.OwnerName)</p>
        <p><strong>Notas:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</p>
        <p><strong>Creado:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </article>
</section>
