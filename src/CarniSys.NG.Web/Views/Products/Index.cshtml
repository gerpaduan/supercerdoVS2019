@model ProductListPageViewModel
@{
    ViewData["Title"] = "Productos";
}

<section class="hero-panel">
    <p class="eyebrow">Productos NG</p>
    <h1>Listado de productos en solo lectura</h1>
    <p class="lead-copy">
        Esta pantalla consume la base actual de CarniSys con filtro por empresa y permiso real de consulta, sin escribir datos ni alterar el flujo legacy.
    </p>
</section>

<section class="status-card">
    <h2>Filtros</h2>
    <form method="get" class="product-filters">
        <div>
            <label for="searchText" class="form-label">Busqueda</label>
            <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Codigo o descripcion" />
        </div>
        <div>
            <label for="type" class="form-label">Tipo</label>
            <input id="type" name="type" value="@Model.Type" class="form-control" placeholder="Tipo exacto" />
        </div>
        <div class="product-filter-actions">
            <button type="submit" class="btn app-button">Buscar</button>
        </div>
    </form>
</section>

<section class="status-card mt-3">
    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Descripcion</th>
                    <th>Tipo</th>
                    <th>Marca</th>
                    <th>Precio Kg</th>
                    <th>Estado</th>
                    <th>Pesable</th>
                    <th>Actualizado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No se encontraron productos para los filtros indicados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Description</td>
                            <td>@item.Type</td>
                            <td>@(string.IsNullOrWhiteSpace(item.BrandName) ? "-" : item.BrandName)</td>
                            <td>@item.PricePerKilogram.ToString("0.00")</td>
                            <td>
                                <span class="table-badge @(item.Enabled ? "is-enabled" : "is-disabled")">
                                    @(item.Enabled ? "Habilitado" : "Inactivo")
                                </span>
                            </td>
                            <td>@(item.Weighable ? "Si" : "No")</td>
                            <td>
                                <a asp-controller="ProductDetails" asp-action="Index" asp-route-id="@item.ProductId" class="app-inline-link">
                                    @((item.UpdatedAt ?? item.CreatedAt).ToString("dd/MM/yyyy HH:mm"))
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
