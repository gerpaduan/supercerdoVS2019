<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Negocio</RootNamespace>
    <AssemblyName>Negocio</AssemblyName>
    <!-- Ya existe Properties\AssemblyInfo.cs explicito (proyecto clasico). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Referencias de framework que el SDK-style no trae solas para net472 (el proyecto
       clasico las listaba explicitas). Incluye System.Net.Http/System.Web.Extensions, que
       agrego otra sesion en paralelo para MercadoPago; se preservan tal cual. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Transactions" />
  </ItemGroup>

  <!-- TODO(claude): swap a Microsoft.Data.SqlClient pendiente, igual que en Datos.csproj (ver
       docs/DECISIONS.md migracion ASP.NET Core). -->
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <!-- MercadoPagoOAuthClient.cs (trabajo en curso de otra sesion en paralelo) usa
       System.Web.Script.Serialization, que no existe en net10.0. Se excluye solo de esa
       compilacion; sigue intacto y compilando normal para net472. No es parte de esta
       migracion, no se toca ni se adapta. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="MercadoPagoOAuthClient.cs" />
    <Compile Remove="MercadoPagoConfig.cs" />
    <Compile Remove="MercadoPagoSucursalConfig.cs" />
    <Compile Remove="TerminalMercadoPago.cs" />
  </ItemGroup>

  <!-- Utilidades trae WinForms/WPF/COM, solo compila para net472. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <ProjectReference Include="..\Utilidades\Utilidades.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Utilidades.Core\Utilidades.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Datos\Datos.csproj" />
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
    <ProjectReference Include="..\Contratos\Contratos.csproj" />
  </ItemGroup>

</Project>
