<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Datos</RootNamespace>
    <AssemblyName>Datos</AssemblyName>
    <!-- Ya existe Properties\AssemblyInfo.cs explicito (proyecto clasico); sin esto, el SDK
         genera uno propio y choca por atributos duplicados. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Paquetes que packages.config traía para net472 (probablemente transitivos, se preservan
       tal cual para no cambiar comportamiento de Web/Presentacion actuales). En net10.0 son
       parte del BCL, no hace falta referenciarlos. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <!-- TODO(claude): swap a Microsoft.Data.SqlClient pendiente (ver docs/DECISIONS.md migracion
       ASP.NET Core). Se difiere a cuando WebCore consuma datos reales, para no tocar los 15
       archivos de esta capa en el mismo movimiento que la conversion de formato del csproj. -->
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <!-- Utilidades trae WinForms/WPF/COM, solo tiene sentido (y solo compila) para net472. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <ProjectReference Include="..\Utilidades\Utilidades.csproj" />
    <!-- Necesario para AsEnumerable()/DataTableExtensions (LINQ to DataSet); en el SDK-style
         net472 no se referencia solo por targetear el framework, a diferencia del proyecto
         clasico original que lo listaba explicito. -->
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <!-- TODO(claude): temporal mientras Utilidades.csproj tiene cambios sin commitear de otra
       sesion (ver Utilidades.Core/IEmpresaContext.cs). En net10.0 solo hace falta el subconjunto
       trivial de interfaces/contexto, no todo Utilidades (que no compila fuera de net472). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Utilidades.Core\Utilidades.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
    <ProjectReference Include="..\Contratos\Contratos.csproj" />
  </ItemGroup>

</Project>
