<Project Sdk="Microsoft.NET.Sdk">
  <!-- Herramienta de una sola vez: copia la base SuperCerdo unificada (SQL Server) a un esquema de trabajo de
       carnisys (Postgres). Ver Program.cs y docs/DECISIONS.md "Unificacion SuperCerdo SM + SL". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
