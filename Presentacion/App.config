<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <!--****Base de Datos LOCAL****-->
    <add name="local" connectionString="Data Source=equipogap;Initial Catalog=SuperCerdo;Integrated Security=True"
        providerName="System.Data.SqlClient" />

    <!--****Acceso Local SUPERCERDO***-->
    <!--<add name="connecStringRemota" connectionString="Data Source=.\sqlexpress;Network Library=DBMSSOCN;;Initial Catalog=SuperCerdo;User ID=sa;Password=sistema;"/>-->

    <!--****Local San Martin***-->
    <add name="sanMartin" connectionString="Data Source=192.168.0.151\sqlexpress;Network Library=DBMSSOCN;;Initial Catalog=SuperCerdo;User ID=sa;Password=sistema;"/>
    <!--****Remoto SUPERCERDO San Martin***-->
    <add name="sanMartinRemoto" connectionString="Data Source=200.43.113.188,1433\sqlexpress;Network Library=DBMSSOCN;;Initial Catalog=SuperCerdo;User ID=sa;Password=sistema;"/>

    
    <!--****LOCAL SAN LORENZO***-->
    <add name="sanLorenzo" connectionString="Data Source=192.168.1.93\sqlexpress;Network Library=DBMSSOCN;;Initial Catalog=SuperCerdo;User ID=sa;Password=sistema;" />
    <!--****REMOTO SAN LORENZO***-->
    <add name="sanLorenzoRemoto" connectionString="Data Source=supercerdosl.ddns.net,1433\sqlexpress;Network Library=DBMSSOCN;;Initial Catalog=SuperCerdo;User ID=sa;Password=sistema;" />

  </connectionStrings>
  
  <appSettings>


    <!--****ConnectionString por defecto***-->
    <add key="Desc_connString" value="****ConnectionString por defecto***" />
    <add key="connString" value="local" />
    
    <!--****Sucursal***-->
    <add key="Desc_idSucursal" value="****Id de Sucursal***" />
    <add key="idSucursal" value="2" />

    <!--****Form Inicio App***-->
    <add key="Desc_formInicioApp" value="****0: formPrincipal | 1:formStockActual***" />
    <add key="formInicioApp" value="0" />

    <!--****Abrir Stock Actual externo***-->
    <add key="Desc_abrirStockActualExterno" value="****Si valor '1' abre la aplicacion por fuera***" />
    <add key="abrirStockActualExterno" value="1" />

    <!--****Admin clave***-->
    <add key="Desc_clave" value="****Admin clave***" />
    <add key="clave" value="sistema" />

    <!--****Puerto Balanza***-->
    <add key="Desc_Puerto" value="****Puerto Balanza (value 0 cuando no hay balanza conectada)***" />
    <add key="puerto" value="0" />

    <!--****Puerto Balanza***-->
    <add key="Desc_singleton" value="****Leer peso con Singleton***" />
    <add key="singleton" value="false" />

    <!--****velocidad Timer Balanza***-->
    <add key="Desc_timerBalanza" value="****velocidad Timer Balanza***" />
    <add key="timerBalanza" value="100" />
    
    <!--****velocidad Timer Formularios***-->
    <add key="Desc_timerForm" value="***velocidad Timer Formularios***" />
    <add key="timerForm" value="50" />

    <!--****Fijar valor balanza para pruebas, esto evita leer el peso***-->
    <add key="Desc_fijarPeso" value="Fijar valor balanza para pruebas, esto evita leer el peso***" />
    <add key="fijarPeso" value="false" />
    
    <!--****valor de Visible para el checkbox de LeerPeso***-->
    <add key="Desc_leerPesoCaja" value="****CajaVenta: Visible para el checkbox de LeerPeso***" />
    <add key="leerPesoCaja" value="true" />
    
    <!--****valor de Visible para el checkbox de LeerPeso***-->
    <add key="Desc_leerPeso" value="****valor de Visible para el checkbox de LeerPeso***" />
    <add key="leerPeso" value="true" />
    
    <!--****valor de Visible para el checkbox de Ticket***-->
    <add key="Desc_ticket" value="****Caja Venta: valor de Visible para el checkbox de Ticket***" />
    <add key="ticket" value="false" />
    
    <!--****muestra la barra de progreso con la info del vendedor en el primer corte ingresado***-->
    <add key="Desc_cartelPrimerCorteVendedor" value="****Caja Venta: titila vendedor al ingresar primer corte***" />
    <add key="cartelPrimerCorteVendedor" value="true" />
    
    <!--****Permite al vendedor acceder a la ultima venta y modificarla***-->
    <add key="Desc_ultimaVenta" value="****Caja venta: Permite al vendedor acceder a la ultima venta y modificarla***" />
    <add key="ultimaVenta" value="true" />

    <!--****valor checkbox de Ticket en Egreso Caja***-->
    <add key="Desc_ticketForms" value="****Formularios: valor checkbox de Ticket***" />
    <add key="ticketForms" value="true" />
    
    <!--****Cantidad de milisegundos segundo inactivo a bloquear pantalla CajaVenta***-->
    <add key="Desc_tiempoBloqueo" value="****Bloquear Caja venta: milisec. inactivo***" />
    <add key="tiempoBloqueo" value="600000" />
    
    <!--****Cantidad de milisegundo que deben pasar para registra el Temporal de Linea Venta***-->
    <add key="Desc_tiempoRegistrarTemporal" value="****Temporal de Linea Venta: Milisec. de corte en balanza***" />
    <add key="tiempoRegistrarTemporal" value="3000" />

    <!--****CERRAR SESION: cantidad de milisegundos segundo inactivo***-->
    <add key="Desc_tiempoInactivoAdmin" value="****CERRAR SESION: Milisec. inactivo***" />
    <add key="tiempoInactivoAdmin" value="1800000" />

    <!--****Ruta de Actualización de movimientos***-->
    <add key="Desc_rutaActualizarMovimientos" value="****Ruta de Actualización de movimientos***" />
    <add key="rutaActualizarMovimientos" value="C:\Users\Germán\Desktop\SuperCerdo\SuperCerdo.exe" />

    <!--****TextBox enableColor White***-->
    <add key="Desc_enableColor" value="****TextBox enableColor***" />
    <add key="enableColor" value="Window" />

    <!--****TextBox readOnlyColor Silver***-->
    <add key="Desc_readOnlyColor" value="****TextBox readOnlyColor***" />
    <add key="readOnlyColor" value="ScrollBar" />
             
    <!--****TextBox focusColor***-->
    <add key="Desc_focusColor" value="****TextBox focusColor***" />
    <add key="focusColor" value="Orange" />
         
    <!--****Impresora***-->
    <add key="Desc_Impresora" value="****Nombre Impresora***" />
    <!--<add key="Impresora" value="GP-5890X Series" />
    <add key="ImpresoraRemota" value="\\Pc-9a3247099f75\GP-5890X Series" />-->
    <add key="Impresora" value="\\Pc-9a3247099f75\GP-5890X Series" />

    <!--****Id del Consumidor final***-->
    <add key="Desc_idConsumidorFinal" value="****Id del Consumidor final en BD***" />
    <add key="idConsumidorFinal" value="6" />

    <!--****Codigo Precio Mayorista***-->
    <add key="Desc_codigoPrecioMayorista" value="****Codigo Precio Mayorista****" />
    <add key="codigoPrecioMayorista" value="5000" />

    <!--****limite Dias para fecha desde***-->
    <add key="Desc_cantDiasLimitFechaDesde" value="***CantDiasLimitFechaDesde***" />
    <add key="cantDiasLimitFechaDesde" value="7" />

    <!--****Chorizo***-->
    <add key="Desc_SalChorizo" value="***SalChorizos***" />
    <add key="salChorizo" value="0.022" />

    <add key="Desc_PimientaChorizo" value="***PimientaChorizos***" />
    <add key="pimientaChorizo" value="0.0017" />
    
    <add key="Desc_NuezChorizo" value="***NuezChorizos***" />
    <add key="nuezChorizo" value="0.0007" />

    <add key="Desc_BracolorChorizo" value="***BracolorChorizos***" />
    <add key="bracolorChorizo" value="0.0017" />

    <!--****Salame***-->
    <add key="Desc_SalSalame" value="***SalSalames***" />
    <add key="salSalame" value="0.025" />

    <add key="Desc_PimientaSalame" value="***PimientaSalames***" />
    <add key="pimientaSalame" value="0.002" />

    <add key="Desc_NuezSalame" value="***NuezSalames***" />
    <add key="nuezSalame" value="0.0007" />

    <add key="Desc_BracolorSalame" value="***ProductoSalames***" />
    <add key="productoSalame" value="0.0018" />

    <!--****Salchicha***-->
    <add key="Desc_SalSalchicha" value="***SalSalchichas***" />
    <add key="salSalchicha" value="0.022" />

    <add key="Desc_PimientaSalchicha" value="***PimientaSalchichas***" />
    <add key="pimientaSalchicha" value="0.0017" />

    <add key="Desc_BracolorSalchicha" value="***BracolorSalchichas***" />
    <add key="bracolorSalchicha" value="0.0017" />

    <add key="Desc_PimentonSalchicha" value="***PimentonSalchicha***" />
    <add key="pimentonSalchicha" value="0.001" />
    
  </appSettings>
</configuration>
