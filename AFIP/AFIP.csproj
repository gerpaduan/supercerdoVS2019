<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>AFIP</RootNamespace>
    <AssemblyName>AFIP</AssemblyName>
    <!-- Ya existe Properties\AssemblyInfo.cs explicito (proyecto clasico); sin esto, el SDK
         genera uno propio y choca por atributos duplicados. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Proxies ASMX viejos (Web References\*\Reference.cs, herencia de
       System.Web.Services.Protocols.SoapHttpClientProtocol): solo compilan en net472.
       ConsultarPadronService.cs (WSPSA13/WSPSA4, consulta de padron AFIP) tampoco se porta a
       net10.0 en este slice, fuera de alcance de la migracion de GenerarFactura/LoginClass (ver
       docs/DECISIONS.md, mini-spike AFIP). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="ServiceReferenceCore\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Web References\**\*.cs" />
    <Compile Remove="ConsultarPadronService.cs" />
    <!-- Scaffolding de Settings.settings sin uso real (nada en el codigo lee
         Properties.Settings.Default), requeriria el paquete System.Configuration.ConfigurationManager
         solo para compilar cruft muerto. -->
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Cliente WCF para consumir SOAP desde .NET Core (System.ServiceModel.* no es parte del BCL
       ahi, a diferencia de net472). Genera y consume igual que el proxy ASMX viejo, ver
       ServiceReferenceCore\Ws{fe,aa}Compat.cs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- System.ServiceModel.Http/Primitives 8.1.2 (la ultima disponible) arrastran
         System.Security.Cryptography.Xml 8.0.2, con vulnerabilidad alta conocida (NU1903,
         GHSA-23rf-6693-g89p y otras). Se pinea una version parcheada directa (gana por
         "nearest wins" de NuGet sobre la transitiva). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
  </ItemGroup>

</Project>
